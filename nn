function readCpuStat() {
    try {
        const stat = fs.readFileSync('/proc/stat', 'utf8');
        const line = stat.split('\n')[0];
        const parts = line.trim().split(/\s+/).slice(1).map(Number);
        const idle = (parts[3] || 0) + (parts[4] || 0);
        const total = parts.reduce((a, b) => a + b, 0);
        return { idle, total };
    } catch (e) { return null; }
}
lastCpuInfo = readCpuStat();
setInterval(() => {
    const cur = readCpuStat();
    if (lastCpuInfo && cur) {
        const idleDiff = cur.idle - lastCpuInfo.idle;
        const totalDiff = cur.total - lastCpuInfo.total;
        if (totalDiff > 0) cpuUsagePercent = Math.max(0, Math.min(100, 100 - (idleDiff / totalDiff * 100)));
    }
    lastCpuInfo = cur;
}, 5000);

function fetchPublicIp(family) {
    return new Promise(resolve => {
        const cmd = family === 6
            ? 'curl -s6 --max-time 5 https://ifconfig.co 2>/dev/null || curl -s6 --max-time 5 https://api64.ipify.org 2>/dev/null'
            : 'curl -s4 --max-time 5 https://ifconfig.me 2>/dev/null || curl -s4 --max-time 5 https://api.ipify.org 2>/dev/null';
        exec(cmd, { timeout: 8000 }, (err, stdout) => {
            const ip = (stdout || '').trim().split('\n')[0].trim();
            let valid = false;
            if (family === 6) valid = !!ip && /^[0-9a-fA-F:]+$/.test(ip) && ip.includes(':');
            else valid = !!ip && /^[\d.]+$/.test(ip);
            resolve(valid ? ip : 'N/A');
        });
    });
}
async function getPublicIp(family = 4) {
    const now = Date.now();
    const cache = family === 6 ? publicIpv6Cache : publicIpCache;
    const ttl = cache.ip === 'N/A' ? 60000 : 600000;
    if (cache.ip && (now - cache.time) < ttl) return cache.ip;
    const ip = await fetchPublicIp(family);
    if (family === 6) publicIpv6Cache = { ip, time: now };
    else publicIpCache = { ip, time: now };
    return ip;
}

