<script>
// ---------- utilidades ----------
(function(){
  const _f = window.fetch.bind(window);
  window.fetch = async (...a) => {
    const r = await _f(...a);
    if (r.status === 401 && !location.pathname.includes('/login')) location.href = '/login';
    return r;
  };
})();

const socket = io({ transports: ['websocket', 'polling'], reconnection: true });
let inbounds = [], clientsByInbound = {}, vpnStats = [], routingSettings = {}, routingRules = [];
let editingClientId = null, editingClientInbound = null, editingInboundId = null, editingRuleId = null;
let currentConditions = [], selectedIpType = 'dual', vpnDomainCache = '';
let savingClient = false, savingInbound = false, savingRule = false;
let countries = [];
let clockTz = localStorage.getItem('gzmnet-tz') || 'America/Santo_Domingo';
let clockLabel = localStorage.getItem('gzmnet-tz-label') || 'República Dominicana';

function esc(s){ if(s==null) return ''; return String(s).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[m]); }
function fmtB(b){ b = Number(b)||0; if (b<=0) return '0 B'; const k=1024; const u=['B','KB','MB','GB','TB']; const i=Math.min(Math.floor(Math.log(b)/Math.log(k)), u.length-1); return (b/Math.pow(k,i)).toFixed(2)+' '+u[i]; }
function fmtUptime(s){ const d=Math.floor(s/86400),h=Math.floor((s%86400)/3600),m=Math.floor((s%3600)/60); if(d>0) return d+'d '+h+'h'; if(h>0) return h+'h '+m+'m'; return m+'m'; }
function fmtLastSeen(ls){
  if (!ls) return '—';
  const d = new Date(ls.indexOf('T') === -1 ? ls.replace(' ','T')+'Z' : ls);
  if (isNaN(d.getTime())) return '—';
  const diff = Math.floor((Date.now() - d.getTime())/1000);
  if (diff < 60) return 'hace ' + Math.max(1, diff) + 's';
  if (diff < 3600) return 'hace ' + Math.floor(diff/60) + 'm';
  if (diff < 86400) return 'hace ' + Math.floor(diff/3600) + 'h';
  if (diff < 604800) return 'hace ' + Math.floor(diff/86400) + 'd';
  return d.toLocaleDateString();
}
function copyEl(id){
  const el = document.getElementById(id);
  const v = (el.value !== undefined && el.tagName === 'INPUT') ? el.value : el.textContent;
  if (!v) return;
  navigator.clipboard.writeText(v).then(() => toast('Copiado', 'success')).catch(() => toast('No se pudo copiar', 'error'));
}
function copySysIp(id){
  const el = document.getElementById(id);
  const v = (el.textContent || '').trim();
  if (!v || v === '—' || v === 'N/A') { toast('Sin IP disponible', 'warning'); return; }
  navigator.clipboard.writeText(v).then(() => toast('IP copiada', 'success')).catch(() => toast('No se pudo copiar', 'error'));
}

