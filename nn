function normalizeValues(rawValue, type) {
    if (!rawValue) return [];
    const parts = String(rawValue).split(/[,;\n]+/).map(x => x.trim()).filter(Boolean);
    if (type === 'geosite') return parts.map(v => {
        if (v.startsWith('geosite:')) return v;
        if (v.startsWith('domain:') || v.startsWith('full:') || v.startsWith('regexp:')) return v;
        if (v.includes('.')) return 'domain:' + v;
        return 'geosite:' + v.toLowerCase();
    });
    if (type === 'geoip') return parts.map(v => v.startsWith('geoip:') ? v : 'geoip:' + v);
    if (type === 'domain') return parts.map(d => {
        if (d.startsWith('domain:') || d.startsWith('full:') || d.startsWith('regexp:') || d.startsWith('geosite:')) return d;
        if (d.includes('.')) return 'domain:' + d;
        if (KNOWN_GEOSITE_TAGS.has(d.toLowerCase())) return 'geosite:' + d.toLowerCase();
        return 'domain:' + d;
    });
    if (type === 'ip') return parts;
    if (type === 'port') return parts;
    if (type === 'protocol') return parts.map(v => v.toLowerCase());
    return parts;
}

function ipTypeToQueryStrategy(ipType) {
    switch (ipType) {
        case 'ipv4': return 'UseIPv4';
        case 'ipv6': return 'UseIPv6';
        case 'prefer-ipv4': return 'UseIPv4';
        case 'prefer-ipv6': return 'UseIPv6';
        default: return 'UseIP';
    }
}
function ipTypeToOutboundStrategy(ipType) { return ipTypeToQueryStrategy(ipType); }

// Reglas QUIC: van PRIMERO en el enrutamiento para ganar a WARP
function buildQuicRulesFromCustom(r) {
    const result = [];
    let conditions = [];
    try {
        if (r.match_rules && String(r.match_rules).trim()) {
            conditions = JSON.parse(r.match_rules);
            if (!Array.isArray(conditions)) conditions = [];
        }
    } catch (e) { conditions = []; }
    if (!conditions.length && r.value) conditions.push({ type: r.match_type || 'domain', value: r.value });

    const domains = [], ips = [];
    const domSet = new Set(), ipSet = new Set();
    for (const cond of conditions) {
        const value = String(cond.value || '').trim();
        if (!value) continue;
        if (cond.type === 'domain' || cond.type === 'geosite') {
            const vals = normalizeValues(value, cond.type === 'geosite' ? 'geosite' : 'domain');
            for (const v of vals) { if (!domSet.has(v)) { domSet.add(v); domains.push(v); } }
            const parts = value.split(/[,;\n]+/).map(x => x.trim().toLowerCase()).filter(Boolean);
            for (const p of parts) {
                if (p.includes('.') && !p.startsWith('geosite:') && !p.startsWith('domain:') && !p.startsWith('full:') && !p.startsWith('regexp:')) {
                    const d = 'domain:' + p;
                    if (!domSet.has(d)) { domSet.add(d); domains.push(d); }
                }
            }
        } else if (cond.type === 'ip' || cond.type === 'geoip') {
            const vals = normalizeValues(value, cond.type);
            for (const v of vals) { if (!ipSet.has(v)) { ipSet.add(v); ips.push(v); } }
        }
    }
    if (domains.length) {
        result.push({ type: "field", outboundTag: "block", protocol: ["quic"], domain: domains });
        result.push({ type: "field", outboundTag: "block", network: "udp", port: 443, domain: domains });
        result.push({ type: "field", outboundTag: "block", network: "udp", port: 80, domain: domains });
        result.push({ type: "field", outboundTag: "block", network: "udp", domain: domains });
    }
    if (ips.length) {
        result.push({ type: "field", outboundTag: "block", network: "udp", port: 443, ip: ips });
        result.push({ type: "field", outboundTag: "block", network: "udp", port: 80, ip: ips });
    }
    return result;
}

function buildRuleFromCustom(r, useWarp) {
    const out = [];
    let outbound = r.outbound || "direct";
    if (outbound === 'proxy') outbound = useWarp ? 'warp' : 'direct';
    if (outbound === 'warp' && !useWarp) outbound = 'direct';
    if (!['block', 'direct', 'warp'].includes(outbound)) outbound = 'direct';
    let conditions = [];
    try {
        if (r.match_rules && String(r.match_rules).trim()) {
            conditions = JSON.parse(r.match_rules);
            if (!Array.isArray(conditions)) conditions = [];
        }
    } catch (e) { conditions = []; }
    if (!conditions.length && r.value) conditions.push({ type: r.match_type || 'domain', value: r.value });
    const baseRule = { type: "field", outboundTag: outbound };
    let hasContent = false, explicitPorts = null, explicitProtocols = null;
    for (const cond of conditions) {
        const value = String(cond.value || '').trim();
        if (!value) continue;
        if (cond.type === 'domain' || cond.type === 'geosite') {
            const values = normalizeValues(value, cond.type === 'geosite' ? 'geosite' : 'domain');
            if (values.length) { if (!baseRule.domain) baseRule.domain = []; baseRule.domain.push(...values); hasContent = true; }
        } else if (cond.type === 'geoip' || cond.type === 'ip') {
            const values = normalizeValues(value, cond.type);
            if (values.length) { if (!baseRule.ip) baseRule.ip = []; baseRule.ip.push(...values); hasContent = true; }
        } else if (cond.type === 'port') { explicitPorts = value; hasContent = true; }
        else if (cond.type === 'protocol') { explicitProtocols = value.split(',').map(x => x.trim().toLowerCase()); hasContent = true; }
    }
    if (explicitPorts) baseRule.port = explicitPorts;
    if (explicitProtocols) baseRule.protocol = explicitProtocols;
    if (hasContent) out.push(baseRule);
    return out;
}

// Orden: API > QUIC block > privadas/DNS directo > filtros > reglas custom > WARP global
function buildXrayRouting() {
    const rules = [];
    const s = vpnDb.prepare('SELECT * FROM routing_settings WHERE id = 1').get() || {};
    const customRules = vpnDb.prepare('SELECT * FROM routing_rules WHERE enabled = 1 ORDER BY priority DESC, id ASC').all();
    const rulesNeedWarp = customRules.some(r => r.outbound === 'warp' || r.outbound === 'proxy');
    const useWarp = (s.warp_enabled == 1 || rulesNeedWarp) && wireproxyReady;

    rules.push({ type: "field", inboundTag: ["api"], outboundTag: "api" });

    const quicRules = customRules.filter(r => r.outbound === 'block_quic');
    for (const r of quicRules) for (const b of buildQuicRulesFromCustom(r)) rules.push(b);

    rules.push({ type: "field", ip: ["geoip:private"], outboundTag: "direct" });
    rules.push({ type: "field", outboundTag: "direct", network: "udp", port: "53" });
    rules.push({ type: "field", outboundTag: "direct", network: "tcp", port: "53" });

    if (s.prevent_captcha) rules.push({ type: "field", domain: CAPTCHA_DOMAINS.map(d => 'domain:' + d), outboundTag: "direct" });
    if (s.block_ads) rules.push({ type: "field", domain: ["geosite:category-ads-all", ...EXPLICIT_AD_DOMAINS], outboundTag: "block" });
    if (s.block_trackers) rules.push({ type: "field", domain: TRACKER_DOMAINS, outboundTag: "block" });
    if (s.block_adult) rules.push({ type: "field", domain: ["geosite:category-porn"], outboundTag: "block" });
    if (s.block_malware) rules.push({ type: "field", domain: MALWARE_DOMAINS.map(d => "domain:" + d), outboundTag: "block" });
    if (s.block_bittorrent) rules.push({ type: "field", protocol: ["bittorrent"], outboundTag: "block" });

    const otherRules = customRules.filter(r => r.outbound !== 'block_quic');
    for (const r of otherRules) for (const b of buildRuleFromCustom(r, useWarp)) rules.push(b);

    if (useWarp) rules.push({ type: "field", network: "tcp,udp", outboundTag: "warp" });
    return rules;
}

function buildXrayDns() {
    const s = vpnDb.prepare('SELECT * FROM routing_settings WHERE id = 1').get() || {};
    const primary = (s.dns_primary || '1.1.1.1').trim();
    const secondary = (s.dns_secondary || '8.8.8.8').trim();
    const primaryV6 = (s.dns_primary_v6 || '').trim();
    const secondaryV6 = (s.dns_secondary_v6 || '').trim();
    const ipType = s.ip_type || 'dual';
    const strategy = s.dns_query_strategy || ipTypeToQueryStrategy(ipType);
    const servers = [];
    if (primary) servers.push({ address: primary, skipFallback: false, port: 53 });
    if (secondary && secondary !== primary) servers.push({ address: secondary, skipFallback: false, port: 53 });
    if (primaryV6 && (ipType === 'dual' || ipType === 'prefer-ipv6' || ipType === 'ipv6')) servers.push({ address: primaryV6, skipFallback: false, port: 53 });
    if (secondaryV6 && secondaryV6 !== primaryV6 && (ipType === 'dual' || ipType === 'prefer-ipv6' || ipType === 'ipv6')) servers.push({ address: secondaryV6, skipFallback: false, port: 53 });
    if (servers.length === 0) { servers.push({ address: '1.1.1.1', skipFallback: false, port: 53 }); servers.push({ address: '8.8.8.8', skipFallback: false, port: 53 }); }
    const dnsConf = { servers, queryStrategy: strategy, disableCache: false, serveStale: true, enableParallelQuery: true, tag: "dns_inbound" };
    if (s.fake_dns) {
        dnsConf.servers.push({ address: "https://cloudflare-dns.com/dns-query", skipFallback: false, tag: "doh-cf" });
        dnsConf.servers.push({ address: "https://dns.google/dns-query", skipFallback: false, tag: "doh-google" });
        dnsConf.serveStaleExpirationTime = 3600;
    }
    return dnsConf;
}

function buildStreamSettings(ib, wsPath, hostHeader, domainSni) {
    const streamSettings = {};
    const network = ib.network || 'ws';
    if (network === 'ws') { streamSettings.network = 'ws'; streamSettings.wsSettings = { path: wsPath }; if (hostHeader) streamSettings.wsSettings.headers = { Host: hostHeader }; }
    else if (network === 'httpupgrade') { streamSettings.network = 'httpupgrade'; streamSettings.httpupgradeSettings = { path: wsPath }; if (hostHeader) streamSettings.httpupgradeSettings.host = hostHeader; }
    else if (network === 'raw' || network === 'tcp') { streamSettings.network = 'raw'; }
    else { streamSettings.network = 'ws'; streamSettings.wsSettings = { path: wsPath }; if (hostHeader) streamSettings.wsSettings.headers = { Host: hostHeader }; }
    const security = ib.security || (ib.tls ? 'tls' : 'none');
    if (security === 'reality') {
        streamSettings.security = 'reality';
        const serverNames = (ib.reality_server_names || 'www.google.com').split(',').map(x => x.trim()).filter(Boolean);
        const shortIds = (ib.reality_short_ids || generateShortId()).split(',').map(x => x.trim()).filter(Boolean);
        streamSettings.realitySettings = { show: false, dest: ib.reality_dest || 'www.google.com:443', xver: 0, serverNames: serverNames.length ? serverNames : ['www.google.com'], privateKey: ib.reality_private_key || '', shortIds: shortIds.length ? shortIds : [generateShortId()] };
    } else if (security === 'tls' || ib.tls) {
        streamSettings.security = 'tls';
        const certDomain = domainSni || 'server';
        const alpnList = (ib.alpn || '').split(',').map(x => x.trim()).filter(Boolean);
        if (alpnList.length === 0) alpnList.push('h2', 'http/1.1');
        streamSettings.tlsSettings = { certificates: [{ certificateFile: `/etc/nginx/ssl/${certDomain}.crt`, keyFile: `/etc/nginx/ssl/${certDomain}.key` }], alpn: alpnList };
        if (domainSni) streamSettings.tlsSettings.serverName = domainSni;
    } else streamSettings.security = 'none';
    streamSettings.sockopt = getOptimizedSockopt();
    return streamSettings;
}

function buildXrayConfig() {
    const inbounds = vpnDb.prepare('SELECT * FROM inbounds ORDER BY id').all();
    const s = vpnDb.prepare('SELECT * FROM routing_settings WHERE id = 1').get() || {};
    const xrayInbounds = [];
    xrayInbounds.push({ tag: "api", listen: "127.0.0.1", port: XRAY_API_PORT, protocol: "dokodemo-door", settings: { address: "127.0.0.1" } });
    const allClients = vpnDb.prepare('SELECT * FROM clients WHERE enabled = 1').all();
    const clientsByInb = {};
    for (const c of allClients) { if (!clientsByInb[c.inbound_id]) clientsByInb[c.inbound_id] = []; clientsByInb[c.inbound_id].push(c); }
    for (const ib of inbounds) {
        const clients = clientsByInb[ib.id] || [];
        const hostHeader = (ib.host && ib.host.trim()) ? ib.host.trim() : "";
        const domainSni = (ib.domain && ib.domain.trim()) ? ib.domain.trim() : "";
        const wsPath = (ib.path && ib.path.trim()) ? ib.path.trim() : "/";
        let streamSettings;
        try { streamSettings = buildStreamSettings(ib, wsPath, hostHeader, domainSni); } catch (e) { continue; }
        const sniffing = ib.sniffing ? { enabled: true, destOverride: ["http", "tls", "quic"], routeOnly: true } : { enabled: false };
        let inboundObj;
        if (ib.protocol === 'vless') {
            const decryptionKey = getVlessDecryptionKey();
            const clientObjs = clients.map(c => {
                let flow = c.flow || ib.flow || "";
                if (flow === 'xtls-rprx-vision' && (ib.network !== 'tcp' && ib.network !== 'raw')) flow = "";
                if (flow === 'xtls-rprx-vision' && (streamSettings.security === 'none')) flow = "";
                return { id: c.uuid, email: c.email || `user${c.id}@${ib.name}`, flow: flow };
            });
            const settings = { clients: clientObjs, decryption: "none" };
            if (decryptionKey && decryptionKey !== 'none') settings.decryption = decryptionKey;
            inboundObj = { tag: `ib-${ib.id}`, listen: "0.0.0.0", port: ib.port, protocol: "vless", settings, streamSettings, sniffing };
        } else if (ib.protocol === 'vmess') {
            const clientObjs = clients.map(c => ({ id: c.uuid, email: c.email || `user${c.id}@${ib.name}`, alterId: 0 }));
            inboundObj = { tag: `ib-${ib.id}`, listen: "0.0.0.0", port: ib.port, protocol: "vmess", settings: { clients: clientObjs }, streamSettings, sniffing };
        } else if (ib.protocol === 'trojan') {
            const clientObjs = clients.map(c => ({ password: c.uuid, email: c.email || `user${c.id}@${ib.name}`, flow: c.flow || ib.flow || "" }));
            inboundObj = { tag: `ib-${ib.id}`, listen: "0.0.0.0", port: ib.port, protocol: "trojan", settings: { clients: clientObjs }, streamSettings, sniffing };
        }
        if (inboundObj) xrayInbounds.push(inboundObj);
    }
    const domainStrategy = s.domain_strategy || 'IPIfNonMatch';
    const ipType = s.ip_type || 'dual';
    const outboundStrategy = ipTypeToOutboundStrategy(ipType);
    const routingRules = buildXrayRouting();
    const dnsConfig = buildXrayDns();
    const customRules = vpnDb.prepare('SELECT * FROM routing_rules WHERE enabled = 1').all();
    const rulesNeedWarp = customRules.some(r => r.outbound === 'warp' || r.outbound === 'proxy');
    const useWarp = (s.warp_enabled == 1 || rulesNeedWarp) && wireproxyReady;
    const optimizedSockopt = getOptimizedSockopt();
    const outbounds = [
        { protocol: "freedom", tag: "direct", settings: { domainStrategy: outboundStrategy }, streamSettings: { sockopt: optimizedSockopt } },
        { protocol: "blackhole", tag: "block" }
    ];
    if (useWarp) outbounds.push({ tag: "warp", protocol: "socks", settings: { servers: [{ address: "127.0.0.1", port: 40000 }] }, streamSettings: { sockopt: optimizedSockopt } });
    return {
        log: { loglevel: "warning" },
        api: { tag: "api", services: ["HandlerService", "LoggerService", "StatsService"] },
        stats: {},
        dns: dnsConfig,
        policy: { levels: { "0": { statsUserUplink: true, statsUserDownlink: true } }, system: { statsInboundUplink: true, statsInboundDownlink: true, statsOutboundUplink: true, statsOutboundDownlink: true } },
        inbounds: xrayInbounds,
        outbounds,
        routing: { domainStrategy, domainMatcher: "hybrid", rules: routingRules }
    };
}

