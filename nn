                    if (!result[email]) result[email] = { up: 0, down: 0 };
                    if (parts[2] === 'traffic') {
                        const val = parseInt(s.value, 10) || 0;
                        if (parts[3] === 'uplink') result[email].up = val;
                        else if (parts[3] === 'downlink') result[email].down = val;
                    }
                }
            } catch (e) {}
            resolve(result);
        });
    });
}

async function processStatsSnapshot(trafficData) {
    const now = Date.now();
    const clients = vpnDb.prepare('SELECT id, email, up_bytes, down_bytes, total_bytes, online, last_seen, limit_gb, enabled FROM clients').all();
    const nowIso = new Date().toISOString();
    let configNeedsRefresh = false;
    if (isFirstSnapshot) {
        for (const c of clients) {
            if (!c.email) continue;
            const cur = trafficData[c.email] || { up: 0, down: 0 };
            lastTrafficSnapshot[c.email] = { up: cur.up, down: cur.down };
        }
        try { vpnDb.prepare('UPDATE clients SET online = 0').run(); } catch(e) {}
        isFirstSnapshot = false;
        return;
    }
    const updateTraffic = vpnDb.prepare(`UPDATE clients SET up_bytes=?, down_bytes=?, total_bytes=?, online=?, last_seen=COALESCE(?, last_seen) WHERE id=?`);
    const tx = vpnDb.transaction(() => {
        for (const c of clients) {
            if (!c.email) continue;
            const hasData = Object.prototype.hasOwnProperty.call(trafficData, c.email);
            const cur = hasData ? trafficData[c.email] : { up: 0, down: 0 };
            const prev = lastTrafficSnapshot[c.email] || { up: 0, down: 0 };
            let deltaUp = cur.up - prev.up; let deltaDown = cur.down - prev.down;
            if (deltaUp < 0) deltaUp = cur.up;
            if (deltaDown < 0) deltaDown = cur.down;
            const newUp = (c.up_bytes || 0) + deltaUp;
            const newDown = (c.down_bytes || 0) + deltaDown;
            const newTotal = newUp + newDown;
            const hadTraffic = (deltaUp + deltaDown) > 0;
            if (hasData) lastTrafficSnapshot[c.email] = { up: cur.up, down: cur.down };
            let isOnline = 0, lastSeenUpdate = null;
            if (hadTraffic) { isOnline = 1; lastSeenUpdate = nowIso; }
            else if (c.last_seen) {
                const ls = new Date(c.last_seen.indexOf('T') === -1 ? c.last_seen.replace(' ', 'T') + 'Z' : c.last_seen).getTime();
                if (!isNaN(ls) && (now - ls) < ONLINE_TIMEOUT_MS) isOnline = 1;
            }
            updateTraffic.run(newUp, newDown, newTotal, isOnline, lastSeenUpdate, c.id);
            if (c.limit_gb > 0 && newTotal >= c.limit_gb * 1024 * 1024 * 1024 && c.enabled === 1) {
                vpnDb.prepare('UPDATE clients SET enabled = 0 WHERE id = ?').run(c.id);
                configNeedsRefresh = true;
            }
        }
    });
    tx();
    if (configNeedsRefresh) scheduleApply(true);
}

function buildVpnStatsPayload() {
    const now = Date.now();
    if (statsCache.data && (now - statsCache.time) < 1500) return statsCache.data;
    const clients = vpnDb.prepare(`SELECT c.id, c.name, c.email, c.inbound_id, c.up_bytes, c.down_bytes, c.total_bytes, c.online, c.last_seen, c.limit_gb, c.enabled, i.name as inbound_name, i.protocol FROM clients c JOIN inbounds i ON i.id = c.inbound_id`).all();
    const payload = clients.map(c => ({ id: c.id, name: c.name, email: c.email, inbound_id: c.inbound_id, inbound: c.inbound_name, protocol: c.protocol, up: c.up_bytes || 0, down: c.down_bytes || 0, total: c.total_bytes || 0, connected: c.online === 1, last_seen: c.last_seen, limit_gb: c.limit_gb || 0, enabled: c.enabled === 1 }));
    statsCache = { data: payload, time: now };
    return payload;
}
function emitVpnStats() {
    try {
        const count = (io.engine && io.engine.clientsCount) || 0;
        if (count > 0) io.emit('vpn_stats', buildVpnStatsPayload());
    } catch (e) {}
}

