// ---------- gauges y gráfica ----------
function getGaugeColor(pct){ if (pct < 50) return '#22c55e'; if (pct < 70) return '#eab308'; if (pct < 85) return '#f97316'; return '#ef4444'; }
function updateGauge(ringId, valId, pct){
  const ring = document.getElementById(ringId), val = document.getElementById(valId);
  if (!ring || !val) return;
  const p = Math.max(0, Math.min(100, Number(pct) || 0));
  const circ = 2 * Math.PI * 13;
  ring.setAttribute('stroke-dasharray', `${(p/100)*circ} ${circ}`);
  ring.setAttribute('stroke', getGaugeColor(p));
  val.textContent = Math.round(p);
}
const MAX_SAMPLES = 60;
const chartHistory = { cpu: [], ram: [] };
function resizeChart(){
  const canvas = document.getElementById('sysChart'); if (!canvas) return;
  const wrap = canvas.parentElement, dpr = window.devicePixelRatio || 1;
  canvas.width = wrap.clientWidth * dpr; canvas.height = wrap.clientHeight * dpr;
  drawChart();
}
function pushChartSample(cpu, ram){
  chartHistory.cpu.push(cpu); chartHistory.ram.push(ram);
  if (chartHistory.cpu.length > MAX_SAMPLES) chartHistory.cpu.shift();
  if (chartHistory.ram.length > MAX_SAMPLES) chartHistory.ram.shift();
  drawChart();
}
function drawLine(ctx, data, W, H, PAD, color){
  if (data.length < 2) return;
  const chartW = W - PAD*2, chartH = H - PAD*2;
  ctx.strokeStyle = color; ctx.lineWidth = 2; ctx.lineJoin = 'round';
  ctx.beginPath();
  for (let i = 0; i < data.length; i++) {
    const x = PAD + (i / (MAX_SAMPLES - 1)) * chartW;
    const y = PAD + chartH - (Math.min(100, data[i]) / 100) * chartH;
    i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
  }
  ctx.stroke();
}
function drawChart(){
  const canvas = document.getElementById('sysChart'); if (!canvas) return;
  const ctx = canvas.getContext('2d'), dpr = window.devicePixelRatio || 1;
  const W = canvas.width / dpr, H = canvas.height / dpr;
  ctx.setTransform(dpr,0,0,dpr,0,0); ctx.clearRect(0,0,W,H);
  const PAD = 24, chartH = H - PAD*2;
  ctx.strokeStyle = 'rgba(128,128,128,0.15)'; ctx.lineWidth = 1;
  for (let i = 0; i <= 4; i++) { const y = PAD + (chartH/4)*i; ctx.beginPath(); ctx.moveTo(PAD, y); ctx.lineTo(W-PAD, y); ctx.stroke(); }
  drawLine(ctx, chartHistory.ram, W, H, PAD, '#a78bfa');
  drawLine(ctx, chartHistory.cpu, W, H, PAD, '#60a5fa');
}
window.addEventListener('resize', () => { if (document.getElementById('p-settings').classList.contains('active')) resizeChart(); });

async function updateSystemInfo(){
  try {
    const r = await fetch('/api/system-info'); const d = await r.json();
    if (!d.ok) return;
    const cpu = parseFloat(d.cpuUsage) || 0, ram = parseFloat(d.memPercent) || 0;
    updateGauge('cpuRing','cpuVal',cpu); updateGauge('ramRing','ramVal',ram);
    const el = id => document.getElementById(id);
    if (el('cpuBigVal')) { el('cpuBigVal').textContent = cpu.toFixed(1); el('cpuBigVal').style.color = getGaugeColor(cpu); }
    if (el('ramBigVal')) { el('ramBigVal').textContent = ram.toFixed(1); el('ramBigVal').style.color = getGaugeColor(ram); }
    if (el('cpuStatSub')) el('cpuStatSub').textContent = (d.cpuCount||1) + ' núcleos · load ' + (d.cpuLoad||0);
    if (el('ramStatSub')) el('ramStatSub').textContent = ((d.memUsed||0)/1024/1024/1024).toFixed(1) + ' / ' + ((d.memTotal||0)/1024/1024/1024).toFixed(1) + ' GB';
    if (el('sysNode')) el('sysNode').textContent = d.nodeVersion || '—';
    if (el('sysUptime')) el('sysUptime').textContent = fmtUptime(d.uptime || 0);
    if (el('sysIpv4')) el('sysIpv4').textContent = d.ipv4 || '—';
    if (el('sysIpv6')) el('sysIpv6').textContent = d.ipv6 || '—';
    if (el('sysCpuLoad')) el('sysCpuLoad').textContent = (d.cpuLoad||'0') + ' / ' + (d.cpuCount||1);
    pushChartSample(cpu, ram);
  } catch(e){}
}

