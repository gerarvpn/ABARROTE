  if (!confirm('Esto reemplazará usuarios, servidores, enrutamiento y ajustes actuales. ¿Continuar?')) return;
  try {
    const text = await file.text();
    let bundle; try { bundle = JSON.parse(text); } catch(e) { toast('El archivo no es un JSON válido', 'error', 4000); return; }
    toast('Restaurando...', null, 10000);
    const r = await fetch('/api/restore', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ bundle }) });
    const d = await r.json();
    if (!d.ok) { toast(d.error || 'Error al restaurar', 'error', 5000); return; }
    toast('Copia restaurada. Recargando...', 'success', 3000);
