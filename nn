app.put('/api/clients/:id', checkAuth, async (req, res) => {
    try {
        const { id } = req.params;
        const { name, email, limit_gb, flow, regenerate_credential, credential, sub_token } = req.body;
        const old = vpnDb.prepare('SELECT * FROM clients WHERE id = ?').get(id);
        if (!old) return res.status(404).json({ ok: false, error: 'Cliente no encontrado' });
        const ib = vpnDb.prepare('SELECT * FROM inbounds WHERE id = ?').get(old.inbound_id);
        const finalEmail = (email && email.trim()) ? email.trim() : old.email;
        if (finalEmail !== old.email) {
            const dup = vpnDb.prepare('SELECT id FROM clients WHERE email = ? AND id != ?').get(finalEmail, id);
            if (dup) return res.status(400).json({ ok: false, error: `Email ya en uso` });
            if (old.email) delete lastTrafficSnapshot[old.email];
        }
        let newCredential = old.uuid;
        if (regenerate_credential) {
            newCredential = ib.protocol === 'trojan' ? generatePassword() : generateUuid();
        } else if (credential !== undefined && String(credential).trim()) {
            const c = String(credential).trim();
            if (c !== old.uuid) {
                if ((ib.protocol === 'vless' || ib.protocol === 'vmess') && !UUID_RE.test(c)) return res.status(400).json({ ok: false, error: 'UUID inválido' });
                if (ib.protocol === 'trojan' && c.length < 6) return res.status(400).json({ ok: false, error: 'Contraseña muy corta' });
                newCredential = c;
            }
        }
        let newToken = old.sub_token;
        if (sub_token !== undefined && sub_token !== '') {
            const t = String(sub_token).trim();
            if (t.length >= 1 && t.length <= 32 && /^[a-zA-Z0-9_-]+$/.test(t)) {
                if (t !== old.sub_token) {
                    const d = vpnDb.prepare('SELECT id FROM clients WHERE sub_token = ? AND id != ?').get(t, id);
                    if (d) return res.status(400).json({ ok: false, error: 'Token ya en uso' });
                    newToken = t;
                }
            } else return res.status(400).json({ ok: false, error: 'Token invalido' });
        }
        if (newCredential !== old.uuid) delete lastTrafficSnapshot[finalEmail];
        vpnDb.prepare(`UPDATE clients SET name=?, email=?, uuid=?, limit_gb=?, flow=?, sub_token=? WHERE id=?`)
            .run(name || old.name, finalEmail, newCredential, parseFloat(limit_gb) || 0, flow || old.flow, newToken, id);
        const updatedClient = vpnDb.prepare('SELECT * FROM clients WHERE id = ?').get(id);
        io.emit('refresh_servers');
        statsCache = { data: null, time: 0 }; totalsCache = { data: null, time: 0 };
        res.json({ ok: true, client: updatedClient, credential: newCredential, subToken: newToken });
        scheduleApply(false);
    } catch (e) { res.status(500).json({ ok: false, error: e.message }); }
});

