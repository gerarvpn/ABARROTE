// ---------- toast ----------
let toastTO = null;
function toast(text, type, ms){
  const el = document.getElementById('toast');
  if (toastTO) clearTimeout(toastTO);
  el.classList.remove('success','error','warning');
  if (type) el.classList.add(type);
  document.getElementById('toastText').textContent = text;
  el.classList.add('on');
  toastTO = setTimeout(() => { el.classList.remove('on'); toastTO = null; }, ms || 2400);
}

