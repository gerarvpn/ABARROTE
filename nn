const BACKUP_FORMAT = 'gzmnet-backup';
const BACKUP_VERSION = 1;
const SQLITE_MAGIC = 'SQLite format 3\u0000';

app.get('/api/backup', checkAuth, async (req, res) => {
    const tmpFile = path.join(BACKUP_DIR, `export-${Date.now()}.sqlite`);
    try {
        // Copia consistente de la BD (incluye datos del WAL)
        await vpnDb.backup(tmpFile);
        const dbBuf = fs.readFileSync(tmpFile);
        const readOpt = p => { try { return fs.readFileSync(p, 'utf8').trim(); } catch (e) { return ''; } };
        const bundle = {
            format: BACKUP_FORMAT,
            version: BACKUP_VERSION,
            panelVersion: APP_VERSION,
            createdAt: new Date().toISOString(),
            database: dbBuf.toString('base64'),
            files: {
                'config.json': readOpt(CONFIG_PATH),
                'vpn_config.json': readOpt(VPN_CONFIG_PATH),
                'data/vless_decryption.key': readOpt(VLESS_DECRYPTION_KEY_PATH),
                'data/vless_encryption.key': readOpt(VLESS_ENCRYPTION_KEY_PATH)
            }
        };
        const stamp = new Date().toISOString().replace(/[:.]/g, '-');
        res.set('Content-Type', 'application/json; charset=utf-8');
        res.set('Content-Disposition', `attachment; filename="gzmnet-backup-${stamp}.json"`);
        res.set('Cache-Control', 'no-store');
        res.send(JSON.stringify(bundle));
    } catch (e) {
        res.status(500).json({ ok: false, error: e.message });
    } finally {
        try { fs.unlinkSync(tmpFile); } catch (e) {}
    }
});

app.post('/api/restore', checkAuth, async (req, res) => {
    if (restoring) return res.status(409).json({ ok: false, error: 'Ya hay una restauración en curso' });
    const tmpDb = path.join(DATA_DIR, `restore-${Date.now()}.sqlite`);
    try {
        const bundle = req.body && req.body.bundle ? req.body.bundle : req.body;
        if (!bundle || bundle.format !== BACKUP_FORMAT) return res.status(400).json({ ok: false, error: 'Archivo no es una copia de GZMNET' });
        if (bundle.version !== BACKUP_VERSION) return res.status(400).json({ ok: false, error: 'Versión de copia no compatible' });
        if (typeof bundle.database !== 'string' || !bundle.database) return res.status(400).json({ ok: false, error: 'Copia sin base de datos' });

        const dbBuf = Buffer.from(bundle.database, 'base64');
        if (dbBuf.slice(0, 16).toString('binary') !== SQLITE_MAGIC) return res.status(400).json({ ok: false, error: 'Base de datos inválida' });
        fs.writeFileSync(tmpDb, dbBuf);

        // Validar estructura antes de tocar nada
        let check;
        try {
            check = new Database(tmpDb, { readonly: true, fileMustExist: true });
            const tables = check.prepare("SELECT name FROM sqlite_master WHERE type='table'").all().map(t => t.name);
            const required = ['inbounds', 'clients', 'routing_settings', 'routing_rules'];
            const missing = required.filter(t => !tables.includes(t));
            if (missing.length) throw new Error('Faltan tablas: ' + missing.join(', '));
            const integrity = check.prepare('PRAGMA integrity_check').get();
            if (!integrity || Object.values(integrity)[0] !== 'ok') throw new Error('La base de datos está dañada');
        } finally { try { if (check) check.close(); } catch (e) {} }

        // Copia de seguridad previa automática del estado actual
        const preName = path.join(BACKUP_DIR, `pre-restore-${new Date().toISOString().replace(/[:.]/g, '-')}.sqlite`);
        try { await vpnDb.backup(preName); } catch (e) { logApply('[RESTORE] no se pudo respaldar estado previo: ' + e.message); }

        // Bloquear peticiones y reemplazar archivos
        restoring = true;
        try { vpnDb.pragma('wal_checkpoint(TRUNCATE)'); vpnDb.close(); } catch (e) {}
        fs.copyFileSync(tmpDb, VPN_DB_PATH);
        for (const suffix of ['-wal', '-shm']) { try { fs.unlinkSync(VPN_DB_PATH + suffix); } catch (e) {} }

        const files = bundle.files || {};
        if (typeof files['config.json'] === 'string' && files['config.json']) {
            fs.writeFileSync(CONFIG_PATH, files['config.json']);
            try { fs.chmodSync(CONFIG_PATH, 0o600); } catch (e) {}
        }
        if (typeof files['vpn_config.json'] === 'string' && files['vpn_config.json']) {
            fs.writeFileSync(VPN_CONFIG_PATH, files['vpn_config.json']);
            try { fs.chmodSync(VPN_CONFIG_PATH, 0o600); } catch (e) {}
        }
        if (files['data/vless_decryption.key']) fs.writeFileSync(VLESS_DECRYPTION_KEY_PATH, files['data/vless_decryption.key'] + '\n');
        if (files['data/vless_encryption.key']) fs.writeFileSync(VLESS_ENCRYPTION_KEY_PATH, files['data/vless_encryption.key'] + '\n');

        logApply('[RESTORE] Copia restaurada, reiniciando panel');
        res.json({ ok: true, message: 'Copia restaurada. Reiniciando panel...' });
        // PM2 reinicia el proceso y carga la nueva base de datos
        setTimeout(() => process.exit(0), 800);
    } catch (e) {
        restoring = false;
        logApply('[RESTORE] error: ' + e.message);
        res.status(500).json({ ok: false, error: e.message });
    } finally {
        try { fs.unlinkSync(tmpDb); } catch (e) {}
    }
});

