const loginAttempts = new Map();
function checkLoginRate(ip) {
    const now = Date.now();
    const rec = loginAttempts.get(ip);
    if (!rec) return true;
    if (rec.until > now) return false;
    if (now - rec.until > 15 * 60 * 1000) { loginAttempts.delete(ip); return true; }
    return true;
}
function recordFailedLogin(ip) {
    const now = Date.now();
    const rec = loginAttempts.get(ip) || { count: 0, until: 0 };
    rec.count++;
    if (rec.count >= 5) { rec.until = now + 15 * 60 * 1000; rec.count = 0; }
    loginAttempts.set(ip, rec);
}
function clearLoginAttempts(ip) { loginAttempts.delete(ip); }

