let cacheJobRunning = false;
setInterval(async () => {
    if (cacheJobRunning || restoring) return;
    try {
        const s = vpnDb.prepare('SELECT cache_enabled, cache_time, cache_timezone, last_cache_at FROM routing_settings WHERE id = 1').get() || {};
        if (!s.cache_enabled) return;
        const tz = isValidTimeZone(s.cache_timezone) ? s.cache_timezone : DEFAULT_TZ;
        const target = isValidHM(s.cache_time) ? s.cache_time : '04:00';
        const now = nowInTz(tz);
        if (now.hm !== target) return;
        if (s.last_cache_at) {
            const last = nowInTz(tz, new Date(s.last_cache_at));
            if (last.date === now.date) return;
        }
        cacheJobRunning = true;
        logApply(`[CACHE] Limpieza automática ${target} (${tz})`);
        await performFullCacheClean();
    } catch (e) {
        logApply('[CACHE] error: ' + e.message);
    } finally { cacheJobRunning = false; }
}, 20000);

