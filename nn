function getRuleConditions(r){
  let conds = [];
  try { if (r.match_rules && String(r.match_rules).trim()) { const p = JSON.parse(r.match_rules); if (Array.isArray(p)) conds = p; } } catch(e){}
  if (!conds.length && r.match_type && r.value) conds = [{ type: r.match_type === 'auto' ? 'domain' : r.match_type, value: r.value }];
  return conds;
}
function renderRules(){
  const list = document.getElementById('rulesList');
  document.getElementById('rulesDesc').textContent = routingRules.length ? `${routingRules.length} regla${routingRules.length > 1 ? 's' : ''} configurada${routingRules.length > 1 ? 's' : ''}` : 'Enrutamiento por dominio, IP o protocolo';
  if (!routingRules.length) { list.innerHTML = '<div class="empty-text" style="text-align:center; padding:20px 0;">Sin reglas personalizadas</div>'; return; }
  const outs = { block:'Bloquear', direct:'Directo', warp:'WARP', proxy:'WARP', block_quic:'Bloquear QUIC' };
  list.innerHTML = routingRules.map(r => {
    const on = r.enabled == 1, conds = getRuleConditions(r);
    const chips = conds.map(c => `<span class="rule-cond">${esc(c.type)}: ${esc((c.value||'').slice(0,30))}</span>`).join('');
    let o = r.outbound || 'direct'; if (o === 'proxy') o = 'warp';
    const badge = o === 'block_quic' ? 'quic' : o === 'block' ? 'danger' : o === 'direct' ? 'on' : 'warp';
    return `<div class="rule-card out-${o} ${on ? '' : 'disabled'}">
      <div class="rule-info"><div class="rule-name">${esc(r.name)}</div><div class="rule-conds">${chips}</div></div>
      <span class="badge ${badge}">${outs[r.outbound] || o}</span>
      <div style="display:flex; gap:2px;">
        <button class="btn btn-ghost btn-icon" onclick="openRuleModal(${r.id})" title="Editar">✎</button>
        <button class="btn btn-ghost btn-icon" onclick="toggleRule(${r.id})" title="Activar/pausar">⏻</button>
        <button class="btn btn-ghost btn-icon" style="color:var(--danger);" onclick="deleteRule(${r.id})" title="Eliminar">✕</button>
      </div>
    </div>`;
  }).join('');
}
function addCondition(type, value){ currentConditions.push({ type: type || 'domain', value: value || '' }); renderConditions(); }
function removeCondition(i){ currentConditions.splice(i, 1); renderConditions(); }
function updateCondition(i, key, v){ if (!currentConditions[i]) return; currentConditions[i][key] = v; if (key === 'type') renderConditions(); }
function renderConditions(){
  const c = document.getElementById('conditionsList');
  if (!currentConditions.length) { c.innerHTML = '<div class="field-hint" style="padding:10px; text-align:center; background:var(--surface-2); border-radius:8px;">Sin condiciones</div>'; return; }
