async function loadRouting(){
  try {
    const r = await fetch('/api/routing'); const d = await r.json();
    if (!d.ok) return;
    routingSettings = d.settings || {};
    routingRules = d.rules || [];
    renderToggles(); renderRules();
    selectedIpType = routingSettings.ip_type || 'dual'; renderIpType();
    const el = id => document.getElementById(id);
    el('dnsPrimary').value = routingSettings.dns_primary || '1.1.1.1';
    el('dnsSecondary').value = routingSettings.dns_secondary || '8.8.8.8';
    el('dnsPrimaryV6').value = routingSettings.dns_primary_v6 || '';
    el('dnsSecondaryV6').value = routingSettings.dns_secondary_v6 || '';
    el('domainStrategy').value = routingSettings.domain_strategy || 'IPIfNonMatch';
    el('swFakeDns').classList.toggle('on', routingSettings.fake_dns == 1);
  } catch(e){}
}
async function pushRoutingSettings(o){
  try { const r = await fetch('/api/routing/settings', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(o) }); return await r.json(); }
  catch(e){ return { ok:false, error: e.message }; }
}
function renderIpType(){ document.querySelectorAll('.ipType').forEach(b => b.classList.toggle('active', b.dataset.type === selectedIpType)); }
async function selectIpType(t){ selectedIpType = t; renderIpType(); const d = await pushRoutingSettings({ ip_type: t }); d.ok ? toast('Tipo de IP aplicado', 'success') : toast(d.error || 'Error', 'error'); }
function renderToggles(){
  const keys = ['block_ads','block_trackers','block_adult','block_malware','prevent_captcha','block_bittorrent'];
  let activeCount = 0;
  for (const k of keys) {
    const el = document.querySelector(`[data-filter="${k}"]`);
    if (el) el.classList.toggle('on', routingSettings[k] == 1);
    if (routingSettings[k] == 1) activeCount++;
  }
  const desc = document.getElementById('filtersDesc');
  if (desc) desc.textContent = activeCount > 0 ? `${activeCount} filtro${activeCount > 1 ? 's' : ''} activo${activeCount > 1 ? 's' : ''}` : 'Publicidad, rastreadores, malware y más';
  const w = document.getElementById('swWarp');
  if (w) {
    const a = routingSettings.warp_enabled == 1;
    w.classList.toggle('on', a);
    document.getElementById('warpDot').className = 'dot ' + (a ? 'on' : '');
    const txt = document.getElementById('warpStatusText');
    txt.textContent = a ? 'ACTIVO: todo el tráfico por WARP' : 'Inactivo';
    txt.style.color = a ? 'var(--warp)' : '';
  }
}
async function toggleBlock(k){
  const prev = routingSettings[k], nv = Number(prev) === 1 ? 0 : 1;
  routingSettings[k] = nv; renderToggles();
  const d = await pushRoutingSettings({ [k]: nv == 1 });
  if (!d.ok) { routingSettings[k] = prev; renderToggles(); toast(d.error || 'Error', 'error'); } else toast('Aplicado', 'success');
}
async function toggleWarp(){
  const prev = routingSettings.warp_enabled, nv = Number(prev) === 1 ? 0 : 1;
  routingSettings.warp_enabled = nv; renderToggles();
  const d = await pushRoutingSettings({ warp_enabled: nv == 1 });
  if (!d.ok) { routingSettings.warp_enabled = prev; renderToggles(); toast(d.error || 'Error', 'error'); }
  else if (d.warp_enabled === 0 && nv === 1) { routingSettings.warp_enabled = 0; renderToggles(); toast('WARP no disponible', 'warning'); }
  else toast(nv ? 'WARP global activado' : 'WARP desactivado', 'success');
}
