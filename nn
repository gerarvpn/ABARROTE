function buildClientLink(c) {
    const address = c.ib_domain || c.host || c.domain || 'TU_DOMINIO.com';
    const hostHeader = c.host || c.ib_domain || c.domain || 'TU_DOMINIO.com';
    const sni = c.ib_domain || c.host || c.domain || 'TU_DOMINIO.com';
    const port = c.port;
    const pathValue = c.path || '/';
    const network = c.network || 'ws';
    const security = c.security || (c.tls ? 'tls' : 'none');
    let flow = c.flow || c.inbound_flow || "";
    if (flow === 'xtls-rprx-vision') {
        if (network !== 'tcp' && network !== 'raw') flow = "";
        if (security === 'none') flow = "";
    }
    let link = '';
    const params = new URLSearchParams();
    if (network === 'ws') { params.set('type', 'ws'); params.set('path', pathValue); }
    else if (network === 'httpupgrade') { params.set('type', 'httpupgrade'); params.set('path', pathValue); }
    else { params.set('type', 'tcp'); params.set('headerType', 'none'); }
    if (security === 'reality') {
        params.set('security', 'reality'); params.set('sni', sni);
        params.set('fp', c.fingerprint || 'chrome');
        if (c.reality_public_key) params.set('pbk', c.reality_public_key);
        const sid = (c.reality_short_ids || '').split(',').map(x => x.trim()).filter(Boolean)[0] || '';
        if (sid) params.set('sid', sid);
        params.set('spx', '/');
    } else if (security === 'tls' || c.tls) {
        params.set('security', 'tls'); params.set('sni', sni);
        params.set('fp', c.fingerprint || 'chrome');
        if (c.alpn) params.set('alpn', c.alpn);
    } else params.set('security', 'none');
    if (c.protocol === 'vless') { const encKey = getVlessEncryptionKey(); if (encKey && encKey !== 'none') params.set('encryption', encKey); }
    params.set('host', hostHeader);
    if (flow && c.protocol === 'vless') params.set('flow', flow);
    if (c.protocol === 'vless') link = `vless://${c.uuid}@${address}:${port}?${params.toString()}#${encodeURIComponent(c.name)}`;
    else if (c.protocol === 'vmess') {
        const vmessNet = network === 'raw' ? 'tcp' : network;
        const vmess = { v: "2", ps: c.name, add: address, port: port, id: c.uuid, aid: "0", scy: "auto", net: vmessNet, type: "none", host: hostHeader, path: pathValue, tls: security === 'none' ? "" : security, sni: security !== 'none' ? sni : "", fp: security !== 'none' ? (c.fingerprint || 'chrome') : "" };
        if (security === 'reality') {
            vmess.pbk = c.reality_public_key || "";
            vmess.sid = (c.reality_short_ids || "").split(',')[0].trim();
            vmess.spx = "/";
        }
        link = `vmess://${Buffer.from(JSON.stringify(vmess)).toString('base64')}`;
    } else if (c.protocol === 'trojan') link = `trojan://${encodeURIComponent(c.uuid)}@${address}:${port}?${params.toString()}#${encodeURIComponent(c.name)}`;
    return link;
}

function checkAuth(req, res, next) {
    try { if (req && req.session && req.session.user) return next(); return res.status(401).send('Unauthorized'); }
    catch (e) { return res.status(401).send('Unauthorized'); }
}

function fetchInboundsWithClients() {
    const inbounds = vpnDb.prepare('SELECT * FROM inbounds ORDER BY id DESC').all();
    const allClients = vpnDb.prepare('SELECT * FROM clients ORDER BY id DESC').all();
    const byInb = {};
    for (const c of allClients) { if (!byInb[c.inbound_id]) byInb[c.inbound_id] = []; byInb[c.inbound_id].push(c); }
    return inbounds.map(ib => ({ ...ib, clients: byInb[ib.id] || [] }));
}

