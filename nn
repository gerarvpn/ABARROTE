#!/bin/bash
# ============================================================
# GZMNET VPN PANEL - v3.4.0 (INSTALACION LIMPIA)
# PARTE 1 de 4: base, Nginx, sistema, QR local
# Continúa con la PARTE 2 (init-db, Xray, WARP)
# ============================================================

clear
echo "============================================================="
echo "         GZMNET VPN PANEL - Instalacion v3.4.0"
echo "============================================================="

if [ "$EUID" -ne 0 ]; then echo "Error: ejecuta como root (sudo)."; exit 1; fi

mkdir -p /etc/nginx/sites-enabled /etc/nginx/sites-available /etc/nginx/conf.d /etc/nginx/ssl /var/www/html
systemctl stop nginx >/dev/null 2>&1 || true
rm -f /etc/nginx/conf.d/gzmnet*.conf 2>/dev/null || true
rm -f /etc/nginx/sites-enabled/gzmnet /etc/nginx/sites-enabled/default 2>/dev/null || true

if [ -f /etc/nginx/nginx.conf ] && [ ! -f /etc/nginx/nginx.conf.gzmnet.bak ]; then
    cp /etc/nginx/nginx.conf /etc/nginx/nginx.conf.gzmnet.bak 2>/dev/null || true
fi

cat > /etc/nginx/nginx.conf <<'NGINX_MAIN'
user www-data;
worker_processes auto;
worker_rlimit_nofile 1000000;
pid /run/nginx.pid;
include /etc/nginx/modules-enabled/*.conf;
events { worker_connections 16384; multi_accept on; use epoll; }
http {
    sendfile on; tcp_nopush on; tcp_nodelay on; keepalive_timeout 65;
    types_hash_max_size 4096; server_tokens off;
    include /etc/nginx/mime.types; default_type application/octet-stream;
    ssl_protocols TLSv1.2 TLSv1.3; ssl_prefer_server_ciphers on;
    access_log off; error_log /var/log/nginx/error.log;
    gzip on; gzip_vary on; gzip_min_length 1024; gzip_comp_level 3;
    client_body_buffer_size 256k; client_max_body_size 100M;
    include /etc/nginx/conf.d/*.conf; include /etc/nginx/sites-enabled/*;
}
NGINX_MAIN

if [ -L /etc/resolv.conf ] && readlink /etc/resolv.conf 2>/dev/null | grep -q systemd; then
    mkdir -p /etc/systemd/resolved.conf.d
    cat > /etc/systemd/resolved.conf.d/gzmnet.conf <<'RESOLVEOF'
[Resolve]
DNS=8.8.8.8 1.1.1.1 8.8.4.4
FallbackDNS=
RESOLVEOF
    systemctl restart systemd-resolved 2>/dev/null || true
else
    printf 'nameserver 8.8.8.8\nnameserver 1.1.1.1\nnameserver 8.8.4.4\n' > /etc/resolv.conf
fi

for i in {1..10}; do
    if ping -c 1 8.8.8.8 > /dev/null 2>&1; then echo "Conectividad: OK"; break; fi
    if [ $i -eq 10 ]; then echo "Error: sin Internet."; exit 1; fi
    echo "Esperando... ($i)"; sleep 5
done

echo ""
read -p "Usuario administrador: " ADMIN_USER
read -sp "Contrasena: " ADMIN_PASS; echo
read -p "Dominio: " DOMAIN
if [ -z "$DOMAIN" ]; then echo "Error: dominio requerido."; exit 1; fi

PUBLIC_IP=$(curl -s4 --max-time 5 ifconfig.me 2>/dev/null || echo "")
DOMAIN_IP=$(getent hosts "$DOMAIN" 2>/dev/null | awk '{print $1}' | head -1)
echo "IP publica: $PUBLIC_IP  |  DNS $DOMAIN -> $DOMAIN_IP"
if [ -n "$PUBLIC_IP" ] && [ -n "$DOMAIN_IP" ] && [ "$PUBLIC_IP" != "$DOMAIN_IP" ]; then
    read -p "ATENCION: $DOMAIN resuelve a $DOMAIN_IP pero tu IP publica es $PUBLIC_IP. Continuar? [s/N]: " CONT
    [ "$CONT" != "s" ] && exit 1
fi

read -p "Puerto HTTPS del panel [Enter = 443]: " PANEL_PORT
PANEL_PORT=${PANEL_PORT:-443}
if ! [[ "$PANEL_PORT" =~ ^[0-9]+$ ]] || [ "$PANEL_PORT" -lt 1 ] || [ "$PANEL_PORT" -gt 65535 ]; then PANEL_PORT=443; fi
if [ "$PANEL_PORT" = "80" ]; then PANEL_PORT=443; fi

if [ "$PANEL_PORT" = "443" ]; then PANEL_URL="https://$DOMAIN"; else PANEL_URL="https://$DOMAIN:$PANEL_PORT"; fi
echo "Panel URL: $PANEL_URL"

apt_install() {
    local max_retries=5; local count=0
    until [ $count -ge $max_retries ]; do
        DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=-1 -o Dpkg::Options::=--force-confold install -y -qq --no-install-recommends --fix-missing "$@" && return 0
        count=$((count+1)); sleep 10; apt-get update -qq
    done
    return 1
}

apt-get -o DPkg::Lock::Timeout=-1 update -qq || true
apt_install nginx curl wget git ca-certificates build-essential sqlite3 libsqlite3-dev lsof cron openssl ufw unzip zip jq iproute2 socat tzdata iptables

curl -fsSL https://deb.nodesource.com/setup_20.x | bash - > /dev/null 2>&1
apt_install nodejs
timedatectl set-timezone America/Santo_Domingo 2>/dev/null || true

cat > /etc/sysctl.d/99-gzmnet-optimize.conf <<'SYSCTL_EOF'
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr
net.core.rmem_max = 268435456
net.core.wmem_max = 268435456
net.ipv4.tcp_rmem = 8192 262144 268435456
net.ipv4.tcp_wmem = 8192 262144 268435456
net.ipv4.tcp_fastopen = 3
net.ipv4.tcp_slow_start_after_idle = 0
net.ipv4.tcp_mtu_probing = 1
net.ipv4.tcp_keepalive_time = 300
net.ipv4.tcp_fin_timeout = 15
net.ipv4.tcp_tw_reuse = 1
net.ipv4.tcp_ecn = 1
net.ipv4.tcp_syncookies = 1
net.ipv4.tcp_notsent_lowat = 16384
net.ipv4.ip_local_port_range = 10240 65535
net.core.somaxconn = 65535
net.core.netdev_max_backlog = 65535
net.ipv4.tcp_max_syn_backlog = 65535
fs.file-max = 2000000
fs.nr_open = 2000000
vm.swappiness = 5
vm.overcommit_memory = 1
vm.max_map_count = 262144
SYSCTL_EOF

modprobe tcp_bbr 2>/dev/null || true
echo "tcp_bbr" > /etc/modules-load.d/bbr.conf 2>/dev/null || true
sysctl -p /etc/sysctl.d/99-gzmnet-optimize.conf > /dev/null 2>&1 || true

cat > /etc/security/limits.d/99-gzmnet.conf <<'LIMITS_EOF'
*    soft nofile 1000000
*    hard nofile 1000000
root soft nofile 1000000
root hard nofile 1000000
LIMITS_EOF

mkdir -p /etc/systemd/system/pm2-root.service.d
cat > /etc/systemd/system/pm2-root.service.d/limits.conf <<'P2LIM'
[Service]
LimitNOFILE=1000000
P2LIM
systemctl daemon-reload 2>/dev/null || true

curl -s https://get.acme.sh | sh -s email=admin@$DOMAIN > /dev/null 2>&1
source ~/.acme.sh/acme.sh.env 2>/dev/null || true

mkdir -p /root/gzmnet/{views,data,backups,public}
mkdir -p /var/www/html /etc/nginx/ssl
mkdir -p /var/log/xray
cd /root/gzmnet

SESSION_SECRET=$(openssl rand -hex 32)
jq -n --arg u "$ADMIN_USER" --arg p "$ADMIN_PASS" --arg s "$SESSION_SECRET" \
    '{adminUser:$u, adminPassword:$p, port:3000, sessionSecret:$s}' > config.json
chmod 600 /root/gzmnet/config.json
chmod 700 /root/gzmnet/data

jq -n --arg d "$DOMAIN" --argjson pp "$PANEL_PORT" \
    '{enabled:true, domain:$d, panelPort:$pp, subInterval:12, subPort:$pp, subPath:"/sub", subShowUsage:1, subTitle:"GZMNET VPN", subUserAgent:"", cacheEnabled:false, cacheTime:"04:00", cacheTimezone:"America/Santo_Domingo"}' > vpn_config.json
chmod 600 vpn_config.json

# ------------------------------------------------------------
# QR LOCAL: se descarga desde varias fuentes y se VERIFICA
# que el archivo realmente contenga la librería. Si todas
# fallan, se reintenta. Así nunca queda un archivo vacío que
# provoque "librería no cargada".
# ------------------------------------------------------------
QR_OK=0
QR_SOURCES=(
  "https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"
  "https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"
  "https://unpkg.com/qrcodejs@1.0.0/qrcode.min.js"
  "https://raw.githubusercontent.com/davidshimjs/qrcodejs/master/qrcode.min.js"
)
for attempt in 1 2 3; do
    for url in "${QR_SOURCES[@]}"; do
        if curl -fsSL --max-time 20 -o /root/gzmnet/public/qrcode.min.js "$url" 2>/dev/null; then
            if [ -s /root/gzmnet/public/qrcode.min.js ] && grep -q "QRCode" /root/gzmnet/public/qrcode.min.js; then
                QR_OK=1; echo "QR: descargado desde $url"; break 2
            fi
        fi
    done
    echo "QR: reintento $attempt..."; sleep 3
done
if [ $QR_OK -eq 0 ]; then
    echo "ADVERTENCIA: no se pudo descargar qrcode.min.js. El panel mostrara el enlace en texto."
fi
# ============================================================
# PARTE 2 de 4: init-db, Xray, geodata, WARP
# Continúa de la PARTE 1 y va seguida de la PARTE 3
# ============================================================

cd /root/gzmnet

cat > init-db.js <<'INITEOF'
const Database = require('better-sqlite3');
const path = require('path');
const db = new Database(path.join(__dirname, 'data', 'vpn.sqlite'));
db.pragma('journal_mode = WAL');
db.exec(`
  CREATE TABLE IF NOT EXISTS inbounds (
    id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, protocol TEXT NOT NULL,
    port INTEGER NOT NULL, network TEXT DEFAULT 'ws', path TEXT DEFAULT '/',
    tls INTEGER DEFAULT 0, domain TEXT DEFAULT '', host TEXT DEFAULT '',
    security TEXT DEFAULT 'none', flow TEXT DEFAULT '', sniffing INTEGER DEFAULT 1,
    encryption TEXT DEFAULT '', fingerprint TEXT DEFAULT 'chrome', alpn TEXT DEFAULT '',
    reality_dest TEXT DEFAULT '', reality_server_names TEXT DEFAULT '',
    reality_private_key TEXT DEFAULT '', reality_public_key TEXT DEFAULT '',
    reality_short_ids TEXT DEFAULT '',
    created_at TEXT DEFAULT (datetime('now','localtime')),
    updated_at TEXT DEFAULT (datetime('now','localtime'))
  );
  CREATE TABLE IF NOT EXISTS clients (
    id INTEGER PRIMARY KEY AUTOINCREMENT, inbound_id INTEGER NOT NULL,
    name TEXT NOT NULL, uuid TEXT NOT NULL, email TEXT, flow TEXT DEFAULT '',
    limit_gb REAL DEFAULT 0, enabled INTEGER DEFAULT 1, last_seen TEXT,
    up_bytes INTEGER DEFAULT 0, down_bytes INTEGER DEFAULT 0, total_bytes INTEGER DEFAULT 0,
    online INTEGER DEFAULT 0, sub_token TEXT, sub_blocked INTEGER DEFAULT 0,
    created_at TEXT DEFAULT (datetime('now','localtime')),
    FOREIGN KEY(inbound_id) REFERENCES inbounds(id) ON DELETE CASCADE
  );
  CREATE INDEX IF NOT EXISTS idx_clients_inbound ON clients(inbound_id);
  CREATE UNIQUE INDEX IF NOT EXISTS idx_clients_subtoken ON clients(sub_token);
  CREATE TABLE IF NOT EXISTS routing_settings (
    id INTEGER PRIMARY KEY CHECK (id = 1),
    block_ads INTEGER DEFAULT 0, block_adult INTEGER DEFAULT 0,
    block_malware INTEGER DEFAULT 0, block_trackers INTEGER DEFAULT 0,
    block_bittorrent INTEGER DEFAULT 0, prevent_captcha INTEGER DEFAULT 0,
    warp_enabled INTEGER DEFAULT 0, domain_strategy TEXT DEFAULT 'IPIfNonMatch',
    ip_type TEXT DEFAULT 'dual', fake_dns INTEGER DEFAULT 0,
    dns_primary TEXT DEFAULT '1.1.1.1', dns_secondary TEXT DEFAULT '8.8.8.8',
    dns_primary_v6 TEXT DEFAULT '2606:4700:4700::1111', dns_secondary_v6 TEXT DEFAULT '2001:4860:4860::8888',
    dns_query_strategy TEXT DEFAULT 'UseIP',
    cache_enabled INTEGER DEFAULT 0, cache_time TEXT DEFAULT '04:00',
    cache_timezone TEXT DEFAULT 'America/Santo_Domingo', last_cache_at TEXT,
    block_quic_global INTEGER DEFAULT 0,
    updated_at TEXT DEFAULT (datetime('now','localtime'))
  );
  CREATE TABLE IF NOT EXISTS routing_rules (
    id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL,
    match_type TEXT NOT NULL, value TEXT NOT NULL,
    outbound TEXT NOT NULL, enabled INTEGER DEFAULT 1,
    priority INTEGER DEFAULT 0, match_rules TEXT DEFAULT '',
    created_at TEXT DEFAULT (datetime('now','localtime'))
  );
  CREATE TABLE IF NOT EXISTS json_sub_settings (
    id INTEGER PRIMARY KEY CHECK (id = 1), enabled INTEGER DEFAULT 0,
    path TEXT DEFAULT '/subjson', bypass TEXT DEFAULT '',
    updated_at TEXT DEFAULT (datetime('now','localtime'))
  );
`);
const alters = [
  'ALTER TABLE routing_settings ADD COLUMN cache_time TEXT DEFAULT "04:00"',
  'ALTER TABLE routing_settings ADD COLUMN cache_timezone TEXT DEFAULT "America/Santo_Domingo"',
  'ALTER TABLE routing_settings ADD COLUMN cache_enabled INTEGER DEFAULT 0',
  'ALTER TABLE routing_settings ADD COLUMN last_cache_at TEXT',
  'ALTER TABLE routing_settings ADD COLUMN ip_type TEXT DEFAULT "dual"',
  'ALTER TABLE routing_settings ADD COLUMN prevent_captcha INTEGER DEFAULT 0',
  'ALTER TABLE routing_settings ADD COLUMN dns_primary_v6 TEXT DEFAULT "2606:4700:4700::1111"',
  'ALTER TABLE routing_settings ADD COLUMN dns_secondary_v6 TEXT DEFAULT "2001:4860:4860::8888"',
  'ALTER TABLE routing_settings ADD COLUMN block_quic_global INTEGER DEFAULT 0',
  'ALTER TABLE routing_rules ADD COLUMN priority INTEGER DEFAULT 0',
  'ALTER TABLE routing_rules ADD COLUMN match_rules TEXT DEFAULT ""',
  'ALTER TABLE clients ADD COLUMN sub_blocked INTEGER DEFAULT 0',
  'ALTER TABLE json_sub_settings ADD COLUMN bypass TEXT DEFAULT ""',
  'ALTER TABLE inbounds ADD COLUMN reality_dest TEXT DEFAULT ""',
  'ALTER TABLE inbounds ADD COLUMN reality_server_names TEXT DEFAULT ""',
  'ALTER TABLE inbounds ADD COLUMN reality_private_key TEXT DEFAULT ""',
  'ALTER TABLE inbounds ADD COLUMN reality_public_key TEXT DEFAULT ""',
  'ALTER TABLE inbounds ADD COLUMN reality_short_ids TEXT DEFAULT ""',
  'ALTER TABLE inbounds ADD COLUMN fingerprint TEXT DEFAULT "chrome"',
  'ALTER TABLE inbounds ADD COLUMN alpn TEXT DEFAULT ""'
];
for (const sql of alters) { try { db.exec(sql); } catch(e) {} }
const row = db.prepare('SELECT COUNT(*) as c FROM routing_settings').get();
if (!row || row.c === 0) db.prepare(`INSERT INTO routing_settings (id) VALUES (1)`).run();
const row2 = db.prepare('SELECT COUNT(*) as c FROM json_sub_settings').get();
if (!row2 || row2.c === 0) db.prepare(`INSERT INTO json_sub_settings (id) VALUES (1)`).run();
console.log('Base de datos lista');
INITEOF
node init-db.js || true

# ------------------------------------------------------------
# XRAY
# ------------------------------------------------------------
bash -c "$(curl -L https://github.com/XTLS/Xray-install/raw/main/install-release.sh)" @ install > /dev/null 2>&1 || true
if [ ! -f /usr/local/bin/xray ]; then
    ARCH=$(uname -m)
    case $ARCH in x86_64) XRAY_ARCH="64" ;; aarch64) XRAY_ARCH="arm64-v8a" ;; *) XRAY_ARCH="64" ;; esac
    curl -L -o /tmp/xray.zip "https://github.com/XTLS/Xray-core/releases/download/v25.9.11/Xray-linux-${XRAY_ARCH}.zip"
    mkdir -p /usr/local/bin /usr/local/etc/xray
    unzip -o /tmp/xray.zip -d /usr/local/bin/ > /dev/null 2>&1
    rm -f /tmp/xray.zip
fi
chmod +x /usr/local/bin/xray 2>/dev/null || true
echo "Xray: $(/usr/local/bin/xray version 2>/dev/null | head -1 || echo desconocida)"

mkdir -p /usr/local/share/xray
curl -fsSL -o /usr/local/share/xray/geoip.dat "https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geoip.dat" 2>/dev/null || true
curl -fsSL -o /usr/local/share/xray/geosite.dat "https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geosite.dat" 2>/dev/null || true
ln -sf /usr/local/share/xray/geoip.dat /usr/local/bin/geoip.dat 2>/dev/null || true
ln -sf /usr/local/share/xray/geosite.dat /usr/local/bin/geosite.dat 2>/dev/null || true

if [ ! -f /root/gzmnet/data/vless_decryption.key ] || [ ! -f /root/gzmnet/data/vless_encryption.key ]; then
    VLESSENC_OUTPUT=$(/usr/local/bin/xray vlessenc 2>&1 | tr -d '\r')
    VLESSENC_FLAT=$(printf '%s' "$VLESSENC_OUTPUT" | tr '\n' ' ')
    DECRYPTION_KEY=$(printf '%s' "$VLESSENC_FLAT" | sed -n 's/.*"decryption"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
    ENCRYPTION_KEY=$(printf '%s' "$VLESSENC_FLAT" | sed -n 's/.*"encryption"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
    [ -z "$DECRYPTION_KEY" ] && DECRYPTION_KEY="none"
    [ -z "$ENCRYPTION_KEY" ] && ENCRYPTION_KEY="none"
    echo "$DECRYPTION_KEY" > /root/gzmnet/data/vless_decryption.key
    echo "$ENCRYPTION_KEY" > /root/gzmnet/data/vless_encryption.key
    chmod 600 /root/gzmnet/data/vless_decryption.key /root/gzmnet/data/vless_encryption.key
fi

mkdir -p /usr/local/etc/xray
cat > /usr/local/etc/xray/config.json <<'XRAYEOF'
{
  "log": {"loglevel": "warning"},
  "api": {"tag": "api", "services": ["HandlerService", "LoggerService", "StatsService"]},
  "stats": {},
  "policy": {
    "levels": { "0": { "statsUserUplink": true, "statsUserDownlink": true } },
    "system": { "statsInboundUplink": true, "statsInboundDownlink": true, "statsOutboundUplink": true, "statsOutboundDownlink": true }
  },
  "inbounds": [
    {"tag": "api", "listen": "127.0.0.1", "port": 10085, "protocol": "dokodemo-door", "settings": {"address": "127.0.0.1"}}
  ],
  "outbounds": [
    {"protocol": "freedom", "tag": "direct"},
    {"protocol": "blackhole", "tag": "block"}
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "domainMatcher": "hybrid",
    "rules": [{"type": "field", "inboundTag": ["api"], "outboundTag": "api"}]
  }
}
XRAYEOF

cat > /usr/local/bin/xray-pm2-wrapper.sh <<'WRAPEOF'
#!/bin/bash
ulimit -n 1000000 2>/dev/null || ulimit -n 65535 2>/dev/null || true
export XRAY_LOCATION_ASSET=/usr/local/share/xray
CONFIG="/usr/local/etc/xray/config.json"
LOG="/root/gzmnet/data/xray-daemon.log"
mkdir -p "$(dirname "$LOG")"
echo "[$(date)] === Wrapper v3.4.0 iniciado ===" >> "$LOG"
CHILD_PID=""
shutdown() {
    [ -n "$CHILD_PID" ] && kill -TERM "$CHILD_PID" 2>/dev/null && wait "$CHILD_PID" 2>/dev/null
    exit 0
}
trap shutdown SIGTERM SIGINT SIGHUP
sleep 3
while true; do
    [ ! -f "$CONFIG" ] && sleep 5 && continue
    START_TS=$(date +%s)
    /usr/local/bin/xray run -config "$CONFIG" >> "$LOG" 2>&1 &
    CHILD_PID=$!
    wait "$CHILD_PID"
    EXIT=$?
    CHILD_PID=""
    END_TS=$(date +%s)
    UPTIME=$((END_TS - START_TS))
    if [ -f "$LOG" ]; then
        SIZE=$(stat -c%s "$LOG" 2>/dev/null || echo 0)
        [ "$SIZE" -gt 5242880 ] && tail -500 "$LOG" > "$LOG.tmp" && cat "$LOG.tmp" > "$LOG" && rm -f "$LOG.tmp"
    fi
    if [ $EXIT -eq 23 ]; then sleep 30
    elif [ "$UPTIME" -lt 3 ]; then sleep 5
    else sleep 2; fi
done
WRAPEOF
chmod +x /usr/local/bin/xray-pm2-wrapper.sh

# ------------------------------------------------------------
# WARP (WireProxy)
# ------------------------------------------------------------
echo ""
echo "Instalando WARP (WireProxy)..."
WP_ARCH=$(uname -m)
case $WP_ARCH in x86_64) WP_ARCH_NAME="amd64" ;; aarch64) WP_ARCH_NAME="arm64" ;; *) WP_ARCH_NAME="amd64" ;; esac

if ! command -v wireproxy >/dev/null 2>&1; then
    curl -fsSL -o /tmp/wireproxy.tar.gz "https://github.com/pufferffish/wireproxy/releases/download/v1.0.9/wireproxy_linux_${WP_ARCH_NAME}.tar.gz" 2>/dev/null || true
    if [ -f /tmp/wireproxy.tar.gz ]; then
        tar -xzf /tmp/wireproxy.tar.gz -C /tmp/ 2>/dev/null || true
        [ -f /tmp/wireproxy ] && mv /tmp/wireproxy /usr/local/bin/wireproxy && chmod +x /usr/local/bin/wireproxy
        rm -f /tmp/wireproxy.tar.gz
    fi
fi

if ! command -v wgcf >/dev/null 2>&1; then
    curl -fsSL -o /usr/local/bin/wgcf "https://github.com/ViRb3/wgcf/releases/download/v2.2.22/wgcf_2.2.22_linux_${WP_ARCH_NAME}" 2>/dev/null || true
    chmod +x /usr/local/bin/wgcf 2>/dev/null || true
fi

if command -v wireproxy >/dev/null 2>&1 && command -v wgcf >/dev/null 2>&1; then
    mkdir -p /etc/wireproxy
    cd /etc/wireproxy
    [ ! -f wgcf-account.toml ] && wgcf register --accept-tos >/dev/null 2>&1 || true
    [ -f wgcf-account.toml ] && wgcf generate >/dev/null 2>&1 || true
    if [ -f wgcf-profile.conf ]; then
        grep -q "^MTU" wgcf-profile.conf && sed -i 's|^MTU.*|MTU = 1420|' wgcf-profile.conf || sed -i '/\[Interface\]/a MTU = 1420' wgcf-profile.conf
        if ! grep -q "\[Socks5\]" wgcf-profile.conf; then printf '\n[Socks5]\nBindAddress = 127.0.0.1:40000\n' >> wgcf-profile.conf; else sed -i 's|^BindAddress.*|BindAddress = 127.0.0.1:40000|' wgcf-profile.conf; fi
        cat > /etc/systemd/system/wireproxy.service <<'WSEOF'
[Unit]
Description=WireProxy (WARP SOCKS5)
After=network.target
Wants=network-online.target
[Service]
Type=simple
ExecStart=/usr/local/bin/wireproxy -c /etc/wireproxy/wgcf-profile.conf
Restart=always
RestartSec=3
LimitNOFILE=1048576
[Install]
WantedBy=multi-user.target
WSEOF
        systemctl daemon-reload >/dev/null 2>&1
        systemctl enable wireproxy >/dev/null 2>&1
        systemctl restart wireproxy >/dev/null 2>&1
        sleep 2
        systemctl is-active --quiet wireproxy && echo "WARP: OK" || echo "WARP: no arranco"
    fi
fi

cd /root/gzmnet
# ============================================================
# PARTE 3 de 4: app.js (backend completo)
# Continúa de la PARTE 2 y va seguida de la PARTE 4
# ============================================================

cat <<'APPEOF' > app.js
process.env.TZ = 'America/Santo_Domingo';
process.env.XRAY_LOCATION_ASSET = '/usr/local/share/xray';

process.on('uncaughtException', (err) => {
    console.error('[UNCAUGHT]', err && err.message ? err.message : err);
    try { require('fs').appendFileSync('/root/gzmnet/data/apply.log', `[${new Date().toISOString()}] UNCAUGHT: ${err && err.stack ? err.stack : err}\n`); } catch(e) {}
});
process.on('unhandledRejection', (reason) => { console.error('[UNHANDLED]', reason && reason.message ? reason.message : reason); });

const fs = require('fs');
const path = require('path');
const crypto = require('crypto');
const express = require('express');
const http = require('http');
const socketIo = require('socket.io');
const session = require('express-session');
const os = require('os');
const { exec } = require('child_process');
const Database = require('better-sqlite3');

const APP_VERSION = '3.4.0';
const app = express();
app.set('trust proxy', 1);
app.disable('x-powered-by');
const server = http.createServer(app);
server.keepAliveTimeout = 65000;
server.headersTimeout = 66000;
const io = socketIo(server, { pingTimeout: 30000, pingInterval: 20000, transports: ['websocket', 'polling'], maxHttpBufferSize: 1e6 });

const BASE_DIR = __dirname;
const DATA_DIR = path.join(BASE_DIR, 'data');
const BACKUP_DIR = path.join(BASE_DIR, 'backups');
const VPN_DB_PATH = path.join(DATA_DIR, 'vpn.sqlite');
const CONFIG_PATH = path.join(BASE_DIR, 'config.json');
const VPN_CONFIG_PATH = path.join(BASE_DIR, 'vpn_config.json');
const VLESS_DECRYPTION_KEY_PATH = path.join(DATA_DIR, 'vless_decryption.key');
const VLESS_ENCRYPTION_KEY_PATH = path.join(DATA_DIR, 'vless_encryption.key');
const APPLY_LOG = path.join(DATA_DIR, 'apply.log');
