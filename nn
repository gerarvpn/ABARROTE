let applyChain = Promise.resolve();
let lastWrittenConfigHash = '';
let xrayHealthy = true;
let applyDebounceTimer = null;
const APPLY_DEBOUNCE_MS = 1500;
let isApplying = false;
let pendingApply = false;
let forceNextApply = false;
let cachedConfig = null, cachedConfigHash = '', cachedConfigTime = 0;
const CONFIG_CACHE_TTL = 2000;

function hashString(s) { return crypto.createHash('sha1').update(s).digest('hex'); }
function invalidateConfigCache() { cachedConfig = null; cachedConfigHash = ''; cachedConfigTime = 0; }
function getCachedConfig() {
    const now = Date.now();
    if (cachedConfig && (now - cachedConfigTime) < CONFIG_CACHE_TTL) return { config: cachedConfig, hash: cachedConfigHash };
    const config = buildXrayConfig();
    const hash = hashString(JSON.stringify(config));
    cachedConfig = config; cachedConfigHash = hash; cachedConfigTime = now;
    return { config, hash };
}
async function waitXrayReady(maxMs = 10000) {
    const start = Date.now();
    while ((Date.now() - start) < maxMs) { if (await checkXrayActive()) return true; await new Promise(r => setTimeout(r, 500)); }
    return false;
}
async function _doApplyInternal() {
    try {
        const { config: newConfig, hash: newHash } = getCachedConfig();
        const newConfigStr = JSON.stringify(newConfig, null, 2);
        if (!forceNextApply && newHash === lastWrittenConfigHash) return { ok: true, skipped: true };
        forceNextApply = false;
        const valid = await validateXrayConfig(newConfigStr);
        if (!valid.ok) {
            logApply('CONFIG INVALIDA: ' + (valid.output || '').substring(0, 300));
            try { io.emit('xray_error', { error: 'Config invalida', context: 'validation' }); } catch(e){}
            return { ok: false, error: 'Config invalida' };
        }
        if (fs.existsSync(XRAY_CONFIG)) { try { fs.copyFileSync(XRAY_CONFIG, XRAY_CONFIG_BAK); } catch (e) {} }
        fs.writeFileSync(XRAY_CONFIG, newConfigStr);
        await restartXrayNow();
        const active = await waitXrayReady(10000);
        if (!active) {
            if (fs.existsSync(XRAY_CONFIG_BAK)) {
                try { fs.copyFileSync(XRAY_CONFIG_BAK, XRAY_CONFIG); await restartXrayNow(); await waitXrayReady(10000); } catch (e) {}
                try { io.emit('xray_error', { error: 'Xray no arranco. Backup restaurado.', context: 'restart' }); } catch(e){}
                return { ok: false, error: 'Xray no arranco. Backup restaurado.' };
            }
            return { ok: false, error: 'Xray no arranco. Sin backup.' };
        }
        xrayHealthy = true;
        lastWrittenConfigHash = newHash;
        try { io.emit('xray_applied', { ok: true }); } catch(e){}
        return { ok: true };
    } catch (e) {
        logApply('EXCEPTION: ' + e.message);
        return { ok: false, error: e.message };
    }
}
function applyXrayNow() {
    const myPromise = applyChain.then(async () => {
        if (isApplying) { pendingApply = true; return { ok: true, queued: true }; }
        isApplying = true;
        try {
            let result = await _doApplyInternal();
            while (pendingApply) { pendingApply = false; await new Promise(r => setTimeout(r, 400)); const r2 = await _doApplyInternal(); if (r2 && !r2.skipped) result = r2; }
            return result;
        } finally { isApplying = false; }
    }).catch((e) => ({ ok: false, error: e.message || String(e) }));
    applyChain = myPromise.catch(() => {});
    return myPromise;
}
function scheduleApply(force = true) {
    if (force) forceNextApply = true;
    invalidateConfigCache();
    if (applyDebounceTimer) clearTimeout(applyDebounceTimer);
    applyDebounceTimer = setTimeout(() => { applyDebounceTimer = null; applyXrayNow(); }, APPLY_DEBOUNCE_MS);
}

