// Pública: /p/ruta
function serveWebPage(req, res) {
    try {
        let slug = '';
        if (req.params && req.params.slug) slug = req.params.slug;
        else if (req.params && req.params[0]) slug = req.params[0];
        else slug = String(req.path || '').replace(/^\/p\/?/, '');
        slug = slugifyPath(slug);
        if (!slug) return res.status(404).send('Not found');
        if (!vpnDb) return res.status(503).send('DB no lista');
        const row = vpnDb.prepare('SELECT * FROM web_pages WHERE path = ? AND enabled = 1').get(slug);
        if (!row) return res.status(404).send('<!DOCTYPE html><html><body style="font-family:system-ui;background:#0a0a0c;color:#a1a1aa;display:flex;align-items:center;justify-content:center;height:100vh;margin:0"><div>Página no encontrada</div></body></html>');
        res.setHeader('Content-Type', 'text/html; charset=utf-8');
        res.setHeader('X-Robots-Tag', 'noindex');
        res.send(row.html || '<!DOCTYPE html><html><body></body></html>');
    } catch(e) { res.status(500).send('Error'); }
}
app.get('/p/:slug', serveWebPage);
app.get('/p/:slug', serveWebPage);
app.use('/p', (req, res, next) => {
    if (req.method !== 'GET' && req.method !== 'HEAD') return next();
    const slug = slugifyPath(String(req.path || '').replace(/^\/+/, ''));
    if (!slug) return res.status(404).send('Not found');
    req.params = req.params || {};
    req.params.slug = slug;
    return serveWebPage(req, res);
});


