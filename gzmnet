    else params.set('security', 'none');

    if (c.protocol === 'vless') {
        const encKey = getVlessEncryptionKey();
        if (encKey && encKey !== 'none') params.set('encryption', encKey);
        if (flow) params.set('flow', flow);
        return `vless://${c.uuid}@${address}:${port}?${params.toString()}#${encodeURIComponent(c.name)}`;
    }
    if (c.protocol === 'vmess') {
        const vmessNet = network === 'raw' ? 'tcp' : network;
        const vmess = { v: "2", ps: c.name, add: address, port: port, id: c.uuid, aid: "0", scy: "auto", net: vmessNet, type: "none", host: hostHeader, path: pathValue, tls: security === 'none' ? "" : security, sni: security !== 'none' ? sni : "", fp: security !== 'none' ? (c.fingerprint || 'chrome') : "" };
