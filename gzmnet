#!/bin/bash

clear
# Colores ANSI (azul moderno)
C0='\033[0m'; CB='\033[1m'; CD='\033[2m'
CBL='\033[38;5;39m'; CG='\033[38;5;39m'; CY='\033[38;5;220m'; CW='\033[38;5;255m'; CR='\033[38;5;203m'
C_BLUE='\033[38;5;39m'
C_DIM='\033[38;5;245m'
C_RST='\033[0m'
C_GREEN='\033[38;5;39m'
INSTALL_STEP=0
INSTALL_TOTAL=12
INSTALL_ERRORS=""

_clear_line(){ printf '\r\033[K'; }

# Barra fija: una sola línea, se actualiza in-place 1%→100%
_progress(){
  local cur=$1 total=$2
  local label="${3:-}"
  local pct=0
  if [ "$total" -gt 0 ]; then pct=$(( cur * 100 / total )); fi
  [ "$pct" -gt 100 ] && pct=100
  local width=36
  local filled=$(( pct * width / 100 ))
  local empty=$(( width - filled ))
  local bar='' i
  for i in $(seq 1 $filled); do bar="${bar}█"; done
  for i in $(seq 1 $empty); do bar="${bar}░"; done
  # fd 3 = terminal durante install silenciosa; si no, stdout
  if { true >&3; } 2>/dev/null; then
    printf "\r\033[K  ${C_BLUE}%s${C_RST} ${CW}%3d%%${C_RST}  ${C_DIM}%s${C_RST}" "$bar" "$pct" "$label" >&3
  else
    printf "\r\033[K  ${C_BLUE}%s${C_RST} ${CW}%3d%%${C_RST}  ${C_DIM}%s${C_RST}" "$bar" "$pct" "$label"
  fi
}

_banner(){
  printf "\n"
  printf "${C_BLUE}${CB}"
  printf "\n"
  printf "   ██████╗ ███████╗███╗   ███╗███╗   ██╗███████╗████████╗\n"
  printf "  ██╔════╝ ╚══███╔╝████╗ ████║████╗  ██║██╔════╝╚══██╔══╝\n"
  printf "  ██║  ███╗  ███╔╝ ██╔████╔██║██╔██╗ ██║█████╗     ██║\n"
  printf "  ██║   ██║ ███╔╝  ██║╚██╔╝██║██║╚██╗██║██╔══╝     ██║\n"
  printf "  ╚██████╔╝███████╗██║ ╚═╝ ██║██║ ╚████║███████╗   ██║\n"
  printf "   ╚═════╝ ╚══════╝╚═╝     ╚═╝╚═╝  ╚═══╝╚══════╝   ╚═╝\n"
  printf "\n"
  printf "                    G Z M N E T\n"
  printf "${C_RST}"
  printf "${CW}               VPN Panel  ·  v0.0.1${C_RST}\n\n"
}

_step(){
  INSTALL_STEP=$((INSTALL_STEP + 1))
  local label="$1"
  _progress "$INSTALL_STEP" "$INSTALL_TOTAL" "$label"
}
_ok(){ :; }
_info(){ :; }
_warn(){ INSTALL_ERRORS="${INSTALL_ERRORS}\n  ! $1"; }
_quiet(){ "$@" >/dev/null 2>&1; }
_err(){ INSTALL_ERRORS="${INSTALL_ERRORS}\n  ✗ $1"; }
_start_quiet_install(){
  # Guarda terminal en fd 3; todo lo demás a log
  INSTALL_LOG="/tmp/gzmnet-install-$$.log"
  exec 3>&1
  exec >>"$INSTALL_LOG" 2>&1
}
_end_quiet_install(){
  # Restaura terminal
  exec 1>&3 2>&3 3>&-
  printf "\n" || true
}
export PM2_DISCRETE_MODE=true
export npm_config_loglevel=error

# PM2: nunca muestra "already online" / "already launched"
pm2_ensure() {
  local name="$1"; shift
  if pm2 describe "$name" >/dev/null 2>&1; then
    pm2 restart "$name" --update-env >/dev/null 2>&1 || true
  else
    pm2 start "$@" --name "$name" >/dev/null 2>&1 || true
  fi
}
pm2_restart_quiet() {
  local name="$1"
  if pm2 describe "$name" >/dev/null 2>&1; then
    pm2 restart "$name" --update-env >/dev/null 2>&1 || true
  else
    return 0
  fi
}
pm2_delete_quiet() {
  local name="$1"
  if pm2 describe "$name" >/dev/null 2>&1; then
    pm2 delete "$name" >/dev/null 2>&1 || true
  fi
}
set +e
trap 'true' ERR
_banner

if [ "$EUID" -ne 0 ]; then echo "Error: ejecuta como root (sudo)."; exit 1; fi

# ============ LIBERACIÓN SILENCIOSA DEL PUERTO 80 ============
{
    if [ -f "/root/gzmnet/data/vpn.sqlite" ]; then
        XRAY_ON_80=$(sqlite3 "/root/gzmnet/data/vpn.sqlite" "SELECT COUNT(*) FROM inbounds WHERE port = 80" 2>/dev/null || echo 0)
        if [ "$XRAY_ON_80" -gt 0 ]; then
            pm2 stop xray --silent 2>/dev/null || true
            pkill -9 -f "xray run" 2>/dev/null || true
            sleep 2
        fi
    fi
    systemctl stop nginx 2>/dev/null || true
    systemctl stop apache2 2>/dev/null || true
    pkill -9 nginx 2>/dev/null || true
    pkill -9 apache2 2>/dev/null || true
} > /dev/null 2>&1
sleep 2
for i in {1..10}; do
    if ! ss -tln | grep -q ':80 '; then break; fi
    fuser -k -9 80/tcp 2>/dev/null || true
    sleep 2
done

# ============ PREPARACIÓN ============
mkdir -p /etc/nginx/sites-enabled /etc/nginx/sites-available /etc/nginx/conf.d /etc/nginx/ssl /var/www/html
rm -f /etc/nginx/conf.d/gzmnet*.conf 2>/dev/null || true
rm -f /etc/nginx/sites-enabled/gzmnet /etc/nginx/sites-enabled/default 2>/dev/null || true
[ -f /etc/nginx/nginx.conf ] && [ ! -f /etc/nginx/nginx.conf.gzmnet.bak ] && cp /etc/nginx/nginx.conf /etc/nginx/nginx.conf.gzmnet.bak 2>/dev/null || true

cat > /etc/nginx/nginx.conf <<'NGINX_MAIN'
user www-data;
worker_processes auto;
worker_rlimit_nofile 1000000;
pid /run/nginx.pid;
include /etc/nginx/modules-enabled/*.conf;
events { worker_connections 16384; multi_accept on; use epoll; }
http {
    sendfile on; tcp_nopush on; tcp_nodelay on; keepalive_timeout 65;
    types_hash_max_size 4096; server_tokens off;
    include /etc/nginx/mime.types; default_type application/octet-stream;
    ssl_protocols TLSv1.2 TLSv1.3; ssl_prefer_server_ciphers on;
    access_log off; error_log /var/log/nginx/error.log;
    gzip on; gzip_vary on; gzip_min_length 1024; gzip_comp_level 3;
    client_body_buffer_size 256k; client_max_body_size 100M;
    include /etc/nginx/conf.d/*.conf; include /etc/nginx/sites-enabled/*;
}
NGINX_MAIN

if [ -L /etc/resolv.conf ] && readlink /etc/resolv.conf 2>/dev/null | grep -q systemd; then
    mkdir -p /etc/systemd/resolved.conf.d
    cat > /etc/systemd/resolved.conf.d/gzmnet.conf <<'RESOLVEOF'
[Resolve]
DNS=8.8.8.8 1.1.1.1 8.8.4.4
FallbackDNS=
RESOLVEOF
    systemctl restart systemd-resolved 2>/dev/null || true
else
    printf 'nameserver 8.8.8.8\nnameserver 1.1.1.1\nnameserver 8.8.4.4\n' > /etc/resolv.conf
fi

for i in {1..10}; do
    if ping -c 1 8.8.8.8 > /dev/null 2>&1; then _ok "Internet OK"; break; fi
    if [ $i -eq 10 ]; then echo "Error: sin Internet."; exit 1; fi
    echo "Esperando... ($i)"; sleep 5
done

# ============ INSTALACIÓN INTELIGENTE ============
echo ""
echo -e "  \033[38;5;255m\033[1m┌────────────────────────────────────────────┐\033[0m"
echo -e "  \033[38;5;255m\033[1m│\033[0m  \033[38;5;255m\033[1mConfiguración del panel GZMNET\033[0m           \033[38;5;255m\033[1m│\033[0m"
echo -e "  \033[38;5;255m\033[1m└────────────────────────────────────────────┘\033[0m"
echo ""

EXISTING_USER=""
EXISTING_PASS=""
EXISTING_DOMAIN=""
EXISTING_PORT=""
EXISTING_SECRET=""

# Migrar config.json antiguo del panel → panel.json (si aplica)
if [ -f /root/gzmnet/config.json ] && [ ! -f /root/gzmnet/panel.json ]; then
    # Solo migrar si parece config del panel (tiene adminUser)
    if jq -e '.adminUser' /root/gzmnet/config.json >/dev/null 2>&1; then
        mv -f /root/gzmnet/config.json /root/gzmnet/panel.json
        : # "  ✓ Migrado config.json → panel.json"
    fi
fi

# Detectar instalación previa
_PCFG=""
if [ -f /root/gzmnet/panel.json ]; then
    _PCFG=/root/gzmnet/panel.json
elif [ -f /root/gzmnet/config.json ] && jq -e '.adminUser' /root/gzmnet/config.json >/dev/null 2>&1; then
    _PCFG=/root/gzmnet/config.json
fi

if [ -n "$_PCFG" ] && [ -f /root/gzmnet/vpn_config.json ]; then
    EXISTING_USER=$(jq -r '.adminUser // empty' "$_PCFG" 2>/dev/null)
    EXISTING_PASS=$(jq -r '.adminPassword // empty' "$_PCFG" 2>/dev/null)
    EXISTING_SECRET=$(jq -r '.sessionSecret // empty' "$_PCFG" 2>/dev/null)
    EXISTING_DOMAIN=$(jq -r '.domain // empty' /root/gzmnet/vpn_config.json 2>/dev/null)
    EXISTING_PORT=$(jq -r '.panelPort // 443' /root/gzmnet/vpn_config.json 2>/dev/null)
fi

ADMIN_USER=""
ADMIN_PASS=""
DOMAIN=""
PANEL_PORT=""

if [ -n "$EXISTING_USER" ]; then
    echo ""
    echo "  📦 Instalación previa detectada:"
    echo ""
    echo "     Usuario:  $EXISTING_USER"
    echo "     Dominio:  $EXISTING_DOMAIN"
    echo "     Puerto:   $EXISTING_PORT"
    echo ""
    read -p "  ¿Deseas mantener estas credenciales? [S/n]: " USE_EXISTING
    USE_EXISTING=${USE_EXISTING:-S}
    if [[ "$USE_EXISTING" =~ ^[SsYy]$ ]]; then
        ADMIN_USER="$EXISTING_USER"
        ADMIN_PASS="$EXISTING_PASS"
        DOMAIN="$EXISTING_DOMAIN"
        PANEL_PORT="${EXISTING_PORT:-443}"
        SESSION_SECRET_KEEP="$EXISTING_SECRET"
        : # "  ✓ Credenciales existentes conservadas (usuario: $ADMIN_USER)"
    else
        echo "  → Se pedirán credenciales nuevas (la BD y clientes se mantienen)"
    fi
fi

if [ -z "$ADMIN_USER" ] || [ -z "$DOMAIN" ]; then
    echo ""
    echo -e "  ${CBL}┌─ Configuración del panel ─────────────────────┐${C0}"
    echo -e "  ${CBL}│${C0}  Completa los datos. No se muestran en claro   ${CBL}│${C0}"
    echo -e "  ${CBL}│${C0}  las contraseñas.                              ${CBL}│${C0}"
    echo -e "  ${CBL}└───────────────────────────────────────────────┘${C0}"
    echo ""
    while true; do
        echo -ne "  ${CBL}▸${C0} Usuario administrador: "
        read ADMIN_USER
        [ -z "$ADMIN_USER" ] && echo -e "     ${CR}✗ Obligatorio${C0}" && continue
        break
    done
    echo ""
    while true; do
        echo -ne "  ${CBL}▸${C0} Contraseña: "
        read -rs ADMIN_PASS
        echo ""
        [ -z "$ADMIN_PASS" ] && echo -e "     ${CR}✗ Obligatorio${C0}" && continue
        echo -ne "  ${CBL}▸${C0} Confirmar contraseña: "
        read -rs ADMIN_PASS2
        echo ""
        [ "$ADMIN_PASS" != "$ADMIN_PASS2" ] && echo -e "     ${CR}✗ No coinciden${C0}" && continue
        break
    done
    echo ""
    while true; do
        echo -ne "  ${CBL}▸${C0} Dominio (ej: panel.midominio.com): "
        read DOMAIN
        [ -z "$DOMAIN" ] && echo -e "     ${CR}✗ Obligatorio${C0}" && continue
        break
    done
    echo ""
    echo -e "  ${CBL}┌─ Resumen ─────────────────────────────────────┐${C0}"
    echo -e "  ${CBL}│${C0}  Usuario:    ${CB}$ADMIN_USER${C0}"
    echo -e "  ${CBL}│${C0}  Dominio:    ${CB}$DOMAIN${C0}"
    echo -e "  ${CBL}│${C0}  Contraseña: ${CD}********${C0}"
    echo -e "  ${CBL}└───────────────────────────────────────────────┘${C0}"
    echo ""
    echo -ne "  ${CBL}▸${C0} ¿Confirmar e instalar? [S/n]: "
    read CONFIRM
    CONFIRM=${CONFIRM:-S}
    if [[ ! "$CONFIRM" =~ ^[SsYy]$ ]]; then
        echo -e "  ${CR}Instalación cancelada.${C0}"
        exit 1
    fi
fi

[ -z "$DOMAIN" ] && { echo "Error: dominio requerido."; exit 1; }

SERVER_TZ="America/Santo_Domingo"
timedatectl set-timezone "$SERVER_TZ" 2>/dev/null || true

PUBLIC_IP=$(curl -s4 --max-time 5 ifconfig.me 2>/dev/null || echo "")
DOMAIN_IP=$(getent hosts "$DOMAIN" 2>/dev/null | awk '{print $1}' | head -1)
echo "IP publica: $PUBLIC_IP  |  DNS $DOMAIN -> $DOMAIN_IP"
if [ -n "$PUBLIC_IP" ] && [ -n "$DOMAIN_IP" ] && [ "$PUBLIC_IP" != "$DOMAIN_IP" ]; then
    read -p "ATENCION: $DOMAIN resuelve a $DOMAIN_IP pero tu IP publica es $PUBLIC_IP. Continuar? [s/N]: " CONT
    [ "$CONT" != "s" ] && exit 1
fi

if [ -z "$PANEL_PORT" ]; then
    echo -ne "  ${CBL}▸${C0} Puerto HTTPS del panel [Enter = 443]: "; read PANEL_PORT
    PANEL_PORT=${PANEL_PORT:-443}
fi
if ! [[ "$PANEL_PORT" =~ ^[0-9]+$ ]] || [ "$PANEL_PORT" -lt 1 ] || [ "$PANEL_PORT" -gt 65535 ]; then PANEL_PORT=443; fi
[ "$PANEL_PORT" = "80" ] && PANEL_PORT=443

if [ "$PANEL_PORT" = "443" ]; then PANEL_URL="https://$DOMAIN"; else PANEL_URL="https://$DOMAIN:$PANEL_PORT"; fi
echo "Panel URL: $PANEL_URL"

# ============ FUNCIONES AUXILIARES ============
apt_install() {
    local max_retries=5; local count=0
    until [ $count -ge $max_retries ]; do
        DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=-1 -o Dpkg::Options::=--force-confold install -y -qq --no-install-recommends --fix-missing "$@" && return 0
        count=$((count+1)); sleep 10; apt-get update -qq
    done
    return 1
}

apt-get -o DPkg::Lock::Timeout=-1 update -qq || true
apt_install nginx curl wget git ca-certificates build-essential sqlite3 libsqlite3-dev lsof cron openssl ufw unzip zip jq iproute2 socat tzdata iptables libcairo2-dev libpango1.0-dev libjpeg-dev libgif-dev librsvg2-dev pkg-config psmisc

curl -fsSL https://deb.nodesource.com/setup_20.x | bash - > /dev/null 2>&1
apt_install nodejs

# ============ OPTIMIZACIÓN DEL SISTEMA ============
cat > /etc/sysctl.d/99-gzmnet-optimize.conf <<'SYSCTL_EOF'
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr
net.core.rmem_max = 268435456
net.core.wmem_max = 268435456
net.ipv4.tcp_rmem = 8192 262144 268435456
net.ipv4.tcp_wmem = 8192 262144 268435456
net.ipv4.tcp_fastopen = 3
net.ipv4.tcp_slow_start_after_idle = 0
net.ipv4.tcp_mtu_probing = 1
net.ipv4.tcp_keepalive_time = 300
net.ipv4.tcp_fin_timeout = 15
net.ipv4.tcp_tw_reuse = 1
net.ipv4.tcp_ecn = 1
net.ipv4.tcp_syncookies = 1
net.ipv4.tcp_notsent_lowat = 16384
net.ipv4.ip_local_port_range = 10240 65535
net.core.somaxconn = 65535
net.core.netdev_max_backlog = 65535
net.ipv4.tcp_max_syn_backlog = 65535
net.ipv4.tcp_window_scaling = 1
net.ipv4.tcp_timestamps = 1
net.ipv4.tcp_sack = 1
fs.file-max = 2000000
fs.nr_open = 2000000
vm.swappiness = 5
vm.overcommit_memory = 1
vm.max_map_count = 262144
SYSCTL_EOF

modprobe tcp_bbr 2>/dev/null || true
echo "tcp_bbr" > /etc/modules-load.d/bbr.conf 2>/dev/null || true
sysctl -p /etc/sysctl.d/99-gzmnet-optimize.conf > /dev/null 2>&1 || true

cat > /etc/security/limits.d/99-gzmnet.conf <<'LIMITS_EOF'
*    soft nofile 1000000
*    hard nofile 1000000
root soft nofile 1000000
root hard nofile 1000000
LIMITS_EOF

mkdir -p /etc/systemd/system/pm2-root.service.d
cat > /etc/systemd/system/pm2-root.service.d/limits.conf <<'P2LIM'
[Service]
LimitNOFILE=1000000
P2LIM
systemctl daemon-reload 2>/dev/null || true

# ============ ACME.SH ============
curl -s https://get.acme.sh | sh -s email=admin@$DOMAIN > /dev/null 2>&1
source ~/.acme.sh/acme.sh.env 2>/dev/null || true

# ============ DIRECTORIOS Y CONFIG ============
mkdir -p /root/gzmnet/{views,data,backups,public}
mkdir -p /var/www/html /etc/nginx/ssl
chmod 700 /root/gzmnet /root/gzmnet/data
cd /root/gzmnet

if [ -n "${SESSION_SECRET_KEEP:-}" ]; then
    SESSION_SECRET="$SESSION_SECRET_KEEP"
else
    SESSION_SECRET=$(openssl rand -hex 32)
fi
# Guardar credenciales del panel (panel.json — NUNCA config.json, Xray lo confundía)
jq -n --arg u "$ADMIN_USER" --arg p "$ADMIN_PASS" --arg s "$SESSION_SECRET"     '{adminUser:$u, adminPassword:$p, port:3000, sessionSecret:$s}' > /root/gzmnet/panel.json
chmod 600 /root/gzmnet/panel.json
# Quitar SOLO el antiguo config.json del panel (si existe)
rm -f /root/gzmnet/config.json 2>/dev/null || true
# Verificar que panel.json quedó bien
if [ ! -s /root/gzmnet/panel.json ]; then
    echo "ERROR: no se pudo escribir /root/gzmnet/panel.json"
    exit 1
fi
: # "  ✓ Credenciales guardadas en panel.json"

if [ -f /root/gzmnet/vpn_config.json ]; then
    jq --arg d "$DOMAIN" --arg tz "$SERVER_TZ" --argjson pp "$PANEL_PORT" \
        '.domain = $d | .timezone = $tz | .panelPort = $pp | .subPort = ($pp)' \
        /root/gzmnet/vpn_config.json > /tmp/vpn_config.tmp && mv /tmp/vpn_config.tmp /root/gzmnet/vpn_config.json
else
    jq -n --arg d "$DOMAIN" --arg tz "$SERVER_TZ" --argjson pp "$PANEL_PORT" \
        '{enabled:true, domain:$d, timezone:$tz, timeFormat:"24h", panelPort:$pp, subInterval:12, subPort:$pp, subPath:"/sub", subShowUsage:1, subTitle:"GZMNET VPN", subUserAgent:"", jsonEnabled:0, jsonPath:"/subjson", jsonBypass:"", jsonBypassDomains:"", jsonBypassGeosites:"", lastSslNotified:"", lastSslRenewed:""}' > vpn_config.json
fi
chmod 600 vpn_config.json

# ============ INICIALIZAR BASE DE DATOS ============
cat > init-db.js <<'INITEOF'
const Database = require('better-sqlite3');
const pathMod = require('path');
const fs = require('fs');
const dbPath = pathMod.join(__dirname, 'data', 'vpn.sqlite');
fs.mkdirSync(pathMod.dirname(dbPath), { recursive: true });
const db = new Database(dbPath);
db.pragma('journal_mode = WAL');
db.pragma('busy_timeout = 5000');

function run(sql) {
  try { db.exec(sql); } catch (e) { console.error('SQL:', e.message); }
}

run(`CREATE TABLE IF NOT EXISTS inbounds (
  id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, protocol TEXT NOT NULL,
  port INTEGER NOT NULL, network TEXT DEFAULT 'ws', path TEXT DEFAULT '/',
  tls INTEGER DEFAULT 0, domain TEXT DEFAULT '', host TEXT DEFAULT '',
  security TEXT DEFAULT 'none', flow TEXT DEFAULT '', sniffing INTEGER DEFAULT 1,
  encryption TEXT DEFAULT '', fingerprint TEXT DEFAULT 'chrome', alpn TEXT DEFAULT '',
  reality_dest TEXT DEFAULT '', reality_server_names TEXT DEFAULT '',
  reality_private_key TEXT DEFAULT '', reality_public_key TEXT DEFAULT '',
  reality_short_ids TEXT DEFAULT '',
  grpc_service TEXT DEFAULT '', grpc_multi INTEGER DEFAULT 0,
  h2_path TEXT DEFAULT '/', h2_host TEXT DEFAULT '',
  quic_key TEXT DEFAULT '', quic_security TEXT DEFAULT 'none', quic_header TEXT DEFAULT 'none',
  kcp_seed TEXT DEFAULT '', kcp_header TEXT DEFAULT 'none',
  xhttp_path TEXT DEFAULT '/', xhttp_host TEXT DEFAULT '', xhttp_mode TEXT DEFAULT 'auto',
