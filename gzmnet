    if (domains.length) out.push({ type: "field", outboundTag: "block", protocol: ["quic"], domain: domains });
    if (ips.length) out.push({ type: "field", outboundTag: "block", protocol: ["quic"], ip: ips });
    // 2) Bloquear UDP 443 (HTTP/3)
    if (domains.length) out.push({ type: "field", outboundTag: "block", network: "udp", port: "443", domain: domains });
