/* Protocol badges — color por protocolo */
.badge.vless{background:rgba(59,130,246,.14)!important;color:#60a5fa!important;border:1px solid rgba(59,130,246,.25);}
.badge.vmess{background:rgba(168,85,247,.14)!important;color:#c084fc!important;border:1px solid rgba(168,85,247,.25);}
.badge.trojan{background:rgba(244,63,94,.14)!important;color:#fb7185!important;border:1px solid rgba(244,63,94,.25);}
.badge.shadowsocks{background:rgba(245,158,11,.14)!important;color:#fbbf24!important;border:1px solid rgba(245,158,11,.25);}
.badge.socks{background:rgba(6,182,212,.14)!important;color:#22d3ee!important;border:1px solid rgba(6,182,212,.25);}
