function slugifyPath(p) {
    return String(p || '').trim().toLowerCase()
        .replace(/^\/+/, '').replace(/\/+$/, '')
        .replace(/[^a-z0-9\-_\/]/g, '-')
        .replace(/-+/g, '-')
        .replace(/\/+/g, '/')
        .slice(0, 80);
}
