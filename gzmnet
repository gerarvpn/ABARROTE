    }
    if (c.protocol === 'trojan') return `trojan://${encodeURIComponent(c.uuid)}@${address}:${port}?${params.toString()}#${encodeURIComponent(c.name)}`;
    if (c.protocol === 'shadowsocks') {
        const method = c.ss_method || 'aes-256-gcm';
        const userinfo = Buffer.from(`${method}:${c.uuid}`).toString('base64').replace(/=+$/,'').replace(/\+/g,'-').replace(/\//g,'_');
        const params2 = new URLSearchParams(params);
        return `ss://${userinfo}@${address}:${port}?${params2.toString()}#${encodeURIComponent(c.name)}`;
    }
    return '';
}

