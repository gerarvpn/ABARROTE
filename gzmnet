    let allClientsRouting = [];
    try {
        allClientsRouting = vpnDb.prepare('SELECT id, routing_bypass, filter_bypass FROM clients WHERE enabled = 1').all();
    } catch (e) { allClientsRouting = []; }
    const bypassAllUsers = allClientsRouting.filter(c => c.routing_bypass == 1).map(c => `c${c.id}`);
    function usersBypassFilter(key) {
        const out = [];
        for (const c of allClientsRouting) {
            if (c.routing_bypass == 1) { out.push(`c${c.id}`); continue; }
            const fb = parseFilterBypass(c.filter_bypass);
            if (fb[key] == 1 || fb[key] === true) out.push(`c${c.id}`);
        }
        return out;
    }
    // Nota: NO se envía todo el tráfico de bypass a direct/warp (rompe selectividad).
    // Solo se exceptúan dominios/protocolos de cada filtro concreto.

    // --- 2) Content filters BEFORE any WARP/direct catch-alls ---
    if (s.block_ads == 1) {
        const adDomains = ["geosite:category-ads-all", "geosite:category-ads", ...EXPLICIT_AD_DOMAINS];
        const aUsers = usersBypassFilter('ads');
        if (aUsers.length) rules.push({ type: "field", user: aUsers, domain: adDomains, outboundTag: "direct" });
        rules.push({ type: "field", outboundTag: "block", domain: adDomains });
    }
    if (s.block_trackers == 1) {
        const tUsers = usersBypassFilter('trackers');
        if (tUsers.length) rules.push({ type: "field", user: tUsers, domain: TRACKER_DOMAINS, outboundTag: "direct" });
        rules.push({ type: "field", outboundTag: "block", domain: TRACKER_DOMAINS });
    }
    if (s.block_adult == 1) {
        const adultDomains = [
            "geosite:category-porn",
            "domain:pornhub.com", "domain:xvideos.com", "domain:xnxx.com", "domain:xhamster.com",
            "domain:redtube.com", "domain:youporn.com", "domain:spankbang.com", "domain:onlyfans.com"
        ];
        const aduUsers = usersBypassFilter('adult');
        if (aduUsers.length) rules.push({ type: "field", user: aduUsers, domain: adultDomains, outboundTag: "direct" });
        rules.push({ type: "field", outboundTag: "block", domain: adultDomains });
    }
    if (s.block_malware == 1) {
        const mUsers = usersBypassFilter('malware');
        const mal = ["geosite:category-malware", "geosite:win-spyware"];
        if (mUsers.length) rules.push({ type: "field", user: mUsers, domain: mal, outboundTag: "direct" });
        rules.push({ type: "field", outboundTag: "block", domain: mal });
    }
    if (s.block_bittorrent == 1) {
        const btUsers = usersBypassFilter('bittorrent');
        if (btUsers.length) rules.push({ type: "field", user: btUsers, protocol: ["bittorrent"], outboundTag: "direct" });
        rules.push({ type: "field", outboundTag: "block", protocol: ["bittorrent"] });
    }

    // Custom user rules (block_quic ANTES de WARP; block clásico no se agrega aquí)
    for (const r of customRules) {
        if (r.outbound === 'block_quic') {
            for (const b of buildBlockQuicRules(r)) rules.push(b);
        } else if (r.outbound !== 'block') {
            for (const b of buildRuleFromCustom(r, useWarp)) rules.push(b);
        }
    }

    // private + DNS
    rules.push({ type: "field", ip: ["geoip:private"], outboundTag: "direct" });
    rules.push({ type: "field", outboundTag: "direct", network: "udp", port: "53" });
    rules.push({ type: "field", outboundTag: "direct", network: "tcp", port: "53" });

    if (s.prevent_captcha == 1) {
        rules.push({ type: "field", domain: CAPTCHA_DOMAINS.map(d => 'domain:' + d), outboundTag: "direct" });
    }

    if (useWarp) {
        rules.push({ type: "field", protocol: ["quic"], outboundTag: "direct" });
        rules.push({ type: "field", network: "udp", port: "443", outboundTag: "direct" });
        rules.push({ type: "field", network: "tcp,udp", outboundTag: "warp" });
    }

    // Si falta geosite.dat, quitar reglas geosite:* (evita config inválida) y dejar domain:/regexp:
    try {
        if (!fs.existsSync('/usr/local/share/xray/geosite.dat') && !fs.existsSync('/usr/local/bin/geosite.dat')) {
            for (const r of rules) {
                if (r.domain && Array.isArray(r.domain)) {
                    r.domain = r.domain.filter(d => typeof d === 'string' && !d.startsWith('geosite:'));
                    if (!r.domain.length) delete r.domain;
                }
            }
            // eliminar reglas vacías de bloqueo sin domain/ip/protocol/port/user
            for (let i = rules.length - 1; i >= 0; i--) {
                const r = rules[i];
                if (r.outboundTag === 'block' || r.outboundTag === 'direct' || r.outboundTag === 'warp') {
                    const has = r.domain || r.ip || r.protocol || r.port || r.user || r.inboundTag || r.network;
                    if (!has) rules.splice(i, 1);
                }
            }
        }
    } catch (e) {}
    return rules;
}


