    if openssl x509 -in "$CERT_FILE" -noout -checkhost "$DOMAIN" 2>/dev/null | grep -q "does match"; then CERT_HOST_OK=1; fi
    if [ "$START_TS" -gt 0 ] && [ "$END_TS" -gt "$NOW_TS" ] && [ "$CERT_HOST_OK" -eq 1 ]; then
        DAYS_OLD=$(( (NOW_TS - START_TS) / 86400 ))
        DAYS_LEFT=$(( (END_TS - NOW_TS) / 86400 ))
        if [ "$DAYS_OLD" -lt 50 ] && [ "$DAYS_LEFT" -gt 40 ]; then
            _ok "Certificado válido ($DAYS_OLD días, $DAYS_LEFT restantes)"
            SSL_SUCCESS=1
        else
            _info "Certificado requiere renovación, reemitiendo con ZeroSSL..."
            NEED_ISSUE=1
        fi
    else
        _info "Certificado inválido o expirado, reemitiendo con ZeroSSL..."
        NEED_ISSUE=1
    fi
else
    _info "No existe certificado, emitiendo con ZeroSSL..."
    NEED_ISSUE=1
fi

if [ "$NEED_ISSUE" -eq 1 ]; then
    {
        if [ -f "/root/gzmnet/data/vpn.sqlite" ]; then
            XRAY_ON_80=$(sqlite3 "/root/gzmnet/data/vpn.sqlite" "SELECT COUNT(*) FROM inbounds WHERE port = 80" 2>/dev/null || echo 0)
