.badge.count{background:rgba(255,255,255,.06)!important;color:var(--text-2)!important;border:1px solid rgba(255,255,255,.08);}

/* Online = verde, offline = gris */
.client-dot{width:11px;height:11px;border-radius:50%;background:#52525b!important;flex-shrink:0;box-shadow:0 0 0 3px rgba(82,82,91,.25)!important;transition:background .25s,box-shadow .25s;}
