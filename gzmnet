function onSecurityChange(){
    try {
        const s = (document.getElementById('ib-security') || {}).value || 'none';
        const tlsF = document.getElementById('tlsFields');
        const realF = document.getElementById('realityFields');
        if (tlsF) tlsF.style.display = s === 'tls' ? 'block' : 'none';
        if (realF) realF.style.display = s === 'reality' ? 'block' : 'none';
        const net = document.getElementById('ib-network');
