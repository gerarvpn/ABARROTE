    echo -e "   ${CW} 6${C0}  Cambiar dominio (certificado ZeroSSL nuevo)"
    echo ""
    echo -e "   ${CBL}${CB}Certificado SSL${C0}"
    echo -e "   ${CW} 7${C0}  Ver certificado actual"
    echo -e "   ${CW} 8${C0}  Regenerar certificado ahora"
    echo ""
    echo -e "   ${CBL}${CB}Diagnóstico${C0}"
    echo -e "   ${CW} 9${C0}  Ver logs completos"
    echo -e "   ${CW}10${C0}  Test config Xray"
    echo -e "   ${CW}11${C0}  Estado WARP"
    echo -e "   ${CW}12${C0}  Firewall (UFW)"
    echo -e "   ${CW}13${C0}  Test Nginx"
    echo ""
    echo -e "   ${CR} 0${C0}  Salir"
    echo ""
    read -rp "   Opción › " ch
    case $ch in
        1) echo ""; pm2 restart gzmnet; pm2 save --force >/dev/null 2>&1; echo -e "  ${CG}✓ Panel reiniciado${C0}"; pause ;;
        2) echo ""; pm2 restart xray; echo -e "  ${CG}✓ Xray reiniciado${C0}"; pause ;;
        3) echo ""; pm2 status >/dev/null 2>&1; pause ;;
        4)
            echo ""
            echo -e "  ${CB}Cambiar credenciales del panel${C0}"
            read -rp "  Nuevo usuario (>=3): " NU
            if [ ${#NU} -lt 3 ]; then echo -e "  ${CR}Usuario demasiado corto${C0}"; pause; menu; return; fi
            read -rsp "  Nueva contraseña (>=8): " NP; echo ""
            read -rsp "  Confirmar contraseña: " NP2; echo ""
            if [ "$NP" != "$NP2" ]; then echo -e "  ${CR}No coinciden${C0}"; pause; menu; return; fi
            if [ ${#NP} -lt 8 ]; then echo -e "  ${CR}Contraseña demasiado corta${C0}"; pause; menu; return; fi
            jq --arg u "$NU" --arg p "$NP" '.adminUser=$u | .adminPassword=$p' "$CONFIG" > /tmp/gzm-cfg.json \
              && mv /tmp/gzm-cfg.json "$CONFIG" && chmod 600 "$CONFIG"
            pm2 restart gzmnet >/dev/null 2>&1
            echo -e "  ${CG}✓ Credenciales actualizadas. Cierra sesión en el panel.${C0}"
            pause
            ;;
        5)
            echo ""
            OLD_PORT=$(get_port); OLD_PORT=${OLD_PORT:-443}
            DOM=$(get_domain)
            echo -e "  Puerto actual: ${CW}${OLD_PORT}${C0}"
            read -rp "  Nuevo puerto (1-65535, no 80): " NEW_PORT
            if ! [[ "$NEW_PORT" =~ ^[0-9]+$ ]] || [ "$NEW_PORT" -lt 1 ] || [ "$NEW_PORT" -gt 65535 ] || [ "$NEW_PORT" = "80" ]; then
                echo -e "  ${CR}Puerto inválido${C0}"; pause; menu; return
            fi
            if [ "$NEW_PORT" = "$OLD_PORT" ]; then echo -e "  ${CY}Es el mismo puerto${C0}"; pause; menu; return; fi
            if ss -tlnp 2>/dev/null | grep -q ":${NEW_PORT} "; then
                echo -e "  ${CR}Puerto $NEW_PORT en uso${C0}"; pause; menu; return
            fi
            jq --argjson pp "$NEW_PORT" '.panelPort=$pp | .subPort=$pp' "$VPN_CFG" > /tmp/gzm-vpn.json \
              && mv /tmp/gzm-vpn.json "$VPN_CFG" && chmod 600 "$VPN_CFG"
            rewrite_nginx "$DOM" "$NEW_PORT"
            ufw allow ${NEW_PORT}/tcp >/dev/null 2>&1 || true
            ufw delete allow ${OLD_PORT}/tcp >/dev/null 2>&1 || true
            nginx -t && systemctl reload nginx
            pm2 restart gzmnet >/dev/null 2>&1
            if [ "$NEW_PORT" = "443" ]; then URL="https://$DOM"; else URL="https://$DOM:$NEW_PORT"; fi
            echo -e "  ${CG}✓ Puerto actualizado${C0}"
            echo -e "  Nueva URL: ${CW}${URL}${C0}"
            pause
            ;;
        6)
            echo ""
            OLD_DOM=$(get_domain)
            PPORT=$(get_port); PPORT=${PPORT:-443}
            echo -e "  Dominio actual: ${CW}${OLD_DOM}${C0}"
            read -rp "  Nuevo dominio: " NEW_DOM
            NEW_DOM=$(echo "$NEW_DOM" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
            if ! [[ "$NEW_DOM" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$ ]]; then
                echo -e "  ${CR}Dominio inválido${C0}"; pause; menu; return
            fi
            PUB_IP=$(curl -s4 --max-time 5 ifconfig.me 2>/dev/null || echo "")
            DOM_IP=$(getent hosts "$NEW_DOM" 2>/dev/null | awk '{print $1}' | head -1)
            echo "  IP pública: $PUB_IP  |  DNS $NEW_DOM -> $DOM_IP"
            if [ -n "$PUB_IP" ] && [ -n "$DOM_IP" ] && [ "$PUB_IP" != "$DOM_IP" ]; then
                read -rp "  ATENCIÓN: DNS no coincide. Continuar? [s/N]: " CONT
                [ "$CONT" != "s" ] && [ "$CONT" != "S" ] && { pause; menu; return; }
            fi
            jq --arg d "$NEW_DOM" '.domain=$d' "$VPN_CFG" > /tmp/gzm-vpn.json \
              && mv /tmp/gzm-vpn.json "$VPN_CFG" && chmod 600 "$VPN_CFG"
            echo "  Emitiendo certificado ZeroSSL para $NEW_DOM ..."
            if issue_zerossl "$NEW_DOM"; then
                echo -e "  ${CG}✓ Certificado emitido${C0}"
            else
                echo -e "  ${CR}✗ No se pudo emitir el certificado${C0}"
                echo "  Revisa /tmp/gzm-ssl-ecc.log y /tmp/gzm-ssl-rsa.log"
            fi
            rewrite_nginx "$NEW_DOM" "$PPORT"
            nginx -t && systemctl reload nginx
            # actualizar sed del renew script
            if [ -f /usr/local/bin/gzmnet-renew-cert.sh ]; then
                sed -i "s|^DOMAIN=.*|DOMAIN=\"$NEW_DOM\"|" /usr/local/bin/gzmnet-renew-cert.sh 2>/dev/null || true
            fi
            if [ -n "$OLD_DOM" ] && [ "$OLD_DOM" != "$NEW_DOM" ]; then
                read -rp "  ¿Eliminar cert antiguo de $OLD_DOM? [s/N]: " DELC
                if [ "$DELC" = "s" ] || [ "$DELC" = "S" ]; then
                    rm -f "/etc/nginx/ssl/${OLD_DOM}.crt" "/etc/nginx/ssl/${OLD_DOM}.key" 2>/dev/null || true
                fi
            fi
            pm2 restart gzmnet >/dev/null 2>&1
            if [ "$PPORT" = "443" ]; then URL="https://$NEW_DOM"; else URL="https://$NEW_DOM:$PPORT"; fi
            echo -e "  ${CG}✓ Dominio actualizado${C0}"
            echo -e "  Nueva URL: ${CW}${URL}${C0}"
            if [ -f "/etc/nginx/ssl/${NEW_DOM}.crt" ]; then
                openssl x509 -in "/etc/nginx/ssl/${NEW_DOM}.crt" -noout -dates 2>/dev/null
            fi
            pause
            ;;
        7|S|s)
            DOM=$(get_domain)
            CERT="/etc/nginx/ssl/${DOM}.crt"
            echo ""
            echo -e "  ${CB}Certificado SSL — $DOM${C0}"
            if [ ! -f "$CERT" ]; then echo -e "  ${CR}No encontrado${C0}"; pause; menu; return; fi
            openssl x509 -in "$CERT" -noout -subject -issuer -dates 2>/dev/null
            openssl x509 -in "$CERT" -noout -ext subjectAltName 2>/dev/null | head -5
            END_DATE=$(openssl x509 -in "$CERT" -noout -enddate 2>/dev/null | sed 's/notAfter=//')
            END_TS=$(date -d "$END_DATE" +%s 2>/dev/null || echo 0)
            NOW_TS=$(date +%s)
            if [ "$END_TS" -gt 0 ]; then
                DAYS=$(( (END_TS - NOW_TS) / 86400 ))
                echo -e "  Días restantes: ${CW}${DAYS}${C0}"
                if [ "$DAYS" -lt 15 ]; then echo -e "  ${CR}⚠ Quedan menos de 15 días${C0}"; fi
            fi
            openssl x509 -in "$CERT" -noout -checkhost "$DOM" 2>/dev/null
            pause
            ;;
        8|R|r)
            echo ""
            echo -e "  ${CB}Regenerando certificado (ZeroSSL)...${C0}"
            FORCE=1 /usr/local/bin/gzmnet-renew-cert.sh
            echo -e "  ${CD}Log: /root/gzmnet/data/cert-renew.log${C0}"
            tail -30 /root/gzmnet/data/cert-renew.log 2>/dev/null
            pause
            ;;
        9)
            echo ""
            show_section(){
                echo ""
                echo "══════════════════════════════════════════════"
                echo "  $1"
                echo "══════════════════════════════════════════════"
            }
            show_section "LOGS DEL PANEL (gzmnet — últimas 100 líneas)"
            pm2 logs gzmnet --lines 100 --nostream 2>/dev/null || true
            show_section "LOGS DE XRAY (últimas 100 líneas)"
            pm2 logs xray --lines 100 --nostream 2>/dev/null || true
            echo "--- xray-daemon.log ---"
            tail -100 /root/gzmnet/data/xray-daemon.log 2>/dev/null || true
            show_section "LOGS DE NGINX (errores recientes)"
            journalctl -u nginx -n 100 --no-pager 2>/dev/null || true
            show_section "APPLY LOG (config Xray)"
            tail -100 /root/gzmnet/data/apply.log 2>/dev/null || true
            show_section "CERT RENEW LOG"
            tail -50 /root/gzmnet/data/cert-renew.log 2>/dev/null || true
            show_section "ERRORES DEL SISTEMA (journalctl -p err)"
            journalctl -p err -n 50 --no-pager 2>/dev/null || true
            echo ""
            read -rp "  ¿Filtrar solo errores? [s/N]: " FILT
            if [ "$FILT" = "s" ] || [ "$FILT" = "S" ]; then
                echo "--- filtro error|fail|exception ---"
                FOUND=0
                { pm2 logs gzmnet --lines 200 --nostream 2>/dev/null; pm2 logs xray --lines 200 --nostream 2>/dev/null; tail -200 /root/gzmnet/data/apply.log 2>/dev/null; tail -100 /root/gzmnet/data/xray-daemon.log 2>/dev/null; } \
                  | grep -iE 'error|fail|exception|ERR|ENOENT|EADDR' | tail -80 | while IFS= read -r line; do echo "$line"; FOUND=1; done
                if ! { pm2 logs gzmnet --lines 200 --nostream 2>/dev/null; pm2 logs xray --lines 200 --nostream 2>/dev/null; tail -200 /root/gzmnet/data/apply.log 2>/dev/null; } | grep -qiE 'error|fail|exception|ERR'; then
                    echo "  (sin coincidencias en logs recientes — el panel puede estar sano)"
                    echo "  Tip: revisa también: pm2 logs gzmnet --lines 50"
                fi
            fi
            pause
            ;;
        10) echo ""; /usr/local/bin/xray run -test -config /usr/local/etc/xray/config.json 2>&1 | tail -12; pause ;;
        11) echo ""; systemctl status wireproxy --no-pager 2>/dev/null | head -14 || echo "  WARP no instalado"; pause ;;
        12) echo ""; ufw status numbered; pause ;;
        13) echo ""; nginx -t; pause ;;
        0) echo ""; exit 0 ;;
        *) echo -e "  ${CR}Opción inválida${C0}"; sleep 1 ;;
    esac
    menu
}
menu
GZMENU
chmod +x /usr/local/bin/gzm

# =================== REINICIO FINAL ===================
pm2 delete gzmnet xray 2>/dev/null || true
sleep 1
cd /root/gzmnet

# Solo liberar puerto 80 (acme/nginx residual). NO matar puertos de inbounds:
# eso mata al propio Xray y provoca el bucle "Killed" en los logs.
if [ -f /root/gzmnet/data/vpn.sqlite ]; then
    X80=$(sqlite3 /root/gzmnet/data/vpn.sqlite "SELECT COUNT(*) FROM inbounds WHERE port=80" 2>/dev/null || echo 0)
    if [ "${X80:-0}" -gt 0 ]; then
        # no matar aún — el panel/apply gestiona el bind
        true
    fi
fi

_step "Servicios finales"
pm2 describe gzmnet >/dev/null 2>&1 && pm2 restart gzmnet || pm2 start /root/gzmnet/app.js --name gzmnet --cwd /root/gzmnet --node-args="--max-old-space-size=192" --max-memory-restart 300M --max-restarts 50 --restart-delay 2000

for i in $(seq 1 50); do
    if curl -fsS -o /dev/null --connect-timeout 1 http://127.0.0.1:3000/login 2>/dev/null; then _info "Panel activo"; break; fi
    sleep 1
done
sleep 5

_ok "Panel listo"
sleep 2

_step "Xray"
# Idempotente: si ya corre (arranque previo), solo restart — evita "Script already launched"
pm2 describe xray >/dev/null 2>&1 && pm2_restart_quiet xray; if ! pm2 describe xray >/dev/null 2>&1; then pm2 start /usr/local/bin/xray-pm2-wrapper.sh --name xray --interpreter bash --cwd /usr/local >/dev/null 2>&1 || true; fi
sleep 3
# Verificar que la config tiene clientes
if ! grep -q '"email"' /usr/local/etc/xray/config.json 2>/dev/null; then
    _info "ADVERTENCIA: config sin emails — forzando regeneración"
    if [ -f /usr/local/etc/xray/config.json.bak ]; then
        cp -a /usr/local/etc/xray/config.json.bak /usr/local/etc/xray/config.json
        _info "Restaurado config.json desde .bak"
    fi
    pm2_restart_quiet xray
fi

for i in $(seq 1 40); do
    if ss -tln 2>/dev/null | grep -q ':10085 '; then _ok "Xray API lista (:10085)"; break; fi
    sleep 1
done

# Segunda pasada: apply + restart xray
_step "Aplicando configuración Xray"
curl -fsS -X POST http://127.0.0.1:3000/api/local/force-apply >/dev/null 2>&1 || true
sleep 3
# NO matar puertos de inbounds (mata a Xray y causa bucle Killed). Solo restart limpio.
pm2 restart xray 2>/dev/null || pm2 describe xray >/dev/null 2>&1 && pm2_restart_quiet xray; if ! pm2 describe xray >/dev/null 2>&1; then pm2 start /usr/local/bin/xray-pm2-wrapper.sh --name xray --interpreter bash --cwd /usr/local >/dev/null 2>&1 || true; fi
sleep 5
# Verificar API
if ! ss -tln 2>/dev/null | grep -q ':10085 '; then
    _info "Xray API no responde — reinicio forzado"
    pm2 delete xray 2>/dev/null || true
    sleep 2
    pm2 start /usr/local/bin/xray-pm2-wrapper.sh --name xray --interpreter bash --cwd /usr/local/etc/xray --max-restarts 200 --restart-delay 3000
    sleep 6
fi
# Verificar config tiene emails
EMAILS=$(grep -c '"email"' /usr/local/etc/xray/config.json 2>/dev/null || echo 0)
_info "Emails en config: $EMAILS"
if [ "$EMAILS" = "0" ]; then
    _info "ADVERTENCIA: config sin clientes — el panel regenerará al primer acceso"
fi

# Verificar puertos de servidores (sin fuser -k)
if [ -f /root/gzmnet/data/vpn.sqlite ]; then
    PORTS=$(sqlite3 /root/gzmnet/data/vpn.sqlite "SELECT DISTINCT port FROM inbounds;" 2>/dev/null | tr '\n' ' ')
    NEED_RESTART=0
    for p in $PORTS; do
        if ss -tln 2>/dev/null | grep -q ":${p} "; then
            _info "Puerto $p: OK (escuchando)"
        else
            _info "Puerto $p: no escucha aún"
            NEED_RESTART=1
        fi
    done
    if [ "$NEED_RESTART" -eq 1 ]; then
        _info "Reiniciando Xray una vez..."
        pm2_restart_quiet xray
        sleep 4
    fi
fi

pm2 save --force >/dev/null 2>&1
_info "Servidores restaurados (sin necesidad de editar/guardar)"

_info "Servidores restaurados (claves VLESS no regeneradas)"

echo ""
_step "Verificación"
SMOKE_OK=1
curl -fsS -o /dev/null --connect-timeout 3 http://127.0.0.1:3000/login 2>/dev/null || { echo "  FAIL /login"; SMOKE_OK=0; }
ss -tln 2>/dev/null | grep -q ':3000 ' || { echo "  FAIL :3000"; SMOKE_OK=0; }
ss -tln 2>/dev/null | grep -q ':10085 ' || echo "  WARN :10085 (Xray API aún no lista)"
if [ "$SMOKE_OK" -eq 1 ]; then _ok "Verificación OK"; else echo "  >>> Smoke FALLÓ — pm2 logs gzmnet:"; pm2 logs gzmnet --lines 20 --nostream 2>/dev/null || true; fi

echo ""
echo ""
_end_quiet_install
