        fuser -k -9 80/tcp 2>/dev/null || true
        sleep 3
        timeout 300 /root/.acme.sh/acme.sh --issue -d "$DOMAIN" --standalone --server zerossl --keylength ec-256 --force --accountemail "admin@$DOMAIN" > /tmp/ssl-zerossl-ecc.log 2>&1
