@media(max-width:520px){.backup-grid{grid-template-columns:1fr}}
.backup-card{background:var(--bg);border:1px solid var(--border);border-radius:14px;padding:18px;display:flex;flex-direction:column;align-items:center;text-align:center;gap:12px;transition:all 0.2s}
.backup-card:hover{border-color:var(--border-2);transform:translateY(-2px);box-shadow:0 8px 24px rgba(0,0,0,0.15)}
.backup-icon{width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.backup-icon.download{background:rgba(59,130,246,0.15);color:var(--success)}
.backup-icon.upload{background:rgba(245,158,11,0.15);color:var(--warning)}
.backup-icon svg{width:22px;height:22px}
.backup-title{font-family:'Sora',sans-serif;font-size:14px;font-weight:600}
.backup-desc{font-size:11.5px;color:var(--text-3);line-height:1.4}
.input-group{display:flex;gap:8px;align-items:stretch}
.input-group input{flex:1;min-width:0;height:42px}

/* Inputs oscuros (credenciales, UUID, tokens) — evita barras blancas */
.input-group input,
.easy-card input,
.modal-body input[type="text"],
.modal-body input[type="number"],
.modal-body input[type="password"],
.modal-body input.mono,
.modal-section input,
.field input,
.field select,
.field textarea{
  background:var(--surface-2) !important;
  color:var(--text) !important;
  border:1px solid var(--border) !important;
  border-radius:11px;
  -webkit-text-fill-color:var(--text);
  caret-color:var(--text);
  color-scheme:dark;
}
:root[data-theme="light"] .input-group input,
:root[data-theme="light"] .easy-card input,
:root[data-theme="light"] .modal-body input[type="text"],
:root[data-theme="light"] .modal-body input[type="number"],
:root[data-theme="light"] .modal-body input[type="password"],
:root[data-theme="light"] .modal-body input.mono,
:root[data-theme="light"] .modal-section input,
:root[data-theme="light"] .field input,
:root[data-theme="light"] .field select,
:root[data-theme="light"] .field textarea{
  color-scheme:light;
}
.input-group input:focus,
.easy-card input:focus,
.modal-body input:focus,
.field input:focus,
.field select:focus{
  border-color:var(--accent) !important;
  box-shadow:0 0 0 3px rgba(59,130,246,0.15);
  background:rgba(59,130,246,0.06) !important;
}
input:-webkit-autofill,
input:-webkit-autofill:hover,
input:-webkit-autofill:focus,
input:-webkit-autofill:active,
textarea:-webkit-autofill,
select:-webkit-autofill{
  -webkit-box-shadow:0 0 0 1000px var(--surface-2) inset !important;
  box-shadow:0 0 0 1000px var(--surface-2) inset !important;
  -webkit-text-fill-color:var(--text) !important;
  caret-color:var(--text);
  transition:background-color 99999s ease-out 0s;
  border:1px solid var(--border) !important;
}
.input-group input{
  flex:1;min-width:0;height:42px;padding:10px 12px;font-size:13px;outline:none;
}
.mono{font-family:'JetBrains Mono',ui-monospace,monospace;font-size:12px !important;letter-spacing:0.01em}

.input-group .btn{flex-shrink:0;height:42px;width:42px;padding:0;border-radius:11px}
.form-hint{font-size:11.5px;color:var(--text-3);margin-top:6px;line-height:1.4}
.form-grid-2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media(max-width:420px){.form-grid-2{grid-template-columns:1fr}}
.protocol-pills{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:4px}
.easy-card{background:linear-gradient(165deg,var(--surface-2) 0%,var(--bg) 100%);border:1px solid var(--border);border-radius:16px;padding:16px;margin-bottom:12px;box-shadow:0 1px 0 rgba(255,255,255,0.03) inset}
.easy-card-title{font-size:11px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-3);margin-bottom:14px;display:flex;align-items:center;gap:8px;padding-bottom:10px;border-bottom:1px solid var(--border)}
.easy-card-title svg{width:14px;height:14px;color:var(--accent-2)}
.adv-toggle{display:flex;align-items:center;justify-content:space-between;width:100%;padding:12px 14px;border-radius:12px;background:var(--surface-2);border:1px solid var(--border);color:var(--text-2);font-size:13px;font-weight:600;cursor:pointer;margin-bottom:10px}
.adv-toggle:hover{border-color:var(--border-2);color:var(--text)}
.adv-toggle svg{width:16px;height:16px;transition:transform 0.2s}
.adv-toggle.open svg{transform:rotate(180deg)}
.adv-panel{display:none;margin-bottom:8px}
.adv-panel.open{display:block}
.input-group{display:flex;align-items:center;gap:6px}
.input-group input{flex:1;min-width:0}
.protocol-chip{display:inline-flex;align-items:center;justify-content:center;padding:6px 12px;border-radius:8px;background:var(--bg);border:1px solid var(--border);cursor:pointer;font-size:11.5px;font-weight:600;user-select:none;transition:all 0.15s;text-transform:uppercase}
.protocol-chip:hover{border-color:var(--border-2)}
.protocol-chip.on{background:var(--accent);border-color:var(--accent);color:#fff}
@media(max-width:640px){.dynamic-island{min-height:46px;padding:4px 5px;gap:6px}.dynamic-island.island-expanded{min-width:auto;padding:4px 5px 4px 12px}.island-menu-btn{width:36px;height:36px}.island-menu-btn svg{width:15px;height:15px}.island-brand-text{display:none}.island-divider{height:18px}.island-clock{padding:6px 11px;font-size:11.5px}.island-notif-btn{width:34px;height:34px}.island-notif-btn svg{width:15px;height:15px}.gauge{width:34px;height:34px}.gauge-value{font-size:9px}.island-dropdown{right:8px;left:8px;max-width:none}.clock-popover{left:8px;right:8px;transform:none;min-width:auto}.clock-popover.open{transform:translateY(0)}.notif-panel{left:8px;right:8px;transform:translateY(-12px) scale(0.96);min-width:auto;max-width:none}.notif-panel.open{transform:translateY(0) scale(1)}.content{padding-left:12px;padding-right:12px}.floating-theme-btn{display:none}.dynamic-island{max-width:calc(100vw - 28px)}.client-row{flex-wrap:wrap}.client-actions{width:100%;justify-content:flex-end;margin-top:8px}}
@media(max-width:420px){.island-brand{display:none}}
</style>
</head>
<body>

<button class="floating-theme-btn" onclick="toggleThemeGlobal()"><i data-lucide="sun-moon" id="themeIconGlobal"></i></button>

<div class="dynamic-island" id="island">
  <div class="island-brand" onclick="nav('dash')"><span class="island-brand-dot"></span><span class="island-brand-text">GZMNET</span></div>
  <div class="island-divider"></div>
  <button class="island-notif-btn" id="notifBtn" onclick="toggleNotifPanel(event)" title="Notificaciones">
    <i data-lucide="bell"></i>
    <span class="island-notif-badge" id="notifBadge"></span>
  </button>
  <div class="island-divider"></div>
  <div class="island-gauges">
    <div class="gauge" title="CPU"><svg viewBox="0 0 38 38"><circle class="ring-bg" cx="19" cy="19" r="14"></circle><circle class="ring-fg" id="cpuRing" cx="19" cy="19" r="14" stroke-dasharray="0 87.96" stroke="#3b82f6"></circle></svg><span class="gauge-value" id="cpuVal">0</span></div>
    <div class="gauge" title="RAM"><svg viewBox="0 0 38 38"><circle class="ring-bg" cx="19" cy="19" r="14"></circle><circle class="ring-fg" id="ramRing" cx="19" cy="19" r="14" stroke-dasharray="0 87.96" stroke="#3b82f6"></circle></svg><span class="gauge-value" id="ramVal">0</span></div>
  </div>
  <div class="island-divider"></div>
  <button class="island-clock" onclick="toggleClockPopover(event)"><span id="islandTime">--:--</span></button>
  <button class="island-menu-btn" onclick="toggleIslandMenu(event)"><i data-lucide="menu" id="menuIcon"></i></button>
</div>

<div class="notif-panel" id="notifPanel">
  <div class="notif-head">
    <div class="notif-head-title"><i data-lucide="bell"></i> Notificaciones</div>
    <button class="notif-head-clear" onclick="clearNotifBadge()">Marcar leídas</button>
  </div>
  <div class="notif-list" id="notifList"></div>
</div>

<div class="clock-popover" id="clockPopover"><div class="time-big" id="clockPopTime">--:--:--</div><div class="date-line" id="clockPopDate">—</div></div>
<div class="island-overlay" id="islandOverlay" onclick="closeAllPopovers()"></div>

<div class="island-dropdown" id="islandMenu">
  <button class="island-dropdown-item active" data-nav="dash" onclick="nav('dash')"><i data-lucide="layout-dashboard"></i> Panel</button>
  <button class="island-dropdown-item" data-nav="servers" onclick="nav('servers')"><i data-lucide="server"></i> Servidores</button>
  <button class="island-dropdown-item" data-nav="clients" onclick="nav('clients')"><i data-lucide="users"></i> Clientes</button>
  <div class="island-dropdown-divider"></div>
  <div class="island-dropdown-section">Red</div>
  <button class="island-dropdown-item" data-nav="routing" onclick="nav('routing')"><i data-lucide="route"></i> Enrutamiento</button>
  <button class="island-dropdown-item" data-nav="sub" onclick="nav('sub')"><i data-lucide="rss"></i> Suscripción</button>
  <button class="island-dropdown-item" data-nav="webpages" onclick="nav('webpages')"><i data-lucide="globe-2"></i> Páginas web</button>
  <div class="island-dropdown-divider"></div>
  <div class="island-dropdown-section">Sistema</div>
  <button class="island-dropdown-item" data-nav="settings" onclick="nav('settings')"><i data-lucide="settings"></i> Ajustes</button>
  <button class="island-dropdown-item" onclick="toggleThemeGlobal();closeAllPopovers();"><i data-lucide="sun-moon"></i> Cambiar tema</button>
  <div class="island-dropdown-divider"></div>
  <button class="island-dropdown-item danger" onclick="location.href='/logout'"><i data-lucide="log-out"></i> Cerrar sesión</button>
</div>

<main class="content">
<div class="page active" id="p-dash">
  <div class="page-title"><h1>Panel</h1></div>
  <div class="kpis">
    <div class="kpi"><div class="kpi-label">Servidores</div><div class="kpi-value" id="kpiInbounds">0</div></div>
    <div class="kpi"><div class="kpi-label">Clientes</div><div class="kpi-value" id="kpiClients">0</div></div>
    <div class="kpi"><div class="kpi-label">En línea</div><div class="kpi-value" id="kpiOnline" style="color:var(--success);">0</div></div>
    <div class="kpi"><div class="kpi-label">Tráfico total</div><div class="kpi-value" id="kpiTraffic">0 B</div><div class="kpi-sub" id="kpiTrafficSub">↑ 0 · ↓ 0</div></div>
  </div>
  <div class="card"><div class="card-header"><div class="card-title"><i data-lucide="wifi"></i> Conectados ahora</div><span class="badge on" id="connCount">0</span></div><div id="connectedList"></div></div>
</div>

<div class="page" id="p-servers">
  <div class="page-title"><h1>Servidores</h1><button class="btn btn-primary" onclick="openInboundModal()"><i data-lucide="plus"></i> Nuevo servidor</button></div>
  <div id="serversList"></div>
</div>

<div class="page" id="p-clients">
  <div class="page-title"><h1>Clientes</h1><button class="btn btn-primary" onclick="openNewClient()"><i data-lucide="user-plus"></i> Nuevo cliente</button></div>
  <div class="search-bar"><i data-lucide="search"></i><input type="text" id="clientSearch" placeholder="Buscar por nombre o ID..." oninput="renderClientsAll()"></div>
  <div id="clientsAllList"></div>
</div>

<div class="page" id="p-routing">
  <div class="page-title"><h1>Enrutamiento</h1></div>
  <div class="routing-section" id="secNet">
    <div class="routing-head" onclick="toggleSection('secNet')"><div class="routing-icon net"><i data-lucide="network"></i></div><div class="routing-title"><div class="routing-title-text">Tipo de Red</div></div><i data-lucide="chevron-down" class="routing-chevron"></i></div>
    <div class="routing-body"><div class="routing-body-inner">
      <div class="field"><label>Preferencia de IP</label><div class="ip-pick">
        <div class="ip-card" data-ip="ipv4" onclick="selectIpType('ipv4')"><div class="ip-card-icon"><i data-lucide="wifi"></i></div><div class="ip-card-label">Solo IPv4</div><div class="ip-card-sub">UseIPv4</div></div>
        <div class="ip-card" data-ip="ipv6" onclick="selectIpType('ipv6')"><div class="ip-card-icon"><i data-lucide="wifi"></i></div><div class="ip-card-label">Solo IPv6</div><div class="ip-card-sub">UseIPv6</div></div>
        <div class="ip-card active" data-ip="dual" onclick="selectIpType('dual')"><div class="ip-card-icon"><i data-lucide="wifi"></i></div><div class="ip-card-label">IPv4 + IPv6</div><div class="ip-card-sub">Dual</div></div>
      </div></div>
      <div class="field" style="margin-bottom:0;"><label>Estrategia de dominio</label><select id="domainStrategy" onchange="saveDomainStrategy()"><option value="IPIfNonMatch">IPIfNonMatch (recomendado)</option><option value="IPOnDemand">IPOnDemand</option><option value="AsIs">AsIs</option></select></div>
    </div></div>
  </div>
  <div class="routing-section" id="secDNS">
    <div class="routing-head" onclick="toggleSection('secDNS')"><div class="routing-icon dns"><i data-lucide="globe"></i></div><div class="routing-title"><div class="routing-title-text">DNS</div></div><i data-lucide="chevron-down" class="routing-chevron"></i></div>
    <div class="routing-body"><div class="routing-body-inner">
      <div class="field-row"><div class="field"><label>DNS IPv4 primario</label><input type="text" id="dnsPrimary" placeholder="1.1.1.1" class="mono"></div><div class="field"><label>DNS IPv4 secundario</label><input type="text" id="dnsSecondary" placeholder="8.8.8.8" class="mono"></div></div>
      <div class="field-row"><div class="field"><label>DNS IPv6 primario</label><input type="text" id="dnsPrimaryV6" placeholder="2606:4700:4700::1111" class="mono"></div><div class="field"><label>DNS IPv6 secundario</label><input type="text" id="dnsSecondaryV6" placeholder="2001:4860:4860::8888" class="mono"></div></div>
      <div class="row-switch"><div class="row-switch-text"><div class="row-switch-title"><span class="filter-icon dns"><i data-lucide="zap"></i></span> Fake DNS Boost</div></div><button class="toggle" id="swFakeDns" onclick="toggleFakeDns()"></button></div>
      <button class="btn btn-primary" style="width:100%;" onclick="autoSaveDns()"><i data-lucide="check"></i> Guardar DNS</button>
      <div style="margin-top:16px;padding-top:14px;border-top:1px solid var(--border);"><div style="font-size:11.5px;font-weight:600;color:var(--text-2);margin-bottom:8px;letter-spacing:0.05em;">PRESETS RÁPIDOS</div><div class="dns-presets">
        <button class="dns-preset" onclick="quickDns('1.1.1.1','1.0.0.1','2606:4700:4700::1111','2606:4700:4700::1001')"><span class="name">Cloudflare</span><span class="ip">1.1.1.1</span></button>
        <button class="dns-preset" onclick="quickDns('8.8.8.8','8.8.4.4','2001:4860:4860::8888','2001:4860:4860::8844')"><span class="name">Google</span><span class="ip">8.8.8.8</span></button>
        <button class="dns-preset" onclick="quickDns('94.140.14.14','94.140.15.15','2a10:50c0::ad1:ff','2a10:50c0::ad2:ff')"><span class="name">AdGuard</span><span class="ip">94.140.14.14</span></button>
        <button class="dns-preset" onclick="quickDns('9.9.9.9','149.112.112.112','2620:fe::fe','2620:fe::9')"><span class="name">Quad9</span><span class="ip">9.9.9.9</span></button>
      </div></div>
    </div></div>
  </div>
  <div class="routing-section" id="secWarp">
    <div class="routing-head" onclick="toggleSection('secWarp')"><div class="routing-icon warp"><i data-lucide="cloud"></i></div><div class="routing-title"><div class="routing-title-text">WARP</div></div><i data-lucide="chevron-down" class="routing-chevron"></i></div>
    <div class="routing-body"><div class="routing-body-inner">
      <div class="row-switch"><div class="row-switch-text"><div class="row-switch-title" style="color:var(--warp);">Activar WARP Global</div><div style="display:flex;align-items:center;gap:6px;margin-top:8px;font-size:11.5px;"><span class="dot" id="warpDot"></span><span id="warpStatusText" style="color:var(--text-3);">Inactivo</span></div></div><button class="toggle" id="swWarp" onclick="toggleWarp()"></button></div>
      <button class="btn btn-ghost btn-sm" style="width:100%;" onclick="restartWarp()"><i data-lucide="refresh-cw"></i> Reiniciar WARP</button>
    </div></div>
  </div>
  <div class="routing-section" id="secFilters">
    <div class="routing-head" onclick="toggleSection('secFilters')"><div class="routing-icon filter"><i data-lucide="filter"></i></div><div class="routing-title"><div class="routing-title-text">Filtros de Contenido</div><div class="routing-title-desc" id="filtersDesc"></div></div><i data-lucide="chevron-down" class="routing-chevron"></i></div>
    <div class="routing-body"><div class="routing-body-inner">
      <div class="filter-row"><div class="filter-info"><div class="filter-title"><span class="filter-icon ads"><i data-lucide="ban"></i></span> Bloqueo de anuncios</div></div><button class="toggle" data-filter="block_ads" onclick="toggleBlock('block_ads')"></button></div>
      <div class="filter-row"><div class="filter-info"><div class="filter-title"><span class="filter-icon track"><i data-lucide="radar"></i></span> Bloquear rastreadores</div></div><button class="toggle" data-filter="block_trackers" onclick="toggleBlock('block_trackers')"></button></div>
      <div class="filter-row"><div class="filter-info"><div class="filter-title"><span class="filter-icon adult"><i data-lucide="eye-off"></i></span> Bloquear adulto</div></div><button class="toggle" data-filter="block_adult" onclick="toggleBlock('block_adult')"></button></div>
      <div class="filter-row"><div class="filter-info"><div class="filter-title"><span class="filter-icon malware"><i data-lucide="shield-alert"></i></span> Bloquear malware</div></div><button class="toggle" data-filter="block_malware" onclick="toggleBlock('block_malware')"></button></div>
      <div class="filter-row"><div class="filter-info"><div class="filter-title"><span class="filter-icon captcha"><i data-lucide="bot"></i></span> Prevenir captcha</div></div><button class="toggle" data-filter="prevent_captcha" onclick="toggleBlock('prevent_captcha')"></button></div>
      <div class="filter-row"><div class="filter-info"><div class="filter-title"><span class="filter-icon torrent"><i data-lucide="download-cloud"></i></span> Bloquear BitTorrent</div></div><button class="toggle" data-filter="block_bittorrent" onclick="toggleBlock('block_bittorrent')"></button></div>
    </div></div>
  </div>
  <div class="routing-section open" id="secRules">
    <div class="routing-head" onclick="toggleSection('secRules')"><div class="routing-icon rules"><i data-lucide="list"></i></div><div class="routing-title"><div class="routing-title-text">Reglas Personalizadas</div><div class="routing-title-desc" id="rulesDesc"></div></div><i data-lucide="chevron-down" class="routing-chevron"></i></div>
    <div class="routing-body"><div class="routing-body-inner">
      <div style="display:flex;justify-content:flex-end;margin-bottom:12px;"><button class="btn btn-primary btn-sm" onclick="openRuleModal()"><i data-lucide="plus"></i> Nueva regla</button></div>
      <div id="rulesList"></div>
    </div></div>
  </div>
</div>

<div class="page" id="p-sub">
  <div class="page-title"><h1>Suscripción</h1></div>
  <div class="collapsible-section open" id="subBasic">
    <div class="collapsible-head" onclick="toggleSection('subBasic')"><div class="collapsible-icon sub"><i data-lucide="rss"></i></div><div class="collapsible-title"><div class="collapsible-title-text">Configuración básica</div></div><i data-lucide="chevron-down" class="collapsible-chevron"></i></div>
    <div class="collapsible-body"><div class="collapsible-body-inner">
      <div class="field-row"><div class="field"><label>Intervalo (horas)</label><input type="number" id="subInterval" min="1" max="1440" value="12"></div><div class="field"><label>Puerto</label><input type="number" id="subPort" min="1" max="65535"></div></div>
      <div class="field-row"><div class="field"><label>Ruta base</label><input type="text" id="subPath" placeholder="/sub"></div><div class="field"><label>Título</label><input type="text" id="subTitle" placeholder="Mi VPN"></div></div>
    </div></div>
  </div>
  <div class="collapsible-section" id="subInfo">
    <div class="collapsible-head" onclick="toggleSection('subInfo')"><div class="collapsible-icon info"><i data-lucide="eye"></i></div><div class="collapsible-title"><div class="collapsible-title-text">Información mostrada</div></div><i data-lucide="chevron-down" class="collapsible-chevron"></i></div>
    <div class="collapsible-body"><div class="collapsible-body-inner">
      <div class="row-switch" style="margin-bottom:0;"><div class="row-switch-text"><div class="row-switch-title">Mostrar uso de datos</div></div><button class="toggle" id="swSubUsage" onclick="toggleSubUsage()"></button></div>
    </div></div>
  </div>
  <div class="collapsible-section" id="subJson">
    <div class="collapsible-head" onclick="toggleSection('subJson')"><div class="collapsible-icon json"><i data-lucide="file-json"></i></div><div class="collapsible-title"><div class="collapsible-title-text">Suscripción JSON</div></div><i data-lucide="chevron-down" class="collapsible-chevron"></i></div>
    <div class="collapsible-body"><div class="collapsible-body-inner">
      <div class="row-switch"><div class="row-switch-text"><div class="row-switch-title" style="color:#6366f1;">Activar Suscripción JSON</div></div><button class="toggle" id="swJson" onclick="toggleJson()"></button></div>
      <div class="field-row"><div class="field"><label>Ruta JSON</label><input type="text" id="jsonPath" placeholder="/subjson" class="mono"></div><div class="field"><label>UA bloqueado</label><input type="text" id="jsonBypass" placeholder="Clash" class="mono"></div></div>
      <div class="field"><label>Dominios DIRECTO</label><textarea id="jsonBypassAll" placeholder="google.com&#10;youtube.com&#10;cn" rows="5"></textarea></div>
    </div></div>
  </div>
  <div class="collapsible-section" id="subSecurity">
    <div class="collapsible-head" onclick="toggleSection('subSecurity')"><div class="collapsible-icon security"><i data-lucide="shield-check"></i></div><div class="collapsible-title"><div class="collapsible-title-text">Seguridad de suscripción</div></div><i data-lucide="chevron-down" class="collapsible-chevron"></i></div>
    <div class="collapsible-body"><div class="collapsible-body-inner">
