function queryTrafficStats() {
    return new Promise(async (resolve) => {
        if (!fs.existsSync(XRAY_BIN)) return resolve({});
        if (isQuerying) return resolve({});
        isQuerying = true;
        const runCmd = (args) => new Promise((res) => {
            execFile(XRAY_BIN, args, {
                timeout: 2500,
                maxBuffer: 8 * 1024 * 1024,
                encoding: 'utf8',
                env: Object.assign({}, process.env, { XRAY_LOCATION_ASSET: '/usr/local/share/xray' })
            }, (err, stdout, stderr) => {
                res((stdout && String(stdout)) || (err && err.stdout && String(err.stdout)) || '');
            });
        });
        try {
            const attempts = [
                ['api', 'statsquery', '--server=127.0.0.1:' + XRAY_API_PORT],
                ['api', 'statsquery', '--server=127.0.0.1:' + XRAY_API_PORT, '-pattern', 'user>>>'],
            ];
            let lastOut = '';
            for (const args of attempts) {
                const out = await runCmd(args);
                lastOut = out || lastOut;
                const parsed = parseUserTrafficFromStats(out);
                if (Object.keys(parsed).length > 0) {
                    try { fs.writeFileSync(path.join(BASE_DIR, 'data', 'last-stats.json'), JSON.stringify({ at: new Date().toISOString(), n: Object.keys(parsed).length, keys: Object.keys(parsed).slice(0, 30) })); } catch (e) {}
                    isQuerying = false;
                    return resolve(parsed);
                }
            }
            if (Date.now() - lastStatsDebugLog > 30000) {
                lastStatsDebugLog = Date.now();
                logApply('[STATS] vacío sample=' + String(lastOut).slice(0, 200));
                try { fs.writeFileSync(path.join(BASE_DIR, 'data', 'last-stats-raw.txt'), lastOut || '(empty)'); } catch (e) {}
            }
            resolve(parseUserTrafficFromStats(lastOut));
        } catch (e) {
            resolve({});
        } finally {
            isQuerying = false;
        }
    });
}


async function processStatsSnapshot(trafficData) {
    const now = Date.now();
    const clients = vpnDb.prepare('SELECT id, email, up_bytes, down_bytes, total_bytes, online, last_seen, limit_gb, enabled FROM clients').all();
    const nowIso = new Date().toISOString();
    let configNeedsRefresh = false;
    let onlineChanged = false;
    const accessOnline = parseAccessLogOnline();
    if (isFirstSnapshot) {
        for (const c of clients) {
            const xemail = `c${c.id}`;
            const found = findClientTraffic(trafficData, c.id) || trafficData[xemail] || { up: 0, down: 0 };
            lastTrafficSnapshot[xemail] = { up: found.up || 0, down: found.down || 0 };
        }
        isFirstSnapshot = false;
    }
    const updateTraffic = vpnDb.prepare(`UPDATE clients SET up_bytes=?, down_bytes=?, total_bytes=?, online=?, last_seen=COALESCE(?, last_seen) WHERE id=?`);
    let onlineCount = 0;
    vpnDb.transaction(() => {
        for (const c of clients) {
            const xemail = `c${c.id}`;
            const found = findClientTraffic(trafficData, c.id);
            const hasData = !!found;
            const cur = found || { up: 0, down: 0 };
            const prev = lastTrafficSnapshot[xemail] || { up: 0, down: 0 };
            let deltaUp = cur.up - prev.up, deltaDown = cur.down - prev.down;
            if (deltaUp < 0) deltaUp = cur.up;
            if (deltaDown < 0) deltaDown = cur.down;

            // Sembrar desde Xray si la BD está en 0 y Xray ya tiene contadores
            let newUp = (c.up_bytes || 0) + deltaUp;
            let newDown = (c.down_bytes || 0) + deltaDown;
            if ((c.up_bytes || 0) === 0 && (c.down_bytes || 0) === 0 && hasData && (cur.up + cur.down) > 0) {
                newUp = cur.up;
                newDown = cur.down;
            }
            const newTotal = newUp + newDown;
            const hadTraffic = (deltaUp + deltaDown) > 0;
            if (hasData) lastTrafficSnapshot[xemail] = { up: cur.up, down: cur.down };

            let isOnline = 0, lastSeenUpdate = null;
            const actKey = xemail;
            if (hadTraffic) {
                lastActivityMs[actKey] = now;
                isOnline = 1;
                lastSeenUpdate = nowIso;
            }
            if (accessOnline && (accessOnline[`c${c.id}`] || accessOnline[c.id])) {
                const at = accessOnline[`c${c.id}`] || accessOnline[c.id];
                lastActivityMs[actKey] = Math.max(lastActivityMs[actKey] || 0, at);
            }
            const lastAct = lastActivityMs[actKey] || 0;
            if (lastAct && (now - lastAct) <= ONLINE_TIMEOUT_MS) {
                isOnline = 1;
                if (!lastSeenUpdate) lastSeenUpdate = new Date(lastAct).toISOString();
            } else {
                isOnline = 0;
            }
            if (isOnline) onlineCount++;
            const prevState = (lastOnlineState[actKey] != null) ? lastOnlineState[actKey] : (c.online || 0);
            if (isOnline !== prevState || isOnline !== (c.online || 0)) onlineChanged = true;
            lastOnlineState[actKey] = isOnline;
            updateTraffic.run(newUp, newDown, newTotal, isOnline, lastSeenUpdate, c.id);
            if (c.limit_gb > 0 && newTotal >= c.limit_gb * 1024 * 1024 * 1024 && c.enabled === 1) {
                vpnDb.prepare('UPDATE clients SET enabled = 0 WHERE id = ?').run(c.id);
                configNeedsRefresh = true;
            }
        }
    })();
    statsCache = { data: null, time: 0 };
    totalsCache = { data: null, time: 0 };
    if (now - lastStatsDebugLog > 60000) {
        lastStatsDebugLog = now;
        logApply(`[STATS] clients=${clients.length} online=${onlineCount} trafficEntries=${Object.keys(trafficData||{}).length} accessOnline=${Object.keys(accessOnline).length}`);
    }
    if (configNeedsRefresh) scheduleApply(true);
    if (onlineChanged) {
        statsCache = { data: null, time: 0 };
        totalsCache = { data: null, time: 0 };
    }
    return onlineChanged;
}

