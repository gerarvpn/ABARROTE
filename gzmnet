function getCertIssueDate() {
    try {
        const cfg = getVpnConfig();
        const domain = cfg.domain;
        if (!domain) return null;
        const certPath = `/etc/nginx/ssl/${domain}.crt`;
        if (!fs.existsSync(certPath)) return null;
        const out = execSync(`openssl x509 -in "${certPath}" -noout -startdate 2>/dev/null`, { timeout: 5000, encoding: 'utf8' });
        const str = out.replace('notBefore=', '').trim();
        const d = new Date(str);
        if (isNaN(d.getTime())) return null;
        return d;
    } catch(e) { return null; }
}
function getCertAgeHours() {
    const issue = getCertIssueDate();
    if (!issue) return -1;
    return (Date.now() - issue.getTime()) / 3600000;
}

