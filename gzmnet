echo -e "  \033[38;5;255m\033[1m  [OK] Instalación completada\033[0m"
echo -e "  \033[2m  ──────────────────────────────────────────\033[0m"
if [ "$PANEL_MODE" = "https" ]; then
    echo -e "  \033[2m  Panel\033[0m     \033[1m$PANEL_URL\033[0m  \033[38;5;39mHTTPS\033[0m"
else
