app.post('/api/inbounds', checkAuth, async (req, res) => {
    try {
        const b = req.body;
        const { name, protocol, port } = b;
        if (!name || !protocol || !port) return res.status(400).json({ ok: false, error: 'Faltan campos' });
        if (!PROTOCOL_TRANSPORTS[protocol]) return res.status(400).json({ ok: false, error: 'Protocolo inválido' });
        const portNum = parseInt(port);
        if (portNum < 1 || portNum > 65535) return res.status(400).json({ ok: false, error: 'Puerto inválido' });
        // FIX: warn if panel uses port 80 (Nginx) - panel must not be on port 80
        if (portNum === 80) {
            const vpnCfg = getVpnConfig();
            // Panel no longer uses port 80 in fallback (moved to 8443), so 80 is safe for Xray
        }
        const conflict = isPortInUseByOtherInbound(portNum); if (conflict) return res.status(400).json({ ok: false, error: `Puerto en uso por "${conflict.name}"` });
        const sys = await isPortInUseSystem(portNum); if (sys) return res.status(400).json({ ok: false, error: `Puerto usado` });
        let finalSecurity = b.security || 'none';
        if (!PROTOCOL_SECURITIES[protocol].includes(finalSecurity)) return res.status(400).json({ ok: false, error: `Seguridad "${finalSecurity}" no soportada por ${protocol}` });
        let net = String(b.network || 'ws').toLowerCase().trim();
        if (net === 'tcp' || net === 'raw') net = 'raw';
        // Reality solo con TCP (raw en BD)
        if (finalSecurity === 'reality') {
            net = 'raw';
            if (!b.reality_dest) b.reality_dest = 'www.cloudflare.com:443';
            if (!b.reality_server_names) b.reality_server_names = 'www.cloudflare.com';
            if (!b.reality_short_ids) b.reality_short_ids = generateShortId().slice(0, 8);
        }
        const allowedNets = PROTOCOL_TRANSPORTS[protocol] || ['ws', 'raw', 'tcp'];
        if (!allowedNets.includes(net) && !allowedNets.includes('raw') && net === 'raw') {
            /* allow */
        } else if (!allowedNets.includes(net)) {
            // fallback seguro en lugar de fallar en silencio
            net = allowedNets.includes('ws') ? 'ws' : (allowedNets[0] || 'ws');
        }
        const encKey = protocol === 'vless' ? getVlessDecryptionKey() : '';
        const info = vpnDb.prepare(`INSERT INTO inbounds (name, protocol, port, network, path, tls, domain, host, security, flow, sniffing, encryption, fingerprint, alpn, reality_dest, reality_server_names, reality_private_key, reality_public_key, reality_short_ids, grpc_service, grpc_multi, h2_path, h2_host, quic_key, quic_security, quic_header, kcp_seed, kcp_header, xhttp_path, xhttp_host, xhttp_mode, ss_method) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)`).run(
            name, protocol, portNum, net || 'ws', b.path || '/',
            (finalSecurity === 'tls' || finalSecurity === 'reality') ? 1 : 0,
            b.domain || '', b.host || '', finalSecurity, b.flow || '', b.sniffing ? 1 : 0, encKey,
            b.fingerprint || 'chrome', b.alpn || '',
            b.reality_dest || '', b.reality_server_names || '', b.reality_private_key || '', b.reality_public_key || '', b.reality_short_ids || '',
            b.grpc_service || '', b.grpc_multi ? 1 : 0,
            b.h2_path || '/', b.h2_host || '',
            b.quic_key || '', b.quic_security || 'none', b.quic_header || 'none',
            b.kcp_seed || '', b.kcp_header || 'none',
            b.xhttp_path || '/', b.xhttp_host || '', b.xhttp_mode || 'auto',
            b.ss_method || 'aes-256-gcm'
        );
        await ufwAllowPort(portNum);
        emitRefresh();
        res.json({ ok: true, id: info.lastInsertRowid, inbound: vpnDb.prepare('SELECT * FROM inbounds WHERE id = ?').get(info.lastInsertRowid) });
        scheduleApply(false);
    } catch(e) {
        try { logApply('CREATE INBOUND ERR: ' + (e && e.message ? e.message : e)); } catch(_){}
        res.status(500).json({ ok: false, error: e.message || String(e) });
    }
});
app.put('/api/inbounds/:id', checkAuth, async (req, res) => {
    try {
        const { id } = req.params;
        const old = vpnDb.prepare('SELECT * FROM inbounds WHERE id = ?').get(id);
        if (!old) return res.status(404).json({ ok: false, error: 'No existe' });
        const b = req.body;
        const portNum = parseInt(b.port);
        if (portNum !== old.port) { const c = isPortInUseByOtherInbound(portNum, id); if (c) return res.status(400).json({ ok: false, error: `Puerto en uso` }); const s = await isPortInUseSystem(portNum); if (s) return res.status(400).json({ ok: false, error: `Puerto usado` }); }
        let finalSecurity = b.security || 'none';
        if (!PROTOCOL_SECURITIES[b.protocol].includes(finalSecurity)) return res.status(400).json({ ok: false, error: `Seguridad no soportada` });
        let net = String(b.network || 'ws').toLowerCase().trim();
        if (net === 'tcp' || net === 'raw') net = 'raw';
        if (finalSecurity === 'reality') {
            net = 'raw';
            if (!b.reality_dest) b.reality_dest = 'www.cloudflare.com:443';
            if (!b.reality_server_names) b.reality_server_names = 'www.cloudflare.com';
            if (!b.reality_short_ids) b.reality_short_ids = generateShortId().slice(0, 8);
        }
        const encKey = b.protocol === 'vless' ? getVlessDecryptionKey() : '';
        vpnDb.prepare(`UPDATE inbounds SET name=?, protocol=?, port=?, network=?, path=?, tls=?, domain=?, host=?, security=?, flow=?, sniffing=?, encryption=?, fingerprint=?, alpn=?, reality_dest=?, reality_server_names=?, reality_private_key=?, reality_public_key=?, reality_short_ids=?, grpc_service=?, grpc_multi=?, h2_path=?, h2_host=?, quic_key=?, quic_security=?, quic_header=?, kcp_seed=?, kcp_header=?, xhttp_path=?, xhttp_host=?, xhttp_mode=?, ss_method=?, updated_at=datetime('now','localtime') WHERE id=?`).run(
            b.name, b.protocol, portNum, net || 'ws', b.path || '/',
            (finalSecurity === 'tls' || finalSecurity === 'reality') ? 1 : 0,
            b.domain || '', b.host || '', finalSecurity, b.flow || '', b.sniffing ? 1 : 0, encKey,
            b.fingerprint || 'chrome', b.alpn || '',
            b.reality_dest || '', b.reality_server_names || '', b.reality_private_key || '', b.reality_public_key || '', b.reality_short_ids || '',
            b.grpc_service || '', b.grpc_multi ? 1 : 0,
            b.h2_path || '/', b.h2_host || '',
            b.quic_key || '', b.quic_security || 'none', b.quic_header || 'none',
            b.kcp_seed || '', b.kcp_header || 'none',
            b.xhttp_path || '/', b.xhttp_host || '', b.xhttp_mode || 'auto',
            b.ss_method || 'aes-256-gcm',
            id
        );
        if (portNum !== old.port) { await ufwAllowPort(portNum); await ufwDeletePort(old.port); }
        emitRefresh();
        res.json({ ok: true, inbound: vpnDb.prepare('SELECT * FROM inbounds WHERE id = ?').get(id) });
        scheduleApply(false);
    } catch(e) { res.status(500).json({ ok: false, error: e.message }); }
});
app.delete('/api/inbounds/:id', checkAuth, async (req, res) => {
