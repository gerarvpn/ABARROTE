    fi

    _info "Liberando puerto 80 para ZeroSSL..."
    systemctl stop nginx 2>/dev/null || true
    fuser -k 80/tcp 2>/dev/null || true
    fuser -k 80/udp 2>/dev/null || true
    sleep 2
    _info "Emitiendo certificado ZeroSSL (ECC)..."
    for attempt in 1 2 3; do
