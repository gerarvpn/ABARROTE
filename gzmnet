            h2_path: v('ib-h2-path', '/') || '/',
            h2_host: v('ib-h2-host', ''),
            quic_key: v('ib-quic-key', ''),
            quic_security: v('ib-quic-security', 'none') || 'none',
            quic_header: 'none',
            kcp_seed: v('ib-kcp-seed', ''),
            kcp_header: v('ib-kcp-header', 'none') || 'none',
            xhttp_path: v('ib-xhttp-path', '/') || '/',
            xhttp_host: v('ib-xhttp-host', ''),
            xhttp_mode: v('ib-xhttp-mode', 'auto') || 'auto',
            ss_method: v('ib-ss-method', 'aes-256-gcm') || 'aes-256-gcm'
        };

        if (security === 'reality') {
            if (!body.reality_private_key || !body.reality_public_key) {
                toast('Reality requiere claves — pulsa Generar claves', 'warning');
                return;
            }
            if (!body.reality_dest) body.reality_dest = 'www.google.com:443';
            if (!body.reality_server_names) body.reality_server_names = 'www.google.com';
            body.network = 'raw';
            if ((body.protocol || '').toLowerCase() === 'vless' && !body.flow) body.flow = 'xtls-rprx-vision';
        }

        const url = id ? ('/api/inbounds/' + id) : '/api/inbounds';
        const r = await fetch(url, {
            method: id ? 'PUT' : 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
        });
        let d = null;
        try { d = await r.json(); } catch (e) { d = null; }
        if (d && d.ok) {
            closeInboundModal();
            await loadInbounds();
            renderServers();
            toast(id ? 'Servidor actualizado' : 'Servidor creado', 'success');
        } else {
            const msg = (d && d.error) ? d.error : ('Error HTTP ' + r.status);
            toast(msg, 'error', 6000);
        }
    } catch (e) {
        console.error('saveInbound', e);
        toast('Error: ' + (e && e.message ? e.message : 'desconocido'), 'error', 6000);
    } finally {
        savingInbound = false;
        if (btn) btn.disabled = false;
        if (txt) txt.textContent = prev;
    }
}

