)`);

run(`CREATE TABLE IF NOT EXISTS routing_rules (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  name TEXT NOT NULL,
  match_type TEXT DEFAULT 'domain',
  value TEXT DEFAULT '',
