            /root/.acme.sh/acme.sh --install-cert -d "$DOMAIN" --ecc \
                --key-file "$KEY_FILE" \
                --fullchain-file "$CERT_FILE" > /tmp/ssl-install-ecc.log 2>&1
            if [ -f "$CERT_FILE" ] && [ -f "$KEY_FILE" ] && [ -s "$CERT_FILE" ] && [ -s "$KEY_FILE" ]; then
                if openssl x509 -in "$CERT_FILE" -noout -checkhost "$DOMAIN" 2>/dev/null | grep -q "does match"; then
                    SSL_SUCCESS=1
                    _ok "ZeroSSL ECC emitido correctamente"
                    break
                fi
            fi
        fi
        sleep 8
    done

    if [ "$SSL_SUCCESS" -eq 0 ]; then
        _info "ECC falló, intentando ZeroSSL RSA..."
        for attempt in 1 2 3; do
            echo "    Intento RSA $attempt/3..."
            fuser -k -9 80/tcp 2>/dev/null || true
            sleep 3
            timeout 300 /root/.acme.sh/acme.sh --issue -d "$DOMAIN" --standalone --server zerossl --keylength 2048 --force --accountemail "admin@$DOMAIN" > /tmp/ssl-zerossl-rsa.log 2>&1
            if [ $? -eq 0 ]; then
