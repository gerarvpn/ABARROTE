                    if openssl x509 -in "$CERT_FILE" -noout -checkhost "$DOMAIN" 2>/dev/null | grep -q "does match"; then
                        SSL_SUCCESS=1
                        _ok "ZeroSSL RSA emitido correctamente"
                        break
                    fi
                fi
            fi
            sleep 8
        done
    fi

    if [ -f "/root/gzmnet/data/vpn.sqlite" ]; then
        XRAY_ON_80=$(sqlite3 "/root/gzmnet/data/vpn.sqlite" "SELECT COUNT(*) FROM inbounds WHERE port = 80" 2>/dev/null || echo 0)
