async function saveInbound(){
    if (savingInbound) return;
    savingInbound = true;
    const btn = document.getElementById('ibSaveBtn');
    const txt = document.getElementById('ibSaveTxt');
    const prev = txt ? txt.textContent : 'Crear';
    if (btn) btn.disabled = true;
    if (txt) txt.textContent = 'Guardando...';
    const v = (id, def) => {
        const el = document.getElementById(id);
        if (!el) return def !== undefined ? def : '';
        if (el.type === 'checkbox') return el.checked;
        return (el.value != null ? String(el.value) : '').trim();
    };
    try {
        const id = v('ib-id', '');
        let security = v('ib-security', 'none') || 'none';
        let network = (v('ib-network', 'ws') || 'ws').toLowerCase();
        if (network === 'tcp') network = 'raw';
        // Reality solo funciona con TCP puro
        if (security === 'reality') {
            network = 'raw';
            security = 'reality';
        }
        const proto = v('ib-protocol', 'vless') || 'vless';
        const domainVal = v('ib-domain', '');
        const portNum = parseInt(v('ib-port', ''), 10);
        const name = v('ib-name', '');
        if (!name) { toast('Escribe un nombre para el servidor', 'warning'); return; }
        if (!portNum || portNum < 1 || portNum > 65535) { toast('Puerto inválido (1-65535)', 'warning'); return; }

        let path = v('ib-path', '/') || '/';
        let host = v('ib-host', '');
        if (network === 'raw' || network === 'tcp') {
            // TCP puro: sin path ni host
            path = '/';
            host = '';
        }

        const body = {
            name: name,
            protocol: proto,
            port: portNum,
            network: network,
            path: path,
            tls: (security === 'tls' || security === 'reality'),
            security: security,
            domain: domainVal,
            host: host,
            sniffing: true,
            fingerprint: v('ib-tls-fp', 'chrome') || 'chrome',
            alpn: '',
            flow: v('ib-flow', ''),
            reality_dest: v('ib-reality-dest', '') || (security === 'reality' ? 'www.cloudflare.com:443' : ''),
            reality_server_names: v('ib-reality-server-names', '') || (security === 'reality' ? 'www.cloudflare.com' : ''),
            reality_private_key: v('ib-reality-private-key', ''),
            reality_public_key: v('ib-reality-public-key', ''),
            reality_short_ids: v('ib-reality-short-ids', ''),
            grpc_service: v('ib-grpc-service', ''),
