    const security = securityEarly;
    let flow = c.flow || c.inbound_flow || '';
    if (flow === 'xtls-rprx-vision') {
        if (network !== 'tcp') flow = '';
        if (security !== 'reality' && security !== 'tls') flow = '';
    }
    if (!flow && security === 'reality' && network === 'tcp') flow = 'xtls-rprx-vision';
    const params = new URLSearchParams();
    if (network === 'ws') { params.set('type', 'ws'); params.set('path', pathValue); if (hostHeader) params.set('host', hostHeader); }
    else if (network === 'httpupgrade') { params.set('type', 'httpupgrade'); params.set('path', pathValue); if (hostHeader) params.set('host', hostHeader); }
    else if (network === 'grpc') { params.set('type', 'grpc'); if (c.grpc_service) params.set('serviceName', c.grpc_service); if (c.grpc_multi == 1) params.set('mode', 'multi'); }
