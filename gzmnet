function getSubUaList() {
    const vpn = getVpnConfig();
    const raw = String(vpn.subUserAgent || '');
    return raw.split(/[,\n]+/).map(x => x.trim().toLowerCase()).filter(Boolean);
}
function validateUA(req) {
    const list = getSubUaList();
    if (list.length === 0) return true;
    const ua = String(req.get('user-agent') || '').toLowerCase();
    return list.some(a => ua.includes(a));
}
function deviceDisplayName(ua) {
    const l = String(ua || '').toLowerCase();
    if (l.includes('v2rayng')) return 'v2rayNG';
    if (l.includes('v2raytun')) return 'v2rayTun';
    if (l.includes('shadowrocket')) return 'Shadowrocket';
    if (l.includes('sing-box')) return 'Sing-Box';
    if (l.includes('nekobox')) return 'NekoBox';
    if (l.includes('nekoray')) return 'NekoRay';
    if (l.includes('hiddify')) return 'Hiddify';
    if (l.includes('streisand')) return 'Streisand';
    if (l.includes('clashmeta') || l.includes('clash')) return 'Clash';
    if (l.includes('quantumult')) return 'Quantumult';
    if (l.includes('surfboard')) return 'Surfboard';
    if (l.includes('mozilla') || l.includes('chrome') || l.includes('safari') || l.includes('firefox')) return 'Navegador';
    if (!ua) return 'Desconocido';
    return String(ua).substring(0, 30);
}
function trackDevice(clientId, req, deviceLimit) {
    const ua = String(req.get('user-agent') || '');
    const ip = req.ip || '0.0.0.0';
    const hash = crypto.createHash('sha256').update(ua).digest('hex').substring(0, 16);
    const existing = vpnDb.prepare('SELECT id FROM subscription_devices WHERE client_id = ? AND device_hash = ?').get(clientId, hash);
    if (existing) {
        vpnDb.prepare("UPDATE subscription_devices SET last_seen = datetime('now','localtime'), ip_address = ? WHERE id = ?").run(ip, existing.id);
        return { ok: true };
    }
    if (deviceLimit > 0) {
        const count = vpnDb.prepare('SELECT COUNT(*) as c FROM subscription_devices WHERE client_id = ?').get(clientId).c;
        if (count >= deviceLimit) return { ok: false, error: 'device_limit' };
    }
    vpnDb.prepare('INSERT INTO subscription_devices (client_id, device_hash, user_agent, display_name, ip_address) VALUES (?,?,?,?,?)').run(clientId, hash, ua.substring(0, 200), deviceDisplayName(ua), ip);
    return { ok: true };
}

