    const domains = [];
    const ips = [];
    for (const cond of conditions) {
        const value = String(cond.value || '').trim();
        if (!value) continue;
        if (cond.type === 'domain' || cond.type === 'geosite') {
            const vals = normalizeValues(value, cond.type === 'geosite' ? 'geosite' : 'domain');
