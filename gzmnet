printf " ██║  ███╗  ███╔╝ ██╔████╔██║██╔██╗ ██║█████╗     ██║\n"
printf " ██║   ██║ ███╔╝  ██║╚██╔╝██║██║╚██╗██║██╔══╝     ██║\n"
printf " ╚██████╔╝███████╗██║ ╚═╝ ██║██║ ╚████║███████╗   ██║\n"
printf "  ╚═════╝ ╚══════╝╚═╝     ╚═╝╚═╝  ╚═══╝╚══════╝   ╚═╝\n"
printf "\n                    G Z M N E T\n"
