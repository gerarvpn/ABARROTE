function buildStreamSettings(ib, domainSni) {
    // Transportes y seguridad compatibles con Xray 1.8+ / 24.x y clientes v2rayN, Streisand, Hiddify, etc.
    // - TCP: network "tcp" (no "raw") → máxima compatibilidad
    // - Reality: SOLO tcp + privateKey + serverNames + dest + shortIds (fingerprint SOLO en cliente)
    // - Vision: VLESS + tcp + reality|tls
    const streamSettings = {};
    let network = String(ib.network || 'ws').toLowerCase().trim();
    if (ib.protocol === 'socks' || ib.protocol === 'http') network = 'tcp';

    const hostHeader = (ib.host && String(ib.host).trim()) ? String(ib.host).trim() : '';
    const wsPath = (ib.path && String(ib.path).trim()) ? String(ib.path).trim() : '/';
    const alpnList = String(ib.alpn || '').split(',').map(x => x.trim()).filter(Boolean);
    let security = String(ib.security || (ib.tls ? 'tls' : 'none')).toLowerCase().trim();

    // Reality obliga TCP
    if (security === 'reality' && network !== 'tcp' && network !== 'raw') {
        network = 'tcp';
    }

    // ----- Transportes -----
    if (network === 'ws') {
        streamSettings.network = 'ws';
        streamSettings.wsSettings = { path: wsPath, headers: {} };
        if (hostHeader) streamSettings.wsSettings.host = hostHeader;
    } else if (network === 'httpupgrade') {
        streamSettings.network = 'httpupgrade';
        streamSettings.httpupgradeSettings = { path: wsPath };
        if (hostHeader) streamSettings.httpupgradeSettings.host = hostHeader;
    } else if (network === 'tcp' || network === 'raw') {
        // TCP siempre puro (sin path/host/HTTP header)
        streamSettings.network = 'tcp';
        streamSettings.tcpSettings = {
            acceptProxyProtocol: false,
            header: { type: 'none' }
        };
    } else if (network === 'grpc') {
        streamSettings.network = 'grpc';
        streamSettings.grpcSettings = {
            serviceName: String(ib.grpc_service || 'GunService').trim() || 'GunService',
            multiMode: !!(ib.grpc_multi == 1)
        };
    } else if (network === 'h2' || network === 'http') {
        streamSettings.network = 'h2';
        const hosts = [];
        const h = (ib.h2_host || hostHeader || '').trim();
        if (h) hosts.push(h);
        streamSettings.httpSettings = {
            path: (ib.h2_path || wsPath || '/'),
            host: hosts.length ? hosts : undefined
        };
    } else if (network === 'quic') {
        streamSettings.network = 'quic';
        streamSettings.quicSettings = {
            security: ib.quic_security || 'none',
            key: ib.quic_key || '',
            header: { type: ib.quic_header || 'none' }
        };
    } else if (network === 'kcp' || network === 'mkcp') {
        streamSettings.network = 'kcp';
        streamSettings.kcpSettings = {
            mtu: 1350,
            tti: 50,
            uplinkCapacity: 100,
            downlinkCapacity: 100,
            congestion: false,
            readBufferSize: 2,
            writeBufferSize: 2,
            header: { type: ib.kcp_header || 'none' },
            seed: ib.kcp_seed || ''
        };
    } else if (network === 'xhttp') {
        streamSettings.network = 'xhttp';
        streamSettings.xhttpSettings = {
            path: ib.xhttp_path || wsPath || '/',
            host: ib.xhttp_host || hostHeader || '',
            mode: ib.xhttp_mode || 'auto'
        };
    } else {
        // fallback seguro: TCP
        streamSettings.network = 'tcp';
        streamSettings.tcpSettings = { acceptProxyProtocol: false, header: { type: 'none' } };
    }

    // ----- Seguridad -----
    if (security === 'reality') {
        const serverNames = String(ib.reality_server_names || 'www.cloudflare.com')
            .split(',').map(x => x.trim()).filter(Boolean);
        // shortIds: hex 2-16 chars; incluir "" para clientes sin sid
        let shortIds = String(ib.reality_short_ids || '')
            .split(',').map(x => x.trim().toLowerCase()).filter(x => x === '' || /^[0-9a-f]{2,16}$/.test(x));
        if (!shortIds.filter(x => x).length) shortIds = [generateShortId().slice(0, 16)];
        if (!shortIds.includes('')) shortIds = ['', ...shortIds];
        const privateKey = String(ib.reality_private_key || '').trim();
        if (!privateKey) {
            streamSettings.security = 'none';
        } else {
            let dest = String(ib.reality_dest || 'www.cloudflare.com:443').trim();
            if (dest && !dest.includes(':')) dest = dest + ':443';
            streamSettings.security = 'reality';
            streamSettings.network = 'tcp';
            streamSettings.tcpSettings = {
                acceptProxyProtocol: false,
                header: { type: 'none' }
            };
            streamSettings.realitySettings = {
                show: false,
                dest: dest,
                xver: 0,
                serverNames: serverNames.length ? serverNames : ['www.cloudflare.com'],
                privateKey: privateKey,
                shortIds: shortIds
            };
        }
    } else if (security === 'tls' || ib.tls) {
        streamSettings.security = 'tls';
        const certDomain = domainSni || String(ib.domain || '').trim() || 'server';
        streamSettings.tlsSettings = {
            certificates: [{
                certificateFile: `/etc/nginx/ssl/${certDomain}.crt`,
                keyFile: `/etc/nginx/ssl/${certDomain}.key`
            }],
            alpn: alpnList.length ? alpnList : ['h2', 'http/1.1']
        };
        if (domainSni) streamSettings.tlsSettings.serverName = domainSni;
    } else {
        streamSettings.security = 'none';
    }

    // sockopt suave (tcpCongestion bbr a veces falla si el módulo no está)
    streamSettings.sockopt = {
        tcpNoDelay: true,
        tcpKeepAliveIdle: 30,
        tcpKeepAliveInterval: 15
    };
    return streamSettings;
}


function buildXrayConfig() {
    const inbounds = vpnDb.prepare('SELECT * FROM inbounds ORDER BY id').all();
    const s = vpnDb.prepare('SELECT * FROM routing_settings WHERE id = 1').get() || {};
    const xrayInbounds = [{ tag: "api", listen: "127.0.0.1", port: XRAY_API_PORT, protocol: "dokodemo-door", settings: { address: "127.0.0.1", port: 0 } }];
    const allClients = vpnDb.prepare('SELECT * FROM clients WHERE enabled = 1').all();
    const clientsByInb = {};
    for (const c of allClients) { if (!clientsByInb[c.inbound_id]) clientsByInb[c.inbound_id] = []; clientsByInb[c.inbound_id].push(c); }
    for (const ib of inbounds) {
        const clients = clientsByInb[ib.id] || [];
        const domainSni = (ib.domain && ib.domain.trim()) ? ib.domain.trim() : "";
        let streamSettings; try { streamSettings = buildStreamSettings(ib, domainSni); } catch(e) { continue; }
        // Sniffing SIEMPRE activo: sin esto los filtros por dominio (ads/youtube/etc) no aplican
        const sniffing = { enabled: true, destOverride: ["http", "tls", "quic"], metadataOnly: false, routeOnly: true };
        let inboundObj;
        if (ib.protocol === 'vless') {
            const decryptionKey = getVlessDecryptionKey();
            const clientObjs = clients.map(c => {
                let flow = c.flow || ib.flow || '';
                const net = String(ib.network || streamSettings.network || '').toLowerCase();
                const isTcp = (net === 'tcp' || net === 'raw');
                const sec = streamSettings.security || 'none';
                // Vision solo con VLESS + TCP/raw + reality/tls
                if (flow === 'xtls-rprx-vision') {
                    if (!isTcp || (sec !== 'reality' && sec !== 'tls')) flow = '';
                }
                // Auto-vision en Reality+TCP si no hay flow
                if (!flow && sec === 'reality' && isTcp) flow = 'xtls-rprx-vision';
                return { id: c.uuid, email: `c${c.id}`, flow, level: 0 };
            });
            const settings = { clients: clientObjs, decryption: (decryptionKey && decryptionKey !== 'none') ? decryptionKey : 'none' };
            inboundObj = { tag: `ib-${ib.id}`, listen: "0.0.0.0", port: ib.port, protocol: "vless", settings, streamSettings, sniffing };
        } else if (ib.protocol === 'vmess') {
            const clientObjs = clients.map(c => ({ id: c.uuid, email: `c${c.id}`, alterId: 0, level: 0 }));
            inboundObj = { tag: `ib-${ib.id}`, listen: "0.0.0.0", port: ib.port, protocol: "vmess", settings: { clients: clientObjs }, streamSettings, sniffing };
        } else if (ib.protocol === 'trojan') {
            const clientObjs = clients.map(c => ({ password: c.uuid, email: `c${c.id}`, level: 0 }));
            const trojanSettings = { clients: clientObjs };
            
            inboundObj = { tag: `ib-${ib.id}`, listen: "0.0.0.0", port: ib.port, protocol: "trojan", settings: trojanSettings, streamSettings, sniffing };
        } else if (ib.protocol === 'shadowsocks') {
            const method = ib.ss_method || 'aes-256-gcm';
            const clientObjs = clients.map(c => ({ password: c.uuid, email: `c${c.id}`, method, level: 0 }));
            inboundObj = { tag: `ib-${ib.id}`, listen: "0.0.0.0", port: ib.port, protocol: "shadowsocks", settings: { method, clients: clientObjs, network: "tcp,udp" }, streamSettings, sniffing };
        } else if (ib.protocol === 'socks') {
            // Auto-generar auth si falta (proxy no funciona sin user/pass para stats)
            const accounts = clients.map(c => {
                let u = c.auth_user, p = c.auth_pass;
                if (!u || !p) {
                    u = u || ('user_' + c.id);
                    p = p || generatePassword();
                    try { vpnDb.prepare('UPDATE clients SET auth_user=?, auth_pass=? WHERE id=?').run(u, p, c.id); } catch(e) {}
                }
                return { user: String(u), pass: String(p), email: `c${c.id}`, level: 0 };
            });
            inboundObj = { tag: `ib-${ib.id}`, listen: "0.0.0.0", port: ib.port, protocol: "socks", settings: { auth: accounts.length ? 'password' : 'noauth', accounts, udp: true }, streamSettings, sniffing };
        } else if (ib.protocol === 'http') {
            const accounts = clients.map(c => {
                let u = c.auth_user, p = c.auth_pass;
                if (!u || !p) {
                    u = u || ('user_' + c.id);
                    p = p || generatePassword();
                    try { vpnDb.prepare('UPDATE clients SET auth_user=?, auth_pass=? WHERE id=?').run(u, p, c.id); } catch(e) {}
                }
                return { user: String(u), pass: String(p) };
            });
            inboundObj = { tag: `ib-${ib.id}`, listen: "0.0.0.0", port: ib.port, protocol: "http", settings: { accounts }, streamSettings, sniffing };
        }
        if (inboundObj) xrayInbounds.push(inboundObj);
    }
    const domainStrategy = s.domain_strategy || 'IPIfNonMatch';
    const ipType = s.ip_type || 'dual';
    const routingRules = buildXrayRouting();
    const dnsConfig = buildXrayDns();
    const customRules = vpnDb.prepare('SELECT * FROM routing_rules WHERE enabled = 1').all();
    const rulesNeedWarp = customRules.some(r => r.outbound === 'warp' || r.outbound === 'proxy');
    const useWarp = (s.warp_enabled == 1 || rulesNeedWarp) && wireproxyReady;
    const optimizedSockopt = getOptimizedSockopt();
    const outbounds = [
        { protocol: "freedom", tag: "direct", settings: { domainStrategy: "AsIs" }, streamSettings: { sockopt: optimizedSockopt } },
        { protocol: "blackhole", tag: "block", settings: { response: { type: "none" } } }
    ];
    if (useWarp) outbounds.push({ tag: "warp", protocol: "socks", settings: { servers: [{ address: "127.0.0.1", port: 40000 }] }, streamSettings: { sockopt: optimizedSockopt } });
    return { log: { access: path.join(BASE_DIR, "data", "xray-access.log"), loglevel: "warning" }, api: { tag: "api", services: ["HandlerService", "LoggerService", "StatsService"] }, stats: {}, dns: dnsConfig, policy: { levels: { "0": { statsUserUplink: true, statsUserDownlink: true, statsUserOnline: true }, "1": { statsUserUplink: true, statsUserDownlink: true, statsUserOnline: true } }, system: { statsInboundUplink: true, statsInboundDownlink: true, statsOutboundUplink: true, statsOutboundDownlink: true } }, inbounds: xrayInbounds, outbounds, routing: { domainStrategy, rules: routingRules } };
}

