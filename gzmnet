                    const portalUrl = `https://${domain}${subPortPart}/portal/${subToken}`;
                    resp += `\n📲 <b>Suscripción</b>\n<code>${subUrl}</code>\n`;
                    resp += `\n🌐 <b>Portal</b>\n<code>${portalUrl}</code>\n`;
