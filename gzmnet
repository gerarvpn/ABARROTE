            delete botState[chatId];
            scheduleApply(true);
            emitRefresh();
            return;
        }
        if (state.action === 'copy_config' && state.step === 'id') {
            const id = parseInt(text);
            if (!id) { await tgSend(chatId, '❌ ID inválido.'); return; }
            const c = vpnDb.prepare('SELECT * FROM clients WHERE id = ?').get(id);
            if (!c) { await tgSend(chatId, '❌ No existe.'); return; }
