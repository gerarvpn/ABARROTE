if [ -n "${INSTALL_ERRORS:-}" ]; then
  echo -e "\033[38;5;203m\033[1m"
  echo "  ┌──────────────────────────────────────┐"
  echo "  │  Instalación con avisos / errores    │"
  echo "  └──────────────────────────────────────┘"
  echo -e "\033[0m"
  echo -e "\033[38;5;203m${INSTALL_ERRORS}\033[0m"
