        pm2 restart xray 2>/dev/null || pm2 describe xray >/dev/null 2>&1 && pm2 restart xray 2>/dev/null || pm2 start /usr/local/bin/xray-pm2-wrapper.sh --name xray --interpreter bash --cwd /usr/local/etc/xray >/dev/null 2>&1 || true
        sleep 5
        # REQUISITO D: verificar que :80 vuelve a escuchar (reintentos)
        for attempt in 1 2 3; do
            if ss -tln 2>/dev/null | grep -q ':80 '; then
                echo "[$(date)] Puerto 80 OK (intento $attempt)" >> "$LOG"
                break
            fi
            echo "[$(date)] Puerto 80 NO escucha — pm2 restart xray ($attempt/3)" >> "$LOG"
            pm2 restart xray 2>/dev/null || pm2 describe xray >/dev/null 2>&1 && pm2 restart xray 2>/dev/null || pm2 start /usr/local/bin/xray-pm2-wrapper.sh --name xray --interpreter bash --cwd /usr/local/etc/xray >/dev/null 2>&1 || true
            sleep 3
        done
        if ! ss -tln 2>/dev/null | grep -q ':80 '; then
            echo "[$(date)] ADVERTENCIA: puerto 80 aún no escucha tras 3 reintentos" >> "$LOG"
        fi
    fi
fi
systemctl start nginx 2>/dev/null || true
nginx -t && systemctl reload nginx 2>/dev/null || systemctl restart nginx 2>/dev/null || true

echo "[$(date)] === Renovación completada ===" >> "$LOG"
RENEWEOF

sed -i "s/__DOMAIN__/$DOMAIN/g" /usr/local/bin/gzmnet-renew-cert.sh
chmod +x /usr/local/bin/gzmnet-renew-cert.sh

