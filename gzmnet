        const upEl = document.getElementById('statUp'); if (upEl) upEl.textContent = fmtB(c.up);
        const downEl = document.getElementById('statDown'); if (downEl) downEl.textContent = fmtB(c.down);
        const totalEl = document.getElementById('statTotal'); if (totalEl) totalEl.textContent = fmtB(c.total);
        const wrap = document.getElementById('usageBarWrap');
        if (wrap && INITIAL_LIMIT_GB > 0) {
            const pct = Math.min(100, (c.total / (INITIAL_LIMIT_GB * 1024 * 1024 * 1024)) * 100);
            wrap.innerHTML = '<div class="usage-bar"><div class="usage-fill" style="width:' + pct + '%"></div></div><div class="usage-text">' + fmtB(c.total) + ' de ' + INITIAL_LIMIT_GB + ' GB (' + pct.toFixed(0) + '%)</div>';
        }
    } catch(e) {}
});
setInterval(() => { const d = document.getElementById('liveDot'); if (d) { d.style.opacity = d.style.opacity === '0.3' ? '1' : '0.3'; } }, 1000);

async function fetchVapid() {
    try { const r = await fetch('/api/portal/' + TOKEN + '/vapid', { cache: 'no-store' }); const d = await r.json(); if (d.ok && d.publicKey) { VAPID_PUB = d.publicKey; return true; } } catch(e) {}
    return !!VAPID_PUB;
}
async function subscribe() {
    try {
        if (!VAPID_PUB) { const ok = await fetchVapid(); if (!ok) { showToast('Servidor sin VAPID'); return false; } }
        const reg = await navigator.serviceWorker.ready;
        let sub = await reg.pushManager.getSubscription();
        if (sub) await sub.unsubscribe();
        sub = await reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: b64ToUint8(VAPID_PUB) });
        const subData = sub.toJSON ? sub.toJSON() : sub;
        const r = await fetch('/api/portal/' + TOKEN + '/subscribe', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(subData) });
        const d = await r.json();
        if (d.ok) { hideNotifCard(); return true; }
        return false;
    } catch(e) { return false; }
}
async function requestNotif() {
    try {
        if (!VAPID_PUB) { const ok = await fetchVapid(); if (!ok) { showToast('Servidor sin VAPID'); return; } }
        const perm = await Notification.requestPermission();
        if (perm !== 'granted') { showToast('Permiso denegado'); return; }
        const ok = await subscribe();
        if (ok) showToast('Notificaciones activadas');
        else showToast('Error al suscribir');
    } catch(e) { showToast('Error: ' + e.message); }
}
async function checkNotifStatus() {
    if (!('serviceWorker' in navigator) || !('PushManager' in window)) { hideNotifCard(); return; }
    if (Notification.permission === 'denied') { hideNotifCard(); return; }
    if (!VAPID_PUB) { const ok = await fetchVapid(); if (!ok) { hideNotifCard(); return; } }
    if (Notification.permission === 'granted') { try { const reg = await navigator.serviceWorker.ready; const sub = await reg.pushManager.getSubscription(); if (sub) { hideNotifCard(); return; } } catch(e) {} }
    showNotifCard();
}
async function bootstrapNotif() {
    if (!('serviceWorker' in navigator) || !('PushManager' in window)) { hideNotifCard(); return; }
    try { await navigator.serviceWorker.register('/sw.js'); } catch(e) {}
    try { await navigator.serviceWorker.ready; } catch(e) {}
    if (!VAPID_PUB) { await fetchVapid(); }
    await checkNotifStatus();
    if (Notification.permission === 'granted') { try { const reg = await navigator.serviceWorker.ready; const sub = await reg.pushManager.getSubscription(); if (!sub) { const ok = await subscribe(); if (ok) hideNotifCard(); } } catch(e) {} }
}
bootstrapNotif();

let installPrompt = null;
window.addEventListener('beforeinstallprompt', e => { e.preventDefault(); installPrompt = e; document.getElementById('installBanner').classList.add('on'); });
document.getElementById('installBtn').addEventListener('click', async () => { if (!installPrompt) return; installPrompt.prompt(); await installPrompt.userChoice; installPrompt = null; document.getElementById('installBanner').classList.remove('on'); });
</script>
