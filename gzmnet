async function tgSend(chatId, text, opts) { return tgApi('sendMessage', { chat_id: chatId, text, parse_mode: 'HTML', disable_web_page_preview: true, ...(opts || {}) }); }
async function tgSendDocument(chatId, filename, content, caption) {
    const s = getTelegramSettings();
    if (!s.bot_token) return { ok: false };
    try {
        const buf = Buffer.from(typeof content === 'string' ? content : JSON.stringify(content), 'utf8');
        // multipart manual (compatible Node 18+)
        const boundary = '----GZMNET' + Date.now();
        const chunks = [];
        const push = (s) => chunks.push(Buffer.from(s, 'utf8'));
        push('--' + boundary + '\r\n');
        push('Content-Disposition: form-data; name="chat_id"\r\n\r\n' + String(chatId) + '\r\n');
        if (caption) {
            push('--' + boundary + '\r\n');
            push('Content-Disposition: form-data; name="caption"\r\n\r\n' + String(caption) + '\r\n');
        }
        push('--' + boundary + '\r\n');
        push('Content-Disposition: form-data; name="document"; filename="' + filename + '"\r\n');
        push('Content-Type: application/json\r\n\r\n');
        chunks.push(buf);
        push('\r\n--' + boundary + '--\r\n');
        const body = Buffer.concat(chunks);
        const r = await fetch(`https://api.telegram.org/bot${s.bot_token}/sendDocument`, {
            method: 'POST',
            headers: { 'Content-Type': 'multipart/form-data; boundary=' + boundary },
            body,
            signal: AbortSignal.timeout(60000)
        });
        return await r.json();
    } catch (e) { return { ok: false, error: e.message }; }
}

