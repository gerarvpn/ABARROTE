app.post('/api/clients', checkAuth, async (req, res) => {
    try {
        const { inbound_id, name, email, limit_gb, flow, credential, auth_user, auth_pass, sub_token, payment_enabled, payment_date, payment_frequency, payment_time, telegram_chat_id, device_limit, routing_bypass } = req.body;
        if (!inbound_id || !name) return res.status(400).json({ ok: false, error: 'Faltan campos' });
        const ib = vpnDb.prepare('SELECT * FROM inbounds WHERE id = ?').get(inbound_id);
        if (!ib) return res.status(404).json({ ok: false, error: 'Servidor no existe' });
        const isAuth = protocolUsesAuth(ib.protocol);
