function getProtocolsInfo() {
    const fb = { vless:{transports:['tcp','ws','xhttp','grpc','httpupgrade','kcp'],securities:['none','tls','reality']}, vmess:{transports:['tcp','ws','xhttp','grpc','httpupgrade','kcp'],securities:['none','tls','reality']}, trojan:{transports:['tcp','ws','xhttp','grpc','httpupgrade','kcp'],securities:['none','tls','reality']}, shadowsocks:{transports:['tcp','ws','xhttp','grpc','httpupgrade','kcp'],securities:['none','tls']}, socks:{transports:['tcp'],securities:['none','tls']}, http:{transports:['tcp'],securities:['none','tls']} };
    if (!protocolsInfo || !protocolsInfo.vless) return fb;
    return protocolsInfo;
}
function onProtocolChange() {
    const proto = document.getElementById('ib-protocol').value;
    const info = getProtocolsInfo();
    let transports = (info[proto] && info[proto].transports) || ['raw','ws'];
    // Una sola entrada TCP (raw y tcp son el mismo transporte)
    transports = [...new Set(transports.map(t => (t === 'raw' ? 'tcp' : t)))];
    if (!transports.includes('tcp')) transports = ['tcp', ...transports];
    const securities = (info[proto] && info[proto].securities) || ['none'];
    const netSel = document.getElementById('ib-network');
    let curNet = netSel.value === 'raw' ? 'tcp' : netSel.value;
    const secNow = (document.getElementById('ib-security') || {}).value || 'none';
    if (secNow === 'reality') transports = ['tcp'];
    netSel.innerHTML = transports.map(t => {
        const label = t === 'tcp' ? 'TCP' : (t === 'ws' ? 'WebSocket' : (t === 'httpupgrade' ? 'HTTPUpgrade' : t.toUpperCase()));
        return `<option value="${t}">${label}</option>`;
    }).join('');
    if (transports.includes(curNet)) netSel.value = curNet;
    else netSel.value = transports[0] || 'tcp';
    netSel.disabled = (secNow === 'reality');
    const secSel = document.getElementById('ib-security');
    const curSec = secSel.value;
    secSel.innerHTML = securities.map(s => `<option value="${s}">${s === 'none' ? 'Ninguna' : s === 'tls' ? 'TLS' : 'Reality'}</option>`).join('');
    if (securities.includes(curSec)) secSel.value = curSec;
    document.getElementById('ssMethodFields').style.display = proto === 'shadowsocks' ? 'block' : 'none';
    const isSimple = (proto === 'socks' || proto === 'http');
    document.getElementById('ib-network-wrap').style.display = isSimple ? 'none' : 'block';
    document.getElementById('ib-security-wrap').style.display = isSimple ? 'none' : 'block';
    if (isSimple) {
        ['wsFields','grpcFields','h2Fields','quicFields','kcpFields','xhttpFields'].forEach(id => { const e = document.getElementById(id); if (e) e.style.display = 'none'; });
    }
    onSecurityChange();
    onNetworkChange();
}

