    else if (network === 'kcp') { params.set('type', 'kcp'); if (c.kcp_header) params.set('headerType', c.kcp_header); if (c.kcp_seed) params.set('seed', c.kcp_seed); }
    else if (network === 'xhttp') { params.set('type', 'xhttp'); params.set('path', c.xhttp_path || pathValue); if (c.xhttp_host || hostHeader) params.set('host', c.xhttp_host || hostHeader); if (c.xhttp_mode) params.set('mode', c.xhttp_mode); }
    else { params.set('type', 'tcp'); params.set('headerType', 'none'); }

    if (security === 'reality') {
        // Export estándar Reality: TCP + vision + pbk/sid/sni/fp
        params.set('type', 'tcp');
        params.set('headerType', 'none');
        params.set('security', 'reality');
        params.set('sni', sni || 'www.cloudflare.com');
        params.set('fp', c.fingerprint || 'chrome');
        const pbk = String(c.reality_public_key || '').trim();
        if (pbk) params.set('pbk', pbk);
        const sids = String(c.reality_short_ids || '').split(',').map(x => x.trim()).filter(x => x && /^[0-9a-fA-F]+$/.test(x));
        if (sids.length) params.set('sid', sids[0]);
        params.set('spx', '/');
        params.set('flow', 'xtls-rprx-vision');
