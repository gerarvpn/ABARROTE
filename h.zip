try{vpnDb.exec(`CREATE TABLE IF NOT EXISTS payment_reminder_jobs(id INTEGER PRIMARY KEY AUTOINCREMENT,client_id INTEGER NOT NULL,reminder_key TEXT NOT NULL,sent_count INTEGER NOT NULL DEFAULT 0,attempts INTEGER NOT NULL DEFAULT 0,next_send_at TEXT NOT NULL DEFAULT (datetime('now','localtime')),next_send_epoch INTEGER NOT NULL DEFAULT 0,completed INTEGER NOT NULL DEFAULT 0,created_at TEXT DEFAULT (datetime('now','localtime')),UNIQUE(client_id,reminder_key),FOREIGN KEY(client_id) REFERENCES clients(id) ON DELETE CASCADE)`)}catch(e){logApply(`[PAYMENT-JOBS-DB] ${e.message}`)}
try{const cols=vpnDb.prepare('PRAGMA table_info(payment_reminder_jobs)').all().map(c=>c.name);if(!cols.includes('next_send_epoch'))vpnDb.exec('ALTER TABLE payment_reminder_jobs ADD COLUMN next_send_epoch INTEGER NOT NULL DEFAULT 0')}catch(e){logApply(`[PAYMENT-JOBS-MIGRATION] ${e.message}`)}
try{vpnDb.exec('CREATE INDEX IF NOT EXISTS idx_payment_jobs_due ON payment_reminder_jobs(completed,next_send_epoch,next_send_at)')}catch(e){logApply(`[PAYMENT-JOBS-INDEX] ${e.message}`)}
try{vpnDb.exec('DELETE FROM push_subscriptions WHERE id NOT IN (SELECT MAX(id) FROM push_subscriptions GROUP BY client_id,endpoint); CREATE UNIQUE INDEX IF NOT EXISTS idx_push_client_endpoint ON push_subscriptions(client_id,endpoint)')}catch(e){logApply(`[PUSH-INDEX-MIGRATION] ${e.message}`)}
try{const cols=vpnDb.prepare('PRAGMA table_info(push_invalid_endpoints)').all().map(c=>c.name);if(!cols.includes('p256dh'))vpnDb.exec("ALTER TABLE push_invalid_endpoints ADD COLUMN p256dh TEXT DEFAULT ''");if(!cols.includes('auth'))vpnDb.exec("ALTER TABLE push_invalid_endpoints ADD COLUMN auth TEXT DEFAULT ''")}catch(e){logApply(`[PUSH-INVALID-MIGRATION] ${e.message}`)}
try{const cols=vpnDb.prepare('PRAGMA table_info(push_subscriptions)').all().map(c=>c.name);if(!cols.includes('vapid_public_key'))vpnDb.exec("ALTER TABLE push_subscriptions ADD COLUMN vapid_public_key TEXT DEFAULT ''")}catch(e){logApply(`[PUSH-VAPID-MIGRATION] ${e.message}`)}
try{vpnDb.exec(`CREATE TABLE IF NOT EXISTS admin_notifications(id INTEGER PRIMARY KEY AUTOINCREMENT,title TEXT NOT NULL,body TEXT NOT NULL,created_at TEXT DEFAULT (datetime('now','localtime')),seen INTEGER DEFAULT 0)`)}catch(e){}
try{const cols=vpnDb.prepare('PRAGMA table_info(clients)').all().map(c=>c.name);if(!cols.includes('payment_message'))vpnDb.exec("ALTER TABLE clients ADD COLUMN payment_message TEXT DEFAULT ''")}catch(e){logApply(`[PAYMENT-MESSAGE-MIGRATION] ${e.message}`)}
try{let cols=vpnDb.prepare('PRAGMA table_info(clients)').all().map(c=>c.name);if(!cols.includes('quota_used_bytes')){vpnDb.exec('ALTER TABLE clients ADD COLUMN quota_used_bytes INTEGER DEFAULT 0');vpnDb.prepare('UPDATE clients SET quota_used_bytes=CASE WHEN limit_gb>0 THEN COALESCE(total_bytes,0) ELSE 0 END').run();cols.push('quota_used_bytes')}if(!cols.includes('quota_exhausted_at')){vpnDb.exec("ALTER TABLE clients ADD COLUMN quota_exhausted_at TEXT DEFAULT ''");cols.push('quota_exhausted_at')}const directionMissing=!cols.includes('quota_up_bytes')||!cols.includes('quota_down_bytes');if(!cols.includes('quota_up_bytes'))vpnDb.exec('ALTER TABLE clients ADD COLUMN quota_up_bytes INTEGER DEFAULT 0');if(!cols.includes('quota_down_bytes'))vpnDb.exec('ALTER TABLE clients ADD COLUMN quota_down_bytes INTEGER DEFAULT 0');if(directionMissing)vpnDb.exec(`UPDATE clients SET quota_up_bytes=CASE WHEN total_bytes>0 THEN MIN(MAX(CAST(quota_used_bytes*1.0*up_bytes/total_bytes AS INTEGER),0),MAX(quota_used_bytes,0)) ELSE 0 END,quota_down_bytes=MAX(COALESCE(quota_used_bytes,0)-CASE WHEN total_bytes>0 THEN MIN(MAX(CAST(quota_used_bytes*1.0*up_bytes/total_bytes AS INTEGER),0),MAX(quota_used_bytes,0)) ELSE 0 END,0) WHERE COALESCE(quota_used_bytes,0)>0`)}catch(e){logApply(`[QUOTA-USAGE-MIGRATION] ${e.message}`)}
try{for(const [col,def] of [['routing_enabled','INTEGER DEFAULT 1'],['routing_filters_enabled','INTEGER DEFAULT 1'],['custom_routing_enabled','INTEGER DEFAULT 1']]){const cols=vpnDb.prepare('PRAGMA table_info(clients)').all().map(c=>c.name);if(!cols.includes(col))vpnDb.exec(`ALTER TABLE clients ADD COLUMN ${col} ${def}`)}}catch(e){logApply(`[CLIENT-ROUTING-MIGRATION] ${e.message}`)}
try{vpnDb.exec('DELETE FROM push_subscriptions WHERE id NOT IN (SELECT MAX(id) FROM push_subscriptions GROUP BY client_id,endpoint); CREATE UNIQUE INDEX IF NOT EXISTS idx_push_client_endpoint ON push_subscriptions(client_id,endpoint)')}catch(e){logApply(`[PUSH-INDEX-MIGRATION] ${e.message}`)}
if(vapidKeyChangedAtStartup)try{const invalid=vpnDb.prepare('SELECT DISTINCT endpoint FROM push_subscriptions UNION SELECT DISTINCT endpoint FROM admin_push_subscriptions').all();for(const row of invalid){const sub=vpnDb.prepare('SELECT p256dh,auth FROM push_subscriptions WHERE endpoint=? LIMIT 1').get(row.endpoint)||vpnDb.prepare('SELECT p256dh,auth FROM admin_push_subscriptions WHERE endpoint=? LIMIT 1').get(row.endpoint)||{};vpnDb.prepare("INSERT OR REPLACE INTO push_invalid_endpoints(endpoint,p256dh,auth,marked_at) VALUES(?,?,?,datetime('now','localtime'))").run(row.endpoint,sub.p256dh||'',sub.auth||'')}logApply(`[VAPID-ROTATED] invalid endpoints marked=${invalid.length}; preserving until renewed`)}catch(e){logApply(`[VAPID-ROTATED-MARK-ERROR] ${e.message}`)}
// No se rotan ni convierten claves VLESS heredadas automáticamente: hacerlo invalida perfiles ya instalados. Los pares existentes se conservan hasta que el administrador genere uno nuevo explícitamente.
try{const legacy=vpnDb.prepare("SELECT COUNT(*) AS n FROM inbounds WHERE protocol='vless' AND vless_encryption!='' AND length(vless_encryption)>100").get();if(legacy&&legacy.n)logApply(`[VLESS-MIGRATE-SKIPPED] ${legacy.n} pares heredados largos se conservaron para no invalidar perfiles activos; usa Generar solo si vas a actualizar los perfiles de clientes.`)}catch(e){}
const loginAttempts = new Map();
function checkLoginRate(ip) { const now = Date.now(); const rec = loginAttempts.get(ip); if (!rec) return true; if (rec.until > now) return false; if (now - rec.until > 15*60*1000) { loginAttempts.delete(ip); return true; } return true; }
function recordFailedLogin(ip) { const now = Date.now(); const rec = loginAttempts.get(ip) || { count: 0, until: 0 }; rec.count++; if (rec.count >= 5) { rec.until = now + 15*60*1000; rec.count = 0; } loginAttempts.set(ip, rec); }
function clearLoginAttempts(ip) { loginAttempts.delete(ip); }

function getVlessDecryptionKey() { try { return fs.readFileSync(VLESS_DECRYPTION_KEY_PATH, 'utf8').trim(); } catch(e) { return 'none'; } }
function getVlessEncryptionKey() { try { return fs.readFileSync(VLESS_ENCRYPTION_KEY_PATH, 'utf8').trim(); } catch(e) { return 'none'; } }
function generateUuid() { return crypto.randomUUID(); }
function generatePassword() { return crypto.randomBytes(18).toString('base64').replace(/[+/=]/g, '').substring(0, 24); }
function generateShortToken(len = 8) { const chars = 'abcdefghjkmnpqrstuvwxyz23456789'; const bytes = crypto.randomBytes(len); let t = ''; for (let i = 0; i < len; i++) t += chars[bytes[i] % chars.length]; return t; }
function generateShortId() { return crypto.randomBytes(8).toString('hex'); }
function ensureUniqueSubToken() { for (let i = 0; i < 15; i++) { const t = generateShortToken(8); try { if (!vpnDb.prepare('SELECT id FROM clients WHERE sub_token = ?').get(t)) return t; } catch(e) {} } return generateShortToken(12); }
function isPortInUseByOtherInbound(port, excludeId = null) { return excludeId ? vpnDb.prepare('SELECT id, name FROM inbounds WHERE port = ? AND id != ?').get(port, excludeId) : vpnDb.prepare('SELECT id, name FROM inbounds WHERE port = ?').get(port); }
function isPortInUseSystem(port) { const p=parseInt(port,10);if(!Number.isInteger(p)||p<1||p>65535)return Promise.resolve(true);return new Promise(resolve => { exec(`ss -H -ltnup 'sport = :${p}' 2>/dev/null`, { timeout: 3000 }, (err, stdout) => resolve(!err && stdout && stdout.trim().length > 0)); }); }
function generateVlessKeypair() {
    return new Promise(resolve => {
        const xrayBin=fs.existsSync(XRAY_BIN)?XRAY_BIN:'/usr/local/bin/xray';
        execFile(xrayBin, ['x25519'], {timeout:10000,maxBuffer:65536}, (err,stdout,stderr) => {
            const text=String(stdout||'').replace(/\r/g,'').trim();
            if(err||!text)return resolve({error:String(stderr||(err&&err.message)||'xray x25519 no devolvió salida').trim()});
            let privateKey='',password='';
            for(const line of text.split(/\n/)){
                const m=line.match(/^\s*([^:]+):\s*(.+?)\s*$/);if(!m)continue;
                const label=m[1].toLowerCase().replace(/[^a-z0-9]/g,'');
                if(label==='privatekey')privateKey=m[2].trim();
                if(label==='password'||label==='passwordpublickey')password=m[2].trim();
            }
            if(!privateKey||!password)return resolve({error:`Xray no devolvió PrivateKey/Password (PublicKey). Binario: ${xrayBin}; salida: ${text.slice(0,600)}`});
            const base='mlkem768x25519plus.native.';
            resolve({decryption:base+'600s.'+privateKey,encryption:base+'0rtt.'+password});
        });
    });
}


async function migrateLegacyVlessEncryptionToShort() {
    if(isApplying)return;
    try {
        const rows=vpnDb.prepare("SELECT id,name,vless_encryption FROM inbounds WHERE protocol='vless' AND vless_encryption!=''").all();
        for(const row of rows){
            const last=String(row.vless_encryption||'').split('.').pop();
            if(!last||last.length<100)continue;
            const pair=await generateVlessKeypair();
            if(!pair||pair.error){logApply(`[VLESS-MIGRATE-ERROR] inbound=${row.id} ${pair&&pair.error||'key generation failed'}`);continue}
            try{
                vpnDb.exec('BEGIN IMMEDIATE');
                vpnDb.prepare("UPDATE inbounds SET vless_decryption=?,vless_encryption=?,updated_at=datetime('now','localtime') WHERE id=?").run(pair.decryption,pair.encryption,row.id);
                invalidateConfigCache();
                const cfg=JSON.stringify(buildXrayConfig(),null,2),check=await validateXrayConfig(cfg);
                if(!check.ok){vpnDb.exec('ROLLBACK');invalidateConfigCache();logApply(`[VLESS-MIGRATE-ROLLBACK] inbound=${row.id} original keys retained; ${String(check.output||'').slice(0,4000)}`);continue}
                vpnDb.exec('COMMIT');
                logApply(`[VLESS-MIGRATE] inbound=${row.id} validated short pair; subscribed clients must refresh`);
                forceNextApply=true;lastWrittenConfigHash='';scheduleApply(true);
            }catch(e){try{vpnDb.exec('ROLLBACK')}catch(_){}invalidateConfigCache();logApply(`[VLESS-MIGRATE-ROLLBACK] inbound=${row.id} ${e.stack||e.message}`)}
        }
    }catch(e){logApply(`[VLESS-MIGRATE-FATAL] ${e.stack||e.message}`)}
}

function compactVlessEncryption(value) { return String(value||'').trim(); }
function isValidVlessEncKey(value) { return typeof value === 'string' && value.trim().length >= 16 && value.trim().length <= 4096 && !/[\r\n]/.test(value); }
function getInboundVlessKeys(ib) {
    return { decryption: (ib && ib.vless_decryption) || getVlessDecryptionKey(), encryption: (ib && ib.vless_encryption) || getVlessEncryptionKey() };
}
function generateRealityKeypair() { return new Promise(resolve=>{exec('/usr/local/bin/xray x25519',{timeout:10000,maxBuffer:65536},(err,stdout,stderr)=>{const text=String(stdout||'').replace(/\r/g,'');if(err||!text.trim())return resolve({error:String(stderr||(err&&err.message)||'Xray no devolvió salida').trim()});let privateKey='',publicKey='';for(const line of text.split(/\n/)){const m=line.match(/^\s*([^:]+):\s*(.+?)\s*$/);if(!m)continue;const label=m[1].toLowerCase().replace(/[^a-z0-9]/g,'');if(label==='privatekey')privateKey=m[2].trim();else if(label==='password'||label==='passwordpublickey'||label==='publickey')publicKey=m[2].trim()}if(!privateKey||!publicKey)return resolve({error:'No se reconocieron PrivateKey y Password (PublicKey) de xray x25519'});resolve({privateKey,publicKey})})})}

const MONTHS_ES = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
function formatDateSpanish(dateStr) {
    try {
        const parts = String(dateStr).split('-');
        if (parts.length !== 3) return dateStr;
        const y = parseInt(parts[0]), m = parseInt(parts[1]) - 1, d = parseInt(parts[2]);
        if (isNaN(y) || isNaN(m) || isNaN(d) || m < 0 || m > 11) return dateStr;
        return `${d} de ${MONTHS_ES[m]}`;
    } catch(e) { return dateStr; }
}
function getLocalClockParts(instant=new Date()){try{const parts=new Intl.DateTimeFormat('en-CA',{timeZone:SERVER_TZ,year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',second:'2-digit',hourCycle:'h23'}).formatToParts(instant);return Object.fromEntries(parts.filter(p=>p.type!=='literal').map(p=>[p.type,p.value]))}catch(e){const d=new Date(instant);return {year:String(d.getFullYear()),month:String(d.getMonth()+1).padStart(2,'0'),day:String(d.getDate()).padStart(2,'0'),hour:String(d.getHours()).padStart(2,'0'),minute:String(d.getMinutes()).padStart(2,'0'),second:String(d.getSeconds()).padStart(2,'0')}}}
function getTzDate(){try{return new Date(new Date().toLocaleString('en-US',{timeZone:SERVER_TZ}))}catch(e){return new Date()}}
function getTodayKey(){const p=getLocalClockParts();return `${p.year}-${p.month}-${p.day}`}
function getLocalMinuteOfDay(){const p=getLocalClockParts();return Number(p.hour)*60+Number(p.minute)}
function dateKeyAddDays(key,days){const [y,m,d]=String(key||'').split('-').map(Number);if(!y||!m||!d)return '';const x=new Date(Date.UTC(y,m-1,d+days));return `${x.getUTCFullYear()}-${String(x.getUTCMonth()+1).padStart(2,'0')}-${String(x.getUTCDate()).padStart(2,'0')}`}
function dateKeyDiffDays(from,to){const a=String(from||'').split('-').map(Number),b=String(to||'').split('-').map(Number);if(a.length!==3||b.length!==3||!a[0]||!b[0])return NaN;return Math.round((Date.UTC(b[0],b[1]-1,b[2])-Date.UTC(a[0],a[1]-1,a[2]))/86400000)}

const XRAY_BIN = '/usr/local/bin/xray';
const XRAY_CONFIG = '/usr/local/etc/xray/config.json';
const XRAY_CONFIG_TEST = '/usr/local/etc/xray/config-test.json';
const XRAY_CONFIG_BAK = '/usr/local/etc/xray/config.json.bak';
const XRAY_API_PORT = 10085;

function checkXrayActive(){return new Promise(resolve=>{execFile('ss',['-H','-ltn'],{timeout:2500,encoding:'utf8'},(err,out)=>{if(!err&&String(out||'').split('\n').some(line=>new RegExp('127\\.0\\.0\\.1:'+XRAY_API_PORT+'(?:\\s|$)').test(line)))return resolve(true);execFile(XRAY_BIN,['api','statsquery',`--server=127.0.0.1:${XRAY_API_PORT}`],{timeout:2500,encoding:'utf8'},(e,o)=>resolve(!e&&!!String(o||'').trim()))})})}
function restartXrayNow(){return new Promise(resolve=>execFile('systemctl',['restart','gzmnet-xray.service'],{timeout:30000,encoding:'utf8'},err=>resolve(!err)))}
function getWarpWireguardSettings(settingsOverride){
  try{
    const file='/etc/wireproxy/wgcf-profile.conf';if(!fs.existsSync(file))return null;
    const sections={Interface:{},Peer:{}};let section='';
    for(const raw of fs.readFileSync(file,'utf8').split(/\r?\n/)){
      const line=raw.trim();if(!line||line.startsWith('#')||line.startsWith(';'))continue;
      const sm=line.match(/^\[([^\]]+)\]$/);if(sm){section=sm[1];if(!sections[section])sections[section]={};continue}
      const i=line.indexOf('=');if(i<1||!section)continue;
      const key=line.slice(0,i).trim().toLowerCase(),value=line.slice(i+1).trim();
      if(!sections[section][key])sections[section][key]=[];sections[section][key].push(value);
    }
    const iface=sections.Interface||{},peer=sections.Peer||{};
    const one=(obj,k)=>obj[k]&&obj[k][0]?obj[k][0].trim():'';
    const secretKey=one(iface,'privatekey'),publicKey=one(peer,'publickey');let endpoint=one(peer,'endpoint');
    const routing=settingsOverride||vpnDb.prepare('SELECT * FROM routing_settings WHERE id=1').get()||{},ipType=['ipv4','ipv6','dual'].includes(routing.ip_type)?routing.ip_type:'dual';
    let address=(iface.address||[]).map(x=>x.trim()).filter(x=>/^.+\/(32|128)$/.test(x)&&net.isIP(x.split('/')[0])).map(x=>x.split('/')[0]);
    const familyOfCidr=x=>net.isIP(String(x).split('/')[0]);
    if(ipType==='ipv4')address=address.filter(x=>familyOfCidr(x)===4);else if(ipType==='ipv6')address=address.filter(x=>familyOfCidr(x)===6);
    let allowedIPs=(peer.allowedips||[]).flatMap(x=>x.split(',')).map(x=>x.trim()).filter(Boolean);
    if(ipType==='ipv4')allowedIPs=allowedIPs.filter(x=>familyOfCidr(x)===4);else if(ipType==='ipv6')allowedIPs=allowedIPs.filter(x=>familyOfCidr(x)===6);
    if(!allowedIPs.length)allowedIPs=ipType==='ipv4'?['0.0.0.0/0']:ipType==='ipv6'?['::/0']:['0.0.0.0/0','::/0'];
    const match=endpoint.match(/^(.+):(\d+)$/);if(!secretKey||!publicKey||!address.length||!match)return null;
    let host=match[1].replace(/^\[|\]$/g,'');const port=parseInt(match[2]);
    let endpointFamily=net.isIP(host);if(ipType==='ipv4'&&endpointFamily===6||ipType==='ipv6'&&endpointFamily===4)return null;
    if(!endpointFamily){try{const families=ipType==='ipv4'?[4]:ipType==='ipv6'?[6]:[4,6];let resolved='';for(const family of families){try{const out=execFileSync('getent',[family===6?'ahostsv6':'ahostsv4',host],{timeout:5000,encoding:'utf8',stdio:['ignore','pipe','ignore']}).trim();resolved=out.split(/\s+/)[0];if(net.isIP(resolved)===family)break;resolved=''}catch(e){resolved=''}}if(!resolved)return null;host=resolved;endpointFamily=net.isIP(host)}catch(e){return null}}
    endpoint=endpointFamily===6?`[${host}]:${port}`:`${host}:${port}`;
    const rawReserved=one(peer,'reserved')||one(iface,'reserved');let reserved=[0,0,0];
    if(rawReserved){try{const parsed=JSON.parse(rawReserved);if(Array.isArray(parsed)&&parsed.length===3)reserved=parsed.map(x=>Math.max(0,Math.min(255,parseInt(x)||0)))}catch(e){const dec=rawReserved.match(/^\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)\s*$/);const hex=rawReserved.replace(/^0x/i,'').replace(/[^a-f0-9]/gi,'');if(dec)reserved=dec.slice(1).map(x=>Math.max(0,Math.min(255,parseInt(x)||0)));else if(hex.length===6)reserved=[0,2,4].map(i=>parseInt(hex.slice(i,i+2),16))}}
    const remoteDNS=getDnsAddresses({...routing,ip_type:ipType});
    return {secretKey,address,peers:[{endpoint,publicKey,allowedIPs}],reserved,noKernelTun:true,remoteDNS};
  }catch(e){logApply(`[WARP-WIREGUARD-PROFILE] ${e.message}`);return null}
}
function isWireproxyInstalled() { try { const r = execSync('command -v wireproxy 2>/dev/null').toString().trim(); return r.length > 0; } catch(e) { return fs.existsSync('/usr/local/bin/wireproxy'); } }
function isWireproxyRunning() { return new Promise(resolve => { exec('systemctl is-active wireproxy 2>/dev/null', { timeout: 3000 }, (err, stdout) => { if ((stdout || '').trim() !== 'active') return resolve(false); exec('timeout 3 bash -c "</dev/tcp/127.0.0.1/40000" 2>/dev/null', { timeout: 5000 }, (err2) => resolve(!err2)); }); }); }
async function ensureWireproxy() { if (await isWireproxyRunning()) { wireproxyReady = true; return { ok: true }; } if (!isWireproxyInstalled()) { wireproxyReady = false; return { ok: false, error: 'WireProxy no instalado' }; } await new Promise(resolve => exec('systemctl restart wireproxy 2>/dev/null || true', { timeout: 15000 }, () => resolve())); await new Promise(resolve => setTimeout(resolve, 5000)); const ok = await isWireproxyRunning(); wireproxyReady = ok; return ok ? { ok: true } : { ok: false, error: 'WireProxy no responde' }; }
async function refreshWireproxyStatus() { try { const prev = wireproxyReady; wireproxyReady = await isWireproxyRunning(); if (prev && !wireproxyReady) { await ensureWireproxy(); } } catch(e) { wireproxyReady = false; } }

let applyChain = Promise.resolve();
let lastWrittenConfigHash = '';
let xrayHealthy = true;
let applyDebounceTimer = null;
const APPLY_DEBOUNCE_MS = 1000;
let isApplying = false;
let pendingApply = false;
let forceNextApply = false;
let cachedConfig = null, cachedConfigHash = '', cachedConfigTime = 0;
const CONFIG_CACHE_TTL = 5000;

function hashString(s) { return crypto.createHash('sha1').update(s).digest('hex'); }
function invalidateConfigCache() { cachedConfig = null; cachedConfigHash = ''; cachedConfigTime = 0; }
function getCachedConfig() { const now = Date.now(); if (cachedConfig && (now - cachedConfigTime) < CONFIG_CACHE_TTL) return { config: cachedConfig, hash: cachedConfigHash }; const config = buildXrayConfig(); const hash = hashString(JSON.stringify(config)); cachedConfig = config; cachedConfigHash = hash; cachedConfigTime = now; return { config, hash }; }
async function waitXrayReady(maxMs = 12000) { const start = Date.now(); while ((Date.now() - start) < maxMs) { if (await checkXrayActive()) return true; await new Promise(r => setTimeout(r, 500)); } return false; }
async function _doApplyInternal() {
    try {
        const { config: newConfig, hash: newHash } = getCachedConfig();
        const newConfigStr = JSON.stringify(newConfig, null, 2);
        // A forced save is not a reason to interrupt every VPN session: compare against the actual active file.
        try { const active=JSON.parse(fs.readFileSync(XRAY_CONFIG,'utf8')); if(hashString(JSON.stringify(active))===newHash&&await checkXrayActive()){lastWrittenConfigHash=newHash;forceNextApply=false;xrayHealthy=true;return {ok:true,skipped:true,unchanged:true}} } catch(_) {}
        if (!forceNextApply && newHash === lastWrittenConfigHash && await checkXrayActive()) return { ok: true, skipped: true, unchanged:true };
        forceNextApply = false;
        const valid = await validateXrayConfig(newConfigStr);
        if (!valid.ok) { xrayHealthy=await checkXrayActive(); const detail=String(valid.output||'Sin detalle del binario');logApply('CONFIG INVALIDA (no se reemplazó la configuración activa):\n'+detail.slice(0,12000));return {ok:false,error:'Xray rechazó la configuración nueva; se conservó la anterior y los túneles activos.'}; }
        if (fs.existsSync(XRAY_CONFIG)) try { fs.copyFileSync(XRAY_CONFIG, XRAY_CONFIG_BAK); } catch(e) {}
        const stagedConfig=XRAY_CONFIG+`.pending-${process.pid}`;
        fs.writeFileSync(stagedConfig,newConfigStr,{mode:0o600});
        fs.renameSync(stagedConfig,XRAY_CONFIG);
        const restartCommandOk=await restartXrayNow();
        // Judge success by the live Xray API, not only systemctl's exit code (systemd may report a transient error while Xray is already back).
        const active=await waitXrayReady(25000);
        if(!restartCommandOk&&active)logApply('[APPLY] systemctl returned a warning, but Xray API is healthy; keeping the validated configuration.');
        if(!active){
            if(fs.existsSync(XRAY_CONFIG_BAK)){try{const restoreTmp=XRAY_CONFIG+`.restore-${process.pid}`;fs.copyFileSync(XRAY_CONFIG_BAK,restoreTmp);fs.renameSync(restoreTmp,XRAY_CONFIG);const restored=await restartXrayNow();if(restored)await waitXrayReady(20000)}catch(e){logApply(`[XRAY-ROLLBACK-ERROR] ${e.message}`)}return {ok:false,error:'Xray no confirmó la API tras el cambio. Se restauró la configuración anterior; revisa los logs de Xray.'}}
            return {ok:false,error:'Xray no confirmó la API después del cambio.'};
        }
        xrayHealthy = true;
        lastWrittenConfigHash = newHash;
        return { ok: true };
    } catch (e) { logApply('EXC: ' + e.message); return { ok: false, error: e.message }; }
}
function execFileAsyncSafe(file,args,options={}){return new Promise((resolve,reject)=>execFile(file,args,{timeout:options.timeout||7000,maxBuffer:1024*1024,encoding:'utf8',stdio:['ignore','pipe','pipe']},(err,stdout,stderr)=>{if(err){err.stdout=stdout;err.stderr=stderr;reject(err)}else resolve({stdout,stderr})}))}
async function applyRoutingLive(){
  const server=`127.0.0.1:${XRAY_API_PORT}`,bin=XRAY_BIN;
  const candidate=buildXrayConfig();
  const previousConfig=JSON.parse(fs.readFileSync(XRAY_CONFIG,'utf8'));
  const oldWarp=previousConfig.outbounds.filter(o=>o.tag==='warp'),newWarp=candidate.outbounds.filter(o=>o.tag==='warp');
  const warpProfileChanged=oldWarp.length>0&&newWarp.length>0&&JSON.stringify(oldWarp)!==JSON.stringify(newWarp);
  // Regla-only mutations are applied through the live routing API. A stale DNS JSON comparison
  // must not block them: DNS settings are changed only by the dedicated validated settings endpoint.
  if(warpProfileChanged)throw new Error('El perfil WARP cambió mientras se editaba la regla; aplica la configuración WARP completa antes de continuar.');
  if(!Array.isArray(candidate.routing.rules)||!candidate.routing.rules.length)throw new Error('No hay reglas de enrutamiento para aplicar.');
  const outboundsRaw=JSON.parse((await execFileAsyncSafe(bin,['api','lso',`--server=${server}`],{timeout:3000})).stdout);
  const outbounds=Array.isArray(outboundsRaw)?outboundsRaw:(outboundsRaw.outbounds||outboundsRaw.Outbounds||[]);
  const tags=new Set((Array.isArray(outbounds)?outbounds:[]).map(o=>o.tag||o.Tag).filter(Boolean));
  const s=vpnDb.prepare('SELECT * FROM routing_settings WHERE id=1').get()||{};
  const rules=vpnDb.prepare('SELECT * FROM routing_rules WHERE enabled=1 ORDER BY priority DESC,id ASC').all();
  const needsWarp=Number(s.warp_enabled)===1||rules.some(r=>r.outbound==='warp'||r.outbound==='proxy');
  const current=JSON.parse((await execFileAsyncSafe(bin,['api','lsrules',`--server=${server}`],{timeout:3000})).stdout);
  const liveRules=Array.isArray(current)?current:(current.rules||current.Rules||[]);
  const apiOutbound='api';
  const dnsConfigured=candidate.dns&&Array.isArray(candidate.dns.servers)&&candidate.dns.servers.length>0;
  const missing=candidate.outbounds.filter(o=>!tags.has(o.tag));if(missing.length){const outFile=`${DATA_DIR}/routing-outbounds-${process.pid}.json`;try{fs.writeFileSync(outFile,JSON.stringify({outbounds:missing}),{mode:0o600});await execFileAsyncSafe(bin,['api','ado',`--server=${server}`,outFile],{timeout:5000});missing.forEach(o=>tags.add(o.tag))}finally{try{fs.unlinkSync(outFile)}catch(_){}}}
  const requireTags=['direct','block','dns-out'];
  if(!dnsConfigured||requireTags.some(t=>!tags.has(t)))throw new Error('Xray no confirma las salidas necesarias para aplicar el enrutamiento; se conservó la configuración activa.');
  if(needsWarp&&!tags.has('warp'))throw new Error('Xray no pudo añadir la salida WARP en caliente. Se conserva la regla anterior y las sesiones.');
  const previousTags=liveRules.map(r=>r.ruleTag||r.RuleTag).filter(t=>t&&String(t).startsWith('gzmnet-live-'));
  const livePrefix=`gzmnet-live-${Date.now()}-${process.pid}-`;
  const liveConverted=candidate.routing.rules.map((r,i)=>({...r,ruleTag:livePrefix+i}));
  const payload=JSON.stringify({routing:{domainStrategy:candidate.routing.domainStrategy,rules:liveConverted}}),tmp=`${DATA_DIR}/routing-live-${process.pid}.json`;
  fs.writeFileSync(tmp,payload,{mode:0o600});
  try{
    // Add and confirm the new set before removing the active rules: never leave Xray with an empty routing table.
    await execFileAsyncSafe(bin,['api','adrules',`--server=${server}`,'--append',tmp],{timeout:5000});
    const verifyRaw=(await execFileAsyncSafe(bin,['api','lsrules',`--server=${server}`],{timeout:3000})).stdout;
    const verify=JSON.parse(verifyRaw),nowRules=Array.isArray(verify)?verify:(verify.rules||verify.Rules||[]);
    const count=nowRules.filter(r=>String(r.ruleTag||r.RuleTag||'').startsWith(livePrefix)).length;
    if(count!==liveConverted.length)throw new Error(`Xray confirmó ${count} de ${liveConverted.length} reglas nuevas`);
    if(previousTags.length)await execFileAsyncSafe(bin,['api','rmrules',`--server=${server}`,...previousTags],{timeout:4000});
    lastWrittenConfigHash=hashString(JSON.stringify(candidate));xrayHealthy=true;return {ok:true,live:true};
  }catch(e){
    try{
      const raw=(await execFileAsyncSafe(bin,['api','lsrules',`--server=${server}`],{timeout:3000})).stdout,listed=JSON.parse(raw),arr=Array.isArray(listed)?listed:(listed.rules||listed.Rules||[]);
      const newTags=arr.map(r=>r.ruleTag||r.RuleTag).filter(t=>t&&String(t).startsWith(livePrefix));if(newTags.length)await execFileAsyncSafe(bin,['api','rmrules',`--server=${server}`,...newTags],{timeout:3000});
      const remaining=(await execFileAsyncSafe(bin,['api','lsrules',`--server=${server}`],{timeout:3000})).stdout,parsed=JSON.parse(remaining),now=Array.isArray(parsed)?parsed:(parsed.rules||parsed.Rules||[]),remainingTags=new Set(now.map(r=>r.ruleTag||r.RuleTag).filter(Boolean)),missingOld=liveRules.filter(r=>{const tag=r.ruleTag||r.RuleTag;return tag&&String(tag).startsWith('gzmnet-live-')&&!remainingTags.has(tag)});
      if(missingOld.length){const rollback=`${DATA_DIR}/routing-rollback-${process.pid}.json`;try{fs.writeFileSync(rollback,JSON.stringify({routing:{rules:missingOld}}),{mode:0o600});await execFileAsyncSafe(bin,['api','adrules',`--server=${server}`,'--append',rollback],{timeout:4000})}finally{try{fs.unlinkSync(rollback)}catch(_){}}}
    }catch(restoreError){logApply(`[ROUTING-LIVE-ROLLBACK-ERROR] ${restoreError.message}`)}
    throw e;
  }finally{try{fs.unlinkSync(tmp)}catch(_){}}
}
async function applyRoutingRulesSafely(){
  const candidate=buildXrayConfig();let current;
  try{current=JSON.parse(fs.readFileSync(XRAY_CONFIG,'utf8'))}catch(e){throw new Error('No se pudo leer la configuración activa de Xray para validar la regla: '+e.message)}
  const sig=c=>JSON.stringify((c.inbounds||[]).map(x=>({tag:x.tag,sniffing:x.sniffing||{enabled:false}})));
  if(sig(candidate)!==sig(current)){invalidateConfigCache();forceNextApply=true;const result=await applyXrayNow();if(!result||!result.ok)throw new Error(result&&result.error||'Xray no confirmó la configuración de sniffing');return result}
  const result=await applyXrayNow({routingOnly:true});if(!result||!result.ok)throw new Error(result&&result.error||'Xray no confirmó las reglas en caliente');return result;
}
async function applyRoutingWithoutRestart(){try{return await applyRoutingLive()}catch(e){logApply(`[ROUTING-LIVE-ERROR] ${e.message}`);return {ok:false,error:e.message}}}
function applyXrayNow(options={}) {
    const myPromise = applyChain.then(async () => {
        if (isApplying) { pendingApply = true; return { ok: true, queued: true }; }
        isApplying = true;
        try { let r=options.routingOnly?await applyRoutingLive():await _doApplyInternal();while(pendingApply){pendingApply=false;await new Promise(r=>setTimeout(r,250));const r2=options.routingOnly?await applyRoutingLive():await _doApplyInternal();if(r2&&!r2.skipped)r=r2}return r}finally{isApplying=false}
    }).catch((e) => ({ ok: false, error: e.message || String(e) }));
    applyChain = myPromise.catch(() => {});
    return myPromise;
}
function scheduleApply(force = true) { if (force) forceNextApply = true; invalidateConfigCache(); if (applyDebounceTimer) clearTimeout(applyDebounceTimer); applyDebounceTimer = setTimeout(() => { applyDebounceTimer = null; applyXrayNow().then(r=>{if(!r.ok)logApply(`[APPLY-ASYNC-ERROR] ${r.error||'No se pudo aplicar Xray'}`)}); }, APPLY_DEBOUNCE_MS); }

setInterval(async () => {
    try {
        if ((Date.now() - panelStartedAt) < 90000) return;
        if (isApplying) return;
        if(!(await checkXrayActive())){logApply('[XRAY-WATCHDOG] Xray no responde; systemd reinicia el servicio');await restartXrayNow();if(!(await waitXrayReady(20000)))logApply('[XRAY-WATCHDOG-FAILED] Xray sigue sin API activa tras reiniciar; consulta journalctl -u gzmnet-xray.service')}
    } catch(e) {}
}, 240000);
setInterval(refreshWireproxyStatus, 30000);

async function performFullCacheClean(){
    try{vpnDb.pragma('wal_checkpoint(PASSIVE)')}catch(e){logApply(`[CACHE-CHECKPOINT] ${e.message}`)}
    try{for(const file of ['/var/log/xray/access.log','/var/log/xray/error.log'])if(fs.existsSync(file)){const st=fs.statSync(file);if(st.size>8*1024*1024){const rotated=file+'.1';try{fs.unlinkSync(rotated)}catch(e){}fs.renameSync(file,rotated);fs.writeFileSync(file,'',{mode:0o640})}}}catch(e){logApply(`[CACHE-LOG-ROTATE] ${e.message}`)}
    // Keep the daily maintenance task lightweight so active VPN sessions are not stalled.
    vpnDb.prepare("UPDATE routing_settings SET last_cache_at=datetime('now','localtime') WHERE id=1").run();
}

setInterval(async () => {
    try {
        const s = vpnDb.prepare('SELECT cache_enabled, cache_hour, cache_minute, last_cache_at FROM routing_settings WHERE id = 1').get() || {};
        if (!s.cache_enabled) return;
        const now = getTzDate();
        const curMin = now.getHours() * 60 + now.getMinutes();
        const ch = parseInt(s.cache_hour, 10); const cm = parseInt(s.cache_minute, 10);
        const confMin = (isNaN(ch) ? 4 : ch) * 60 + (isNaN(cm) ? 0 : cm);
        if (curMin < confMin || curMin > confMin + 4) return;
        const todayKey = getTodayKey();
        if (lastCacheRunDate === todayKey) return;
        lastCacheRunDate = todayKey;
        await performFullCacheClean();
    } catch(e) {}
}, 60000);

setInterval(() => {
    try {
        const totalMem = os.totalmem(); const usedMem = totalMem - os.freemem();
        const ramPct = (usedMem / totalMem) * 100;
        vpnDb.prepare('INSERT INTO system_metrics (cpu, ram) VALUES (?, ?)').run(cpuUsagePercent, ramPct);
        vpnDb.prepare("DELETE FROM system_metrics WHERE ts < datetime('now','localtime','-4 days')").run();
    } catch(e) {}
}, 300000);

const KNOWN_GEOSITE_TAGS = new Set(['google','youtube','facebook','twitter','instagram','tiktok','linkedin','reddit','telegram','whatsapp','netflix','spotify','twitch','openai','amazon','microsoft','apple','cloudflare','steam','github','cn','ir','ru','private','geolocation-!cn','category-ads-all','category-porn','category-trackers','category-malware','speedtest']);
