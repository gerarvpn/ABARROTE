#!/bin/bash
# ============================================================
# GZMNET VPN PANEL - v0.0.2
# - GZMNET VPN Panel release 0.0.2
# - Interfaz móvil mejorada, enlaces de suscripción cortos y servicios gestionados por systemd
# - Bot Telegram con teclado flotante (estilo panel avanzado)
# - Versión de release v0.0.2; servicios bajo systemd y suscripciones multi-servidor
# - DNS: prioridad de red coherente (IPv4, IPv6 o dual), consultas independientes de WARP y filtros DNS aplicados
# - WARP: túnel WireGuard global TCP/UDP; no reemplaza conexiones activas ni reinicia Xray por cada regla
# - Reglas personalizadas: match auto y condiciones de protocolo
# - WARP global incluye el tráfico público, también Speedtest/Ookla
# ============================================================

clear
echo "============================================================="
echo "         GZMNET VPN PANEL - Instalacion v0.0.2"
echo "============================================================="

if [ "$EUID" -ne 0 ]; then echo "Error: ejecuta como root (sudo)."; exit 1; fi

# ============ LIBERACIÓN SILENCIOSA DEL PUERTO 80 ============
{
    if [ -f "/root/gzmnet/data/vpn.sqlite" ]; then
        XRAY_ON_80=$(sqlite3 "/root/gzmnet/data/vpn.sqlite" "SELECT COUNT(*) FROM inbounds WHERE port = 80" 2>/dev/null || echo 0)
        if [ "$XRAY_ON_80" -gt 0 ]; then
            systemctl stop gzmnet-xray.service 2>/dev/null || true
            sleep 2
        fi
    fi
    systemctl stop nginx 2>/dev/null || true
    systemctl stop apache2 2>/dev/null || true
    pkill -9 nginx 2>/dev/null || true
    pkill -9 apache2 2>/dev/null || true
} > /dev/null 2>&1
sleep 2
for i in {1..10}; do
    if ! ss -tln | grep -q ':80 '; then break; fi
    fuser -k -9 80/tcp 2>/dev/null || true
    sleep 2
done

# ============ PREPARACIÓN ============
mkdir -p /etc/nginx/sites-enabled /etc/nginx/sites-available /etc/nginx/conf.d /etc/nginx/ssl /var/www/html
rm -f /etc/nginx/conf.d/gzmnet*.conf 2>/dev/null || true
rm -f /etc/nginx/sites-enabled/gzmnet /etc/nginx/sites-enabled/default 2>/dev/null || true
[ -f /etc/nginx/nginx.conf ] && [ ! -f /etc/nginx/nginx.conf.gzmnet.bak ] && cp /etc/nginx/nginx.conf /etc/nginx/nginx.conf.gzmnet.bak 2>/dev/null || true

cat > /etc/nginx/nginx.conf <<'NGINX_MAIN'
user www-data;
worker_processes auto;
worker_rlimit_nofile 1000000;
pid /run/nginx.pid;
include /etc/nginx/modules-enabled/*.conf;
events { worker_connections 16384; multi_accept on; use epoll; }
http {
    sendfile on; tcp_nopush on; tcp_nodelay on; keepalive_timeout 65;
    http2_max_concurrent_streams 256;
    types_hash_max_size 4096; server_tokens off;
    include /etc/nginx/mime.types; default_type application/octet-stream;
    ssl_protocols TLSv1.2 TLSv1.3; ssl_prefer_server_ciphers on;
    access_log off; error_log /var/log/nginx/error.log;
    gzip on; gzip_vary on; gzip_min_length 1024; gzip_comp_level 3;
    client_body_buffer_size 256k; client_max_body_size 100M;
    include /etc/nginx/conf.d/*.conf; include /etc/nginx/sites-enabled/*;
}
NGINX_MAIN

# Preserve the current resolver during install; DNS can be changed and tested in Routing.
echo "El DNS actual del VPS se conserva durante la instalación."

echo "Comprobando conectividad..."
connected=0
for _attempt in {1..10}; do
    if ping -c 1 8.8.8.8 > /dev/null 2>&1; then connected=1; break; fi
    sleep 5
done
if [ "$connected" -ne 1 ]; then echo "Error: no se pudo comprobar la conexión a Internet."; exit 1; fi
echo "Conectividad verificada."

# ============ INSTALACIÓN INTELIGENTE ============
echo ""
echo "╔══════════════════════════════════════════════════════════╗"
echo "║          CONFIGURACIÓN DEL PANEL GZMNET                  ║"
echo "╚══════════════════════════════════════════════════════════╝"

EXISTING_USER=""
EXISTING_PASS=""
EXISTING_DOMAIN=""
EXISTING_PORT=""

if [ -f "/root/gzmnet/config.json" ] && [ -f "/root/gzmnet/vpn_config.json" ]; then
    EXISTING_USER=$(jq -r '.adminUser // ""' /root/gzmnet/config.json 2>/dev/null)
    EXISTING_PASS=$(jq -r '.adminPassword // ""' /root/gzmnet/config.json 2>/dev/null)
    EXISTING_DOMAIN=$(jq -r '.domain // ""' /root/gzmnet/vpn_config.json 2>/dev/null)
    EXISTING_PORT=$(jq -r '.panelPort // 443' /root/gzmnet/vpn_config.json 2>/dev/null)
fi

ADMIN_USER=""
ADMIN_PASS=""
DOMAIN=""
PANEL_PORT=""

if [ -n "$EXISTING_USER" ]; then
    echo ""
    echo "  📦 Instalación previa detectada:"
    echo ""
    echo "     Usuario:  $EXISTING_USER"
    echo "     Dominio:  $EXISTING_DOMAIN"
    echo "     Puerto:   $EXISTING_PORT"
    echo ""
    read -p "  ¿Deseas mantener estas credenciales? [S/n]: " USE_EXISTING
    USE_EXISTING=${USE_EXISTING:-S}
    if [[ "$USE_EXISTING" =~ ^[SsYy]$ ]]; then
        ADMIN_USER="$EXISTING_USER"
        ADMIN_PASS="$EXISTING_PASS"
        DOMAIN="$EXISTING_DOMAIN"
        PANEL_PORT="$EXISTING_PORT"
        echo "  ✓ Credenciales existentes conservadas"
    fi
fi

if [ -z "$ADMIN_USER" ] || [ -z "$DOMAIN" ]; then
    echo ""
    while true; do
        read -p "  👤 Usuario administrador: " ADMIN_USER
        [ -z "$ADMIN_USER" ] && echo "     ⚠ Debe ingresar un usuario" && continue
        break
    done
    echo ""
    while true; do
        read -p "  🔑 Contraseña (visible): " ADMIN_PASS
        [ -z "$ADMIN_PASS" ] && echo "     ⚠ Debe ingresar una contraseña" && continue
        break
    done
    echo ""
    while true; do
        read -p "  🌐 Dominio (ej: panel.midominio.com): " DOMAIN
        [ -z "$DOMAIN" ] && echo "     ⚠ Debe ingresar un dominio" && continue
        break
    done
    echo ""
    echo "  ┌─────────────────────────────────────────────┐"
    echo "  │  Usuario:    $ADMIN_USER"
    echo "  │  Contraseña: $ADMIN_PASS"
    echo "  │  Dominio:    $DOMAIN"
    echo "  └─────────────────────────────────────────────┘"
    echo ""
    read -p "  ¿Son correctas estas credenciales? [S/n]: " CONFIRM
    CONFIRM=${CONFIRM:-S}
    if [[ ! "$CONFIRM" =~ ^[SsYy]$ ]]; then
        echo "  Cancelando instalación..."
        exit 1
    fi
fi

[ -z "$DOMAIN" ] && { echo "Error: dominio requerido."; exit 1; }

SERVER_TZ="America/Santo_Domingo"
timedatectl set-timezone "$SERVER_TZ" 2>/dev/null || true

PUBLIC_IP=$(curl -s4 --max-time 5 ifconfig.me 2>/dev/null || echo "")
DOMAIN_IP=$(getent hosts "$DOMAIN" 2>/dev/null | awk '{print $1}' | head -1)
echo "Validando resolución del dominio y conectividad..."
if [ -n "$PUBLIC_IP" ] && [ -n "$DOMAIN_IP" ] && [ "$PUBLIC_IP" != "$DOMAIN_IP" ]; then
    read -p "ATENCIÓN: el dominio no parece apuntar a este servidor. ¿Continuar? [s/N]: " CONT
    [ "$CONT" != "s" ] && exit 1
fi

if [ -z "$PANEL_PORT" ]; then
    read -p "Puerto HTTPS del panel [Enter = 443]: " PANEL_PORT
    PANEL_PORT=${PANEL_PORT:-443}
fi
if ! [[ "$PANEL_PORT" =~ ^[0-9]+$ ]] || [ "$PANEL_PORT" -lt 1 ] || [ "$PANEL_PORT" -gt 65535 ]; then PANEL_PORT=443; fi
[ "$PANEL_PORT" = "80" ] && PANEL_PORT=443

if [ "$PANEL_PORT" = "443" ]; then PANEL_URL="https://$DOMAIN"; else PANEL_URL="https://$DOMAIN:$PANEL_PORT"; fi
echo "Panel URL: $PANEL_URL"

# ============ FUNCIONES AUXILIARES ============
apt_install() {
    local max_retries=5; local count=0
    until [ $count -ge $max_retries ]; do
        DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=-1 -o Dpkg::Options::=--force-confold install -y -qq --no-install-recommends --fix-missing "$@" && return 0
        count=$((count+1)); sleep 10; apt-get update -qq
    done
    return 1
}

apt-get -o DPkg::Lock::Timeout=-1 update -qq || true
apt_install nginx curl wget git ca-certificates build-essential sqlite3 libsqlite3-dev lsof cron openssl ufw unzip zip jq iproute2 socat tzdata iptables libcairo2-dev libpango1.0-dev libjpeg-dev libgif-dev librsvg2-dev pkg-config psmisc
# Upgrade cleanup: restore MTU baselines recorded by older releases, then retire their global-MTU state.
if [ -f /root/gzmnet/data/system-mtu-state.json ] && command -v jq >/dev/null 2>&1; then
  while read -r iface mtu; do
    [[ "$iface" =~ ^[a-zA-Z0-9_.:-]{1,32}$ && "$mtu" =~ ^[0-9]{3,4}$ ]] && ip link set dev "$iface" mtu "$mtu" 2>/dev/null || true
  done < <(jq -r '.interfaces | to_entries[] | "\(.key) \(.value)"' /root/gzmnet/data/system-mtu-state.json 2>/dev/null)
  rm -f /root/gzmnet/data/system-mtu-state.json
fi

curl -fsSL https://deb.nodesource.com/setup_20.x | bash - > /dev/null 2>&1
apt_install nodejs

# ============ OPTIMIZACIÓN DEL SISTEMA ============
cat > /etc/sysctl.d/99-gzmnet-optimize.conf <<'SYSCTL_EOF'
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr
net.core.rmem_max = 268435456
net.core.wmem_max = 268435456
net.ipv4.tcp_rmem = 8192 262144 268435456
net.ipv4.tcp_wmem = 8192 262144 268435456
net.ipv4.tcp_fastopen = 3
net.ipv4.tcp_slow_start_after_idle = 0
net.ipv4.tcp_keepalive_time = 300
net.ipv4.tcp_fin_timeout = 15
net.ipv4.tcp_tw_reuse = 1
net.ipv4.tcp_ecn = 1
net.ipv4.tcp_syncookies = 1
net.ipv4.tcp_notsent_lowat = 16384
net.ipv4.ip_local_port_range = 10240 65535
net.core.somaxconn = 65535
net.core.netdev_max_backlog = 65535
net.ipv4.tcp_max_syn_backlog = 65535
net.ipv4.tcp_window_scaling = 1
net.ipv4.tcp_timestamps = 1
net.ipv4.tcp_sack = 1
fs.file-max = 2000000
fs.nr_open = 2000000
vm.swappiness = 5
vm.overcommit_memory = 1
vm.max_map_count = 262144
SYSCTL_EOF

modprobe tcp_bbr 2>/dev/null || true
echo "tcp_bbr" > /etc/modules-load.d/bbr.conf 2>/dev/null || true
sysctl -p /etc/sysctl.d/99-gzmnet-optimize.conf > /dev/null 2>&1 || true
# Retira el ajuste MTU probing que usaban revisiones previas; conserva el valor normal del kernel.
sysctl -w net.ipv4.tcp_mtu_probing=0 > /dev/null 2>&1 || true

cat > /etc/security/limits.d/99-gzmnet.conf <<'LIMITS_EOF'
*    soft nofile 1000000
*    hard nofile 1000000
root soft nofile 1000000
root hard nofile 1000000
LIMITS_EOF

systemctl daemon-reload 2>/dev/null || true

# ============ ACME.SH ============
curl -s https://get.acme.sh | sh -s email=admin@$DOMAIN > /dev/null 2>&1
source ~/.acme.sh/acme.sh.env 2>/dev/null || true

# ============ DIRECTORIOS Y CONFIG ============
mkdir -p /root/gzmnet/{views,data,backups,public}
mkdir -p /var/www/html /etc/nginx/ssl
chmod 700 /root/gzmnet /root/gzmnet/data
cd /root/gzmnet

SESSION_SECRET=$(openssl rand -hex 32)
jq -n --arg u "$ADMIN_USER" --arg p "$ADMIN_PASS" --arg s "$SESSION_SECRET" \
    '{adminUser:$u, adminPassword:$p, port:3000, sessionSecret:$s}' > config.json
chmod 600 /root/gzmnet/config.json

if [ -f /root/gzmnet/vpn_config.json ]; then
    jq --arg d "$DOMAIN" --arg tz "$SERVER_TZ" --argjson pp "$PANEL_PORT" \
        '.domain = $d | .timezone = $tz | .panelPort = $pp | .subPort = (.subPort // $pp) | .subPath = (.subPath // "/sub") | .subInterval = (.subInterval // 12) | .subTitle = (.subTitle // "GZMNET VPN") | .subShowUsage = (.subShowUsage // 1) | .jsonPath = (.jsonPath // "/subjson") | .jsonEnabled = (.jsonEnabled // 0)' \
        /root/gzmnet/vpn_config.json > /tmp/vpn_config.tmp && mv /tmp/vpn_config.tmp /root/gzmnet/vpn_config.json
else
    jq -n --arg d "$DOMAIN" --arg tz "$SERVER_TZ" --argjson pp "$PANEL_PORT" \
        '{enabled:true, domain:$d, timezone:$tz, timeFormat:"24h", panelPort:$pp, subInterval:12, subPort:$pp, subPath:"/sub", subShowUsage:1, subTitle:"GZMNET VPN", subUserAgent:"", jsonEnabled:0, jsonPath:"/subjson", jsonBypass:"", jsonBypassDomains:"", jsonBypassGeosites:"", lastSslNotified:"", lastSslRenewed:""}' > vpn_config.json
fi
chmod 600 vpn_config.json

# ============ INICIALIZAR BASE DE DATOS ============
cat > init-db.js <<'INITEOF'
const Database = require('better-sqlite3');
const path = require('path');
const db = new Database(path.join(__dirname, 'data', 'vpn.sqlite'));
db.pragma('journal_mode = WAL');
db.exec(`
  CREATE TABLE IF NOT EXISTS inbounds (
    id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, protocol TEXT NOT NULL,
    port INTEGER NOT NULL, network TEXT DEFAULT 'ws', path TEXT DEFAULT '/',
    tls INTEGER DEFAULT 0, domain TEXT DEFAULT '', tls_sni TEXT DEFAULT '', host TEXT DEFAULT '',
    security TEXT DEFAULT 'none', flow TEXT DEFAULT '', sniffing INTEGER DEFAULT 1,
    encryption TEXT DEFAULT '', fingerprint TEXT DEFAULT 'chrome', alpn TEXT DEFAULT '',
    reality_dest TEXT DEFAULT '', reality_server_names TEXT DEFAULT '',
    reality_private_key TEXT DEFAULT '', reality_public_key TEXT DEFAULT '',
    reality_short_ids TEXT DEFAULT '',
    grpc_service TEXT DEFAULT '', grpc_multi INTEGER DEFAULT 0,
    h2_path TEXT DEFAULT '/', h2_host TEXT DEFAULT '',
    quic_key TEXT DEFAULT '', quic_security TEXT DEFAULT 'none', quic_header TEXT DEFAULT 'none',
    kcp_seed TEXT DEFAULT '', kcp_header TEXT DEFAULT 'none',
    xhttp_path TEXT DEFAULT '/', xhttp_host TEXT DEFAULT '', xhttp_mode TEXT DEFAULT 'auto',
    ss_method TEXT DEFAULT 'aes-256-gcm',
    vless_decryption TEXT DEFAULT '', vless_encryption TEXT DEFAULT '',
    created_at TEXT DEFAULT (datetime('now','localtime')),
    updated_at TEXT DEFAULT (datetime('now','localtime'))
  );
  CREATE TABLE IF NOT EXISTS clients (
    id INTEGER PRIMARY KEY AUTOINCREMENT, inbound_id INTEGER NOT NULL,
    name TEXT NOT NULL, uuid TEXT NOT NULL, email TEXT, flow TEXT DEFAULT '',
    limit_gb REAL DEFAULT 0, enabled INTEGER DEFAULT 1, last_seen TEXT,
    up_bytes INTEGER DEFAULT 0, down_bytes INTEGER DEFAULT 0, total_bytes INTEGER DEFAULT 0, quota_used_bytes INTEGER DEFAULT 0, quota_up_bytes INTEGER DEFAULT 0, quota_down_bytes INTEGER DEFAULT 0, quota_exhausted_at TEXT DEFAULT '',
    online INTEGER DEFAULT 0, sub_token TEXT, sub_blocked INTEGER DEFAULT 0,
    auth_user TEXT DEFAULT '', auth_pass TEXT DEFAULT '',
    prev_uuid TEXT DEFAULT '', prev_auth_user TEXT DEFAULT '', prev_auth_pass TEXT DEFAULT '',
    payment_enabled INTEGER DEFAULT 0, payment_date TEXT DEFAULT '',
    payment_frequency INTEGER DEFAULT 0, payment_time TEXT DEFAULT '09:00',
    telegram_chat_id TEXT DEFAULT '',
    last_payment_notified TEXT DEFAULT '',
    payment_message TEXT DEFAULT '',
    device_limit INTEGER DEFAULT 0,
    expiry_enabled INTEGER DEFAULT 0, expiry_date TEXT DEFAULT '', expiry_time TEXT DEFAULT '23:59',
    routing_enabled INTEGER DEFAULT 1, routing_filters_enabled INTEGER DEFAULT 1, custom_routing_enabled INTEGER DEFAULT 1,
    created_at TEXT DEFAULT (datetime('now','localtime')),
    FOREIGN KEY(inbound_id) REFERENCES inbounds(id) ON DELETE CASCADE
  );
  CREATE INDEX IF NOT EXISTS idx_clients_inbound ON clients(inbound_id);
  CREATE INDEX IF NOT EXISTS idx_clients_subtoken_lookup ON clients(sub_token);
  CREATE TABLE IF NOT EXISTS subscription_devices (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    client_id INTEGER NOT NULL,
    device_hash TEXT NOT NULL,
    user_agent TEXT DEFAULT '',
    display_name TEXT DEFAULT '',
    ip_address TEXT DEFAULT '',
    first_seen TEXT DEFAULT (datetime('now','localtime')),
    last_seen TEXT DEFAULT (datetime('now','localtime')),
    FOREIGN KEY(client_id) REFERENCES clients(id) ON DELETE CASCADE
  );
  CREATE INDEX IF NOT EXISTS idx_devices_client ON subscription_devices(client_id);
  CREATE TABLE IF NOT EXISTS payment_reminder_jobs (id INTEGER PRIMARY KEY AUTOINCREMENT, client_id INTEGER NOT NULL, reminder_key TEXT NOT NULL, sent_count INTEGER NOT NULL DEFAULT 0, attempts INTEGER NOT NULL DEFAULT 0, next_send_at TEXT NOT NULL DEFAULT (datetime('now','localtime')), next_send_epoch INTEGER NOT NULL DEFAULT 0, completed INTEGER NOT NULL DEFAULT 0, created_at TEXT DEFAULT (datetime('now','localtime')), UNIQUE(client_id,reminder_key), FOREIGN KEY(client_id) REFERENCES clients(id) ON DELETE CASCADE);

  CREATE TABLE IF NOT EXISTS routing_settings (
    id INTEGER PRIMARY KEY CHECK (id = 1),
    block_ads INTEGER DEFAULT 0, block_adult INTEGER DEFAULT 0,
    block_malware INTEGER DEFAULT 0, block_trackers INTEGER DEFAULT 0,
    block_bittorrent INTEGER DEFAULT 0, prevent_captcha INTEGER DEFAULT 0,
    block_youtube_ads INTEGER DEFAULT 0,
    warp_enabled INTEGER DEFAULT 0, domain_strategy TEXT DEFAULT 'IPIfNonMatch',
    ip_type TEXT DEFAULT 'dual', fake_dns INTEGER DEFAULT 0,
    dns_primary TEXT DEFAULT '1.1.1.1', dns_secondary TEXT DEFAULT '8.8.8.8',
    dns_primary_v6 TEXT DEFAULT '2606:4700:4700::1111', dns_secondary_v6 TEXT DEFAULT '2001:4860:4860::8888',
    dns_query_strategy TEXT DEFAULT 'UseIP',
    cache_enabled INTEGER DEFAULT 0, cache_hour INTEGER DEFAULT 4,
    cache_minute INTEGER DEFAULT 0, last_cache_at TEXT,
    block_quic_global INTEGER DEFAULT 0,
    updated_at TEXT DEFAULT (datetime('now','localtime'))
  );
  CREATE TABLE IF NOT EXISTS routing_rules (
    id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL,
    match_type TEXT NOT NULL, value TEXT NOT NULL,
    outbound TEXT NOT NULL, enabled INTEGER DEFAULT 1,
    priority INTEGER DEFAULT 0, match_rules TEXT DEFAULT '',
    created_at TEXT DEFAULT (datetime('now','localtime'))
  );
  CREATE TABLE IF NOT EXISTS json_sub_settings (
    id INTEGER PRIMARY KEY CHECK (id = 1), enabled INTEGER DEFAULT 0,
    path TEXT DEFAULT '/subjson', bypass TEXT DEFAULT '',
    updated_at TEXT DEFAULT (datetime('now','localtime'))
  );
  CREATE TABLE IF NOT EXISTS telegram_settings (
    id INTEGER PRIMARY KEY CHECK (id = 1),
    enabled INTEGER DEFAULT 0,
    bot_token TEXT DEFAULT '',
    admin_ids TEXT DEFAULT '',
    notify_payment INTEGER DEFAULT 1,
    notify_online INTEGER DEFAULT 0,
    auto_backup INTEGER DEFAULT 0,
    auto_backup_hour INTEGER DEFAULT 3,
    auto_backup_minute INTEGER DEFAULT 0,
    last_backup_at TEXT DEFAULT '',
    updated_at TEXT DEFAULT (datetime('now','localtime'))
  );
  CREATE TABLE IF NOT EXISTS push_subscriptions (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    client_id INTEGER NOT NULL,
    endpoint TEXT NOT NULL,
    p256dh TEXT NOT NULL,
    auth TEXT NOT NULL,
    created_at TEXT DEFAULT (datetime('now','localtime')),
    vapid_public_key TEXT DEFAULT '',
    FOREIGN KEY(client_id) REFERENCES clients(id) ON DELETE CASCADE
  );
  CREATE INDEX IF NOT EXISTS idx_push_client ON push_subscriptions(client_id);
  CREATE TABLE IF NOT EXISTS push_invalid_endpoints(endpoint TEXT PRIMARY KEY,p256dh TEXT DEFAULT '',auth TEXT DEFAULT '',marked_at TEXT DEFAULT (datetime('now','localtime')));
  CREATE TABLE IF NOT EXISTS push_meta(key TEXT PRIMARY KEY,value TEXT NOT NULL);
  CREATE TABLE IF NOT EXISTS admin_notifications (id INTEGER PRIMARY KEY AUTOINCREMENT, title TEXT NOT NULL, body TEXT NOT NULL, created_at TEXT DEFAULT (datetime('now','localtime')), seen INTEGER DEFAULT 0);
  CREATE TABLE IF NOT EXISTS admin_push_subscriptions (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    endpoint TEXT NOT NULL UNIQUE,
    p256dh TEXT NOT NULL,
    auth TEXT NOT NULL,
    created_at TEXT DEFAULT (datetime('now','localtime'))
  );
  
  CREATE TABLE IF NOT EXISTS web_pages (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    path TEXT NOT NULL,
    html TEXT DEFAULT '',
    enabled INTEGER DEFAULT 1,
    project_slug TEXT DEFAULT '',
    is_project INTEGER DEFAULT 0,
    created_at TEXT DEFAULT (datetime('now','localtime')),
    updated_at TEXT DEFAULT (datetime('now','localtime'))
  );
  CREATE UNIQUE INDEX IF NOT EXISTS idx_web_pages_path ON web_pages(path);

  CREATE TABLE IF NOT EXISTS system_metrics (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    ts TEXT DEFAULT (datetime('now','localtime')),
    cpu REAL DEFAULT 0,
    ram REAL DEFAULT 0
  );
  CREATE INDEX IF NOT EXISTS idx_metrics_ts ON system_metrics(ts);
`);
function ensureCol(table, col, def) {
    try {
        const cols = db.prepare(`PRAGMA table_info(${table})`).all().map(c => c.name);
        if (!cols.includes(col)) db.exec(`ALTER TABLE ${table} ADD COLUMN ${col} ${def}`);
    } catch(e) {}
}
ensureCol('clients', 'payment_enabled', 'INTEGER DEFAULT 0');
ensureCol('clients', 'payment_date', "TEXT DEFAULT ''");
ensureCol('clients', 'payment_frequency', 'INTEGER DEFAULT 0');
ensureCol('clients', 'payment_time', "TEXT DEFAULT '09:00'");
try{db.exec('DELETE FROM push_subscriptions WHERE id NOT IN (SELECT MAX(id) FROM push_subscriptions GROUP BY client_id,endpoint); CREATE UNIQUE INDEX IF NOT EXISTS idx_push_client_endpoint ON push_subscriptions(client_id,endpoint)')}catch(e){console.warn('[PUSH-INDEX]',e.message)}
ensureCol('clients', 'telegram_chat_id', "TEXT DEFAULT ''");
ensureCol('subscription_devices', 'admin_notified_at', "TEXT DEFAULT ''");
ensureCol('subscription_devices', 'app_name', "TEXT DEFAULT ''");
ensureCol('subscription_devices', 'location', "TEXT DEFAULT ''");
ensureCol('clients', 'payment_message', "TEXT DEFAULT ''");
try { db.exec('DROP INDEX IF EXISTS idx_clients_subtoken; CREATE INDEX IF NOT EXISTS idx_clients_subtoken_lookup ON clients(sub_token);'); } catch(e) {}
ensureCol('clients', 'last_payment_notified', "TEXT DEFAULT ''");
ensureCol('clients', 'auth_user', "TEXT DEFAULT ''");
ensureCol('clients', 'auth_pass', "TEXT DEFAULT ''");
ensureCol('clients', 'prev_uuid', "TEXT DEFAULT ''");
ensureCol('clients', 'prev_auth_user', "TEXT DEFAULT ''");
ensureCol('clients', 'prev_auth_pass', "TEXT DEFAULT ''");
ensureCol('clients', 'device_limit', 'INTEGER DEFAULT 0');
let quotaUsageColumnExists=false;try{quotaUsageColumnExists=db.prepare('PRAGMA table_info(clients)').all().some(c=>c.name==='quota_used_bytes')}catch(e){}
if(!quotaUsageColumnExists){ensureCol('clients', 'quota_used_bytes', 'INTEGER DEFAULT 0');try{db.prepare('UPDATE clients SET quota_used_bytes=CASE WHEN limit_gb>0 THEN COALESCE(total_bytes,0) ELSE 0 END').run()}catch(e){console.warn('[QUOTA-USAGE-MIGRATION]',e.message)}}
ensureCol('clients', 'quota_exhausted_at', "TEXT DEFAULT ''");
let quotaDirectionColumnsMissing=false;try{const cols=db.prepare('PRAGMA table_info(clients)').all().map(c=>c.name);quotaDirectionColumnsMissing=!cols.includes('quota_up_bytes')||!cols.includes('quota_down_bytes')}catch(e){}
ensureCol('clients','quota_up_bytes','INTEGER DEFAULT 0');ensureCol('clients','quota_down_bytes','INTEGER DEFAULT 0');
if(quotaDirectionColumnsMissing)try{db.exec(`UPDATE clients SET quota_up_bytes=CASE WHEN total_bytes>0 THEN MIN(MAX(CAST(quota_used_bytes*1.0*up_bytes/total_bytes AS INTEGER),0),MAX(quota_used_bytes,0)) ELSE 0 END, quota_down_bytes=MAX(COALESCE(quota_used_bytes,0)-CASE WHEN total_bytes>0 THEN MIN(MAX(CAST(quota_used_bytes*1.0*up_bytes/total_bytes AS INTEGER),0),MAX(quota_used_bytes,0)) ELSE 0 END,0) WHERE COALESCE(quota_used_bytes,0)>0`)}catch(e){console.warn('[QUOTA-DIRECTION-MIGRATION]',e.message)}
ensureCol('clients', 'expiry_enabled', 'INTEGER DEFAULT 0');
ensureCol('clients', 'expiry_date', "TEXT DEFAULT ''");
ensureCol('clients', 'expiry_time', "TEXT DEFAULT '23:59'");
ensureCol('clients','routing_enabled','INTEGER DEFAULT 1');ensureCol('clients','routing_filters_enabled','INTEGER DEFAULT 1');ensureCol('clients','custom_routing_enabled','INTEGER DEFAULT 1');
ensureCol('inbounds', 'ss_method', "TEXT DEFAULT 'aes-256-gcm'");
ensureCol('inbounds', 'vless_decryption', "TEXT DEFAULT ''");
ensureCol('inbounds', 'vless_encryption', "TEXT DEFAULT ''");
ensureCol('inbounds','tls_sni',"TEXT DEFAULT ''");
ensureCol('inbounds', 'grpc_service', "TEXT DEFAULT ''");
ensureCol('inbounds', 'grpc_multi', "INTEGER DEFAULT 0");
ensureCol('inbounds', 'h2_path', "TEXT DEFAULT '/'");
ensureCol('inbounds', 'h2_host', "TEXT DEFAULT ''");
ensureCol('inbounds', 'quic_key', "TEXT DEFAULT ''");
ensureCol('inbounds', 'quic_security', "TEXT DEFAULT 'none'");
ensureCol('inbounds', 'quic_header', "TEXT DEFAULT 'none'");
ensureCol('inbounds', 'kcp_seed', "TEXT DEFAULT ''");
ensureCol('inbounds', 'kcp_header', "TEXT DEFAULT 'none'");
ensureCol('inbounds', 'xhttp_path', "TEXT DEFAULT '/'");
ensureCol('inbounds', 'xhttp_host', "TEXT DEFAULT ''");
ensureCol('inbounds', 'xhttp_mode', "TEXT DEFAULT 'auto'");
ensureCol('routing_settings', 'block_youtube_ads', 'INTEGER DEFAULT 0');

db.prepare("DELETE FROM routing_rules WHERE outbound IN ('block_quic','force_tcp')").run();
ensureCol('routing_settings', 'dns_primary_v6', "TEXT DEFAULT '2606:4700:4700::1111'");
ensureCol('routing_settings', 'dns_secondary_v6', "TEXT DEFAULT '2001:4860:4860::8888'");
ensureCol('routing_settings', 'ip_type', "TEXT DEFAULT 'dual'");
ensureCol('routing_settings', 'dns_query_strategy', "TEXT DEFAULT 'UseIP'");
ensureCol('telegram_settings', 'auto_backup_minute', 'INTEGER DEFAULT 0');

const r1 = db.prepare('SELECT COUNT(*) as c FROM routing_settings').get();
if (!r1 || r1.c === 0) db.prepare(`INSERT INTO routing_settings (id) VALUES (1)`).run();
const r2 = db.prepare('SELECT COUNT(*) as c FROM json_sub_settings').get();
if (!r2 || r2.c === 0) db.prepare(`INSERT INTO json_sub_settings (id) VALUES (1)`).run();
const r3 = db.prepare('SELECT COUNT(*) as c FROM telegram_settings').get();
if (!r3 || r3.c === 0) db.prepare(`INSERT INTO telegram_settings (id) VALUES (1)`).run();
console.log('Base de datos lista');
INITEOF

echo "Instalando dependencias de Node.js..."
npm install --production --no-optional --no-audit --no-fund --loglevel=error express socket.io express-session better-sqlite3 better-sqlite3-session-store qrcode web-push canvas > /dev/null 2>&1 || npm install --production --no-optional --no-audit --no-fund --loglevel=error express socket.io express-session better-sqlite3 qrcode web-push > /dev/null 2>&1

echo "Inicializando base de datos..."
node init-db.js

# ============ XRAY ============
echo "Descargando Xray (latest)..."
ARCH=$(uname -m)
case $ARCH in
    x86_64) XRAY_ARCH="64" ;;
    aarch64) XRAY_ARCH="arm64-v8a" ;;
    *) XRAY_ARCH="64" ;;
esac

XRAY_URL="https://github.com/XTLS/Xray-core/releases/latest/download/Xray-linux-${XRAY_ARCH}.zip"

if curl -fsSL -o /tmp/xray.zip "$XRAY_URL"; then
    mkdir -p /usr/local/bin /usr/local/etc/xray /usr/local/share/xray
    unzip -o /tmp/xray.zip -d /usr/local/bin/ > /dev/null 2>&1
    # Keep the matching geoip.dat from this Xray release. Seed geosite.dat too, then try a checksummed, expanded list with the same geosite format and category names.
    if unzip -p /tmp/xray.zip geosite.dat > /usr/local/share/xray/geosite.dat.tmp && [ -s /usr/local/share/xray/geosite.dat.tmp ]; then mv -f /usr/local/share/xray/geosite.dat.tmp /usr/local/share/xray/geosite.dat; else echo "Error: el paquete Xray no trae geosite.dat; no se instala con reglas geosite rotas."; rm -f /tmp/xray.zip /usr/local/share/xray/geosite.dat.tmp; exit 1; fi
    if unzip -p /tmp/xray.zip geoip.dat > /usr/local/share/xray/geoip.dat.tmp && [ -s /usr/local/share/xray/geoip.dat.tmp ]; then mv -f /usr/local/share/xray/geoip.dat.tmp /usr/local/share/xray/geoip.dat; else echo "Error: el paquete Xray no trae geoip.dat; no se instala con reglas geoip rotas."; rm -f /tmp/xray.zip /usr/local/share/xray/geoip.dat.tmp; exit 1; fi
    rm -f /tmp/xray.zip
    chmod +x /usr/local/bin/xray
    echo "Xray instalado: $(/usr/local/bin/xray version | head -1)"
    GEO_ENHANCED_OK=0
    for GEO_BASE in "https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download" "https://cdn.jsdelivr.net/gh/Loyalsoldier/v2ray-rules-dat@release"; do
        rm -f /usr/local/share/xray/geosite.enhanced.tmp /usr/local/share/xray/geosite.sha256sum.tmp
        if curl -fsSL --retry 1 --max-time 45 "$GEO_BASE/geosite.dat.sha256sum" -o /usr/local/share/xray/geosite.sha256sum.tmp && curl -fsSL --retry 1 --max-time 90 "$GEO_BASE/geosite.dat" -o /usr/local/share/xray/geosite.enhanced.tmp; then
            GEO_EXPECTED=$(awk 'NR==1 {print $1}' /usr/local/share/xray/geosite.sha256sum.tmp)
            GEO_ACTUAL=$(sha256sum /usr/local/share/xray/geosite.enhanced.tmp | awk '{print $1}')
            if [ "${#GEO_EXPECTED}" -eq 64 ] && [ "$GEO_EXPECTED" = "$GEO_ACTUAL" ] && [ -s /usr/local/share/xray/geosite.enhanced.tmp ]; then
                cp -f /usr/local/share/xray/geosite.dat /usr/local/share/xray/geosite.official.rollback
                mv -f /usr/local/share/xray/geosite.enhanced.tmp /usr/local/share/xray/geosite.dat
                cat > /tmp/gzmnet-geosite-check.json <<'GZMGEOEOF'
{"inbounds":[{"listen":"127.0.0.1","port":10086,"protocol":"socks","settings":{"auth":"noauth","udp":true}}],"outbounds":[{"protocol":"freedom","tag":"direct"},{"protocol":"blackhole","tag":"block"}],"routing":{"rules":[{"type":"field","domain":["geosite:category-ads-all"],"outboundTag":"block"},{"type":"field","domain":["geosite:youtube","geosite:youtube@ads"],"outboundTag":"block"}]}}
GZMGEOEOF
                if XRAY_LOCATION_ASSET=/usr/local/share/xray /usr/local/bin/xray run -test -config /tmp/gzmnet-geosite-check.json >/tmp/gzmnet-geosite-check.log 2>&1; then
                    GEO_ENHANCED_OK=1
                    rm -f /usr/local/share/xray/geosite.official.rollback
                    echo "Geosite ampliado instalado y validado: publicidad (EasyList/EasyListChina, AdGuard DNS, Peter Lowe y Dan Pollock), YouTube y categoría ads."
                    break
                else
                    mv -f /usr/local/share/xray/geosite.official.rollback /usr/local/share/xray/geosite.dat
                    echo "Aviso: Xray rechazó el geosite ampliado; se restauró el geosite oficial de su paquete."
                    cat /tmp/gzmnet-geosite-check.log 2>/dev/null | tail -10
                fi
            else
                echo "Aviso: checksum de geosite ampliado no coincide; no se instalará esa lista."
            fi
        fi
    done
    rm -f /usr/local/share/xray/geosite.enhanced.tmp /usr/local/share/xray/geosite.sha256sum.tmp /usr/local/share/xray/geosite.official.rollback /tmp/gzmnet-geosite-check.json /tmp/gzmnet-geosite-check.log
    if [ "$GEO_ENHANCED_OK" -ne 1 ]; then echo "Aviso: no se pudo validar el geosite ampliado; se conserva geosite.dat del paquete Xray."; fi
else
    echo "Error: No se pudo descargar Xray"
    exit 1
fi

mkdir -p /root/gzmnet/data /var/lib/gzmnet
chmod 700 /var/lib/gzmnet 2>/dev/null || true
# VLESS Encryption keys are created per inbound when a VLESS server is added.
# Keep legacy shared key files, if present, for older servers that have no per-server pair.
[ -f /root/gzmnet/data/vless_decryption.key ] && chmod 600 /root/gzmnet/data/vless_decryption.key 2>/dev/null || true
[ -f /root/gzmnet/data/vless_encryption.key ] && chmod 600 /root/gzmnet/data/vless_encryption.key 2>/dev/null || true

mkdir -p /usr/local/share/xray
# Keep geoip.dat from this Xray release. geosite.dat may be replaced only by a SHA-256-verified, Xray-tested expanded database in the same supported geosite format; otherwise the package's original file remains in place.

mkdir -p /usr/local/etc/xray
# Preserve the currently working Xray config during an upgrade. The app validates
# its DB-generated replacement before applying it; create only the first-install seed.
if [ ! -s /usr/local/etc/xray/config.json ]; then
cat > /usr/local/etc/xray/config.json <<'XRAYEOF'
{
  "log": {"loglevel": "warning"},
  "api": {"tag": "api", "services": ["HandlerService", "LoggerService", "StatsService", "RoutingService"]},
  "stats": {},
  "policy": {
    "levels": { "0": { "statsUserUplink": true, "statsUserDownlink": true } },
    "system": { "statsInboundUplink": true, "statsInboundDownlink": true, "statsOutboundUplink": true, "statsOutboundDownlink": true }
  },
  "inbounds": [
    {"tag": "api", "listen": "127.0.0.1", "port": 10085, "protocol": "tunnel", "settings": {"rewriteAddress": "127.0.0.1"}}
  ],
  "outbounds": [
    {"protocol": "freedom", "tag": "direct"},
    {"protocol": "blackhole", "tag": "block"}
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [{"type": "field", "inboundTag": ["api"], "outboundTag": "api"}]
  }
}
XRAYEOF
fi



# ============ WIREPROXY ============
echo ""
echo "Instalando WARP (WireProxy)..."
WP_ARCH=$(uname -m)
case $WP_ARCH in x86_64) WP_ARCH_NAME="amd64" ;; aarch64) WP_ARCH_NAME="arm64" ;; *) WP_ARCH_NAME="amd64" ;; esac

if ! command -v wireproxy >/dev/null 2>&1; then
    curl -fsSL -o /tmp/wireproxy.tar.gz "https://github.com/pufferffish/wireproxy/releases/download/v1.1.3/wireproxy_linux_${WP_ARCH_NAME}.tar.gz" 2>/dev/null || true
    if [ -f /tmp/wireproxy.tar.gz ]; then
        tar -xzf /tmp/wireproxy.tar.gz -C /tmp/ 2>/dev/null || true
        [ -f /tmp/wireproxy ] && mv /tmp/wireproxy /usr/local/bin/wireproxy && chmod +x /usr/local/bin/wireproxy
        rm -f /tmp/wireproxy.tar.gz
    fi
fi

if ! command -v wgcf >/dev/null 2>&1; then
    curl -fsSL -o /usr/local/bin/wgcf "https://github.com/ViRb3/wgcf/releases/download/v2.2.22/wgcf_2.2.22_linux_${WP_ARCH_NAME}" 2>/dev/null || true
    chmod +x /usr/local/bin/wgcf 2>/dev/null || true
fi

if command -v wireproxy >/dev/null 2>&1 && command -v wgcf >/dev/null 2>&1; then
    mkdir -p /etc/wireproxy
    cd /etc/wireproxy
    if [ -s wgcf-profile.conf ] && grep -q '^\[Interface\]' wgcf-profile.conf 2>/dev/null && grep -q '^\[Peer\]' wgcf-profile.conf 2>/dev/null; then
        :
    else
        [ ! -f wgcf-account.toml ] && wgcf register --accept-tos >/dev/null 2>&1 || true
        [ -f wgcf-account.toml ] && wgcf generate >/dev/null 2>&1 || true
    fi
    if [ -f wgcf-profile.conf ]; then
        grep -q "^Table" wgcf-profile.conf && sed -i 's|^Table.*|Table = off|' wgcf-profile.conf || sed -i '/\[Interface\]/a Table = off' wgcf-profile.conf
        grep -q "^PersistentKeepalive" wgcf-profile.conf && sed -i 's|^PersistentKeepalive.*|PersistentKeepalive = 25|' wgcf-profile.conf || sed -i '/\[Peer\]/a PersistentKeepalive = 25' wgcf-profile.conf
        sed -i '/^DNS/d' wgcf-profile.conf
        sed -i '/^\[Socks5\]/,/^$/d' wgcf-profile.conf 2>/dev/null || true
        sed -i '/^\[http\]/,/^$/d' wgcf-profile.conf 2>/dev/null || true
        printf '\n[Socks5]\nBindAddress = 127.0.0.1:40000\n\n[http]\nBindAddress = 127.0.0.1:40001\n' >> wgcf-profile.conf
        cat > /etc/systemd/system/wireproxy.service <<'WSEOF'
[Unit]
Description=WireProxy (WARP SOCKS5 + HTTP)
After=network.target
Wants=network-online.target
StartLimitInterval=300
StartLimitBurst=5
[Service]
Type=simple
Environment=GOMAXPROCS=2
ExecStart=/usr/local/bin/wireproxy -c /etc/wireproxy/wgcf-profile.conf
Restart=always
RestartSec=10
LimitNOFILE=1048576
[Install]
WantedBy=multi-user.target
WSEOF
        systemctl daemon-reload >/dev/null 2>&1
        systemctl enable wireproxy >/dev/null 2>&1
        systemctl restart wireproxy >/dev/null 2>&1
        sleep 4
        systemctl is-active --quiet wireproxy && echo "WARP: OK" || echo "WARP: no arranco"
    fi
fi

cd /root/gzmnet

# =================== APP.JS ===================
echo "Generando app.js..."
cat <<'APPEOF' > app.js
process.env.XRAY_LOCATION_ASSET = '/usr/local/share/xray';

process.on('uncaughtException', (err) => {
    console.error('[UNCAUGHT]', err && err.message ? err.message : err);
    try { require('fs').appendFileSync('/root/gzmnet/data/apply.log', `[${new Date().toISOString()}] UNCAUGHT: ${err && err.stack ? err.stack : err}\n`); } catch(e) {}
});
process.on('unhandledRejection', (reason) => { console.error('[UNHANDLED]', reason && reason.message ? reason.message : reason); });

const fs = require('fs');
const path = require('path');
const crypto = require('crypto');
const express = require('express');
const http = require('http');
const socketIo = require('socket.io');
const session = require('express-session');
const os = require('os');
const net = require('net');
const dns = require('dns');
const { exec, execSync, execFile, execFileSync } = require('child_process');
const Database = require('better-sqlite3');
const QRCode = require('qrcode');

let webpush = null;
try { webpush = require('web-push'); console.log('[WEBPUSH] OK'); } catch(e) { console.error('[WEBPUSH] NO CARGADO:', e.message); }

let canvasLib = null;
try { canvasLib = require('canvas'); console.log('[CANVAS] OK'); } catch(e) { console.warn('[CANVAS] no disponible'); }

const app = express();
app.set('trust proxy', 1);
app.disable('x-powered-by');
const server = http.createServer(app);
server.keepAliveTimeout = 65000;
server.headersTimeout = 66000;
const io = socketIo(server, { pingTimeout: 30000, pingInterval: 20000, transports: ['websocket', 'polling'], maxHttpBufferSize: 1e6 });

const BASE_DIR = __dirname;
const DATA_DIR = path.join(BASE_DIR, 'data');
const VPN_DB_PATH = path.join(BASE_DIR, 'data', 'vpn.sqlite');
const CONFIG_PATH = path.join(BASE_DIR, 'config.json');
const VPN_CONFIG_PATH = path.join(BASE_DIR, 'vpn_config.json');
const VAPID_PATH = path.join(BASE_DIR, 'data', 'vapid.json');
const PERSISTENT_VAPID_PATH='/var/lib/gzmnet/vapid.json';
const VLESS_DECRYPTION_KEY_PATH = path.join(BASE_DIR, 'data', 'vless_decryption.key');
const VLESS_ENCRYPTION_KEY_PATH = path.join(BASE_DIR, 'data', 'vless_encryption.key');
const APPLY_LOG = path.join(BASE_DIR, 'data', 'apply.log');
const LOGO_URL = 'https://i.postimg.cc/06XkJT9K/photo-output.png';

if (!fs.existsSync(path.join(BASE_DIR, 'data'))) fs.mkdirSync(path.join(BASE_DIR, 'data'), { recursive: true });

let logoBuf = null;
async function preloadLogo() {
    try {
        const r = await fetch(LOGO_URL, { signal: AbortSignal.timeout(10000) });
        if (r.ok) { logoBuf = Buffer.from(await r.arrayBuffer()); console.log('[LOGO] cached', logoBuf.length, 'bytes'); }
    } catch(e) { console.warn('[LOGO] fetch failed:', e.message); }
}
preloadLogo();

function logApply(msg) {
    try {
        const line = `[${new Date().toISOString()}] [${process.pid}] ${msg}\n`;
        fs.appendFileSync(APPLY_LOG, line);
        const stat = fs.statSync(APPLY_LOG);
        if (stat.size > 2 * 1024 * 1024) { const c = fs.readFileSync(APPLY_LOG, 'utf8'); fs.writeFileSync(APPLY_LOG, c.split('\n').slice(-500).join('\n')); }
    } catch(e) {}
    console.log(msg);
}

const SYSTEM_DNS_BACKUP='/root/gzmnet/data/resolv.conf.gzmnet.bak';
const SYSTEM_DNS_TXN='/root/gzmnet/data/system-dns-transaction.json';
const SYSTEMD_DNS_DROPIN='/etc/systemd/resolved.conf.d/90-gzmnet-dns.conf';
const SYSTEMD_DNS_BACKUP='/root/gzmnet/data/90-gzmnet-dns.conf.bak';
function normalizeDnsPreset(value,family){const raw=String(value||'').trim(),l=raw.toLowerCase();const sets={cloudflare:family===6?['2606:4700:4700::1111','2606:4700:4700::1001']:['1.1.1.1','1.0.0.1'],google:family===6?['2001:4860:4860::8888','2001:4860:4860::8844']:['8.8.8.8','8.8.4.4'],quad9:family===6?['2620:fe::fe','2620:fe::9']:['9.9.9.9','149.112.112.112'],adguard:family===6?['2a10:50c0::ad1:ff','2a10:50c0::ad2:ff']:['94.140.14.14','94.140.15.15'],opendns:family===6?['2620:119:35::35','2620:119:53::53']:['208.67.222.222','208.67.220.220']};for(const [name,addresses] of Object.entries(sets))if(l.includes(name)||l.includes(addresses[0]))return addresses;const ip=raw.replace(/^\[|\]$/g,'');if(net.isIP(ip)===family)return [ip];return []}
function validDnsAddress(value){const x=String(value||'').trim().replace(/^\[|\]$/g,'');return net.isIP(x)?x:''}
function getDnsAddresses(settings){const wanted=[],mode=['ipv4','ipv6','dual'].includes(settings.ip_type)?settings.ip_type:'dual',v4raw=[String(settings.dns_primary||'1.1.1.1').trim(),String(settings.dns_secondary||'').trim()].filter(Boolean),v6raw=[String(settings.dns_primary_v6||(mode==='ipv6'||mode==='dual'?'2606:4700:4700::1111':'')).trim(),String(settings.dns_secondary_v6||(mode==='ipv6'||mode==='dual'?'2001:4860:4860::8888':'')).trim()].filter(Boolean),v4=v4raw.flatMap(x=>normalizeDnsPreset(x,4)),v6=v6raw.flatMap(x=>normalizeDnsPreset(x,6));if(mode!=='ipv6'&&(!v4.length||v4.some(x=>!x||net.isIP(x)!==4)))throw new Error('Los DNS IPv4 deben ser direcciones IPv4 válidas.');if(mode!=='ipv4'&&(!v6.length||v6.some(x=>!x||net.isIP(x)!==6)))throw new Error('El modo IPv6/Dual requiere al menos un DNS IPv6 válido.');const ordered=mode==='ipv6'?v6:mode==='ipv4'?v4:[...v4,...v6];for(const ip of ordered)if(!wanted.includes(ip))wanted.push(ip);return wanted}
async function probeSelectedDns(addresses,timeoutMs=4000,mode='dual'){const list=[...new Set((addresses||[]).filter(Boolean))];if(!list.length)return false;const checks=list.map(address=>new Promise(resolve=>{const family=net.isIP(address),queryFamily=mode==='ipv4'?4:mode==='ipv6'?6:(family===6?6:4),resolver=new dns.Resolver();let done=false;const finish=ok=>{if(done)return;done=true;clearTimeout(timer);try{resolver.cancel()}catch(e){}resolve({address,ok:!!ok,family})};const timer=setTimeout(()=>finish(false),timeoutMs);try{resolver.setServers([address]);const cb=(err,records)=>finish(!err&&Array.isArray(records)&&records.length>0);if(queryFamily===6)resolver.resolve6('example.com',cb);else resolver.resolve4('example.com',cb)}catch(e){finish(false)}}));try{const results=await Promise.all(checks),healthy=results.filter(x=>x.ok).map(x=>x.address),failed=results.filter(x=>!x.ok).map(x=>x.address);if(failed.length)logApply(`[DNS-PROBE] upstream sin respuesta (la selección no se considera probada): ${failed.join(', ')}`);return healthy.length>0}catch(e){return false}}
function probeSystemDns(mode='dual'){try{const getent=mode==='ipv6'?['ahostsv6','example.com']:mode==='ipv4'?['ahostsv4','example.com']:['ahosts','example.com'],out=execFileSync('getent',getent,{timeout:6000,encoding:'utf8',stdio:['ignore','pipe','ignore']}).trim();return out.split(/\r?\n/).some(line=>{const v=net.isIP(line.trim().split(/\s+/)[0]);return mode==='ipv6'?v===6:mode==='ipv4'?v===4:v===4||v===6})}catch(e){return false}}
function rollbackSystemDns(){try{if(!fs.existsSync(SYSTEM_DNS_TXN))return false;const txn=JSON.parse(fs.readFileSync(SYSTEM_DNS_TXN,'utf8'));if(txn.mode==='systemd-resolved'){if(txn.oldContent==='__GZMNET_ABSENT__')fs.unlinkSync(SYSTEMD_DNS_DROPIN);else fs.writeFileSync(SYSTEMD_DNS_DROPIN,txn.oldContent);execSync('systemctl restart systemd-resolved',{timeout:12000,stdio:'ignore'})}else if(txn.mode==='resolv.conf'){const tmp='/etc/resolv.conf.gzmnet.rollback';fs.writeFileSync(tmp,txn.oldContent||'',{mode:0o644});fs.renameSync(tmp,'/etc/resolv.conf')}fs.unlinkSync(SYSTEM_DNS_TXN);return true}catch(e){logApply(`[SYSTEM-DNS-ROLLBACK-ERROR] ${e.message}`)}return false}
async function applySystemDns(settings){
  const addresses=getDnsAddresses(settings),joined=addresses.join(' ');if(fs.existsSync(SYSTEM_DNS_TXN)&&!rollbackSystemDns())return {ok:false,error:'Hay una transacción DNS anterior que no se pudo revertir; no se aplicó ningún cambio.'};
  try{
    const isResolved=fs.existsSync('/run/systemd/resolve')&&(()=>{try{return execSync('systemctl is-active systemd-resolved',{timeout:3000,encoding:'utf8'}).trim()==='active'}catch(e){return false}})();
    if(isResolved){
      const dir=path.dirname(SYSTEMD_DNS_DROPIN);fs.mkdirSync(dir,{recursive:true});
      if(!fs.existsSync(SYSTEMD_DNS_BACKUP)){const initial=fs.existsSync(SYSTEMD_DNS_DROPIN)?fs.readFileSync(SYSTEMD_DNS_DROPIN):'__GZMNET_ABSENT__';fs.writeFileSync(SYSTEMD_DNS_BACKUP,initial,{mode:0o600})}
      else if(!fs.existsSync(SYSTEM_DNS_TXN)){const backup=fs.readFileSync(SYSTEMD_DNS_BACKUP,'utf8');if(backup!=='__GZMNET_ABSENT__'&&!backup.includes('[Resolve]'))throw new Error('el respaldo de systemd-resolved está inválido; no se cambia el DNS automáticamente')}
      const oldContent=fs.existsSync(SYSTEMD_DNS_DROPIN)?fs.readFileSync(SYSTEMD_DNS_DROPIN,'utf8'):'__GZMNET_ABSENT__';
      fs.writeFileSync(SYSTEM_DNS_TXN,JSON.stringify({mode:'systemd-resolved',oldContent}),{mode:0o600});
      const body=`[Resolve]\nDNS=${joined}\nDomains=~.\nFallbackDNS=\nDNSOverTLS=no\n`;
      fs.writeFileSync(SYSTEMD_DNS_DROPIN,body,{mode:0o644});
      try{execSync('systemctl restart systemd-resolved',{timeout:12000,stdio:'pipe'});const status=execSync('systemctl is-active systemd-resolved',{timeout:3000,encoding:'utf8'}).trim();if(status!=='active')throw new Error('systemd-resolved no quedó activo');try{execSync('resolvectl flush-caches',{timeout:5000,stdio:'ignore'})}catch(e){}}
      catch(e){try{if(oldContent==='__GZMNET_ABSENT__')fs.unlinkSync(SYSTEMD_DNS_DROPIN);else fs.writeFileSync(SYSTEMD_DNS_DROPIN,oldContent);execSync('systemctl restart systemd-resolved',{timeout:12000,stdio:'ignore'})}catch(restoreError){logApply(`[SYSTEM-DNS-ROLLBACK-ERROR] ${restoreError.message}`)}throw e}
      if(!(await probeSelectedDns(addresses,4000,settings.ip_type||'dual'))||!probeSystemDns(settings.ip_type||'dual'))throw new Error('systemd-resolved está activo, pero la consulta directa a los DNS seleccionados o la resolución de la VPS falló. Se restaurará la configuración anterior.');
      logApply(`[SYSTEM-DNS] systemd-resolved aplicado y probado: ${joined}`);return {ok:true,mode:'systemd-resolved',servers:addresses};
    }
    const file='/etc/resolv.conf';
    if(fs.lstatSync(file).isSymbolicLink())return {ok:true,mode:'managed-external',warning:'El resolver de la VPS lo gestiona el proveedor/otro servicio; se preservó sin cambios. El DNS de las conexiones VPN se aplicará en Xray.'};
    if(!fs.existsSync(SYSTEM_DNS_BACKUP)){try{const st=fs.lstatSync(file);const backup={isSymlink:false,content:fs.readFileSync(file,'utf8'),mode:st.mode&0o777};fs.writeFileSync(SYSTEM_DNS_BACKUP,JSON.stringify(backup,null,2),{mode:0o600})}catch(e){logApply(`[SYSTEM-DNS-BACKUP-WARN] ${e.message}`)}}
    else if(!fs.existsSync(SYSTEM_DNS_TXN)){try{const saved=JSON.parse(fs.readFileSync(SYSTEM_DNS_BACKUP,'utf8'));if(saved.isSymlink)return {ok:true,mode:'managed-external',warning:'El DNS de la VPS lo administra otro servicio y se conservó; Xray usará el DNS seleccionado.'};if(!saved.content||!saved.content.includes('nameserver'))throw new Error('el respaldo resolv.conf no contiene servidores DNS; restaura la configuración del proveedor antes de cambiarla');}catch(e){if(e.message.includes('el DNS de la VPS lo administra'))return {ok:true,mode:'managed-external',warning:'El resolver externo se conservó; Xray usará el DNS seleccionado.'};throw new Error(`No se puede reemplazar el DNS del VPS con seguridad: ${e.message}`)}}
    const oldContent=fs.readFileSync(file,'utf8');fs.writeFileSync(SYSTEM_DNS_TXN,JSON.stringify({mode:'resolv.conf',oldContent}),{mode:0o600});
    const keep=oldContent.split('\n').filter(line=>/^\s*(search|domain|options)\s+/.test(line));const lines=['# Managed by GZMNET — select DNS from the Routing page.',...addresses.map(a=>`nameserver ${a}`),...keep];if(!keep.some(line=>/^\s*options\s/.test(line)))lines.push('options timeout:2 attempts:2');lines.push('');
    const tmp=`${file}.gzmnet.tmp`;fs.writeFileSync(tmp,lines.join('\n'),{mode:0o644});fs.renameSync(tmp,file);
    if(!(await probeSelectedDns(addresses,4000,settings.ip_type||'dual'))||!probeSystemDns(settings.ip_type||'dual'))throw new Error('/etc/resolv.conf fue escrito, pero la consulta directa a los DNS seleccionados o la resolución de la VPS falló. Se restaurará la configuración anterior.');
    logApply(`[SYSTEM-DNS] /etc/resolv.conf aplicado y probado: ${joined}`);return {ok:true,mode:'resolv.conf',servers:addresses};
  }catch(e){rollbackSystemDns();logApply(`[SYSTEM-DNS-ERROR] ${e.message}`);return {ok:false,error:`No se pudo aplicar/probar el DNS en el sistema de la VPS: ${e.message}`}}
}
