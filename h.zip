        vpnDb.prepare(`UPDATE clients SET inbound_id=?, name=?, uuid=?, limit_gb=?, flow=?, sub_token=?, auth_user=?, auth_pass=?, prev_uuid=?, prev_auth_user=?, prev_auth_pass=?, payment_enabled=?, payment_date=?, payment_frequency=?, payment_time=?, telegram_chat_id=?, last_payment_notified=?, device_limit=?, payment_message=?, expiry_enabled=?, expiry_date=?, expiry_time=?, quota_used_bytes=?, quota_up_bytes=?, quota_down_bytes=?, quota_exhausted_at=?, routing_enabled=?, routing_filters_enabled=?, custom_routing_enabled=? WHERE id=?`)
            .run(newInboundId, name || old.name, newCredential || '', limit_gb!==undefined?(parseFloat(limit_gb)||0):old.limit_gb, newFlow, newToken, finalAuthUser, finalAuthPass, newPrevUuid || '', newPrevAuthUser || '', newPrevAuthPass || '', newPayEnabled, newPayDate, newPayFreq, newPayTime, telegram_chat_id !== undefined ? String(telegram_chat_id).trim() : old.telegram_chat_id, newLastNotif, newDeviceLimit, newPaymentMessage, newExpiryEnabled, newExpiry.date, newExpiry.time, newQuotaUsed, newQuotaUp, newQuotaDown, newQuotaExhaustedAt,newRoutingEnabled,newRoutingFiltersEnabled,newCustomRoutingEnabled,id);
        if(routingChanged){invalidateConfigCache();forceNextApply=true;const routingApply=await applyXrayNow(coreXrayConfigChanged?{}:{routingOnly:true});if(!routingApply||!routingApply.ok){vpnDb.prepare('UPDATE clients SET routing_enabled=?,routing_filters_enabled=?,custom_routing_enabled=? WHERE id=?').run(Number(old.routing_enabled??1),Number(old.routing_filters_enabled??1),Number(old.custom_routing_enabled??1),id);invalidateConfigCache();forceNextApply=true;const rollback=await applyXrayNow();if(!rollback||!rollback.ok)logApply(`[CLIENT-ROUTING-ROLLBACK] client=${id} ${rollback&&rollback.error||'Xray no confirmó el enrutamiento anterior'}`);return res.status(503).json({ok:false,error:`Xray no confirmó la configuración avanzada de este cliente; se restauró su política anterior. ${routingApply&&routingApply.error||''}`})}}
