const TRACKER_DOMAINS = ["domain:google-analytics.com","domain:googletagmanager.com","domain:connect.facebook.net","domain:analytics.twitter.com","domain:hotjar.com","domain:mixpanel.com","domain:amplitude.com"];
const MALWARE_DOMAINS = ["update-flash-player.com","adobe-flash-update.net","windows-defender-alert.com","paypal-secure-login.com","netflix-verify-account.com","amazon-security-alert.net"];
