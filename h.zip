let vapidKeys = { publicKey: '', privateKey: '' };
const VAPID_PUBLIC_MARKER='/var/lib/gzmnet/vapid-public.key';
let vapidKeyChangedAtStartup=false;
function persistVapidKeys(keys){if(!keys||!keys.publicKey||!keys.privateKey)throw new Error('VAPID incompleto');vapidKeys={publicKey:String(keys.publicKey),privateKey:String(keys.privateKey)};if(webpush)webpush.setVapidDetails('mailto:admin@gzmnet.com',vapidKeys.publicKey,vapidKeys.privateKey);for(const file of [VAPID_PATH,PERSISTENT_VAPID_PATH]){fs.mkdirSync(path.dirname(file),{recursive:true,mode:0o700});const tmp=file+'.tmp';fs.writeFileSync(tmp,JSON.stringify(vapidKeys,null,2),{mode:0o600});fs.chmodSync(tmp,0o600);fs.renameSync(tmp,file)}try{fs.mkdirSync(path.dirname(VAPID_PUBLIC_MARKER),{recursive:true,mode:0o700});fs.writeFileSync(VAPID_PUBLIC_MARKER,vapidKeys.publicKey+'\n',{mode:0o600});fs.chmodSync(VAPID_PUBLIC_MARKER,0o600)}catch(e){logApply(`[VAPID-MARKER] ${e.message}`)}return true;}
function initVapid(){
    let priorPublicKey='';try{priorPublicKey=fs.existsSync(VAPID_PUBLIC_MARKER)?fs.readFileSync(VAPID_PUBLIC_MARKER,'utf8').trim():''}catch(e){}for(const file of [PERSISTENT_VAPID_PATH,VAPID_PATH])if(fs.existsSync(file)){try{const v=JSON.parse(fs.readFileSync(file,'utf8'));if(v.publicKey&&v.privateKey&&v.publicKey.length>40){vapidKeys=v;break}}catch(e){console.warn('[VAPID] Archivo inválido:',file,e.message)}}
    if(!vapidKeys.publicKey){if(!webpush){console.error('[VAPID] webpush NO disponible');return}try{const k=webpush.generateVAPIDKeys();vapidKeys={publicKey:k.publicKey,privateKey:k.privateKey};console.log('[VAPID] Keys generadas OK')}catch(e){console.error('[VAPID] Error generando:',e.message);return}}vapidKeyChangedAtStartup=!!(priorPublicKey&&priorPublicKey!==vapidKeys.publicKey);
    for(const file of [VAPID_PATH,PERSISTENT_VAPID_PATH])try{fs.mkdirSync(path.dirname(file),{recursive:true,mode:0o700});const tmp=file+'.tmp';fs.writeFileSync(tmp,JSON.stringify(vapidKeys,null,2),{mode:0o600});fs.chmodSync(tmp,0o600);fs.renameSync(tmp,file)}catch(e){logApply(`[VAPID-PERSIST] ${file}: ${e.message}`)}
    try{fs.mkdirSync(path.dirname(VAPID_PUBLIC_MARKER),{recursive:true,mode:0o700});fs.writeFileSync(VAPID_PUBLIC_MARKER,vapidKeys.publicKey+'\n',{mode:0o600});fs.chmodSync(VAPID_PUBLIC_MARKER,0o600)}catch(e){logApply(`[VAPID-MARKER] ${e.message}`)}
    try{fs.mkdirSync('/root/gzmnet/data',{recursive:true,mode:0o700});fs.writeFileSync('/root/gzmnet/data/vapid-migration-complete','ok',{mode:0o600})}catch(e){}
}
initVapid();
if (webpush && vapidKeys.publicKey && vapidKeys.privateKey) {
    try { webpush.setVapidDetails('mailto:admin@gzmnet.com', vapidKeys.publicKey, vapidKeys.privateKey); console.log('[VAPID] setVapidDetails OK'); } catch(e) { console.error('[VAPID] setVapidDetails FALLO:', e.message); }
}

function readCpuStat() {
    try { const stat = fs.readFileSync('/proc/stat', 'utf8'); const parts = stat.split('\n')[0].trim().split(/\s+/).slice(1).map(Number); return { idle: (parts[3]||0)+(parts[4]||0), total: parts.reduce((a,b)=>a+b,0) }; } catch(e) { return null; }
}
lastCpuInfo = readCpuStat();
setInterval(() => {
    const cur = readCpuStat();
    if (lastCpuInfo && cur) { const idleDiff = cur.idle - lastCpuInfo.idle; const totalDiff = cur.total - lastCpuInfo.total; if (totalDiff > 0) cpuUsagePercent = Math.max(0, Math.min(100, 100 - (idleDiff / totalDiff * 100))); }
    lastCpuInfo = cur;
    if (io.engine && io.engine.clientsCount > 0) {
        const totalMem = os.totalmem(), usedMem = totalMem - os.freemem();
        io.emit('system_metrics_live', { cpuUsage: Number(cpuUsagePercent.toFixed(1)), memPercent: Number((usedMem / totalMem * 100).toFixed(1)), memUsed: usedMem, memTotal: totalMem, cpuCount: os.cpus().length, uptime: Math.floor(process.uptime()) });
    }
}, 10000);

function fetchPublicIp(family) {
    return new Promise(resolve => {
        const cmd = family === 6 ? 'curl -s6 --max-time 5 https://ifconfig.co 2>/dev/null || curl -s6 --max-time 5 https://api64.ipify.org 2>/dev/null' : 'curl -s4 --max-time 5 https://ifconfig.me 2>/dev/null || curl -s4 --max-time 5 https://api.ipify.org 2>/dev/null';
        exec(cmd, { timeout: 8000 }, (err, stdout) => {
            const ip = (stdout || '').trim().split('\n')[0].trim();
            let valid = false;
            if (family === 6) valid = !!ip && /^[0-9a-fA-F:]+$/.test(ip) && ip.includes(':');
            else valid = !!ip && /^[\d.]+$/.test(ip);
            resolve(valid ? ip : 'N/A');
        });
    });
}
async function getPublicIp(family = 4) {
    const now = Date.now();
    const cache = family === 6 ? publicIpv6Cache : publicIpCache;
    const ttl = cache.ip === 'N/A' ? 60000 : 600000;
    if (cache.ip && (now - cache.time) < ttl) return cache.ip;
    const ip = await fetchPublicIp(family);
    if (family === 6) publicIpv6Cache = { ip, time: now }; else publicIpCache = { ip, time: now };
    return ip;
}

let vpnDb = null;
try {
    vpnDb = new Database(VPN_DB_PATH);
    const fixedReality=vpnDb.prepare("UPDATE inbounds SET network='raw',updated_at=datetime('now','localtime') WHERE security='reality' AND network NOT IN ('raw','xhttp','grpc')").run();
    if(fixedReality.changes)logApply(`[REALITY-NETWORK-MIGRATION] ${fixedReality.changes} servidores REALITY incompatibles se normalizaron a RAW para que Xray arranque`);
    vpnDb.pragma('journal_mode = WAL');
    vpnDb.pragma('busy_timeout = 8000');

    vpnDb.prepare("DELETE FROM routing_rules WHERE outbound IN ('block_quic','force_tcp')").run();
    vpnDb.pragma('synchronous = NORMAL');
    vpnDb.pragma('cache_size = -32000');
    vpnDb.pragma('temp_store = MEMORY');
    vpnDb.pragma('mmap_size = 268435456');
    try {
        const legacyD = fs.readFileSync(VLESS_DECRYPTION_KEY_PATH, 'utf8').trim();
        const legacyE = fs.readFileSync(VLESS_ENCRYPTION_KEY_PATH, 'utf8').trim();
        vpnDb.prepare("UPDATE inbounds SET vless_decryption=encryption WHERE protocol='vless' AND vless_decryption='' AND encryption IS NOT NULL AND encryption!='' AND encryption!='none'").run();
        if (legacyD && legacyE) vpnDb.prepare("UPDATE inbounds SET vless_decryption=?, vless_encryption=? WHERE protocol='vless' AND (vless_decryption='' OR vless_encryption='')").run(legacyD, legacyE);
    } catch(e) {}
} catch (e) { console.error('SQLite VPN:', e.message); }

let shuttingDown = false;
function gracefulShutdown(sig) {
    if (shuttingDown) return;
    shuttingDown = true;
    try { io.close(); } catch(e) {}
    try { server.close(); } catch(e) {}
    try { if (vpnDb) { vpnDb.pragma('wal_checkpoint(TRUNCATE)'); vpnDb.close(); } } catch(e) {}
    setTimeout(() => process.exit(0), 500);
}
process.on('SIGTERM', () => gracefulShutdown('SIGTERM'));
process.on('SIGINT',  () => gracefulShutdown('SIGINT'));

