app.post('/api/inbounds', checkAuth, async (req, res) => {
    try {
        const b = req.body;
        const { name, protocol, port } = b;
        if (!name || !protocol || !port) return res.status(400).json({ ok: false, error: 'Faltan campos' });
        if (!PROTOCOL_TRANSPORTS[protocol]) return res.status(400).json({ ok: false, error: 'Protocolo inválido' });
        const portNum = parseInt(port);
        if (portNum < 1 || portNum > 65535) return res.status(400).json({ ok: false, error: 'Puerto inválido' });
        // FIX: warn if panel uses port 80 (Nginx) - panel must not be on port 80
        if (portNum === 80) {
            const vpnCfg = getVpnConfig();
            // Panel no longer uses port 80 in fallback (moved to 8443), so 80 is safe for Xray
        }
        const conflict = isPortInUseByOtherInbound(portNum); if (conflict) return res.status(400).json({ ok: false, error: `Puerto en uso por "${conflict.name}"` });
        const sys = await isPortInUseSystem(portNum); if (sys) return res.status(400).json({ ok: false, error: `Puerto usado` });
        const finalSecurity = b.security || 'none';
        const sniffingEnabled=b.sniffing===true||b.sniffing===1||b.sniffing==='1';
        if (!PROTOCOL_SECURITIES[protocol].includes(finalSecurity)) return res.status(400).json({ok:false,error:`Seguridad ${finalSecurity} no soportada por ${protocol}`});
        if(finalSecurity==='tls'){const v=getVpnConfig(),cert=`/etc/nginx/ssl/${String(v.domain||'').replace(/[^a-zA-Z0-9.-]/g,'')}.crt`,key=`/etc/nginx/ssl/${String(v.domain||'').replace(/[^a-zA-Z0-9.-]/g,'')}.key`;if(!v.domain||!fs.existsSync(cert)||!fs.existsSync(key))return res.status(400).json({ok:false,error:'TLS necesita un certificado y una llave válidos para el dominio del panel.'});const sn=String(b.tls_sni||v.domain||'').trim();if(sn){try{execSync(`openssl x509 -in ${JSON.stringify(cert)} -noout -checkhost ${JSON.stringify(sn)}`,{timeout:3000,stdio:'pipe'})}catch(e){return res.status(400).json({ok:false,error:'El SNI no está incluido en el certificado TLS instalado.'})}}}
        if(finalSecurity==='reality'&&(!String(b.reality_private_key||'').trim()||!String(b.reality_public_key||'').trim()||!String(b.reality_short_ids||'').trim()))return res.status(400).json({ok:false,error:'Reality requiere clave privada, Password/PublicKey y al menos un Short ID.'});
        if (!PROTOCOL_TRANSPORTS[protocol].includes(b.network || 'ws')) return res.status(400).json({ ok: false, error: `Transporte "${b.network}" no soportado por ${protocol}` });
        if(finalSecurity==='reality'&&!REALITY_TRANSPORTS.includes(b.network||'ws'))return res.status(400).json({ok:false,error:'Xray REALITY solo funciona con RAW, XHTTP o gRPC. Elige uno de esos transportes.'});
        if((b.network||'ws')==='xhttp'&&!['auto','packet-up','stream-up','stream-one'].includes(String(b.xhttp_mode||'auto')))return res.status(400).json({ok:false,error:'Modo XHTTP inválido. Usa auto, packet-up, stream-up o stream-one.'});
        let vlessDecryption = '', vlessEncryption = '';
        if (protocol === 'vless') {
            const suppliedD=String(b.vless_decryption||'').trim(), suppliedE=String(b.vless_encryption||'').trim();
            if(suppliedD.toLowerCase()==='none'&&suppliedE.toLowerCase()==='none'){vlessDecryption='none';vlessEncryption='none'}
            else if(suppliedE&&!isValidVlessEncKey(suppliedE))return res.status(400).json({ok:false,error:'Formato de VLESS Encryption inválido'});
            else if(suppliedD&&suppliedE&&isValidVlessEncKey(suppliedD)){vlessDecryption=suppliedD;vlessEncryption=suppliedE}
            else {if(suppliedE)return res.status(400).json({ok:false,error:'Para pegar una clave debe importarse también su pareja de servidor. Pulsa Generar para crear ambas.'});const generated=await generateVlessKeypair();if(!generated||generated.error)return res.status(500).json({ok:false,error:generated&&generated.error||'No se pudo generar VLESS Encryption'});vlessDecryption=generated.decryption;vlessEncryption=generated.encryption}
        }
        const info = vpnDb.prepare(`INSERT INTO inbounds (name, protocol, port, network, path, tls, domain, tls_sni, host, security, flow, sniffing, encryption, fingerprint, alpn, reality_dest, reality_server_names, reality_private_key, reality_public_key, reality_short_ids, grpc_service, grpc_multi, h2_path, h2_host, quic_key, quic_security, quic_header, kcp_seed, kcp_header, xhttp_path, xhttp_host, xhttp_mode, ss_method, vless_decryption, vless_encryption) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)`).run(
            name, protocol, portNum, b.network || 'ws', b.path || '/',
            (finalSecurity === 'tls' || finalSecurity === 'reality') ? 1 : 0,
            b.domain || '', (b.tls_sni || (finalSecurity==='tls'?getVpnConfig().domain:'')), b.host || '', finalSecurity, b.flow || '', sniffingEnabled ? 1 : 0, b.encryption || '',
            b.fingerprint || 'chrome', b.alpn || '',
            b.reality_dest || '', b.reality_server_names || '', b.reality_private_key || '', b.reality_public_key || '', b.reality_short_ids || '',
            b.grpc_service || '', b.grpc_multi ? 1 : 0,
            b.h2_path || '/', b.h2_host || '',
            b.quic_key || '', b.quic_security || 'none', b.quic_header || 'none',
            b.kcp_seed || '', b.kcp_header || 'none',
            b.xhttp_path || '/', b.xhttp_host || '', b.xhttp_mode || 'auto',
            b.ss_method || 'aes-256-gcm', vlessDecryption, vlessEncryption
        );
        await ufwAllowPort(portNum);
        emitRefresh();
        res.json({ ok: true, id: info.lastInsertRowid, inbound: vpnDb.prepare('SELECT * FROM inbounds WHERE id = ?').get(info.lastInsertRowid) });
        scheduleApply(true);
    } catch(e) { res.status(500).json({ ok: false, error: e.message }); }
});
app.put('/api/inbounds/:id', checkAuth, async (req, res) => {
    try {
        const { id } = req.params;
        const old = vpnDb.prepare('SELECT * FROM inbounds WHERE id = ?').get(id);
        if (!old) return res.status(404).json({ ok: false, error: 'No existe' });
        const b = req.body;
        const sniffingEnabled=b.sniffing===true||b.sniffing===1||b.sniffing==='1';
        const portNum = parseInt(b.port);
        if (portNum !== old.port) { const c = isPortInUseByOtherInbound(portNum, id); if (c) return res.status(400).json({ ok: false, error: `Puerto en uso` }); const s = await isPortInUseSystem(portNum); if (s) return res.status(400).json({ ok: false, error: `Puerto usado` }); }
        const finalSecurity = b.security || 'none';
        if (!PROTOCOL_SECURITIES[b.protocol].includes(finalSecurity)) return res.status(400).json({ok:false,error:'Seguridad no soportada'});
        if(!PROTOCOL_TRANSPORTS[b.protocol]||!PROTOCOL_TRANSPORTS[b.protocol].includes(b.network||'ws'))return res.status(400).json({ok:false,error:'Transporte no soportado por el protocolo.'});
        if(finalSecurity==='reality'&&!REALITY_TRANSPORTS.includes(b.network||'ws'))return res.status(400).json({ok:false,error:'Xray REALITY solo funciona con RAW, XHTTP o gRPC. Elige uno de esos transportes.'});
        if((b.network||'ws')==='xhttp'&&!['auto','packet-up','stream-up','stream-one'].includes(String(b.xhttp_mode||'auto')))return res.status(400).json({ok:false,error:'Modo XHTTP inválido. Usa auto, packet-up, stream-up o stream-one.'});
        if(finalSecurity==='tls'){const v=getVpnConfig(),cert=`/etc/nginx/ssl/${String(v.domain||'').replace(/[^a-zA-Z0-9.-]/g,'')}.crt`,key=`/etc/nginx/ssl/${String(v.domain||'').replace(/[^a-zA-Z0-9.-]/g,'')}.key`;if(!v.domain||!fs.existsSync(cert)||!fs.existsSync(key))return res.status(400).json({ok:false,error:'TLS necesita certificado y llave válidos del dominio del panel.'});const sn=String(b.tls_sni||v.domain||'').trim();if(sn){try{execSync(`openssl x509 -in ${JSON.stringify(cert)} -noout -checkhost ${JSON.stringify(sn)}`,{timeout:3000,stdio:'pipe'})}catch(e){return res.status(400).json({ok:false,error:'El SNI no está incluido en el certificado TLS instalado.'})}}}
        if(finalSecurity==='reality'&&(!String(b.reality_private_key||'').trim()||!String(b.reality_public_key||'').trim()||!String(b.reality_short_ids||'').trim()))return res.status(400).json({ok:false,error:'Reality requiere private key, public key/Password y Short ID.'});
        let vlessDecryption = old.vless_decryption || '', vlessEncryption = old.vless_encryption || '';
        if (b.protocol === 'vless') {
            const suppliedD = b.vless_decryption !== undefined ? String(b.vless_decryption).trim() : '';
            const suppliedE = b.vless_encryption !== undefined ? String(b.vless_encryption).trim() : '';
            if (suppliedD.toLowerCase()==='none'&&suppliedE.toLowerCase()==='none') { vlessDecryption='none';vlessEncryption='none'; }
            else if (suppliedE) {
                if (!isValidVlessEncKey(suppliedE)) return res.status(400).json({ok:false,error:'Formato de VLESS Encryption inválido'});
                if (!isValidVlessEncKey(suppliedD)) return res.status(400).json({ok:false,error:'Usa Generar para obtener una pareja válida antes de editar.'});
                const oldSuffix=String(old.vless_encryption||'').split('.').pop(),newSuffix=suppliedE.split('.').pop();
                if(oldSuffix!==newSuffix && suppliedD===old.vless_decryption)return res.status(400).json({ok:false,error:'La clave de autenticación cambió. Pega también la clave de servidor compatible o genera un par nuevo.'});
                vlessEncryption=suppliedE; vlessDecryption=suppliedD;
            } else if (!isValidVlessEncKey(vlessDecryption) || !isValidVlessEncKey(vlessEncryption)) {
                const generated=await generateVlessKeypair();
                if(!generated||generated.error)return res.status(500).json({ok:false,error:generated&&generated.error||'No se pudo generar VLESS Encryption'});
                vlessDecryption=generated.decryption;vlessEncryption=generated.encryption;
            }
        } else { vlessDecryption = ''; vlessEncryption = ''; }
        vpnDb.prepare(`UPDATE inbounds SET name=?, protocol=?, port=?, network=?, path=?, tls=?, domain=?, tls_sni=?, host=?, security=?, flow=?, sniffing=?, encryption=?, fingerprint=?, alpn=?, reality_dest=?, reality_server_names=?, reality_private_key=?, reality_public_key=?, reality_short_ids=?, grpc_service=?, grpc_multi=?, h2_path=?, h2_host=?, quic_key=?, quic_security=?, quic_header=?, kcp_seed=?, kcp_header=?, xhttp_path=?, xhttp_host=?, xhttp_mode=?, ss_method=?, vless_decryption=?, vless_encryption=?, updated_at=datetime('now','localtime') WHERE id=?`).run(
            b.name, b.protocol, portNum, b.network || 'ws', b.path || '/',
            (finalSecurity === 'tls' || finalSecurity === 'reality') ? 1 : 0,
            b.domain || '', (b.tls_sni || (finalSecurity==='tls'?getVpnConfig().domain:'')), b.host || '', finalSecurity, b.flow || '', sniffingEnabled ? 1 : 0, b.encryption || old.encryption || '',
            b.fingerprint || 'chrome', b.alpn || '',
            b.reality_dest || '', b.reality_server_names || '', b.reality_private_key || '', b.reality_public_key || '', b.reality_short_ids || '',
            b.grpc_service || '', b.grpc_multi ? 1 : 0,
            b.h2_path || '/', b.h2_host || '',
            b.quic_key || '', b.quic_security || 'none', b.quic_header || 'none',
            b.kcp_seed || '', b.kcp_header || 'none',
            b.xhttp_path || '/', b.xhttp_host || '', b.xhttp_mode || 'auto',
            b.ss_method || 'aes-256-gcm', vlessDecryption, vlessEncryption,
            id
        );
        if (portNum !== old.port) { await ufwAllowPort(portNum); await ufwDeletePort(old.port); }
        emitRefresh();
        res.json({ ok: true, inbound: vpnDb.prepare('SELECT * FROM inbounds WHERE id = ?').get(id) });
        scheduleApply(true);
    } catch(e) { res.status(500).json({ ok: false, error: e.message }); }
});
app.delete('/api/inbounds/:id', checkAuth, async (req, res) => {
    try {
        const ib = vpnDb.prepare('SELECT * FROM inbounds WHERE id = ?').get(req.params.id);
        if (!ib) return res.status(404).json({ ok: false, error: 'No existe' });
        for (const c of vpnDb.prepare('SELECT id FROM clients WHERE inbound_id = ?').all(req.params.id)) delete lastTrafficSnapshot[`c${c.id}`];
        vpnDb.prepare('DELETE FROM clients WHERE inbound_id = ?').run(req.params.id);
        vpnDb.prepare('DELETE FROM inbounds WHERE id = ?').run(req.params.id);
        await ufwDeletePort(ib.port);
        emitRefresh();
        res.json({ ok: true });
        scheduleApply(true);
    } catch(e) { res.status(500).json({ ok: false, error: e.message }); }
});

