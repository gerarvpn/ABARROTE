app.get('/api/timezone', checkAuth, (req, res) => { try { const vpn = getVpnConfig(); res.json({ ok: true, timezone: vpn.timezone || SERVER_TZ, timeFormat: vpn.timeFormat || '24h', list: TIMEZONES }); } catch(e) { res.status(500).json({ ok: false, error: e.message }); } });
app.post('/api/timezone', checkAuth, async (req, res) => {
    try { const { timezone, timeFormat } = req.body; const vpn = getVpnConfig(); if (timezone !== undefined) { if (!TIMEZONES.some(t => t.value === timezone)) return res.status(400).json({ ok: false, error: 'Timezone inválido' }); vpn.timezone = timezone; SERVER_TZ = timezone; process.env.TZ = timezone; exec(`timedatectl set-timezone "${timezone}" 2>/dev/null`, { timeout: 5000 }, () => {}); } if (timeFormat !== undefined) { if (timeFormat !== '12h' && timeFormat !== '24h') return res.status(400).json({ ok: false, error: 'Formato inválido' }); vpn.timeFormat = timeFormat; } saveVpnConfig(vpn); res.json({ ok: true }); } catch(e) { res.status(500).json({ ok: false, error: e.message }); }
});

function normalizeRoutePath(value){let p=String(value||'').trim().replace(/\\/g,'/');if(!p.startsWith('/'))p='/'+p;p=p.replace(/\/+/g,'/').replace(/\/$/,'');if(!p||p==='/'||/[?#\s]/.test(p)||p.split('/').some(x=>x==='.'||x==='..'))return '';return p}
const SUB_NGINX_CONF='/etc/nginx/conf.d/gzmnet-subscription-extra.conf';
function syncSubscriptionListener(port) {
    const vpn=getVpnConfig(), panelPort=Number(vpn.panelPort)||443, p=Number(port)||panelPort;
    if(p===panelPort){try{if(fs.existsSync(SUB_NGINX_CONF))fs.unlinkSync(SUB_NGINX_CONF);execSync('nginx -t && systemctl reload nginx',{timeout:15000,stdio:'pipe'});}catch(e){logApply(`[SUB-NGINX] ${e.message}`)}return true}
    if(p<1||p>65535||p===80||!vpn.domain)return false;
    if(vpnDb.prepare('SELECT id FROM inbounds WHERE port=?').get(p))return false;
    let old='';try{if(fs.existsSync(SUB_NGINX_CONF))old=fs.readFileSync(SUB_NGINX_CONF,'utf8')}catch(e){}
    const ipv6Listen=(()=>{try{return execFileSync('ip',['-6','addr','show','scope','global'],{timeout:2000,encoding:'utf8',stdio:['ignore','pipe','ignore']}).includes('inet6 ')?`    listen [::]:${p} ssl;\n`:''}catch(e){return ''}})();const conf=`server {\n    listen ${p} ssl;\n${ipv6Listen}    server_name ${String(vpn.domain).replace(/[^a-zA-Z0-9.-]/g,'')};\n    ssl_certificate /etc/nginx/ssl/${String(vpn.domain).replace(/[^a-zA-Z0-9.-]/g,'')}.crt;\n    ssl_certificate_key /etc/nginx/ssl/${String(vpn.domain).replace(/[^a-zA-Z0-9.-]/g,'')}.key;\n    location / { proxy_pass http://127.0.0.1:3000; proxy_http_version 1.1; proxy_set_header Upgrade \$http_upgrade; proxy_set_header Connection \'upgrade\'; proxy_set_header Host \$host; proxy_set_header X-Real-IP \$remote_addr; proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto \$scheme; proxy_connect_timeout 15s; proxy_send_timeout 150s; proxy_read_timeout 150s; proxy_buffering off; }\n    location /socket.io/ { proxy_pass http://127.0.0.1:3000/socket.io/; proxy_http_version 1.1; proxy_set_header Upgrade \$http_upgrade; proxy_set_header Connection \'upgrade\'; proxy_set_header Host \$host; proxy_read_timeout 86400s; }\n}\n`;
    try{fs.writeFileSync(SUB_NGINX_CONF,conf,{mode:0o644});execSync('nginx -t',{timeout:15000,stdio:'pipe'});execSync('systemctl reload nginx',{timeout:15000,stdio:'pipe'});try{execSync(`ufw allow ${p}/tcp >/dev/null 2>&1 || true`,{timeout:8000,stdio:'pipe'})}catch(e){}return true}catch(e){try{if(old)fs.writeFileSync(SUB_NGINX_CONF,old);else if(fs.existsSync(SUB_NGINX_CONF))fs.unlinkSync(SUB_NGINX_CONF);execSync('nginx -t && systemctl reload nginx',{timeout:15000,stdio:'pipe'})}catch(e2){}logApply(`[SUB-NGINX-ERR] port=${p} ${e.message}`);return false}
}
setTimeout(()=>{try{const vc=getVpnConfig();syncSubscriptionListener(vc.subPort||vc.panelPort||443)}catch(e){logApply(`[SUB-NGINX-BOOT] ${e.message}`)}},5000);
app.get('/api/subscription-settings', checkAuth, (req, res) => {
    try {
        const vpn = getVpnConfig();
        res.json({
            ok: true,
            domain: vpn.domain || (req.get('host')||'').split(':')[0],
            panelPort: vpn.panelPort||443,
            subInterval: vpn.subInterval||12,
            subPort: vpn.subPort||vpn.panelPort||443,
            subPath: vpn.subPath||'/sub',
            subShowUsage: vpn.subShowUsage!==undefined?vpn.subShowUsage:1,
            subTitle: vpn.subTitle||'',
            subUserAgent: vpn.subUserAgent||'',
            jsonEnabled: vpn.jsonEnabled||0,
            jsonPath: vpn.jsonPath||'/subjson',
            jsonBypass: vpn.jsonBypass||'',
            jsonBypassAll: vpn.jsonBypassDomains||''
        });
    } catch(e) { res.status(500).json({ ok: false, error: e.message }); }
});
app.post('/api/subscription-settings', checkAuth, async (req, res) => {
    try {
        const vpn = getVpnConfig();
        const oldSubPort = vpn.subPort || vpn.panelPort || 443;
        const { subInterval, subPort, subPath, subShowUsage, subTitle, subUserAgent, jsonEnabled, jsonPath, jsonBypass, jsonBypassAll } = req.body;
        if (subInterval !== undefined) { const v = parseInt(subInterval); if (v >= 1 && v <= 1440) vpn.subInterval = v; }
        if (subPort !== undefined) { const p = parseInt(subPort); if (p < 1 || p > 65535) return res.status(400).json({ok:false,error:'Puerto de suscripción inválido'}); vpn.subPort = p; }
        if (subPath !== undefined) { let sp = normalizeRoutePath(subPath); if (!sp || sp.length > 80 || ['api','login','logout','portal','p','socket.io','manifest.json','admin-manifest.json','sw.js'].includes(sp.split('/')[1])) return res.status(400).json({ok:false,error:'Ruta de suscripción inválida o reservada'}); vpn.subPath = sp; }
        if (subShowUsage !== undefined) vpn.subShowUsage = subShowUsage ? 1 : 0;
        if (subTitle !== undefined) vpn.subTitle = String(subTitle).trim().substring(0, 64);
        if (subUserAgent !== undefined) vpn.subUserAgent = String(subUserAgent).trim().substring(0, 500);
        if (jsonEnabled !== undefined) vpn.jsonEnabled = jsonEnabled ? 1 : 0;
        if (jsonPath !== undefined) { let jp = normalizeRoutePath(jsonPath); if (!jp || jp.length > 80 || ['api','socket.io','login','logout','portal','p','manifest.json','admin-manifest.json','sw.js'].includes(jp.split('/')[1])) return res.status(400).json({ok:false,error:'Ruta JSON inválida o reservada'}); vpn.jsonPath = jp; }
        if(normalizeRoutePath(vpn.subPath||'/sub')===normalizeRoutePath(vpn.jsonPath||'/subjson'))return res.status(400).json({ok:false,error:'La ruta JSON debe ser distinta de la ruta de suscripción.'});
        if (jsonBypass !== undefined) vpn.jsonBypass = String(jsonBypass).trim().substring(0, 128);
        if (jsonBypassAll !== undefined) vpn.jsonBypassDomains = String(jsonBypassAll).trim().substring(0, 6000);
        const newSubPort = vpn.subPort || vpn.panelPort || 443;
        if (!syncSubscriptionListener(newSubPort)) return res.status(400).json({ok:false,error:'No se pudo abrir ese puerto. Verifica que esté libre y no sea el puerto 80.'});
        saveVpnConfig(vpn);
        if (oldSubPort !== newSubPort && oldSubPort !== (vpn.panelPort||443) && !vpnDb.prepare('SELECT id FROM inbounds WHERE port=?').get(oldSubPort)) exec(`ufw delete allow ${oldSubPort}/tcp >/dev/null 2>&1`,{timeout:5000},()=>{});
        res.json({ ok: true });
    } catch(e) { res.status(500).json({ ok: false, error: e.message }); }
});


function slugifyPath(p){
    return String(p||'').trim().replace(/^\/+/, '').replace(/[^a-zA-Z0-9\/_-]/g, '-').replace(/\/+/g, '/').slice(0, 80) || 'page';
}
