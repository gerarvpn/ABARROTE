const YOUTUBE_DOMAINS = ['geosite:youtube','domain:youtube.com','domain:music.youtube.com','domain:googlevideo.com','domain:youtubei.googleapis.com','domain:youtube.googleapis.com','domain:youtubeembeddedplayer.googleapis.com','domain:wide-youtube.l.google.com','domain:withyoutube.com','domain:ytimg.com','domain:youtu.be','domain:youtube-nocookie.com','domain:youtube-ui.l.google.com','domain:youtubeeducation.com','domain:youtube.googleapis.com','domain:youtube.com.ar','domain:youtube.com.do','domain:youtube.com.mx','domain:youtube.com.br','domain:youtube.co','domain:youtube.net','domain:youtube.org','domain:youtube.tv','domain:yt.be','domain:ggpht.com','full:yt3.googleusercontent.com'];
