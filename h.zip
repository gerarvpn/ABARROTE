const VALID_OUTBOUNDS = ['block', 'direct', 'warp', 'proxy'];
app.get('/api/routing/rules/export', checkAuth, (req, res) => {
    try {
        const rules = vpnDb.prepare('SELECT name, match_type, value, outbound, enabled, priority, match_rules FROM routing_rules ORDER BY priority DESC, id ASC').all();
        res.json({ ok: true, rules, exportedAt: new Date().toISOString() });
    } catch (e) { res.status(500).json({ ok: false, error: e.message }); }
});
app.post('/api/routing/rules/import',checkAuth,async(req,res)=>{
    const ids=[];try{const rules=req.body&&(req.body.rules||req.body);if(!Array.isArray(rules))return res.status(400).json({ok:false,error:'Se espera un array de reglas'});const ins=vpnDb.prepare('INSERT INTO routing_rules(name,match_type,value,outbound,enabled,priority,match_rules) VALUES(?,?,?,?,?,?,?)');for(const r of rules){if(!r||!r.name||!r.outbound||!VALID_OUTBOUNDS.includes(String(r.outbound)))continue;if(['warp','proxy'].includes(String(r.outbound))&&!getWarpWireguardSettings())throw new Error('Falta un perfil WARP WireGuard válido para importar esta regla.');const matchRules=typeof r.match_rules==='string'?r.match_rules:JSON.stringify(r.match_rules||[]),info=ins.run(String(r.name).slice(0,120),r.match_type||'domain',r.value||'',String(r.outbound),r.enabled==0?0:1,parseInt(r.priority,10)||0,matchRules);ids.push(Number(info.lastInsertRowid))}await applyRoutingRulesSafely();io.emit('rules_updated');return res.json({ok:true,imported:ids.length,rules:ids.map(id=>vpnDb.prepare('SELECT * FROM routing_rules WHERE id=?').get(id)),live:true})}catch(e){if(ids.length){try{const del=vpnDb.prepare('DELETE FROM routing_rules WHERE id=?');vpnDb.transaction(()=>ids.forEach(id=>del.run(id)))();await applyRoutingRulesSafely()}catch(re){forceNextApply=true;logApply(`[RULE-IMPORT-ROLLBACK] ${re.message}`)}}return res.status(503).json({ok:false,error:`No se pudieron aplicar las reglas importadas; se revirtió el lote. ${e.message}`})}
});

app.post('/api/routing/rules',checkAuth,async(req,res)=>{
    let createdId=null;
    try{const {name,match_type,value,outbound,priority,match_rules}=req.body||{};if(!name||!outbound)return res.status(400).json({ok:false,error:'Faltan campos'});if(!VALID_OUTBOUNDS.includes(outbound))return res.status(400).json({ok:false,error:'Acción inválida'});if(['warp','proxy'].includes(outbound)&&!getWarpWireguardSettings())return res.status(400).json({ok:false,error:'No se puede crear esta regla: falta un perfil WARP WireGuard válido.'});const mr=typeof match_rules==='string'?match_rules:(Array.isArray(match_rules)?JSON.stringify(match_rules):'');const info=vpnDb.prepare('INSERT INTO routing_rules(name,match_type,value,outbound,enabled,priority,match_rules) VALUES(?,?,?,?,1,?,?)').run(String(name).trim().slice(0,120),match_type||'auto',String(value||'').trim(),outbound,parseInt(priority)||0,mr);createdId=Number(info.lastInsertRowid);await applyRoutingRulesSafely();io.emit('rules_updated');return res.json({ok:true,id:createdId,rule:vpnDb.prepare('SELECT * FROM routing_rules WHERE id=?').get(createdId),live:true})}
    catch(e){if(createdId!==null){try{vpnDb.prepare('DELETE FROM routing_rules WHERE id=?').run(createdId);await applyRoutingRulesSafely()}catch(rollbackError){forceNextApply=true;logApply(`[RULE-CREATE-ROLLBACK] ${rollbackError.message}`)}}return res.status(503).json({ok:false,error:`No se pudo aplicar la regla; se restauró el estado anterior. ${e.message}`})}
});
app.put('/api/routing/rules/:id',checkAuth,async(req,res)=>{
    const id=Number(req.params.id);let old=null;
    try{old=vpnDb.prepare('SELECT * FROM routing_rules WHERE id=?').get(id);if(!old)return res.status(404).json({ok:false,error:'No existe'});const {name,match_type,value,outbound,priority,match_rules}=req.body||{};if(outbound&&!VALID_OUTBOUNDS.includes(outbound))return res.status(400).json({ok:false,error:'Acción inválida'});const target=outbound||old.outbound;if(['warp','proxy'].includes(target)&&!getWarpWireguardSettings())return res.status(400).json({ok:false,error:'No se puede aplicar la regla: falta un perfil WARP WireGuard válido.'});const mr=match_rules!==undefined?(typeof match_rules==='string'?match_rules:(Array.isArray(match_rules)?JSON.stringify(match_rules):'')):old.match_rules;vpnDb.prepare('UPDATE routing_rules SET name=?,match_type=?,value=?,outbound=?,priority=?,match_rules=? WHERE id=?').run(name||old.name,match_type||old.match_type,value!=null?value:old.value,target,priority!==undefined?(parseInt(priority)||0):old.priority,mr,id);await applyRoutingRulesSafely();io.emit('rules_updated');return res.json({ok:true,rule:vpnDb.prepare('SELECT * FROM routing_rules WHERE id=?').get(id),live:true})}
    catch(e){if(old)try{vpnDb.prepare('UPDATE routing_rules SET name=?,match_type=?,value=?,outbound=?,priority=?,match_rules=?,enabled=? WHERE id=?').run(old.name,old.match_type,old.value,old.outbound,old.priority,old.match_rules,old.enabled,id);await applyRoutingRulesSafely()}catch(rollbackError){forceNextApply=true;logApply(`[RULE-EDIT-ROLLBACK] ${rollbackError.message}`)}return res.status(503).json({ok:false,error:`No se pudo aplicar el cambio; se restauró la regla anterior. ${e.message}`})}
});
app.delete('/api/routing/rules/:id',checkAuth,async(req,res)=>{const id=Number(req.params.id);let old=null;try{old=vpnDb.prepare('SELECT * FROM routing_rules WHERE id=?').get(id);if(!old)return res.status(404).json({ok:false,error:'No existe'});vpnDb.prepare('DELETE FROM routing_rules WHERE id=?').run(id);await applyRoutingRulesSafely();io.emit('rules_updated');return res.json({ok:true,live:true})}catch(e){if(old)try{vpnDb.prepare('INSERT OR REPLACE INTO routing_rules(id,name,match_type,value,outbound,enabled,priority,match_rules) VALUES(?,?,?,?,?,?,?,?)').run(old.id,old.name,old.match_type,old.value,old.outbound,old.enabled,old.priority,old.match_rules);await applyRoutingRulesSafely()}catch(re){forceNextApply=true;logApply(`[RULE-DELETE-ROLLBACK] ${re.message}`)}return res.status(503).json({ok:false,error:`No se pudo eliminar/aplicar la regla; se restauró si fue posible. ${e.message}`})}});
app.patch('/api/routing/rules/:id/toggle',checkAuth,async(req,res)=>{let rule=null;try{rule=vpnDb.prepare('SELECT * FROM routing_rules WHERE id=?').get(req.params.id);if(!rule)return res.status(404).json({ok:false,error:'No existe'});const enabled=rule.enabled?0:1;vpnDb.prepare('UPDATE routing_rules SET enabled=? WHERE id=?').run(enabled,req.params.id);await applyRoutingRulesSafely();io.emit('rules_updated');return res.json({ok:true,enabled:!!enabled,live:true})}catch(e){if(rule)try{vpnDb.prepare('UPDATE routing_rules SET enabled=? WHERE id=?').run(rule.enabled,rule.id);invalidateConfigCache();await applyRoutingRulesSafely()}catch(re){forceNextApply=true;scheduleApply(true);logApply(`[RULE-TOGGLE-ROLLBACK] ${re.message}`)}return res.status(503).json({ok:false,error:`No se aplicó el cambio; se conservó la regla anterior. ${e.message}`})}});

