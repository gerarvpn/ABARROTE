app.delete('/api/clients/:id', checkAuth, async (req, res) => {
    try { const c = vpnDb.prepare('SELECT id FROM clients WHERE id = ?').get(req.params.id); if (c) delete lastTrafficSnapshot[`c${c.id}`]; vpnDb.prepare('DELETE FROM clients WHERE id = ?').run(req.params.id); statsCache = { data: null, time: 0 }; totalsCache = { data: null, time: 0 }; emitRefresh(); res.json({ ok: true }); scheduleApply(true); }
    catch(e) { res.status(500).json({ ok: false, error: e.message }); }
});
app.patch('/api/clients/:id/toggle', checkAuth, async (req, res) => {
    try {
        const c=vpnDb.prepare('SELECT * FROM clients WHERE id=?').get(req.params.id);
        if(!c)return res.status(404).json({ok:false,error:'No encontrado'});
        const body=req.body||{},requested=body.enabled,ns=requested===0||requested===false?0:requested===1||requested===true?1:(c.enabled?0:1);
        let quotaAction='',additionalGb=0,expiryAction='',expiryDays=0,quotaReset=false,expiryExtended=false,expiryDisabled=false;
        if(ns===0){vpnDb.prepare('UPDATE clients SET enabled=0,online=0 WHERE id=?').run(c.id);}
        else{
            const p=getLocalClockParts(new Date()),today=`${p.year}-${p.month}-${p.day}`,tm=`${p.hour}:${p.minute}`,expiryDue=!!(Number(c.expiry_enabled)&&c.expiry_date&&(c.expiry_date<today||(c.expiry_date===today&&(c.expiry_time||'23:59')<=tm)));
            const exhausted=Number(c.limit_gb)>0&&Number(c.quota_used_bytes)>=Number(c.limit_gb)*1000000000;
            quotaAction=String(body.quota_action||'');if(exhausted&&!['unlimited','add_gb'].includes(quotaAction))return res.status(409).json({ok:false,needsAction:'quota',client:c,error:'Elige quitar el límite o agregar GB.'});if(quotaAction&&!['unlimited','add_gb'].includes(quotaAction))return res.status(400).json({ok:false,error:'Acción de cuota inválida.'});if(quotaAction==='add_gb'){const rawGb=String(body.additional_gb??'').trim().replace(',','.');additionalGb=Number(rawGb);if(!rawGb||!Number.isFinite(additionalGb)||additionalGb<=0||additionalGb>1000000)return res.status(400).json({ok:false,needsAction:'quota',client:c,error:'Indica una cantidad válida de GB mayor que 0 y no superior a 1 000 000.'})}
            expiryAction=String(body.expiry_action||'');if(expiryDue&&!['add_days','disable'].includes(expiryAction))return res.status(409).json({ok:false,needsAction:'expiry',client:c,error:'Elige agregar días o quitar el vencimiento.'});if(expiryAction&&!['add_days','disable'].includes(expiryAction))return res.status(400).json({ok:false,error:'Acción de vencimiento inválida.'});if(expiryAction==='add_days'){expiryDays=Number(body.expiry_days);if(!Number.isInteger(expiryDays)||expiryDays<1||expiryDays>3650)return res.status(400).json({ok:false,needsAction:'expiry',client:c,error:'Indica una cantidad válida de días (de 1 a 3650).'})}expiryDisabled=expiryAction==='disable'&&Number(c.expiry_enabled)===1;
            let newLimit=Number(c.limit_gb)||0,keptQuotaUsed=Math.max(0,Number(c.quota_used_bytes)||0),keptQuotaUp=Math.max(0,Number(c.quota_up_bytes)||0),keptQuotaDown=Math.max(0,Number(c.quota_down_bytes)||0);if(quotaAction==='unlimited'){newLimit=0;quotaReset=true}else if(quotaAction==='add_gb'){const oldCap=Math.floor(newLimit*1000000000);if(oldCap>0&&keptQuotaUsed>oldCap){keptQuotaUp=Math.floor(keptQuotaUp*oldCap/keptQuotaUsed);keptQuotaDown=oldCap-keptQuotaUp;keptQuotaUsed=oldCap}newLimit+=additionalGb;quotaReset=false}else if(exhausted){return res.status(409).json({ok:false,needsAction:'quota',client:c,error:'La cuota cambió mientras se procesaba. Vuelve a elegir la acción.'})}
            let newExpiryDate=c.expiry_date||'';if(expiryDue&&expiryAction==='add_days'){const [y,m,d]=String(newExpiryDate).split('-').map(Number),[ty,tmn,td]=today.split('-').map(Number),base=Math.max(Date.UTC(y,m-1,d),Date.UTC(ty,tmn-1,td)),next=new Date(base+expiryDays*86400000);newExpiryDate=`${next.getUTCFullYear()}-${String(next.getUTCMonth()+1).padStart(2,'0')}-${String(next.getUTCDate()).padStart(2,'0')}`;expiryExtended=true}else if(expiryDisabled)newExpiryDate='';
            vpnDb.prepare('UPDATE clients SET enabled=1,online=0,limit_gb=?,quota_used_bytes=CASE WHEN ? THEN 0 ELSE ? END,quota_up_bytes=CASE WHEN ? THEN 0 ELSE ? END,quota_down_bytes=CASE WHEN ? THEN 0 ELSE ? END,quota_exhausted_at=CASE WHEN ? THEN ? ELSE quota_exhausted_at END,expiry_date=?,expiry_enabled=CASE WHEN ? THEN 0 WHEN ? THEN 1 ELSE expiry_enabled END WHERE id=?').run(newLimit,quotaReset?1:0,keptQuotaUsed,quotaReset?1:0,keptQuotaUp,quotaReset?1:0,keptQuotaDown,quotaAction?1:0,'',newExpiryDate,expiryDisabled?1:0,expiryExtended?1:0,c.id);
            try{const current=await queryTrafficStats();const baseline=current&&current[`c${c.id}`];if(baseline){lastTrafficSnapshot[`c${c.id}`]={up:baseline.up||0,down:baseline.down||0};clientQuotaBaselinePending.delete(Number(c.id))}else{delete lastTrafficSnapshot[`c${c.id}`];clientQuotaBaselinePending.add(Number(c.id))}liveTrafficRates.delete(Number(c.id))}catch(e){delete lastTrafficSnapshot[`c${c.id}`];clientQuotaBaselinePending.add(Number(c.id));liveTrafficRates.delete(Number(c.id))}
        }
        statsCache={data:null,time:0};totalsCache={data:null,time:0};emitRefresh();emitVpnStats();
        const result={ok:true,client:vpnDb.prepare('SELECT * FROM clients WHERE id=?').get(c.id),enabled:!!ns,trafficReset:quotaReset,quotaAction,additionalGb,expiryExtended,expiryDisabled,expiryAction,expiryDays,applying:true};
        res.json(result);
        setImmediate(()=>applyXrayNow().then(applied=>{if(!applied||!applied.ok)logApply(`[CLIENT-TOGGLE-APPLY] id=${c.id} enabled=${ns} error=${applied&&applied.error||'not confirmed'}`);else{statsCache={data:null,time:0};emitRefresh();emitVpnStats()}}).catch(e=>logApply(`[CLIENT-TOGGLE-APPLY] id=${c.id} ${e.message}`)));
    }catch(e){res.status(500).json({ok:false,error:e.message})}
});
app.patch('/api/clients/:id/reset-traffic', checkAuth, async (req, res) => {
    try { const c = vpnDb.prepare('SELECT id FROM clients WHERE id = ?').get(req.params.id); if (!c) return res.status(404).json({ ok: false, error: 'No encontrado' }); vpnDb.prepare('UPDATE clients SET up_bytes=0, down_bytes=0, total_bytes=0, quota_used_bytes=0, quota_up_bytes=0, quota_down_bytes=0, quota_exhausted_at=? WHERE id = ?').run('',c.id); try{const snap=await queryTrafficStats(),base=snap&&snap[`c${c.id}`];if(base){lastTrafficSnapshot[`c${c.id}`]={up:base.up||0,down:base.down||0};clientQuotaBaselinePending.delete(Number(c.id))}else{delete lastTrafficSnapshot[`c${c.id}`];clientQuotaBaselinePending.add(Number(c.id))}}catch(e){delete lastTrafficSnapshot[`c${c.id}`];clientQuotaBaselinePending.add(Number(c.id))}liveTrafficRates.delete(Number(c.id));statsCache = { data: null, time: 0 }; totalsCache = { data: null, time: 0 }; emitRefresh(); emitVpnStats(); res.json({ ok: true, client: vpnDb.prepare('SELECT * FROM clients WHERE id = ?').get(req.params.id) }); }
    catch(e) { res.status(500).json({ ok: false, error: e.message }); }
});
app.get('/api/clients/:id/link', checkAuth, async (req, res) => {
    try {
        const c = vpnDb.prepare('SELECT c.*, i.protocol, i.port, i.network, i.path, i.tls, i.domain as ib_domain, i.tls_sni, i.host, i.security, i.flow as inbound_flow, i.reality_public_key, i.reality_server_names, i.reality_short_ids, i.vless_encryption, i.fingerprint, i.alpn, i.ss_method, i.grpc_service, i.grpc_multi, i.h2_path, i.h2_host, i.quic_key, i.quic_security, i.quic_header, i.kcp_seed, i.kcp_header, i.xhttp_path, i.xhttp_host, i.xhttp_mode FROM clients c JOIN inbounds i ON i.id = c.inbound_id WHERE c.id = ?').get(req.params.id);
        if (!c) return res.status(404).json({ ok: false });
        const link = buildClientLink(c);
        const vpn = getVpnConfig();
        const domain = vpn.domain || (req.get('host') || '').split(':')[0];
        const subPort = vpn.subPort || vpn.panelPort || 443;
        const subPortPart = (subPort == 443) ? '' : ':' + subPort;
        const hasSub = protocolHasSub(c.protocol);
        const subUrl = (c.sub_token && hasSub) ? `https://${domain}${subPortPart}${vpn.subPath || '/sub'}/${c.sub_token}` : '';
        const jsonEnabled = vpn.jsonEnabled == 1;
        const jsonUrl = (c.sub_token && jsonEnabled && hasSub) ? `https://${domain}${subPortPart}${vpn.jsonPath || '/subjson'}/${c.sub_token}` : '';
        const portalUrl = (c.sub_token && hasSub) ? `https://${domain}${subPortPart}/portal/${c.sub_token}` : '';
        let qr = '', qrSub=''; if (link) try { qr = await QRCode.toDataURL(link, { width: 360, margin: 2, errorCorrectionLevel: 'H', color: { dark: '#000000', light: '#ffffff' } }); } catch(e) {} if(subUrl)try{qrSub=await QRCode.toDataURL(subUrl,{width:360,margin:2,errorCorrectionLevel:'H',color:{dark:'#000000',light:'#ffffff'}})}catch(e){}
        res.json({ ok: true, link, subUrl, jsonUrl, jsonEnabled, portalUrl, subToken: c.sub_token || '', qr, qrSub, hasSub, usesAuth: protocolUsesAuth(c.protocol), authUser: c.auth_user || '', authPass: c.auth_pass || '' });
    } catch(e) { res.status(500).json({ ok: false, error: e.message }); }
});

app.get('/api/routing', checkAuth, async (req, res) => {
    try { let s = vpnDb.prepare('SELECT * FROM routing_settings WHERE id = 1').get(); if (!s) { vpnDb.prepare(`INSERT INTO routing_settings (id) VALUES (1)`).run(); s = vpnDb.prepare('SELECT * FROM routing_settings WHERE id = 1').get(); }let configMatches=false;try{const active=JSON.parse(fs.readFileSync(XRAY_CONFIG,'utf8')),desired=buildXrayConfig();configMatches=hashString(JSON.stringify(active))===hashString(JSON.stringify(desired))}catch(e){}const xrayActive=await checkXrayActive();res.json({ ok: true, settings: s, rules: vpnDb.prepare('SELECT * FROM routing_rules ORDER BY priority DESC, id ASC').all(), wireproxyReady, systemDnsManaged:fs.existsSync(SYSTEM_DNS_BACKUP), systemDnsPending:fs.existsSync(SYSTEM_DNS_TXN),xrayActive,applied:!!(xrayActive&&configMatches) }); }
    catch(e) { res.status(500).json({ ok: false, error: e.message }); }
});
app.post('/api/routing/settings', checkAuth, async (req, res) => {
    try {
        const b = req.body || {};
        const cur = vpnDb.prepare('SELECT * FROM routing_settings WHERE id = 1').get() || {};
        const pick = (k, d) => b[k] !== undefined ? b[k] : (cur[k] !== undefined ? cur[k] : d);
        const pickBool = (k, d) => b[k] !== undefined ? (b[k] ? 1 : 0) : (cur[k] !== undefined ? cur[k] : (d ? 1 : 0));
        const rulesNeedWarp = vpnDb.prepare('SELECT * FROM routing_rules WHERE enabled = 1').all().some(r => r.outbound === 'warp' || r.outbound === 'proxy');
        const finalWarp=pickBool('warp_enabled',0);let warpWarning=null;
        const selectedIpType=String(pick('ip_type','dual')).trim().toLowerCase();if(!['ipv4','ipv6','dual'].includes(selectedIpType))return res.status(400).json({ok:false,error:'Tipo de red inválido. Selecciona Solo IPv4, Solo IPv6 o Dual.'});if(selectedIpType==='ipv6'&&cur.ip_type!=='ipv6'){const networkCheck=validateSelectedNetwork(selectedIpType);if(!networkCheck.ok)return res.status(400).json({ok:false,error:networkCheck.error})}
        const nextSettings={
            block_ads:pickBool('block_ads',0),block_youtube_ads:pickBool('block_youtube_ads',0),block_adult:pickBool('block_adult',0),block_malware:pickBool('block_malware',0),block_trackers:pickBool('block_trackers',0),block_bittorrent:pickBool('block_bittorrent',0),prevent_captcha:pickBool('prevent_captcha',0),warp_enabled:finalWarp,
            domain_strategy:String(pick('domain_strategy','IPIfNonMatch')).trim()||'IPIfNonMatch',ip_type:selectedIpType,fake_dns:pickBool('fake_dns',0),
            dns_primary:String(pick('dns_primary','1.1.1.1')).trim(),dns_secondary:String(pick('dns_secondary','8.8.8.8')).trim(),dns_primary_v6:String(pick('dns_primary_v6','2606:4700:4700::1111')).trim(),dns_secondary_v6:String(pick('dns_secondary_v6','2001:4860:4860::8888')).trim(),dns_query_strategy:ipTypeToQueryStrategy(selectedIpType)};
            const systemDnsChange=['dns_primary','dns_secondary','dns_primary_v6','dns_secondary_v6','ip_type'].some(k=>Object.prototype.hasOwnProperty.call(b,k));
        const routingConfigChange=['block_ads','block_youtube_ads','block_adult','block_malware','block_trackers','block_bittorrent','prevent_captcha','warp_enabled','domain_strategy','ip_type','fake_dns','dns_primary','dns_secondary','dns_primary_v6','dns_secondary_v6','dns_query_strategy'].some(k=>Object.prototype.hasOwnProperty.call(b,k));
        if(systemDnsChange){try{if(fs.existsSync(SYSTEM_DNS_TXN)&&!rollbackSystemDns())return res.status(500).json({ok:false,error:'Hay un cambio DNS pendiente sin poder restaurar. No se aplicó uno nuevo; revisa el log de sistema.'})}catch(e){return res.status(400).json({ok:false,error:e.message})}}
        try{buildXrayDns(nextSettings)}catch(e){return res.status(400).json({ok:false,error:e.message})}
        vpnDb.prepare(`UPDATE routing_settings SET block_ads=?,block_youtube_ads=?,block_adult=?,block_malware=?,block_trackers=?,block_bittorrent=?,prevent_captcha=?,warp_enabled=?,domain_strategy=?,ip_type=?,fake_dns=?,dns_primary=?,dns_secondary=?,dns_primary_v6=?,dns_secondary_v6=?,dns_query_strategy=?,updated_at=datetime('now','localtime') WHERE id=1`).run(
            nextSettings.block_ads,nextSettings.block_youtube_ads,nextSettings.block_adult,nextSettings.block_malware,nextSettings.block_trackers,nextSettings.block_bittorrent,nextSettings.prevent_captcha,nextSettings.warp_enabled,nextSettings.domain_strategy,nextSettings.ip_type,nextSettings.fake_dns,nextSettings.dns_primary,nextSettings.dns_secondary,nextSettings.dns_primary_v6,nextSettings.dns_secondary_v6,nextSettings.dns_query_strategy);
        let systemDns={ok:true,mode:'unchanged'},systemDnsWarning=null;
        if(systemDnsChange){systemDns=await applySystemDns(nextSettings);if(!systemDns.ok){systemDnsWarning=systemDns.error||'El resolver del VPS no aceptó el cambio; se conservará su configuración anterior.';logApply(`[SYSTEM-DNS-WARNING] ${systemDnsWarning} Xray aplicará su resolver por separado.`)}}
        invalidateConfigCache();
        const requiresXrayReload=systemDnsChange||['ip_type','fake_dns','dns_query_strategy','domain_strategy','block_ads','block_youtube_ads','block_trackers','block_adult','block_malware'].some(k=>Object.prototype.hasOwnProperty.call(b,k));
        let applyResult={ok:true,skipped:true};if(routingConfigChange){if(requiresXrayReload){forceNextApply=true;applyResult=await applyXrayNow()}else applyResult=await applyXrayNow({routingOnly:true})}
        if(!applyResult.ok){if(systemDnsChange&&systemDns&&systemDns.mode!=='managed-external')rollbackSystemDns();vpnDb.prepare(`UPDATE routing_settings SET block_ads=?,block_youtube_ads=?,block_adult=?,block_malware=?,block_trackers=?,block_bittorrent=?,prevent_captcha=?,warp_enabled=?,domain_strategy=?,ip_type=?,fake_dns=?,dns_primary=?,dns_secondary=?,dns_primary_v6=?,dns_secondary_v6=?,dns_query_strategy=? WHERE id=1`).run(cur.block_ads||0,cur.block_youtube_ads||0,cur.block_adult||0,cur.block_malware||0,cur.block_trackers||0,cur.block_bittorrent||0,cur.prevent_captcha||0,cur.warp_enabled||0,cur.domain_strategy||'IPIfNonMatch',cur.ip_type||'dual',cur.fake_dns||0,cur.dns_primary||'1.1.1.1',cur.dns_secondary||'8.8.8.8',cur.dns_primary_v6||'2606:4700:4700::1111',cur.dns_secondary_v6||'2001:4860:4860::8888',cur.dns_query_strategy||'UseIP');invalidateConfigCache();forceNextApply=true;return res.status(500).json({ok:false,error:applyResult.error||'Xray no pudo aplicar DNS/enrutamiento. Se restauró la configuración anterior.'})}
        if(Object.prototype.hasOwnProperty.call(b,'ip_type')){sysInfoCache=null;sysInfoCacheTime=0;}if(systemDnsChange&&systemDns&&systemDns.ok&&systemDns.mode!=='managed-external')try{fs.unlinkSync(SYSTEM_DNS_TXN)}catch(e){} emitRefresh();
        res.json({ ok: true, warning: [warpWarning,systemDnsWarning].filter(Boolean).join('; ')||null, systemDns, warp_enabled: finalWarp });
    } catch(e) { res.status(500).json({ ok: false, error: e.message }); }
});
