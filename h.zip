<div class="modal" id="shareModal" onclick="if(event.target===this)closeShareModal()">
  <div class="modal-box share-modal-box" style="max-width:540px;">
    <div class="modal-head">
      <div><div class="modal-title">Compartir cliente</div><div class="modal-sub" id="shareClientSubtitle">Enlaces y códigos de acceso</div></div>
      <div class="modal-head-actions">
        <button class="modal-close" onclick="closeShareModal()" aria-label="Cerrar"><i data-lucide="x"></i></button>
      </div>
    </div>
    <div class="modal-body share-body">
      <div class="share-qr-card"><div class="share-qr" id="qr1" aria-label="Código QR de suscripción"></div></div>
      <section class="share-portal-card" id="portalShareWrap" style="display:none"><div class="share-portal-icon"><i data-lucide="layout-dashboard"></i></div><div class="share-portal-copy"><strong>Portal del cliente</strong><span>Consulta tu cuenta y administra el acceso.</span></div><button class="share-action portal-action" onclick="openPortalInTab()" title="Abrir portal"><i data-lucide="arrow-up-right"></i><span>Abrir portal</span></button></section>
      <section class="share-option" id="subWrap" style="display:none"><div class="share-option-icon sub"><i data-lucide="rss"></i></div><div class="share-option-main"><div class="share-option-title">Suscripción</div><div class="share-option-subtitle">Recomendado · se actualiza automáticamente</div><div class="mono share-value" id="subTxt"></div></div><button class="share-action" onclick="copyEl('subTxt')" title="Copiar suscripción"><i data-lucide="copy"></i><span>Copiar</span></button></section>
      <section class="share-option" id="directShareWrap"><div class="share-option-icon direct"><i data-lucide="link-2"></i></div><div class="share-option-main"><div class="share-option-title">Enlace de configuración</div><div class="share-option-subtitle">Importa este servidor directamente</div><div class="mono share-value" id="linkTxt"></div></div><button class="share-action" onclick="copyEl('linkTxt')" title="Copiar enlace directo"><i data-lucide="copy"></i><span>Copiar</span></button></section>
      <section class="share-option" id="jsonShareWrap" style="display:none"><div class="share-option-icon json"><i data-lucide="braces"></i></div><div class="share-option-main"><div class="share-option-title">Suscripción JSON</div><div class="share-option-subtitle">Para apps compatibles con configuración JSON</div><div class="mono share-value" id="jsonSubTxt"></div></div><button class="share-action" id="jsonCopyBtn" onclick="copyEl('jsonSubTxt')" title="Copiar JSON"><i data-lucide="copy"></i><span>Copiar</span></button></section>
    </div>
  </div>
</div>

<div class="toast" id="toast"><div class="toast-icon" id="toastIcon"><i data-lucide="check"></i></div><span id="toastText"></span></div>
<div class="reactivate-dialog-backdrop" id="clientReactivateDialog" style="display:none" role="presentation" onclick="if(event.target===this)closeClientReactivateDialog(null)"><section class="reactivate-dialog" role="dialog" aria-modal="true" aria-labelledby="reactivateTitle"><button type="button" class="reactivate-close" aria-label="Cancelar" onclick="closeClientReactivateDialog(null)"><i data-lucide="x"></i></button><div class="reactivate-icon" id="reactivateIcon"><i data-lucide="rotate-cw"></i></div><h2 id="reactivateTitle">Reactivar cliente</h2><p id="reactivateIntro"></p><form id="clientReactivateForm" onsubmit="submitClientReactivateDialog(event)"><div id="reactivateOptions"></div><div class="reactivate-actions"><button type="button" class="btn btn-secondary" onclick="closeClientReactivateDialog(null)">Cancelar</button><button type="submit" class="btn btn-primary"><i data-lucide="check"></i> Continuar</button></div></form></section></div>

<script>
(function(){
  const rawFetch=window.fetch.bind(window);
  window.fetch=async(input,init={})=>{
    const method=String(init.method||(input&&input.method)||'GET').toUpperCase();
    const isApi=String(typeof input==='string'?input:input&&input.url||'').includes('/api/');
    const baseHeaders=new Headers(init.headers||(input&&input.headers)||{});if(isApi&&!baseHeaders.has('Cache-Control'))baseHeaders.set('Cache-Control','no-store');
    const opts={...init,headers:baseHeaders,cache:isApi?'no-store':(init.cache||'default')};
    const tries=(method==='GET'&&isApi&&!init.signal)?4:1;let lastError;
    for(let attempt=0;attempt<tries;attempt++){
      try{
        const r=await rawFetch(input,opts);
        if(r.status===401&&!location.pathname.includes('/login')){location.href='/login';return r}
        if(r.status>=500&&attempt+1<tries){await new Promise(resolve=>setTimeout(resolve,250*(attempt+1)));continue}
        return r;
      }catch(e){lastError=e;if(init.signal||attempt+1>=tries)break;await new Promise(resolve=>setTimeout(resolve,250*(attempt+1)))}
    }
    if(method==='GET'&&isApi)throw new Error('No se pudo conectar con el panel. Comprueba que la VPN o la red siguen conectadas e inténtalo otra vez.');
    if(method!=='GET'&&isApi)throw new Error('No se pudo confirmar el cambio por la conexión. La pantalla se actualizará para mostrar el estado guardado; evita repetir una acción de creación.');
    throw lastError||new Error('No se pudo conectar con el panel.');
  };
})();
function renderIcons(){ if(window.lucide){ try{window.lucide.createIcons();}catch(e){} } }
function syncIslandModalVisibility(){const island=document.getElementById('island');if(!island)return;const hide=Array.from(document.querySelectorAll('.modal.on')).some(m=>m.id!=='importServerModal'&&m.id!=='exportRulesModal');island.classList.toggle('island-modal-hidden',hide);const content=document.querySelector('main.content');if(content)content.classList.toggle('content-island-hidden',hide)}
function lockModalBody(){syncIslandModalVisibility();const content=document.querySelector('main.content');if(content)content.classList.add('modal-content-locked');if(!document.documentElement.classList.contains('modal-lock')){window.__modalScrollY=window.scrollY||0;document.documentElement.classList.add('modal-lock');document.body.style.top=`-${window.__modalScrollY}px`}document.body.classList.add('modal-open')}
function syncModalLock(){syncIslandModalVisibility();const content=document.querySelector('main.content'),open=[...document.querySelectorAll('.modal.on')].length>0||!!document.querySelector('.dynamic-modal-lock');if(open){if(content)content.classList.add('modal-content-locked');if(!document.documentElement.classList.contains('modal-lock')){window.__modalScrollY=window.scrollY||0;document.documentElement.classList.add('modal-lock');document.body.style.top=`-${window.__modalScrollY}px`}document.body.classList.add('modal-open')}else{if(content)content.classList.remove('modal-content-locked');if(document.documentElement.classList.contains('modal-lock')){document.documentElement.classList.remove('modal-lock');document.body.classList.remove('modal-open');const y=window.__modalScrollY||0;document.body.style.top='';window.scrollTo(0,y)}}}
window.addEventListener('DOMContentLoaded',syncModalLock);

let _iconTO = null;
window.addEventListener('DOMContentLoaded', () => { renderIcons(); const ob = new MutationObserver(() => { clearTimeout(_iconTO); _iconTO = setTimeout(renderIcons, 80); }); ob.observe(document.body, { childList: true, subtree: true }); });
if (document.readyState !== 'loading') setTimeout(renderIcons, 80);
const socket = io({ transports: ['websocket', 'polling'], reconnection: true });
let inbounds = [], clientsByInbound = {}, vpnStats = [], allClients = [], routingSettings = {}, routingRules = [];
let protocolsInfo = {};
let editingClientId = null, editingClientInbound = null, editingClientOriginalInbound = null;
let editingInboundId = null;
let editingRuleId = null;
let currentConditions = [], selectedIpType = 'dual';
let vpnDomainCache = '';
let serverTimezone = 'America/Santo_Domingo';
let serverTimeFormat = '24h';
let timezoneList = [];
let savingClient = false, savingInbound = false, savingRule = false;
let liveViewRefreshTimer=null;
function scheduleLiveViewRefresh(){if(liveViewRefreshTimer)return;liveViewRefreshTimer=setTimeout(()=>{liveViewRefreshTimer=null;if(editingClientId||editingInboundId||savingClient||savingInbound)return;if(document.getElementById('p-dash').classList.contains('active'))renderConnected();if(document.getElementById('p-servers').classList.contains('active'))renderServers();if(document.getElementById('p-clients').classList.contains('active'))renderClientsAll()},4500)}
let clockPopoverTimeout = null;
let currentPortalUrl = '';
let notifList = [];
let notifSeenKeys = new Set();
let vapidPubKey = '';
const MONTHS_ES = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
function formatDateSpanish(dateStr) {
    try {
        const parts = String(dateStr).split('-');
        if (parts.length !== 3) return dateStr;
        const y = parseInt(parts[0]), m = parseInt(parts[1]) - 1, d = parseInt(parts[2]);
        if (isNaN(y) || isNaN(m) || isNaN(d) || m < 0 || m > 11) return dateStr;
        return `${d} de ${MONTHS_ES[m]}`;
    } catch(e) { return dateStr; }
}
function esc(s){ if(s==null) return ''; return String(s).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[m]); }
function fmtB(b){ b = Number(b)||0; if (b<=0) return '0 B'; const k=1000; const u=['B','KB','MB','GB','TB']; const i=Math.min(Math.floor(Math.log(b)/Math.log(k)), u.length-1); return (b/Math.pow(k,i)).toFixed(2)+' '+u[i]; }
function fmtUptime(s){ const d=Math.floor(s/86400),h=Math.floor((s%86400)/3600),m=Math.floor((s%3600)/60); if(d>0) return d+'d '+h+'h'; if(h>0) return h+'h '+m+'m'; return m+'m'; }
function fmtLastSeen(ls){ if (!ls) return '—'; try { const d = new Date(ls.indexOf('T') === -1 ? ls.replace(' ','T')+'Z' : ls); if (isNaN(d.getTime())) return '—'; const now = Date.now(); const diff = Math.floor((now - d.getTime())/1000); if (diff < 60) return 'hace ' + Math.max(1, diff) + 's'; if (diff < 3600) return 'hace ' + Math.floor(diff/60) + 'm'; if (diff < 86400) return 'hace ' + Math.floor(diff/3600) + 'h'; if (diff < 604800) return 'hace ' + Math.floor(diff/86400) + 'd'; return d.toLocaleDateString(); } catch(e){ return '—'; } }
function fmtLastSeenExact(value){if(!value)return 'Sin conexión registrada';try{const text=String(value).trim(),d=new Date(text.includes('T')?text:text.replace(' ','T'));if(Number.isNaN(d.getTime()))return 'Sin conexión registrada';return new Intl.DateTimeFormat('es-DO',{dateStyle:'medium',timeStyle:'short',timeZone:serverTimezone||'America/Santo_Domingo'}).format(d)}catch(e){return 'Sin conexión registrada'}}
function displayDeviceLocation(value){const raw=String(value||'').trim();if(!raw)return '';const m=raw.match(/^([A-Z]{2})\|(.+)$/);if(m){const flag=Array.from(m[1]).map(c=>String.fromCodePoint(127397+c.charCodeAt(0))).join('');return `${flag} ${m[2].trim()}`}const parts=raw.split(',').map(x=>x.trim()).filter(Boolean);return parts.length>1?parts[0]:raw.slice(0,80)}
function copyEl(id){ const el = document.getElementById(id); const v = el.value || el.textContent; if (!v) return; navigator.clipboard.writeText(v).then(() => toast('Copiado', 'success')).catch(() => {}); }
function copySysIp(id){ const el = document.getElementById(id); if (!el) return; const v = (el.textContent||'').trim(); if (!v || v === '—' || v === 'N/A') return; navigator.clipboard.writeText(v).then(() => { toast('IP copiada', 'success'); el.classList.add('copied'); setTimeout(() => el.classList.remove('copied'), 900); }).catch(() => {}); }
function getGaugeColor(pct){ if (pct < 50) return '#3b82f6'; if (pct < 70) return '#0ea5e9'; if (pct < 85) return '#f59e0b'; return '#ef4444'; }
function updateGauge(ringId, valId, pct, circ){ const ring = document.getElementById(ringId); const val = document.getElementById(valId); if (!ring || !val) return; const p = Math.max(0, Math.min(100, Number(pct) || 0)); const color = getGaugeColor(p); ring.setAttribute('stroke-dasharray', `${(p/100)*circ} ${circ}`); ring.setAttribute('stroke', color); val.textContent = Math.round(p); val.style.color = p >= 85 ? color : 'var(--text)'; }
function applyTheme(t){ document.documentElement.setAttribute('data-theme', t); try { localStorage.setItem('gzmnet-theme', t); } catch(e){} const ic = document.getElementById('themeIconGlobal'); if (ic) ic.setAttribute('data-lucide', t === 'dark' ? 'sun' : 'moon'); setTimeout(renderIcons, 30); }
function toggleThemeGlobal(){ const cur = document.documentElement.getAttribute('data-theme') || 'dark'; applyTheme(cur === 'dark' ? 'light' : 'dark'); }
(function initTheme(){ let t = 'dark'; try { t = localStorage.getItem('gzmnet-theme') || 'dark'; } catch(e){} document.documentElement.setAttribute('data-theme', t); setTimeout(() => { const ic = document.getElementById('themeIconGlobal'); if (ic) ic.setAttribute('data-lucide', t === 'dark' ? 'sun' : 'moon'); }, 50); })();
(function keepIslandFixedAndHideOnScroll(){
  const island=document.getElementById('island'),content=document.querySelector('main.content');if(!island)return;
  try{localStorage.removeItem('gzmnet-island-position')}catch(e){}
  const fixPosition=()=>{island.style.left='';island.style.right='';island.style.top='';island.style.transform=''};
  const syncScrollVisibility=()=>{const y=content?content.scrollTop:(window.scrollY||0);island.classList.toggle('island-hidden',y>12);fixPosition();syncIslandModalVisibility()};
  fixPosition();syncScrollVisibility();if(content)content.addEventListener('scroll',syncScrollVisibility,{passive:true});window.addEventListener('scroll',syncScrollVisibility,{passive:true});window.addEventListener('resize',syncScrollVisibility,{passive:true});window.__syncIslandScrollVisibility=syncScrollVisibility;
})();
function toggleSection(id){ const el = document.getElementById(id); if (!el) return; el.classList.toggle('open'); }
function toggleSw(id){ const el = document.getElementById(id); if (el) el.classList.toggle('on'); }
function toggleInboundSniffing(){const el=document.getElementById('swInboundSniffing');if(!el)return;const on=!el.classList.contains('on');el.classList.toggle('on',on);el.setAttribute('aria-checked',String(on))}
function setInboundSniffing(on){const el=document.getElementById('swInboundSniffing');if(!el)return;el.classList.toggle('on',!!on);el.setAttribute('aria-checked',String(!!on))}
function setExpiryUi(on,date){const sw=document.getElementById('swExpiry'),fields=document.getElementById('expiryFields'),summary=document.getElementById('cl-expiry-summary');if(sw){sw.classList.toggle('on',!!on);sw.setAttribute('aria-pressed',on?'true':'false')}if(fields)fields.style.display=on?'block':'none';if(summary)summary.textContent=on?(date?`Activo · ${date}`:'Activo · configura fecha y hora'):'Desactivado'}
function toggleExpirySection(){const sw=document.getElementById('swExpiry');if(!sw)return;const on=!sw.classList.contains('on');setExpiryUi(on,document.getElementById('cl-expiry-date').value);if(on)document.getElementById('cl-expiry-details').open=true}
function togglePaySection(){const el=document.getElementById('swPay');if(!el)return;el.classList.toggle('on');const active=el.classList.contains('on');el.setAttribute('aria-pressed',active?'true':'false');const ps=document.getElementById('paySection'),details=document.getElementById('cl-pay-details'),summary=document.getElementById('cl-pay-summary');if(ps)ps.style.display=active?'block':'none';if(details)details.open=active;if(summary)summary.textContent=active?'Recordatorios activos':'Configura avisos automáticos'}
function setClientRoutingUi(client={},protocol=''){const ids={routing_enabled:'swClientRouting',routing_filters_enabled:'swClientFilters',custom_routing_enabled:'swClientCustomRules'},supported=!protocolUsesAuthFrontend(protocol),master=client.routing_enabled===undefined||client.routing_enabled===null||Number(client.routing_enabled)!==0;for(const [key,id] of Object.entries(ids)){const el=document.getElementById(id);if(!el)continue;const enabled=!supported?true:(client[key]===undefined||client[key]===null?true:Number(client[key])!==0);el.classList.toggle('on',enabled);el.setAttribute('aria-pressed',enabled?'true':'false');el.disabled=!supported||(key!=='routing_enabled'&&!master);el.title=supported?'':'El enrutamiento individual de Xray necesita un cliente con identidad UUID; no se puede distinguir cada usuario SOCKS/HTTP.'}const note=document.getElementById('cl-routing-summary');if(note)note.textContent=!supported?'No disponible para usuarios SOCKS/HTTP':!master?'Salida directa · enrutamiento desactivado':`Filtros ${document.getElementById('swClientFilters').classList.contains('on')?'activos':'pausados'} · Reglas ${document.getElementById('swClientCustomRules').classList.contains('on')?'activas':'pausadas'}`}
function toggleClientRoutingOption(key){const ids={routing_enabled:'swClientRouting',routing_filters_enabled:'swClientFilters',custom_routing_enabled:'swClientCustomRules'},el=document.getElementById(ids[key]);if(!el||el.disabled)return;el.classList.toggle('on');el.setAttribute('aria-pressed',el.classList.contains('on')?'true':'false');const values={routing_enabled:document.getElementById('swClientRouting').classList.contains('on')?1:0,routing_filters_enabled:document.getElementById('swClientFilters').classList.contains('on')?1:0,custom_routing_enabled:document.getElementById('swClientCustomRules').classList.contains('on')?1:0},proto=(inbounds.find(x=>Number(x.id)===Number(editingClientInbound||document.getElementById('cl-inbound').value))||{}).protocol;setClientRoutingUi(values,proto)}
function toggleIslandMenu(e){
  try { if (e) { e.preventDefault(); e.stopPropagation(); } } catch(_){}
  const menu = document.getElementById('islandMenu');
  const overlay = document.getElementById('islandOverlay');
  const island = document.getElementById('island');
  const pop = document.getElementById('clockPopover');
  const np = document.getElementById('notifPanel');
  if (!menu) return;
  if (island) island.classList.remove('island-hidden');
  if (pop) pop.classList.remove('open');
  if (np) np.classList.remove('open');
  if (clockPopoverTimeout) { clearTimeout(clockPopoverTimeout); clockPopoverTimeout = null; }
  const isOpen = menu.classList.contains('open');
  if (isOpen) {
    menu.classList.remove('open');
    if (overlay) overlay.classList.remove('open');
    if (island) island.classList.remove('island-expanded');
  } else {
    menu.classList.add('open');
    if (overlay) overlay.classList.add('open');
    if (island) island.classList.add('island-expanded');
  }
}

function toggleClockPopover(e){ if (e) e.stopPropagation(); const pop = document.getElementById('clockPopover'); const overlay = document.getElementById('islandOverlay'); const menu = document.getElementById('islandMenu'); const np = document.getElementById('notifPanel'); if (menu) menu.classList.remove('open'); if (np) np.classList.remove('open'); if (clockPopoverTimeout) { clearTimeout(clockPopoverTimeout); clockPopoverTimeout = null; } if (pop.classList.contains('open')) { pop.classList.remove('open'); overlay.classList.remove('open'); } else { pop.classList.add('open'); overlay.classList.add('open'); clockPopoverTimeout = setTimeout(() => { pop.classList.remove('open'); overlay.classList.remove('open'); clockPopoverTimeout = null; }, 5000); } }
function toggleNotifPanel(e){ if (e) e.stopPropagation(); const np = document.getElementById('notifPanel'); const overlay = document.getElementById('islandOverlay'); const menu = document.getElementById('islandMenu'); const pop = document.getElementById('clockPopover'); if (menu) menu.classList.remove('open'); if (pop) pop.classList.remove('open'); if (np.classList.contains('open')) { np.classList.remove('open'); overlay.classList.remove('open'); } else { np.classList.add('open'); overlay.classList.add('open'); loadNotifications(); } }
function closeAllPopovers(){
  ['islandMenu','clockPopover','notifPanel','islandOverlay'].forEach(id => { const el = document.getElementById(id); if (el) el.classList.remove('open'); });
  const island = document.getElementById('island'); if (island) island.classList.remove('island-expanded');
  if (clockPopoverTimeout) { clearTimeout(clockPopoverTimeout); clockPopoverTimeout = null; }
}

document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAllPopovers(); });

function updateClock(){
    const tz = serverTimezone || undefined;
    const now = new Date();
    const use12h = serverTimeFormat === '12h';
    let timeStr = '--:--', fullTimeStr = '--:--:--', dateStr = '—';
    try {
        if (tz) {
            if (use12h) { const base = now.toLocaleTimeString('en-US', { timeZone: tz, hour12: true, hour: 'numeric', minute: '2-digit' }); timeStr = base.replace(/\s*[AP]\.?M\.?$/i, '').trim(); fullTimeStr = now.toLocaleTimeString('en-US', { timeZone: tz, hour12: true }); }
            else { timeStr = now.toLocaleTimeString('es-ES', { timeZone: tz, hour12: false, hour: '2-digit', minute: '2-digit' }); fullTimeStr = now.toLocaleTimeString('es-ES', { timeZone: tz, hour12: false }); }
            dateStr = now.toLocaleDateString('es-ES', { timeZone: tz, weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
        } else { timeStr = now.toTimeString().slice(0, 5); fullTimeStr = now.toTimeString().slice(0, 8); dateStr = now.toLocaleDateString('es-ES', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }); }
    } catch(e) {}
    const el = document.getElementById('islandTime'); if (el) el.textContent = timeStr;
    const elt = document.getElementById('clockPopTime'); if (elt) elt.textContent = fullTimeStr;
    const eld = document.getElementById('clockPopDate'); if (eld) eld.textContent = dateStr;
    const eltz = document.getElementById('tzPreviewTime'); if (eltz) eltz.textContent = fullTimeStr;
    const eltzz = document.getElementById('tzPreviewZone'); if (eltzz) eltzz.textContent = (tz || 'Local') + ' · ' + serverTimeFormat;
}
setInterval(updateClock, 1000); updateClock();

function saveNotifSeen(){ try { localStorage.setItem('gzmnet-notif-seen', JSON.stringify([...notifSeenKeys])); } catch(e){} }
function loadNotifSeen(){ try { const s = localStorage.getItem('gzmnet-notif-seen'); if (s) notifSeenKeys = new Set(JSON.parse(s)); } catch(e){} }
loadNotifSeen();

function updateNotifBadge(){
    const unread = notifList.filter(n => !notifSeenKeys.has(n.key)).length;
    const badge = document.getElementById('notifBadge');
    const btn = document.getElementById('notifBtn');
    if (!badge || !btn) return;
    badge.textContent = unread > 0 ? (unread > 9 ? '9+' : String(unread)) : '';
    btn.classList.toggle('has-unread', unread > 0);
}
async function loadNotifications(){
    try {
        const r = await fetch('/api/payments/upcoming');
        const d = await r.json();
        if (!d.ok) return;
        notifList = [];
        for (const p of (d.payments||[])) {
            const isToday = p.dueIn === 'hoy';
            const key = 'pay-' + p.id + '-' + p.date;
            notifList.push({ key, title: isToday ? `Pago HOY: ${p.name}` : `Pago mañana: ${p.name}`, desc: `El cliente ${p.name} tiene pago ${isToday ? 'hoy' : 'mañana'} (${formatDateSpanish(p.date)}). Avisa al cliente.`, type: isToday ? 'warn' : 'pay', icon: 'credit-card' });
        }
        try { const nr=await fetch('/api/admin-notifications'); const nd=await nr.json(); for(const n of (nd.notifications||[])){const key='admin-'+n.id;if(!n.seen&&!notifSeenKeys.has(key))notifList.unshift({key,title:n.title,desc:n.body+' · '+n.created_at,type:'warn',icon:'smartphone'});} } catch(e){}
        renderNotifList();
        updateNotifBadge();
    } catch(e){}
}
function renderNotifList(){
    const list = document.getElementById('notifList');
    if (!list) return;
    if (!notifList.length) { list.innerHTML = '<div class="notif-empty"><i data-lucide="bell-off"></i><div class="notif-empty-text">Sin notificaciones</div></div>'; renderIcons(); return; }
    list.innerHTML = notifList.map(n => { const unread = !notifSeenKeys.has(n.key); return `<div class="notif-item ${unread ? 'unread' : ''}" onclick="markNotifRead('${n.key}')"><div class="notif-item-icon ${n.type === 'pay' ? 'pay' : n.type === 'warn' ? 'warn' : ''}"><i data-lucide="${n.icon}"></i></div><div class="notif-item-body"><div class="notif-item-title">${esc(n.title)}</div><div class="notif-item-desc">${esc(n.desc)}</div></div></div>`; }).join('');
    renderIcons();
}
function markNotifRead(key){ notifSeenKeys.add(key); saveNotifSeen(); renderNotifList(); updateNotifBadge(); }
function clearNotifBadge(){ notifList.forEach(n => notifSeenKeys.add(n.key)); fetch('/api/admin-notifications/read',{method:'POST'}).catch(()=>{}); saveNotifSeen(); renderNotifList(); updateNotifBadge(); }

function b64ToUint8(b64) { const pad = '='.repeat((4 - b64.length % 4) % 4); const raw = atob((b64 + pad).replace(/-/g, '+').replace(/_/g, '/')); return new Uint8Array([...raw].map(c => c.charCodeAt(0))); }
async function syncAdminPushSubscription(sub,allowRenew=true){try{if(!sub)return false;const data=sub.toJSON?sub.toJSON():sub,r=await fetch('/api/admin/subscribe',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data),cache:'no-store'}),d=await r.json();if(r.ok&&d.ok)return true;if(d.renew&&allowRenew){try{await sub.unsubscribe()}catch(e){}const reg=await navigator.serviceWorker.ready,fresh=await reg.pushManager.subscribe({userVisibleOnly:true,applicationServerKey:b64ToUint8(vapidPubKey)});return await syncAdminPushSubscription(fresh,false)}return false}catch(e){return false}}
async function adminSubscribePush(forceNew=false) {
    if (!vapidPubKey) return false;
    try {
        const reg = await navigator.serviceWorker.ready;
        let sub = await reg.pushManager.getSubscription();
        if(sub&&forceNew){try{await sub.unsubscribe()}catch(e){}sub=null}
        if(!sub){try{sub=await reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: b64ToUint8(vapidPubKey) })}catch(e){if(/already exists|registration|failed/i.test(e.message||'')){const stale=await reg.pushManager.getSubscription();if(stale)try{await stale.unsubscribe()}catch(_){}sub=await reg.pushManager.subscribe({userVisibleOnly:true,applicationServerKey:b64ToUint8(vapidPubKey)})}else throw e}}
        return await syncAdminPushSubscription(sub);
    } catch(e) { return false; }
}
async function adminRequestNotif() {
    try {
        const perm = await Notification.requestPermission();
        if (perm !== 'granted') { toast('Permiso denegado', 'warning'); return; }
        const ok = await adminSubscribePush();
        if (ok) toast('Notificaciones activadas', 'success');
        updateAdminNotifStatus();
    } catch(e) { toast('Error: ' + e.message, 'error'); }
}
async function updateAdminNotifStatus(){
    const el = document.getElementById('adminNotifStatus');
    const btn = document.getElementById('adminNotifBtn');
    if (!el || !btn) return;
    if (!('serviceWorker' in navigator) || !('PushManager' in window) || !vapidPubKey) { el.textContent = 'Push no disponible en este navegador.'; btn.style.display = 'none'; return; }
    if (Notification.permission === 'denied') { el.textContent = 'Notificaciones bloqueadas. Habilítalas desde el navegador.'; btn.style.display = 'none'; return; }
    if (Notification.permission === 'granted') { try { const ok=await adminSubscribePush();if(ok){el.textContent='Notificaciones activadas y sincronizadas.';btn.innerHTML='<i data-lucide="bell"></i> Activar notificaciones';btn.style.display='none';return} } catch(e){} el.textContent = 'El permiso sigue activo; toca para sincronizar la suscripción con este servidor.';btn.innerHTML='<i data-lucide="refresh-cw"></i> Sincronizar notificaciones';btn.style.display='flex';renderIcons();return; }
    el.textContent = 'Activa las notificaciones para recibir alertas de pago.'; btn.style.display = 'flex';
}
async function testAdminPush(){
    try { const r = await fetch('/api/notifications/test-admin', { method: 'POST' }); const d = await r.json(); if (d.ok) toast(`Enviado a ${d.sent}/${d.total}`, 'success'); else toast(d.error || 'Error', 'error', 5000); } catch(e) { toast('Error de red', 'error'); }
}
async function testClientPush(){
    if (!editingClientId) return;
    try { const r = await fetch('/api/notifications/test-client/' + editingClientId, { method: 'POST' }); const d = await r.json(); if (d.ok) toast(`Enviado a ${d.sent}/${d.total}`, 'success'); else toast(d.error || 'Error', 'error', 6000); } catch(e) { toast('Error de red', 'error'); }
}

async function bootstrapNotifications() {
    try { const r = await fetch('/api/status',{cache:'no-store'}); const d = await r.json(); if (d.ok && d.vapidPublicKey) vapidPubKey = d.vapidPublicKey; } catch(e) {}
    if (!('serviceWorker' in navigator) || !('PushManager' in window) || !vapidPubKey) { updateAdminNotifStatus(); return; }
    try { await navigator.serviceWorker.register('/sw.js',{updateViaCache:'none'}); } catch(e) {}
    try { await navigator.serviceWorker.ready; } catch(e) {}
    await updateAdminNotifStatus();
    if (Notification.permission === 'granted') { try { const reg = await navigator.serviceWorker.ready; const sub = await reg.pushManager.getSubscription(); if(sub)await syncAdminPushSubscription(sub);else await adminSubscribePush();await updateAdminNotifStatus(); } catch(e) {} }
}

function goPage(page){ return nav(page); }
function nav(page){closeAllPopovers();closeAllClientMenus();if(typeof closeAllServerMenus==='function')closeAllServerMenus();document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));const t=document.getElementById('p-'+page);if(!t){console.error('[nav] missing page',page);return}t.classList.add('active');const content=document.querySelector('main.content');if(content){content.classList.remove('content-island-hidden');content.scrollTop=0}if(typeof window.__syncIslandScrollVisibility==='function')window.__syncIslandScrollVisibility();syncIslandModalVisibility();document.querySelectorAll('.island-dropdown-item[data-nav]').forEach(i=>i.classList.toggle('active',i.dataset.nav===page));renderIcons();if(page==='dash'){loadTotals();renderConnected()}if(page==='servers'){renderServers();loadInbounds().then(renderServers).catch(e=>showPageError('serversList',e))}if(page==='clients')loadAllClients().catch(e=>showPageError('clientsAllList',e));if(page==='routing')loadRouting();if(page==='sub'){loadSubSettings();loadDevices()}if(page==='webpages')loadWebPages();if(page==='settings'){loadSystemInfo();loadCacheSettings();loadTimezone();loadTelegramSettings();updateAdminNotifStatus()}}

function toggleXrayLogs(){const panel=document.getElementById('xrayLogsPanel');if(!panel)return;const opening=panel.style.display==='none';panel.style.display=opening?'block':'none';if(opening){loadLogs();panel.scrollIntoView({behavior:'smooth',block:'nearest'})}}
function showPageError(id,e){const el=document.getElementById(id);if(el)el.innerHTML='<div class="card empty"><div class="empty-title">No se pudo cargar esta sección</div><div class="empty-text">'+esc(e&&e.message||'Revisa la conexión del panel')+'</div><button class="btn btn-secondary" onclick="location.reload()"><i data-lucide="refresh-cw"></i> Recargar panel</button></div>';renderIcons()}
const toastEl = document.getElementById('toast');
let toastTO = null;
function toast(text,type,ms){if(toastTO)clearTimeout(toastTO);const icon=document.getElementById('toastIcon'),message=document.getElementById('toastText');if(!toastEl||!icon||!message)return;toastEl.classList.remove('success','error','warning','info');const icons={success:'check',error:'x',warning:'alert-triangle',info:'info'};icon.innerHTML=`<i data-lucide="${icons[type]||'info'}"></i>`;message.textContent=text;toastEl.classList.add('on',type||'info');toastTO=setTimeout(()=>{toastEl.classList.remove('on');toastTO=null},ms||3000)}
window.addEventListener('panel:network-error',e=>{const m=e&&e.detail&&e.detail.message;if(m)toast(m,'warning',5000)})
async function updateSystemInfo(){ try { const r = await fetch('/api/system-info'); const d = await r.json(); if (!d.ok) return; if (d.timezone && d.timezone !== serverTimezone) serverTimezone = d.timezone; if (d.timeFormat && d.timeFormat !== serverTimeFormat) serverTimeFormat = d.timeFormat; updateClock(); const cpu = parseFloat(d.cpuUsage) || 0; const ram = parseFloat(d.memPercent) || 0; updateGauge('cpuRing', 'cpuVal', cpu, 87.96); updateGauge('ramRing', 'ramVal', ram, 87.96); updateGauge('cpuRingBig', 'cpuBigVal', cpu, 238.76); updateGauge('ramRingBig', 'ramBigVal', ram, 238.76); const el = id => document.getElementById(id); if (el('cpuBigVal')) { el('cpuBigVal').style.color = cpu >= 85 ? getGaugeColor(cpu) : 'var(--text)'; } if (el('ramBigVal')) { el('ramBigVal').style.color = ram >= 85 ? getGaugeColor(ram) : 'var(--text)'; } if (el('cpuStatSub')) el('cpuStatSub').textContent = (d.cpuCount || 1) + ' núcleos'; if (el('ramStatSub')) { const used = ((d.memUsed||0)/1024/1024/1024).toFixed(1); const total = ((d.memTotal||0)/1024/1024/1024).toFixed(1); el('ramStatSub').textContent = used + ' / ' + total + ' GB'; } if (el('sysUptime')) el('sysUptime').textContent = fmtUptime(d.uptime || 0); if (el('sysIpv4')) el('sysIpv4').textContent = d.ipv4 || '—'; if (el('sysIpv6')) el('sysIpv6').textContent = d.ipv6 || '—'; } catch(e){} }

async function loadProtocolsInfo(){try{const r=await fetch('/api/protocols-info');const d=await r.json();if(!r.ok||!d.ok)throw new Error(d.error||`Error HTTP ${r.status}`);protocolsInfo=d.protocols||{}}catch(e){console.error('[protocols-info]',e.message);protocolsInfo={vless:{transports:['raw','xhttp','grpc','ws','httpupgrade','kcp'],securities:['none','tls','reality']},vmess:{transports:['raw','xhttp','grpc','ws','httpupgrade','kcp'],securities:['none','tls','reality']},trojan:{transports:['raw','xhttp','grpc','ws','httpupgrade','kcp'],securities:['none','tls','reality']},shadowsocks:{transports:['raw','xhttp','grpc','ws','httpupgrade','kcp'],securities:['none','tls']},socks:{transports:['raw'],securities:['none','tls']},http:{transports:['raw'],securities:['none','tls']}}}}
async function loadInbounds(){ const r=await fetch('/api/inbounds-full');const d=await r.json();if(!r.ok||!d.ok)throw new Error(d.error||'No se pudieron cargar los servidores');inbounds=d.inbounds||[];clientsByInbound={};for(const ib of inbounds)clientsByInbound[ib.id]=ib.clients||[];return inbounds; }
async function loadAllClients(){ const r=await fetch('/api/clients-all');const d=await r.json();if(!r.ok||!d.ok)throw new Error(d.error||'No se pudieron cargar los clientes');allClients=d.clients||[];renderClientsAll();return allClients; }
async function loadTotals(){ try { const r = await fetch('/api/traffic-total'); const d = await r.json(); if (!d.ok) return; const el = id => document.getElementById(id); if (el('kpiInbounds')) el('kpiInbounds').textContent = d.totalInbounds; if (el('kpiClients')) el('kpiClients').textContent = d.totalClients; if (el('kpiOnline')) el('kpiOnline').textContent = d.active; if (el('kpiTraffic')) el('kpiTraffic').textContent = fmtB(d.total); if (el('kpiTrafficSub')) el('kpiTrafficSub').textContent = '↑ ' + fmtB(d.up) + ' · ↓ ' + fmtB(d.down); if (el('sysTraffic')) el('sysTraffic').textContent = fmtB(d.total); } catch(e){} }

function renderConnected(){ const list = document.getElementById('connectedList'); const online = vpnStats.filter(s => s.connected && s.enabled);  if (!online.length) { list.innerHTML = '<div class="empty" style="padding:36px 12px;min-height:auto;"><i data-lucide="wifi-off"></i><div class="empty-text" style="margin-bottom:0;">Sin usuarios conectados</div></div>'; renderIcons(); return; } list.innerHTML = online.map(u => { const proto = (u.protocol||'').toLowerCase(); return `<div style="display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--border);"><span class="dot on"></span><div style="flex:1;min-width:0;"><div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;"><span style="font-weight:500;font-size:13px;">${esc(u.name)}</span><span class="badge ${proto}">${proto.toUpperCase()}</span></div><div style="font-size:11px;color:var(--text-3);margin-top:2px;">${esc(u.inbound||'')}</div></div><div class="mono" style="font-size:11.5px;">${fmtB(u.total)}</div></div>`; }).join(''); renderIcons(); }

function renderServers(){
    if(document.querySelector('.client-menu-drop.open'))return;
    closeAllClientMenus();
    const list = document.getElementById('serversList');if(!list)return;
    if (!inbounds.length) { list.innerHTML = `<div class="card empty"><i data-lucide="server"></i><div class="empty-title">Aún no hay servidores</div><div class="empty-text">Crea tu primer servidor.</div><button class="btn btn-primary" onclick="openInboundModal()"><i data-lucide="plus"></i> Crear</button></div>`; renderIcons(); return; }
    list.innerHTML = inbounds.map(ib => {
        const cls = clientsByInbound[ib.id] || [];
        const online = cls.filter(c => { const s = vpnStats.find(v => v.id === c.id); return s && s.connected && c.enabled; }).length;
        const tot = cls.reduce((a,c) => { const s = vpnStats.find(v => Number(v.id) === Number(c.id)); return a + (Number(s&&s.total)||Number(c.total_bytes)||0); }, 0);
        const shownNetwork=ib.security==='reality'&&!['raw','xhttp','grpc'].includes(ib.network||'ws')?'RAW':(ib.network||'ws').toUpperCase();
        const iconName = ib.protocol === 'vless' ? 'zap' : ib.protocol === 'vmess' ? 'shield' : ib.protocol === 'trojan' ? 'key-round' : ib.protocol === 'shadowsocks' ? 'lock' : ib.protocol === 'socks' ? 'radio' : 'globe';
        return `<div class="server-card">
          <div class="server-card-header">
            <div class="server-icon ${ib.protocol}"><i data-lucide="${iconName}"></i></div>
            <div class="server-info">
              <div class="server-name">${esc(ib.name)}</div>
              <div class="server-meta"><span class="badge ${ib.protocol}">${ib.protocol.toUpperCase()}</span><span>:${ib.port}</span><span>·</span><span>${esc(shownNetwork)}</span><span class="security-text security-${esc(ib.security||(ib.tls?'tls':'none'))}">${esc((ib.security||(ib.tls?'tls':'none')).toUpperCase())}</span></div>
            </div>
            <div class="server-actions">
              <button class="btn btn-primary btn-icon" onclick="openNewClient(${ib.id})" title="Cliente"><i data-lucide="user-plus"></i></button>
              <div class="client-menu">
                <button type="button" class="client-menu-btn" onclick="toggleServerMenu(event, ${ib.id})" title="Más"><i data-lucide="menu"></i></button>
                <div class="client-menu-drop" id="sv-menu-${ib.id}">
                  <button type="button" onclick="closeAllServerMenus();requestAnimationFrame(()=>editInbound(${ib.id}))"><i data-lucide="pencil"></i> Editar</button>
                  <button type="button" onclick="copyServerJson(${ib.id});closeAllServerMenus()"><i data-lucide="copy"></i> Copiar JSON</button>
                  <button type="button" class="danger" onclick="deleteInbound(${ib.id});closeAllServerMenus()"><i data-lucide="trash-2"></i> Eliminar</button>
                </div>
              </div>
            </div>
          </div>
          <div class="server-stats">
            <div class="server-stat"><div class="server-stat-label">Clientes</div><div class="server-stat-value accent">${cls.length}</div></div>
            <div class="server-stat"><div class="server-stat-label">En línea</div><div class="server-stat-value success">${online}</div></div>
            <div class="server-stat"><div class="server-stat-label">Tráfico</div><div class="server-stat-value">${fmtB(tot)}</div></div>
          </div>
        </div>`;
    }).join('');
    renderIcons();
}
function closeAllServerMenus(){closeAllClientMenus()}
function toggleServerMenu(ev,id){return toggleClientMenu(ev,id,'sv')}
async function copyServerJson(id){
  try {
    const r = await fetch('/api/inbounds/' + id + '/export');
    const d = await r.json();
    if (!d.ok) return toast(d.error || 'Error', 'error');
    await navigator.clipboard.writeText(JSON.stringify(d.server, null, 2));
    toast('JSON del servidor copiado', 'success');
  } catch(e){ toast('Error al copiar', 'error'); }
}
function openImportServerModal(){
  const wrap = document.createElement('div');
  wrap.className = 'modal on';
  wrap.id = 'importServerModal';
  wrap.style.zIndex = '9200';
  wrap.innerHTML = `<div class="modal-box import-server-modal-box" style="max-width:520px">
    <div class="modal-head">
      <div><div class="modal-title">Importar servidor y clientes</div><div class="modal-sub">Pega JSON de GZMNET o un inbound de 3x-ui con settings.clients</div></div>
      <div class="modal-head-actions"><button class="btn btn-primary btn-sm" id="impOk"><i data-lucide="clipboard-paste"></i> Restaurar</button><button class="modal-close" id="impClose" aria-label="Cerrar"><i data-lucide="x"></i></button></div>
    </div>
    <div class="modal-body">
      <div class="field" style="margin:0">
        <label>JSON del servidor</label>
        <textarea id="impJson" rows="10" class="mono" style="width:100%;font-size:12px;border-radius:12px;" placeholder='{"inbound":{...},"clients":[...]}'></textarea>
      </div>
    </div>
  </div>`;
  document.body.appendChild(wrap);
  lockModalBody();
  if (window.lucide) try{lucide.createIcons();}catch(e){}
  const close = () => { wrap.remove(); syncModalLock(); };
  wrap.querySelector('#impClose').onclick = close;
  wrap.querySelector('#impOk').onclick = async () => {
    const raw = (document.getElementById('impJson').value || '').trim();
    if (!raw) return toast('Pega el JSON', 'warning');
    close();
    await importServerJson(raw);
  };
  wrap.addEventListener('click', (e) => { if (e.target === wrap) close(); });
}
async function importServerJson(raw){
  try {
    const data = typeof raw === 'string' ? JSON.parse(raw) : raw;
    const r = await fetch('/api/inbounds/import', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(data) });
    const d = await r.json();
    if (d.ok) {
      toast((d.source==='3x-ui'?'3x-ui importado':'Servidor restaurado') + (d.clients ? ` · ${d.clients} clientes` : '') + (d.keysPreserved?' · par VLESS conservado':''), 'success', 6000);
      await loadInbounds();
      renderServers();
    } else toast(d.error || 'Error', 'error', 8000);
  } catch(e){ toast('JSON inválido', 'error'); }
}

function getPayBadges(c) {
    if (!c.payment_enabled || !c.payment_date) return '';
    const freq = parseInt(c.payment_frequency) || 0;
    const today = new Date(); today.setHours(0,0,0,0);
    let target;
    if (freq === 0) target = new Date(c.payment_date + 'T00:00:00');
    else { let start = new Date(c.payment_date + 'T00:00:00'); if (start >= today) target = start; else { const diff = Math.floor((today - start) / 86400000); target = new Date(start.getTime() + Math.ceil(diff/freq) * freq * 86400000); } }
    const diff = Math.round((target - today) / 86400000);
    if (diff === 0) return '<span class="badge pay-today"><i data-lucide="credit-card" style="width:11px;height:11px;"></i>Pago HOY</span>';
    if (diff === 1) return '<span class="badge pay"><i data-lucide="credit-card" style="width:11px;height:11px;"></i>Pago mañana</span>';
    if (diff > 1 && diff <= 7) return `<span class="badge pay"><i data-lucide="credit-card" style="width:11px;height:11px;"></i>En ${diff}d</span>`;
    return '';
}

let clientStatusFilter='all';
function formatTrafficRate(value){const n=Math.max(0,Number(value)||0),units=['B/s','KB/s','MB/s','GB/s'];if(n<1)return '0 B/s';const i=Math.min(units.length-1,Math.floor(Math.log(n)/Math.log(1024)));return (n/Math.pow(1024,i)).toFixed(i?1:0)+' '+units[i]}
function clientExpiryStatus(c){
 if(!Number(c.expiry_enabled)||!c.expiry_date)return {expired:false,soon:false};
 try{
  const tz=serverTimezone||'America/Santo_Domingo';
  const parts=Object.fromEntries(new Intl.DateTimeFormat('en-CA',{timeZone:tz,year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',hourCycle:'h23'}).formatToParts(new Date()).map(x=>[x.type,x.value]));
  const now=Date.UTC(+parts.year,+parts.month-1,+parts.day,+parts.hour,+parts.minute);
  const m=/^(\d{2}):(\d{2})$/.exec(c.expiry_time||'23:59'),d=/^(\d{4})-(\d{2})-(\d{2})$/.exec(c.expiry_date);
  if(!m||!d)return {expired:false,soon:false};
  const end=Date.UTC(+d[1],+d[2]-1,+d[3],+m[1],+m[2]),delta=end-now;
  return {expired:delta<=0,soon:delta>0&&delta<=7*86400000};
 }catch(e){return {expired:false,soon:false}}
}
function clientExpirySoon(c){return clientExpiryStatus(c).soon}
function clientCardDate(date,time=''){const m=/^(\d{4})-(\d{2})-(\d{2})$/.exec(String(date||''));return m?`${m[3]}|${m[2]}|${m[1].slice(-2)}${time?' '+time:''}`:''}
function clientAssignedGb(value){const n=Number(value)||0;return n.toLocaleString('es-DO',{maximumFractionDigits:3})}
function clientLimitBadge(c){const gb=Number(c&&c.limit_gb)||0;return gb>0?`<span class="client-limit-chip"><i data-lucide="gauge" aria-hidden="true"></i>LÍMITE DE ${esc(clientAssignedGb(gb))} GB</span>`:''}
function formatClientLastSeen(value){if(!value)return '';try{const text=String(value).trim(),d=new Date(text.includes('T')?text:text.replace(' ','T'));if(Number.isNaN(d.getTime()))return '';const p=Object.fromEntries(new Intl.DateTimeFormat('en-CA',{timeZone:serverTimezone||'America/Santo_Domingo',year:'2-digit',month:'2-digit',day:'2-digit',hour:'numeric',minute:'2-digit',hour12:true}).formatToParts(d).filter(x=>x.type!=='literal').map(x=>[x.type,x.value]));const suffix=String(p.dayPeriod||'').toLowerCase().includes('p')?'p. m.':'a. m.',hour=String(p.hour||'').replace(/[^0-9]/g,'');return `${p.day}|${p.month}|${p.year}  ${hour}:${p.minute} ${suffix}`}catch(e){return ''}}
function clientExpiryBadge(c,exhausted=false){if(exhausted){const gb=clientAssignedGb(c.limit_gb);return `<span class=\"badge is-quota-exhausted\"><i data-lucide=\"chart-no-axes-column-increasing\" style=\"width:11px;height:11px;\"></i>Consumo de ${esc(gb)} GB completado</span>`}if(!Number(c.expiry_enabled)||!c.expiry_date)return '';const st=clientExpiryStatus(c),date=clientCardDate(c.expiry_date,String(c.expiry_time||'23:59'));return `<span class=\"badge ${st.expired?'is-expired':'count'}\"><i data-lucide=\"calendar-clock\" style=\"width:11px;height:11px;\"></i>${st.expired?'Venció el':'Vence el'} ${esc(date)}</span>`}
function clientLiveState(c){const st=vpnStats.find(x=>Number(x.id)===Number(c.id));const enabled=Number(c.enabled)===1,total=Number((st&&st.total)??c.total_bytes)||0,quota=Number((st&&st.quota_used)??c.quota_used_bytes??total)||0,limit=Number(c.limit_gb)||0,exhausted=limit>0&&quota>=limit*1000000000,expiry=clientExpiryStatus(c),online=!!(enabled&&st&&st.connected===true&&!exhausted&&!expiry.expired),near=!exhausted&&limit>0&&quota>=limit*.85*1000000000,expiring=expiry.soon;return {st:st||{},enabled,online,total,quota,exhausted,near,expiring,expired:expiry.expired}}
function clientStatusBucket(x){if(x.exhausted)return 'exhausted';if(x.expired||!x.enabled)return 'disabled';if(x.online)return 'online';return 'active'}
function clientStatusMatchesFilter(x,key){if(key==='all')return true;if(key==='expiring')return !x.exhausted&&!x.expired&&!!(x.near||x.expiring);if(key==='active')return x.enabled&&!x.online&&!x.exhausted&&!x.expired;if(key==='online')return x.online;if(key==='exhausted')return x.exhausted;if(key==='disabled')return !x.exhausted&&(!x.enabled||x.expired);return clientStatusBucket(x)===key}
function renderClientStatusTable(){
 const box=document.getElementById('clientsStatusTable');if(!box)return;
 const rows=(allClients||[]).map(c=>({c,...clientLiveState(c)}));
 const items=[['all','Clientes'],['online','En línea'],['expiring','Venciendo'],['disabled','Deshabilitado'],['active','Activo'],['exhausted','Agotado']];
 const counts={all:rows.length,online:rows.filter(x=>x.online).length,expiring:rows.filter(x=>!x.exhausted&&!x.expired&&(x.near||x.expiring)).length,disabled:rows.filter(x=>x.expired||(!x.enabled&&!x.exhausted)).length,active:rows.filter(x=>x.enabled&&!x.online&&!x.exhausted&&!x.expired).length,exhausted:rows.filter(x=>x.exhausted&&!x.expired).length};
 box.innerHTML=items.map(([key,label])=>`<button type="button" class="client-status-cell ${clientStatusFilter===key?'active':''}" data-client-filter="${key}" aria-pressed="${clientStatusFilter===key}" onclick="setClientFilter('${key}')"><span class="client-status-label">${key==='all'?'<i class="client-status-icon" data-lucide="user-round" aria-hidden="true"></i>':''}${label}</span><span class="client-status-value">${key==='all'?'':'<i class="client-status-dot"></i>'}<b>${counts[key]||0}</b></span></button>`).join('');
 if(typeof renderIcons==='function')renderIcons();
}
function setClientFilter(key){clientStatusFilter=['all','online','expiring','disabled','active','exhausted'].includes(key)?key:'all';renderClientsAll()}
function renderClientsAll(){
    if(document.querySelector('.client-menu-drop.open'))return;
    closeAllClientMenus();
    const list = document.getElementById('clientsAllList');
    if (!list) return;
    renderClientStatusTable();
    const q = (document.getElementById('clientSearch') && document.getElementById('clientSearch').value || '').toLowerCase().trim();
    let filtered = (allClients||[]).filter(c=>clientStatusMatchesFilter(clientLiveState(c),clientStatusFilter));
    if (q) filtered = filtered.filter(c => String(c.name||'').toLowerCase().includes(q) || String(c.id).includes(q));
    if (!filtered.length) {
        list.innerHTML = `<div class="card empty"><i data-lucide="users-round"></i><div class="empty-title">${q ? 'Sin resultados' : (clientStatusFilter==='all'?'Aún no hay clientes':'No hay clientes en este estado')}</div><div class="empty-text">${q ? 'Intenta otra búsqueda' : (clientStatusFilter==='all'?'Crea tu primer cliente':'Toca otro contador para ver clientes')}</div>${!q&&clientStatusFilter==='all' ? '<button class="btn btn-primary" onclick="openNewClient()"><i data-lucide="user-round-plus"></i> Crear</button>' : ''}</div>`;
        renderIcons(); return;
    }
    list.innerHTML = filtered.map(c => {
        const s = vpnStats.find(v => v.id === c.id) || {};
        const en = Number(c.enabled) === 1;
        const on = clientLiveState(c).online;
        const totalNow=Number(s.total??c.total_bytes)||0,quotaNow=Number(s.quota_used??c.quota_used_bytes??totalNow)||0,limitNow=Number(c.limit_gb)||0,exhausted=limitNow>0&&quotaNow>=limitNow*1000000000,expiryState=clientExpiryStatus(c),expired=expiryState.expired,nearLimit=!exhausted&&limitNow>0&&quotaNow>=limitNow*.85*1000000000,expiring=expiryState.soon;
        const rowState=exhausted?'is-exhausted':expired?'is-expired':(!en?'is-disabled':(nearLimit||expiring?'is-near-limit':''));
        const quotaUp=Number(s.quota_up??c.quota_up_bytes)||0,quotaDown=Number(s.quota_down??c.quota_down_bytes)||0;
        const lifetimeTotal=(s.total!=null&&s.total>0)?Number(s.total):((Number(c.total_bytes)||0)||((Number(c.up_bytes)||0)+(Number(c.down_bytes)||0)));
        const tot=limitNow>0?quotaNow:lifetimeTotal;
        const up=limitNow>0?quotaUp:((s.up!=null)?Number(s.up):(Number(c.up_bytes)||0));
        const down=limitNow>0?quotaDown:((s.down!=null)?Number(s.down):(Number(c.down_bytes)||0));
        const proto = (c.protocol||'').toLowerCase();
        const protoIcons = { vless:'zap', vmess:'shield', trojan:'key-round', shadowsocks:'lock-keyhole', socks:'radio', http:'globe' };
        const protoIcon = protoIcons[proto] || 'network';
        const badges = clientLimitBadge(c)+getPayBadges(c)+clientExpiryBadge(c,exhausted);
        const lastSeen = s.last_seen || c.last_seen;
        const statusHtml = exhausted
          ? `<div class="client-status-line exhausted"><span class="dot-exhausted"></span><span>Agotado</span></div>`
          : expired
            ? `<div class="client-status-line expired"><span class="dot-expired"></span><span>Vencido</span></div>`
            : (nearLimit||expiring)
              ? `<div class="client-status-line warning"><span class="dot-warning"></span><span>${on?'En línea':(en?'Desconectado':'Desactivado')} · Venciendo</span></div>`
              : on
                ? `<div class="client-status-line on"><span class="dot-live"></span><span>En línea</span></div>`
                : (en ? `<div class="client-status-line off"><span class="dot-off"></span><span>Desconectado</span></div>` : `<div class="client-status-line off disabled"><span class="dot-disabled"></span><span>Desactivado</span></div>`);
        const lastTxt = on ? '' : formatClientLastSeen(lastSeen);
        return `<div class="client-row ${rowState}" data-id="${c.id}">
          <div class="client-info">
            <div class="client-meta-row client-presence-row" style="margin-bottom:4px">
              ${statusHtml}
              ${lastTxt ? `<span class="client-last-seen"><i data-lucide="clock-3" aria-hidden="true"></i><span>${esc(lastTxt)}</span></span>` : (!on?'<span class="client-last-seen muted">Sin conexión</span>':'')}
            </div>
            <div class="client-meta-row client-identity-row">
              <div class="client-name-proto"><div class="client-name-main">${esc(c.name)} <span class="mono" style="font-size:11px;color:var(--text-3);font-weight:400;">#${c.id}</span></div>
              <span class="client-proto-badge ${proto}"><i data-lucide="${protoIcon}"></i>${(proto||'?').toUpperCase()}</span></div>
              <span class="badge count">${esc(c.inbound_name||'')}</span>
            </div>
            <div class="client-stats-mini">
              <div class="client-stat"><div class="lbl">Total</div><div class="val">${fmtB(tot)}</div></div>
              <div class="client-stat"><div class="lbl">↑ Subida</div><div class="val">${on?`<span class="client-stat-rate">${formatTrafficRate(s.up_rate)}</span>`:fmtB(up)}</div></div>
              <div class="client-stat"><div class="lbl">↓ Bajada</div><div class="val">${on?`<span class="client-stat-rate">${formatTrafficRate(s.down_rate)}</span>`:fmtB(down)}</div></div>
            </div>
            ${badges ? `<div class="client-badges" style="margin-top:6px">${badges}</div>` : ''}
          </div>
          <div class="client-actions">
            <div class="client-menu">
              <button type="button" class="client-menu-btn" onclick="toggleClientMenu(event, ${c.id})" title="Más"><i data-lucide="menu"></i></button>
              <div class="client-menu-drop" id="cl-menu-${c.id}">
                <button type="button" onclick="closeAllClientMenus();requestAnimationFrame(()=>openEditClient(${c.id}, ${c.inbound_id}))"><i data-lucide="pencil"></i> Editar</button>
                <button type="button" onclick="openShare(${c.id});closeAllClientMenus()"><i data-lucide="share"></i> Compartir</button>
                <button type="button" class="${en?'client-action-deactivate':'client-action-activate'}" onclick="toggleClient(${c.id});closeAllClientMenus()"><i data-lucide="${en ? 'power-off' : 'power'}"></i> ${en ? 'Desactivar' : 'Activar'}</button>
                <button type="button" class="danger" onclick="deleteClient(${c.id});closeAllClientMenus()"><i data-lucide="trash-2"></i> Eliminar</button>
              </div>
            </div>
          </div>
        </div>`;
    }).join('');
    renderIcons();
}
function closeAllClientMenus(){
    document.querySelectorAll('.client-row.menu-open,.server-card.menu-open,.webpage-card.menu-open').forEach(x=>x.classList.remove('menu-open'));
    document.querySelectorAll('.client-menu-drop').forEach(el=>{
        el.classList.remove('open');el.style.display='none';el.style.pointerEvents='';el.removeAttribute('aria-hidden');
        el.style.position='';el.style.top='';el.style.bottom='';el.style.left='';el.style.right='';el.style.maxWidth='';el.style.maxHeight='';el.style.overflowY='';el.style.visibility='';el.style.zIndex='';
        if(el._portalAnchor){try{el._portalAnchor.remove()}catch(_){}delete el._portalAnchor}
        delete el.dataset.portalMenu;
        if(el._portalButton)el._portalButton.setAttribute('aria-expanded','false');delete el._portalButton;
        const btn=el.parentElement&&el.parentElement.querySelector('.client-menu-btn');if(btn)btn.setAttribute('aria-expanded','false');
    });
}
function toggleClientMenu(ev,id,prefix='cl'){
    if(ev){ev.preventDefault();ev.stopPropagation()}
    const drop=document.getElementById((prefix==='sv'?'sv-menu-':'cl-menu-')+id),btn=ev&&(ev.currentTarget||(ev.target&&ev.target.closest&&ev.target.closest('.client-menu-btn')));
    if(!drop||!btn)return;
    const was=drop.classList.contains('open');closeAllClientMenus();if(typeof closeAllServerMenus==='function')closeAllServerMenus();if(was)return;
    const menu=btn.closest('.client-menu');if(!menu)return;
    menu.style.position='relative';drop._portalButton=btn;drop.style.display='block';drop.style.position='absolute';drop.style.right='0';drop.style.left='auto';drop.style.top='calc(100% + 6px)';drop.style.bottom='auto';drop.style.zIndex='200';drop.style.maxWidth='min(240px, calc(100vw - 24px))';drop.style.maxHeight='min(320px, calc(100dvh - 100px))';drop.style.overflowY='auto';drop.style.pointerEvents='auto';drop.style.visibility='visible';drop.setAttribute('aria-hidden','false');btn.setAttribute('aria-expanded','true');drop.classList.add('open');
    const card=btn.closest('.client-row,.server-card,.webpage-card');if(card){document.querySelectorAll('.client-row.menu-open,.server-card.menu-open,.webpage-card.menu-open').forEach(x=>x.classList.remove('menu-open'));card.classList.add('menu-open')}
}

window.addEventListener('resize',()=>{if(document.querySelector('.client-menu-drop.open'))closeAllClientMenus()},{passive:true});
document.addEventListener('click', function(ev){
  try {
    const t = ev.target;
    if (t && t.closest && (t.closest('.client-menu-btn') || t.closest('.client-menu-drop'))) return;
    closeAllClientMenus();
    if (typeof closeAllServerMenus==='function') closeAllServerMenus();
  } catch(e) {}
}, true);



function getRuleConditions(r){
  let conds = [];
  try {
    if (r.match_rules && String(r.match_rules).trim()) {
      const p = JSON.parse(r.match_rules);
      if (Array.isArray(p)) conds = p;
    }
  } catch(e){}
  if (!conds.length && r.match_type && r.value) {
    conds = [{ type: r.match_type === 'auto' ? 'domain' : r.match_type, value: r.value }];
  }
  return conds;
}

function renderRules(){ const list = document.getElementById('rulesList'); if (!list) return; const desc = document.getElementById('rulesDesc'); if (desc) desc.textContent = routingRules.length > 0 ? `${routingRules.length} regla${routingRules.length > 1 ? 's' : ''}` : 'Enrutamiento por dominio/IP'; if (!routingRules.length) { list.innerHTML = '<div class="empty" style="padding:30px 12px;min-height:auto;"><i data-lucide="list"></i><div class="empty-text" style="margin-bottom:0;">Sin reglas</div></div>'; renderIcons(); return; } const outs = { block:'Bloquear', direct:'Directo', warp:'WARP', proxy:'WARP' };
    const icons = { block:'ban', direct:'route', warp:'cloud', proxy:'cloud' };
    list.innerHTML = routingRules.map(r => {
        const on = r.enabled == 1;
        const conds = getRuleConditions(r);
        const condChips = conds.map(c => `<span class="rule-cond">${esc(c.type)}: ${esc(String(Array.isArray(c.value) ? c.value.join(',') : (c.value||'')).slice(0,30))}</span>`).join('');
        let o = r.outbound || 'direct'; if (o === 'proxy') o = 'warp';
        const badgeCls = o === 'block' ? 'danger' : o === 'direct' ? 'on' : 'warp';
        const ic = icons[r.outbound] || icons[o] || 'list';
        return `<div class="rule-card out-${o} ${on ? '' : 'disabled'}" >
          <div class="rule-icon ${o}"><i data-lucide="${ic}"></i></div>
          <div class="rule-info"><div class="rule-name">${esc(r.name)}</div><div class="rule-conds">${condChips}</div></div>
          <span class="badge ${badgeCls}">${outs[r.outbound] || o}</span>
          <div class="rule-actions">
            <button class="btn btn-ghost btn-icon" onclick="openRuleModal(${r.id})"><i data-lucide="edit-2"></i></button>
            <button class="btn btn-ghost btn-icon" onclick="toggleRule(${r.id})"><i data-lucide="power"></i></button>
            <button class="btn btn-ghost btn-icon" style="color:var(--danger);" onclick="deleteRule(${r.id})"><i data-lucide="trash-2"></i></button>
          </div>
        </div>`;
    }).join('');
    renderIcons();
}


let routingLoadInFlight=null;
async function loadRouting(){
  if(routingLoadInFlight)return routingLoadInFlight;
  routingLoadInFlight=(async()=>{try{
    let response,data,lastError;for(let attempt=0;attempt<4;attempt++){try{response=await fetch('/api/routing',{signal:AbortSignal.timeout(12000),cache:'no-store'});data=await response.json();if(response.ok&&data.ok)break;lastError=new Error(data.error||`HTTP ${response.status}`)}catch(e){lastError=e}if(attempt<3)await new Promise(r=>setTimeout(r,350*(attempt+1)))}
    if(!response||!response.ok||!data||!data.ok)throw lastError||new Error('Sin respuesta del panel');const d=data;
    routingSettings = d.settings || {};
    routingRules = d.rules || [];
    if (typeof renderToggles === 'function') renderToggles();
    renderRules();
    selectedIpType = routingSettings.ip_type || 'dual';
    if (typeof renderIpType === 'function') renderIpType();
    const el = id => document.getElementById(id);
    if (el('dnsPrimary')) el('dnsPrimary').value = routingSettings.dns_primary || '1.1.1.1';
    if (el('dnsSecondary')) el('dnsSecondary').value = routingSettings.dns_secondary || '8.8.8.8';
    if (el('dnsPrimaryV6')) el('dnsPrimaryV6').value = routingSettings.dns_primary_v6 || '';
    if (el('dnsSecondaryV6')) el('dnsSecondaryV6').value = routingSettings.dns_secondary_v6 || '';
    if (el('domainStrategy')) el('domainStrategy').value = routingSettings.domain_strategy || 'IPIfNonMatch';
    if (el('swFakeDns')) el('swFakeDns').classList.toggle('on', routingSettings.fake_dns == 1);
  }catch(e){const list=document.getElementById('rulesList');if(list){const hadRules=Array.isArray(routingRules)&&routingRules.length>0;if(!hadRules)list.innerHTML='<div class="empty" style="padding:24px 12px;min-height:auto"><div class="empty-title">Conexión interrumpida</div><div class="empty-text">No se pudo actualizar la lista. Tus reglas guardadas no se han borrado.</div><button class="btn btn-secondary" onclick="loadRouting()">Reintentar</button></div>';else{let note=document.getElementById('routingLoadNote');if(!note){note=document.createElement('div');note.id='routingLoadNote';note.className='field-hint';list.parentElement.insertBefore(note,list)}note.textContent='No se pudo actualizar ahora; se mantienen visibles las reglas existentes. Reintenta cuando vuelva la conexión.';setTimeout(()=>{const n=document.getElementById('routingLoadNote');if(n)n.remove()},7000)}}}finally{routingLoadInFlight=null}})();return routingLoadInFlight;
}
async function pushRoutingSettings(o){
  if (!o || !Object.keys(o).length) return { ok: true };
  const matchesSaved=async()=>{try{const r=await fetch('/api/routing',{signal:AbortSignal.timeout(12000),cache:'no-store'}),state=await r.json(),saved=state.settings||{};return r.ok&&state.ok&&state.applied===true&&Object.entries(o).every(([k,v])=>String(saved[k])===String(typeof v==='boolean'?Number(v):v))?{ok:true,recovered:true,systemDns:{mode:'unchanged'}}:null}catch(e){return null}};
  for(let attempt=0;attempt<2;attempt++){
    try{const r=await fetch('/api/routing/settings',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(o),signal:AbortSignal.timeout(180000)}),d=await r.json();if(r.ok&&d.ok)return d;if(!r.ok&&r.status<500)return {ok:false,error:d.error||`Error HTTP ${r.status}`,...d};return {ok:false,error:d.error||`Error HTTP ${r.status}`,...d}}
    catch(e){const confirmed=await matchesSaved();if(confirmed)return confirmed;if(attempt===0)await new Promise(r=>setTimeout(r,800))}
  }
  const confirmed=await matchesSaved();if(confirmed)return confirmed;
  return {ok:false,error:'No se confirmó que Xray aplicara el tipo de red. Se conserva la selección anterior; revisa el estado y los registros de Xray antes de reintentar.'};
}
function renderIpType(){
  document.querySelectorAll('.ip-card').forEach(c => c.classList.toggle('active', c.dataset.ip === selectedIpType));
}
let ipTypeChangeInFlight=false;
async function selectIpType(t){if(!['ipv4','ipv6','dual'].includes(t)||ipTypeChangeInFlight)return;const prev=selectedIpType;if(t===prev&&String(routingSettings.ip_type||'dual')===t)return;ipTypeChangeInFlight=true;selectedIpType=t;renderIpType();document.querySelectorAll('.ip-card').forEach(c=>{c.classList.add('applying');c.setAttribute('aria-disabled','true')});const labels={ipv4:'Solo IPv4',ipv6:'Solo IPv6',dual:'Dual: IPv4 primero con respaldo IPv6'};toast('Aplicando '+labels[t]+'; espera la confirmación de Xray…','info',30000);try{const d=await pushRoutingSettings({ip_type:t});if(!d.ok)throw new Error(d.error||'No se pudo aplicar el tipo de red');routingSettings.ip_type=t;selectedIpType=t;renderIpType();toast(d.warning?'Tipo de red aplicado a Xray; revisa DNS del VPS: '+d.warning:'Tipo de red aplicado y confirmado: '+labels[t],'success',7000);if(typeof updateSystemInfo==='function')updateSystemInfo()}catch(e){selectedIpType=prev;renderIpType();toast(e.message||'No se pudo confirmar el tipo de red; se restauró la selección anterior','error',7000)}finally{ipTypeChangeInFlight=false;document.querySelectorAll('.ip-card').forEach(c=>{c.classList.remove('applying');c.removeAttribute('aria-disabled')})}}
async function setDnsPreset(name){
  const map = {
    cloudflare: ['1.1.1.1','1.0.0.1','2606:4700:4700::1111','2606:4700:4700::1001'],
    google: ['8.8.8.8','8.8.4.4','2001:4860:4860::8888','2001:4860:4860::8844'],
    adguard: ['94.140.14.14','94.140.15.15','2a10:50c0::ad1:ff','2a10:50c0::ad2:ff'],
    quad9: ['9.9.9.9','149.112.112.112','2620:fe::fe','2620:fe::9'],
    opendns: ['208.67.222.222','208.67.220.220','2620:119:35::35','2620:119:53::53']
  };
  const v = map[name]; if (!v) return;
  const a = document.getElementById('dnsPrimary');
  const b = document.getElementById('dnsSecondary');
  const c = document.getElementById('dnsPrimaryV6');
  const d6 = document.getElementById('dnsSecondaryV6');
  if (a) a.value = v[0];
  if (b) b.value = v[1];
  if (c) c.value = v[2] || '';
  if (d6) d6.value = v[3] || '';
  document.querySelectorAll('.dns-preset').forEach(el => el.classList.toggle('on', el.dataset.dns === name));
  await autoSaveDns();
}


async function applyDnsPreset(name){
  const map = {
    cloudflare: ['1.1.1.1','1.0.0.1','2606:4700:4700::1111','2606:4700:4700::1001'],
    google: ['8.8.8.8','8.8.4.4','2001:4860:4860::8888','2001:4860:4860::8844'],
    adguard: ['94.140.14.14','94.140.15.15','2a10:50c0::ad1:ff','2a10:50c0::ad2:ff'],
    quad9: ['9.9.9.9','149.112.112.112','2620:fe::fe','2620:fe::9'],
    opendns: ['208.67.222.222','208.67.220.220','2620:119:35::35','2620:119:53::53']
  };
  const v = map[name]; if (!v) return;
  const el = id => document.getElementById(id);
  if (el('dnsPrimary')) el('dnsPrimary').value = v[0];
  if (el('dnsSecondary')) el('dnsSecondary').value = v[1];
  if (el('dnsPrimaryV6')) el('dnsPrimaryV6').value = v[2] || '';
  if (el('dnsSecondaryV6')) el('dnsSecondaryV6').value = v[3] || '';
  document.querySelectorAll('.dns-chip').forEach(c => c.classList.toggle('on', c.dataset.dns === name));
  await autoSaveDns();
  renderIcons();
}

function showDnsSave(){ const b=document.getElementById('btnSaveDns'); if(b) b.style.display='block'; }
function renderToggles(){
  const keys = ['block_ads','block_youtube_ads','block_trackers','block_adult','block_malware','prevent_captcha','block_bittorrent'];
  let ac = 0;
  for (const k of keys) {
    const el = document.querySelector('[data-filter="'+k+'"]');
    if (el) el.classList.toggle('on', routingSettings[k] == 1);
    if (routingSettings[k] == 1) ac++;
  }
  const fake=document.getElementById('swFakeDns');if(fake)fake.classList.toggle('on',routingSettings.fake_dns==1);
  const desc = document.getElementById('filtersDesc');
  if (desc) desc.textContent = ac > 0 ? (ac + ' filtro' + (ac>1?'s':'') + ' activo' + (ac>1?'s':'')) : 'Publicidad, rastreadores, malware';
  const w = document.getElementById('swWarp');
  if (w) {
    const a = routingSettings.warp_enabled == 1;
    w.classList.toggle('on', a);
    const dot = document.getElementById('warpDot');
    const txt = document.getElementById('warpStatusText');
    if (dot) dot.className = 'dot ' + (a ? 'on' : '');
    if (txt) { txt.textContent = a ? 'ACTIVO' : 'Inactivo'; txt.style.color = a ? 'var(--warp)' : ''; }
  }
}
async function toggleBlock(k){const el=document.querySelector('[data-filter="'+k+'"]'),prev=routingSettings[k],nv=Number(prev)===1?0:1;routingSettings[k]=nv;renderToggles();if(el)el.disabled=true;try{const d=await pushRoutingSettings({[k]:nv===1});if(!d.ok){routingSettings[k]=prev;renderToggles();toast(d.error||'No se pudo aplicar el filtro','error',5000);return}toast(nv?'Filtro activado':'Filtro desactivado','success')}finally{if(el)el.disabled=false}}
async function toggleWarp(){const btn=document.getElementById('swWarp'),prev=routingSettings.warp_enabled,nv=Number(prev)===1?0:1;routingSettings.warp_enabled=nv;renderToggles();if(btn)btn.disabled=true;try{const d=await pushRoutingSettings({warp_enabled:nv===1});if(!d.ok){routingSettings.warp_enabled=prev;renderToggles();toast(d.error||'No se pudo actualizar WARP','error',5000);return}if(d.warp_enabled===0&&nv===1){routingSettings.warp_enabled=0;renderToggles();toast('WARP no está disponible; no se cambió la ruta y el tráfico sigue directo','warning',5000);return}routingSettings.warp_enabled=nv;renderToggles();toast(nv?'WARP global activado: todo el tráfico de Internet sale por WARP':'WARP global desactivado: el tráfico usa salida directa','success',5000)}finally{if(btn)btn.disabled=false}}
async function toggleFakeDns(){const el=document.getElementById('swFakeDns'),prev=routingSettings.fake_dns,nv=Number(prev)===1?0:1;routingSettings.fake_dns=nv;if(el)el.classList.toggle('on',nv===1);if(el)el.disabled=true;try{const d=await pushRoutingSettings({fake_dns:nv===1});if(!d.ok){routingSettings.fake_dns=prev;if(el)el.classList.toggle('on',Number(prev)===1);toast(d.error||'No se pudo actualizar Fake DNS','error',5000);return}if(el)el.classList.toggle('on',nv===1);toast(nv?'Fake DNS activado':'Fake DNS desactivado','success')}finally{if(el)el.disabled=false}}
async function restartWarp(){toast('Validando y reaplicando la ruta WARP de Xray…','info',3000);try{const r=await fetch('/api/restart-xray',{method:'POST'}),d=await r.json();if(!r.ok||!d.ok)throw new Error(d.error||'No se pudo aplicar');toast('Ruta WARP reaplicada','success',4000)}catch(e){toast(e.message||'No se pudo reaplicar WARP','error',6000)}}

async function autoSaveDns(){
  const p4=(document.getElementById('dnsPrimary')?.value||'').trim();if(!p4&&selectedIpType!=='ipv6'){toast('DNS IPv4 primario requerido','warning');return}
  const btn=document.getElementById('btnSaveDns');if(btn){btn.disabled=true;btn.dataset.prev=btn.innerHTML;btn.innerHTML='<i data-lucide="loader-circle"></i> Aplicando DNS…'}
  try{const d=await pushRoutingSettings({dns_primary:p4||'1.1.1.1',dns_secondary:(document.getElementById('dnsSecondary')?.value||'').trim(),dns_primary_v6:(document.getElementById('dnsPrimaryV6')?.value||'').trim()||'2606:4700:4700::1111',dns_secondary_v6:(document.getElementById('dnsSecondaryV6')?.value||'').trim()||'2001:4860:4860::8888'});
    if(d.ok){routingSettings={...routingSettings,dns_primary:p4,dns_secondary:(document.getElementById('dnsSecondary')?.value||'').trim(),dns_primary_v6:(document.getElementById('dnsPrimaryV6')?.value||'').trim(),dns_secondary_v6:(document.getElementById('dnsSecondaryV6')?.value||'').trim()};toast(d.systemDns&&d.systemDns.mode==='managed-external'?'DNS aplicado en Xray; el DNS del VPS se conserva porque lo gestiona otro servicio':d.systemDns&&d.systemDns.ok===false?'DNS de Xray aplicado; falló el DNS del VPS: '+(d.warning||'revisa los logs'):d.recovered?'Cambios DNS confirmados al reconectar':'DNS aplicado y comprobado',d.systemDns&&d.systemDns.ok===false?'warning':'success',7000);if(btn)btn.style.display='none'}else toast(d.error||'No se pudo aplicar el DNS','error',7000)
  }finally{if(btn){btn.disabled=false;if(btn.dataset.prev){btn.innerHTML=btn.dataset.prev;delete btn.dataset.prev}renderIcons()}}
}
async function saveDomainStrategy(){
  const v=document.getElementById('domainStrategy').value,prev=routingSettings.domain_strategy;routingSettings.domain_strategy=v;const d=await pushRoutingSettings({domain_strategy:v});if(d.ok)toast('Estrategia de enrutamiento aplicada','success');else{routingSettings.domain_strategy=prev;document.getElementById('domainStrategy').value=prev||'IPIfNonMatch';toast(d.error||'No se pudo aplicar la estrategia','error',5000)}
}

function addCondition(type, value){ currentConditions.push({ type: type || 'domain', value: value !== undefined ? value : '' }); renderConditions(); }
function removeCondition(i){ currentConditions.splice(i, 1); renderConditions(); }
function updateCondition(i, key, v){ if (!currentConditions[i]) return; if (key === 'type') { currentConditions[i].type = v; currentConditions[i].value = (v === 'protocol') ? [] : ''; renderConditions(); } else { currentConditions[i][key] = v; } }
function updateProtocolSelection(i, el){
    if (!currentConditions[i]) return;
    const container = document.getElementById('protocol-checkboxes-' + i);
    if (!container) return;
    const items = container.querySelectorAll('.protocol-item');
    const checked = [];
    items.forEach(item => { const cb = item.querySelector('input[type=checkbox]'); if (cb && cb.checked) { checked.push(cb.value); item.classList.add('on'); } else item.classList.remove('on'); });
    currentConditions[i].value = checked;
}
function renderConditions(){
    const c = document.getElementById('conditionsList');
    if (!currentConditions.length) { c.innerHTML = '<div style="padding:12px;text-align:center;color:var(--text-3);font-size:12px;background:var(--surface-2);border-radius:10px;">Sin condiciones</div>'; return; }
    const types = [['domain','Dominio'],['geosite','Geosite'],['geoip','GeoIP'],['ip','IP/CIDR'],['port','Puerto'],['protocol','Protocolo']];
    const protocolOptions = ['http', 'tls', 'quic', 'bittorrent'];
    c.innerHTML = currentConditions.map((cond, i) => {
        let valueInput = '';
        if (cond.type === 'protocol') {
            const selected = Array.isArray(cond.value) ? cond.value : (cond.value ? String(cond.value).split(',').filter(Boolean) : []);
            valueInput = `<div id="protocol-checkboxes-${i}" class="protocol-list">${protocolOptions.map(p => `<label class="protocol-item ${selected.includes(p) ? 'on' : ''}"><input type="checkbox" value="${p}" ${selected.includes(p) ? 'checked' : ''} style="display:none" onchange="updateProtocolSelection(${i}, this)"><span>${p}</span></label>`).join('')}</div>`;
        } else {
            valueInput = `<input type="text" value="${esc(cond.value || '')}" oninput="updateCondition(${i}, 'value', this.value)" placeholder="Valor" style="width:100%;background:var(--bg);border:1px solid var(--border);color:var(--text);padding:8px 10px;border-radius:9px;font-size:12.5px;">`;
        }
        return `<div style="background:var(--surface-2);padding:10px;border-radius:10px;margin-bottom:6px;"><div style="display:flex;gap:6px;margin-bottom:6px;"><select onchange="updateCondition(${i}, 'type', this.value)" style="flex:1;background:var(--bg);border:1px solid var(--border);color:var(--text);padding:8px 10px;border-radius:9px;font-size:12px;">${types.map(([v,l]) => `<option value="${v}" ${v === cond.type ? 'selected' : ''}>${l}</option>`).join('')}</select><button class="btn btn-ghost btn-icon" style="color:var(--danger);" onclick="removeCondition(${i})"><i data-lucide="x"></i></button></div>${valueInput}</div>`;
    }).join('');
    renderIcons();
}
function openRuleModal(id){ editingRuleId = id || null; currentConditions = []; if (id) { const r = routingRules.find(x => Number(x.id) === Number(id)); if (!r) {toast('No se encontró la regla. Actualiza la lista e intenta otra vez.','error');return;} document.getElementById('rmTitle').textContent = 'Editar regla'; document.getElementById('r-id').value = r.id; document.getElementById('r-name').value = r.name; currentConditions = getRuleConditions(r); let o = r.outbound || 'direct'; if (o === 'proxy') o = 'warp'; document.getElementById('r-out').value = o; } else { document.getElementById('rmTitle').textContent = 'Nueva regla'; document.getElementById('r-id').value = ''; document.getElementById('r-name').value = ''; currentConditions = [{ type: 'domain', value: '' }]; document.getElementById('r-out').value = 'direct'; } renderConditions(); document.getElementById('ruleModal').classList.add('on'); lockModalBody(); renderIcons(); }
function closeRuleModal(){ document.getElementById('ruleModal').classList.remove('on'); syncModalLock(); }
async function saveRule(){if(savingRule)return;savingRule=true;const btn=document.getElementById('ruleSaveBtn'),name=document.getElementById('r-name').value.trim(),out=document.getElementById('r-out').value,valid=currentConditions.filter(c=>c.type==='protocol'?Array.isArray(c.value)&&c.value.length>0:c.value&&String(c.value).trim());if(!name||!valid.length){toast('Completa nombre y condición','warning');savingRule=false;return}const wasEdit=editingRuleId;btn.disabled=true;try{const url=wasEdit?'/api/routing/rules/'+wasEdit:'/api/routing/rules',firstVal=valid[0].value,valueStr=Array.isArray(firstVal)?firstVal.join(','):firstVal,r=await fetch(url,{method:wasEdit?'PUT':'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name,outbound:out,match_type:valid[0].type,value:valueStr,match_rules:JSON.stringify(valid)})}),d=await r.json();if(!r.ok||!d.ok)throw new Error(d.error||`Error HTTP ${r.status}`);if(d.rule){const idx=routingRules.findIndex(x=>Number(x.id)===Number(d.rule.id));if(idx>=0)routingRules[idx]=d.rule;else routingRules.unshift(d.rule);renderRules()}closeRuleModal();toast(wasEdit?'Regla aplicada y actualizada':'Regla aplicada y creada','success',4000)}catch(e){toast(e.message||'No se pudo aplicar la regla; conserva la configuración anterior','warning',6000)}finally{savingRule=false;btn.disabled=false}}

async function exportRules(){
  try {
    if (!routingRules || !routingRules.length) return toast('No hay reglas', 'warning');
    const selected = await pickRulesToExport();
    if (!selected || !selected.length) return;
    const blob = new Blob([JSON.stringify({ rules: selected, exportedAt: new Date().toISOString() }, null, 2)], { type: 'application/json' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'gzmnet-rules-' + Date.now() + '.json';
    a.click();
    toast('Exportadas: ' + selected.length, 'success');
  } catch(e){ toast('Error','error'); }
}
function pickRulesToExport(){
  return new Promise((resolve) => {
    const wrap = document.createElement('div');
    wrap.className = 'modal on';
    wrap.style.zIndex = '9200';
    wrap.innerHTML = '<div class="modal-box" style="max-width:420px"><div class="modal-head"><div class="modal-title">Exportar reglas</div><div class="modal-head-actions"><button class="btn btn-primary btn-sm" id="expOk">Exportar</button><button class="modal-close" id="expClose" aria-label="Cerrar"><i data-lucide="x"></i></button></div></div><div class="modal-body" id="expList"></div></div>';
    document.body.appendChild(wrap);
    lockModalBody();
    const list = wrap.querySelector('#expList');
    list.innerHTML = routingRules.map(r => '<label style="display:flex;align-items:center;gap:10px;padding:10px;border-bottom:1px solid var(--border);cursor:pointer"><input type="checkbox" checked data-id="'+r.id+'" style="width:16px;height:16px"><span style="flex:1">'+esc(r.name)+'</span><span class="badge count">'+(r.outbound||'')+'</span></label>').join('');
    if (window.lucide) try{lucide.createIcons();}catch(e){}
    const done = (val) => { wrap.remove(); syncModalLock(); resolve(val); };
    wrap.querySelector('#expClose').onclick = () => done(null);
    wrap.querySelector('#expOk').onclick = () => {
      const ids = new Set([...list.querySelectorAll('input:checked')].map(c => Number(c.dataset.id)));
      done(routingRules.filter(r => ids.has(r.id)).map(r => ({ name:r.name, match_type:r.match_type, value:r.value, outbound:r.outbound, enabled:r.enabled, priority:r.priority, match_rules:r.match_rules })));
    };
  });
}
async function importRules(ev){
  const file = ev && ev.target && ev.target.files && ev.target.files[0];
  if (!file) return;
  try {
    const text = await file.text();
    const data = JSON.parse(text);
    const rules = data.rules || data;
    if (!Array.isArray(rules)) { toast('JSON inválido','error'); return; }
    if (!confirm('Importar ' + rules.length + ' regla(s)?')) { ev.target.value=''; return; }
    const r = await fetch('/api/routing/rules/import', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ rules }) });
    const d = await r.json();
    if(d.ok){if(Array.isArray(d.rules)){const seen=new Set(routingRules.map(x=>Number(x.id)));routingRules=[...d.rules.filter(x=>x&&!seen.has(Number(x.id))),...routingRules];renderRules()}toast('Aplicadas: '+(d.imported||0),'success')}
    else toast(d.error||'No se pudieron aplicar las reglas; se conservó el estado anterior','warning',6000);
  } catch(e){ toast('Archivo inválido','error'); }
  ev.target.value = '';
}

async function toggleRule(id){const idx=routingRules.findIndex(r=>Number(r.id)===Number(id));if(idx<0)return;const prev=routingRules[idx].enabled;routingRules[idx].enabled=prev?0:1;renderRules();try{const r=await fetch('/api/routing/rules/'+id+'/toggle',{method:'PATCH'}),d=await r.json();if(!r.ok||!d.ok)throw new Error(d.error||'El cambio no se pudo confirmar');routingRules[idx].enabled=d.enabled?1:0;renderRules();toast('Regla aplicada sin reiniciar la VPN','success',3500)}catch(e){routingRules[idx].enabled=prev;renderRules();toast(e.message||'No se pudo aplicar la regla; se mantuvo el estado anterior','warning',6000)}}
async function deleteRule(id){if(!confirm('¿Eliminar esta regla?'))return;try{const r=await fetch('/api/routing/rules/'+id,{method:'DELETE'}),d=await r.json();if(!r.ok||!d.ok)throw new Error(d.error||'No se pudo aplicar el cambio');routingRules=routingRules.filter(x=>Number(x.id)!==Number(id));renderRules();toast('Regla eliminada y aplicada','success',3500)}catch(e){toast(e.message||'No se pudo eliminar; se conservó la regla anterior','warning',6000)}}

function genUuidClient() {
    if (window.crypto && crypto.randomUUID) { try { return crypto.randomUUID(); } catch(e){} }
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => { const r = Math.random() * 16 | 0; return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16); });
}
function genShortTokenClient(len) {
    const chars = 'abcdefghjkmnpqrstuvwxyz23456789';
    let t = '';
    try { const bytes = crypto.getRandomValues(new Uint8Array(len || 8)); for (let i = 0; i < (len || 8); i++) t += chars[bytes[i] % chars.length]; }
    catch(e) { for (let i = 0; i < (len || 8); i++) t += chars[Math.floor(Math.random() * chars.length)]; }
    return t;
}
function genPassClient(len) {
    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
    let s = '';
    try { const bytes = crypto.getRandomValues(new Uint8Array(len || 16)); for (let i = 0; i < (len || 16); i++) s += chars[bytes[i] % chars.length]; }
    catch(e) { for (let i = 0; i < (len || 16); i++) s += chars[Math.floor(Math.random() * chars.length)]; }
    return s;
}
function fillInbSelect(selVal){ const s = document.getElementById('cl-inbound'); s.innerHTML = '<option value="">Selecciona...</option>' + inbounds.map(ib => `<option value="${ib.id}">${esc(ib.name)} (${ib.protocol.toUpperCase()}:${ib.port})</option>`).join(''); if (selVal) s.value = selVal; }
function currentInboundProtocol(){ const id = parseInt(document.getElementById('cl-inbound').value) || (editingClientInbound || 0); const ib = inbounds.find(x => x.id === id); return ib ? ib.protocol : 'vless'; }
function protocolUsesAuthFrontend(proto) { return ['socks','http'].includes(proto); }
function protocolHasUuidFrontend(proto) { return ['vless','vmess','trojan','shadowsocks'].includes(proto); }
function credentialTypeFrontend(proto) {
    if (['socks','http'].includes(proto)) return 'auth';
    if (['vless','vmess'].includes(proto)) return 'uuid';
    if (['trojan','shadowsocks'].includes(proto)) return 'password';
    return 'unknown';
}
function updateClientFieldsForProtocol(proto) {
    const needsCred = protocolHasUuidFrontend(proto);
    const needsAuth = protocolUsesAuthFrontend(proto);
    document.getElementById('cl-field-cred').style.display = needsCred ? 'block' : 'none';
    document.getElementById('cl-field-auth').style.display = needsAuth ? 'block' : 'none';
    document.getElementById('cl-field-token').style.display = needsCred ? 'block' : 'none';
    document.getElementById('cl-field-devicelimit').style.display = needsCred ? 'block' : 'none';
}
function generateClientCredentials(proto) {
    if (protocolUsesAuthFrontend(proto)) {
        document.getElementById('cl-auth-user').value = 'user_' + genShortTokenClient(6);
        document.getElementById('cl-auth-pass').value = genPassClient(16);
        document.getElementById('cl-cred').value = '';
        document.getElementById('cl-token').value = '';
    } else {
        if (proto === 'trojan' || proto === 'shadowsocks') document.getElementById('cl-cred').value = genPassClient(24);
        else document.getElementById('cl-cred').value = genUuidClient();
        document.getElementById('cl-token').value = genShortTokenClient(8);
        document.getElementById('cl-auth-user').value = '';
        document.getElementById('cl-auth-pass').value = '';
    }
}
async function regenCred(){ const proto = currentInboundProtocol(); const el = document.getElementById('cl-cred'); if (proto === 'trojan' || proto === 'shadowsocks') { el.value = genPassClient(24); toast('Regenerada', 'success'); } else { el.value = genUuidClient(); toast('Regenerada', 'success'); } }
async function regenAuthPass(){ document.getElementById('cl-auth-pass').value = genPassClient(16); toast('Regenerada', 'success'); }

function onClientInboundChange(){
    const newId = parseInt(document.getElementById('cl-inbound').value);
    const newIb = inbounds.find(x => x.id === newId);
    if (!newIb) return;
    const newProto = newIb.protocol;
    updateClientFieldsForProtocol(newProto);setClientRoutingUi({routing_enabled:document.getElementById('swClientRouting').classList.contains('on'),routing_filters_enabled:document.getElementById('swClientFilters').classList.contains('on'),custom_routing_enabled:document.getElementById('swClientCustomRules').classList.contains('on')},newProto);

    if (editingClientId && editingClientOriginalInbound) {
        const oldIb = inbounds.find(x => x.id === editingClientOriginalInbound);
        if (oldIb) {
            const oldType = credentialTypeFrontend(oldIb.protocol);
            const newType = credentialTypeFrontend(newProto);
            if (oldType !== newType) {
                generateClientCredentials(newProto);
                toast('Credenciales regeneradas por cambio de protocolo', 'info', 3000);
            } else if (newType !== 'auth' && !document.getElementById('cl-token').value) {
                document.getElementById('cl-token').value = genShortTokenClient(8);
            }
        }
    } else if (!editingClientId) {
        generateClientCredentials(newProto);
    }
}
function openNewClient(inbId){
    editingClientId = null; editingClientInbound = inbId || null; editingClientOriginalInbound = null; fillInbSelect(inbId);
    const el = id => document.getElementById(id);
    el('cl-id').value = ''; el('cl-name').value = ''; el('cl-email').value = 'c' + Date.now(); el('cl-limit').value = '0'; el('cl-device-limit').value = '0';el('cl-expiry-date').value='';el('cl-expiry-time').value='23:59';setExpiryUi(false,'');document.getElementById('cl-expiry-details').open=false;document.getElementById('cl-device-details').open=false;document.getElementById('cl-pay-details').open=false;document.getElementById('cl-advanced-details').open=false;document.getElementById('cl-pay-summary').textContent='Configura avisos automáticos';
    el('cl-pay-date').value = ''; el('cl-pay-freq').value = '0'; el('cl-pay-time').value = '09:00'; el('cl-tg-chat').value = '';
    document.getElementById('swPay').classList.remove('on'); document.getElementById('swPay').setAttribute('aria-pressed','false'); document.getElementById('paySection').style.display = 'none';
    el('cl-stats-sec').style.display = 'none'; el('cl-test-push-sec').style.display = 'none';
    document.getElementById('cl-devices-section').style.display = 'none';
    el('cmTitle').textContent = 'Nuevo cliente'; el('cmSubtitle').textContent = 'Agrega usuario'; el('clSaveTxt').textContent = 'Crear';
    const ib = inbounds.find(x => Number(x.id) === Number(inbId));
    const proto = ib ? ib.protocol : 'vless';
    updateClientFieldsForProtocol(proto);setClientRoutingUi({},proto);
    generateClientCredentials(proto);
    document.getElementById('clientModal').classList.add('on'); lockModalBody(); renderIcons();
}
function openEditClient(cid, iid){
    let cl = null;
    if (iid) cl = (clientsByInbound[iid] || []).find(c => Number(c.id) === Number(cid));
    if (!cl) cl = allClients.find(c => Number(c.id) === Number(cid));
    if (!cl) { toast('No encontrado', 'error'); return; }
    if (!iid) iid = cl.inbound_id;
    editingClientId = cid; editingClientInbound = iid; editingClientOriginalInbound = iid; fillInbSelect(iid);
    const el = id => document.getElementById(id);
    el('cl-id').value=cl.id;el('cl-name').value=cl.name;el('cl-email').value=cl.email||'c'+cl.id;el('cl-limit').value=cl.limit_gb||0;const deviceLimitEl=el('cl-device-limit');if(deviceLimitEl)deviceLimitEl.value=cl.device_limit||0;el('cl-expiry-date').value=cl.expiry_date||'';el('cl-expiry-time').value=cl.expiry_time||'23:59';setExpiryUi(Number(cl.expiry_enabled)===1,cl.expiry_date||'');document.getElementById('cl-expiry-details').open=false;document.getElementById('cl-device-details').open=false;document.getElementById('cl-advanced-details').open=false;
    el('cl-cred').value = cl.uuid || ''; el('cl-token').value = cl.sub_token || '';
    el('cl-auth-user').value = cl.auth_user || ''; el('cl-auth-pass').value = cl.auth_pass || '';
    el('cl-pay-date').value=cl.payment_date||'';el('cl-pay-freq').value=cl.payment_frequency||'0';el('cl-pay-time').value=cl.payment_time||'09:00';el('cl-tg-chat').value=cl.telegram_chat_id||'';const payMsgEl=el('cl-pay-message');if(payMsgEl)payMsgEl.value=cl.payment_message||'';
    document.getElementById('swPay').classList.toggle('on', cl.payment_enabled == 1); document.getElementById('swPay').setAttribute('aria-pressed',cl.payment_enabled==1?'true':'false');
    document.getElementById('paySection').style.display = cl.payment_enabled == 1 ? 'block' : 'none';document.getElementById('cl-pay-details').open=cl.payment_enabled==1;document.getElementById('cl-pay-summary').textContent=cl.payment_enabled==1?'Recordatorios activos':'Configura avisos automáticos';
    const ib = inbounds.find(x => Number(x.id) === Number(iid));
    const proto = ib ? ib.protocol : 'vless';
    updateClientFieldsForProtocol(proto);setClientRoutingUi(cl,proto);
    const st = vpnStats.find(v => v.id === cid) || {},hasLimit=Number(cl.limit_gb)>0;
    el('cl-up').textContent = fmtB(hasLimit?(st.quota_up??cl.quota_up_bytes):(st.up??cl.up_bytes)||0); el('cl-down').textContent = fmtB(hasLimit?(st.quota_down??cl.quota_down_bytes):(st.down??cl.down_bytes)||0); el('cl-total').textContent = fmtB(hasLimit?(st.quota_used??cl.quota_used_bytes):(st.total??cl.total_bytes)||0);
    el('cl-lastseen').textContent=cl.last_seen?fmtLastSeenExact(cl.last_seen):'Sin conexión registrada'; const lastSeenRow = el('cl-lastseen-row'); if (lastSeenRow) lastSeenRow.style.display = (cl.enabled == 1 && st.connected) ? 'none' : 'flex';
    const en = cl.enabled == 1, on = en && st.connected;
    const statusEl = el('cl-status');
    if (!en) { statusEl.textContent = 'Desactivado'; statusEl.style.color = 'var(--text-3)'; }
    else if (on) { statusEl.textContent = 'En línea'; statusEl.style.color = 'var(--success)'; }
    else { statusEl.textContent = 'Desconectado'; statusEl.style.color = 'var(--text-3)'; }
    el('cl-stats-sec').style.display = 'block';
    el('cl-test-push-sec').style.display = protocolUsesAuthFrontend(proto) ? 'none' : 'block';
    el('cmTitle').textContent = 'Editar cliente'; el('cmSubtitle').textContent = 'Modifica los datos'; el('clSaveTxt').textContent = 'Guardar';
    document.getElementById('clientModal').classList.add('on'); lockModalBody(); renderIcons();
    if (protocolHasUuidFrontend(proto)) loadClientDevices(cid);
    else document.getElementById('cl-devices-section').style.display = 'none';
}

async function loadClientDevices(cid) {
    if (!cid) return;
    try {
        const r = await fetch('/api/clients/' + cid + '/devices');
        const d = await r.json();
        const section = document.getElementById('cl-devices-section');
        const list = document.getElementById('cl-devices-list');
        if (!section || !list) return;
        section.style.display = 'block';
        if (!d.ok || !d.devices || !d.devices.length) {
            list.innerHTML = '<div style="padding:14px;text-align:center;color:var(--text-3);font-size:12px;background:var(--bg);border-radius:10px;">Sin dispositivos registrados</div>';
            return;
        }
        list.innerHTML = d.devices.map(dev => `<div class="device-row"><div class="device-icon"><i data-lucide="smartphone"></i></div><div class="device-info"><div class="device-name">${esc(dev.app_name||'App VPN no identificada')} · ${esc(dev.display_name||'Dispositivo')}</div><div class="device-meta">${esc(dev.location?displayDeviceLocation(dev.location):'Ubicación pendiente')} · ${esc(fmtLastSeenExact(dev.last_seen_iso||dev.last_seen))}</div></div><button class="btn btn-ghost btn-icon" style="color:var(--danger);" onclick="deleteClientDevice(${dev.id})" title="Eliminar"><i data-lucide="trash-2"></i></button></div>`).join('');
        renderIcons();
    } catch(e) {}
}
async function deleteClientDevice(devId) {
    if (!confirm('Eliminar este dispositivo?')) return;
    try {
        const r = await fetch('/api/devices/' + devId, { method: 'DELETE' });
        const d = await r.json();
        if (d.ok) { toast('Dispositivo eliminado', 'success'); if (editingClientId) loadClientDevices(editingClientId); }
    } catch(e) {}
}

function closeClientModal(){ const m=document.getElementById('clientModal');if(m)m.classList.remove('on');editingClientId=null;editingClientInbound=null;editingClientOriginalInbound=null;syncModalLock();if(typeof flushQueuedSocketRefresh==='function')flushQueuedSocketRefresh(); }
async function saveClient(){
    if (savingClient) return;
    const btn=document.getElementById('clSaveBtn'),txt=document.getElementById('clSaveTxt');
    if(!btn||!txt){toast('No se encontró el formulario de cliente. Cierra y vuelve a abrirlo.','error',5000);return}
    savingClient=true;const prev=txt.textContent;
    btn.disabled=true;txt.textContent='Guardando...';
    try {
        const id = editingClientId;
        const inbound_id = parseInt(document.getElementById('cl-inbound').value);
        const name = document.getElementById('cl-name').value.trim();
        const email = document.getElementById('cl-email').value.trim() || 'c' + Date.now();
        const limit_gb = parseFloat(document.getElementById('cl-limit').value) || 0;
        const sub_token = document.getElementById('cl-token').value.trim();
        const credential = document.getElementById('cl-cred').value.trim();
        const auth_user = document.getElementById('cl-auth-user').value.trim();
        const auth_pass = document.getElementById('cl-auth-pass').value.trim();
        const payment_enabled = document.getElementById('swPay').classList.contains('on') ? 1 : 0;
        const payment_date = document.getElementById('cl-pay-date').value.trim();
        const payment_frequency = parseInt(document.getElementById('cl-pay-freq').value) || 0;
        const payment_time = document.getElementById('cl-pay-time').value.trim() || '09:00';
        const telegram_chat_id = document.getElementById('cl-tg-chat').value.trim();
        const deviceLimitEl=document.getElementById('cl-device-limit');const device_limit=deviceLimitEl?Math.max(0,parseInt(deviceLimitEl.value,10)||0):undefined;
        const payment_message=(document.getElementById('cl-pay-message')?.value||'').trim().slice(0,1200);
        const expiry_enabled=document.getElementById('swExpiry').classList.contains('on')?1:0,expiry_date=document.getElementById('cl-expiry-date').value.trim(),expiry_time=document.getElementById('cl-expiry-time').value||'23:59';
        const routing_enabled=document.getElementById('swClientRouting').classList.contains('on')?1:0,routing_filters_enabled=document.getElementById('swClientFilters').classList.contains('on')?1:0,custom_routing_enabled=document.getElementById('swClientCustomRules').classList.contains('on')?1:0;
        if (!inbound_id || !name) { toast('Faltan campos', 'warning'); return; }
        let url, method, body;
        if (id) { url = '/api/clients/' + id; method = 'PUT'; body = { name, email, limit_gb, sub_token, credential, auth_user, auth_pass, inbound_id, payment_enabled, payment_date, payment_frequency, payment_time, telegram_chat_id, device_limit, payment_message, expiry_enabled, expiry_date, expiry_time,routing_enabled,routing_filters_enabled,custom_routing_enabled }; }
        else { url = '/api/clients'; method = 'POST'; body = { inbound_id, name, email, limit_gb, credential, auth_user, auth_pass, sub_token, payment_enabled, payment_date, payment_frequency, payment_time, telegram_chat_id, device_limit, payment_message, expiry_enabled, expiry_date, expiry_time,routing_enabled,routing_filters_enabled,custom_routing_enabled }; }
        const r = await fetch(url, { method, headers:{'Content-Type':'application/json'}, body: JSON.stringify(body), signal:AbortSignal.timeout(45000) });
        const d=await r.json();if(!r.ok||!d.ok)throw new Error(d.error||`Error HTTP ${r.status}`);closeClientModal();toast(id?'Cliente actualizado':'Cliente creado','success');setTimeout(()=>Promise.all([loadInbounds(),loadAllClients()]).then(()=>{renderServers();loadNotifications()}).catch(e=>console.warn('[refresh-after-client-save]',e)),0);
    }catch(e){toast(e.message||'Conexión interrumpida. Verifica el estado antes de repetir el guardado.','error',7000)}
    finally { savingClient = false; btn.disabled = false; txt.textContent = prev; if(typeof flushQueuedSocketRefresh==='function')flushQueuedSocketRefresh(); }
}
async function deleteClientFromModal(){ if (!editingClientId) return; const id = editingClientId; if (!confirm('Eliminar cliente?')) return; try { const r = await fetch('/api/clients/' + id, { method:'DELETE' }); const d = await r.json(); if (d.ok) { closeClientModal(); await loadInbounds(); await loadAllClients(); renderServers(); loadNotifications(); toast('Eliminado', 'success'); } } catch(e){} }
let clientReactivateResolve=null;
function closeClientReactivateDialog(value){const modal=document.getElementById('clientReactivateDialog');if(modal)modal.style.display='none';if(clientReactivateResolve){const resolve=clientReactivateResolve;clientReactivateResolve=null;resolve(value)}}
function submitClientReactivateDialog(ev){ev.preventDefault();const result={};if(document.getElementById('reactivateGbWrap')){const action=document.querySelector('input[name="reactivateQuotaAction"]:checked')?.value;if(!action){toast('Elige cómo quieres continuar con el límite de GB.','warning');return}result.quota_action=action;if(action==='add_gb'){const rawAmount=String(document.getElementById('reactivateGb').value||'').trim().replace(',','.');const amount=Number(rawAmount);if(!Number.isFinite(amount)||amount<=0||amount>1000000){toast('Escribe una cantidad de GB mayor que 0.','warning');return}result.additional_gb=amount}}if(document.getElementById('reactivateDaysWrap')){const action=document.querySelector('input[name="reactivateExpiryAction"]:checked')?.value;if(!action){toast('Elige cómo quieres continuar con el vencimiento.','warning');return}result.expiry_action=action;if(action==='add_days'){const days=Number(document.getElementById('reactivateDays').value);if(!Number.isInteger(days)||days<1||days>3650){toast('Escribe una cantidad de días entre 1 y 3650.','warning');return}result.expiry_days=days}}closeClientReactivateDialog(result)}
function requestClientReactivateOptions(client,state){return new Promise(resolve=>{clientReactivateResolve=resolve;const modal=document.getElementById('clientReactivateDialog'),options=document.getElementById('reactivateOptions'),intro=document.getElementById('reactivateIntro'),title=document.getElementById('reactivateTitle');if(!modal||!options||!intro||!title){clientReactivateResolve=null;resolve(null);toast('No se pudo abrir la confirmación de reactivación.','error');return}const limit=Number(client.limit_gb)||0;title.textContent='Reactivar '+String(client.name||'cliente');intro.textContent='Elige cómo deseas reactivar este acceso. No se aplicará ningún cambio hasta que confirmes.';let html='';if(state.exhausted)html+=`<div class="reactivate-group" id="reactivateGbWrap"><div class="reactivate-group-title">Límite de datos agotado (${limit} GB)</div><label class="reactivate-choice"><input type="radio" name="reactivateQuotaAction" value="add_gb" checked><span><strong>Agregar más GB</strong><small>Se suma al límite vigente; el consumo actual y los históricos se conservan.</small></span></label><div class="reactivate-number"><input type="text" id="reactivateGb" value="1" inputmode="decimal" autocomplete="off" aria-label="GB adicionales"><span>GB adicionales</span></div><label class="reactivate-choice"><input type="radio" name="reactivateQuotaAction" value="unlimited"><span><strong>Quitar el límite</strong><small>El cliente quedará ilimitado.</small></span></label></div>`;if(state.expired)html+=`<div class="reactivate-group" id="reactivateDaysWrap"><div class="reactivate-group-title">Vencimiento cumplido</div><label class="reactivate-choice"><input type="radio" name="reactivateExpiryAction" value="add_days" checked><span><strong>Agregar más días</strong><small>La fecha se extiende desde hoy y conserva la hora configurada.</small></span></label><label class="reactivate-number"><input type="number" id="reactivateDays" min="1" max="3650" step="1" value="2" inputmode="numeric"><span>días adicionales</span></label><label class="reactivate-choice"><input type="radio" name="reactivateExpiryAction" value="disable"><span><strong>Quitar el vencimiento</strong><small>El cliente quedará sin vencimiento automático.</small></span></label></div>`;options.innerHTML=html||'<p>Confirma para volver a activar el cliente.</p>';modal.style.display='grid';renderIcons();setTimeout(()=>{const first=options.querySelector('input[type="number"]');if(first)first.focus()},60)})}
async function toggleClient(id){const row=(allClients||[]).find(x=>Number(x.id)===Number(id));if(!row)return;const target=Number(row.enabled)===1?0:1;let actionData={};if(target){const state=clientLiveState(row);if(state.exhausted||state.expired){const chosen=await requestClientReactivateOptions(row,state);if(!chosen)return;actionData=chosen}}const patchLocal=(enabled,clientData)=>{allClients=(allClients||[]).map(x=>Number(x.id)===Number(id)?{...x,...(clientData||{}),enabled,online:0}:x);vpnStats=(vpnStats||[]).map(x=>Number(x.id)===Number(id)?{...x,...(clientData?{up:clientData.up_bytes,down:clientData.down_bytes,total:clientData.total_bytes,quota_used:clientData.quota_used_bytes,quota_up:clientData.quota_up_bytes,quota_down:clientData.quota_down_bytes,limit_gb:clientData.limit_gb,quota_exhausted_at:clientData.quota_exhausted_at}:{}),enabled:!!enabled,connected:false}:x);for(const ib of (inbounds||[])){if(Array.isArray(ib.clients))ib.clients=ib.clients.map(x=>Number(x.id)===Number(id)?{...x,...(clientData||{}),enabled,online:0}:x);if(clientsByInbound[ib.id])clientsByInbound[ib.id]=clientsByInbound[ib.id].map(x=>Number(x.id)===Number(id)?{...x,...(clientData||{}),enabled,online:0}:x)}renderClientsAll();renderServers()};toast(target?'Activando cliente…':'Desactivando cliente…','info',1800);for(let attempt=0;attempt<3;attempt++){try{const r=await fetch('/api/clients/'+id+'/toggle',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({enabled:target,...actionData}),signal:AbortSignal.timeout(15000)}),d=await r.json();if(!r.ok||!d.ok){if(d.needsAction){const refreshedClient={...row,...(d.client||{})},refreshedState=clientLiveState(refreshedClient);if(d.needsAction==='quota')refreshedState.exhausted=true;if(d.needsAction==='expiry')refreshedState.expired=true;const corrected=await requestClientReactivateOptions(refreshedClient,refreshedState);if(!corrected)return;actionData={...actionData,...corrected};attempt--;continue}throw new Error(d.error||'No se pudo cambiar el estado')}patchLocal(target,d.client);toast(target?'Cliente activado'+(d.quotaAction==='unlimited'?' · sin límite':d.additionalGb?' · +'+d.additionalGb+' GB':'')+(d.expiryExtended?' · +'+d.expiryDays+' días':d.expiryDisabled?' · sin vencimiento':'')+(d.trafficReset?' · período reiniciado':''):'Cliente desactivado',target?'success':'warning',4500);try{await Promise.all([loadInbounds(),loadAllClients()]);renderClientsAll();renderServers()}catch(refreshError){console.warn('[client-reactivate-refresh]',refreshError)}return}catch(e){if(attempt<2)await new Promise(r=>setTimeout(r,600*(attempt+1)))}}try{await loadAllClients();await loadInbounds();renderServers();const actual=(allClients||[]).find(x=>Number(x.id)===Number(id));if(actual&&Number(actual.enabled)===target){toast('Cliente activado','success',4500);return}}catch(e){}const latest=(allClients||[]).find(x=>Number(x.id)===Number(id));if(latest)patchLocal(Number(latest.enabled)===1,latest);toast('No pude confirmar el cambio de estado. Comprueba la conexión e inténtalo de nuevo.','error',5000)}
async function deleteClient(id){ if (!confirm('Eliminar cliente?')) return; const r = await fetch('/api/clients/' + id, { method:'DELETE' }); const d = await r.json(); if (d.ok) { await loadInbounds(); await loadAllClients(); renderServers(); loadNotifications(); toast('Eliminado', 'success'); } }

async function openShare(id){
    try {
        const r = await fetch('/api/clients/' + id + '/link');
        const d = await r.json();
        if (!d.ok) { toast('Error','error'); return; }
        currentPortalUrl='';document.getElementById('portalShareWrap').style.display='none';
        document.getElementById('linkTxt').textContent = d.link || '';
        const clientNow=allClients.find(x=>String(x.id)===String(id));document.getElementById('shareClientSubtitle').textContent=clientNow?`${clientNow.name} · ${clientNow.protocol||''}`:'Enlaces y códigos de acceso';
        currentPortalUrl=d.portalUrl||'';document.getElementById('portalShareWrap').style.display=currentPortalUrl?'grid':'none';
        if(d.hasSub)document.getElementById('subTxt').textContent=d.subUrl||'';
        const sw = document.getElementById('subWrap');
        const jw = document.getElementById('jsonShareWrap');
        const jt = document.getElementById('jsonSubTxt');
        const jb = document.getElementById('jsonCopyBtn');
        if (d.hasSub) {
            sw.style.display = 'grid'; document.getElementById('subTxt').textContent = d.subUrl || '';
            if (d.jsonEnabled && d.jsonUrl) { jw.style.display = 'grid'; jt.textContent = d.jsonUrl; jb.disabled = false; jb.style.opacity = '1'; }
            else jw.style.display = 'none';
            currentPortalUrl=d.portalUrl||'';document.getElementById('portalShareWrap').style.display=currentPortalUrl?'grid':'none';
        } else {
            sw.style.display = 'none'; jw.style.display = 'none'; document.getElementById('portalShareWrap').style.display='none';
        }
        const q = document.getElementById('qr1');
        q.innerHTML = '';
        if (d.qr && d.qr.startsWith('data:image')) { const img = document.createElement('img'); img.src = d.hasSub && d.qrSub ? d.qrSub : d.qr; img.alt = 'QR'; q.appendChild(img); }
        else q.innerHTML = '<span aria-label="QR no disponible" style="color:#666;font-size:11px;text-align:center;">QR no disponible</span>'; 
        document.getElementById('shareModal').classList.add('on'); lockModalBody();
        renderIcons();
    } catch(e){ toast('Error', 'error'); }
}
function closeShareModal(){ document.getElementById('shareModal').classList.remove('on'); syncModalLock(); }
function openPortalInTab(){ if(currentPortalUrl){const w=window.open(currentPortalUrl,'_blank','noopener');if(!w)toast('El navegador bloqueó la ventana del portal. Permite ventanas emergentes para este panel.','warning',5000)} }

function getProtocolsInfo() { return protocolsInfo || { vless:{transports:['raw','xhttp','grpc','ws','httpupgrade','kcp'],securities:['none','tls','reality']}, vmess:{transports:['raw','xhttp','grpc','ws','httpupgrade','kcp'],securities:['none','tls','reality']}, trojan:{transports:['raw','xhttp','grpc','ws','httpupgrade','kcp'],securities:['none','tls','reality']}, shadowsocks:{transports:['raw','xhttp','grpc','ws','httpupgrade','kcp'],securities:['none','tls']}, socks:{transports:['raw'],securities:['none','tls']}, http:{transports:['raw'],securities:['none','tls']} }; }
function onProtocolChange() {
    const proto = document.getElementById('ib-protocol').value;
    const info = getProtocolsInfo();
    const transports = (info[proto] && info[proto].transports) || ['raw'];
    const securities = (info[proto] && info[proto].securities) || ['none'];
    const netSel = document.getElementById('ib-network');
    const curNet = netSel.value;
    netSel.innerHTML = transports.map(t => `<option value="${t}">${t.toUpperCase()}</option>`).join('');
    if (transports.includes(curNet)) netSel.value = curNet;
    const secSel = document.getElementById('ib-security');
    const curSec = secSel.value;
    secSel.innerHTML = securities.map(s => `<option value="${s}">${s === 'none' ? 'Ninguna' : s === 'tls' ? 'TLS' : 'Reality'}</option>`).join('');
    if (securities.includes(curSec)) secSel.value = curSec;
    document.getElementById('ssMethodFields').style.display = proto === 'shadowsocks' ? 'block' : 'none'; const vlessKeys = document.getElementById('vlessEncryptionFields'); if (vlessKeys) vlessKeys.style.display = proto === 'vless' ? 'block' : 'none';
    const isSimple = (proto === 'socks' || proto === 'http');
    document.getElementById('ib-network-wrap').style.display = isSimple ? 'none' : 'block';
    document.getElementById('ib-security-wrap').style.display = 'block';
    if (isSimple) {
        ['wsFields','grpcFields','h2Fields','quicFields','kcpFields','xhttpFields'].forEach(id => { const e = document.getElementById(id); if (e) e.style.display = 'none'; });
    }
    onSecurityChange();
    onNetworkChange();
}
function onSecurityChange(){ const sec=document.getElementById('ib-security').value,netSel=document.getElementById('ib-network'),proto=document.getElementById('ib-protocol').value,info=getProtocolsInfo(),all=(info[proto]&&info[proto].transports)||['raw'];const allowed=sec==='reality'?all.filter(t=>['raw','xhttp','grpc'].includes(t)):all;const cur=netSel.value;netSel.innerHTML=allowed.map(t=>`<option value="${t}">${t.toUpperCase()}</option>`).join('');if(allowed.includes(cur))netSel.value=cur;else if(allowed.length)netSel.value=allowed[0];document.getElementById('tlsFields').style.display=sec==='tls'?'block':'none';document.getElementById('realityFields').style.display=sec==='reality'?'block':'none';onNetworkChange();}
function onNetworkChange(){
    const proto = document.getElementById('ib-protocol').value;
    const isSimple = (proto === 'socks' || proto === 'http');
    if (isSimple) {
        ['wsFields','grpcFields','h2Fields','quicFields','kcpFields','xhttpFields'].forEach(id => { const e = document.getElementById(id); if (e) e.style.display = 'none'; });
        return;
    }
    const net = document.getElementById('ib-network').value;
    document.getElementById('wsFields').style.display = (net === 'ws' || net === 'httpupgrade') ? 'block' : 'none';
    document.getElementById('wsFieldsTitle').textContent = net === 'httpupgrade' ? 'HTTPUpgrade' : 'WebSocket';
    document.getElementById('grpcFields').style.display = net === 'grpc' ? 'block' : 'none';
    document.getElementById('h2Fields').style.display = (net === 'h2' || net === 'http') ? 'block' : 'none';
    document.getElementById('quicFields').style.display = net === 'quic' ? 'block' : 'none';
    document.getElementById('kcpFields').style.display = (net === 'kcp' || net === 'mkcp') ? 'block' : 'none';
    document.getElementById('xhttpFields').style.display = net === 'xhttp' ? 'block' : 'none';
}
async function genVlessKeys(){ const btn=document.getElementById('btnGenVless'); if(btn)btn.disabled=true; try { const r=await fetch('/api/vless/generate',{method:'POST'}); const d=await r.json(); if(!r.ok||!d.ok)throw new Error(d.error||'No se pudo generar'); document.getElementById('ib-vless-decryption').value=d.serverDecryption; document.getElementById('ib-vless-encryption').value=d.encryption; document.getElementById('ib-vless-encryption').title=d.encryption; toast('Par VLESS generado','success'); } catch(e){toast(e.message||'Error al generar VLESS Encryption','error',5000)} finally{if(btn)btn.disabled=false} }
async function genRealityKeys(){ const btn = document.querySelector('#realityFields button[onclick="genRealityKeys()"]'); if (btn) btn.disabled = true; toast('Generando claves Reality…', 'info', 2000); try { const r = await fetch('/api/reality/generate', { method:'POST' }); const d = await r.json(); if (!r.ok || !d.ok) throw new Error(d.error || 'No se pudieron generar las claves'); document.getElementById('ib-reality-private-key').value = d.privateKey; document.getElementById('ib-reality-public-key').value = d.publicKey; document.getElementById('ib-reality-short-ids').value = d.shortIds; if (!document.getElementById('ib-reality-dest').value) document.getElementById('ib-reality-dest').value = 'www.google.com:443'; if (!document.getElementById('ib-reality-server-names').value) document.getElementById('ib-reality-server-names').value = 'www.google.com'; toast('Claves Reality generadas', 'success'); } catch(e){ toast(e.message || 'Error al generar claves Reality', 'error', 5000); } finally { if (btn) btn.disabled = false; } }
function openInboundModal(){
    editingInboundId = null;
    const el = id => document.getElementById(id);
    el('ib-id').value = ''; el('ib-name').value = ''; el('ib-protocol').value = 'vless'; el('ib-port').value = '';
    el('ib-network').value = 'ws'; el('ib-path').value = '/'; el('ib-host').value = ''; el('ib-domain').value = '';
    el('ib-security').value = 'none';
    setInboundSniffing(true);
    el('ib-tls-sni').value = '';
    el('ib-grpc-service').value = ''; el('ib-h2-path').value = '/'; el('ib-h2-host').value = '';
    el('ib-quic-security').value = 'none'; el('ib-quic-key').value = '';
    el('ib-kcp-header').value = 'none'; el('ib-kcp-seed').value = '';
    el('ib-xhttp-path').value = '/'; el('ib-xhttp-host').value = ''; el('ib-xhttp-mode').value = 'auto';
    el('ib-ss-method').value = 'aes-256-gcm'; el('ib-vless-decryption').value = ''; el('ib-vless-encryption').value = ''; el('ib-vless-encryption').title = '';
    el('ib-reality-dest').value = ''; el('ib-reality-server-names').value = ''; el('ib-reality-private-key').value = ''; el('ib-reality-public-key').value = ''; el('ib-reality-short-ids').value = '';
    document.getElementById('swGrpcMulti').classList.remove('on');
    onProtocolChange();
    el('imTitle').textContent = 'Nuevo servidor'; el('ibSaveTxt').textContent = 'Crear';
    document.getElementById('inboundModal').classList.add('on'); lockModalBody(); renderIcons();
    if (document.getElementById('ib-protocol').value === 'vless') genVlessKeys();
}
async function editInbound(id){
    let ib=inbounds.find(x=>Number(x.id)===Number(id));
    if(!ib){try{await Promise.race([loadInbounds(),new Promise((_,reject)=>setTimeout(()=>reject(new Error('Tiempo de espera agotado')),12000))]);ib=inbounds.find(x=>Number(x.id)===Number(id))}catch(e){toast('No se pudo cargar el servidor: '+(e.message||''),'error',5000);return}}
    if(!ib){toast('Ese servidor ya no aparece en la lista. Actualiza los datos e intenta de nuevo.','warning',5000);return}
    editingInboundId = id;
    const el = id => document.getElementById(id);
    el('ib-id').value = ib.id; el('ib-name').value = ib.name; el('ib-protocol').value = ib.protocol; el('ib-port').value = ib.port;
    setInboundSniffing(Number(ib.sniffing)===1);
    el('ib-domain').value = ib.domain || ''; el('ib-path').value = ib.path || '/'; el('ib-host').value = ib.host || '';
    el('ib-tls-sni').value = ib.tls_sni || ''; 
    el('ib-grpc-service').value = ib.grpc_service || ''; el('ib-h2-path').value = ib.h2_path || '/'; el('ib-h2-host').value = ib.h2_host || '';
    el('ib-quic-security').value = ib.quic_security || 'none'; el('ib-quic-key').value = ib.quic_key || '';
    el('ib-kcp-header').value = ib.kcp_header || 'none'; el('ib-kcp-seed').value = ib.kcp_seed || '';
    el('ib-xhttp-path').value = ib.xhttp_path || '/'; el('ib-xhttp-host').value = ib.xhttp_host || ''; el('ib-xhttp-mode').value = ib.xhttp_mode || 'auto';
    el('ib-ss-method').value = ib.ss_method || 'aes-256-gcm'; el('ib-vless-decryption').value = ib.vless_decryption || ''; el('ib-vless-encryption').value = ib.vless_encryption || ''; el('ib-vless-decryption').title = ib.vless_decryption || ''; el('ib-vless-encryption').title = ib.vless_encryption || '';
    el('ib-reality-dest').value = ib.reality_dest || ''; el('ib-reality-server-names').value = ib.reality_server_names || '';
    el('ib-reality-private-key').value = ib.reality_private_key || ''; el('ib-reality-public-key').value = ib.reality_public_key || '';
    el('ib-reality-short-ids').value = ib.reality_short_ids || '';

    document.getElementById('swGrpcMulti').classList.toggle('on', ib.grpc_multi == 1);
    onProtocolChange();
    // Restaurar transporte/seguridad DESPUÉS de reconstruir opciones
    let net = (ib.network || 'ws').toLowerCase();
    if (net === 'tcp') net = 'raw';
    const netSel = document.getElementById('ib-network');
    const secSel = document.getElementById('ib-security');
    if (netSel && [...netSel.options].some(o => o.value === net)) netSel.value = net;
    else if (netSel && ib.network) {
      // fallback: add option if missing
      const opt = document.createElement('option'); opt.value = ib.network; opt.textContent = String(ib.network).toUpperCase();
      netSel.appendChild(opt); netSel.value = ib.network;
    }
    if (secSel) secSel.value = ib.security || 'none';
    if(secSel&&secSel.value==='reality'&&!['raw','xhttp','grpc'].includes(net)){netSel.value='raw';}
    if (typeof onNetworkChange === 'function') onNetworkChange();
    if (typeof onSecurityChange === 'function') onSecurityChange();
    el('imTitle').textContent = 'Editar servidor'; el('ibSaveTxt').textContent = 'Guardar';
    document.getElementById('inboundModal').classList.add('on'); lockModalBody(); renderIcons();
}
function closeInboundModal(){ const m=document.getElementById('inboundModal');if(m)m.classList.remove('on');editingInboundId=null;syncModalLock();if(typeof flushQueuedSocketRefresh==='function')flushQueuedSocketRefresh(); }
async function saveInbound(){
    if (savingInbound) return;
    const btn=document.getElementById('ibSaveBtn'),txt=document.getElementById('ibSaveTxt');
    if(!btn||!txt){toast('No se encontró el formulario del servidor. Cierra y vuelve a abrirlo.','error',5000);return}
    savingInbound=true;const prev=txt.textContent;
    btn.disabled=true;txt.textContent='Guardando...';
    try {
        const id = document.getElementById('ib-id').value;
        const security = document.getElementById('ib-security').value;
        const network = document.getElementById('ib-network').value;
        const proto = document.getElementById('ib-protocol').value;
        const domainVal = document.getElementById('ib-domain').value.trim();
        const body = {
            name: document.getElementById('ib-name').value.trim(),
            protocol: proto, port: parseInt(document.getElementById('ib-port').value),
            network: network, path: document.getElementById('ib-path').value.trim() || '/',
            tls: security === 'tls' || security === 'reality', security: security,
            domain: domainVal, tls_sni: document.getElementById('ib-tls-sni').value.trim(), host: document.getElementById('ib-host').value.trim(),
            sniffing: document.getElementById('swInboundSniffing').classList.contains('on'), fingerprint: document.getElementById('ib-tls-fp').value, alpn: '',
            reality_dest: document.getElementById('ib-reality-dest').value.trim(),
            reality_server_names: document.getElementById('ib-reality-server-names').value.trim(),
            reality_private_key: document.getElementById('ib-reality-private-key').value.trim(),
            reality_public_key: document.getElementById('ib-reality-public-key').value.trim(),
            reality_short_ids: document.getElementById('ib-reality-short-ids').value.trim(),
            grpc_service: document.getElementById('ib-grpc-service').value.trim(),
            grpc_multi: document.getElementById('swGrpcMulti').classList.contains('on') ? 1 : 0,
            h2_path: document.getElementById('ib-h2-path').value.trim() || '/',
            h2_host: document.getElementById('ib-h2-host').value.trim(),
            quic_key: document.getElementById('ib-quic-key').value.trim(),
            quic_security: document.getElementById('ib-quic-security').value,
            quic_header: 'none',
            kcp_seed: document.getElementById('ib-kcp-seed').value.trim(),
            kcp_header: document.getElementById('ib-kcp-header').value,
            xhttp_path: document.getElementById('ib-xhttp-path').value.trim() || '/',
            xhttp_host: document.getElementById('ib-xhttp-host').value.trim(),
            xhttp_mode: document.getElementById('ib-xhttp-mode').value,
            ss_method: document.getElementById('ib-ss-method').value,
            vless_decryption: document.getElementById('ib-vless-decryption').value.trim(),
            vless_encryption: document.getElementById('ib-vless-encryption').value.trim()
        };
        if (!body.name || !body.port) { toast('Faltan campos', 'warning'); return; }
        if(proto==='vless'){
            const pasted=body.vless_encryption.includes('decryption')?body.vless_encryption:(body.vless_decryption.includes('encryption')?body.vless_decryption:'');
            if(pasted){try{const obj=JSON.parse(pasted);if(obj.encryption&&obj.decryption){body.vless_encryption=String(obj.encryption);body.vless_decryption=String(obj.decryption)}}catch(e){}if(!body.vless_decryption||body.vless_decryption===pasted){const em=pasted.match(/\"encryption\"\s*:\s*\"([^\"]+)\"/),dm=pasted.match(/\"decryption\"\s*:\s*\"([^\"]+)\"/);if(em&&dm){body.vless_encryption=em[1];body.vless_decryption=dm[1]}}}
            if(body.vless_encryption&&!body.vless_decryption){const current=(inbounds.find(x=>Number(x.id)===Number(id))||{}),oldSuffix=String(current.vless_encryption||'').split('.').pop(),newSuffix=body.vless_encryption.trim().split('.').pop();if(oldSuffix===newSuffix&&current.vless_decryption)body.vless_decryption=current.vless_decryption;else{toast('Pega también decryption del mismo par o usa Generar el par. No se guardó una clave incompleta.', 'warning', 5000);return}}
        }
        if (security === 'reality' && (!body.reality_private_key || !body.reality_public_key)) { toast('Reality requiere claves', 'warning'); return; }
        const url = id ? '/api/inbounds/' + id : '/api/inbounds';
        const r = await fetch(url, { method: id ? 'PUT' : 'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body), signal:AbortSignal.timeout(45000) });
        const d=await r.json();if(!r.ok||!d.ok)throw new Error(d.error||`Error HTTP ${r.status}`);closeInboundModal();toast(id?'Servidor actualizado':'Servidor creado','success');setTimeout(()=>loadInbounds().then(renderServers).catch(e=>console.warn('[refresh-after-server-save]',e)),0);
    }catch(e){toast(e.message||'La conexión falló. Verifica si se guardó antes de repetir la operación.','error',7000)}
    finally { savingInbound = false; btn.disabled = false; txt.textContent = prev; if(typeof flushQueuedSocketRefresh==='function')flushQueuedSocketRefresh(); }
}
async function deleteInbound(id){
  if (!confirm('Eliminar servidor y todos sus clientes?')) return;
  try {
    const r = await fetch('/api/inbounds/' + id, { method:'DELETE' });
    const d = await r.json();
    if (d.ok) { await loadInbounds(); renderServers(); toast('Eliminado', 'success'); }
    else toast(d.error || 'Error', 'error');
  } catch(e){ toast('Error', 'error'); }
}
async function deleteInboundFromModal(){ if (!editingInboundId) return; const id = editingInboundId; if (!confirm('Eliminar servidor y todos sus clientes?')) return; try { const r = await fetch('/api/inbounds/' + id, { method:'DELETE' }); const d = await r.json(); if (d.ok) { closeInboundModal(); await loadInbounds(); renderServers(); toast('Eliminado', 'success'); } } catch(e){} }

async function saveSubBasic(){
  const subInterval=parseInt(document.getElementById('subInterval').value,10)||12;
  const subPort=parseInt(document.getElementById('subPort').value,10)||443;
  let subPath=(document.getElementById('subPath').value||'').trim()||'/sub';
  if(!subPath.startsWith('/'))subPath='/'+subPath;
  const subTitle=(document.getElementById('subTitle').value||'').trim();
  try{
    const r=await fetch('/api/subscription-settings',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({subInterval,subPort,subPath,subTitle})});
    const d=await r.json();
    if(d.ok){toast('Configuración básica guardada','success');await loadSubSettings()}else toast(d.error||'Error al guardar','error');
  }catch(e){toast('Error de red al guardar','error')}
}
async function loadSubSettings(){ try { const r = await fetch('/api/subscription-settings'); const d = await r.json(); if (!d.ok) return; vpnDomainCache = d.domain || ''; const el = id => document.getElementById(id); el('subInterval').value = d.subInterval || 12; el('subPort').value = d.subPort || d.panelPort || 443; el('subPath').value = d.subPath || '/sub'; el('subTitle').value = d.subTitle || ''; el('swSubUsage').classList.toggle('on', d.subShowUsage == 1); el('jsonPath').value = d.jsonPath || '/subjson'; el('jsonBypass').value = d.jsonBypass || ''; el('jsonBypassAll').value = d.jsonBypassAll || ''; el('swJson').classList.toggle('on', d.jsonEnabled == 1); const jd = document.getElementById('jsonDesc'); if (jd) { jd.textContent = d.jsonEnabled == 1 ? 'ACTIVADO' : 'Desactivado'; jd.style.color = d.jsonEnabled == 1 ? '#6366f1' : ''; } renderUAChipsFromString(d.subUserAgent || ''); } catch(e){} }

let currentUAList = [];
function renderUAChipsFromString(s) {
    currentUAList = String(s || '').split(/[,\n]+/).map(x => x.trim()).filter(Boolean);
    renderUAChips();
}
function renderUAChips() {
    const wrap = document.getElementById('uaChipsWrap');
    if (!wrap) return;
    wrap.innerHTML = currentUAList.map((ua, i) => `<span class="ua-chip">${esc(ua)}<button type="button" onclick="removeUAChip(${i})">×</button></span>`).join('');
}
function addUAChip() {
    const inp = document.getElementById('uaInput');
    const v = (inp.value || '').trim();
    if (!v) return;
    if (!currentUAList.includes(v)) currentUAList.push(v);
    inp.value = '';
    renderUAChips();
}
function removeUAChip(i) {
    currentUAList.splice(i, 1);
    renderUAChips();
}

async function saveSubSecurity() {
    try {
        const uaStr = currentUAList.join(',');
        const r = await fetch('/api/subscription-settings', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ subUserAgent: uaStr }) });
        const d = await r.json();
        if (d.ok) toast('Seguridad actualizada', 'success');
        else toast(d.error || 'Error', 'error');
    } catch(e) { toast('Error de red', 'error'); }
}

async function loadDevices() {
    try {
        const r = await fetch('/api/devices');
        const d = await r.json();
        if (!d.ok) return;
        const list = document.getElementById('devicesList');
        if (!list) return;
        if (!d.devices || !d.devices.length) {
            list.innerHTML = '<div style="padding:20px;text-align:center;color:var(--text-3);font-size:12px;background:var(--bg);border-radius:10px;">Sin dispositivos registrados</div>';
            return;
        }
        list.innerHTML = d.devices.map(dev => `<div class="device-row"><div class="device-icon"><i data-lucide="smartphone"></i></div><div class="device-info"><div class="device-name">${esc(dev.app_name||'App VPN no identificada')} · ${esc(dev.display_name||'Dispositivo')}</div><div class="device-meta">${esc(dev.location?displayDeviceLocation(dev.location):'Ubicación pendiente')} · ${esc(fmtLastSeenExact(dev.last_seen_iso||dev.last_seen))}</div><div class="device-client">${esc(dev.client_name||'')} ${dev.sub_token?'('+esc(dev.sub_token)+')':''}</div></div><button class="btn btn-ghost btn-icon" style="color:var(--danger);" onclick="deleteDevice(${dev.id})" title="Eliminar dispositivo"><i data-lucide="trash-2"></i></button></div>`).join('');
        renderIcons();
    } catch(e) {}
}

async function deleteDevice(id) {
    if (!confirm('Eliminar este dispositivo?')) return;
    try {
        const r = await fetch('/api/devices/' + id, { method: 'DELETE' });
        const d = await r.json();
        if (d.ok) { toast('Dispositivo eliminado', 'success'); loadDevices(); }
    } catch(e) {}
}

async function saveSubSettings(){ const subInterval = parseInt(document.getElementById('subInterval').value) || 12; const subPort = parseInt(document.getElementById('subPort').value) || 443; let subPath = document.getElementById('subPath').value.trim() || '/sub'; if (!subPath.startsWith('/')) subPath = '/' + subPath; const subTitle = document.getElementById('subTitle').value.trim(); const subShowUsage = document.getElementById('swSubUsage').classList.contains('on') ? 1 : 0; const jsonEnabled = document.getElementById('swJson').classList.contains('on') ? 1 : 0; let jsonPath = document.getElementById('jsonPath').value.trim() || '/subjson'; if (!jsonPath.startsWith('/')) jsonPath = '/' + jsonPath; const jsonBypass = document.getElementById('jsonBypass').value.trim(); const jsonBypassAll = document.getElementById('jsonBypassAll').value.trim(); const subUserAgent = currentUAList.join(','); try { const r = await fetch('/api/subscription-settings', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ subInterval, subPort, subPath, subTitle, subUserAgent, subShowUsage, jsonEnabled, jsonPath, jsonBypass, jsonBypassAll }) }); const d = await r.json(); if (d.ok) { toast('Guardado', 'success'); loadSubSettings(); } else toast(d.error || 'Error', 'error'); } catch(e){ toast('Error', 'error'); } }
function toggleSubUsage(){ document.getElementById('swSubUsage').classList.toggle('on'); }
function toggleJson(){ const el = document.getElementById('swJson'); el.classList.toggle('on'); const on = el.classList.contains('on'); const jd = document.getElementById('jsonDesc'); if (jd) { jd.textContent = on ? 'ACTIVADO' : 'Desactivado'; jd.style.color = on ? '#6366f1' : ''; } }

async function loadCacheSettings(){ try { const r = await fetch('/api/cache/settings'); const d = await r.json(); if (!d.ok) return; const s = d.settings || {}; document.getElementById('swCache').classList.toggle('on', !!s.cache_enabled); const ch = parseInt(s.cache_hour, 10); const cm = parseInt(s.cache_minute, 10); const h = String(isNaN(ch) ? 4 : ch).padStart(2, '0'); const m = String(isNaN(cm) ? 0 : cm).padStart(2, '0'); document.getElementById('cacheTime').value = h + ':' + m; } catch(e){} }
function toggleCache(){ document.getElementById('swCache').classList.toggle('on'); saveCache(); }
async function saveCache(){ const t = document.getElementById('cacheTime').value || '04:00'; const p = t.split(':'); const hh = parseInt(p[0], 10); const mm = parseInt(p[1], 10); const hour = isNaN(hh) ? 0 : hh; const minute = isNaN(mm) ? 0 : mm; const enabled = document.getElementById('swCache').classList.contains('on'); await fetch('/api/cache/settings', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ cache_enabled: enabled ? 1 : 0, cache_hour: hour, cache_minute: minute }) }); toast('Actualizado', 'success'); }
async function cleanNow(){ if (!confirm('Limpiar cache ahora?')) return; toast('Limpiando...', 'info', 3000); try { await fetch('/api/cache/clean', { method:'POST' }); toast('Completado', 'success'); } catch(e){} }
async function loadTimezone(){ try { const r = await fetch('/api/timezone'); const d = await r.json(); if (!d.ok) return; timezoneList = d.list || []; serverTimezone = d.timezone || serverTimezone; serverTimeFormat = d.timeFormat || '24h'; const sel = document.getElementById('tzSelect'); if (sel) sel.innerHTML = timezoneList.map(t => `<option value="${esc(t.value)}" ${t.value === serverTimezone ? 'selected' : ''}>${esc(t.label)}</option>`).join(''); const tf = document.getElementById('timeFormatSelect'); if (tf) tf.value = serverTimeFormat; updateClock(); } catch(e){} }
async function saveTimezone(){ const v = document.getElementById('tzSelect').value; const tf = document.getElementById('timeFormatSelect').value; if (!v) return; try { const r = await fetch('/api/timezone', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ timezone: v, timeFormat: tf }) }); const d = await r.json(); if (d.ok) { serverTimezone = v; serverTimeFormat = tf; updateClock(); toast('Aplicado', 'success'); } } catch(e){} }
function downloadBackup(){ toast('Generando backup...', 'info', 2000); window.location.href = '/api/backup/download'; setTimeout(() => toast('Descargado', 'success'), 1500); }
async function uploadBackup(ev){ const file = ev.target.files && ev.target.files[0]; if (!file) return; if (!confirm('Restaurar backup? Esto reemplazará servidores y clientes actuales.')) { ev.target.value = ''; return; } try { const text = await file.text(); const data = JSON.parse(text); toast('Restaurando...', 'info', 4000); const r = await fetch('/api/backup/restore', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(data) }); const d = await r.json(); if (d.ok) { await Promise.all([loadInbounds(),loadAllClients(),loadRouting(),loadTotals(),loadNotifications()]);renderServers();renderClientsAll();renderConnected();toast('Backup restaurado y panel actualizado sin recargar','success',4000); } else toast(d.error || 'Error', 'error', 5000); } catch(e) { toast('Archivo inválido: '+(e.message||''), 'error', 5000); } ev.target.value = ''; }
async function saveCreds(){ const u = document.getElementById('confUser').value.trim(); const p = document.getElementById('confPass').value; if (!u && !p) { toast('Completa un campo', 'warning'); return; } const r = await fetch('/api/credentials', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ user: u, pass: p }) }); const d = await r.json(); if (d.ok) { toast('Guardado. Re-login en 3s', 'success'); setTimeout(() => location.href = '/logout', 3000); } }
async function restartXray(){ if (!confirm('Reiniciar Xray?')) return; toast('Reiniciando...', 'info', 3000); try { const r = await fetch('/api/restart-xray', { method:'POST' }); const d = await r.json(); toast(d.ok ? 'Reiniciado' : 'Error', d.ok ? 'success' : 'error', 3000); } catch(e){} }
async function viewConfig(){ try { const r = await fetch('/api/config-view'); const d = await r.json(); if (!d.ok) return; const w = window.open('', '_blank'); w.document.write('<pre style="color:#e2e8f0;background:#0a0a0c;padding:20px;font-size:12px;font-family:JetBrains Mono,monospace;">' + d.config.replace(/</g,'&lt;') + '</pre>'); } catch(e){} }
async function testConfig(){ toast('Probando...', 'info'); const r = await fetch('/api/test-config'); const d = await r.json(); toast(d.valid ? 'Válida' : 'Inválida', d.valid ? 'success' : 'error', 4000); }
async function loadSystemInfo(){ await updateSystemInfo(); }

async function loadTelegramSettings(){ try { const r = await fetch('/api/telegram/settings'); const d = await r.json(); if (!d.ok) return; const s = d.settings || {}; document.getElementById('swTelegram').classList.toggle('on', s.enabled == 1); document.getElementById('tgToken').value = s.bot_token || ''; document.getElementById('tgAdminIds').value = s.admin_ids || ''; document.getElementById('swTgNotify').classList.toggle('on', s.notify_payment == 1); document.getElementById('swTgBackup').classList.toggle('on', s.auto_backup == 1); const bh = parseInt(s.auto_backup_hour, 10); const bm = parseInt(s.auto_backup_minute, 10); const h = String(isNaN(bh) ? 3 : bh).padStart(2, '0'); const m = String(isNaN(bm) ? 0 : bm).padStart(2, '0'); document.getElementById('tgBackupTime').value = h + ':' + m; } catch(e){} }
async function saveTelegram(){ const t = document.getElementById('tgBackupTime').value || '03:00'; const parts = t.split(':'); const hh = parseInt(parts[0], 10); const mm = parseInt(parts[1], 10); const body = { enabled: document.getElementById('swTelegram').classList.contains('on') ? 1 : 0, bot_token: document.getElementById('tgToken').value.trim(), admin_ids: document.getElementById('tgAdminIds').value.trim(), notify_payment: document.getElementById('swTgNotify').classList.contains('on') ? 1 : 0, notify_online: 0, auto_backup: document.getElementById('swTgBackup').classList.contains('on') ? 1 : 0, auto_backup_hour: isNaN(hh) ? 3 : hh, auto_backup_minute: isNaN(mm) ? 0 : mm }; try { const r = await fetch('/api/telegram/settings', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) }); const d = await r.json(); if (d.ok) toast('Guardado', 'success'); else toast(d.error || 'Error', 'error'); } catch(e){ toast('Error', 'error'); } }
async function testTelegram(){ toast('Enviando test...', 'info'); try { const r = await fetch('/api/telegram/test', { method:'POST' }); const d = await r.json(); toast(d.ok ? 'Test enviado' : 'Error: ' + (d.error||''), d.ok ? 'success' : 'error', 5000); } catch(e){ toast('Error', 'error'); } }

socket.on('connect', () => { try { socket.emit('vpn_stats_request'); } catch(e){}; if(typeof refreshAdminViewsFromSocket==='function')refreshAdminViewsFromSocket(); });
socket.on('vpn_stats', data => { if(!Array.isArray(data))return; vpnStats = data; const online = data.filter(s => s.connected && s.enabled); const el = id => document.getElementById(id); if (editingClientId) { const live= data.find(x=>Number(x.id)===Number(editingClientId)); const row=el('cl-lastseen-row'); if(row&&live) row.style.display=(live.enabled&&live.connected)?'none':'flex';if(live){const limited=Number(live.limit_gb)>0,up=limited?live.quota_up:live.up,down=limited?live.quota_down:live.down,total=limited?live.quota_used:live.total;if(el('cl-up'))el('cl-up').textContent=fmtB(up);if(el('cl-down'))el('cl-down').textContent=fmtB(down);if(el('cl-total'))el('cl-total').textContent=fmtB(total)}} if (el('kpiOnline')) el('kpiOnline').textContent = online.length; if (el('kpiClients')) el('kpiClients').textContent = data.length; scheduleLiveViewRefresh(); });
socket.on('system_metrics_live', d => { if (!d) return; updateGauge('cpuRing','cpuVal',d.cpuUsage,87.96); updateGauge('ramRing','ramVal',d.memPercent,87.96); updateGauge('cpuRingBig','cpuBigVal',d.cpuUsage,238.76); updateGauge('ramRingBig','ramBigVal',d.memPercent,238.76); const cpuSub=document.getElementById('cpuStatSub'); if(cpuSub) cpuSub.textContent=(d.cpuCount||1)+' núcleos'; const ramSub=document.getElementById('ramStatSub'); if(ramSub) ramSub.textContent=((d.memUsed||0)/1000000000).toFixed(1)+' / '+((d.memTotal||0)/1073741824).toFixed(1)+' GB'; const up=document.getElementById('sysUptime'); if(up) up.textContent=fmtUptime(d.uptime||0); });
let queuedSocketRefresh=false;
async function refreshAdminViewsFromSocket(){if(savingClient||savingInbound||editingClientId||editingInboundId){queuedSocketRefresh=true;return}queuedSocketRefresh=false;try{await loadInbounds();if(document.getElementById('p-servers').classList.contains('active'))renderServers();if(document.getElementById('p-clients').classList.contains('active'))await loadAllClients();if(document.getElementById('p-routing').classList.contains('active'))await loadRouting()}catch(e){console.error('[refresh_servers]',e)}}
function flushQueuedSocketRefresh(){if(queuedSocketRefresh&&!savingClient&&!savingInbound&&!editingClientId&&!editingInboundId)setTimeout(()=>refreshAdminViewsFromSocket(),0)}
socket.on('refresh_servers', refreshAdminViewsFromSocket);


async function loadWebPages(){
  try {closeAllClientMenus();
    const r=await fetch('/api/web-pages');const d=await r.json();
    const list=document.getElementById('webPagesList');if(!list)return;if(!r.ok||!d.ok)throw new Error(d.error||`Error HTTP ${r.status}`);
    if (!d.ok || !d.pages || !d.pages.length) {
      list.innerHTML = '<div class="card empty"><i data-lucide="layout-template"></i><div class="empty-title">Sin páginas</div><div class="empty-text">Crea una landing o portal público</div><button class="btn btn-primary" onclick="openWebPageModal()"><i data-lucide="plus"></i> Crear</button></div>';
      renderIcons(); return;
    }
    closeAllClientMenus();
    list.innerHTML = d.pages.map(p => `<div class="webpage-card">
      <div class="webpage-card-icon"><i data-lucide="globe-2"></i></div>
      <div class="webpage-card-info"><div class="webpage-card-title">${esc(p.name)}</div><a class="webpage-card-url" href="/${esc(p.path)}" target="_blank">/${esc(p.path)}</a></div>
      <div class="webpage-card-actions"><span class="badge ${p.enabled? 'on':'off'}">${p.enabled? 'Activa':'Off'}</span><div class="client-menu"><button type="button" class="client-menu-btn" aria-haspopup="menu" aria-expanded="false" onclick="toggleClientMenu(event, 'wp'+${p.id})" title="Más"><i data-lucide="menu"></i></button><div class="client-menu-drop" id="cl-menu-wp${p.id}" role="menu"><button type="button" onclick="editWebPage(${p.id});closeAllClientMenus()"><i data-lucide="pencil"></i> Editar</button><a href="/${esc(p.path)}" target="_blank" onclick="closeAllClientMenus()"><i data-lucide="external-link"></i> Abrir</a><button type="button" class="danger" onclick="deleteWebPageById(${p.id})"><i data-lucide="trash-2"></i> Eliminar</button></div></div></div>
    </div>`).join('');
    renderIcons();
  }catch(e){const list=document.getElementById('webPagesList');if(list)list.innerHTML=`<div class="card empty"><div class="empty-title">No se pudieron cargar las páginas</div><div class="empty-text">${esc(e.message||"Error de conexión")}</div><button class="btn btn-secondary" onclick="loadWebPages()">Reintentar</button></div>`}
}
async function deleteWebPageById(id){if(!confirm('¿Eliminar esta página?'))return;try{const r=await fetch('/api/web-pages/'+id,{method:'DELETE'}),d=await r.json();if(!r.ok||!d.ok)throw new Error(d.error||`Error HTTP ${r.status}`);toast('Página eliminada','success');setTimeout(()=>loadWebPages(),0)}catch(e){toast(e.message||'No se pudo eliminar la página','error',6000)}}
let savingWebPage=false;
function openWebPageModal(){
  if(savingWebPage)return;
  document.getElementById('wp-id').value='';
  document.getElementById('wp-name').value='';
  document.getElementById('wp-path').value='';
  document.getElementById('wp-html').value = '<!doctype html>\n<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>GZMNET</title></head><body style="font-family:system-ui;padding:24px;background:#0a0a0c;color:#f5f5f5;"><h1>Hola</h1></body></html>';
  document.getElementById('swWpEnabled').classList.add('on');
  document.getElementById('wpDeleteBtn').style.display='none';
  document.getElementById('wpModalTitle').textContent='Nueva página';
  document.getElementById('webPageModal').classList.add('on');
  syncIslandModalVisibility();lockModalBody();
  renderIcons();
}
function closeWebPageModal(){ const m=document.getElementById('webPageModal'); if(m) m.classList.remove('on'); syncModalLock(); }
async function editWebPage(id){
  try {
    const r = await fetch('/api/web-pages/'+id); const d = await r.json();
    if(!r.ok||!d.ok)throw new Error(d.error||`Error HTTP ${r.status}`);
    const p=d.page;
    document.getElementById('wp-id').value=p.id;
    document.getElementById('wp-name').value=p.name||'';
    document.getElementById('wp-path').value=p.path||'';
    document.getElementById('wp-html').value=p.html||'';
    document.getElementById('swWpEnabled').classList.toggle('on', p.enabled==1);
    const wpDeleteBtn = document.getElementById('wpDeleteBtn'); if (wpDeleteBtn) wpDeleteBtn.style.display='';
    document.getElementById('wpModalTitle').textContent='Editar página';
    document.getElementById('webPageModal').classList.add('on');
    syncIslandModalVisibility();lockModalBody();
    renderIcons();
  } catch(e){toast(e.message||'No se pudo abrir la página','error',6000)}
}
async function saveWebPage(){
  if(savingWebPage)return;const id=document.getElementById('wp-id').value,btn=document.querySelector('#webPageModal .modal-head-actions .btn-primary');savingWebPage=true;if(btn){btn.disabled=true;btn.dataset.original=btn.innerHTML;btn.textContent='Guardando…'}
  const body = {
    name: document.getElementById('wp-name').value.trim(),
    path: document.getElementById('wp-path').value.trim(),
    html: document.getElementById('wp-html').value,
    enabled: document.getElementById('swWpEnabled').classList.contains('on') ? 1 : 0
  };
  if (!body.name){savingWebPage=false;if(btn){btn.disabled=false;if(btn.dataset.original){btn.innerHTML=btn.dataset.original;delete btn.dataset.original}}return toast('Nombre requerido','warning')}
  try {
    const r=await fetch(id?'/api/web-pages/'+id:'/api/web-pages',{method:id?'PUT':'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});const d=await r.json();if(!r.ok||!d.ok)throw new Error(d.error||`Error HTTP ${r.status}`);
    closeWebPageModal();toast('Página guardada','success');setTimeout(()=>loadWebPages(),0);
  }catch(e){toast(e.message||'No se pudo guardar la página','error',6000)}finally{savingWebPage=false;if(btn){btn.disabled=false;if(btn.dataset.original){btn.innerHTML=btn.dataset.original;delete btn.dataset.original}renderIcons()}}
}
async function deleteWebPage(){
  const id = document.getElementById('wp-id').value;
  if (!id || !confirm('Eliminar página?')) return;
  try {
    const r = await fetch('/api/web-pages/'+id, { method:'DELETE' });
    const d = await r.json();
    if (d.ok) { closeWebPageModal(); loadWebPages(); toast('Eliminada','success'); }
  } catch(e){}
}

async function copyLogs(){const out=document.getElementById('logsOutput'),btn=document.getElementById('copyLogsBtn');if(!out)return;const lines=out.textContent.split('\n').filter(x=>/\b(error|fail(?:ed|ure)?|exception|uncaught|unhandled|fatal|auth-fail|vless-migrate-error|config invalida|rollback-error)\b/i.test(x));const text=lines.length?lines.join('\n'):'No hay errores visibles para copiar.';try{await navigator.clipboard.writeText(text);toast(lines.length?'Errores copiados':'No hay errores en los registros mostrados',lines.length?'success':'info')}catch(e){const area=document.createElement('textarea');area.value=text;area.style.position='fixed';area.style.opacity='0';document.body.appendChild(area);area.select();const ok=document.execCommand('copy');area.remove();toast(ok?'Errores copiados':'No se pudieron copiar los errores',ok?'success':'error')}}
let logsRequestId=0;async function loadLogs(){const out=document.getElementById('logsOutput');if(!out)return;const rid=++logsRequestId,source=document.getElementById('logsSource')?.value||'all',level=document.getElementById('logsLevel')?.value||'error',lines=document.getElementById('logsLines')?.value||200;out.textContent='Cargando registros…';try{const r=await fetch(`/api/logs?source=${encodeURIComponent(source)}&level=${encodeURIComponent(level)}&lines=${encodeURIComponent(lines)}`,{signal:AbortSignal.timeout(15000)});const d=await r.json();if(!r.ok||!d.ok)throw new Error(d.error||'No se pudieron cargar los registros');if(rid===logsRequestId){out.textContent=d.logs||'No hay registros para los filtros elegidos.';const b=document.getElementById('copyLogsBtn');if(b)b.innerHTML='<i data-lucide="copy"></i> '+(level==='error'?'Copiar errores':'Copiar solo errores');renderIcons()}}catch(e){if(rid===logsRequestId)out.textContent='No se pudieron cargar los logs: '+(e.message||'error de conexión')}}
async function init(){ await loadProtocolsInfo(); try { await loadSubSettings(); } catch(e){} try{await loadInbounds();renderServers()}catch(e){document.getElementById('serversList').innerHTML='<div class="card empty"><div class="empty-title">No se pudieron cargar los servidores</div><div class="empty-text">'+esc(e.message)+'</div></div>'} await loadTotals(); await loadNotifications(); await updateSystemInfo(); await loadTimezone(); renderConnected(); setInterval(() => { if (!document.hidden && document.getElementById('p-settings').classList.contains('active')) updateSystemInfo(); }, 30000); setInterval(() => { if (!document.hidden && document.getElementById('p-dash').classList.contains('active')) loadTotals(); }, 15000); setInterval(() => { if (!document.hidden) loadNotifications(); }, 12000); setInterval(() => { if (document.hidden) return; if (savingClient || savingInbound) return; if (editingClientId || editingInboundId) return; if (document.getElementById('p-servers').classList.contains('active')) loadInbounds().then(renderServers).catch(()=>{}); if (document.getElementById('p-clients').classList.contains('active')) loadAllClients().catch(()=>{}); }, 30000); }

(function(){const el=document.getElementById('island');if(el){el.classList.remove('island-shattering','island-restoring');el.style.left='';el.style.right='';el.style.top='';el.style.transform='';el.style.opacity='';el.style.visibility='';if(typeof window.__syncIslandScrollVisibility==='function')window.__syncIslandScrollVisibility()}})();

window.addEventListener('load', () => {
    setTimeout(init, 200);
    setTimeout(bootstrapNotifications, 300);
});
</script>
</body>
</html>
HTMLEOF

# =================== NODE MODULES ===================
cd /root/gzmnet
npm install --production --no-optional --no-audit --no-fund --loglevel=error express socket.io express-session better-sqlite3 better-sqlite3-session-store qrcode web-push canvas > /dev/null 2>&1 || npm install --production --no-optional --no-audit --no-fund --loglevel=error express socket.io express-session better-sqlite3 qrcode web-push > /dev/null 2>&1
node init-db.js || true

systemctl disable --now xray.service 2>/dev/null || true
systemctl stop gzmnet-xray.service 2>/dev/null || true
pkill -9 -f "^/usr/local/bin/xray run " 2>/dev/null || true
cat > /etc/systemd/system/gzmnet-xray.service <<'XRAYSVC'
[Unit]
Description=GZMNET Xray core
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0
[Service]
Type=simple
Environment=XRAY_LOCATION_ASSET=/usr/local/share/xray
ExecStart=/usr/local/bin/xray run -config /usr/local/etc/xray/config.json
Restart=always
RestartSec=3s
OOMScoreAdjust=-900
Nice=-5
CPUWeight=1000
CPUAccounting=true
MemoryAccounting=true
TasksMax=infinity
LimitNOFILE=1048576
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
XRAYSVC
cat > /etc/systemd/system/gzmnet.service <<'GZMSVC'
[Unit]
Description=GZMNET VPN Panel
After=network-online.target gzmnet-xray.service
Wants=network-online.target
[Service]
Type=simple
WorkingDirectory=/root/gzmnet
Environment=NODE_ENV=production
ExecStart=/usr/bin/node --max-old-space-size=256 /root/gzmnet/app.js
Restart=on-failure
RestartSec=5s
LimitNOFILE=1048576
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gzmnet
CPUWeight=100
[Install]
WantedBy=multi-user.target
GZMSVC
systemctl daemon-reload
systemctl enable gzmnet-xray.service gzmnet.service


# =================== SSL ÚNICAMENTE CON ZEROSSL ===================
echo ""
echo "============================================================="
echo "  Configurando Nginx y certificado SSL (ZeroSSL)"
echo "============================================================="

CERT_FILE="/etc/nginx/ssl/$DOMAIN.crt"
KEY_FILE="/etc/nginx/ssl/$DOMAIN.key"
NEED_ISSUE=0
SSL_SUCCESS=0

if [ -f "$CERT_FILE" ] && [ -f "$KEY_FILE" ] && [ -s "$CERT_FILE" ] && [ -s "$KEY_FILE" ]; then
    START_DATE=$(openssl x509 -in "$CERT_FILE" -noout -startdate 2>/dev/null | sed 's/notBefore=//')
    START_TS=$(date -d "$START_DATE" +%s 2>/dev/null || echo 0)
    END_DATE=$(openssl x509 -in "$CERT_FILE" -noout -enddate 2>/dev/null | sed 's/notAfter=//')
    END_TS=$(date -d "$END_DATE" +%s 2>/dev/null || echo 0)
    NOW_TS=$(date +%s)
    CERT_HOST_OK=0
    if openssl x509 -in "$CERT_FILE" -noout -checkhost "$DOMAIN" 2>/dev/null | grep -q "does match"; then CERT_HOST_OK=1; fi
    if [ "$START_TS" -gt 0 ] && [ "$END_TS" -gt "$NOW_TS" ] && [ "$CERT_HOST_OK" -eq 1 ]; then
        DAYS_OLD=$(( (NOW_TS - START_TS) / 86400 ))
        DAYS_LEFT=$(( (END_TS - NOW_TS) / 86400 ))
        if [ "$DAYS_OLD" -lt 50 ] && [ "$DAYS_LEFT" -gt 40 ]; then
            echo ">>> ✓ Certificado válido ($DAYS_OLD días, $DAYS_LEFT restantes)"
            SSL_SUCCESS=1
        else
            echo ">>> Certificado requiere renovación, reemitiendo con ZeroSSL..."
            NEED_ISSUE=1
        fi
    else
        echo ">>> Certificado inválido o expirado, reemitiendo con ZeroSSL..."
        NEED_ISSUE=1
    fi
else
    echo ">>> No existe certificado, emitiendo con ZeroSSL..."
    NEED_ISSUE=1
fi

if [ "$NEED_ISSUE" -eq 1 ]; then
    {
        if [ -f "/root/gzmnet/data/vpn.sqlite" ]; then
            XRAY_ON_80=$(sqlite3 "/root/gzmnet/data/vpn.sqlite" "SELECT COUNT(*) FROM inbounds WHERE port = 80" 2>/dev/null || echo 0)
            if [ "$XRAY_ON_80" -gt 0 ]; then
                systemctl stop gzmnet-xray.service 2>/dev/null || true
            fi
        fi
        systemctl stop nginx 2>/dev/null || true
        systemctl stop apache2 2>/dev/null || true
        pkill -9 nginx 2>/dev/null || true
        pkill -9 apache2 2>/dev/null || true
    } > /dev/null 2>&1
    sleep 2

    for i in {1..15}; do
        if ! ss -tln | grep -q ':80 '; then break; fi
        fuser -k -9 80/tcp 2>/dev/null || true
        sleep 2
    done

    export LE_WORKING_DIR="/root/.acme.sh"
    ufw allow 80/tcp >/dev/null 2>&1 || true

    echo ">>> Registrando cuenta ZeroSSL..."
    /root/.acme.sh/acme.sh --register-account -m "admin@$DOMAIN" --server zerossl --force > /tmp/acme-zerossl-register.log 2>&1
    if [ $? -ne 0 ]; then
        /root/.acme.sh/acme.sh --register-account -m "gzmnet@$DOMAIN" --server zerossl --force > /tmp/acme-zerossl-register.log 2>&1 || true
    fi

    echo ">>> Emitiendo certificado ZeroSSL (ECC)..."
    for attempt in 1 2 3; do
        echo "    Intento $attempt/3..."
        fuser -k -9 80/tcp 2>/dev/null || true
        sleep 3
        timeout 300 /root/.acme.sh/acme.sh --issue -d "$DOMAIN" --standalone --server zerossl --keylength ec-256 --force --accountemail "admin@$DOMAIN" > /tmp/ssl-zerossl-ecc.log 2>&1
        if [ $? -eq 0 ]; then
            /root/.acme.sh/acme.sh --install-cert -d "$DOMAIN" --ecc \
                --key-file "$KEY_FILE" \
                --fullchain-file "$CERT_FILE" > /tmp/ssl-install-ecc.log 2>&1
            if [ -f "$CERT_FILE" ] && [ -f "$KEY_FILE" ] && [ -s "$CERT_FILE" ] && [ -s "$KEY_FILE" ]; then
                if openssl x509 -in "$CERT_FILE" -noout -checkhost "$DOMAIN" 2>/dev/null | grep -q "does match"; then
                    SSL_SUCCESS=1
                    echo ">>> ✓ ZeroSSL ECC emitido correctamente"
                    break
                fi
            fi
        fi
        sleep 8
    done

    if [ "$SSL_SUCCESS" -eq 0 ]; then
        echo ">>> ECC falló, intentando ZeroSSL RSA..."
        for attempt in 1 2 3; do
            echo "    Intento RSA $attempt/3..."
            fuser -k -9 80/tcp 2>/dev/null || true
            sleep 3
            timeout 300 /root/.acme.sh/acme.sh --issue -d "$DOMAIN" --standalone --server zerossl --keylength 2048 --force --accountemail "admin@$DOMAIN" > /tmp/ssl-zerossl-rsa.log 2>&1
            if [ $? -eq 0 ]; then
                /root/.acme.sh/acme.sh --install-cert -d "$DOMAIN" \
                    --key-file "$KEY_FILE" \
                    --fullchain-file "$CERT_FILE" > /tmp/ssl-install-rsa.log 2>&1
                if [ -f "$CERT_FILE" ] && [ -f "$KEY_FILE" ] && [ -s "$CERT_FILE" ] && [ -s "$KEY_FILE" ]; then
                    if openssl x509 -in "$CERT_FILE" -noout -checkhost "$DOMAIN" 2>/dev/null | grep -q "does match"; then
                        SSL_SUCCESS=1
                        echo ">>> ✓ ZeroSSL RSA emitido correctamente"
                        break
                    fi
                fi
            fi
            sleep 8
        done
    fi

    if [ -f "/root/gzmnet/data/vpn.sqlite" ]; then
        XRAY_ON_80=$(sqlite3 "/root/gzmnet/data/vpn.sqlite" "SELECT COUNT(*) FROM inbounds WHERE port = 80" 2>/dev/null || echo 0)
        if [ "$XRAY_ON_80" -gt 0 ]; then
            echo ">>> Restaurando Xray en puerto 80..."
            systemctl restart gzmnet-xray.service >/dev/null 2>&1 || true
            sleep 5
        fi
    fi
fi

# ============ CONFIGURAR NGINX ============
rm -f /etc/nginx/sites-enabled/default 2>/dev/null || true
mkdir -p /etc/nginx/sites-available /etc/nginx/sites-enabled

PANEL_MODE=""
NGINX_IPV6_LISTEN_HTTPS=""
NGINX_IPV6_LISTEN_HTTP=""
if [ -s /proc/net/if_inet6 ]; then NGINX_IPV6_LISTEN_HTTPS="listen [::]:$PANEL_PORT ssl http2;"; NGINX_IPV6_LISTEN_HTTP="listen [::]:8443;"; fi
if [ "$SSL_SUCCESS" -eq 1 ] && [ -f "$CERT_FILE" ] && [ -f "$KEY_FILE" ] && [ -s "$CERT_FILE" ] && [ -s "$KEY_FILE" ]; then
    PANEL_MODE="https"
    cat > /etc/nginx/sites-available/gzmnet <<EOF
server {
    listen $PANEL_PORT ssl http2;
    $NGINX_IPV6_LISTEN_HTTPS
    server_name $DOMAIN;
    client_max_body_size 100M;
    ssl_certificate $CERT_FILE;
    ssl_certificate_key $KEY_FILE;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'HIGH:!aNULL:!MD5';
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    location /static/ { alias /root/gzmnet/public/; expires 1d; access_log off; }
    location / { proxy_pass http://127.0.0.1:3000; proxy_http_version 1.1; proxy_set_header Upgrade \$http_upgrade; proxy_set_header Connection 'upgrade'; proxy_set_header Host \$host; proxy_set_header X-Real-IP \$remote_addr; proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto \$scheme; proxy_connect_timeout 15s; proxy_send_timeout 150s; proxy_read_timeout 150s; proxy_buffering off; }
    location /socket.io/ { proxy_pass http://127.0.0.1:3000/socket.io/; proxy_http_version 1.1; proxy_set_header Upgrade \$http_upgrade; proxy_set_header Connection "upgrade"; proxy_set_header Host \$host; proxy_read_timeout 86400s; }
}
EOF
    (crontab -l 2>/dev/null | grep -v acme.sh; echo "0 0 * * * /root/.acme.sh/acme.sh --cron --home /root/.acme.sh > /dev/null 2>&1") | crontab -
    echo ">>> Panel HTTPS configurado en puerto $PANEL_PORT"
else
    # FIX: Nginx fallback NO usa puerto 80 (conflictúa con Xray). Usa 8443 en HTTP.
    PANEL_MODE="http"
    cat > /etc/nginx/sites-available/gzmnet <<EOF
server {
    listen 8443;
    $NGINX_IPV6_LISTEN_HTTP
    server_name $DOMAIN;
    client_max_body_size 100M;
    location /static/ { alias /root/gzmnet/public/; expires 1d; access_log off; }
    location / { proxy_pass http://127.0.0.1:3000; proxy_http_version 1.1; proxy_set_header Upgrade \$http_upgrade; proxy_set_header Connection 'upgrade'; proxy_set_header Host \$host; proxy_set_header X-Real-IP \$remote_addr; proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto \$scheme; proxy_connect_timeout 15s; proxy_send_timeout 150s; proxy_read_timeout 150s; proxy_buffering off; }
    location /socket.io/ { proxy_pass http://127.0.0.1:3000/socket.io/; proxy_http_version 1.1; proxy_set_header Upgrade \$http_upgrade; proxy_set_header Connection "upgrade"; proxy_set_header Host \$host; proxy_read_timeout 86400s; }
}
EOF
    echo ">>> ADVERTENCIA: ZeroSSL no pudo emitir el certificado."
    echo ">>> Panel accesible por HTTP: http://$DOMAIN:8443 (puerto 80 libre para Xray)"
    echo ">>> Puedes reintentar la emisión con: /usr/local/bin/gzmnet-renew-cert.sh"
fi

ln -sf /etc/nginx/sites-available/gzmnet /etc/nginx/sites-enabled/
systemctl start nginx
nginx -t && systemctl reload nginx || { echo "ERROR nginx"; journalctl -xeu nginx.service -n 20 --no-pager; }

# =================== SCRIPT DE RENOVACIÓN SSL ===================
cat > /usr/local/bin/gzmnet-renew-cert.sh <<'RENEWEOF'
#!/bin/bash
DOMAIN="__DOMAIN__"
CERT_FILE="/etc/nginx/ssl/$DOMAIN.crt"
KEY_FILE="/etc/nginx/ssl/$DOMAIN.key"
LOG="/root/gzmnet/data/cert-renew.log"
LOCK="/root/gzmnet/data/ssl-renew.lock"

mkdir -p /root/gzmnet/data
echo "[$(date)] === Verificando certificado SSL ===" >> "$LOG"

NEED_ISSUE=0
if [ -f "$CERT_FILE" ] && [ -f "$KEY_FILE" ] && [ -s "$CERT_FILE" ] && [ -s "$KEY_FILE" ]; then
    START_DATE=$(openssl x509 -in "$CERT_FILE" -noout -startdate 2>/dev/null | sed 's/notBefore=//')
    START_TS=$(date -d "$START_DATE" +%s 2>/dev/null || echo 0)
    END_DATE=$(openssl x509 -in "$CERT_FILE" -noout -enddate 2>/dev/null | sed 's/notAfter=//')
    END_TS=$(date -d "$END_DATE" +%s 2>/dev/null || echo 0)
    NOW_TS=$(date +%s)
    CERT_HOST_OK=0
    if openssl x509 -in "$CERT_FILE" -noout -checkhost "$DOMAIN" 2>/dev/null | grep -q "does match"; then CERT_HOST_OK=1; fi
    if [ "$START_TS" -gt 0 ] && [ "$END_TS" -gt "$NOW_TS" ] && [ "$CERT_HOST_OK" -eq 1 ]; then
        DAYS_OLD=$(( (NOW_TS - START_TS) / 86400 ))
        DAYS_LEFT=$(( (END_TS - NOW_TS) / 86400 ))
        echo "[$(date)] Certificado válido: $DAYS_OLD días de antigüedad, $DAYS_LEFT restantes" >> "$LOG"
        if [ "$DAYS_OLD" -lt 50 ]; then
            echo "[$(date)] Certificado joven (<50 días). Saltando renovación." >> "$LOG"
            exit 0
        fi
    else
        echo "[$(date)] Certificado inválido o expirado, requiere reemisión" >> "$LOG"
        NEED_ISSUE=1
    fi
else
    echo "[$(date)] No hay certificado, requiere emisión" >> "$LOG"
    NEED_ISSUE=1
fi

exec 200>"$LOCK"
if ! flock -n 200; then
    echo "[$(date)] Otra renovación en curso, saliendo." >> "$LOG"
    exit 0
fi

{
    if [ -f "/root/gzmnet/data/vpn.sqlite" ]; then
        XRAY_ON_80=$(sqlite3 "/root/gzmnet/data/vpn.sqlite" "SELECT COUNT(*) FROM inbounds WHERE port = 80" 2>/dev/null || echo 0)
        if [ "$XRAY_ON_80" -gt 0 ]; then
            systemctl stop gzmnet-xray.service 2>/dev/null || true
        fi
    fi
    systemctl stop nginx 2>/dev/null || true
    systemctl stop apache2 2>/dev/null || true
    pkill -9 nginx 2>/dev/null || true
    pkill -9 apache2 2>/dev/null || true
} > /dev/null 2>&1
sleep 2

for i in {1..10}; do
    if ! ss -tln | grep -q ':80 '; then break; fi
    fuser -k -9 80/tcp 2>/dev/null || true
    sleep 2
done

export LE_WORKING_DIR="/root/.acme.sh"
/root/.acme.sh/acme.sh --register-account -m "admin@$DOMAIN" --server zerossl --force > /dev/null 2>&1 || true

echo "[$(date)] Renovando con ZeroSSL ECC..." >> "$LOG"
/root/.acme.sh/acme.sh --renew -d "$DOMAIN" --ecc --server zerossl --force >> "$LOG" 2>&1
RENEW_ECC_OK=$?

if [ $RENEW_ECC_OK -ne 0 ]; then
    echo "[$(date)] ECC falló, intentando RSA..." >> "$LOG"
    /root/.acme.sh/acme.sh --renew -d "$DOMAIN" --server zerossl --force >> "$LOG" 2>&1
fi

/root/.acme.sh/acme.sh --install-cert -d "$DOMAIN" --ecc \
    --key-file "$KEY_FILE" \
    --fullchain-file "$CERT_FILE" 2>/dev/null || \
/root/.acme.sh/acme.sh --install-cert -d "$DOMAIN" \
    --key-file "$KEY_FILE" \
    --fullchain-file "$CERT_FILE" 2>/dev/null

if [ -f "/root/gzmnet/data/vpn.sqlite" ]; then
    XRAY_ON_80=$(sqlite3 "/root/gzmnet/data/vpn.sqlite" "SELECT COUNT(*) FROM inbounds WHERE port = 80" 2>/dev/null || echo 0)
    if [ "$XRAY_ON_80" -gt 0 ]; then
        systemctl restart gzmnet-xray.service 2>/dev/null || true
        sleep 5
    fi
fi
systemctl start nginx 2>/dev/null || true
nginx -t && systemctl reload nginx 2>/dev/null || systemctl restart nginx 2>/dev/null || true

echo "[$(date)] === Renovación completada ===" >> "$LOG"
RENEWEOF

sed -i "s/__DOMAIN__/$DOMAIN/g" /usr/local/bin/gzmnet-renew-cert.sh
chmod +x /usr/local/bin/gzmnet-renew-cert.sh

(crontab -l 2>/dev/null | grep -v "gzmnet-renew-cert"; echo "0 4 * * * /usr/local/bin/gzmnet-renew-cert.sh") | crontab -

# =================== FIREWALL ===================
echo "Configurando UFW..."
ufw default deny incoming > /dev/null 2>&1
ufw default allow outgoing > /dev/null 2>&1
ufw allow 22/tcp > /dev/null 2>&1
ufw allow 80/tcp > /dev/null 2>&1
ufw allow $PANEL_PORT/tcp > /dev/null 2>&1
ufw allow 8443/tcp > /dev/null 2>&1
if [ -f "/root/gzmnet/data/vpn.sqlite" ]; then
    PORTS=$(sqlite3 "/root/gzmnet/data/vpn.sqlite" "SELECT DISTINCT port FROM inbounds;" 2>/dev/null | sort -u | tr '\n' ' ')
    for p in $PORTS; do ufw allow ${p}/tcp > /dev/null 2>&1; ufw allow ${p}/udp > /dev/null 2>&1; done
fi
for p in 2053 2083 2087 2096 8080; do ufw allow ${p}/tcp > /dev/null 2>&1; ufw allow ${p}/udp > /dev/null 2>&1; done
ufw --force enable > /dev/null 2>&1
ufw reload > /dev/null 2>&1

cat > /usr/local/bin/gzmnet-uninstall <<'UNINSTALL'
#!/bin/bash
set -e
if [ "${1:-}" != "--yes" ]; then
  echo "Esto elimina GZMNET completo: panel, base de datos, Xray/WARP del panel, certificados y configuración propia de Nginx. No se puede deshacer."
  read -r -p "Escribe ELIMINAR para continuar: " answer
  [ "$answer" = "ELIMINAR" ] || { echo "Cancelado"; exit 1; }
fi
DOMAIN=$(jq -r '.domain // empty' /root/gzmnet/vpn_config.json 2>/dev/null | sed 's/[^A-Za-z0-9.-]//g' || true)
PANEL_PORT=$(jq -r '.panelPort // empty' /root/gzmnet/vpn_config.json 2>/dev/null || true)
if [ -f /root/gzmnet/data/vpn.sqlite ] && command -v sqlite3 >/dev/null 2>&1; then
  for port in $(sqlite3 /root/gzmnet/data/vpn.sqlite 'SELECT DISTINCT port FROM inbounds' 2>/dev/null); do ufw delete allow "$port/tcp" >/dev/null 2>&1 || true; ufw delete allow "$port/udp" >/dev/null 2>&1 || true; done
fi
[ -n "$PANEL_PORT" ] && ufw delete allow "$PANEL_PORT/tcp" >/dev/null 2>&1 || true
ufw delete allow 8443/tcp >/dev/null 2>&1 || true
(crontab -l 2>/dev/null | grep -v 'gzmnet-renew-cert.sh' | crontab -) 2>/dev/null || true
systemctl disable --now gzmnet.service gzmnet-xray.service wireproxy.service 2>/dev/null || true
rm -f /etc/systemd/system/gzmnet.service /etc/systemd/system/gzmnet-xray.service /etc/systemd/system/wireproxy.service
rm -f /usr/local/bin/gzm /usr/local/bin/gzmnet-uninstall /usr/local/bin/gzmnet-renew-cert.sh /usr/local/bin/xray /usr/local/bin/wireproxy /usr/local/bin/wgcf
rm -f /etc/nginx/conf.d/gzmnet*.conf /etc/nginx/sites-enabled/gzmnet* /etc/nginx/sites-available/gzmnet*
if [ -f /etc/nginx/nginx.conf.gzmnet.bak ]; then cp -a /etc/nginx/nginx.conf.gzmnet.bak /etc/nginx/nginx.conf; rm -f /etc/nginx/nginx.conf.gzmnet.bak; fi
[ -n "$DOMAIN" ] && rm -f "/etc/nginx/ssl/$DOMAIN.crt" "/etc/nginx/ssl/$DOMAIN.key"
rm -rf /etc/wireproxy /usr/local/etc/xray /usr/local/share/xray /root/gzmnet
systemctl daemon-reload
systemctl restart nginx 2>/dev/null || true
echo "GZMNET y sus componentes propios se desinstalaron. Los paquetes generales y las reglas base de UFW se conservan para no afectar otros servicios."
UNINSTALL
chmod 700 /usr/local/bin/gzmnet-uninstall

# =================== MENÚ GZM ===================
cat > /usr/local/bin/gzm <<'GZMENU'
#!/bin/bash
DIR="/root/gzmnet"
CONFIG="$DIR/config.json"
[ ! -d "$DIR" ] && { echo "No instalado"; exit 1; }
get_domain(){ sed -n 's/.*"domain"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$DIR/vpn_config.json" | head -1; }
get_port(){ sed -n 's/.*"panelPort"[[:space:]]*:[[:space:]]*\([0-9]*\).*/\1/p' "$DIR/vpn_config.json" | head -1; }
get_user(){ sed -n 's/.*"adminUser"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$CONFIG" | head -1; }
get_tz(){ sed -n 's/.*"timezone"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$DIR/vpn_config.json" | head -1; }
menu(){
    clear
    echo "============================================================="
    echo "  GZMNET VPN PANEL v0.0.2"
    echo "============================================================="
    echo " DOMINIO: $(get_domain)"
    echo " PUERTO:  $(get_port)"
    echo " USUARIO: $(get_user)"
    echo " ZONA:    $(get_tz)"
    echo "============================================================="
    echo " 1) REINICIAR PANEL"
    echo " 2) REINICIAR XRAY"
    echo " 3) ESTADO SYSTEMD"
    echo " 4) TEST CONFIG XRAY (diagnóstico completo)"
    echo " 5) LOGS DEL PANEL (200 líneas)"
    echo " 6) LOGS XRAY (200 líneas)"
    echo " 7) ESTADO WARP"
    echo " 8) VER FIREWALL"
    echo " 9) TEST NGINX"
    echo " U) DESINSTALAR GZMNET COMPLETO"
    echo " S) VERIFICAR CERTIFICADO SSL"
    echo " R) RENOVAR CERTIFICADO SSL AHORA"
    echo " 0) SALIR"
    read -p "OPCION: " ch
    case $ch in
        1) systemctl restart gzmnet.service; echo "OK"; sleep 1 ;;
        2) systemctl restart gzmnet-xray.service; echo "OK"; sleep 1 ;;
        3) systemctl status gzmnet.service gzmnet-xray.service --no-pager; read ;;
        4) /usr/local/bin/xray run -test -config /usr/local/etc/xray/config.json 2>&1 | tail -100; read ;;
        5) journalctl -u gzmnet.service -n 200 --no-pager; read ;;
        6) journalctl -u gzmnet-xray.service -n 200 --no-pager; read ;;
        7) systemctl status wireproxy --no-pager | head -10 2>/dev/null || echo "No instalado"; read ;;
        8) ufw status numbered; read ;;
        9) nginx -t; read ;;
        U|u) /usr/local/bin/gzmnet-uninstall ;;
        S|s) DOM=$(get_domain); echo "=== Certificado ==="; openssl x509 -in "/etc/nginx/ssl/$DOM.crt" -noout -subject -dates -issuer 2>/dev/null; openssl x509 -in "/etc/nginx/ssl/$DOM.crt" -noout -checkhost "$DOM" 2>/dev/null; read ;;
        R|r) /usr/local/bin/gzmnet-renew-cert.sh; echo "Log: /root/gzmnet/data/cert-renew.log"; tail -20 /root/gzmnet/data/cert-renew.log; read ;;
        0) exit 0 ;;
    esac
    menu
}
menu
GZMENU
chmod +x /usr/local/bin/gzm

# =================== REINICIO FINAL ===================
systemctl daemon-reload
systemctl enable gzmnet-xray.service
systemctl restart gzmnet-xray.service

echo ">>> Esperando a que Xray arranque..."
for i in {1..30}; do
    if ss -tln 2>/dev/null | grep -q ':10085 '; then
        echo ">>> Xray listo (API activo)"
        break
    fi
    sleep 1
done

systemctl enable --now gzmnet.service
systemctl restart gzmnet.service

echo ""
echo "============================================================="
echo "  INSTALACION COMPLETADA v0.0.2"
echo " LOGS: journalctl -u gzmnet.service -n 200 --no-pager"
echo "============================================================="
if [ "$PANEL_MODE" = "https" ]; then
    echo " PANEL:   $PANEL_URL  ✅ HTTPS (ZeroSSL)"
else
    echo " PANEL:   http://$DOMAIN:8443  ⚠️  (ZeroSSL no emitió)"
    echo "          Puerto 80 LIBRE para Xray"
fi
echo " USUARIO: $ADMIN_USER"
echo " PUERTO:  $PANEL_PORT"
echo " ZONA:    $SERVER_TZ"
echo " COMANDO: gzm"
echo "============================================================="
