const PROTOCOL_TRANSPORTS = {
    vless: ['raw', 'xhttp', 'grpc', 'ws', 'httpupgrade', 'kcp'],
    vmess: ['raw', 'xhttp', 'grpc', 'ws', 'httpupgrade', 'kcp'],
    trojan: ['raw', 'xhttp', 'grpc', 'ws', 'httpupgrade', 'kcp'],
    shadowsocks: ['raw', 'xhttp', 'grpc', 'ws', 'httpupgrade', 'kcp'],
    socks: ['raw'],
    http: ['raw']
};
const REALITY_TRANSPORTS = ['raw','xhttp','grpc'];
const realityFallbackLogged = new Set();
function normalizeXrayTransport(network){const n=String(network||'ws').trim().toLowerCase();if(n==='tcp')return 'raw';if(['h2','http','quic'].includes(n))return 'xhttp';return n}
function effectiveXhttpMode(security,mode){const m=String(mode||'auto').toLowerCase();if(m!=='auto'&&['packet-up','stream-up','stream-one'].includes(m))return m;return security==='reality'?'stream-one':'packet-up'}
const PROTOCOL_SECURITIES = {
    vless: ['none', 'tls', 'reality'],
    vmess: ['none', 'tls', 'reality'],
    trojan: ['none', 'tls', 'reality'],
    shadowsocks: ['none', 'tls'],
    socks: ['none', 'tls'],
    http: ['none', 'tls']
};
function protocolHasUuid(proto) { return ['vless','vmess','trojan','shadowsocks'].includes(proto); }
function protocolHasSub(proto) { return ['vless','vmess','trojan','shadowsocks'].includes(proto); }
function protocolUsesAuth(proto) { return ['socks','http'].includes(proto); }
function credentialTypeBackend(proto) {
    if (['socks','http'].includes(proto)) return 'auth';
    if (['vless','vmess'].includes(proto)) return 'uuid';
    if (['trojan','shadowsocks'].includes(proto)) return 'password';
    return 'unknown';
}

// FIX: removed mark:255 (was causing routing conflicts), better sockopt for upload speed
function getOptimizedSockopt() {
    return {
        tcpFastOpen: true,
        tcpNoDelay: true,
        tcpKeepAliveIdle: 100,
        tcpKeepAliveInterval: 30,
        tcpUserTimeout: 30000,
        tcpcongestion: 'bbr'
    };
}

function normalizeValues(rawValue, type) {
    if (!rawValue) return [];
    const parts = String(rawValue).split(/[,;\n]+/).map(x => x.trim()).filter(Boolean);
    if (type === 'geosite') return parts.map(v => { if (v.startsWith('geosite:')) return v; if (v.startsWith('domain:') || v.startsWith('full:') || v.startsWith('regexp:')) return v; if (v.includes('.')) return 'domain:' + v; return 'geosite:' + v.toLowerCase(); });
    if (type === 'geoip') return parts.map(v => v.startsWith('geoip:') ? v : 'geoip:' + v);
    if (type === 'domain') return parts.map(d => { if (d.startsWith('domain:') || d.startsWith('full:') || d.startsWith('regexp:') || d.startsWith('geosite:')) return d; if (d.includes('.')) return 'domain:' + d; if (KNOWN_GEOSITE_TAGS.has(d.toLowerCase())) return 'geosite:' + d.toLowerCase(); return 'domain:' + d; });
    return parts;
}
function ipTypeToQueryStrategy(ipType) { switch(ipType) { case 'ipv4': return 'UseIPv4'; case 'ipv6': return 'UseIPv6'; default: return 'UseIP'; } }
function validateSelectedNetwork(ipType){if(ipType!=='ipv6')return {ok:true};try{const addrs=execFileSync('ip',['-6','addr','show','scope','global'],{timeout:2500,encoding:'utf8',stdio:['ignore','pipe','ignore']});const usable=addrs.split(/\r?\n/).some(line=>/inet6\s+(?!fe80:|::1)([0-9a-f:]+)/i.test(line)&&!/(tentative|deprecated|dadfailed)/i.test(line));if(!usable)return {ok:false,error:'Solo IPv6 no se puede activar: el VPS no tiene una dirección IPv6 global activa.'};const route=execFileSync('ip',['-6','route','get','2606:4700:4700::1111'],{timeout:2500,encoding:'utf8',stdio:['ignore','pipe','ignore']});if(!/\bdev\s+\S+/.test(route)||/\bunreachable\b|\bprohibit\b|\bblackhole\b/.test(route))return {ok:false,error:'Solo IPv6 no se puede activar: el VPS no tiene una ruta IPv6 de salida válida.'};return {ok:true}}catch(e){return {ok:false,error:'No pude validar la ruta IPv6 del VPS. Se conserva el tipo de red anterior; comprueba que el proveedor haya habilitado IPv6.'}}}
function ipTypeToOutboundStrategy(ipType) { switch(ipType){case 'ipv4':return 'ForceIPv4';case 'ipv6':return 'ForceIPv6';default:return 'UseIP';} }


function buildRuleFromCustom(r, useWarp) {
    const out = [];
    let outbound = r.outbound || "direct";
    if (outbound === 'proxy') outbound = useWarp ? 'warp' : 'direct';
    if (outbound === 'warp' && !useWarp) outbound = 'direct';
    if (!['block', 'direct', 'warp'].includes(outbound)) outbound = 'direct';
    let conditions = [];
    try { if (r.match_rules && String(r.match_rules).trim()) { conditions = JSON.parse(r.match_rules); if (!Array.isArray(conditions)) conditions = []; } } catch(e) { conditions = []; }
    if (!conditions.length && r.value) {
        let t = r.match_type || 'domain';
        if (t === 'auto') {
            const raw0 = String(r.value).split(/[,;\n]+/).map(x => x.trim()).filter(Boolean)[0] || '';
            t = (!raw0.includes('.') && !raw0.includes(':') && !/^\d/.test(raw0)) ? 'geosite' : 'domain';
        }
        conditions.push({ type: t, value: r.value });
    }
    const baseRule = { type: "field", outboundTag: outbound };
    let hasContent = false, explicitPorts = null, explicitProtocols = null;
    for (const cond of conditions) {
        let value = cond.value;
        if (Array.isArray(value)) value = value.join(',');
        value = String(value || '').trim();
        if (!value && cond.type !== 'protocol') continue;
        let tpe = cond.type || 'domain';
        if (tpe === 'auto') {
            const raw0 = value.split(/[,;\n]+/).map(x => x.trim()).filter(Boolean)[0] || '';
            tpe = (!raw0.includes('.') && !raw0.includes(':') && !/^\d/.test(raw0)) ? 'geosite' : 'domain';
        }
        if (tpe === 'domain' || tpe === 'geosite') {
            const values = normalizeValues(value, tpe === 'geosite' ? 'geosite' : 'domain');
            if (values.length) { if (!baseRule.domain) baseRule.domain = []; baseRule.domain.push(...values); hasContent = true; }
        } else if (tpe === 'geoip' || tpe === 'ip') {
            const values = normalizeValues(value, tpe === 'geoip' ? 'geoip' : 'ip');
            if (values.length) { if (!baseRule.ip) baseRule.ip = []; baseRule.ip.push(...values); hasContent = true; }
        } else if (tpe === 'port') {
            explicitPorts = value; hasContent = true;
        } else if (tpe === 'protocol') {
            const protocols = Array.isArray(cond.value) ? cond.value.map(x => String(x).trim().toLowerCase()).filter(Boolean)
                : String(cond.value || value).split(',').map(x => x.trim().toLowerCase()).filter(Boolean);
            if (protocols.length) { explicitProtocols = protocols; hasContent = true; }
        } else if (tpe === 'network') {
            baseRule.network = value; hasContent = true;
        }
    }
    if (explicitPorts) baseRule.port = explicitPorts;
    if (explicitProtocols) baseRule.protocol = explicitProtocols;
    if (!hasContent) return out;
    out.push(baseRule);
    return out;
}

// FIX: YouTube ads block rule goes BEFORE warp rule (priority)
function buildXrayRouting(options={}) {
    const rules=[];
    const s=vpnDb.prepare('SELECT * FROM routing_settings WHERE id=1').get()||{};
    const customRules=vpnDb.prepare('SELECT * FROM routing_rules WHERE enabled=1 ORDER BY priority DESC,id ASC').all();
    const globalWarp=Number(s.warp_enabled)===1;
    const routingClients=vpnDb.prepare(`SELECT c.id,c.inbound_id,c.routing_enabled,c.routing_filters_enabled,c.custom_routing_enabled,i.protocol FROM clients c JOIN inbounds i ON i.id=c.inbound_id WHERE c.enabled=1`).all();
    const emails=rows=>rows.map(c=>`c${Number(c.id)}`).filter(Boolean),authTags=rows=>[...new Set(rows.map(c=>`ib-${Number(c.inbound_id)}`))];
    const routingOffUsers=emails(routingClients.filter(c=>!protocolUsesAuth(c.protocol)&&Number(c.routing_enabled??1)!==1));
    const filterUsers=emails(routingClients.filter(c=>!protocolUsesAuth(c.protocol)&&Number(c.routing_enabled??1)===1&&Number(c.routing_filters_enabled??1)!==0));
    const youtubeUsers=emails(routingClients.filter(c=>!protocolUsesAuth(c.protocol)&&Number(c.routing_enabled??1)===1));
    const filterOffUsers=emails(routingClients.filter(c=>!protocolUsesAuth(c.protocol)&&Number(c.routing_enabled??1)===1&&Number(c.routing_filters_enabled??1)===0));
    const customUsers=emails(routingClients.filter(c=>!protocolUsesAuth(c.protocol)&&Number(c.routing_enabled??1)===1&&Number(c.custom_routing_enabled??1)!==0));
    // SOCKS/HTTP have no distinct Xray routing user per account; retain the existing inbound-wide policy and disable per-client controls in their editor.
    const authFilterTags=authTags(routingClients.filter(c=>protocolUsesAuth(c.protocol)&&Number(c.routing_enabled)!==0&&Number(c.routing_filters_enabled??1)!==0));
    const youtubeAuthTags=authTags(routingClients.filter(c=>protocolUsesAuth(c.protocol)&&Number(c.routing_enabled)!==0));
    const youtubeDirectUsers=Number(s.block_youtube_ads)===1?youtubeUsers:(Number(s.block_ads)===1?filterUsers:[]);
    const youtubeDirectAuthTags=Number(s.block_youtube_ads)===1?youtubeAuthTags:(Number(s.block_ads)===1?authFilterTags:[]);
    const youtubeDirectEnabled=Number(s.block_youtube_ads)===1||Number(s.block_ads)===1;
    const authCustomTags=authTags(routingClients.filter(c=>protocolUsesAuth(c.protocol)&&Number(c.routing_enabled)!==0&&Number(c.custom_routing_enabled??1)!==0));
    const applicableCustomRules=customUsers.length||authCustomTags.length?customRules:[];
    const rulesNeedWarp=applicableCustomRules.some(r=>r.outbound==='warp'||r.outbound==='proxy');
    const useWarp=globalWarp||rulesNeedWarp;
    const withUsers=(rule,users)=>users.length?[{...rule,user:users}]:[],withAuth=(rule,tags)=>tags.length?[{...rule,inboundTag:tags}]:[];
    // Keep YouTube DNS lookups off WARP whenever its dedicated control or global ad filter is enabled.
    if(youtubeDirectEnabled)rules.push({type:'field',inboundTag:['dns_inbound'],domain:YOUTUBE_DOMAINS,outboundTag:'direct'});
    // Xray's remaining internal DNS resolver traffic follows the global egress choice.
    rules.push({type:'field',inboundTag:['dns_inbound'],outboundTag:globalWarp?'warp':'direct'});
    // Keep strict address-family policy even for clients that opt out of routing.
    if(s.ip_type==='ipv4')rules.push({type:'field',ip:['::/0'],outboundTag:'block'});
    else if(s.ip_type==='ipv6')rules.push({type:'field',ip:['0.0.0.0/0'],outboundTag:'block'});
    // Full opt-out bypasses WARP, global filters and custom rules for only these clients.
    rules.push(...withUsers({type:'field',network:'tcp,udp',outboundTag:'direct'},routingOffUsers));
    // When built-in filters are disabled for one user, send only that user's DNS directly instead of through globally filtered Xray DNS.
    rules.push(...withUsers({type:'field',network:'tcp,udp',port:'53',outboundTag:'direct'},filterOffUsers));
    rules.push({type:'field',network:'tcp,udp',port:'53',outboundTag:'dns-out'});
    // Private destinations stay direct; per-client filter rules below do not change other clients.
    rules.push({type:'field',ip:['geoip:private'],outboundTag:'direct'});
    if(Number(s.block_youtube_ads)===1){const youtubeUdpPortsRule={type:'field',domain:YOUTUBE_DOMAINS,network:'udp',port:'80,443',outboundTag:'block'};const youtubeUdpAllPortsRule={type:'field',domain:YOUTUBE_DOMAINS,network:'udp',outboundTag:'block'};rules.push(...withUsers(youtubeUdpPortsRule,youtubeUsers),...withAuth(youtubeUdpPortsRule,youtubeAuthTags),...withUsers(youtubeUdpAllPortsRule,youtubeUsers),...withAuth(youtubeUdpAllPortsRule,youtubeAuthTags))}
    if(s.block_ads){const filterRule={type:'field',domain:['geosite:category-ads-all','geosite:youtube@ads',...EXPLICIT_AD_DOMAINS],outboundTag:'block'};rules.push(...withUsers(filterRule,filterUsers),...withAuth(filterRule,authFilterTags))}
    if(s.block_trackers){const filterRule={type:'field',domain:TRACKER_DOMAINS,outboundTag:'block'};rules.push(...withUsers(filterRule,filterUsers),...withAuth(filterRule,authFilterTags))}
    if(s.block_adult){const filterRule={type:'field',domain:['geosite:category-porn'],outboundTag:'block'};rules.push(...withUsers(filterRule,filterUsers),...withAuth(filterRule,authFilterTags))}
    if(s.block_malware){const filterRule={type:'field',domain:MALWARE_DOMAINS.map(d=>d.startsWith('domain:')?d:'domain:'+d),outboundTag:'block'};rules.push(...withUsers(filterRule,filterUsers),...withAuth(filterRule,authFilterTags))}
    if(s.block_bittorrent){const filterRule={type:'field',protocol:['bittorrent'],outboundTag:'block'};rules.push(...withUsers(filterRule,filterUsers),...withAuth(filterRule,authFilterTags))}
    // Keep YouTube TCP on the VPS direct route, not WARP; place after ad denials but before custom rules and the WARP catch-all.
    if(youtubeDirectEnabled){const youtubeTcpDirectRule={type:'field',domain:YOUTUBE_DOMAINS,network:'tcp',outboundTag:'direct'};rules.push(...withUsers(youtubeTcpDirectRule,youtubeDirectUsers),...withAuth(youtubeTcpDirectRule,youtubeDirectAuthTags))}
    // Custom rules are evaluated only for clients that have opted in; global rule state and ordering remain unchanged.
    for(const r of applicableCustomRules)for(const rule of buildRuleFromCustom(r,useWarp))rules.push(...withUsers(rule,customUsers),...withAuth(rule,authCustomTags));
    if(s.prevent_captcha){const captchaRule={type:'field',domain:CAPTCHA_DOMAINS.map(d=>d.startsWith('domain:')?d:'domain:'+d),outboundTag:globalWarp?'warp':'direct'};rules.push(...withUsers(captchaRule,filterUsers),...withAuth(captchaRule,authFilterTags))}
    rules.push({type:'field',network:'tcp,udp',outboundTag:globalWarp?'warp':'direct'});
    return rules;
}

function buildXrayDns(settingsOverride) {
    const s = settingsOverride || vpnDb.prepare('SELECT * FROM routing_settings WHERE id = 1').get() || {};
    const mapDns = (v) => {
        const l = String(v || '').trim().toLowerCase();
        if (!l) return '';
        if (l.includes('adguard')) return '94.140.14.14';
        if (l === 'cloudflare' || l.includes('cloudflare')) return '1.1.1.1';
        if (l === 'google' || l.includes('google')) return '8.8.8.8';
        if (l.includes('quad9')) return '9.9.9.9';
        if (l.includes('opendns') || l.includes('open dns')) return '208.67.222.222';
        // No usar DoH/DoT como address crudo en Xray UDP DNS
        if (l.startsWith('https://') || l.startsWith('tls://') || l.startsWith('quic://')) {
            if (l.includes('adguard')) return '94.140.14.14';
            if (l.includes('cloudflare') || l.includes('1.1.1')) return '1.1.1.1';
            if (l.includes('google') || l.includes('8.8.8')) return '8.8.8.8';
            return '1.1.1.1';
        }
        return String(v).trim();
    };
    const ipType=['ipv4','ipv6','dual'].includes(s.ip_type)?s.ip_type:'dual';
    const strategy=ipTypeToQueryStrategy(ipType);
    const resolverIps=getDnsAddresses({...s,ip_type:ipType});
    const servers=[];
    // Ordered v4 then v6 for Dual; use individual server objects and sequential fallback.
    for(const address of resolverIps)servers.push({address,skipFallback:false,port:53,timeoutMs:4000,queryStrategy:strategy});
    if(!servers.length)throw new Error(`No hay servidores DNS válidos para ${ipType}.`);
    // Use only the configured numeric resolvers; DoH hostname bootstrap is not required.
    const dnsConf={
        servers,
        queryStrategy: strategy,
        disableFallback: false,
        disableFallbackIfMatch: false,
        enableParallelQuery: false,
        disableCache: false,
        tag: "dns_inbound"
    };
    return dnsConf;
}

function buildStreamSettings(ib, domainSni) {
    const streamSettings = {};
    const security = ib.security || (ib.tls ? 'tls' : 'none');
    let network = normalizeXrayTransport(ib.network || 'ws');
    if(['h2','http','quic'].includes(String(ib.network||'').toLowerCase()))logApply(`[TRANSPORT-MIGRATION] inbound=${ib.id} ${ib.network}->xhttp; HTTP/2 and QUIC were removed from current Xray`);
    if (security === 'reality' && !REALITY_TRANSPORTS.includes(network)) { if(!realityFallbackLogged.has(String(ib.id))){logApply(`[REALITY-NETWORK-FIX] inbound=${ib.id} unsupported ${network} -> raw`);realityFallbackLogged.add(String(ib.id));} network='raw'; }
    if (ib.protocol === 'socks' || ib.protocol === 'http') network = 'raw';
    const hostHeader = (ib.host && ib.host.trim()) ? ib.host.trim() : "";
    const wsPath = (ib.path && ib.path.trim()) ? ib.path.trim() : "/";
    const alpnList = (ib.alpn || '').split(',').map(x => x.trim()).filter(Boolean);

    if (network === 'ws') { streamSettings.network = 'ws'; streamSettings.wsSettings = { path: wsPath }; if (hostHeader) streamSettings.wsSettings.headers = { Host: hostHeader }; }
    else if (network === 'httpupgrade') { streamSettings.network = 'httpupgrade'; streamSettings.httpupgradeSettings = { path: wsPath }; if (hostHeader) streamSettings.httpupgradeSettings.host = hostHeader; }
    else if (network === 'raw' || network === 'tcp') { streamSettings.network = 'raw'; streamSettings.rawSettings = {}; }
    else if (network === 'grpc') { streamSettings.network = 'grpc'; streamSettings.grpcSettings = { serviceName: ib.grpc_service || 'grpc', multiMode: ib.grpc_multi == 1 }; }
    else if (network === 'h2' || network === 'http') { streamSettings.network = 'h2'; streamSettings.httpSettings = { path: ib.h2_path || wsPath || '/', host: [ib.h2_host || hostHeader || ''] }; }
    else if (network === 'quic') { streamSettings.network = 'quic'; streamSettings.quicSettings = { security: ib.quic_security || 'none', key: ib.quic_key || '', header: { type: ib.quic_header || 'none' } }; }
    else if (network === 'kcp' || network === 'mkcp') { streamSettings.network = 'kcp'; streamSettings.kcpSettings = { tti: 50, uplinkCapacity: 5, downlinkCapacity: 20, congestion: false, readBufferSize: 1, writeBufferSize: 1, header: { type: ib.kcp_header || 'none' }, seed: ib.kcp_seed || '' }; }
    else if (network === 'xhttp') { streamSettings.network = 'xhttp'; streamSettings.xhttpSettings = { path: ib.xhttp_path || wsPath || '/', host: String(ib.xhttp_host||'').trim(), mode: 'auto' }; }
    else { streamSettings.network = 'ws'; streamSettings.wsSettings = { path: wsPath }; if (hostHeader) streamSettings.wsSettings.headers = { Host: hostHeader }; }

    if (security === 'reality') {
        streamSettings.security = 'reality';
        const serverNames = (ib.reality_server_names || 'www.google.com').split(',').map(x => x.trim()).filter(Boolean);
        const shortIds = (ib.reality_short_ids || generateShortId()).split(',').map(x => x.trim()).filter(Boolean);
        streamSettings.realitySettings = { show: false, dest: ib.reality_dest || 'www.google.com:443', xver: 0, serverNames: serverNames.length ? serverNames : ['www.google.com'], privateKey: ib.reality_private_key || '', shortIds: shortIds.length ? shortIds : [generateShortId()] };
    } else if (security === 'tls' || ib.tls) {
        streamSettings.security = 'tls';
        const certDomain = String(getVpnConfig().domain||'').replace(/[^a-zA-Z0-9.-]/g,'');
        if(!certDomain||!fs.existsSync(`/etc/nginx/ssl/${certDomain}.crt`)||!fs.existsSync(`/etc/nginx/ssl/${certDomain}.key`))throw new Error('Falta certificado TLS del dominio del panel');
        const alpn = alpnList.length ? alpnList : ['h2', 'http/1.1'];
        streamSettings.tlsSettings = { certificates: [{ certificateFile: `/etc/nginx/ssl/${certDomain}.crt`, keyFile: `/etc/nginx/ssl/${certDomain}.key` }], alpn };
    } else { streamSettings.security = 'none'; }
    const currentIpType=(vpnDb.prepare('SELECT ip_type FROM routing_settings WHERE id=1').get()||{}).ip_type||'dual';
    streamSettings.sockopt = {...getOptimizedSockopt(),...(currentIpType==='ipv6'?{v6only:true}:{})};
    return streamSettings;
}

function buildXrayConfig() {
    const inbounds = vpnDb.prepare('SELECT * FROM inbounds ORDER BY id').all();
    const s = vpnDb.prepare('SELECT * FROM routing_settings WHERE id = 1').get() || {};
    const ipType=s.ip_type||'dual';
    const xrayInbounds = [];
    // Domain-based ad and YouTube UDP routing needs sniffing of HTTP, TLS and QUIC; activate it for these filters even when the inbound's saved switch is off.
    const forceRouteSniffing=Number(s.block_ads)===1||Number(s.block_youtube_ads)===1;
    const xrayListenAddress=(ipType==='ipv4')?'0.0.0.0':'::';
    const allClients = vpnDb.prepare('SELECT * FROM clients WHERE enabled = 1').all();
    const clientsByInb = {};
    for (const c of allClients) { if (!clientsByInb[c.inbound_id]) clientsByInb[c.inbound_id] = []; clientsByInb[c.inbound_id].push(c); }
    for (const ib of inbounds) {
        const clients = clientsByInb[ib.id] || [];
        const domainSni = (ib.tls_sni && ib.tls_sni.trim()) ? ib.tls_sni.trim() : (ib.domain&&ib.domain.trim()?ib.domain.trim():"");
        let streamSettings; try { streamSettings = buildStreamSettings(ib, domainSni); } catch(e) { throw new Error(`Servidor ${ib.name||ib.id} (${ib.protocol}:${ib.port}) no se pudo preparar: ${e.message}`); }
        const sniffing = (ib.sniffing||forceRouteSniffing) ? { enabled: true, destOverride: ["http", "tls", "quic"], routeOnly: true } : { enabled: false };
        let inboundObj;
        if (ib.protocol === 'vless') {
            const decryptionKey = (ib.vless_decryption && ib.vless_decryption.trim()) || getVlessDecryptionKey();
            const clientObjs = clients.map(c => { let flow = c.flow || ib.flow || ""; if (flow === 'xtls-rprx-vision' && (ib.network !== 'tcp' && ib.network !== 'raw')) flow = ""; if (flow === 'xtls-rprx-vision' && (streamSettings.security === 'none')) flow = ""; return { id: c.uuid, email: `c${c.id}`, flow }; });
            const settings = { clients: clientObjs, decryption: (decryptionKey && decryptionKey !== 'none') ? decryptionKey : 'none' };
            inboundObj = { tag: `ib-${ib.id}`, listen: xrayListenAddress, port: ib.port, protocol: "vless", settings, streamSettings, sniffing };
        } else if (ib.protocol === 'vmess') {
            const clientObjs = clients.map(c => ({ id: c.uuid, email: `c${c.id}`, alterId: 0 }));
            inboundObj = { tag: `ib-${ib.id}`, listen: xrayListenAddress, port: ib.port, protocol: "vmess", settings: { clients: clientObjs }, streamSettings, sniffing };
        } else if (ib.protocol === 'trojan') {
            const clientObjs = clients.map(c => ({ password: c.uuid, email: `c${c.id}` }));
            const trojanSettings = { clients: clientObjs };
            if (streamSettings.security === 'none') trojanSettings.mux = { enabled: true, concurrency: 8 };
            inboundObj = { tag: `ib-${ib.id}`, listen: xrayListenAddress, port: ib.port, protocol: "trojan", settings: trojanSettings, streamSettings, sniffing };
        } else if (ib.protocol === 'shadowsocks') {
            const method = ib.ss_method || 'aes-256-gcm';
            const clientObjs = clients.map(c => ({ password: c.uuid, email: `c${c.id}`, method }));
            inboundObj = { tag: `ib-${ib.id}`, listen: xrayListenAddress, port: ib.port, protocol: "shadowsocks", settings: { method, clients: clientObjs, network: "tcp,udp" }, streamSettings, sniffing };
        } else if (ib.protocol === 'socks') {
            const users = clients.filter(c => c.auth_user && c.auth_pass).map(c => ({ user: c.auth_user, pass: c.auth_pass }));
            inboundObj = { tag: `ib-${ib.id}`, listen: xrayListenAddress, port: ib.port, protocol: "socks", settings: { auth: users.length ? 'password' : 'noauth', users, udp: true, userLevel: 0 }, streamSettings, sniffing };
        } else if (ib.protocol === 'http') {
            const users = clients.filter(c => c.auth_user && c.auth_pass).map(c => ({ user: c.auth_user, pass: c.auth_pass }));
            inboundObj = { tag: `ib-${ib.id}`, listen: xrayListenAddress, port: ib.port, protocol: "http", settings: { users, userLevel: 0 }, streamSettings, sniffing };
        }
        if (inboundObj) xrayInbounds.push(inboundObj);
    }
    const domainStrategy = s.domain_strategy || 'IPIfNonMatch';
    const routingRules = buildXrayRouting().map((rule,index)=>({...rule,ruleTag:`gzmnet-live-${index}`}));
    const dnsConfig = buildXrayDns();
    const customRules = vpnDb.prepare('SELECT * FROM routing_rules WHERE enabled = 1').all();
    const customRouteClients=vpnDb.prepare(`SELECT COUNT(*) AS n FROM clients c JOIN inbounds i ON i.id=c.inbound_id WHERE c.enabled=1 AND ((i.protocol IN ('socks','http')) OR (COALESCE(c.routing_enabled,1)=1 AND COALESCE(c.custom_routing_enabled,1)=1)) `).get();
    const rulesNeedWarp = Number(customRouteClients&&customRouteClients.n)>0&&customRules.some(r => r.outbound === 'warp' || r.outbound === 'proxy');
    const useWarp = Number(s.warp_enabled)===1 || rulesNeedWarp;
    const optimizedSockopt = getOptimizedSockopt();
    const outbounds = [
        { protocol: "freedom", tag: "direct", settings: {}, streamSettings: { sockopt: { ...optimizedSockopt, domainStrategy: ipTypeToOutboundStrategy(ipType), ...(ipType==='ipv6'?{v6only:true}:{}), ...(ipType==='dual'?{happyEyeballs:{tryDelayMs:250,prioritizeIPv6:false,interleave:1,maxConcurrentTry:4}}:{}) } } },
        { protocol: "blackhole", tag: "block" },
        { protocol: "dns", tag: "dns-out", settings: {} }
    ];
    const dnsOutboundRules=[];
    if(s.block_ads)dnsOutboundRules.push({action:"return",rCode:3,domain:["geosite:category-ads-all","geosite:youtube@ads",...EXPLICIT_AD_DOMAINS]});
    if(s.block_trackers)dnsOutboundRules.push({action:"return",rCode:3,domain:TRACKER_DOMAINS});
    if(s.block_adult)dnsOutboundRules.push({action:"return",rCode:3,domain:["geosite:category-porn"]});
    if(s.block_malware)dnsOutboundRules.push({action:"return",rCode:3,domain:MALWARE_DOMAINS.map(d=>d.startsWith("domain:")?d:"domain:"+d)});
    outbounds.find(o=>o.tag==="dns-out").settings={rules:dnsOutboundRules};
    if(useWarp){const wgSettings=getWarpWireguardSettings();if(!wgSettings)throw new Error('No se puede generar una ruta WARP global segura: falta un perfil WireGuard WARP válido en /etc/wireproxy/wgcf-profile.conf.');outbounds.push({tag:'warp',protocol:'wireguard',settings:wgSettings})}
    return { log: { loglevel: "warning" }, api: { tag: "api", listen: `127.0.0.1:${XRAY_API_PORT}`, services: ["HandlerService", "LoggerService", "StatsService", "RoutingService"] }, stats: {}, dns: dnsConfig, policy: { levels: { "0": { statsUserUplink: true, statsUserDownlink: true } }, system: { statsInboundUplink: true, statsInboundDownlink: true, statsOutboundUplink: true, statsOutboundDownlink: true } }, inbounds: xrayInbounds, outbounds, routing: { domainStrategy, rules: routingRules } };
}

async function validateXrayConfig(configStr) { try { fs.writeFileSync(XRAY_CONFIG_TEST, configStr); } catch(e) { return { ok: false, output: e.message }; } const result = await new Promise(resolve => { exec(`nice -n 19 ionice -c3 ${XRAY_BIN} run -test -config ${XRAY_CONFIG_TEST} 2>&1`, { timeout: 20000, maxBuffer:1024*1024 }, (err, stdout, stderr) => resolve({ ok: !err, output: (stdout || '') + (stderr || '') })); }); try { fs.unlinkSync(XRAY_CONFIG_TEST); } catch(e) {} return result; }

function ufwAllowPort(port) { return new Promise(resolve => { exec(`ufw allow ${port}/tcp >/dev/null 2>&1; ufw allow ${port}/udp >/dev/null 2>&1`, { timeout: 10000 }, () => resolve()); }); }
function ufwDeletePort(port) { return new Promise(resolve => { exec(`ufw delete allow ${port}/tcp >/dev/null 2>&1; ufw delete allow ${port}/udp >/dev/null 2>&1`, { timeout: 10000 }, () => resolve()); }); }

let lastTrafficSnapshot = {};
// Tasas temporales de tráfico en B/s; no alteran el esquema ni contadores persistentes.
let liveTrafficRates = new Map();
let lastActualTrafficAt = new Map();
const clientQuotaBaselinePending = new Set();
let isFirstSnapshot = true;
let statsCache = { data: null, time: 0 };
let totalsCache = { data: null, time: 0 };
const ONLINE_POLL_INTERVAL_MS = 3000;
const ONLINE_TIMEOUT_MS = 35000; // tolera pausas del tráfico y muestras fallidas sin parpadeos; luego caduca si no hay tráfico real
const PUSH_SYNC_PROBE_TTL_SECONDS = 60; // valida una suscripción nueva al enlazarla con este servidor
let isQuerying = false;
let lastStatsDebugLog = 0;

function queryTrafficStats() {
    return new Promise((resolve) => {
        if (!fs.existsSync(XRAY_BIN)) return resolve(null);
        exec(`${XRAY_BIN} api statsquery --server=127.0.0.1:${XRAY_API_PORT} 2>/dev/null`, { timeout: 5000 }, (err, stdout) => {
            if (err || !stdout) return resolve(null);
            const result = {};
            const accountIds = new Map();
            try {
                const authUsers = vpnDb.prepare(`SELECT id, auth_user FROM clients WHERE auth_user IS NOT NULL AND auth_user != ''`).all();
                for (const c of authUsers) {
                    if (accountIds.has(c.auth_user)) accountIds.set(c.auth_user, null);
                    else accountIds.set(c.auth_user, `c${c.id}`);
                }
            } catch(e) {}
            try {
                const json = JSON.parse(stdout);
                for (const s of (json.stat || json.stats || [])) {
                    if (!s || !s.name) continue;
                    const parts = String(s.name).split('>>>');
                    if (parts.length < 3 || parts[0] !== 'user') continue;
                    const statKey = /^c\d+$/.test(parts[1]) ? parts[1] : accountIds.get(parts[1]);
                    if (!statKey) continue;
                    if (!result[statKey]) result[statKey] = { up: 0, down: 0 };
                    if (parts[2] === 'traffic') {
                        const val = parseInt(s.value, 10) || 0;
                        if (parts[3] === 'uplink') result[statKey].up = val;
                        else if (parts[3] === 'downlink') result[statKey].down = val;
                    }
                }
            } catch(e) {}
            resolve(result);
        });
    });
}

function validateClientExpiry(dateValue,timeValue){
    const date=String(dateValue||'').trim(),time=String(timeValue||'23:59').trim()||'23:59';
    if(!date)return {date:'',time};
    if(!/^\d{4}-\d{2}-\d{2}$/.test(date)||!/^\d{2}:\d{2}$/.test(time))throw new Error('La fecha o la hora de vencimiento no tiene un formato válido');
    const [y,m,d]=date.split('-').map(Number),[hh,mm]=time.split(':').map(Number),check=new Date(Date.UTC(y,m-1,d));
    if(check.getUTCFullYear()!==y||check.getUTCMonth()!==m-1||check.getUTCDate()!==d||hh>23||mm>59)throw new Error('La fecha o la hora de vencimiento no es válida');
    return {date,time};
}
function pauseExpiredClients(){
    try{
        const parts=getLocalClockParts(new Date()),today=`${parts.year}-${parts.month}-${parts.day}`,nowTime=`${parts.hour}:${parts.minute}`;
        const expired=vpnDb.prepare(`SELECT id FROM clients WHERE enabled=1 AND expiry_enabled=1 AND expiry_date<>'' AND (expiry_date<? OR (expiry_date=? AND COALESCE(NULLIF(expiry_time,''),'23:59')<=?))`).all(today,today,nowTime);
        if(!expired.length)return 0;
        const update=vpnDb.prepare('UPDATE clients SET enabled=0,online=0 WHERE id=?');vpnDb.transaction(()=>expired.forEach(c=>update.run(c.id)))();
        statsCache={data:null,time:0};totalsCache={data:null,time:0};logApply(`[CLIENT-EXPIRY] pausados=${expired.map(c=>c.id).join(',')}`);emitRefresh();emitVpnStats();scheduleApply(true);return expired.length;
    }catch(e){logApply(`[CLIENT-EXPIRY-ERROR] ${e.message}`);return 0}
}
setInterval(pauseExpiredClients,10000);setTimeout(pauseExpiredClients,2000);

// FIX: faster snapshot processing + invalidate totalsCache aggressively
async function processStatsSnapshot(trafficData) {
    const now = Date.now();
    const clients = vpnDb.prepare('SELECT id, email, up_bytes, down_bytes, total_bytes, quota_used_bytes, quota_up_bytes, quota_down_bytes, quota_exhausted_at, online, last_seen, limit_gb, enabled FROM clients').all();
    const nowIso = new Date().toISOString();
    let configNeedsRefresh = false;
    let onlineChanged = false;
    if (isFirstSnapshot) {
        const activeIds=[];
        for (const c of clients) { const xemail = `c${c.id}`,has=Object.prototype.hasOwnProperty.call(trafficData,xemail),cur=has?trafficData[xemail]:{up:0,down:0};lastTrafficSnapshot[xemail]={up:cur.up,down:cur.down};clientQuotaBaselinePending.delete(c.id);liveTrafficRates.set(c.id,{up:cur.up,down:cur.down,at:now,rateUp:0,rateDown:0});const lastSeenMs=c.last_seen?new Date(c.last_seen).getTime():0;if(Number(c.enabled)===1&&Number(c.online)===1&&Number.isFinite(lastSeenMs)&&now-lastSeenMs<ONLINE_TIMEOUT_MS){lastActualTrafficAt.set(c.id,lastSeenMs);activeIds.push(c.id)}else lastActualTrafficAt.delete(c.id)}
        // Conserva estados que aún estaban vigentes al reiniciar; el baseline de Xray no cuenta como actividad nueva.
        try{vpnDb.prepare('UPDATE clients SET online=0').run();const keep=vpnDb.prepare('UPDATE clients SET online=1 WHERE id=?');for(const id of activeIds)keep.run(id)}catch(e){}
        isFirstSnapshot = false;
        statsCache = { data: null, time: 0 };
        totalsCache = { data: null, time: 0 };
        return;
    }
    const updateTraffic = vpnDb.prepare(`UPDATE clients SET up_bytes=?, down_bytes=?, total_bytes=?, quota_used_bytes=?, quota_up_bytes=?, quota_down_bytes=?, online=?, last_seen=COALESCE(?, last_seen) WHERE id=?`);
    let onlineCount = 0;
    vpnDb.transaction(() => {
        for (const c of clients) {
            const xemail = `c${c.id}`;
            const hasData = Object.prototype.hasOwnProperty.call(trafficData, xemail);
            const cur = hasData ? trafficData[xemail] : { up: 0, down: 0 };
            const prev = lastTrafficSnapshot[xemail] || { up: 0, down: 0 };
            let deltaUp = hasData ? cur.up - prev.up : 0, deltaDown = hasData ? cur.down - prev.down : 0;
            const counterReset = deltaUp < 0 || deltaDown < 0;
            if (deltaUp < 0) deltaUp = cur.up;
            if (deltaDown < 0) deltaDown = cur.down;
            const newUp = (c.up_bytes || 0) + deltaUp, newDown = (c.down_bytes || 0) + deltaDown, newTotal = newUp + newDown, quotaBaselineDelta=clientQuotaBaselinePending.has(c.id)&&hasData?0:1,quotaLimitBytes=Number(c.limit_gb)>0?Math.floor(Number(c.limit_gb)*1000000000):0;
            let newQuotaUp=quotaLimitBytes>0?(Number(c.quota_up_bytes)||0)+deltaUp*quotaBaselineDelta:0,newQuotaDown=quotaLimitBytes>0?(Number(c.quota_down_bytes)||0)+deltaDown*quotaBaselineDelta:0,newQuotaUsed=newQuotaUp+newQuotaDown;
            if(quotaLimitBytes>0&&newQuotaUsed>quotaLimitBytes){const cappedUp=Math.floor(newQuotaUp*quotaLimitBytes/newQuotaUsed);newQuotaUp=cappedUp;newQuotaDown=quotaLimitBytes-cappedUp;newQuotaUsed=quotaLimitBytes}
            if(hasData)clientQuotaBaselinePending.delete(c.id);
            const hadTraffic = hasData && !counterReset && (deltaUp + deltaDown) > 0;
            const prevRateSample=liveTrafficRates.get(c.id),elapsedSec=prevRateSample?Math.max(0.001,(now-prevRateSample.at)/1000):0;
            const rateUp=hasData&&prevRateSample?Math.max(0,cur.up-prevRateSample.up)/elapsedSec:0;
            const rateDown=hasData&&prevRateSample?Math.max(0,cur.down-prevRateSample.down)/elapsedSec:0;
            if(hasData)liveTrafficRates.set(c.id,{up:cur.up,down:cur.down,at:now,rateUp,rateDown});
            if (hasData) lastTrafficSnapshot[xemail] = { up: cur.up, down: cur.down };
            if(hadTraffic)lastActualTrafficAt.set(c.id,now);
            let isOnline = 0, lastSeenUpdate = null;
            // Exige un baseline real de Xray; tolera resets temporales/consultas vacías durante el TTL.
            if (hadTraffic) { isOnline = 1; lastSeenUpdate = nowIso; onlineCount++; }
            else { const lastActual=lastActualTrafficAt.get(c.id)||0; if(Number(c.enabled)===1&&lastActual>0&&now-lastActual<ONLINE_TIMEOUT_MS){isOnline=1;onlineCount++} else lastActualTrafficAt.delete(c.id); }
            if (isOnline !== (c.online || 0)) onlineChanged = true;
            liveTrafficRates.set(c.id,{...(liveTrafficRates.get(c.id)||{up:0,down:0,at:now}),rateUp:isOnline?rateUp:0,rateDown:isOnline?rateDown:0});
            updateTraffic.run(newUp, newDown, newTotal, newQuotaUsed, newQuotaUp, newQuotaDown, isOnline, lastSeenUpdate, c.id);
            if (c.limit_gb > 0 && newQuotaUsed >= c.limit_gb * 1000 * 1000 * 1000 && c.enabled === 1) { vpnDb.prepare("UPDATE clients SET enabled=0,online=0,quota_exhausted_at=COALESCE(NULLIF(quota_exhausted_at,''),?) WHERE id=?").run(nowIso,c.id); configNeedsRefresh = true; }
        }
    })();
    // FIX: always invalidate caches (online status changes matter for UI consistency)
    statsCache = { data: null, time: 0 };
    totalsCache = { data: null, time: 0 };
    if (now - lastStatsDebugLog > 60000) {
        lastStatsDebugLog = now;
        logApply(`[STATS] clients=${clients.length} online=${onlineCount} trafficEntries=${Object.keys(trafficData).length} changed=${onlineChanged}`);
    }
    if (configNeedsRefresh) { statsCache={data:null,time:0};totalsCache={data:null,time:0};emitRefresh();emitVpnStats();scheduleApply(true); }
}

function buildVpnStatsPayload() {
    const now = Date.now();
    // FIX: shorter cache TTL for faster UI updates
    if (statsCache.data && (now - statsCache.time) < 500) return statsCache.data;
    const clients = vpnDb.prepare(`SELECT c.id, c.name, c.email, c.inbound_id, c.up_bytes, c.down_bytes, c.total_bytes, c.quota_used_bytes, c.quota_up_bytes, c.quota_down_bytes, c.online, c.last_seen, c.limit_gb, c.enabled, c.payment_enabled, c.payment_date, c.payment_frequency, c.payment_time, c.auth_user, c.auth_pass, c.device_limit, i.name as inbound_name, i.protocol FROM clients c JOIN inbounds i ON i.id = c.inbound_id`).all();
    const payload = clients.map(c => {const live=liveTrafficRates.get(c.id)||{};return { id: c.id, name: c.name, email: c.email, inbound_id: c.inbound_id, inbound: c.inbound_name, protocol: c.protocol, up: c.up_bytes || 0, down: c.down_bytes || 0, total: c.total_bytes || 0, quota_used: c.quota_used_bytes || 0, quota_up: c.quota_up_bytes || 0, quota_down: c.quota_down_bytes || 0, up_rate: c.online===1?Number(live.rateUp)||0:0, down_rate:c.online===1?Number(live.rateDown)||0:0, connected: c.online === 1, last_seen: c.last_seen, limit_gb: c.limit_gb || 0, enabled: c.enabled === 1, payment_enabled: c.payment_enabled === 1, payment_date: c.payment_date || '', payment_frequency: c.payment_frequency || 0, payment_time: c.payment_time || '09:00', auth_user: c.auth_user || '', device_limit: c.device_limit || 0 }});
    statsCache = { data: payload, time: now };
    return payload;
}
function emitVpnStats() { try { const count = (io.engine && io.engine.clientsCount) || activeSockets || 0; if (count > 0) io.emit('vpn_stats', buildVpnStatsPayload()); } catch(e) {} }
function emitRefresh() { try { io.emit('refresh_servers'); } catch(e) {} }

function getClientVlessEncryption(c) {
    if (c && c.vless_encryption) return String(c.vless_encryption).trim();
    try { const ib = vpnDb.prepare('SELECT vless_encryption FROM inbounds WHERE id = ?').get(c.inbound_id); if (ib && ib.vless_encryption) return String(ib.vless_encryption).trim(); } catch(e) {}
    return getVlessEncryptionKey();
}
function buildClientLink(c) {
    if (protocolUsesAuth(c.protocol)) {
        const host = c.host || c.ib_domain || c.domain || getVpnConfig().domain || 'HOST';
        const tls=(c.security==='tls'||c.tls)?'tls':'';
        const sni=c.tls_sni||getVpnConfig().domain||host;
        const params=new URLSearchParams();
        if(tls){params.set('security','tls');params.set('sni',sni);params.set('fp',c.fingerprint||'chrome');}
        const query=params.toString();
        if (c.protocol === 'socks') return `socks://${Buffer.from(`${c.auth_user}:${c.auth_pass}`).toString('base64').replace(/=+$/,'')}@${host}:${c.port}${query?'?'+query:''}#${encodeURIComponent(c.name)}`;
        if (c.protocol === 'http') return `${tls?'https':'http'}://${encodeURIComponent(c.auth_user||'')}:${encodeURIComponent(c.auth_pass||'')}@${host}:${c.port}${query?'?'+query:''}#${encodeURIComponent(c.name)}`;
        return '';
    }
    const address = c.ib_domain || c.host || c.domain || getVpnConfig().domain || 'TU_DOMINIO.com';
    const hostHeader = c.host || c.ib_domain || c.domain || getVpnConfig().domain || 'TU_DOMINIO.com';
    const tlsSni = c.tls_sni || getVpnConfig().domain || c.ib_domain || c.domain || c.host || 'TU_DOMINIO.com';
    const realitySni = String(c.reality_server_names||'www.google.com').split(',').map(x=>x.trim()).filter(Boolean)[0] || 'www.google.com';
    const port = c.port;
    const pathValue = c.path || '/';
    const security = c.security || (c.tls ? 'tls' : 'none');
    const savedNetwork=normalizeXrayTransport(c.network||'ws');
    const network = security==='reality'&&!REALITY_TRANSPORTS.includes(savedNetwork)?'raw':savedNetwork;
    const xhttpClientMode=effectiveXhttpMode(security,c.xhttp_mode);
    let flow = c.flow || c.inbound_flow || "";
    if (flow === 'xtls-rprx-vision') { if (network !== 'tcp' && network !== 'raw') flow = ""; if (security === 'none') flow = ""; }
    const params = new URLSearchParams();
    if (network === 'ws') { params.set('type', 'ws'); params.set('path', pathValue); if (hostHeader) params.set('host', hostHeader); }
    else if (network === 'httpupgrade') { params.set('type', 'httpupgrade'); params.set('path', pathValue); if (hostHeader) params.set('host', hostHeader); }
    else if (network === 'grpc') { params.set('type', 'grpc'); if (c.grpc_service) params.set('serviceName', c.grpc_service); if (c.grpc_multi == 1) params.set('mode', 'multi'); }
    else if (network === 'h2' || network === 'http') { params.set('type', 'http'); if (c.h2_path || pathValue) params.set('path', c.h2_path || pathValue); if (c.h2_host || hostHeader) params.set('host', c.h2_host || hostHeader); }
    else if (network === 'quic') { params.set('type', 'quic'); if (c.quic_security) params.set('quicSecurity', c.quic_security); if (c.quic_key) params.set('key', c.quic_key); if (c.quic_header) params.set('headerType', c.quic_header); }
    else if (network === 'kcp') { params.set('type', 'kcp'); if (c.kcp_header) params.set('headerType', c.kcp_header); if (c.kcp_seed) params.set('seed', c.kcp_seed); }
    else if (network === 'xhttp') { params.set('type', 'xhttp'); params.set('path', c.xhttp_path || pathValue); const xhttpHost=String(c.xhttp_host||'').trim(); if(xhttpHost)params.set('host',xhttpHost); params.set('mode', xhttpClientMode); }
    else if(network==='raw'||network==='tcp'){params.set('type','tcp');params.set('headerType','none')} else { params.set('type', 'tcp'); params.set('headerType', 'none'); }

    if (security === 'reality') { params.set('security', 'reality'); params.set('sni', realitySni); params.set('fp', c.fingerprint || 'chrome'); if (c.reality_public_key) params.set('pbk', c.reality_public_key); const sid = (c.reality_short_ids || '').split(',').map(x => x.trim()).filter(Boolean)[0] || ''; if (sid) params.set('sid', sid); params.set('spx', '/'); }
    else if (security === 'tls' || c.tls) { params.set('security', 'tls'); params.set('sni', tlsSni); params.set('fp', c.fingerprint || 'chrome'); if (c.alpn) params.set('alpn', c.alpn); }
    else params.set('security', 'none');

    if (c.protocol === 'vless') {
        const encKey = getClientVlessEncryption(c);
        if (encKey && encKey !== 'none') params.set('encryption', encKey);
        if (flow) params.set('flow', flow);
        return `vless://${c.uuid}@${address}:${port}?${params.toString()}#${encodeURIComponent(c.name)}`;
    }
    if (c.protocol === 'vmess') {
        const vmessNet = network === 'raw' ? 'tcp' : network;
        const vmess = { v: "2", ps: c.name, add: address, port: port, id: c.uuid, aid: "0", scy: "auto", net: vmessNet, type: "none", host: hostHeader, path: pathValue, tls: security === 'none' ? "" : security, sni: security === 'reality' ? realitySni : (security === 'tls' ? tlsSni : ''), fp: security !== 'none' ? (c.fingerprint || 'chrome') : "" };
        if(network==='xhttp'){vmess.path=c.xhttp_path||pathValue;vmess.host=String(c.xhttp_host||'').trim();vmess.mode=xhttpClientMode;}
        if (security === 'reality') { vmess.pbk = c.reality_public_key || ""; vmess.sid = (c.reality_short_ids || "").split(',')[0].trim(); vmess.spx = "/"; }
        if (network === 'grpc') { vmess.path = c.grpc_service || 'grpc'; vmess.type = c.grpc_multi == 1 ? 'multi' : 'gun'; }
        else if (network === 'h2' || network === 'http') { vmess.path = c.h2_path || pathValue; vmess.host = c.h2_host || hostHeader; }
        return `vmess://${Buffer.from(JSON.stringify(vmess)).toString('base64')}`;
    }
    if (c.protocol === 'trojan') return `trojan://${encodeURIComponent(c.uuid)}@${address}:${port}?${params.toString()}#${encodeURIComponent(c.name)}`;
    if (c.protocol === 'shadowsocks') {
        const method = c.ss_method || 'aes-256-gcm';
        const userinfo = Buffer.from(`${method}:${c.uuid}`).toString('base64').replace(/=+$/,'').replace(/\+/g,'-').replace(/\//g,'_');
        const params2 = new URLSearchParams(params);
        return `ss://${userinfo}@${address}:${port}?${params2.toString()}#${encodeURIComponent(c.name)}`;
    }
    return '';
}

function buildClientJsonConfig(c) {
    if (protocolUsesAuth(c.protocol)) return null;
    const address = c.ib_domain || c.host || c.domain || getVpnConfig().domain || 'TU_DOMINIO.com';
    const hostHeader = c.host || c.ib_domain || c.domain || getVpnConfig().domain || 'TU_DOMINIO.com';
    const tlsSni = c.tls_sni || getVpnConfig().domain || c.ib_domain || c.domain || c.host || 'TU_DOMINIO.com';
    const realitySni = String(c.reality_server_names||'www.google.com').split(',').map(x=>x.trim()).filter(Boolean)[0] || 'www.google.com';
    const security = c.security || (c.tls ? 'tls' : 'none');
    const savedNetwork=normalizeXrayTransport(c.network||'ws');
    const network = security==='reality'&&!REALITY_TRANSPORTS.includes(savedNetwork)?'raw':savedNetwork;
    const xhttpClientMode=effectiveXhttpMode(security,c.xhttp_mode);
    const streamSettings = {};
    const pathValue = c.path || '/';
    if (network === 'ws') { streamSettings.network = 'ws'; streamSettings.wsSettings = { path: pathValue, headers: { Host: hostHeader } }; }
    else if (network === 'httpupgrade') { streamSettings.network = 'httpupgrade'; streamSettings.httpupgradeSettings = { path: pathValue, host: hostHeader }; }
    else if (network === 'grpc') { streamSettings.network = 'grpc'; streamSettings.grpcSettings = { serviceName: c.grpc_service || 'grpc', multiMode: c.grpc_multi == 1 }; }
    else if (network === 'h2' || network === 'http') { streamSettings.network = 'h2'; streamSettings.httpSettings = { path: c.h2_path || pathValue, host: [c.h2_host || hostHeader] }; }
    else if (network === 'quic') { streamSettings.network = 'quic'; streamSettings.quicSettings = { security: c.quic_security || 'none', key: c.quic_key || '', header: { type: c.quic_header || 'none' } }; }
    else if (network === 'kcp') { streamSettings.network = 'kcp'; streamSettings.kcpSettings = { tti: 50, uplinkCapacity: 5, downlinkCapacity: 20, congestion: false, header: { type: c.kcp_header || 'none' }, seed: c.kcp_seed || '' }; }
    else if (network === 'xhttp') { streamSettings.network = 'xhttp'; streamSettings.xhttpSettings = { path: c.xhttp_path || pathValue, host: String(c.xhttp_host||'').trim(), mode: xhttpClientMode }; }
    else { streamSettings.network = 'raw'; streamSettings.rawSettings = {}; }
    streamSettings.security = security;
    if (security === 'reality') streamSettings.realitySettings = { serverName: realitySni, fingerprint: c.fingerprint || 'chrome', publicKey: c.reality_public_key || '', shortId: (c.reality_short_ids || '').split(',')[0].trim(), spiderX: '/' };
    else if (security === 'tls') { streamSettings.tlsSettings = { serverName: tlsSni, fingerprint: c.fingerprint || 'chrome' }; let alpnList = ['h2', 'http/1.1']; if (c.alpn) alpnList = c.alpn.split(',').map(x => x.trim()).filter(Boolean); alpnList = alpnList.filter(x => x !== 'h3'); if (alpnList.length === 0) alpnList = ['h2', 'http/1.1']; streamSettings.tlsSettings.alpn = alpnList; }
    const encKey = getClientVlessEncryption(c);
    const encryptionValue = (encKey && encKey !== 'none') ? encKey : 'none';
    let flow = c.flow || c.inbound_flow || "";
    if (flow === 'xtls-rprx-vision') { if (network !== 'tcp' && network !== 'raw') flow = ""; if (streamSettings.security === 'none') flow = ""; }
    let outbound;
    // FIX: mux disabled to improve upload speed
    if (c.protocol === 'vmess') outbound = { protocol: 'vmess', tag: 'proxy', settings: { vnext: [{ address, port: c.port, users: [{ id: c.uuid, alterId: 0, security: 'auto', level: 8 }] }] }, streamSettings };
    else if (c.protocol === 'trojan') outbound = { protocol: 'trojan', tag: 'proxy', settings: { servers: [{ address, port: c.port, password: c.uuid, level: 8 }] }, streamSettings };
    else if (c.protocol === 'shadowsocks') outbound = { protocol: 'shadowsocks', tag: 'proxy', settings: { servers: [{ address, port: c.port, method: c.ss_method || 'aes-256-gcm', password: c.uuid }] }, streamSettings };
    else outbound = { protocol: 'vless', tag: 'proxy', settings: { vnext: [{ address, port: c.port, users: [{ id: c.uuid, encryption: encryptionValue, flow: flow, level: 8 }] }] }, streamSettings };
    const vpn = getVpnConfig();
    const bypassRaw = String(vpn.jsonBypassDomains || '').split(/[\n,;]+/).map(x => x.trim()).filter(Boolean);
    const bypassDomains = [], bypassGeosites = [];
    for (const item of bypassRaw) { if (item.startsWith('geosite:')) bypassGeosites.push(item); else if (item.includes('.') && !item.startsWith('domain:') && !item.startsWith('full:') && !item.startsWith('regexp:')) bypassDomains.push('domain:' + item); else if (item.startsWith('domain:') || item.startsWith('full:') || item.startsWith('regexp:')) bypassDomains.push(item); else bypassGeosites.push('geosite:' + item); }
    const routingRules = [{ type: 'field', ip: ['geoip:private'], outboundTag: 'direct' }];
    if (bypassDomains.length) routingRules.push({ type: 'field', domain: bypassDomains, outboundTag: 'direct' });
    if (bypassGeosites.length) routingRules.push({ type: 'field', domain: bypassGeosites, outboundTag: 'direct' });
    routingRules.push({ type: 'field', network: 'tcp,udp', outboundTag: 'proxy' });
    return { remarks: c.name || 'GZMNET', log: { loglevel: 'warning' }, dns: { queryStrategy: 'UseIP', servers: [{ address: '8.8.8.8', skipFallback: false }, { address: '1.1.1.1', skipFallback: false }], tag: 'dns_out' }, inbounds: [{ tag: 'mixed', listen: '127.0.0.1', port: 10808, protocol: 'socks', settings: { auth: 'noauth', udp: true, userLevel: 8 }, sniffing: { enabled: true, destOverride: ['http', 'tls', 'quic', 'fakedns'] } }, { tag: 'http', listen: '127.0.0.1', port: 10809, protocol: 'http', settings: { userLevel: 8 } }], outbounds: [outbound, { protocol: 'freedom', tag: 'direct', settings: { domainStrategy: 'AsIs' } }, { protocol: 'blackhole', tag: 'block', settings: { response: { type: 'http' } } }], policy: { levels: { '8': { connIdle: 300, downlinkOnly: 1, handshake: 4, uplinkOnly: 1 } }, system: { statsOutboundDownlink: true, statsOutboundUplink: true } }, routing: { domainStrategy: 'AsIs', rules: routingRules }, stats: {} };
}

function checkAuth(req,res,next){if(!req||!req.session||!req.session.user){if(req&&req.path&&req.path.startsWith('/api/'))return res.status(401).json({ok:false,error:'Sesión vencida'});return res.status(401).send('Unauthorized')}return next()}

function fetchInboundsWithClients() {
    const inbounds = vpnDb.prepare('SELECT * FROM inbounds ORDER BY id DESC').all();
    const allClients = vpnDb.prepare('SELECT * FROM clients ORDER BY id DESC').all();
    const byInb = {};
    for (const c of allClients) { if (!byInb[c.inbound_id]) byInb[c.inbound_id] = []; byInb[c.inbound_id].push(c); }
    return inbounds.map(ib => ({ ...ib, clients: byInb[ib.id] || [] }));
}

function isBrowserRequest(req) {
    const ua=String(req.get('user-agent')||'');
    if(detectVpnApp(ua))return false;
    const lower=ua.toLowerCase(),accept=String(req.get('accept')||'').toLowerCase();
    const fetchDest=String(req.get('sec-fetch-dest')||'').toLowerCase(),fetchMode=String(req.get('sec-fetch-mode')||'').toLowerCase();
    if(fetchDest==='document'||fetchMode==='navigate'||accept.includes('text/html'))return true;
    return /mozilla\//i.test(ua)&&/(chrome\/|safari\/|firefox\/|edg\/|version\/)/i.test(ua);
}

function getNextPaymentDate(c){
    if(!c||!c.payment_enabled||!c.payment_date)return null;
    const start=String(c.payment_date).slice(0,10),freq=Math.max(0,parseInt(c.payment_frequency,10)||0);
    if(!/^\d{4}-\d{2}-\d{2}$/.test(start))return null;
    const today=getTodayKey();if(freq<=0||start>=today)return start;
    const elapsed=dateKeyDiffDays(start,today);if(!Number.isFinite(elapsed))return null;
    return dateKeyAddDays(start,Math.ceil(elapsed/freq)*freq);
}

function getUpcoming() {
    const today = getTzDate(); today.setHours(0,0,0,0);
    const clients = vpnDb.prepare('SELECT id, name, payment_enabled, payment_date, payment_frequency FROM clients WHERE payment_enabled = 1').all();
    const payments = [];
    for (const c of clients) {
        const nd = getNextPaymentDate(c);
        if (!nd) continue;
        const target = new Date(nd + 'T00:00:00');
        const diff = Math.round((target.getTime() - today.getTime()) / 86400000);
        if (diff === 0 || diff === 1) payments.push({ id: c.id, name: c.name, date: nd, dateFormatted: formatDateSpanish(nd), dueIn: diff === 0 ? 'hoy' : 'mañana', diff });
    }
    return { payments, expiries: [], total: payments.length };
}

async function sendPushToClient(clientId, payload) {
    if (!webpush) return { ok: false, error: 'webpush no disponible', sent: 0, total: 0 };
    if (!vapidKeys.publicKey) return { ok: false, error: 'VAPID no configurado', sent: 0, total: 0 };
    const subs = vpnDb.prepare('SELECT * FROM push_subscriptions WHERE client_id = ?').all(clientId);
    let sent = 0, failed = 0, lastError='';const removed=[];
    if (subs.length === 0) { logApply(`[PUSH-CLIENT-NOSUB] client=${clientId}`); return { ok: false, error: 'Sin suscripciones', sent: 0, failed: 0, total: 0 }; }
    for (const sub of subs) {
        try { await webpush.sendNotification({ endpoint: sub.endpoint, keys: { p256dh: sub.p256dh, auth: sub.auth } }, JSON.stringify(payload), { TTL: 86400, urgency: 'high' }); vpnDb.prepare('UPDATE push_subscriptions SET vapid_public_key=? WHERE id=?').run(vapidKeys.publicKey,sub.id); sent++; logApply(`[PUSH-CLIENT-OK] client=${clientId}`); }
        catch(e) { failed++; const code = e.statusCode || 0; lastError=`Proveedor push: HTTP ${code||'sin código'} · ${String(e.message||'error desconocido').slice(0,180)}`; logApply(`[PUSH-CLIENT-FAIL] client=${clientId} code=${code} ${String(e.message||'').slice(0,160)}`); if([401,403,404,410].includes(Number(code)))vpnDb.prepare('INSERT OR REPLACE INTO push_invalid_endpoints(endpoint,p256dh,auth,marked_at) VALUES(?,?,?,datetime(\'now\',\'localtime\'))').run(sub.endpoint,sub.p256dh,sub.auth);if(code===404||code===410){removed.push(sub);vpnDb.prepare('DELETE FROM push_subscriptions WHERE id = ?').run(sub.id);} }
    }
    if(!sent&&removed.length===subs.length)return {ok:false,error:'Las suscripciones push registradas ya no son válidas en este proveedor. Reabre el portal instalado con permiso concedido para renovarlas.',sent,failed,total:subs.length,renew:true};
    return { ok: sent > 0, sent, failed, total: subs.length, error: sent>0?null:(lastError||'El proveedor push no aceptó ninguna suscripción.') };
}
async function sendPushToAdmin(payload) {
    if (!webpush) return { ok: false, error: 'webpush no disponible', sent: 0, total: 0 };
    if (!vapidKeys.publicKey) return { ok: false, error: 'VAPID no configurado', sent: 0, total: 0 };
    const subs = vpnDb.prepare('SELECT * FROM admin_push_subscriptions').all();
    let sent = 0, failed = 0;
    for (const sub of subs) {
        try { await webpush.sendNotification({ endpoint: sub.endpoint, keys: { p256dh: sub.p256dh, auth: sub.auth } }, JSON.stringify(payload), { TTL: 86400, urgency: 'high' }); sent++; logApply(`[PUSH-ADMIN-OK]`); }
        catch(e) { failed++; const code = e.statusCode || 0; logApply(`[PUSH-ADMIN-FAIL] code=${code} ${String(e.message||'').slice(0,160)}`); if([401,403,404,410].includes(Number(code)))vpnDb.prepare('INSERT OR REPLACE INTO push_invalid_endpoints(endpoint,p256dh,auth,marked_at) VALUES(?,?,?,datetime(\'now\',\'localtime\'))').run(sub.endpoint,sub.p256dh,sub.auth);if(code===404||code===410)vpnDb.prepare('DELETE FROM admin_push_subscriptions WHERE id = ?').run(sub.id); }
    }
    return { ok: sent > 0, sent, failed, total: subs.length };
}

function getCertIssueDate() {
    try {
        const cfg = getVpnConfig();
        const domain = cfg.domain;
        if (!domain) return null;
        const certPath = `/etc/nginx/ssl/${domain}.crt`;
        if (!fs.existsSync(certPath)) return null;
        const out = execSync(`openssl x509 -in "${certPath}" -noout -startdate 2>/dev/null`, { timeout: 5000, encoding: 'utf8' });
        const str = out.replace('notBefore=', '').trim();
        const d = new Date(str);
        if (isNaN(d.getTime())) return null;
        return d;
    } catch(e) { return null; }
}
function getCertAgeHours() {
    const issue = getCertIssueDate();
    if (!issue) return -1;
    return (Date.now() - issue.getTime()) / 3600000;
}

setInterval(async () => {
    try {
        const now = getTzDate();
        const todayKey = getTodayKey();
        const curMin = now.getHours() * 60 + now.getMinutes();
        const cfg = getVpnConfig();

        if (curMin >= 0 && curMin <= 4) {
            if (!cfg.lastSslNotified || cfg.lastSslNotified !== todayKey) {
                const ageH = getCertAgeHours();
                if (ageH > 0 && (ageH + 4) >= 50 * 24 && ageH < 60 * 24) {
                    cfg.lastSslNotified = todayKey;
                    saveVpnConfig(cfg);
                    logApply(`[SSL] Notificando renovación (edad actual: ${(ageH/24).toFixed(1)} días)`);
                    try {
                        await sendPushToAdmin({ title: '🔒 Renovación SSL a las 4:00 AM', body: `El certificado SSL será renovado automáticamente hoy a las 4:00 AM (tiene ${Math.floor(ageH/24)} días).`, url: '/', tag: 'ssl-renew-pending' });
                    } catch(e) { logApply(`[SSL] Error notif: ${e.message}`); }
                }
            }
        }

        if (curMin >= 240 && curMin <= 244 && !sslRenewalInProgress) {
            if (!cfg.lastSslRenewed || cfg.lastSslRenewed !== todayKey) {
                const ageH = getCertAgeHours();
                if (ageH >= 50 * 24 && ageH < 60 * 24) {
                    cfg.lastSslRenewed = todayKey;
                    saveVpnConfig(cfg);
                    sslRenewalInProgress = true;
                    logApply(`[SSL] Iniciando renovación automática (edad: ${(ageH/24).toFixed(1)} días)`);
                    exec('/usr/local/bin/gzmnet-renew-cert.sh', { timeout: 300000 }, async (err) => {
                        sslRenewalInProgress = false;
                        if (err) {
                            logApply(`[SSL] Error: ${err.message}`);
                            try { await sendPushToAdmin({ title: '⚠️ Error renovando SSL', body: `Revisa /root/gzmnet/data/cert-renew.log`, url: '/', tag: 'ssl-renew-fail' }); } catch(e) {}
                            return;
                        }
                        logApply(`[SSL] ✅ Renovación completada exitosamente`);
                        try { await sendPushToAdmin({ title: '✅ Certificado SSL renovado', body: 'El certificado SSL se renovó exitosamente.', url: '/', tag: 'ssl-renew-done' }); } catch(e) {}
                    });
                }
            }
        }
    } catch(e) { logApply('[SSL-MONITOR-EXC] ' + e.message); }
}, 60000);

let pushJobTickCount=0;
let paymentTickRunning=false;
let paymentQueueRunning=false;
const paymentNoSubscriptionLogged=new Set();
const paymentPushDelaySeconds=150;
function localWallTimeToEpoch(dateKey,timeText){
    const date=String(dateKey||'').match(/^(\d{4})-(\d{2})-(\d{2})$/),time=String(timeText||'09:00').match(/^(\d{1,2}):(\d{2})$/);
    if(!date||!time)return NaN;const target={y:+date[1],mo:+date[2],d:+date[3],h:+time[1],mi:+time[2]};if(target.h>23||target.mi>59)return NaN;
    const want=Date.UTC(target.y,target.mo-1,target.d,target.h,target.mi),epoch=want;
    let guess=epoch;for(let i=0;i<4;i++){const p=getLocalClockParts(new Date(guess));const shown=Date.UTC(+p.year,+p.month-1,+p.day,+p.hour,+p.minute);const delta=want-shown;if(!delta)break;guess+=delta}return guess;
}
async function runPaymentReminderJobs(){
    if(paymentQueueRunning)return;paymentQueueRunning=true;
    try{
        const now=Date.now();
        const jobs=vpnDb.prepare(`SELECT j.*,c.name,c.sub_token,c.payment_enabled,c.payment_date,c.payment_frequency,c.payment_time,c.payment_message FROM payment_reminder_jobs j JOIN clients c ON c.id=j.client_id WHERE j.completed=0 AND (j.next_send_epoch<=? OR (j.next_send_epoch=0 AND j.next_send_at<=datetime('now','localtime'))) ORDER BY j.id LIMIT 20`).all(now);
        for(const job of jobs){
            if(!job.payment_enabled||!job.sub_token){vpnDb.prepare('UPDATE payment_reminder_jobs SET completed=1 WHERE id=?').run(job.id);continue}
            const match=String(job.reminder_key||'').match(/^(\d{4}-\d{2}-\d{2})_(\d{1,2}:\d{2})$/),date=match?match[1]:getTodayKey();
            if(date!==getTodayKey()){vpnDb.prepare('UPDATE payment_reminder_jobs SET completed=1 WHERE id=?').run(job.id);continue}
            const sequence=Number(job.sent_count)+1,dateFormatted=formatDateSpanish(date),custom=String(job.payment_message||'').trim();
            const body=(custom?`Hola ${job.name}, hoy (${dateFormatted}) te toca realizar tu pago. ${custom}`:`Hola ${job.name}, hoy (${dateFormatted}) te toca realizar tu pago.`).slice(0,1000);
            const sent=await sendPushToClient(job.client_id,{title:sequence===1?'💰 Pago de hoy - GZMNET':'🔔 Recordatorio de pago - GZMNET',body,url:'/portal/'+job.sub_token,tag:`pay-${job.client_id}-${date}-${sequence}`});
            if(sent&&sent.ok){if(sequence>=3)vpnDb.prepare('UPDATE payment_reminder_jobs SET sent_count=?,attempts=0,completed=1 WHERE id=?').run(sequence,job.id);else{const next=Date.now()+paymentPushDelaySeconds*1000;vpnDb.prepare("UPDATE payment_reminder_jobs SET sent_count=?,attempts=0,next_send_epoch=?,next_send_at=datetime('now','localtime','+150 seconds') WHERE id=?").run(sequence,next,job.id)}}
            else{const attempts=Number(job.attempts)+1;const retry=Date.now()+Math.min(300000,30000*Math.min(attempts,10));vpnDb.prepare("UPDATE payment_reminder_jobs SET attempts=?,next_send_epoch=?,next_send_at=datetime('now','localtime','+5 minutes') WHERE id=?").run(attempts,retry,job.id);if(attempts===1||attempts%10===0)logApply(`[PAYMENT-PUSH-RETRY] client=${job.client_id} date=${date} sent=${job.sent_count} attempts=${attempts}`)}
        }
    }finally{paymentQueueRunning=false}
}
setInterval(async()=>{
    if(paymentTickRunning)return;paymentTickRunning=true;
    try{
        pushJobTickCount++;const today=getTodayKey(),minute=getLocalMinuteOfDay();
        const clients=vpnDb.prepare("SELECT * FROM clients WHERE payment_enabled=1 AND payment_date IS NOT NULL AND payment_date!=''").all();
        for(const c of clients){
            const due=getNextPaymentDate(c);if(!due||due!==today)continue;
            const bits=String(c.payment_time||'09:00').split(':'),h=parseInt(bits[0],10),m=parseInt(bits[1],10),hour=Number.isFinite(h)?h:9,min=Number.isFinite(m)?m:0;if(hour>23||min>59)continue;
            const time=`${String(hour).padStart(2,'0')}:${String(min).padStart(2,'0')}`;if(minute<hour*60+min)continue;
            const key=`${today}_${time}`;if(c.last_payment_notified===key)continue;
            const pushCount=vpnDb.prepare('SELECT COUNT(*) n FROM push_subscriptions WHERE client_id=?').get(c.id).n;
            if(!pushCount){const logKey=`${c.id}:${today}:${time}`;if(!paymentNoSubscriptionLogged.has(logKey)){paymentNoSubscriptionLogged.add(logKey);logApply(`[PAYMENT-NO-SUBSCRIPTION] client=${c.id} due=${today} ${time}; waiting until portal push is enabled`)}continue}else paymentNoSubscriptionLogged.delete(`${c.id}:${today}:${time}`)
            const dueEpoch=localWallTimeToEpoch(today,time);if(!Number.isFinite(dueEpoch))continue;
            vpnDb.prepare("INSERT INTO payment_reminder_jobs(client_id,reminder_key,sent_count,attempts,next_send_at,next_send_epoch,completed) VALUES(?,?,0,0,datetime('now','localtime'),?,0) ON CONFLICT(client_id,reminder_key) DO UPDATE SET sent_count=0,attempts=0,next_send_at=datetime('now','localtime'),next_send_epoch=excluded.next_send_epoch,completed=0").run(c.id,key,Math.max(Date.now(),dueEpoch));
            vpnDb.prepare('UPDATE clients SET last_payment_notified=? WHERE id=?').run(key,c.id);
            logApply(`[PAYMENT-QUEUED] client=${c.id} due=${today} ${time} subscriptions=${vpnDb.prepare('SELECT COUNT(*) n FROM push_subscriptions WHERE client_id=?').get(c.id).n}`);
            const message=String(c.payment_message||'').trim();Promise.resolve(sendPushToAdmin({title:`💰 Pago de hoy: ${c.name}`,body:`${c.name} tiene el pago programado para hoy a las ${time}.${message?' Mensaje: '+message:''}`.slice(0,1000),url:'/',tag:`admin-pay-${c.id}-${today}-${time}`})).catch(e=>logApply(`[PAYMENT-ADMIN-PUSH] client=${c.id} ${e.message}`));
        }
        await runPaymentReminderJobs();
    }catch(e){logApply('[PUSH-JOB-EXC] '+e.message)}finally{paymentTickRunning=false}
},10000);

let telegramPolling = false;
let telegramOffset = 0;
let botState = {};
const botReplaceMessage=new Map();

function getTelegramSettings() { return vpnDb.prepare('SELECT * FROM telegram_settings WHERE id = 1').get() || {}; }
function saveTelegramSettings(s) {
    const cur = getTelegramSettings();
    const m = { ...cur, ...s };
    const ah = parseInt(m.auto_backup_hour, 10);
    const am = parseInt(m.auto_backup_minute, 10);
    vpnDb.prepare(`UPDATE telegram_settings SET enabled=?, bot_token=?, admin_ids=?, notify_payment=?, notify_online=?, auto_backup=?, auto_backup_hour=?, auto_backup_minute=?, last_backup_at=?, updated_at=datetime('now','localtime') WHERE id=1`).run(
        m.enabled ? 1 : 0, m.bot_token || '', m.admin_ids || '', m.notify_payment ? 1 : 0, m.notify_online ? 1 : 0, m.auto_backup ? 1 : 0,
        isNaN(ah) ? 3 : Math.max(0, Math.min(23, ah)),
        isNaN(am) ? 0 : Math.max(0, Math.min(59, am)),
        m.last_backup_at || ''
    );
}
function getAdminIds() { const s = getTelegramSettings(); return String(s.admin_ids || '').split(/[\s,]+/).map(x => x.trim()).filter(Boolean); }

async function tgApi(method, body) {
    const s = getTelegramSettings();
    if (!s.bot_token) return { ok: false, error: 'Sin token' };
    try { const r = await fetch(`https://api.telegram.org/bot${s.bot_token}/${method}`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {}), signal: AbortSignal.timeout(15000) }); return await r.json(); }
    catch(e) { return { ok: false, error: e.message }; }
}
async function tgSend(chatId, text, opts) {const messageId=botReplaceMessage.get(String(chatId));if(messageId){botReplaceMessage.delete(String(chatId));const markup=(opts&&opts.reply_markup)||{inline_keyboard:[[{text:'🏠 Menú',callback_data:'menu'}]]};const r=await tgEdit(chatId,messageId,text,markup);if(r&&r.ok)return r}return tgApi('sendMessage', { chat_id: chatId, text, parse_mode: 'HTML', disable_web_page_preview: true, ...(opts || {}) });}
function tgEsc(v){return String(v??'').replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]))}
async function tgEdit(chatId,messageId,text,replyMarkup){const markup=Array.isArray(replyMarkup)?{inline_keyboard:replyMarkup}:replyMarkup;if(!messageId)return tgSend(chatId,text,{reply_markup:markup});const r=await tgApi('editMessageText',{chat_id:chatId,message_id:messageId,text,parse_mode:'HTML',disable_web_page_preview:true,reply_markup:markup});if(!r.ok&&/message is not modified/i.test(r.description||''))return {ok:true,result:{message_id:messageId}};if(!r.ok&&/message to edit not found|message_id_invalid/i.test(r.description||''))return tgSend(chatId,text,{reply_markup:markup});return r}
async function tgFlow(chatId,state,text,keyboard){const markup={inline_keyboard:keyboard||[]};const r=state.messageId?await tgEdit(chatId,state.messageId,text,markup):await tgSend(chatId,text,{reply_markup:markup});if(r&&r.ok&&r.result)state.messageId=r.result.message_id;return r}
function tgClientPicker(action,page=0){page=Math.max(0,Math.floor(Number(page)||0));const rows=vpnDb.prepare('SELECT id,name,enabled FROM clients ORDER BY id DESC LIMIT 20 OFFSET ?').all(page*20);const total=vpnDb.prepare('SELECT COUNT(*) n FROM clients').get().n;const kb=rows.map(c=>[{text:`${c.enabled?'🟢':'⚪'} ${String(c.name).slice(0,38)} · #${c.id}`,callback_data:`tgclient_${action}_${c.id}`}]);if(total>20){const nav=[];if(page>0)nav.push({text:'‹ Anterior',callback_data:`tglist_${action}_${page-1}`});if((page+1)*20<total)nav.push({text:'Siguiente ›',callback_data:`tglist_${action}_${page+1}`});if(nav.length)kb.push(nav)}kb.push([{text:'↩️ Menú',callback_data:'menu'}]);return {keyboard:kb,total,page,pages:Math.max(1,Math.ceil(total/20))}}
async function tgShowClientPicker(chatId,messageId,action,page=0){const {keyboard,total}=tgClientPicker(action,page);const title=action==='delete'?'🗑️ <b>Eliminar cliente</b>':action==='copy'?'🔗 <b>Enlaces de cliente</b>':'👥 <b>Lista de clientes</b>';const footer=total>20?`\nPágina ${page+1} de ${Math.ceil(total/20)} · ${total} en total`:total?`\nSelecciona entre ${total} ${total===1?'cliente':'clientes'}`:'\nTodavía no hay clientes.';return tgEdit(chatId,messageId,`${title}${footer}`,keyboard)}

async function tgSendDocument(chatId, filename, content, caption) {
    const s = getTelegramSettings();
    if (!s.bot_token) return { ok: false };
    try { const form = new FormData(); form.append('chat_id', chatId); if (caption) form.append('caption', caption); form.append('document', new Blob([content], { type: 'application/json' }), filename); const r = await fetch(`https://api.telegram.org/bot${s.bot_token}/sendDocument`, { method: 'POST', body: form, signal: AbortSignal.timeout(30000) }); return await r.json(); }
    catch(e) { return { ok: false, error: e.message }; }
}

function quotaDirectionFromRecord(c, usedOverride) { const used=Math.max(0,Number(usedOverride??c.quota_used_bytes??c.quota_used??0)||0),hasUp=(c.quota_up_bytes!==undefined&&c.quota_up_bytes!==null)||(c.quota_up!==undefined&&c.quota_up!==null),hasDown=(c.quota_down_bytes!==undefined&&c.quota_down_bytes!==null)||(c.quota_down!==undefined&&c.quota_down!==null),total=Math.max(0,Number(c.total_bytes??c.total)||0),lifeUp=Math.max(0,Number(c.up_bytes??c.up)||0);let up=hasUp?Math.max(0,Number(c.quota_up_bytes??c.quota_up)||0):(total>0?Math.floor(used*lifeUp/total):0),down=hasDown?Math.max(0,Number(c.quota_down_bytes??c.quota_down)||0):Math.max(0,used-up);if(hasUp&&!hasDown)down=Math.max(0,used-up);else if(hasDown&&!hasUp)up=Math.max(0,used-down);return {up,down}; }
function generateBackupJson(){
    return JSON.stringify({app:'gzmnet',version:'0.0.2',exportedAt:new Date().toISOString(),containsPushSigningKeys:true,vpnConfig:getVpnConfig(),inbounds:vpnDb.prepare('SELECT * FROM inbounds').all(),clients:vpnDb.prepare('SELECT * FROM clients').all(),subscriptionDevices:vpnDb.prepare('SELECT id,client_id,device_hash,user_agent,display_name,app_name,location,first_seen,last_seen,admin_notified_at FROM subscription_devices').all(),pushSubscriptions:vpnDb.prepare('SELECT client_id,endpoint,p256dh,auth,created_at,vapid_public_key FROM push_subscriptions').all(),adminPushSubscriptions:vpnDb.prepare('SELECT endpoint,p256dh,auth,created_at FROM admin_push_subscriptions').all(),vapidKeys:vapidKeys.publicKey&&vapidKeys.privateKey?vapidKeys:null,routingSettings:vpnDb.prepare('SELECT * FROM routing_settings').all(),routingRules:vpnDb.prepare('SELECT * FROM routing_rules').all(),adminNotifications:vpnDb.prepare('SELECT title,body,created_at,seen FROM admin_notifications ORDER BY id DESC LIMIT 500').all(),paymentReminderJobs:vpnDb.prepare('SELECT client_id,reminder_key,sent_count,attempts,next_send_at,next_send_epoch,completed,created_at FROM payment_reminder_jobs').all(),telegramSettings:vpnDb.prepare('SELECT enabled,admin_ids,notify_payment,notify_online,auto_backup,auto_backup_hour,auto_backup_minute FROM telegram_settings').all()},null,2);
}

async function tgHandleUpdate(update) {
    if (!update.message || !update.message.text) return;
    const msg = update.message;
    const chatId = String(msg.chat.id);
    const text = String(msg.text).trim();
    const admins = getAdminIds();
    if (!admins.includes(chatId)) { await tgApi('sendMessage', { chat_id: chatId, text: `<b>⛔ Sin permiso</b>\n\nTu ID de Telegram:\n<code>${chatId}</code>\n\nPide al admin que te agregue en el panel.`, parse_mode: 'HTML' }); return; }
    const state = botState[chatId];
    const cmd = text.split(/\s+/)[0].toLowerCase();
    const menuCommands=new Set(['/start','/menu','/status','/online','/clients','/payments','/backup','/crear','/eliminar','/copiar','/help']);
    const menuLabels=new Set(['📊 Estado','🟢 En línea','👥 Clientes','💳 Pagos','➕ Crear','🗑️ Eliminar','📋 Copiar','📦 Backup','❓ Ayuda']);
    if(state&&(text==='/cancelar'||text.toLowerCase()==='cancelar')){delete botState[chatId];await tgEdit(chatId,state.messageId,'Operación cancelada.',[[{text:'🏠 Menú',callback_data:'menu'}]]);return;}
    if(state&&(menuCommands.has(cmd)||menuLabels.has(text))){if(state.messageId)botReplaceMessage.set(chatId,state.messageId);delete botState[chatId];}
    else if(state)return handleBotState(chatId,text,state);
    try {
        if (cmd === '/start' || cmd === '/menu') {
            await tgSend(chatId,'<b>🤖 GZMNET · Panel de control</b>\nElige una acción:',{reply_markup:{inline_keyboard:[
                [{text:'📊 Estado',callback_data:'status'},{text:'🟢 En línea',callback_data:'online'}],
                [{text:'👥 Clientes',callback_data:'clients'},{text:'💳 Pagos',callback_data:'payments'}],
                [{text:'➕ Crear cliente',callback_data:'create_user'},{text:'🗑️ Eliminar',callback_data:'delete_user'}],
                [{text:'📋 Enlaces',callback_data:'copy_config'},{text:'📦 Backup',callback_data:'backup'}]
            ]}});return;
        }
        // Atajos del teclado flotante
        if (text === '📊 Estado') { await tgHandleUpdate({ message: { chat: msg.chat, text: '/status', from: msg.from } }); return; }
        if (text === '🟢 En línea') { await tgHandleUpdate({ message: { chat: msg.chat, text: '/online', from: msg.from } }); return; }
        if (text === '👥 Clientes') { await tgHandleUpdate({ message: { chat: msg.chat, text: '/clients', from: msg.from } }); return; }
        if (text === '💳 Pagos') { await tgHandleUpdate({ message: { chat: msg.chat, text: '/payments', from: msg.from } }); return; }
        if (text === '➕ Crear') { await tgHandleUpdate({ message: { chat: msg.chat, text: '/crear', from: msg.from } }); return; }
        if (text === '🗑️ Eliminar') { await tgHandleUpdate({ message: { chat: msg.chat, text: '/eliminar', from: msg.from } }); return; }
        if (text === '📋 Copiar') { await tgHandleUpdate({ message: { chat: msg.chat, text: '/copiar', from: msg.from } }); return; }
        if (text === '📦 Backup') { await tgHandleUpdate({ message: { chat: msg.chat, text: '/backup', from: msg.from } }); return; }
        if (text === '❓ Ayuda') { await tgHandleUpdate({ message: { chat: msg.chat, text: '/help', from: msg.from } }); return; }
        if (cmd === '/status') { const xrayOk = await checkXrayActive(), warpOk = await isWireproxyRunning(); const totalC = vpnDb.prepare('SELECT COUNT(*) as c FROM clients').get().c; const onlineC = vpnDb.prepare('SELECT COUNT(*) as c FROM clients WHERE online = 1').get().c; const totalIb = vpnDb.prepare('SELECT COUNT(*) as c FROM inbounds').get().c; await tgSend(chatId, `<b>Estado</b>\n\nXray: ${xrayOk ? 'Activo' : 'Caido'}\nWARP: ${warpOk ? 'Activo' : 'Inactivo'}\nServidores: ${totalIb}\nClientes: ${totalC}\nEn linea: ${onlineC}\nUptime: ${Math.floor(process.uptime()/3600)}h`); return; }
        if (cmd === '/online') { const list = vpnDb.prepare('SELECT id, name, email FROM clients WHERE online = 1 AND enabled = 1').all(); if (!list.length) { await tgSend(chatId, 'Sin usuarios conectados.'); return; } await tgSend(chatId, `<b>En linea (${list.length})</b>\n\n${list.map(c => `ID ${c.id}: <b>${c.name}</b>`).join('\n\n')}`); return; }
        if (cmd === '/payments') { const u = getUpcoming(); if (!u.total) { await tgSend(chatId, 'Sin pagos proximos.'); return; } await tgSend(chatId, `<b>Pagos proximos</b>\n\n${u.payments.map(p => `Pago ${p.dueIn}: <b>${p.name}</b> (${p.dateFormatted})`).join('\n')}`); return; }
        if (cmd === '/clients') { const state={action:'client_picker',step:'pick',data:{page:0}};botState[chatId]=state;const {keyboard,total}=tgClientPicker('view',0);const r=await tgSend(chatId,`👥 <b>Clientes</b>\n${total?`Selecciona uno para consultar sus datos y enlaces${total>20?` · ${total} en total`:''}.`:'Todavía no hay clientes.'}`,{reply_markup:{inline_keyboard:keyboard}});if(r.ok)state.messageId=r.result.message_id;return; }
        if (cmd === '/backup') { const json = generateBackupJson(); await tgSendDocument(chatId, `gzmnet-backup-${getTodayKey()}.json`, json, 'Backup GZMNET'); return; }
        if (cmd === '/help') { await tgSend(chatId, `<b>Comandos</b>\n\n/start - Menú\n/status - Estado\n/online - Conectados\n/payments - Pagos\n/clients - Clientes\n/backup - Backup\n/crear - Crear\n/eliminar - Eliminar\n/copiar - Copiar`); return; }
        if (cmd === '/crear') { const st=botState[chatId]={action:'create_user',step:'name',data:{}};const r=await tgSend(chatId,'➕ <b>Crear cliente · 1 de 3</b>\n\nEscribe el nombre del cliente.',{reply_markup:{inline_keyboard:[[{text:'✖ Cancelar',callback_data:'cancel_flow'}]]}});if(r.ok)st.messageId=r.result.message_id;return; }
        if (cmd === '/eliminar') { const st=botState[chatId]={action:'delete_user',step:'pick',data:{}};const {keyboard,total}=tgClientPicker('delete',0);const r=await tgSend(chatId,`🗑️ <b>Eliminar cliente</b>\n${total?'Selecciona el cliente que deseas eliminar.':'Todavía no hay clientes para eliminar.'}`,{reply_markup:{inline_keyboard:keyboard}});if(r.ok)st.messageId=r.result.message_id;return; }
        if (cmd === '/copiar') { const st=botState[chatId]={action:'copy_config',step:'pick',data:{}};const {keyboard,total}=tgClientPicker('copy',0);const r=await tgSend(chatId,`🔗 <b>Enlaces de cliente</b>\n${total?'Selecciona el cliente cuyos enlaces necesitas.':'Todavía no hay clientes.'}`,{reply_markup:{inline_keyboard:keyboard}});if(r.ok)st.messageId=r.result.message_id;return; }
        await tgSend(chatId, 'Usa /start para el menú.');
    } catch (e) { console.error('[TG]', e.message); }
}

async function handleBotState(chatId,text,state){
  try{
    if(text==='/cancelar'||text.toLowerCase()==='cancelar'){await tgEdit(chatId,state.messageId,'Operación cancelada.',[[{text:'↩️ Menú',callback_data:'menu'}]]);delete botState[chatId];return}
    if(state.action==='create_user'&&state.step==='name'){
      const name=text.trim().slice(0,80);if(!name){await tgFlow(chatId,state,'El nombre no puede estar vacío. Escríbelo de nuevo.');return}
      state.data.name=name;const inbs=vpnDb.prepare('SELECT id,name,port,protocol FROM inbounds ORDER BY name COLLATE NOCASE').all();
      if(!inbs.length){await tgFlow(chatId,state,'No hay servidores configurados. Crea un servidor primero.',[[{text:'↩️ Menú',callback_data:'menu'}]]);delete botState[chatId];return}
      state.step='server';const rows=inbs.slice(0,80).map(ib=>[{text:`${String(ib.name).slice(0,32)} · ${ib.protocol.toUpperCase()} :${ib.port}`.slice(0,60),callback_data:`tgcreate_${ib.id}`}]);rows.push([{text:'🏠 Menú',callback_data:'menu'}]);
      rows.push([{text:'✖ Cancelar',callback_data:'cancel_flow'}]);await tgFlow(chatId,state,`➕ <b>Crear cliente · 2 de 3</b>\n<b>${tgEsc(name)}</b>\nSelecciona el servidor para este cliente:`,rows);return;
    }
    if(state.action==='create_user'&&state.step==='limit'){
      if(!/^\d+(?:[.,]\d+)?$/.test(text.trim())){await tgFlow(chatId,state,'Escribe un límite válido en GB (0 significa sin límite).',[[{text:'✖ Cancelar',callback_data:'cancel_flow'}]]);return}
      const limit=parseFloat(text.replace(',','.'));const {name,inbound_id}=state.data;const ib=vpnDb.prepare('SELECT * FROM inbounds WHERE id=?').get(inbound_id);
      if(!ib){await tgFlow(chatId,state,'El servidor seleccionado ya no existe.',[[{text:'↩️ Menú',callback_data:'menu'}]]);delete botState[chatId];return}
      const isAuth=protocolUsesAuth(ib.protocol),cred=isAuth?'':(ib.protocol==='trojan'||ib.protocol==='shadowsocks'?generatePassword():generateUuid()),authUser=isAuth?generateShortToken(8):'',authPass=isAuth?generatePassword():'',email=`c${Date.now()}`,subToken=protocolHasSub(ib.protocol)?ensureUniqueSubToken():null;
      const info=vpnDb.prepare(`INSERT INTO clients (inbound_id,name,uuid,email,flow,limit_gb,enabled,up_bytes,down_bytes,total_bytes,online,sub_token,auth_user,auth_pass,device_limit) VALUES (?,?,?,?,?,?,1,0,0,0,0,?,?,?,0)`).run(inbound_id,name,cred,email,'',limit,subToken,authUser,authPass);
      scheduleApply(true);emitRefresh();const id=info.lastInsertRowid;delete botState[chatId];
      const full=vpnDb.prepare(`SELECT c.*,i.protocol,i.port,i.network,i.path,i.tls,i.domain as ib_domain,i.tls_sni,i.host,i.security,i.flow as inbound_flow,i.reality_public_key,i.reality_server_names,i.reality_short_ids,i.vless_encryption,i.fingerprint,i.alpn,i.ss_method,i.grpc_service,i.grpc_multi,i.h2_path,i.h2_host,i.quic_key,i.quic_security,i.quic_header,i.kcp_seed,i.kcp_header,i.xhttp_path,i.xhttp_host,i.xhttp_mode FROM clients c JOIN inbounds i ON i.id=c.inbound_id WHERE c.id=?`).get(id);
      const rawLink=full?buildClientLink(full):'',link=/\bHOST\b/.test(rawLink)?'':rawLink,vpn=getVpnConfig(),domain=String(vpn.domain||full?.ib_domain||'').replace(/^https?:\/\//,'').replace(/\/$/,''),subPort=Number(vpn.subPort||vpn.panelPort||443),subPortPart=(subPort===443?'':`:${subPort}`),subUrl=subToken&&domain?`https://${domain}${subPortPart}${vpn.subPath||'/sub'}/${subToken}`:'';
      const rows=[];if(link&&link.length<=256)rows.push([{text:'📋 Copiar configuración',copy_text:{text:link}}]);if(subUrl)rows.push([{text:'🔄 Abrir suscripción',url:subUrl}]);rows.push([{text:'↩️ Menú',callback_data:'menu'}]);
      let desc=`✅ <b>Cliente creado</b>\n\n<b>${tgEsc(name)}</b> · ${tgEsc(ib.name)}\nLímite: <b>${limit===0?'Sin límite':`${limit} GB`}</b>`;
      if(link)desc+=`\n\n<b>Configuración</b>\n<code>${tgEsc(link)}</code>`;if(subUrl)desc+=`\n\n<b>Suscripción</b>\n<code>${tgEsc(subUrl)}</code>`;
      if(!link&&!subUrl)desc+='\n\nLos enlaces no están disponibles: revisa el dominio del panel.';
      await tgFlow(chatId,state,desc,rows);delete botState[chatId];return;
    }
    if(state.action==='create_user'&&state.step==='server'){const rows=vpnDb.prepare('SELECT id,name,port,protocol FROM inbounds ORDER BY name COLLATE NOCASE LIMIT 80').all().map(ib=>[{text:`${String(ib.name).slice(0,32)} · ${ib.protocol.toUpperCase()} :${ib.port}`.slice(0,60),callback_data:`tgcreate_${ib.id}`}]);rows.push([{text:'✖ Cancelar',callback_data:'cancel_flow'}]);await tgFlow(chatId,state,'Selecciona el servidor con los botones de abajo.',rows);return}
    if(state.action==='delete_user'||state.action==='copy_config'||state.action==='client_picker'){const action=state.action==='delete_user'?'delete':state.action==='copy_config'?'copy':'view';const {keyboard}=tgClientPicker(action,state.data?.page||0);await tgFlow(chatId,state,'Selecciona un cliente con los botones de la lista.',keyboard);return}
  }catch(e){console.error('[TG-State]',e.stack||e.message);try{await tgFlow(chatId,state,'No se pudo completar la operación. Revisa los datos y vuelve a intentarlo.',[[{text:'↩️ Menú',callback_data:'menu'}]])}catch{}delete botState[chatId]}
}

async function tgHandleCallback(cb){
  const chatId=String(cb.message.chat.id),messageId=cb.message.message_id,admins=getAdminIds();
  if(!admins.includes(chatId)){await tgApi('answerCallbackQuery',{callback_query_id:cb.id,text:'No autorizado',show_alert:true});return}
  const data=String(cb.data||'');await tgApi('answerCallbackQuery',{callback_query_id:cb.id});let state=botState[chatId];
  try{
    if(data==='cancel_flow'){delete botState[chatId];await tgEdit(chatId,messageId,'Operación cancelada.',[[{text:'🏠 Menú principal',callback_data:'menu'}]]);return}
    if(data==='menu'){delete botState[chatId];await tgEdit(chatId,messageId,'<b>🤖 GZMNET · Panel de control</b>\nElige una acción:',[[{text:'📊 Estado',callback_data:'status'},{text:'🟢 En línea',callback_data:'online'}],[{text:'👥 Clientes',callback_data:'clients'},{text:'💳 Pagos',callback_data:'payments'}],[{text:'➕ Crear cliente',callback_data:'create_user'},{text:'🗑️ Eliminar',callback_data:'delete_user'}],[{text:'📋 Enlaces',callback_data:'copy_config'},{text:'📦 Backup',callback_data:'backup'}]]);return}
    if(data.startsWith('tgcreate_')&&state?.action==='create_user'&&state.step==='server'){
      const id=Number(data.slice(9)),ib=vpnDb.prepare('SELECT id,name FROM inbounds WHERE id=?').get(id);if(!ib){await tgEdit(chatId,messageId,'Ese servidor ya no está disponible.',[[{text:'↩️ Menú',callback_data:'menu'}]]);delete botState[chatId];return}
      state.data.inbound_id=id;state.data.inbound_name=ib.name;state.step='limit';state.messageId=messageId;await tgFlow(chatId,state,`➕ <b>Crear cliente · 3 de 3</b>\n<b>${tgEsc(state.data.name)}</b>\nServidor: ${tgEsc(ib.name)}\n\nEscribe el límite en GB (0 = sin límite).`,[[{text:'✖ Cancelar',callback_data:'cancel_flow'}]]);return;
    }
    if(data.startsWith('tglist_')){const [,action,page]=data.split('_');await tgShowClientPicker(chatId,messageId,action,Math.max(0,Number(page)||0));return}
    if(data.startsWith('tgclient_')){
      const [,action,idText]=data.split('_'),id=Number(idText),c=vpnDb.prepare('SELECT c.id,c.name,c.enabled,c.sub_token,i.protocol,i.name inbound_name FROM clients c JOIN inbounds i ON i.id=c.inbound_id WHERE c.id=?').get(id);
      if(!c){await tgEdit(chatId,messageId,'Ese cliente ya no existe.',[[{text:'↩️ Volver a clientes',callback_data:'clients'}]]);return}
      if(action==='delete'){
        await tgEdit(chatId,messageId,`⚠️ <b>Confirmar eliminación</b>\n\n¿Eliminar <b>${tgEsc(c.name)}</b> (#${c.id}) y revocar su acceso?`,[[{text:'🗑️ Sí, eliminar',callback_data:`tgdelok_${id}`}],[{text:'Cancelar',callback_data:'clients'}]]);return
      }
      if(action==='copy'||action==='view'){
        const full=vpnDb.prepare(`SELECT c.*,i.protocol,i.port,i.network,i.path,i.tls,i.domain as ib_domain,i.tls_sni,i.host,i.security,i.flow as inbound_flow,i.reality_public_key,i.reality_server_names,i.reality_short_ids,i.vless_encryption,i.fingerprint,i.alpn,i.ss_method,i.grpc_service,i.grpc_multi,i.h2_path,i.h2_host,i.quic_key,i.quic_security,i.quic_header,i.kcp_seed,i.kcp_header,i.xhttp_path,i.xhttp_host,i.xhttp_mode FROM clients c JOIN inbounds i ON i.id=c.inbound_id WHERE c.id=?`).get(id);const link=buildClientLink(full),vpn=getVpnConfig(),domain=String(vpn.domain||full.ib_domain||'').replace(/^https?:\/\//,'').replace(/\/$/,''),subToken=c.sub_token||'',subUrl=subToken&&domain?`https://${domain}${Number(vpn.subPort||443)===443?'':`:${Number(vpn.subPort||443)}`}${vpn.subPath||'/sub'}/${subToken}`:'';
        let text=`👤 <b>${tgEsc(c.name)}</b> · ${tgEsc(c.protocol.toUpperCase())}\nServidor: ${tgEsc(c.inbound_name)}`;if(link)text+=`\n\n<b>Configuración</b>\n<code>${tgEsc(link)}</code>`;if(subUrl)text+=`\n\n<b>Suscripción</b>\n<code>${tgEsc(subUrl)}</code>`;
        const rows=[];if(link&&link.length<=256)rows.push([{text:'📋 Copiar configuración',copy_text:{text:link}}]);if(subUrl)rows.push([{text:'🔄 Abrir suscripción',url:subUrl}]);rows.push([{text:'↩️ Clientes',callback_data:'clients'},{text:'🏠 Menú',callback_data:'menu'}]);await tgEdit(chatId,messageId,text,rows);delete botState[chatId];return;
      }
    }
    if(data.startsWith('tgdelok_')){const id=Number(data.slice(8)),c=vpnDb.prepare('SELECT name FROM clients WHERE id=?').get(id);if(!c){await tgEdit(chatId,messageId,'El cliente ya fue eliminado.',[[{text:'👥 Clientes',callback_data:'clients'}]]);return}vpnDb.prepare('DELETE FROM clients WHERE id=?').run(id);scheduleApply(true);emitRefresh();delete botState[chatId];await tgEdit(chatId,messageId,`✅ <b>${tgEsc(c.name)}</b> eliminado. Su acceso quedó revocado.`,[[{text:'👥 Clientes',callback_data:'clients'}],[{text:'🏠 Menú',callback_data:'menu'}]]);return}
    if(data==='create_user') {const st=botState[chatId]={action:'create_user',step:'name',data:{},messageId};await tgFlow(chatId,st,'➕ <b>Crear cliente · 1 de 3</b>\n\nEscribe el nombre del cliente.',[[{text:'✖ Cancelar',callback_data:'cancel_flow'}]]);return}
    if(data==='delete_user'||data==='copy_config'||data==='clients') {const action=data==='delete_user'?'delete':data==='copy_config'?'copy':'view',st=botState[chatId]={action:action==='view'?'client_picker':action,step:'pick',data:{page:0},messageId};const {keyboard,total}=tgClientPicker(action,0);const title=action==='delete'?'🗑️ <b>Eliminar cliente</b>':action==='copy'?'🔗 <b>Enlaces de cliente</b>':'👥 <b>Clientes</b>';const desc=total?(action==='delete'?'Selecciona el cliente que deseas eliminar.':action==='copy'?'Selecciona el cliente cuyos enlaces necesitas.':'Selecciona un cliente para consultar sus datos y enlaces.'):'Todavía no hay clientes.';await tgEdit(chatId,messageId,`${title}\n${desc}${total>20?` · ${total} en total`:''}`,keyboard);return}
    const map={status:'/status',online:'/online',payments:'/payments',backup:'/backup',help:'/help'};if(map[data]){delete botState[chatId];if(data!=='backup')botReplaceMessage.set(chatId,messageId);await tgHandleUpdate({message:{chat:cb.message.chat,text:map[data],from:cb.from}});return}
  }catch(e){console.error('[TG-Callback]',e.stack||e.message);await tgEdit(chatId,messageId,'No se pudo completar la acción. Vuelve al menú e inténtalo otra vez.',[[{text:'🏠 Menú',callback_data:'menu'}]])}
}

async function startTelegramPolling() {
    if (telegramPolling) return;
    telegramPolling = true;
    while (true) {
        try {
            const s = getTelegramSettings();
            if (!s.enabled || !s.bot_token) { await new Promise(r => setTimeout(r, 5000)); continue; }
            const r = await fetch(`https://api.telegram.org/bot${s.bot_token}/getUpdates?offset=${telegramOffset}&timeout=25`, { signal: AbortSignal.timeout(30000) });
            const data = await r.json();
            if (data.ok && Array.isArray(data.result)) { for (const upd of data.result) { telegramOffset = upd.update_id + 1; try { if (upd.callback_query) await tgHandleCallback(upd.callback_query); else if (upd.message) await tgHandleUpdate(upd); } catch(e) {} } }
            else await new Promise(r => setTimeout(r, 5000));
        } catch(e) { await new Promise(r => setTimeout(r, 5000)); }
    }
}

let lastBackupRunDate = '';
setInterval(async () => {
    try {
        const s = getTelegramSettings();
        if (!s.enabled || !s.auto_backup || !s.bot_token) return;
        const todayKey = getTodayKey();
        if (lastBackupRunDate === todayKey) return;
        const now = getTzDate();
        const curMin = now.getHours() * 60 + now.getMinutes();
        const bParts = `${s.auto_backup_hour}:${s.auto_backup_minute}`.split(':');
        const bH = parseInt(bParts[0], 10), bM = parseInt(bParts[1], 10);
        const confMin = (isNaN(bH) ? 3 : bH) * 60 + (isNaN(bM) ? 0 : bM);
        if (curMin < confMin || curMin > confMin + 4) return;
        lastBackupRunDate = todayKey;
        const admins = getAdminIds();
        if (!admins.length) return;
        const json = generateBackupJson();
        for (const a of admins) await tgSendDocument(a, `gzmnet-backup-${todayKey}.json`, json, 'Backup automatico GZMNET');
        vpnDb.prepare("UPDATE telegram_settings SET last_backup_at = datetime('now','localtime') WHERE id = 1").run();
    } catch(e) {}
}, 30000);

function getSubUaList() {
    const vpn = getVpnConfig();
    const raw = String(vpn.subUserAgent || '');
    return raw.split(/[,\n]+/).map(x => x.trim().toLowerCase()).filter(Boolean);
}
function validateUA(req) {
    const list = getSubUaList();
    if (list.length === 0) return true;
    const ua = String(req.get('user-agent') || '').toLowerCase();
    return list.some(a => ua.includes(a));
}
function detectVpnApp(userAgent,req){
    const ua=String(userAgent||'').toLowerCase();
    const apps=[
      ['quantumultx','Quantumult X'],['quantumult x','Quantumult X'],['shadowrocket','Shadowrocket'],
      ['v2rayng','v2rayNG'],['v2ray tun','V2RayTun'],['v2raytun','V2RayTun'],['v2rayn','v2rayN'],['v2ray-a','v2rayA'],['v2raya','v2rayA'],
      ['hiddify','Hiddify'],['nekobox','NekoBox'],['nekoray','NekoRay'],['sing-box','Sing-box'],['singbox','Sing-box'],
      ['clash meta','Clash Meta'],['clash.meta','Clash Meta'],['clashmeta','Clash Meta'],['clash verge','Clash Verge'],['flclash','FlClash'],
      ['mihomo','Mihomo'],['metacubex','Mihomo'],['shadowrocket','Shadowrocket'],['quantumult','Quantumult'],['streisand','Streisand'],
      ['surfboard','Surfboard'],['stash','Stash'],['loon','Loon'],['foxray','FoXray'],['husi','Husi'],['matsuri','Matsuri'],
      ['pharos','Pharos'],['fair','Fair'],['kitsunebi','Kitsunebi'],['postern','Postern'],['shadowsocks','Shadowsocks'],
      ['outline','Outline'],['openvpn','OpenVPN'],['wireguard','WireGuard'],['trojan','Trojan'],['ssr','ShadowsocksR'],['clash','Clash']
    ];
    for(const [needle,name] of apps)if(ua.includes(needle))return name;
    if(req){for(const allowed of getSubUaList()){if(ua.includes(allowed)&&allowed.length<=40&&!/mozilla|chrome|safari|firefox|browser/i.test(allowed)){const normalized=allowed.replace(/[-_.]+/g,' ').trim();return normalized.replace(/\\b\\w/g,c=>c.toUpperCase())}}}
    const hint=String(req&&((req.get&& (req.get('x-app-name')||req.get('x-client-name')||req.get('x-client')))||'')||'').trim();
    if(hint&&(!req||!isBrowserRequest(req))){const h=hint.toLowerCase();for(const [needle,name] of apps)if(h.includes(needle))return name; if(hint.length<=40&&!/mozilla|chrome|safari|firefox|browser/i.test(hint))return hint.replace(/[<>\r\n]/g,'').slice(0,40)}
    return '';
}
function deviceIdentity(req) {
    const ua=String(req.get('user-agent')||''),l=ua.toLowerCase();
    const model=String(req.get('sec-ch-ua-model')||req.get('x-device-model')||req.get('x-hardware-model')||req.get('x-device-name')||'').replace(/^"|"$/g,'').trim();
    const platform=String(req.get('sec-ch-ua-platform')||'').replace(/^"|"$/g,'').trim();
    let device=model;
    if(!device){const android=ua.match(/Android[^;)]*;\s*([^;)]+?)(?:\s+Build\/[^;)]+)?\s*[;)]/i);if(android)device=android[1].trim().replace(/^(?:wv|Linux|U|en-US|en)\s*;?\s*/i,'')}
    if(!device&&/iphone/i.test(ua)){const m=ua.match(/iPhone OS (\d+)[_\d]*/i);device=m?`iPhone · iOS ${m[1]}`:'iPhone'}
    if(!device&&/ipad/i.test(ua)){const m=ua.match(/CPU OS (\d+)[_\d]*/i);device=m?`iPad · iPadOS ${m[1]}`:'iPad'}
    if(!device&&/ipod/i.test(ua))device='iPod';
    const app=detectVpnApp(ua,req)||(!/mozilla\//i.test(ua)?'App VPN no identificada':'');
    let platformLabel=device||platform||(/windows/i.test(ua)?'Windows':/macintosh|mac os/i.test(ua)?'Mac':/android/i.test(ua)?'Android':/iphone|ipad|ipod/i.test(ua)?'iOS':'Dispositivo');
    return {label:platformLabel.slice(0,80),model:(device||'').slice(0,80),ua,app};
}
function deviceDisplayName(ua) { return deviceIdentity({get:(n)=>n.toLowerCase()==='user-agent'?ua:''}).label; }
function deviceHashForRequest(req){const rawUa=String(req.get('user-agent')||''),ua=rawUa.toLowerCase().replace(/\/\d+(?:[._-]\d+)*(?:[-+][a-z0-9.-]+)?/g,'').replace(/\s+build\/[^;)]+/g,'').trim(),app=detectVpnApp(rawUa,req)||'vpn-client';const fallback=ua?'':String(req.get('sec-ch-ua-model')||req.get('x-device-model')||req.get('sec-ch-ua-platform')||'').replace(/^"|"$/g,'').trim().toLowerCase();const identity=[app,ua||fallback].join('|');return crypto.createHash('sha256').update(identity).digest('hex').substring(0,16);}
function isPublicClientIp(rawIp){
    let ip=String(rawIp||'').split('%')[0].replace(/^::ffff:/i,'');const family=net.isIP(ip);if(!family)return false;
    if(family===4){const a=ip.split('.').map(Number);if(a[0]===0||a[0]===10||a[0]===127||a[0]>=224||a[0]===169&&a[1]===254||a[0]===172&&a[1]>=16&&a[1]<=31||a[0]===192&&a[1]===168||a[0]===100&&a[1]>=64&&a[1]<=127)return false;return true}
    const x=ip.toLowerCase();return x!=='::'&&x!=='::1'&&!x.startsWith('fc')&&!x.startsWith('fd')&&!/^fe[89ab]/.test(x)&&!x.startsWith('2001:db8:');
}
const deviceLocationCache=new Map();
async function lookupDeviceLocation(ip){
    if(!isPublicClientIp(ip))return '';
    if(deviceLocationCache.has(ip))return deviceLocationCache.get(ip);
    let location='';
    try{const response=await fetch(`https://ipwho.is/${encodeURIComponent(ip)}`,{signal:AbortSignal.timeout(6000),headers:{'Accept':'application/json'}});if(response.ok){const data=await response.json();if(data&&data.success){const code=String(data.country_code||'').toUpperCase();const city=String(data.city||data.region||data.country||'').trim();if(/^[A-Z]{2}$/.test(code)&&city)location=`${code}|${city.slice(0,80)}`}}}catch(e){logApply(`[DEVICE-GEO-LOOKUP] ${String(e.message||e).slice(0,140)}`)}
    // Do not permanently cache failed lookups; transient geolocation outages must be retried on the next subscription request.
    if(location){if(deviceLocationCache.size>512)deviceLocationCache.clear();deviceLocationCache.set(ip,location)}return location;
}
function displayDeviceLocation(value){const raw=String(value||'').trim();if(!raw)return '';const m=raw.match(/^([A-Z]{2})\|(.+)$/);if(m){const flag=Array.from(m[1]).map(c=>String.fromCodePoint(127397+c.charCodeAt(0))).join('');return `${flag} ${m[2].trim()}`}const parts=raw.split(',').map(x=>x.trim()).filter(Boolean);return parts.length>1?parts[0]:raw.slice(0,80)}
async function updateDeviceLocationAsync(rowId,ip){const location=await lookupDeviceLocation(ip);if(location){try{vpnDb.prepare('UPDATE subscription_devices SET location=? WHERE id=?').run(location,rowId)}catch(e){logApply(`[DEVICE-GEO-DB] ${e.message}`)}}return location}
try{for(const row of vpnDb.prepare("SELECT id,user_agent,ip_address,app_name,location FROM subscription_devices").all()){const detected=detectVpnApp(row.user_agent),stored=String(row.app_name||'').trim(),app=(!stored||/^(?:app vpn no identificada|desconocido)$/i.test(stored))?(detected||stored):stored;if(!app){if(/mozilla\/|chrome\/|safari\/|firefox\/|edg\//i.test(String(row.user_agent||'')))vpnDb.prepare('DELETE FROM subscription_devices WHERE id=?').run(row.id);continue}if(app!==row.app_name)vpnDb.prepare('UPDATE subscription_devices SET app_name=? WHERE id=?').run(app,row.id);if((!row.location||!/^[A-Z]{2}\|/.test(String(row.location)))&&isPublicClientIp(row.ip_address))setImmediate(()=>updateDeviceLocationAsync(row.id,row.ip_address))}}catch(e){logApply(`[DEVICE-MIGRATION] ${e.message}`)}
function trackDevice(clientId, req, deviceLimit) {
    const ua=String(req.get('user-agent')||''),ip=String(req.ip||'').replace(/^::ffff:/i,''),identity=deviceIdentity(req),appName=identity.app||(!isBrowserRequest(req)&&ua.trim()?'App VPN no identificada':'');
    if(!appName)return {ok:true,added:false,updated:false,tracked:false,displayName:identity.label,appName:'',location:''};
    const hash=deviceHashForRequest(req);
    const existing=vpnDb.prepare('SELECT id,last_seen,admin_notified_at,display_name,app_name,location,user_agent FROM subscription_devices WHERE client_id=? AND device_hash=?').get(clientId,hash);
    if(existing){const uaChanged=String(existing.user_agent||'')!==ua.substring(0,200),identityChanged=String(existing.display_name||'')!==identity.label||String(existing.app_name||'')!==appName;vpnDb.prepare("UPDATE subscription_devices SET last_seen=datetime('now','localtime'),ip_address=?,app_name=?,user_agent=?,display_name=? WHERE id=?").run(ip,appName,ua.substring(0,200),identity.label,existing.id);if(!existing.location)setImmediate(()=>updateDeviceLocationAsync(existing.id,ip));return {ok:true,added:false,updated:true,metadataChanged:uaChanged||identityChanged,tracked:true,displayName:identity.label,appName,model:identity.model||'',location:existing.location||''}}
    if(deviceLimit>0){const count=vpnDb.prepare('SELECT COUNT(*) as c FROM subscription_devices WHERE client_id=?').get(clientId).c;if(count>=deviceLimit)return {ok:false,error:'device_limit'}}
    const result=vpnDb.prepare("INSERT INTO subscription_devices (client_id,device_hash,user_agent,display_name,ip_address,app_name,location,admin_notified_at) VALUES (?,?,?,?,?,?,'','')").run(clientId,hash,ua.substring(0,200),identity.label,ip,appName);
    const rowId=Number(result.lastInsertRowid);setImmediate(()=>updateDeviceLocationAsync(rowId,ip));
    return {ok:true,added:true,updated:false,metadataChanged:true,tracked:true,displayName:identity.label,appName,model:identity.model||'',location:''};
}

app.get('/api/geosite-tags', checkAuth, (req, res) => res.json({ ok: true, tags: Array.from(KNOWN_GEOSITE_TAGS).sort() }));
app.get('/api/protocols-info', checkAuth, (req, res) => res.json({ ok: true, protocols: { vless: { transports: PROTOCOL_TRANSPORTS.vless, securities: PROTOCOL_SECURITIES.vless, usesAuth: false }, vmess: { transports: PROTOCOL_TRANSPORTS.vmess, securities: PROTOCOL_SECURITIES.vmess, usesAuth: false }, trojan: { transports: PROTOCOL_TRANSPORTS.trojan, securities: PROTOCOL_SECURITIES.trojan, usesAuth: false }, shadowsocks: { transports: PROTOCOL_TRANSPORTS.shadowsocks, securities: PROTOCOL_SECURITIES.shadowsocks, usesAuth: false }, socks: { transports: PROTOCOL_TRANSPORTS.socks, securities: PROTOCOL_SECURITIES.socks, usesAuth: true }, http: { transports: PROTOCOL_TRANSPORTS.http, securities: PROTOCOL_SECURITIES.http, usesAuth: true } } }));
app.get('/login', (req, res) => res.sendFile(path.join(__dirname, 'views/login.html')));
app.post('/login', (req, res) => {
    if (!req.session) return res.status(503).json({ok:false,error:'Sesión temporalmente no disponible'});
    const ip = req.ip || 'unknown';
    if (!checkLoginRate(ip)) return res.status(429).json({ ok: false, error: 'Demasiados intentos' });
    const fc = getConfig();
    if (req.body.user === fc.adminUser && req.body.pass === fc.adminPassword) { clearLoginAttempts(ip); req.session.user = req.body.user; res.json({ ok: true }); }
    else { recordFailedLogin(ip); logApply(`[AUTH-FAIL] ip=${ip}`); res.json({ ok: false }); }
});
app.get('/logout', (req, res) => { try { if (req.session) req.session.user = null; } catch(e) {} res.redirect('/login'); });
app.get('/', (req,res)=>{if(req&&req.session&&req.session.user)return res.sendFile(path.join(__dirname,'views/index.html'));return res.redirect('/login')});

app.post('/api/vless/generate', checkAuth, async (req, res) => { try { const keys = await generateVlessKeypair(); if (!keys || keys.error) return res.status(500).json({ ok: false, error: (keys && keys.error) || 'No se pudo generar el par VLESS Encryption' }); res.json({ ok: true, serverDecryption: keys.decryption, encryption: keys.encryption }); } catch(e) { res.status(500).json({ ok: false, error: e.message }); } });
app.post('/api/reality/generate', checkAuth, async (req, res) => { try { const keys = await generateRealityKeypair(); if (!keys || keys.error) return res.status(500).json({ ok: false, error: (keys && keys.error) || 'Xray no pudo generar el par X25519. Comprueba la versión del binario.' }); const shortIds = [generateShortId(), generateShortId()]; res.json({ ok: true, privateKey: keys.privateKey, publicKey: keys.publicKey, shortIds: shortIds.join(',') }); } catch(e) { res.status(500).json({ ok: false, error: e.message }); } });
app.post('/api/generate-uuid', checkAuth, (req, res) => res.json({ ok: true, uuid: generateUuid() }));
app.post('/api/generate-token', checkAuth, (req, res) => res.json({ ok: true, token: ensureUniqueSubToken() }));
app.post('/api/generate-password', checkAuth, (req, res) => { try { const len = Math.max(8, Math.min(32, parseInt(req.body.length) || 16)); const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789'; const bytes = crypto.randomBytes(len); let s = ''; for (let i = 0; i < len; i++) s += chars[bytes[i] % chars.length]; res.json({ ok: true, password: s }); } catch(e) { res.status(500).json({ ok: false, error: e.message }); } });

app.get('/api/portal/:token/vapid', (req, res) => {
    try { const token = String(req.params.token || '').trim(); const c = vpnDb.prepare('SELECT id FROM clients WHERE sub_token = ? AND enabled=1 LIMIT 1').get(token); if (!c) return res.status(404).json({ ok: false, error: 'Portal no encontrado' }); if (!vapidKeys.publicKey) return res.json({ ok: false, error: 'VAPID no disponible' }); res.set('Cache-Control','no-store, no-cache, must-revalidate, proxy-revalidate');res.set('Pragma','no-cache');res.set('Expires','0');res.json({ ok: true, publicKey: vapidKeys.publicKey }); }
    catch(e) { res.status(500).json({ ok: false, error: e.message }); }
});

function getSubscriptionClients(token) {
    return vpnDb.prepare(`SELECT c.*, i.protocol, i.port, i.network, i.path, i.tls, i.domain as ib_domain, i.tls_sni, i.host, i.security, i.flow as inbound_flow, i.reality_public_key, i.reality_server_names, i.reality_short_ids, i.vless_encryption, i.vless_decryption, i.fingerprint, i.alpn, i.ss_method, i.grpc_service, i.grpc_multi, i.h2_path, i.h2_host, i.quic_key, i.quic_security, i.quic_header, i.kcp_seed, i.kcp_header, i.xhttp_path, i.xhttp_host, i.xhttp_mode, i.name as inbound_name FROM clients c JOIN inbounds i ON i.id=c.inbound_id WHERE c.sub_token=? AND c.enabled=1 ORDER BY i.id,c.id`).all(token).filter(c => !protocolUsesAuth(c.protocol));
}
function aggregateJsonSubscription(clients) {
    const configs = clients.map(buildClientJsonConfig).filter(Boolean);
    if (!configs.length) return null;
    if (configs.length === 1) return configs[0];
    const outbounds = [], rules = [];
    configs.forEach((cfg, ix) => {
        const proxy = cfg.outbounds.find(o => o.tag === 'proxy');
        if (proxy) { proxy.tag = `proxy-${ix+1}`; proxy.remarks = clients[ix].name || `Servidor ${ix+1}`; outbounds.push(proxy); }
    });
    const base = configs[0];
    const direct = base.outbounds.find(o => o.tag === 'direct');
    const block = base.outbounds.find(o => o.tag === 'block');
    if (direct) outbounds.push(direct); if (block) outbounds.push(block);
    const firstRules = (base.routing && base.routing.rules || []).filter(r => r.outboundTag !== 'proxy');
    rules.push(...firstRules);
    configs.forEach((cfg,ix) => {
        const rs=(cfg.routing&&cfg.routing.rules||[]).filter(r=>r.outboundTag==='proxy');
        for (const r of rs) rules.push({...r,outboundTag:`proxy-${ix+1}`});
    });
    return {...base, outbounds, routing:{...base.routing,rules}};
}
const subscriptionNoticeLocks=new Map();
async function notifySubscriptionAdmin(body,token,key){
    const title='Actividad de suscripción',text=String(body).slice(0,400);
    try{vpnDb.prepare('INSERT INTO admin_notifications(title,body) VALUES(?,?)').run(title,text)}catch(e){logApply(`[SUB-NOTIFY-DB-ERR] ${e.message}`)}
    const tag='subscription-'+String(token||'').slice(0,16)+'-'+String(key||'').slice(0,10)+'-'+Date.now().toString(36);
    try{const push=await sendPushToAdmin({title,body:text,url:'/',tag});if(!push||!push.ok)logApply(`[SUB-ADMIN-PUSH-NOT-SENT] sent=${push&&push.sent||0} total=${push&&push.total||0} error=${push&&push.error||'No hay un dispositivo administrador con notificaciones push activas'}`)}catch(e){logApply(`[SUB-ADMIN-PUSH-ERR] ${e.message}`)}
    try{const ts=getTelegramSettings();if(ts.enabled&&ts.bot_token){const safe=x=>String(x).replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));const chats=[...new Set(getAdminIds().map(x=>String(x).trim()).filter(Boolean))];for(const chat of chats){try{const r=await tgSend(chat,`<b>${safe(title)}</b>\\n${safe(text)}`);if(!r||!r.ok)logApply(`[SUB-TG-ERR] ${r&&r.description||'send failed'}`)}catch(e){logApply(`[SUB-TG-ERR] ${e.message}`)}}}}catch(e){logApply(`[SUB-NOTIFY-ERR] ${e.message}`)}
    return {ok:true};
}

function recordSubscriptionUse(clients, req) {
    const ua=String(req.get('user-agent')||''), appName=detectVpnApp(ua,req)||(!isBrowserRequest(req)&&ua.trim()?'App VPN no identificada':''), hash=deviceHashForRequest(req), token=clients[0]&&clients[0].sub_token;
    if(!appName)return clients.map(client=>({client,result:{ok:true,added:false,updated:false,tracked:false,displayName:'',appName:'',location:''}}));
    const seenBefore=!!vpnDb.prepare(`SELECT 1 FROM subscription_devices d JOIN clients c ON c.id=d.client_id WHERE c.sub_token=? AND d.device_hash=? LIMIT 1`).get(token,hash);const priorNotice=vpnDb.prepare(`SELECT MAX(d.admin_notified_at) notified FROM subscription_devices d JOIN clients c ON c.id=d.client_id WHERE c.sub_token=? AND d.device_hash=?`).get(token,hash);const lastNoticeMs=priorNotice&&priorNotice.notified?new Date(String(priorNotice.notified).replace(' ','T')).getTime():0;
    const noticeKey=String(token||'')+':'+hash;const lockNow=Date.now();for(const [k,v] of subscriptionNoticeLocks)if(v<lockNow)subscriptionNoticeLocks.delete(k);const lockUntil=subscriptionNoticeLocks.get(noticeKey)||0,dbCooldown=Date.now()-lastNoticeMs<30*60*1000,allowNotice=lockUntil<lockNow&&!dbCooldown;
    for(const c of clients){const prior=vpnDb.prepare('SELECT id FROM subscription_devices WHERE client_id=? AND device_hash=?').get(c.id,hash);if(!prior&&Number(c.device_limit)>0){const count=vpnDb.prepare('SELECT COUNT(*) n FROM subscription_devices WHERE client_id=?').get(c.id).n;if(count>=Number(c.device_limit))return clients.map(x=>({client:x,result:{ok:false,error:'device_limit'}}));}}
    const results=clients.map(c=>({client:c,result:trackDevice(c.id,req,c.device_limit||0)}));
    if(results.some(x=>!x.result.ok))return results;
    const added=results.filter(x=>x.result.added),updated=results.some(x=>x.result.updated)&&seenBefore;
    if((added.length||updated)&&allowNotice){
      const affected=added.length?added.map(x=>x.client.name):clients.map(c=>c.name),identity=added[0]||results.find(x=>x.result.tracked),device=identity&&identity.result.displayName||deviceDisplayName(ua),model=identity&&identity.result.model||'',eventName=added.length?'Nueva suscripción':'Suscripción actualizada',ip=String(req.ip||'').replace(/^::ffff:/i,'');
      subscriptionNoticeLocks.set(noticeKey,lockNow+30*60*1000);
      setImmediate(async()=>{try{let location=await lookupDeviceLocation(ip);if(!location){const prior=vpnDb.prepare(`SELECT location FROM subscription_devices WHERE device_hash=? AND client_id IN (SELECT id FROM clients WHERE sub_token=?) AND COALESCE(location,'')<>'' ORDER BY last_seen DESC LIMIT 1`).get(hash,token);location=prior&&prior.location||''}if(location)vpnDb.prepare("UPDATE subscription_devices SET location=? WHERE device_hash=? AND client_id IN (SELECT id FROM clients WHERE sub_token=?)").run(location,hash,token);const modelText=model?` · Modelo: ${model}`:` · Modelo no informado (${device})`,locationText=location?` · Ubicación aprox.: ${displayDeviceLocation(location)}`:' · Ubicación aprox.: no disponible';await notifySubscriptionAdmin(`${eventName} · Cliente: ${affected.join(', ')} · App: ${appName}${modelText}${locationText}`,token,hash);vpnDb.prepare(`UPDATE subscription_devices SET admin_notified_at=datetime('now','localtime') WHERE device_hash=? AND client_id IN (SELECT id FROM clients WHERE sub_token=?)`).run(hash,token)}catch(e){subscriptionNoticeLocks.delete(noticeKey);logApply(`[DEVICE-GEO-NOTIFY] ${String(e.message||e).slice(0,200)}`)}});
    }
    return results;
}
function subscriptionUsageHeader(clients){const rows=Array.isArray(clients)?clients:[],hasUnlimited=rows.some(c=>!(Number(c.limit_gb)>0)),up=rows.reduce((sum,c)=>sum+(Number(c.limit_gb)>0?(Number(c.quota_up_bytes)||0):(Number(c.up_bytes)||0)),0),down=rows.reduce((sum,c)=>sum+(Number(c.limit_gb)>0?(Number(c.quota_down_bytes)||0):(Number(c.down_bytes)||0)),0),total=hasUnlimited?0:rows.reduce((sum,c)=>sum+Math.floor((Number(c.limit_gb)||0)*1000000000),0);return {upload:Math.floor(up),download:Math.floor(down),total:Math.floor(total)}}
function handleSubBase64(req, res) {
    try {
        const token=String(req.params.token||'').trim();
        if(!token||!validateUA(req))return res.status(404).send('Not found');
        const clients=getSubscriptionClients(token); if(!clients.length)return res.status(404).send('Not found');
        const tracked=recordSubscriptionUse(clients,req);
        if(tracked.some(x=>!x.result.ok))return res.status(403).send('Device limit reached');
        const links=clients.map(c=>buildClientLink(c)).filter(Boolean);
        if(!links.length)return res.status(404).send('No subscription available');
        const vpn=getVpnConfig();
        res.set('Content-Type','text/plain; charset=utf-8');res.set('Cache-Control','no-store');
        res.set('Profile-Update-Interval',String(vpn.subInterval||12));res.set('Accept-CH','Sec-CH-UA-Model, Sec-CH-UA-Platform');
        res.set('Profile-Title',vpn.subTitle||clients.map(c=>c.name).join(' + ').slice(0,64));
        if(vpn.subShowUsage==1){const usage=subscriptionUsageHeader(clients);res.set('Subscription-Userinfo',`upload=${usage.upload}; download=${usage.download}; total=${usage.total}; expire=0`)}
        res.send(Buffer.from(links.join('\n')).toString('base64'));
    } catch(e){res.status(500).send('Error')}
}
function handleSubJson(req, res) {
    try {
        const token=String(req.params.token||'').trim(); if(!token)return res.status(404).send('Not found');
        const vpn=getVpnConfig(); if(vpn.jsonEnabled!=1)return res.status(403).send('JSON disabled');
        if(vpn.jsonBypass&&String(vpn.jsonBypass).trim()&&String(req.get('user-agent')||'').toLowerCase().includes(String(vpn.jsonBypass).toLowerCase()))return res.status(403).send('Forbidden');
        if(!validateUA(req))return res.status(403).send('Forbidden');
        const clients=getSubscriptionClients(token);if(!clients.length)return res.status(404).send('Not found');
        const tracked=recordSubscriptionUse(clients,req);if(tracked.some(x=>!x.result.ok))return res.status(403).send('Device limit reached');
        const conf=aggregateJsonSubscription(clients);if(!conf)return res.status(404).send('No JSON config available');
        res.set('Content-Type','application/json; charset=utf-8');res.set('Cache-Control','no-store');
        res.set('Profile-Update-Interval',String(vpn.subInterval||12));res.set('Accept-CH','Sec-CH-UA-Model, Sec-CH-UA-Platform');res.set('Profile-Title',vpn.subTitle||clients.map(c=>c.name).join(' + ').slice(0,64));
        res.send(JSON.stringify(conf,null,2));
    }catch(e){res.status(500).send('Error: '+e.message)}
}
app.get('/sub/:token', (req, res) => { if (isBrowserRequest(req)) return servePortal(req, res); return handleSubBase64(req, res); });
app.get('/portal/:token', servePortal);
app.get('/subjson/:token',(req,res)=>isBrowserRequest(req)?servePortal(req,res):handleSubJson(req,res));
app.get(/^\/(.+)\/([^/]+)$/, (req,res,next)=>{
    const pathPart='/'+req.params[0].replace(/^\/|\/$/g,''); const token=req.params[1]; const vpn=getVpnConfig();
    const subPath=normalizeRoutePath(vpn.subPath||'/sub'), jsonPath=normalizeRoutePath(vpn.jsonPath||'/subjson');
    if(pathPart===subPath){req.params.token=token;if(isBrowserRequest(req))return servePortal(req,res);return handleSubBase64(req,res)}
    if(pathPart===jsonPath){req.params.token=token;if(isBrowserRequest(req))return servePortal(req,res);return handleSubJson(req,res)}
    next();
});
app.get('/:jsonPathSeg/:token', (req, res, next) => {
    const seg = String(req.params.jsonPathSeg || '');
    if (['api','static','socket.io','sub','login','logout','portal','manifest.json','admin-manifest.json','sw.js','icon-192.png','icon-512.png','apple-touch-icon.png'].includes(seg)) return next();
    const vpn = getVpnConfig();
    const confPath = String(vpn.jsonPath || '/subjson').replace(/^\/+/, '').replace(/\/+$/, '');
    if (seg !== confPath) return next();
    if(isBrowserRequest(req))return servePortal(req,res);
    return handleSubJson(req, res);
});

app.get('/icon-:size.png', async (req, res) => {
    const size = Math.min(1024, Math.max(48, parseInt(req.params.size) || 512));
    if (canvasLib && logoBuf) {
        try { const canvas = canvasLib.createCanvas(size, size); const ctx = canvas.getContext('2d'); ctx.fillStyle = '#000000'; ctx.fillRect(0, 0, size, size); const img = await canvasLib.loadImage(logoBuf); const pad = Math.floor(size * 0.225); ctx.drawImage(img, pad, pad, size - pad*2, size - pad*2); res.set('Content-Type', 'image/png'); res.set('Cache-Control', 'public, max-age=86400'); return res.send(canvas.toBuffer('image/png')); }
        catch(e) { console.error('[ICON] canvas fail:', e.message); }
    }
    const logoSrc = logoBuf ? 'data:image/png;base64,' + logoBuf.toString('base64') : LOGO_URL;
    const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${size} ${size}"><rect width="${size}" height="${size}" fill="#000000"/><image x="${size*0.225}" y="${size*0.225}" width="${size*0.55}" height="${size*0.55}" href="${logoSrc}" preserveAspectRatio="xMidYMid meet"/></svg>`;
    res.set('Content-Type', 'image/svg+xml'); res.set('Cache-Control', 'public, max-age=86400'); res.send(svg);
});
app.get('/apple-touch-icon.png', (req, res) => res.redirect('/icon-180.png'));

app.get('/manifest.json', (req, res) => {
    const token = String(req.query.token || '');
    const c = token ? vpnDb.prepare('SELECT name FROM clients WHERE sub_token = ? AND enabled=1 ORDER BY id LIMIT 1').get(token) : null;
    const name = c ? `GZMNET - ${c.name}` : 'GZMNET';
    const manifest = { name, short_name: 'GZMNET', start_url: token ? `/portal/${token}` : '/', scope: '/', display: 'standalone', background_color: '#111318', theme_color: '#111318', orientation: 'portrait', icons: [{ src: '/icon-192.png', sizes: '192x192', type: 'image/png', purpose: 'any' }, { src: '/icon-512.png', sizes: '512x512', type: 'image/png', purpose: 'any' }, { src: '/icon-512.png', sizes: '512x512', type: 'image/png', purpose: 'maskable' }] };
    res.set('Content-Type', 'application/manifest+json'); res.send(JSON.stringify(manifest));
});

app.get('/admin-manifest.json', (req, res) => {
    const manifest = { name: 'GZMNET Panel', short_name: 'GZMNET', start_url: '/', scope: '/', display: 'standalone', background_color: '#111318', theme_color: '#111318', orientation: 'portrait', icons: [{ src: '/icon-192.png', sizes: '192x192', type: 'image/png', purpose: 'any' }, { src: '/icon-512.png', sizes: '512x512', type: 'image/png', purpose: 'any' }, { src: '/icon-512.png', sizes: '512x512', type: 'image/png', purpose: 'maskable' }] };
    res.set('Content-Type', 'application/manifest+json'); res.send(JSON.stringify(manifest));
});

app.get('/sw.js', (req, res) => {
    res.set('Content-Type', 'application/javascript'); res.set('Cache-Control','no-store, no-cache, must-revalidate, max-age=0'); res.set('Service-Worker-Allowed', '/');
    res.send(`self.addEventListener('install', e => self.skipWaiting());self.addEventListener('activate', e => e.waitUntil(clients.claim()));self.addEventListener('push', e => { let d = { title: 'GZMNET', body: '' }; try { d = e.data.json(); } catch(err) {} const opts = { body: d.body || '', icon: '/icon-192.png', badge: '/icon-192.png', vibrate: [200,100,200], data: { url: d.url || '/' } }; if (d.tag) { opts.tag = d.tag; opts.renotify = true; } e.waitUntil(self.registration.showNotification(d.title || 'GZMNET', opts)); });self.addEventListener('notificationclick', e => { e.notification.close(); const url = (e.notification.data && e.notification.data.url) || '/'; e.waitUntil(clients.matchAll({ type: 'window', includeUncontrolled: true }).then(ws => { for (const w of ws) { if (w.url.includes(url)) return w.focus(); } if (clients.openWindow) return clients.openWindow(url); })); });`);
});

function servePortal(req, res) {
    try {
        const token = String(req.params.token || '').trim();
        if (!token) return res.status(404).send('Not found');
        const group = vpnDb.prepare(`SELECT c.*, i.protocol, i.name as inbound_name, i.port FROM clients c JOIN inbounds i ON i.id = c.inbound_id WHERE c.sub_token = ? AND c.enabled=1 ORDER BY i.id,c.id`).all(token).filter(c=>!protocolUsesAuth(c.protocol));
        if (!group.length) return res.status(404).send('Portal no encontrado');
        const c={...group[0], name:group.map(x=>x.name).join(' + ').slice(0,100), inbound_name:group.map(x=>x.inbound_name).join(', ').slice(0,100), total_bytes:group.reduce((a,x)=>a+(Number(x.total_bytes)||0),0), quota_used_bytes:group.reduce((a,x)=>a+(Number(x.quota_used_bytes)||0),0), quota_up_bytes:group.reduce((a,x)=>a+(Number(x.quota_up_bytes)||0),0), quota_down_bytes:group.reduce((a,x)=>a+(Number(x.quota_down_bytes)||0),0), up_bytes:group.reduce((a,x)=>a+(Number(x.up_bytes)||0),0), down_bytes:group.reduce((a,x)=>a+(Number(x.down_bytes)||0),0), limit_gb:group.reduce((a,x)=>a+(Number(x.limit_gb)||0),0),client_ids:group.map(x=>Number(x.id)),online:group.some(x=>Number(x.online)===1),last_seen:group.map(x=>x.last_seen).filter(Boolean).sort().pop()||null};
        const vpn = getVpnConfig();
        const jsonEnabled = vpn.jsonEnabled == 1;
        const subPort = vpn.subPort || vpn.panelPort || 443;
        const subPortPart = subPort == 443 ? '' : ':' + subPort;
        const subUrl = `https://${vpn.domain}${subPortPart}${vpn.subPath || '/sub'}/${c.sub_token}`;
        const jsonUrl = jsonEnabled ? `https://${vpn.domain}${subPortPart}${vpn.jsonPath || '/subjson'}/${c.sub_token}` : '';
        res.set('Cache-Control', 'no-store');
        res.send(renderPortalHTML(c, subUrl, jsonUrl, jsonEnabled, vapidKeys.publicKey, token));
    } catch(e) { res.status(500).send('Error'); }
}

function portalEscape(value){return String(value==null?'':value).replace(/[&<>\"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',"'":'&#39;'}[ch]))}
function portalMessageHtml(value){const escaped=portalEscape(value);return escaped.replace(/https?:\/\/[^\s<>&]+/gi,raw=>{const url=raw.replace(/[),.;!?]+$/,'');const tail=raw.slice(url.length);return `<a href="${portalEscape(url)}" target="_blank" rel="noopener noreferrer">${portalEscape(url)}</a>${tail}`}).replace(/\r?\n/g,'<br>')}
function renderPortalHTML(c, subUrl, jsonUrl, jsonEnabled, vapidPub, token) {
    const fmtB = b => { b = Number(b)||0; if (b<=0) return '0 B'; const k=1000; const u=['B','KB','MB','GB','TB']; const i=Math.min(Math.floor(Math.log(b)/Math.log(k)),u.length-1); return (b/Math.pow(k,i)).toFixed(2)+' '+u[i]; };
    const lim = c.limit_gb || 0;
    const lifetimeTotal=Number(c.total_bytes)||0;
    const usageForLimit=Number(c.quota_used_bytes??lifetimeTotal)||0;
    const displayTotal=lim>0?usageForLimit:lifetimeTotal,displayUp=lim>0?(Number(c.quota_up_bytes)||0):(Number(c.up_bytes)||0),displayDown=lim>0?(Number(c.quota_down_bytes)||0):(Number(c.down_bytes)||0);
    const pct = lim > 0 ? Math.min(100, (usageForLimit/(lim*1000*1000*1000))*100) : 0;
    const relDate = (dStr) => { if (!dStr) return ''; try { const today = new Date(); today.setHours(0,0,0,0); const t = new Date(dStr + 'T00:00:00'); const diff = Math.round((t.getTime() - today.getTime()) / 86400000); if (diff === 0) return ''; if (diff === 1) return 'Mañana'; if (diff < 0) return ''; return 'En ' + diff + ' día' + (diff !== 1 ? 's' : ''); } catch(e) { return ''; } };
    const nextPayDate = c.payment_enabled ? (getNextPaymentDate(c) || c.payment_date) : '';
    const payDateBlock = (c.payment_enabled && nextPayDate) ? `<div class="date-card"><div class="date-icon"><i data-lucide="credit-card"></i></div><div class="date-body"><div class="date-label">Fecha de pago</div><div class="date-value">${formatDateSpanish(nextPayDate)}</div>${relDate(nextPayDate)?`<div class="date-rel">${relDate(nextPayDate)}</div>`:''}</div></div>` : '';
    const payMessage=String(c.payment_message||'').trim().slice(0,1200);
    const safeMessage=portalMessageHtml(payMessage);
    const paymentMessageBlock=(c.payment_enabled&&payMessage&&nextPayDate===getTodayKey())?`<div class="card payment-message"><div class="card-title"><i data-lucide="message-circle"></i> Mensaje de tu cuenta</div><div class="payment-message-text">${safeMessage}</div></div>`:'';

    const limitBar = lim > 0 ? `<div class="usage-bar"><div class="usage-fill" style="width:${pct}%"></div></div><div class="usage-text">${fmtB(usageForLimit)} de ${lim} GB (${pct.toFixed(0)}%)</div>` : '<div class="usage-text">Sin límite de datos</div>';

    return `<!DOCTYPE html>
<html lang="es"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<meta name="theme-color" content="#111318"><meta name="color-scheme" content="dark light">
<script>(()=>{try{const t=localStorage.getItem("gzmnet-theme");if(t==="light"||t==="dark")document.documentElement.setAttribute("data-theme",t)}catch(e){}})();</script>
<link rel="manifest" href="/manifest.json?token=${token}">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="icon" href="/icon-192.png">
<title>GZMNET - ${portalEscape(c.name)}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://unpkg.com/lucide@0.451.0/dist/umd/lucide.min.js"></script>
<style>
:root{--bg:#0a0a0c;--surface:#121216;--surface-2:#1a1a20;--border:rgba(255,255,255,0.08);--border-2:rgba(255,255,255,0.14);--text:#f5f5f5;--text-2:#a1a1aa;--text-3:#52525b;--accent:#3b82f6;--accent-2:#60a5fa;--success:#22c55e;--warning:#f59e0b;--danger:#ef4444;--radius:12px}
@media(prefers-color-scheme:light){:root{--bg:#f4f4f7;--surface:#fff;--surface-2:#f0f0f5;--border:rgba(0,0,0,0.08);--border-2:rgba(0,0,0,0.14);--text:#18181b;--text-2:#52525b;--text-3:#a1a1aa}}
*{margin:0;padding:0;box-sizing:border-box}
body{background:var(--bg);color:var(--text);font-family:'Inter',system-ui,sans-serif;min-height:100vh;padding:16px;padding-top:max(16px,env(safe-area-inset-top));padding-bottom:max(16px,env(safe-area-inset-bottom));transition:background 0.2s}
.wrap{max-width:440px;margin:0 auto}
.hero{display:flex;flex-direction:column;align-items:center;padding:24px 0;gap:12px}
.logo-plate{width:70px;height:70px;border-radius:18px;background:#000000;display:flex;align-items:center;justify-content:center;padding:14px;box-shadow:0 8px 24px rgba(0,0,0,0.4);border:1px solid rgba(255,255,255,0.08)}
.logo-plate img{width:100%;height:100%;object-fit:contain}
.name{font-family:'Sora',sans-serif;font-size:22px;font-weight:600;text-align:center}
.meta{display:flex;gap:6px;flex-wrap:wrap;justify-content:center;margin-top:2px}
.badge{display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:8px;font-size:11.5px;font-weight:600}
.badge svg{width:12px;height:12px}
.badge.proto{background:rgba(59,130,246,0.15);color:var(--accent-2)}
.badge.on{background:rgba(34,197,94,0.15);color:var(--success)}
.badge.off{background:rgba(239,68,68,0.15);color:var(--danger)}
.badge.server{background:var(--surface-2);color:var(--text-2)}
.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:18px;margin-bottom:12px}
.card-title{display:flex;align-items:center;gap:8px;font-family:'Sora',sans-serif;font-size:13px;font-weight:600;margin-bottom:14px}
.card-title svg{width:16px;height:16px;color:var(--accent-2)}
.stats-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px}
.stat{background:var(--surface-2);border-radius:10px;padding:12px}
.stat-label{display:flex;align-items:center;gap:5px;font-size:10.5px;color:var(--text-3);font-weight:600;letter-spacing:0.05em;text-transform:uppercase;margin-bottom:4px}
.stat-label svg{width:11px;height:11px}
.stat-value{font-family:'JetBrains Mono',monospace;font-size:15px;font-weight:600}
.stat-value.up{color:#60a5fa}
.stat-value.down{color:#94a3b8}
.stat-value.total{color:var(--accent-2);font-size:17px}
.usage-bar{height:8px;background:var(--surface-2);border-radius:999px;overflow:hidden;margin:10px 0 6px}
.usage-fill{height:100%;background:linear-gradient(90deg,#3b82f6,#2563eb);border-radius:999px;transition:width 0.5s}
.usage-text{font-size:12px;color:var(--text-2);text-align:center}.live-dot{margin-left:auto;width:9px;height:9px;border-radius:50%;display:inline-block;background:var(--text-3);box-shadow:0 0 0 3px rgba(113,113,122,.12)}.live-dot.is-online{background:var(--success);box-shadow:0 0 0 3px rgba(34,197,94,.14);animation:portal-online-pulse 1.8s ease-out infinite}.live-dot.is-offline{animation:none;opacity:.7}@keyframes portal-online-pulse{0%{box-shadow:0 0 0 0 rgba(34,197,94,.35)}70%{box-shadow:0 0 0 8px rgba(34,197,94,0)}100%{box-shadow:0 0 0 0 rgba(34,197,94,0)}}
.date-card{display:flex;align-items:center;gap:14px;padding:14px;background:linear-gradient(135deg,rgba(59,130,246,0.1),rgba(59,130,246,0.04));border:1px solid rgba(59,130,246,0.2);border-radius:12px}
.date-icon{width:42px;height:42px;border-radius:12px;background:rgba(59,130,246,0.15);display:flex;align-items:center;justify-content:center;color:var(--accent-2);flex-shrink:0}
.date-icon svg{width:20px;height:20px}
.date-body{flex:1}
.date-label{font-size:11px;font-weight:600;color:var(--text-2);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:3px}
.date-value{font-family:'Sora',sans-serif;font-size:16px;font-weight:600}
.date-rel{font-size:12px;color:var(--accent-2);font-weight:600;margin-top:3px}.payment-message-text{font-size:13px;line-height:1.6;color:var(--text-2);overflow-wrap:anywhere}.payment-message-text a{color:var(--accent-2);text-decoration:underline;word-break:break-word}
.btn{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;padding:14px;border-radius:12px;font-size:14px;font-weight:600;font-family:'Sora',sans-serif;border:none;cursor:pointer;transition:all 0.15s;margin-bottom:8px;touch-action:manipulation}
.btn svg{width:16px;height:16px}
.btn-primary{background:var(--accent);color:#fff}
.btn-primary:active{transform:scale(0.98)}
.btn-ghost{background:var(--surface-2);color:var(--text);border:1px solid var(--border)}
.install-banner{background:linear-gradient(135deg,rgba(59,130,246,0.15),rgba(139,92,246,0.15));border:1px solid rgba(59,130,246,0.3);border-radius:14px;padding:14px;margin-bottom:12px;display:none;align-items:center;gap:12px}
.install-banner.on{display:flex}
.install-icon{width:40px;height:40px;border-radius:10px;background:rgba(59,130,246,0.2);display:flex;align-items:center;justify-content:center;color:var(--accent-2);flex-shrink:0}
.install-icon svg{width:18px;height:18px}
.install-body{flex:1;min-width:0}
.install-title{font-weight:600;font-size:13.5px;margin-bottom:2px}
.install-text{font-size:11.5px;color:var(--text-2)}
.install-btn{padding:8px 14px;background:var(--accent);color:#fff;border:none;border-radius:8px;font-size:12.5px;font-weight:600;cursor:pointer}
.toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%) translateY(80px);background:var(--surface);border:1px solid var(--border-2);padding:12px 18px;border-radius:10px;font-size:13px;opacity:0;transition:all 0.3s;box-shadow:0 8px 24px rgba(0,0,0,0.3);z-index:100;display:flex;align-items:center;gap:8px}
.toast.on{opacity:1;transform:translateX(-50%) translateY(0)}
.toast svg{width:14px;height:14px}


/* GZMNET portal: comparte la paleta del panel y conserva el tema elegido */
:root{--bg:#111318;--surface:rgba(18,18,22,.96);--surface-2:#1a1a20;--border:rgba(255,255,255,.07);--border-2:rgba(255,255,255,.13);--text:#f5f5f5;--text-2:#a1a1aa;--text-3:#71717a;--accent:#3b82f6;--accent-2:#60a5fa;--success:#22c55e;--warning:#f59e0b;--danger:#ef4444;--radius:18px;color-scheme:dark}
:root[data-theme="light"]{--bg:#fafafa;--surface:rgba(255,255,255,.97);--surface-2:#f4f4f5;--border:rgba(0,0,0,.075);--border-2:rgba(0,0,0,.13);--text:#18181b;--text-2:#52525b;--text-3:#71717a;--accent:#2563eb;--accent-2:#3b82f6;--success:#16a34a;--warning:#d97706;--danger:#dc2626;color-scheme:light}
body{background:radial-gradient(ellipse at 50% -18%,rgba(59,130,246,.14),transparent 48%),var(--bg);padding:clamp(14px,4vw,30px);font-family:'Inter',system-ui,sans-serif;transition:background-color .3s,color .3s}
.wrap{max-width:560px}.hero{position:relative;isolation:isolate;overflow:hidden;align-items:flex-start;text-align:left;padding:22px 22px 20px;margin:4px 0 18px;border:1px solid var(--border-2);border-radius:24px;background:linear-gradient(145deg,var(--surface),color-mix(in srgb,var(--surface) 82%,var(--accent) 18%));box-shadow:0 18px 48px rgba(0,0,0,.18);gap:12px;animation:portal-in .65s cubic-bezier(.2,.8,.2,1) both}
.hero:after{content:'';position:absolute;z-index:0;width:220px;height:220px;right:-100px;top:-135px;border-radius:50%;background:radial-gradient(circle,rgba(59,130,246,.24),rgba(59,130,246,0) 68%);animation:portal-glow 8s ease-in-out infinite alternate;pointer-events:none}.hero>*{position:relative;z-index:1}.hero .logo-plate{position:relative;z-index:1}
.hero:before{content:'TU CUENTA GZMNET';font-size:10px;letter-spacing:.18em;font-weight:800;color:var(--accent-2);order:0}.hero .logo-plate{order:1;width:48px;height:48px;padding:9px;border-radius:14px;box-shadow:none;border-color:var(--border-2);position:relative;z-index:1}.hero .name{order:2;font-size:clamp(23px,6vw,30px);text-align:left;letter-spacing:-.035em;position:relative;z-index:1}.hero>div[style*='position:relative']{order:3;color:var(--text-2)!important}.hero .meta{order:4;justify-content:flex-start;margin:0;position:relative;z-index:1}.hero .meta .badge{padding:6px 10px;border:1px solid var(--border-2);background:var(--surface-2);color:var(--text-2);border-radius:999px}.hero .meta .badge.on{color:var(--success);background:rgba(34,197,94,.1)}.hero .meta .badge.off{color:var(--danger);background:rgba(239,68,68,.1)}
.card{padding:clamp(16px,4vw,22px);border-radius:20px;background:var(--surface);border-color:var(--border);backdrop-filter:blur(14px);box-shadow:0 12px 35px rgba(0,0,0,.10);margin-bottom:14px;animation:portal-in .58s cubic-bezier(.2,.8,.2,1) both}.wrap>.card:nth-of-type(1){animation-delay:.06s}.wrap>.card:nth-of-type(2){animation-delay:.12s}.wrap>.card:nth-of-type(3){animation-delay:.18s}.wrap>.card:nth-of-type(4){animation-delay:.24s}
.card-title{font-size:14px;letter-spacing:-.01em;margin-bottom:15px}.stats-grid{gap:11px}.stat{padding:15px;border:1px solid var(--border);border-radius:15px;background:var(--surface-2)}.stat-label{font-size:10px;letter-spacing:.09em}.stat-value{font-size:16px}.stat-value.total{font-size:18px}.usage-bar{height:9px;background:var(--surface-2)}.usage-fill{background:linear-gradient(90deg,var(--accent),var(--accent-2));transition:width .7s cubic-bezier(.2,.8,.2,1)}.usage-text{font-size:12px;margin-top:8px}.date-card{background:linear-gradient(130deg,rgba(59,130,246,.10),var(--surface-2));border-color:var(--border-2)}
.btn{border-radius:14px;padding:14px 16px;font-family:'Inter',system-ui,sans-serif;font-size:13.5px;box-shadow:0 7px 18px rgba(0,0,0,.10);transition:transform .2s ease,box-shadow .2s ease,background-color .2s ease}.btn-primary{background:linear-gradient(135deg,var(--accent),#2563eb)}.btn-ghost{background:var(--surface-2);border-color:var(--border-2)}.btn:last-child{margin-bottom:0}.btn:hover{transform:translateY(-2px);box-shadow:0 10px 22px rgba(59,130,246,.18)}.btn:active{transform:translateY(0) scale(.99)}
.payment-message{border-color:rgba(59,130,246,.25);background:linear-gradient(145deg,color-mix(in srgb,var(--surface) 90%,var(--accent) 10%),var(--surface))}.payment-message-text{padding:13px 14px;border-radius:13px;background:var(--surface-2);color:var(--text);line-height:1.7}.payment-message-text a{color:var(--accent-2)}.install-banner{border-radius:17px;background:linear-gradient(120deg,rgba(59,130,246,.12),var(--surface));border-color:var(--border-2);backdrop-filter:blur(12px)}.toast{border-radius:14px;backdrop-filter:blur(16px)}
@keyframes portal-in{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}@keyframes portal-glow{from{transform:translate3d(-6px,0,0) scale(.94);opacity:.55}to{transform:translate3d(8px,7px,0) scale(1.08);opacity:1}}
@media(max-width:420px){body{padding:12px}.hero{padding:18px;border-radius:21px}.card{padding:15px;border-radius:17px}.stats-grid{gap:8px}.stat{padding:12px}.stat-value{font-size:14px}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;scroll-behavior:auto!important;transition-duration:.01ms!important}}
</style></head>
<body>
<div class="wrap">
<div class="install-banner" id="installBanner"><div class="install-icon"><i data-lucide="download"></i></div><div class="install-body"><div class="install-title">Instalar esta app</div><div class="install-text">Accede más rápido a tu cuenta</div></div><button class="install-btn" id="installBtn">Instalar</button></div>
<div class="hero">
    <div class="logo-plate"><img src="${LOGO_URL}" alt="GZMNET"></div>
    <div class="name">${portalEscape(c.name)}</div>
    <div style="position:relative;z-index:1;color:rgba(234,242,255,.75);font-size:12px;">Tu conexión y cuenta, en un solo lugar.</div>
    <div class="meta">
        <span class="badge proto"><i data-lucide="zap"></i>${portalEscape((c.protocol||'').toUpperCase())}</span>
        <span class="badge server"><i data-lucide="server"></i>${portalEscape(c.inbound_name)}</span>
        <span class="badge ${c.enabled ? 'on' : 'off'}"><i data-lucide="power"></i>${c.enabled ? 'Activo' : 'Inactivo'}</span>
    </div>
</div>
<div class="card" id="statsCard">
    <div class="card-title"><i data-lucide="bar-chart-3"></i> Consumo de datos <span id="liveDot" class="live-dot ${c.online?'is-online':'is-offline'}" aria-label="${c.online?'En línea':'Desconectado'}"></span></div>
    <div class="portal-limit-chip" id="portalLimitChip" ${lim>0?'':'style="display:none"'}>LÍMITE DE ${lim>0?portalEscape(Number(lim).toLocaleString('es-DO',{maximumFractionDigits:3})):''} GB</div>
    <div class="stats-grid">
        <div class="stat"><div class="stat-label"><i data-lucide="arrow-up"></i>Subida</div><div class="stat-value up" id="statUp">${fmtB(displayUp)}</div></div>
        <div class="stat"><div class="stat-label"><i data-lucide="arrow-down"></i>Bajada</div><div class="stat-value down" id="statDown">${fmtB(displayDown)}</div></div>
    </div>
    <div class="stat"><div class="stat-label"><i data-lucide="activity"></i>Total</div><div class="stat-value total" id="statTotal">${fmtB(displayTotal)}</div></div>
    <div id="usageBarWrap">${limitBar}</div>
</div>
${payDateBlock ? `<div class="card"><div class="card-title"><i data-lucide="calendar"></i> Fechas importantes</div>${payDateBlock}</div>` : ''}
${paymentMessageBlock}
<div class="card">
    <div class="card-title"><i data-lucide="link"></i> Accesos rápidos</div>
    <button class="btn btn-primary" onclick="copyText('${subUrl}')"><i data-lucide="copy"></i> Copiar enlace de suscripción</button>
    ${jsonEnabled && jsonUrl ? `<button class="btn btn-ghost" onclick="copyText('${jsonUrl}')"><i data-lucide="file-json"></i> Copiar enlace JSON</button>` : ''}
</div>
<div class="card" id="notifCard" style="display:none;">
    <div class="card-title"><i data-lucide="bell"></i> Notificaciones</div>
    <p id="notifMessage" style="font-size:12.5px;color:var(--text-2);margin-bottom:12px;line-height:1.5;">Activa las notificaciones para recibir recordatorios de pago en tu teléfono.</p>
    <button class="btn btn-primary" id="notifBtn" onclick="requestNotif()"><i data-lucide="bell-ring"></i> <span id="notifBtnText">Permitir notificaciones</span></button>
</div>
</div>
<div class="toast" id="toast"><i data-lucide="check"></i><span id="toastText"></span></div>
<script src="/socket.io/socket.io.js"></script>
<script>
const TOKEN = '${token}';
const INITIAL_TOTAL = ${displayTotal};
const INITIAL_LIMIT_GB = ${lim};
let VAPID_PUB = '${vapidPub}';
function renderIcons(){ if(window.lucide){ try{window.lucide.createIcons();}catch(e){} } }


renderIcons();
window.addEventListener('DOMContentLoaded', renderIcons);
function showToast(t) { const el = document.getElementById('toast'); document.getElementById('toastText').textContent = t; el.classList.add('on'); setTimeout(() => el.classList.remove('on'), 2500); }
function copyText(t) { if (navigator.clipboard) navigator.clipboard.writeText(t).then(() => showToast('Copiado')); else { const ta = document.createElement('textarea'); ta.value = t; document.body.appendChild(ta); ta.select(); document.execCommand('copy'); ta.remove(); showToast('Copiado'); } }
function b64ToUint8(b64) { const pad = '='.repeat((4 - b64.length % 4) % 4); const raw = atob((b64 + pad).replace(/-/g, '+').replace(/_/g, '/')); return new Uint8Array([...raw].map(c => c.charCodeAt(0))); }
function hideNotifCard() { const c = document.getElementById('notifCard'); if (c) c.style.display = 'none'; }
function showNotifCard() { const c = document.getElementById('notifCard'); if (c) c.style.display = 'block'; }
function fmtB(b){ b = Number(b)||0; if (b<=0) return '0 B'; const k=1000; const u=['B','KB','MB','GB','TB']; const i=Math.min(Math.floor(Math.log(b)/Math.log(k)), u.length-1); return (b/Math.pow(k,i)).toFixed(2)+' '+u[i]; }

const socket = io({transports:['websocket','polling'],reconnection:true,reconnectionAttempts:Infinity,reconnectionDelay:1000,reconnectionDelayMax:10000,timeout:20000});
socket.on('disconnect',reason=>console.warn('[live] conexión en tiempo real interrumpida:',reason));
socket.on('connect_error',err=>console.warn('[live] reconexión:',err&&err.message||err));
socket.on('vpn_stats', (data) => {
    try {
        const rows=data.filter(x=>x&&[${(c.client_ids||[c.id]).join(',')}].includes(Number(x.id)));
        if(!rows.length)return;const base=rows.find(x=>Number(x.id)===${c.id})||rows[0],c=rows.length>1?{...base,up:rows.reduce((a,x)=>a+(Number(x.up)||0),0),down:rows.reduce((a,x)=>a+(Number(x.down)||0),0),total:rows.reduce((a,x)=>a+(Number(x.total)||0),0),quota_used:rows.reduce((a,x)=>a+(Number(x.quota_used)||0),0),quota_up:rows.reduce((a,x)=>a+(Number(x.quota_up)||0),0),quota_down:rows.reduce((a,x)=>a+(Number(x.quota_down)||0),0),limit_gb:rows.reduce((a,x)=>a+(Number(x.limit_gb)||0),0)}:base;
        const live=document.getElementById('liveDot');if(live){const isOnline=rows.some(x=>!!x.connected);live.classList.toggle('is-online',isOnline);live.classList.toggle('is-offline',!isOnline);live.setAttribute('aria-label',isOnline?'En línea':'Desconectado');}
        const liveLimit=Number(c.limit_gb)||0,liveTotal=liveLimit>0?(Number(c.quota_used)||0):(Number(c.total)||0),liveUp=liveLimit>0?(Number(c.quota_up)||0):(Number(c.up)||0),liveDown=liveLimit>0?(Number(c.quota_down)||0):(Number(c.down)||0);
        const isLive=rows.some(x=>!!x.connected),fmtRate=b=>fmtB(b)+'/s';
        const upEl = document.getElementById('statUp'); if (upEl) upEl.textContent = isLive?fmtRate(rows.reduce((a,x)=>a+(Number(x.up_rate)||0),0)):fmtB(liveUp);
        const downEl = document.getElementById('statDown'); if (downEl) downEl.textContent = isLive?fmtRate(rows.reduce((a,x)=>a+(Number(x.down_rate)||0),0)):fmtB(liveDown);
        const totalEl = document.getElementById('statTotal'); if (totalEl) totalEl.textContent = fmtB(liveTotal);
        const limitChip=document.getElementById('portalLimitChip');if(limitChip){limitChip.style.display=liveLimit>0?'inline-flex':'none';limitChip.textContent=liveLimit>0?'LÍMITE DE '+liveLimit.toLocaleString('es-DO',{maximumFractionDigits:3})+' GB':'';}
        const wrap = document.getElementById('usageBarWrap');
        if(wrap){if(liveLimit>0){const pct=Math.min(100,(liveTotal/(liveLimit*1000000000))*100);wrap.innerHTML='<div class="usage-bar"><div class="usage-fill" style="width:'+pct+'%"></div></div><div class="usage-text">'+fmtB(liveTotal)+' de '+liveLimit+' GB ('+pct.toFixed(0)+'%)</div>'}else wrap.innerHTML='<div class="usage-text">Sin límite de datos</div>'}
    } catch(e) {}
});


async function fetchVapid() {
    try { const r = await fetch('/api/portal/' + TOKEN + '/vapid?t='+Date.now(), { cache: 'no-store',credentials:'same-origin' }); const d = await r.json(); if (d.ok && d.publicKey) { VAPID_PUB = d.publicKey; return true; }setNotifMessage(d.error||'El servidor todavía no dispone de notificaciones.'); } catch(e) { setNotifMessage('No se pudo consultar el servicio de notificaciones.'); }
    return false;
}
function setNotifMessage(message,buttonText){const p=document.getElementById('notifMessage'),b=document.getElementById('notifBtnText');if(p&&message)p.textContent=message;if(b&&buttonText)b.textContent=buttonText;}
function pushKeyMatches(sub){try{const current=sub&&sub.options&&sub.options.applicationServerKey;if(!current)return null;const norm=s=>String(s||'').replace(/=/g,'').replace(/-/g,'+').replace(/_/g,'/');return norm(btoa(String.fromCharCode(...new Uint8Array(current))))===norm(VAPID_PUB)}catch(e){return null}}
async function syncPushSubscription(sub,allowRenew=true){try{if(!sub)return false;const data=sub.toJSON?sub.toJSON():sub,r=await fetch('/api/portal/'+TOKEN+'/subscribe',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data),cache:'no-store',credentials:'same-origin'}),d=await r.json();if(r.ok&&d.ok)return true;if(d.renew&&allowRenew){setNotifMessage(d.error||'Actualizando suscripción push…');try{await sub.unsubscribe()}catch(e){}const reg=await navigator.serviceWorker.ready,fresh=await reg.pushManager.subscribe({userVisibleOnly:true,applicationServerKey:b64ToUint8(VAPID_PUB)});return await syncPushSubscription(fresh,false)}setNotifMessage(d.error||'No se pudo registrar la suscripción en este servidor.');return false}catch(e){setNotifMessage('No se pudo sincronizar la suscripción con este servidor.');return false}}
async function subscribe(forceNew=false) {
    try {
        if (!VAPID_PUB && !(await fetchVapid())) { showNotifCard();return false; }
        const reg = await navigator.serviceWorker.ready;
        let sub = await reg.pushManager.getSubscription();
        if(sub){const matches=pushKeyMatches(sub);if(forceNew||matches===false){try{await sub.unsubscribe()}catch(e){}sub=null}else if(!forceNew){const ok=await syncPushSubscription(sub);if(ok)hideNotifCard();else showNotifCard();return ok}}
        if(!sub){try{sub=await reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: b64ToUint8(VAPID_PUB) })}catch(e){if(/already exists|registration|failed/i.test(e.message||'')){const stale=await reg.pushManager.getSubscription();if(stale)try{await stale.unsubscribe()}catch(_){}sub=await reg.pushManager.subscribe({userVisibleOnly:true,applicationServerKey:b64ToUint8(VAPID_PUB)})}else throw e}}
        const ok=await syncPushSubscription(sub);if(ok)hideNotifCard();else showNotifCard();return ok;
    } catch(e) { showNotifCard();setNotifMessage('La suscripción local no se pudo actualizar: '+(e.message||'error del navegador'),'Sincronizar notificaciones');return false; }
}
async function requestNotif() {
    try {
        if (!VAPID_PUB && !(await fetchVapid())) { showNotifCard();showToast('Notificaciones no disponibles en el servidor');return; }
        if(!('Notification' in window)){showToast('Este navegador no admite notificaciones');return}
        const perm = Notification.permission==='granted'?'granted':await Notification.requestPermission();
        if (perm !== 'granted') { showNotifCard();setNotifMessage('El permiso está bloqueado en el navegador.');showToast('Permiso denegado'); return; }
        const ok = await subscribe();
        if (ok) showToast('Notificaciones activadas en este dispositivo');
        else showToast('No se pudo registrar la suscripción; revisa el aviso del portal');
    } catch(e) { showNotifCard();setNotifMessage(e.message||'No se pudo activar');showToast('Error: ' + e.message); }
}
async function checkNotifStatus() {
    if (!('serviceWorker' in navigator) || !('PushManager' in window) || !('Notification' in window)) { hideNotifCard(); return; }
    if (Notification.permission === 'denied') { showNotifCard();setNotifMessage('Las notificaciones están bloqueadas por el navegador. Revisa el permiso de este sitio.','Revisar permisos');return; }
    if (!(await fetchVapid())) { showNotifCard();setNotifMessage('El servicio de notificaciones no está disponible todavía.','Reintentar');return; }
    if (Notification.permission === 'granted') { try { const reg = await navigator.serviceWorker.ready; const sub = await reg.pushManager.getSubscription(); if(sub&&await syncPushSubscription(sub)){hideNotifCard();return}showNotifCard();setNotifMessage('El permiso sigue activo, pero esta suscripción no está registrada en el servidor. Sincronízala para recibir avisos.','Sincronizar notificaciones');return; } catch(e) {showNotifCard();setNotifMessage('No se pudo revisar la suscripción en este dispositivo.');return} }
    showNotifCard();setNotifMessage('Activa las notificaciones para recibir recordatorios de pago.');
}
async function bootstrapNotif() {
    if (!('serviceWorker' in navigator) || !('PushManager' in window) || !('Notification' in window)) { hideNotifCard(); return; }
    try { await navigator.serviceWorker.register('/sw.js',{updateViaCache:'none'}); } catch(e) {showNotifCard();setNotifMessage('No se pudo iniciar el servicio del portal: '+(e.message||''));return;}
    try { await navigator.serviceWorker.ready; } catch(e) {showNotifCard();setNotifMessage('El servicio del portal todavía no está listo.');return;}
    await checkNotifStatus();
    if (Notification.permission === 'granted') { try { const reg = await navigator.serviceWorker.ready; const sub = await reg.pushManager.getSubscription(); if(sub){if(await syncPushSubscription(sub))hideNotifCard();else showNotifCard()}else{setNotifMessage('El permiso ya está concedido; toca sincronizar para crear la suscripción.','Sincronizar notificaciones');showNotifCard()} } catch(e) {showNotifCard()} }
}
bootstrapNotif();

let installPrompt = null;
window.addEventListener('beforeinstallprompt', e => { e.preventDefault(); installPrompt = e; document.getElementById('installBanner').classList.add('on'); });
document.getElementById('installBtn').addEventListener('click', async () => { if (!installPrompt) return; installPrompt.prompt(); await installPrompt.userChoice; installPrompt = null; document.getElementById('installBanner').classList.remove('on'); });
</script>
</body></html>`;
}

app.post('/api/portal/:token/subscribe', async (req, res) => {
    try {
        const token = String(req.params.token || '').trim();
        const group=vpnDb.prepare('SELECT c.id,i.protocol FROM clients c JOIN inbounds i ON i.id=c.inbound_id WHERE c.sub_token=? AND c.enabled=1').all(token).filter(c=>!protocolUsesAuth(c.protocol));
        if(!group.length)return res.status(404).json({ok:false,error:'Portal no encontrado'});
        const sub=req.body;if(!sub||!sub.endpoint||!sub.keys||!sub.keys.p256dh||!sub.keys.auth)return res.status(400).json({ok:false,error:'Suscripción inválida'});
        const invalid=vpnDb.prepare('SELECT p256dh,auth FROM push_invalid_endpoints WHERE endpoint=?').get(sub.endpoint);
        if(invalid&&invalid.p256dh===sub.keys.p256dh&&invalid.auth===sub.keys.auth)return res.status(409).json({ok:false,error:'Esta suscripción fue rechazada con la clave actual del servidor; se debe renovar.',renew:true});
        if(invalid){vpnDb.prepare('DELETE FROM push_invalid_endpoints WHERE endpoint=?').run(sub.endpoint);vpnDb.prepare('DELETE FROM push_subscriptions WHERE endpoint=?').run(sub.endpoint)}
        const previous=vpnDb.prepare('SELECT p256dh,auth,vapid_public_key FROM push_subscriptions WHERE endpoint=? LIMIT 1').get(sub.endpoint),needsProbe=!previous||previous.p256dh!==sub.keys.p256dh||previous.auth!==sub.keys.auth||previous.vapid_public_key!==vapidKeys.publicKey;
        const save=vpnDb.prepare('INSERT INTO push_subscriptions(client_id,endpoint,p256dh,auth,created_at,vapid_public_key) VALUES(?,?,?,?,datetime(\'now\',\'localtime\'),?) ON CONFLICT(client_id,endpoint) DO UPDATE SET p256dh=excluded.p256dh,auth=excluded.auth,vapid_public_key=excluded.vapid_public_key');
        vpnDb.transaction(()=>{for(const c of group)save.run(c.id,sub.endpoint,sub.keys.p256dh,sub.keys.auth,vapidKeys.publicKey)})();
        if(needsProbe){try{await webpush.sendNotification({endpoint:sub.endpoint,keys:{p256dh:sub.keys.p256dh,auth:sub.keys.auth}},JSON.stringify({title:'GZMNET',body:'Notificaciones conectadas correctamente.'}),{TTL:PUSH_SYNC_PROBE_TTL_SECONDS,urgency:'low'});vpnDb.prepare('DELETE FROM push_invalid_endpoints WHERE endpoint=?').run(sub.endpoint)}catch(pushErr){const code=Number(pushErr.statusCode)||0;logApply(`[PUSH-SYNC-PROBE-FAIL] code=${code} ${String(pushErr.message||'').slice(0,160)}`);if([401,403,404,410].includes(code)){vpnDb.prepare("INSERT OR REPLACE INTO push_invalid_endpoints(endpoint,p256dh,auth,marked_at) VALUES(?,?,?,datetime('now','localtime'))").run(sub.endpoint,sub.keys.p256dh,sub.keys.auth);vpnDb.prepare('DELETE FROM push_subscriptions WHERE endpoint=?').run(sub.endpoint);return res.status(409).json({ok:false,error:'El proveedor rechazó la suscripción guardada en este teléfono. Renovando con la clave de este servidor…',renew:true})}vpnDb.prepare('DELETE FROM push_subscriptions WHERE endpoint=?').run(sub.endpoint);return res.status(503).json({ok:false,error:'No se pudo validar el servicio push ahora mismo. Reintenta sincronizar las notificaciones.'})}}
        logApply(`[SUBSCRIBE-CLIENT-OK] clients=${group.length} probed=${needsProbe}`);res.json({ok:true,clients:group.length});
    } catch(e) { logApply(`[SUBSCRIBE-CLIENT-ERR] ${e.message}`); res.status(500).json({ ok: false, error: e.message }); }
});

app.post('/api/admin/subscribe', checkAuth, async (req, res) => {
    try {
        const sub = req.body;
        if (!sub || !sub.endpoint || !sub.keys || !sub.keys.p256dh || !sub.keys.auth) return res.status(400).json({ ok: false, error: 'Suscripción inválida' });
        const oldPushKey=vpnDb.prepare('SELECT endpoint FROM push_invalid_endpoints WHERE endpoint=?').get(sub.endpoint);if(oldPushKey){const current=vpnDb.prepare('SELECT p256dh,auth FROM admin_push_subscriptions WHERE endpoint=?').get(sub.endpoint);if(!current||current.p256dh===sub.keys.p256dh&&current.auth===sub.keys.auth)return res.status(409).json({ok:false,error:'La clave del servidor cambió. Renovando notificaciones de este dispositivo…',renew:true});vpnDb.prepare('DELETE FROM push_invalid_endpoints WHERE endpoint=?').run(sub.endpoint);vpnDb.prepare('DELETE FROM admin_push_subscriptions WHERE endpoint=?').run(sub.endpoint)}
        vpnDb.prepare('DELETE FROM admin_push_subscriptions WHERE endpoint = ?').run(sub.endpoint);
        vpnDb.prepare('INSERT INTO admin_push_subscriptions (endpoint, p256dh, auth) VALUES (?,?,?)').run(sub.endpoint, sub.keys.p256dh, sub.keys.auth);
        logApply(`[SUBSCRIBE-ADMIN-OK]`);
        res.json({ ok: true });
    } catch(e) { logApply(`[SUBSCRIBE-ADMIN-ERR] ${e.message}`); res.status(500).json({ ok: false, error: e.message }); }
});

function deviceLastSeenIso(value){try{if(!value)return '';const d=new Date(String(value).trim().replace(' ','T'));return Number.isNaN(d.getTime())?'':d.toISOString()}catch(e){return ''}}
