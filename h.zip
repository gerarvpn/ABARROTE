    try {
        const rows = vpnDb.prepare('SELECT id, name, path, enabled, length(html) as html_len, created_at, updated_at FROM web_pages ORDER BY id DESC').all();
        res.json({ ok: true, pages: rows });
    } catch (e) { res.status(500).json({ ok: false, error: e.message }); }
});
app.get('/api/web-pages/:id', checkAuth, (req, res) => {
    try {
        const row = vpnDb.prepare('SELECT * FROM web_pages WHERE id = ?').get(req.params.id);
        if (!row) return res.status(404).json({ ok: false, error: 'No existe' });
        res.json({ ok: true, page: row });
    } catch (e) { res.status(500).json({ ok: false, error: e.message }); }
});
app.post('/api/web-pages', checkAuth, (req, res) => {
    try {
        const name = String(req.body.name || '').trim();
        let pathSlug = slugifyPath(req.body.path || name);
        if(['api','socket.io','login','logout','portal','sub','subjson','p','manifest.json','admin-manifest.json','sw.js','icon-180.png','icon-192.png','icon-512.png','apple-touch-icon.png'].includes(pathSlug.split('/')[0].toLowerCase()))return res.status(400).json({ok:false,error:'Esa ruta está reservada por el panel. Elige otra.'});
        const html = String(req.body.html || '');
        const enabled = req.body.enabled == 0 ? 0 : 1;
        if (!name) return res.status(400).json({ ok: false, error: 'Nombre requerido' });
        const exists = vpnDb.prepare('SELECT id FROM web_pages WHERE path = ?').get(pathSlug);
        if (exists) pathSlug = pathSlug + '-' + Date.now().toString(36).slice(-4);
        const r = vpnDb.prepare("INSERT INTO web_pages (name, path, html, enabled) VALUES (?,?,?,?)").run(name, pathSlug, html, enabled);
        res.json({ ok: true, id: r.lastInsertRowid, page: vpnDb.prepare('SELECT * FROM web_pages WHERE id = ?').get(r.lastInsertRowid) });
    } catch (e) { res.status(500).json({ ok: false, error: e.message }); }
});
app.put('/api/web-pages/:id', checkAuth, (req, res) => {
    try {
        const row = vpnDb.prepare('SELECT * FROM web_pages WHERE id = ?').get(req.params.id);
        if (!row) return res.status(404).json({ ok: false, error: 'No existe' });
        const name = String(req.body.name != null ? req.body.name : row.name).trim();
        const pathSlug = slugifyPath(req.body.path != null ? req.body.path : row.path);
        if(['api','socket.io','login','logout','portal','sub','subjson','p','manifest.json','admin-manifest.json','sw.js','icon-180.png','icon-192.png','icon-512.png','apple-touch-icon.png'].includes(pathSlug.split('/')[0].toLowerCase())) return res.status(400).json({ok:false,error:'Esa ruta está reservada por el panel. Elige otra.'});
        const html = req.body.html != null ? String(req.body.html) : row.html;
        const enabled = req.body.enabled != null ? (req.body.enabled ? 1 : 0) : row.enabled;
        const clash = vpnDb.prepare('SELECT id FROM web_pages WHERE path = ? AND id != ?').get(pathSlug, row.id);
        if (clash) return res.status(400).json({ ok: false, error: 'Ruta ya usada' });
        vpnDb.prepare("UPDATE web_pages SET name=?, path=?, html=?, enabled=?, updated_at=datetime('now','localtime') WHERE id=?").run(name, pathSlug, html, enabled, row.id);
        res.json({ ok: true, page: vpnDb.prepare('SELECT * FROM web_pages WHERE id = ?').get(row.id) });
    } catch (e) { res.status(500).json({ ok: false, error: e.message }); }
});
app.delete('/api/web-pages/:id', checkAuth, (req, res) => {
    try {
        vpnDb.prepare('DELETE FROM web_pages WHERE id = ?').run(req.params.id);
        res.json({ ok: true });
    } catch (e) { res.status(500).json({ ok: false, error: e.message }); }
});
// Público: servir página por path

app.get(/^\/(.+)$/, (req,res,next)=>{ try { const pathValue=slugifyPath(decodeURIComponent(req.params[0]||'')); if(['api','socket.io','login','logout','portal','sub','subjson','icon-180.png','icon-192.png','icon-512.png','apple-touch-icon.png','manifest.json','admin-manifest.json','sw.js'].includes(pathValue.split('/')[0])) return next(); const row=vpnDb.prepare('SELECT * FROM web_pages WHERE path=? AND enabled=1').get(pathValue); if(!row)return next(); res.setHeader('Content-Type','text/html; charset=utf-8'); res.setHeader('Cache-Control','no-store'); res.send(row.html||'<!doctype html><html><body></body></html>'); } catch(e){next()} });


app.get('/api/inbounds/:id/export', checkAuth, (req, res) => {
    try {
        const ib = vpnDb.prepare('SELECT * FROM inbounds WHERE id = ?').get(req.params.id);
        if (!ib) return res.status(404).json({ ok: false, error: 'No existe' });
        const clients = vpnDb.prepare('SELECT name, uuid, email, flow, limit_gb, enabled, up_bytes, down_bytes, total_bytes, quota_used_bytes, quota_up_bytes, quota_down_bytes, quota_exhausted_at, expiry_enabled, expiry_date, expiry_time, last_seen, auth_user, auth_pass, device_limit, routing_enabled, routing_filters_enabled, custom_routing_enabled, payment_enabled, payment_date, payment_frequency, payment_time, telegram_chat_id, last_payment_notified, payment_message, sub_token FROM clients WHERE inbound_id = ?').all(ib.id);
        const inbound = Object.assign({}, ib, { vless_decryption: ib.vless_decryption || '', vless_encryption: ib.vless_encryption || '' });
        delete inbound.id;
        delete inbound.created_at;
        delete inbound.updated_at;
        res.json({ ok: true, server: { inbound, clients } });
    } catch (e) { res.status(500).json({ ok: false, error: e.message }); }
});
app.post('/api/inbounds/import', checkAuth, async (req, res) => {
    let newId=null, openedPort=null;
    try {
        const root=req.body||{};
        let wrapper=root.server&&typeof root.server==='object'?root.server:root;
        const is3xui=!!(wrapper.protocol&&wrapper.settings&&wrapper.streamSettings);
        let src=wrapper.inbound||wrapper;
        if(src.inbound&&typeof src.inbound==='object')src=src.inbound;
        const proto=String(src.protocol||'').toLowerCase();
        if(!PROTOCOL_TRANSPORTS[proto])return res.status(400).json({ok:false,error:`Protocolo 3x-ui no soportado: ${proto||'vacío'}`});
        const port=parseInt(src.port,10);
        if(!Number.isInteger(port)||port<1||port>65535)return res.status(400).json({ok:false,error:'Puerto inválido en el JSON'});
        if(isPortInUseByOtherInbound(port,null))return res.status(409).json({ok:false,error:`Ya existe un servidor usando el puerto ${port}. No se importó nada para evitar sobrescribirlo.`});
        if(await isPortInUseSystem(port))return res.status(409).json({ok:false,error:`El puerto ${port} ya está ocupado por otro servicio. No se importó nada.`});
