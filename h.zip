app.get('/api/backup/download', checkAuth, (req, res) => { try { const filename = `gzmnet-backup-${getTodayKey()}-${Date.now()}.json`; res.setHeader('Content-Type', 'application/json; charset=utf-8'); res.setHeader('Content-Disposition', `attachment; filename="${filename}"`); res.send(generateBackupJson()); } catch(e) { res.status(500).json({ ok: false, error: e.message }); } });
app.post('/api/backup/restore', checkAuth, async (req, res) => {
    try {
        const b = req.body;
        if (!b || typeof b !== 'object' || !Array.isArray(b.inbounds)) return res.status(400).json({ ok: false, error: 'Backup inválido' });
        vpnDb.exec('BEGIN');
        try {
            vpnDb.prepare('DELETE FROM subscription_devices').run();
            if(Array.isArray(b.pushSubscriptions)||Array.isArray(b.adminPushSubscriptions)){vpnDb.prepare('DELETE FROM push_subscriptions').run();vpnDb.prepare('DELETE FROM admin_push_subscriptions').run()}
            if(b.vapidKeys&&b.vapidKeys.publicKey&&b.vapidKeys.privateKey)vpnDb.prepare('DELETE FROM push_invalid_endpoints').run();
            vpnDb.prepare('DELETE FROM clients').run(); vpnDb.prepare('DELETE FROM inbounds').run(); vpnDb.prepare('DELETE FROM routing_rules').run();
            if(Array.isArray(b.routingSettings)&&b.routingSettings.length){const rs=b.routingSettings.find(x=>Number(x.id)===1)||b.routingSettings[0],keys=['block_ads','block_youtube_ads','block_adult','block_malware','block_trackers','block_bittorrent','prevent_captcha','warp_enabled','domain_strategy','ip_type','fake_dns','dns_primary','dns_secondary','dns_primary_v6','dns_secondary_v6','dns_query_strategy'];if(rs&&typeof rs==='object'){const vals=keys.map(k=>rs[k]!==undefined?rs[k]:0);vpnDb.prepare(`UPDATE routing_settings SET ${keys.map(k=>k+'=?').join(',')} WHERE id=1`).run(...vals)}}
            const iS = vpnDb.prepare(`INSERT INTO inbounds (id, name, protocol, port, network, path, tls, domain, tls_sni, host, security, flow, sniffing, encryption, fingerprint, alpn, reality_dest, reality_server_names, reality_private_key, reality_public_key, reality_short_ids, grpc_service, grpc_multi, h2_path, h2_host, quic_key, quic_security, quic_header, kcp_seed, kcp_header, xhttp_path, xhttp_host, xhttp_mode, ss_method, vless_decryption, vless_encryption) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)`);
            for (const ib of b.inbounds) iS.run(ib.id, ib.name, ib.protocol, ib.port, ib.network||'ws', ib.path||'/', ib.tls?1:0, ib.domain||'', ib.tls_sni||'', ib.host||'', ib.security||'none', ib.flow||'', ib.sniffing?1:0, ib.encryption||'', ib.fingerprint||'chrome', ib.alpn||'', ib.reality_dest||'', ib.reality_server_names||'', ib.reality_private_key||'', ib.reality_public_key||'', ib.reality_short_ids||'', ib.grpc_service||'', ib.grpc_multi?1:0, ib.h2_path||'/', ib.h2_host||'', ib.quic_key||'', ib.quic_security||'none', ib.quic_header||'none', ib.kcp_seed||'', ib.kcp_header||'none', ib.xhttp_path||'/', ib.xhttp_host||'', ib.xhttp_mode||'auto', ib.ss_method||'aes-256-gcm', ib.vless_decryption||'', ib.vless_encryption||'');
            const cS = vpnDb.prepare(`INSERT INTO clients (id,inbound_id,name,uuid,email,flow,limit_gb,enabled,last_seen,up_bytes,down_bytes,total_bytes,online,sub_token,sub_blocked,auth_user,auth_pass,prev_uuid,prev_auth_user,prev_auth_pass,payment_enabled,payment_date,payment_frequency,payment_time,telegram_chat_id,last_payment_notified,device_limit,payment_message,quota_used_bytes,quota_up_bytes,quota_down_bytes,quota_exhausted_at,expiry_enabled,expiry_date,expiry_time,routing_enabled,routing_filters_enabled,custom_routing_enabled) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)`);
            for (const c of (b.clients || [])){const quotaUsed=Math.max(0,Number(c.quota_used_bytes??(Number(c.limit_gb)>0?c.total_bytes:0))||0),quotaParts=quotaDirectionFromRecord(c,quotaUsed);cS.run(c.id, c.inbound_id, c.name, c.uuid, c.email||`c${c.id}`, c.flow||'', c.limit_gb||0, c.enabled?1:0, c.last_seen||null, c.up_bytes||0, c.down_bytes||0, c.total_bytes||0, 0, c.sub_token||null, c.sub_blocked||0, c.auth_user||'', c.auth_pass||'', c.prev_uuid||'', c.prev_auth_user||'', c.prev_auth_pass||'', c.payment_enabled||0, c.payment_date||'', c.payment_frequency||0, c.payment_time||'09:00', c.telegram_chat_id||'', '', c.device_limit||0, c.payment_message||'',quotaUsed,quotaParts.up,quotaParts.down,c.quota_exhausted_at||'',c.expiry_enabled?1:0,c.expiry_date||'',c.expiry_time||'23:59',c.routing_enabled==null?1:(Number(c.routing_enabled)!==0?1:0),c.routing_filters_enabled==null?1:(Number(c.routing_filters_enabled)!==0?1:0),c.custom_routing_enabled==null?1:(Number(c.custom_routing_enabled)!==0?1:0));}
            const pS=vpnDb.prepare('INSERT INTO push_subscriptions(client_id,endpoint,p256dh,auth,created_at,vapid_public_key) VALUES(?,?,?,?,?,?)');
            for(const x of (b.pushSubscriptions||[])){if(x&&x.client_id&&x.endpoint&&x.p256dh&&x.auth&&vpnDb.prepare('SELECT 1 FROM clients WHERE id=?').get(x.client_id))pS.run(x.client_id,x.endpoint,x.p256dh,x.auth,x.created_at||new Date().toISOString(),'')}
            const apS=vpnDb.prepare('INSERT INTO admin_push_subscriptions(endpoint,p256dh,auth,created_at) VALUES(?,?,?,?)');
            for(const x of (b.adminPushSubscriptions||[]))if(x&&x.endpoint&&x.p256dh&&x.auth)apS.run(x.endpoint,x.p256dh,x.auth,x.created_at||new Date().toISOString());
            const rS = vpnDb.prepare(`INSERT INTO routing_rules (id, name, match_type, value, outbound, enabled, priority, match_rules) VALUES (?,?,?,?,?,?,?,?)`);
            for (const r of (b.routingRules || [])) if (['block','direct','warp','proxy'].includes(String(r.outbound))) rS.run(r.id, r.name, r.match_type, r.value, r.outbound, r.enabled?1:0, r.priority||0, r.match_rules||'');
            const restoreValidation=await validateXrayConfig(JSON.stringify(buildXrayConfig(),null,2));if(!restoreValidation.ok)throw new Error(`El respaldo no se restauró: Xray rechazó la configuración combinada (incluido el enrutamiento individual). ${String(restoreValidation.output||'').slice(0,800)}`);
            if(Array.isArray(b.adminNotifications)){vpnDb.prepare('DELETE FROM admin_notifications').run();const nS=vpnDb.prepare('INSERT INTO admin_notifications(title,body,created_at,seen) VALUES(?,?,?,?)');for(const n of b.adminNotifications)nS.run(String(n.title||'Notificación').slice(0,160),String(n.body||'').slice(0,1000),n.created_at||new Date().toISOString(),n.seen?1:0)}
            if(Array.isArray(b.paymentReminderJobs)){vpnDb.prepare('DELETE FROM payment_reminder_jobs').run();const jS=vpnDb.prepare('INSERT INTO payment_reminder_jobs(client_id,reminder_key,sent_count,attempts,next_send_at,next_send_epoch,completed,created_at) VALUES(?,?,?,?,?,?,?,?)');for(const j of b.paymentReminderJobs)if(j&&vpnDb.prepare('SELECT 1 FROM clients WHERE id=?').get(j.client_id))jS.run(j.client_id,j.reminder_key,j.sent_count||0,j.attempts||0,j.next_send_at||new Date().toISOString(),j.next_send_epoch||0,j.completed?1:0,j.created_at||new Date().toISOString())}
            vpnDb.exec('COMMIT');
        } catch(e) { try { vpnDb.exec('ROLLBACK'); } catch(e2){} throw e; }
        if(b.vapidKeys&&b.vapidKeys.publicKey&&b.vapidKeys.privateKey)persistVapidKeys(b.vapidKeys);
        if (b.vpnConfig) { const cur = getVpnConfig(); const merged = Object.assign({}, b.vpnConfig, { domain: cur.domain || b.vpnConfig.domain, panelPort: cur.panelPort || b.vpnConfig.panelPort }); saveVpnConfig(merged); try{if(!syncSubscriptionListener(merged.subPort||merged.panelPort||443))logApply('[SUB-NGINX-RESTORE] no se pudo aplicar el puerto/ruta importados')}catch(e){logApply(`[SUB-NGINX-RESTORE] ${e.message}`)} if (merged.timezone) { SERVER_TZ = merged.timezone; process.env.TZ = merged.timezone; } }
        statsCache = { data: null, time: 0 }; totalsCache = { data: null, time: 0 }; invalidateConfigCache(); forceNextApply = true; lastWrittenConfigHash = '';
        const restoredXray=await applyXrayNow();if(!restoredXray||!restoredXray.ok){logApply(`[BACKUP-ROUTING-APPLY-ERROR] ${restoredXray&&restoredXray.error||'Xray no confirmó la restauración'}`);return res.status(503).json({ok:false,error:`El respaldo quedó guardado, pero Xray no confirmó el enrutamiento restaurado. El panel conserva la configuración y se puede reintentar desde Reiniciar Xray. ${restoredXray&&restoredXray.error||''}`})}emitRefresh();emitVpnStats();res.json({ok:true});
    } catch(e) { res.status(500).json({ ok: false, error: e.message }); }
});

app.get('/api/system-info',checkAuth,async(req,res)=>{try{const now=Date.now();if(sysInfoCache&&(now-sysInfoCacheTime)<5000)return res.json(sysInfoCache);const totalMem=os.totalmem(),usedMem=totalMem-os.freemem(),settings=vpnDb.prepare('SELECT ip_type FROM routing_settings WHERE id=1').get()||{},mode=['ipv4','ipv6','dual'].includes(settings.ip_type)?settings.ip_type:'dual';const [ipv4,ipv6]=await Promise.all([mode==='ipv6'?Promise.resolve('N/A'):getPublicIp(4),mode==='ipv4'?Promise.resolve('N/A'):getPublicIp(6)]);const vpn=getVpnConfig();const xrayVersion=await new Promise(r=>exec('/usr/local/bin/xray version 2>/dev/null | head -1',{timeout:3000},(e,o)=>r((o||'').trim().split(' ').slice(1).join(' ')||'desconocida')));const payload={ok:true,nodeVersion:process.version,xrayVersion,uptime:Math.floor(process.uptime()),memTotal:totalMem,memUsed:usedMem,memPercent:((usedMem/totalMem)*100).toFixed(1),cpuUsage:cpuUsagePercent.toFixed(1),cpuLoad:os.loadavg()[0].toFixed(2),cpuCount:os.cpus().length,ipv4,ipv6,ipType:mode,timezone:SERVER_TZ,timeFormat:vpn.timeFormat||'24h'};sysInfoCache=payload;sysInfoCacheTime=now;res.json(payload)}catch(e){res.json({ok:false,error:e.message})}});
app.get('/api/system-metrics', checkAuth, (req, res) => {
    try {
        const rows = vpnDb.prepare("SELECT ts, cpu, ram FROM system_metrics WHERE ts >= datetime('now','localtime','-3 days') ORDER BY ts ASC").all();
        res.json({ ok: true, metrics: rows });
    } catch(e) { res.status(500).json({ ok: false, error: e.message }); }
});
app.get('/api/status', checkAuth, async (req, res) => { try { res.json({ ok: true, xrayActive: await checkXrayActive(), healthy: xrayHealthy, wireproxyReady, vapidPublicKey: vapidKeys.publicKey }); } catch(e) { res.json({ ok: false }); } });
app.get('/api/logs',checkAuth,(req,res)=>{try{const n=Math.max(20,Math.min(500,parseInt(req.query.lines)||200)),source=['all','app','xray','apply'].includes(req.query.source)?req.query.source:'all',errorOnly=req.query.level==='error';const journal=(unit)=>{const args=['-u',unit,'-n',String(n),'--no-pager','-o','short-iso'];if(errorOnly)args.push('-p','err..emerg');try{return execFileSync('journalctl',args,{timeout:8000,encoding:'utf8'})}catch(e){return ''}};const parts=[];if(source==='all'||source==='app')parts.push('=== PANEL ===\n'+journal('gzmnet.service'));if(source==='all'||source==='xray')parts.push('=== XRAY ===\n'+journal('gzmnet-xray.service'));if(source==='all'||source==='apply'){let x='';try{x=fs.existsSync(APPLY_LOG)?fs.readFileSync(APPLY_LOG,'utf8').split('\n').slice(-n).join('\n'):''}catch(e){}if(errorOnly)x=x.split('\n').filter(l=>/error|fail|exception|uncaught|rejected|fatal/i.test(l)).join('\n');parts.push('=== APLICACIÓN / CAMBIOS ===\n'+x)}const logs=parts.join('\n\n').trim();res.json({ok:true,logs:logs||'No hay registros para los filtros seleccionados.'})}catch(e){res.status(500).json({ok:false,error:e.message})}});
app.get('/api/config-view', checkAuth, (req, res) => { try { res.json({ ok: true, config: fs.readFileSync(XRAY_CONFIG, 'utf8') }); } catch(e) { res.json({ ok: false, error: e.message }); } });
app.get('/api/test-config', checkAuth, async (req, res) => { try { const content = fs.readFileSync(XRAY_CONFIG, 'utf8'); const result = await validateXrayConfig(content); res.json({ ok: true, valid: result.ok, output: result.output }); } catch(e) { res.json({ ok: false, error: e.message }); } });
app.post('/api/restart-xray',checkAuth,async(req,res)=>{try{lastWrittenConfigHash='';forceNextApply=true;invalidateConfigCache();const result=await applyXrayNow();if(!result.ok)return res.status(400).json({ok:false,error:result.error||'No se pudo aplicar la configuración'});res.json({ok:true})}catch(e){res.status(500).json({ok:false,error:e.message})}});
app.post('/api/credentials', checkAuth, (req, res) => { try { const fc = getConfig(); if (req.body.user) fc.adminUser = req.body.user; if (req.body.pass) fc.adminPassword = req.body.pass; fs.writeFileSync(CONFIG_PATH, JSON.stringify(fc, null, 2)); try { fs.chmodSync(CONFIG_PATH, 0o600); } catch(e){} res.json({ ok: true }); } catch(e) { res.status(500).json({ ok: false, error: e.message }); } });
app.get('/api/traffic-total', checkAuth, (req, res) => { try { const now = Date.now(); if (totalsCache.data && (now - totalsCache.time) < 500) return res.json(totalsCache.data); const row = vpnDb.prepare('SELECT COALESCE(SUM(up_bytes),0) as up, COALESCE(SUM(down_bytes),0) as down, COALESCE(SUM(total_bytes),0) as total FROM clients').get(); const payload = { ok: true, up: row.up, down: row.down, total: row.total, active: vpnDb.prepare('SELECT COUNT(*) as c FROM clients WHERE online = 1').get().c, totalClients: vpnDb.prepare('SELECT COUNT(*) as c FROM clients').get().c, totalInbounds: vpnDb.prepare('SELECT COUNT(*) as c FROM inbounds').get().c, top: vpnDb.prepare('SELECT name, total_bytes FROM clients ORDER BY total_bytes DESC LIMIT 5').all() }; totalsCache = { data: payload, time: now }; res.json(payload); } catch(e) { res.json({ ok: false, error: e.message }); } });

app.get('/api/admin-notifications',checkAuth,(req,res)=>{try{const rows=vpnDb.prepare('SELECT id,title,body,created_at,seen FROM admin_notifications ORDER BY id DESC LIMIT 60').all();res.json({ok:true,notifications:rows})}catch(e){res.status(500).json({ok:false,error:e.message})}});
app.post('/api/admin-notifications/read',checkAuth,(req,res)=>{try{vpnDb.prepare('UPDATE admin_notifications SET seen=1 WHERE seen=0').run();res.json({ok:true})}catch(e){res.status(500).json({ok:false,error:e.message})}});
app.get('/api/payments/upcoming', checkAuth, (req, res) => { try { res.json({ ok: true, ...getUpcoming() }); } catch(e) { res.status(500).json({ ok: false, error: e.message }); } });

app.post('/api/notifications/test-admin', checkAuth, async (req, res) => {
    try {
        if (!webpush) return res.json({ ok: false, error: 'webpush no disponible' });
        if (!vapidKeys.publicKey) return res.json({ ok: false, error: 'VAPID keys no configuradas' });
        const subs = vpnDb.prepare('SELECT COUNT(*) as c FROM admin_push_subscriptions').get().c;
        if (subs === 0) return res.json({ ok: false, error: 'No hay dispositivos suscritos. Abre el panel en el dispositivo y sincroniza las notificaciones.' });
        const r = await sendPushToAdmin({ title: '🧪 Test GZMNET', body: 'Notificación de prueba del panel.', url: '/' });
        res.json({ ok: r.ok, sent: r.sent, total: r.total, error: r.ok ? null : 'No se pudo enviar' });
    } catch(e) { res.status(500).json({ ok: false, error: e.message }); }
});
app.post('/api/notifications/test-client/:id', checkAuth, async (req, res) => {
    try {
        if (!webpush) return res.json({ ok: false, error: 'webpush no disponible' });
        if (!vapidKeys.publicKey) return res.json({ ok: false, error: 'VAPID keys no configuradas' });
        const c = vpnDb.prepare('SELECT id, name, sub_token FROM clients WHERE id = ?').get(req.params.id);
        if (!c) return res.json({ ok: false, error: 'Cliente no existe' });
        if (!c.sub_token) return res.json({ ok: false, error: 'Este cliente no tiene suscripción (SOCKS/HTTP)' });
        const subs = vpnDb.prepare('SELECT COUNT(*) as c FROM push_subscriptions WHERE client_id = ?').get(c.id).c;
        const invalid=vpnDb.prepare('SELECT COUNT(*) as c FROM push_subscriptions s JOIN push_invalid_endpoints x ON x.endpoint=s.endpoint WHERE s.client_id=?').get(c.id).c;if(invalid>0)return res.json({ok:false,error:'La suscripción del portal ya no coincide con la clave del servidor. Abre el portal instalado para sincronizarla o renovarla.'});
        if (subs === 0) return res.json({ ok: false, error: `El cliente ${c.name} no tiene dispositivos suscritos. Abre el portal desde el dispositivo y elige «Sincronizar notificaciones».` });
        const r = await sendPushToClient(c.id, { title: '🧪 Test GZMNET', body: `Hola ${c.name}, notificación de prueba.`, url: '/portal/' + c.sub_token });
        res.json({ ok: r.ok, sent: r.sent, total: r.total, error: r.ok ? null : r.error||'No se pudo enviar; revisa la suscripción y el servicio push' });
    } catch(e) { res.status(500).json({ ok: false, error: e.message }); }
});

app.get('/api/telegram/settings', checkAuth, (req, res) => { try { const s = getTelegramSettings(); res.json({ ok: true, settings: { enabled: s.enabled||0, bot_token: s.bot_token||'', admin_ids: s.admin_ids||'', notify_payment: s.notify_payment||0, notify_online: s.notify_online||0, auto_backup: s.auto_backup||0, auto_backup_hour: (s.auto_backup_hour === 0 || s.auto_backup_hour) ? s.auto_backup_hour : 3, auto_backup_minute: (s.auto_backup_minute === 0 || s.auto_backup_minute) ? s.auto_backup_minute : 0, last_backup_at: s.last_backup_at||'' } }); } catch(e) { res.status(500).json({ ok: false, error: e.message }); } });
app.post('/api/telegram/settings', checkAuth, (req, res) => {
    try {
        const { enabled, bot_token, admin_ids, notify_payment, notify_online, auto_backup, auto_backup_hour, auto_backup_minute } = req.body;
        const ah = parseInt(auto_backup_hour, 10);
        const am = parseInt(auto_backup_minute, 10);
        saveTelegramSettings({ enabled: enabled?1:0, bot_token: String(bot_token||'').trim(), admin_ids: String(admin_ids||'').trim(), notify_payment: notify_payment?1:0, notify_online: notify_online?1:0, auto_backup: auto_backup?1:0, auto_backup_hour: isNaN(ah) ? 3 : Math.max(0, Math.min(23, ah)), auto_backup_minute: isNaN(am) ? 0 : Math.max(0, Math.min(59, am)) });
        if (!telegramPolling) startTelegramPolling();
        res.json({ ok: true });
    } catch(e) { res.status(500).json({ ok: false, error: e.message }); }
});
app.post('/api/telegram/test', checkAuth, async (req, res) => { try { const admins = getAdminIds(); if (!admins.length) return res.json({ ok: false, error: 'Configura al menos un admin_id' }); const r = await tgSend(admins[0], '<b>GZMNET Test</b>\n\nBot funcionando'); res.json({ ok: r.ok, error: r.ok ? null : (r.description || '') }); } catch(e) { res.status(500).json({ ok: false, error: e.message }); } });

io.on('connection', (socket) => {
    activeSockets++;
    try { socket.emit('vpn_stats', buildVpnStatsPayload()); } catch(e) {}
    socket.on('vpn_stats_request', () => { try { socket.emit('vpn_stats', buildVpnStatsPayload()); } catch(e){} });
    socket.on('disconnect', () => { activeSockets = Math.max(0, activeSockets - 1); });
});

setTimeout(async () => {
    try { for (const c of vpnDb.prepare('SELECT id, inbound_id FROM clients WHERE sub_token IS NULL OR sub_token = ""').all()) { const ib = vpnDb.prepare('SELECT protocol FROM inbounds WHERE id = ?').get(c.inbound_id); if (ib && protocolHasSub(ib.protocol)) { const t = ensureUniqueSubToken(); try { vpnDb.prepare('UPDATE clients SET sub_token = ? WHERE id = ?').run(t, c.id); } catch(e) {} } } } catch(e) {}
}, 3000);

// Muestrea Xray cada 3 s como en la versión estable; si falla el API no borra el estado online guardado.
setInterval(async () => {
    if (!fs.existsSync(XRAY_BIN)) return;
    if (isQuerying) return;
    isQuerying = true;
    try { const traffic = await queryTrafficStats(); if(traffic!==null)await processStatsSnapshot(traffic); emitVpnStats(); }
    catch(e) {} finally { isQuerying = false; }
}, ONLINE_POLL_INTERVAL_MS);

setTimeout(async () => {
    let waited = 0;
    while (waited < 30000) { if (await checkXrayActive()) break; await new Promise(r => setTimeout(r, 1000)); waited += 1000; }
    await refreshWireproxyStatus();
    try { invalidateConfigCache(); forceNextApply = true; lastWrittenConfigHash = ''; await applyXrayNow(); } catch(e) {}
}, 5000);

startTelegramPolling();

setTimeout(() => {
    const adminSubs = vpnDb.prepare('SELECT COUNT(*) as c FROM admin_push_subscriptions').get().c;
    const clientSubs = vpnDb.prepare('SELECT COUNT(*) as c FROM push_subscriptions').get().c;
    logApply(`[STARTUP] PUSH ready: webpush=${!!webpush} vapidPub=${!!vapidKeys.publicKey} adminSubs=${adminSubs} clientSubs=${clientSubs} TZ=${SERVER_TZ}`);
}, 3000);
APPEOF

# =================== LOGIN.HTML ===================
cat <<'LOGEOF' > views/login.html
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#111318"><meta name="color-scheme" content="dark">
<title>GZMNET | Acceso</title>
<link rel="manifest" href="/admin-manifest.json">
<link rel="icon" href="/icon-192.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://unpkg.com/lucide@0.451.0/dist/umd/lucide.min.js"></script>
<style>
:root{--bg:#08080a;--surface:rgba(18,18,22,0.94);--border:rgba(255,255,255,0.08);--border-2:rgba(255,255,255,0.14);--text:#f5f5f5;--text-2:#a1a1aa;--text-3:#52525b;--accent:#3b82f6;--accent-2:#60a5fa;--input-bg:rgba(10,10,12,0.65);--glow-1:rgba(59,130,246,0.14);--glow-2:rgba(37,99,235,0.12);--grid:rgba(255,255,255,0.015);--panel-shadow:0 18px 40px -10px rgba(0,0,0,0.65);--btn-shadow:0 5px 15px -3px rgba(59,130,246,0.55);--err-bg:rgba(239,68,68,0.08);--err-border:rgba(239,68,68,0.2);--theme-btn-bg:rgba(255,255,255,0.05)}
:root[data-theme="light"]{--bg:#f4f4f7;--surface:rgba(255,255,255,0.97);--border:rgba(0,0,0,0.08);--border-2:rgba(0,0,0,0.14);--text:#18181b;--text-2:#52525b;--text-3:#a1a1aa;--accent:#2563eb;--accent-2:#3b82f6;--input-bg:rgba(255,255,255,0.8);--glow-1:rgba(59,130,246,0.1);--glow-2:rgba(37,99,235,0.07);--grid:rgba(0,0,0,0.025);--panel-shadow:0 18px 40px -10px rgba(0,0,0,0.15);--btn-shadow:0 5px 15px -3px rgba(59,130,246,0.4);--err-bg:rgba(239,68,68,0.07);--err-border:rgba(239,68,68,0.18);--theme-btn-bg:rgba(0,0,0,0.045)}
*{margin:0;padding:0;box-sizing:border-box}
html,body{height:100%}
body{background:var(--bg);color:var(--text);font-family:'Inter',system-ui,sans-serif;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:16px;position:relative;overflow-x:hidden;transition:background 0.25s}
body::before{content:'';position:fixed;inset:0;background:radial-gradient(circle at 15% 15%,var(--glow-1),transparent 45%),radial-gradient(circle at 85% 85%,var(--glow-2),transparent 45%);pointer-events:none;z-index:0}
body::after{content:'';position:fixed;inset:0;background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);background-size:40px 40px;pointer-events:none;z-index:0;mask-image:radial-gradient(ellipse at center,black 30%,transparent 75%)}
.wrap{position:relative;z-index:1;width:100%;max-width:340px}
.panel{background:var(--surface);backdrop-filter:blur(20px) saturate(180%);border:1px solid var(--border);border-radius:18px;padding:38px 26px 20px;box-shadow:var(--panel-shadow);position:relative;overflow:hidden}
.panel::before{content:'';position:absolute;top:0;left:50%;transform:translateX(-50%);width:60%;height:1px;background:linear-gradient(90deg,transparent,var(--accent-2),transparent);opacity:0.7}
.theme-btn{position:absolute;top:12px;right:12px;z-index:2;width:34px;height:34px;border-radius:50%;background:var(--theme-btn-bg);border:1px solid var(--border);color:var(--text-2);display:flex;align-items:center;justify-content:center;cursor:pointer}
.theme-btn svg{width:14px;height:14px}
.logo-plate{width:72px;height:72px;border-radius:18px;background:#000000;display:flex;align-items:center;justify-content:center;margin:0 auto 14px;padding:14px;box-shadow:0 10px 24px rgba(0,0,0,0.4);border:1px solid rgba(255,255,255,0.08)}
.logo-plate img{width:100%;height:100%;object-fit:contain}
h1{font-family:'Sora',sans-serif;font-size:18px;font-weight:600;text-align:center;letter-spacing:0.02em}
.sub{text-align:center;font-size:10px;color:var(--text-3);margin-top:3px;margin-bottom:22px;letter-spacing:0.18em;text-transform:uppercase;font-weight:500}
label{display:block;font-size:11px;font-weight:600;color:var(--text-2);margin-bottom:6px;letter-spacing:0.06em;text-transform:uppercase}
.input-wrap{position:relative;margin-bottom:14px}
.input-wrap svg{position:absolute;left:14px;top:50%;transform:translateY(-50%);width:15px;height:15px;color:var(--text-3);pointer-events:none;transition:color 0.2s}
input{width:100%;background:var(--input-bg);border:1px solid var(--border);color:var(--text);padding:12px 14px 12px 40px;border-radius:10px;font-size:14.5px;font-family:inherit;outline:none;transition:all 0.2s}
input:focus{border-color:var(--accent-2);box-shadow:0 0 0 3px rgba(59,130,246,0.13)}
.input-wrap:focus-within svg{color:var(--accent-2)}
input::placeholder{color:var(--text-3)}
button.submit{width:100%;background:linear-gradient(135deg,#3b82f6,#2563eb);color:#fff;border:none;padding:12px;border-radius:10px;font-size:14px;font-weight:600;cursor:pointer;font-family:'Sora',sans-serif;letter-spacing:0.03em;transition:all 0.2s;margin-top:6px;box-shadow:var(--btn-shadow)}
button.submit:hover:not(:disabled){transform:translateY(-1px)}
button.submit:disabled{opacity:0.6;cursor:not-allowed}
.err{display:none;color:#f87171;font-size:12px;text-align:center;padding:9px 12px;background:var(--err-bg);border:1px solid var(--err-border);border-radius:9px;margin-bottom:12px}
.err.on{display:block}
.footer{text-align:center;font-size:10px;color:var(--text-3);margin-top:16px;letter-spacing:0.12em;font-family:'JetBrains Mono',monospace}
.footer b{color:var(--text-2);font-weight:500}

.client-stats-mini{justify-content:center!important;text-align:center!important}.client-stat{align-items:center!important;text-align:center!important}.client-stat .lbl,.client-stat .val{text-align:center!important}.client-stat-rate{color:#60a5fa!important}
.client-status-cell.active{background:rgba(96,165,250,.14)!important;box-shadow:inset 0 0 0 1px rgba(96,165,250,.3)!important;color:var(--text)!important}.client-status-cell.active[data-client-filter="expiring"]{background:rgba(245,158,11,.16)!important;box-shadow:inset 0 0 0 1px rgba(245,158,11,.35)!important}.client-status-cell:focus-visible{outline:2px solid rgba(96,165,250,.45)!important;outline-offset:1px}
</style>
</head>
<body>
<div class="wrap"><div class="panel">
  <button class="theme-btn" onclick="toggleTheme()" type="button"><i data-lucide="sun-moon" id="themeIcon"></i></button>
  <div class="logo-plate"><img src="https://i.postimg.cc/06XkJT9K/photo-output.png" alt="GZMNET"></div>
  <h1>GZMNET</h1>
  <div class="sub">Panel de control</div>
  <form onsubmit="doLogin(event)" autocomplete="off">
    <label>Usuario</label>
    <div class="input-wrap"><i data-lucide="user"></i><input type="text" id="u" placeholder="admin" required autocomplete="username" autofocus></div>
    <label>Contraseña</label>
    <div class="input-wrap"><i data-lucide="lock"></i><input type="password" id="p" placeholder="••••••••" required autocomplete="current-password"></div>
    <div id="err" class="err"></div>
    <button type="submit" class="submit" id="btn">Acceder</button>
  </form>
  <div class="footer">v<b>0.0.2</b></div>
</div></div>
<script>
function renderIcons(){ if(window.lucide){ try{window.lucide.createIcons();}catch(e){} } }


function applyTheme(t){ document.documentElement.setAttribute('data-theme',t); try{localStorage.setItem('gzmnet-theme',t);}catch(e){} const ic=document.getElementById('themeIcon'); if(ic) ic.setAttribute('data-lucide',t==='dark'?'sun':'moon'); setTimeout(renderIcons,30); }
function toggleTheme(){ const cur=document.documentElement.getAttribute('data-theme')||'dark'; applyTheme(cur==='dark'?'light':'dark'); }
(function(){ let t='dark'; try{t=localStorage.getItem('gzmnet-theme')||'dark';}catch(e){} document.documentElement.setAttribute('data-theme',t); })();
window.addEventListener('DOMContentLoaded',()=>{ const t=document.documentElement.getAttribute('data-theme')||'dark'; const ic=document.getElementById('themeIcon'); if(ic) ic.setAttribute('data-lucide',t==='dark'?'sun':'moon'); renderIcons(); });
async function doLogin(e){ e.preventDefault(); const errEl=document.getElementById('err'); const btn=document.getElementById('btn'); errEl.classList.remove('on'); btn.disabled=true; btn.textContent='Verificando...';
  try{ const res=await fetch('/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({user:document.getElementById('u').value,pass:document.getElementById('p').value})}); const data=await res.json();
    if(data.ok) location.href='/'; else { errEl.textContent=res.status===429?(data.error||'Demasiados intentos'):'Credenciales incorrectas'; errEl.classList.add('on'); btn.disabled=false; btn.textContent='Acceder'; }
  }catch(ex){ errEl.textContent='Error de conexión'; errEl.classList.add('on'); btn.disabled=false; btn.textContent='Acceder'; }
}
</script>
</body></html>
LOGEOF

