        const oldLimit=Number(old.limit_gb)||0,newLimit=limit_gb!==undefined?(parseFloat(limit_gb)||0):oldLimit,oldQuotaUsed=Number(old.quota_used_bytes)||0;
        let newQuotaUsed=newLimit<=0||oldLimit<=0?0:Math.min(oldQuotaUsed,Math.floor(newLimit*1000000000)),newQuotaUp=newLimit<=0||oldLimit<=0?0:(Number(old.quota_up_bytes)||0),newQuotaDown=newLimit<=0||oldLimit<=0?0:(Number(old.quota_down_bytes)||0);if(newLimit>0&&oldLimit>0&&oldQuotaUsed>newQuotaUsed){newQuotaUp=Math.floor(newQuotaUp*newQuotaUsed/oldQuotaUsed);newQuotaDown=newQuotaUsed-newQuotaUp}
