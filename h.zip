      <div class="field"><label>Nombre</label><input type="text" id="r-name"></div>
      <div class="field"><label>Condiciones</label><div id="conditionsList"></div><button class="btn btn-ghost btn-sm" style="margin-top:8px;" onclick="addCondition()"><i data-lucide="plus"></i> Agregar condición</button></div>
      <div class="field" style="margin-bottom:0;"><label>Acción</label><select id="r-out"><option value="block">Bloquear</option><option value="direct">Directo</option><option value="warp">WARP</option></select></div>
    </div>

