});

app.get('/api/telegram/settings', checkAuth, (req, res) => { try { const s = getTelegramSettings(); res.json({ ok: true, settings: { enabled: s.enabled||0, bot_token: s.bot_token||'', admin_ids: s.admin_ids||'', notify_payment: s.notify_payment||0, notify_online: s.notify_online||0, auto_backup: s.auto_backup||0, auto_backup_hour: (s.auto_backup_hour === 0 || s.auto_backup_hour) ? s.auto_backup_hour : 3, auto_backup_minute: (s.auto_backup_minute === 0 || s.auto_backup_minute) ? s.auto_backup_minute : 0, last_backup_at: s.last_backup_at||'' } }); } catch(e) { res.status(500).json({ ok: false, error: e.message }); } });
app.post('/api/telegram/settings', checkAuth, (req, res) => {
