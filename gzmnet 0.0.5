document.getElementById('installBtn').addEventListener('click', async () => { if (!installPrompt) return; installPrompt.prompt(); await installPrompt.userChoice; installPrompt = null; document.getElementById('installBanner').classList.remove('on'); });
</script>
</body></html>`;
}

app.post('/api/portal/:token/subscribe', async (req, res) => {
    try {
        const token = String(req.params.token || '').trim();
        const c = vpnDb.prepare('SELECT id FROM clients WHERE sub_token = ?').get(token);
        if (!c) return res.status(404).json({ ok: false, error: 'Portal no encontrado' });
        const sub = req.body;
        if (!sub || !sub.endpoint || !sub.keys || !sub.keys.p256dh || !sub.keys.auth) return res.status(400).json({ ok: false, error: 'Suscripción inválida' });
        vpnDb.prepare('DELETE FROM push_subscriptions WHERE client_id = ? AND endpoint = ?').run(c.id, sub.endpoint);
        vpnDb.prepare('INSERT INTO push_subscriptions (client_id, endpoint, p256dh, auth) VALUES (?,?,?,?)').run(c.id, sub.endpoint, sub.keys.p256dh, sub.keys.auth);
        logApply(`[SUBSCRIBE-CLIENT-OK] client=${c.id}`);
        res.json({ ok: true });
    } catch(e) { logApply(`[SUBSCRIBE-CLIENT-ERR] ${e.message}`); res.status(500).json({ ok: false, error: e.message }); }
});

