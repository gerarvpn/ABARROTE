<script>
(function(){ const _f = window.fetch.bind(window); window.fetch = async (...a) => { const r = await _f(...a); if (r.status === 401 && !location.pathname.includes('/login')) location.href = '/login'; return r; }; })();
function renderIcons(){ if(window.lucide){ try{window.lucide.createIcons();}catch(e){} } }
let _iconTO = null;
window.addEventListener('DOMContentLoaded', () => { renderIcons(); const ob = new MutationObserver(() => { clearTimeout(_iconTO); _iconTO = setTimeout(renderIcons, 80); }); ob.observe(document.body, { childList: true, subtree: true }); });
if (document.readyState !== 'loading') setTimeout(renderIcons, 80);
const socket = io({ transports: ['websocket', 'polling'], reconnection: true });
let inbounds = [], clientsByInbound = {}, vpnStats = [], allClients = [], routingSettings = {}, routingRules = [];
let protocolsInfo = {};
let editingClientId = null, editingClientInbound = null, editingClientOriginalInbound = null;
let editingInboundId = null;
let editingRuleId = null;
let currentConditions = [], selectedIpType = 'dual';
let vpnDomainCache = '';
let serverTimezone = 'America/Santo_Domingo';
let serverTimeFormat = '24h';
let timezoneList = [];
let savingClient = false, savingInbound = false, savingRule = false;
let clockPopoverTimeout = null;
let currentPortalUrl = '';
let notifList = [];
let notifSeenKeys = new Set();
let vapidPubKey = '';
const MONTHS_ES = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
function formatDateSpanish(dateStr) {
    try {
        const parts = String(dateStr).split('-');
        if (parts.length !== 3) return dateStr;
        const y = parseInt(parts[0]), m = parseInt(parts[1]) - 1, d = parseInt(parts[2]);
        if (isNaN(y) || isNaN(m) || isNaN(d) || m < 0 || m > 11) return dateStr;
        return `${d} de ${MONTHS_ES[m]}`;
    } catch(e) { return dateStr; }
}
function esc(s){ if(s==null) return ''; return String(s).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[m]); }
function fmtB(b){ b = Number(b)||0; if (b<=0) return '0 B'; const k=1024; const u=['B','KB','MB','GB','TB']; const i=Math.min(Math.floor(Math.log(b)/Math.log(k)), u.length-1); return (b/Math.pow(k,i)).toFixed(2)+' '+u[i]; }
function fmtUptime(s){ const d=Math.floor(s/86400),h=Math.floor((s%86400)/3600),m=Math.floor((s%3600)/60); if(d>0) return d+'d '+h+'h'; if(h>0) return h+'h '+m+'m'; return m+'m'; }
function fmtLastSeen(ls){ if (!ls) return '—'; try { const d = new Date(ls.indexOf('T') === -1 ? ls.replace(' ','T')+'Z' : ls); if (isNaN(d.getTime())) return '—'; const now = Date.now(); const diff = Math.floor((now - d.getTime())/1000); if (diff < 60) return 'hace ' + Math.max(1, diff) + 's'; if (diff < 3600) return 'hace ' + Math.floor(diff/60) + 'm'; if (diff < 86400) return 'hace ' + Math.floor(diff/3600) + 'h'; if (diff < 604800) return 'hace ' + Math.floor(diff/86400) + 'd'; return d.toLocaleDateString(); } catch(e){ return '—'; } }
function copyEl(id){ const el = document.getElementById(id); const v = el.value || el.textContent; if (!v) return; navigator.clipboard.writeText(v).then(() => toast('Copiado', 'success')).catch(() => {}); }
function copySysIp(id){ const el = document.getElementById(id); if (!el) return; const v = (el.textContent||'').trim(); if (!v || v === '—' || v === 'N/A') return; navigator.clipboard.writeText(v).then(() => { toast('IP copiada', 'success'); el.classList.add('copied'); setTimeout(() => el.classList.remove('copied'), 900); }).catch(() => {}); }
function getGaugeColor(pct){ if (pct < 50) return '#3b82f6'; if (pct < 70) return '#0ea5e9'; if (pct < 85) return '#f59e0b'; return '#ef4444'; }
function updateGauge(ringId, valId, pct, circ){ const ring = document.getElementById(ringId); const val = document.getElementById(valId); if (!ring || !val) return; const p = Math.max(0, Math.min(100, Number(pct) || 0)); const color = getGaugeColor(p); ring.setAttribute('stroke-dasharray', `${(p/100)*circ} ${circ}`); ring.setAttribute('stroke', color); val.textContent = Math.round(p); val.style.color = p >= 85 ? color : 'var(--text)'; }
function applyTheme(t){ document.documentElement.setAttribute('data-theme', t); try { localStorage.setItem('gzmnet-theme', t); } catch(e){} const ic = document.getElementById('themeIconGlobal'); if (ic) ic.setAttribute('data-lucide', t === 'dark' ? 'sun' : 'moon'); setTimeout(renderIcons, 30); }
function toggleThemeGlobal(){ const cur = document.documentElement.getAttribute('data-theme') || 'dark'; applyTheme(cur === 'dark' ? 'light' : 'dark'); }
(function initTheme(){ let t = 'dark'; try { t = localStorage.getItem('gzmnet-theme') || 'dark'; } catch(e){} document.documentElement.setAttribute('data-theme', t); setTimeout(() => { const ic = document.getElementById('themeIconGlobal'); if (ic) ic.setAttribute('data-lucide', t === 'dark' ? 'sun' : 'moon'); }, 50); })();
function toggleSection(id){ const el = document.getElementById(id); if (!el) return; el.classList.toggle('open'); }
function toggleSw(id){ const el = document.getElementById(id); if (el) el.classList.toggle('on'); }
function togglePaySection(){ const el = document.getElementById('swPay'); el.classList.toggle('on'); const ps = document.getElementById('paySection'); if (ps) ps.style.display = el.classList.contains('on') ? 'block' : 'none'; }
function toggleIslandMenu(e){ if (e) e.stopPropagation(); const menu = document.getElementById('islandMenu'); const overlay = document.getElementById('islandOverlay'); const island = document.getElementById('island'); const pop = document.getElementById('clockPopover'); const np = document.getElementById('notifPanel'); if (pop) pop.classList.remove('open'); if (np) np.classList.remove('open'); if (clockPopoverTimeout) { clearTimeout(clockPopoverTimeout); clockPopoverTimeout = null; } if (menu.classList.contains('open')) { menu.classList.remove('open'); overlay.classList.remove('open'); island.classList.remove('island-expanded'); } else { menu.classList.add('open'); overlay.classList.add('open'); island.classList.add('island-expanded'); } }
function toggleClockPopover(e){ if (e) e.stopPropagation(); const pop = document.getElementById('clockPopover'); const overlay = document.getElementById('islandOverlay'); const menu = document.getElementById('islandMenu'); const np = document.getElementById('notifPanel'); if (menu) menu.classList.remove('open'); if (np) np.classList.remove('open'); if (clockPopoverTimeout) { clearTimeout(clockPopoverTimeout); clockPopoverTimeout = null; } if (pop.classList.contains('open')) { pop.classList.remove('open'); overlay.classList.remove('open'); } else { pop.classList.add('open'); overlay.classList.add('open'); clockPopoverTimeout = setTimeout(() => { pop.classList.remove('open'); overlay.classList.remove('open'); clockPopoverTimeout = null; }, 5000); } }
function toggleNotifPanel(e){ if (e) e.stopPropagation(); const np = document.getElementById('notifPanel'); const overlay = document.getElementById('islandOverlay'); const menu = document.getElementById('islandMenu'); const pop = document.getElementById('clockPopover'); if (menu) menu.classList.remove('open'); if (pop) pop.classList.remove('open'); if (np.classList.contains('open')) { np.classList.remove('open'); overlay.classList.remove('open'); } else { np.classList.add('open'); overlay.classList.add('open'); loadNotifications(); } }
function closeAllPopovers(){ document.getElementById('islandMenu').classList.remove('open'); document.getElementById('clockPopover').classList.remove('open'); document.getElementById('notifPanel').classList.remove('open'); document.getElementById('islandOverlay').classList.remove('open'); document.getElementById('island').classList.remove('island-expanded'); if (clockPopoverTimeout) { clearTimeout(clockPopoverTimeout); clockPopoverTimeout = null; } }
document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAllPopovers(); });

function updateClock(){
    const tz = serverTimezone || undefined;
    const now = new Date();
    const use12h = serverTimeFormat === '12h';
    let timeStr = '--:--', fullTimeStr = '--:--:--', dateStr = '—';
    try {
        if (tz) {
            if (use12h) { const base = now.toLocaleTimeString('en-US', { timeZone: tz, hour12: true, hour: 'numeric', minute: '2-digit' }); timeStr = base.replace(/\s*[AP]\.?M\.?$/i, '').trim(); fullTimeStr = now.toLocaleTimeString('en-US', { timeZone: tz, hour12: true }); }
            else { timeStr = now.toLocaleTimeString('es-ES', { timeZone: tz, hour12: false, hour: '2-digit', minute: '2-digit' }); fullTimeStr = now.toLocaleTimeString('es-ES', { timeZone: tz, hour12: false }); }
            dateStr = now.toLocaleDateString('es-ES', { timeZone: tz, weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
        } else { timeStr = now.toTimeString().slice(0, 5); fullTimeStr = now.toTimeString().slice(0, 8); dateStr = now.toLocaleDateString('es-ES', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }); }
    } catch(e) {}
    const el = document.getElementById('islandTime'); if (el) el.textContent = timeStr;
    const elt = document.getElementById('clockPopTime'); if (elt) elt.textContent = fullTimeStr;
    const eld = document.getElementById('clockPopDate'); if (eld) eld.textContent = dateStr;
    const eltz = document.getElementById('tzPreviewTime'); if (eltz) eltz.textContent = fullTimeStr;
    const eltzz = document.getElementById('tzPreviewZone'); if (eltzz) eltzz.textContent = (tz || 'Local') + ' · ' + serverTimeFormat;
}
setInterval(updateClock, 1000); updateClock();

function saveNotifSeen(){ try { localStorage.setItem('gzmnet-notif-seen', JSON.stringify([...notifSeenKeys])); } catch(e){} }
function loadNotifSeen(){ try { const s = localStorage.getItem('gzmnet-notif-seen'); if (s) notifSeenKeys = new Set(JSON.parse(s)); } catch(e){} }
