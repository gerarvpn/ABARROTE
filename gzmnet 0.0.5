        const todayKey = getTodayKey();
        const curMin = now.getHours() * 60 + now.getMinutes();
        const cfg = getVpnConfig();

        if (curMin >= 0 && curMin <= 4) {
            if (!cfg.lastSslNotified || cfg.lastSslNotified !== todayKey) {
                const ageH = getCertAgeHours();
                if (ageH > 0 && (ageH + 4) >= 50 * 24 && ageH < 60 * 24) {
                    cfg.lastSslNotified = todayKey;
                    saveVpnConfig(cfg);
                    logApply(`[SSL] Notificando renovación (edad actual: ${(ageH/24).toFixed(1)} días)`);
                    try {
                        await sendPushToAdmin({ title: '🔒 Renovación SSL a las 4:00 AM', body: `El certificado SSL será renovado automáticamente hoy a las 4:00 AM (tiene ${Math.floor(ageH/24)} días).`, url: '/', tag: 'ssl-renew-pending' });
                    } catch(e) { logApply(`[SSL] Error notif: ${e.message}`); }
                }
            }
        }

        if (curMin >= 240 && curMin <= 244 && !sslRenewalInProgress) {
            if (!cfg.lastSslRenewed || cfg.lastSslRenewed !== todayKey) {
                const ageH = getCertAgeHours();
                if (ageH >= 50 * 24 && ageH < 60 * 24) {
                    cfg.lastSslRenewed = todayKey;
                    saveVpnConfig(cfg);
                    sslRenewalInProgress = true;
                    logApply(`[SSL] Iniciando renovación automática (edad: ${(ageH/24).toFixed(1)} días)`);
                    exec('/usr/local/bin/gzmnet-renew-cert.sh', { timeout: 300000 }, async (err) => {
                        sslRenewalInProgress = false;
                        if (err) {
                            logApply(`[SSL] Error: ${err.message}`);
                            try { await sendPushToAdmin({ title: '⚠️ Error renovando SSL', body: `Revisa /root/gzmnet/data/cert-renew.log`, url: '/', tag: 'ssl-renew-fail' }); } catch(e) {}
                            return;
                        }
                        logApply(`[SSL] ✅ Renovación completada exitosamente`);
                        try { await sendPushToAdmin({ title: '✅ Certificado SSL renovado', body: 'El certificado SSL se renovó exitosamente.', url: '/', tag: 'ssl-renew-done' }); } catch(e) {}
                    });
                }
            }
        }
    } catch(e) { logApply('[SSL-MONITOR-EXC] ' + e.message); }
}, 60000);

let pushJobTickCount = 0;
setInterval(async () => {
    try {
        if (!webpush) return;
        pushJobTickCount++;
        const now = getTzDate();
        const todayKey = getTodayKey();
        const curMin = now.getHours() * 60 + now.getMinutes();
        const today = new Date(); today.setHours(0,0,0,0);
        const clients = vpnDb.prepare('SELECT * FROM clients WHERE payment_enabled = 1').all();
        for (const c of clients) {
            const nd = getNextPaymentDate(c);
            if (!nd) continue;
            const target = new Date(nd + 'T00:00:00');
            const diff = Math.round((target.getTime() - today.getTime()) / 86400000);
            if (diff !== 0 && diff !== 1) continue;
            const pParts = String(c.payment_time || '09:00').split(':');
            const pH = parseInt(pParts[0], 10), pM = parseInt(pParts[1], 10);
            const pMin = (isNaN(pH) ? 9 : pH) * 60 + (isNaN(pM) ? 0 : pM);
            const inWindow = curMin >= pMin && curMin <= pMin + 4;
            const catchUp = curMin > pMin + 4;
            if (!inWindow && !catchUp) continue;
            const notifyKey = todayKey + '_' + diff;
            if (c.last_payment_notified === notifyKey) continue;
            const isToday = diff === 0;
            const dateFormatted = formatDateSpanish(nd);
            const clientTitle = isToday ? '💰 Pago HOY - GZMNET' : '💳 Pago mañana - GZMNET';
            const clientBody = isToday ? `Hola ${c.name}, tu pago vence hoy (${dateFormatted}).` : `Hola ${c.name}, recuerda que mañana vence tu pago (${dateFormatted}).`;
            await sendPushToClient(c.id, { title: clientTitle, body: clientBody, url: '/portal/' + c.sub_token, tag: 'pay-' + c.id + '-' + diff });
            const adminTitle = isToday ? `💰 Pago HOY: ${c.name}` : `💳 Pago mañana: ${c.name}`;
            await sendPushToAdmin({ title: adminTitle, body: `El cliente ${c.name} tiene pago ${isToday ? 'hoy' : 'mañana'} (${dateFormatted}).`, url: '/', tag: 'admin-pay-' + c.id + '-' + diff });
            vpnDb.prepare('UPDATE clients SET last_payment_notified = ? WHERE id = ?').run(notifyKey, c.id);
        }
    } catch(e) { logApply('PUSH-JOB-EXC: ' + e.message); }
}, 30000);

let telegramPolling = false;
let telegramOffset = 0;
let botState = {};

function getTelegramSettings() { return vpnDb.prepare('SELECT * FROM telegram_settings WHERE id = 1').get() || {}; }
function saveTelegramSettings(s) {
    const cur = getTelegramSettings();
    const m = { ...cur, ...s };
    const ah = parseInt(m.auto_backup_hour, 10);
    const am = parseInt(m.auto_backup_minute, 10);
    vpnDb.prepare(`UPDATE telegram_settings SET enabled=?, bot_token=?, admin_ids=?, notify_payment=?, notify_online=?, auto_backup=?, auto_backup_hour=?, auto_backup_minute=?, last_backup_at=?, updated_at=datetime('now','localtime') WHERE id=1`).run(
        m.enabled ? 1 : 0, m.bot_token || '', m.admin_ids || '', m.notify_payment ? 1 : 0, m.notify_online ? 1 : 0, m.auto_backup ? 1 : 0,
        isNaN(ah) ? 3 : Math.max(0, Math.min(23, ah)),
        isNaN(am) ? 0 : Math.max(0, Math.min(59, am)),
        m.last_backup_at || ''
    );
}
function getAdminIds() { const s = getTelegramSettings(); return String(s.admin_ids || '').split(/[\s,]+/).map(x => x.trim()).filter(Boolean); }

async function tgApi(method, body) {
    const s = getTelegramSettings();
    if (!s.bot_token) return { ok: false, error: 'Sin token' };
    try { const r = await fetch(`https://api.telegram.org/bot${s.bot_token}/${method}`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {}), signal: AbortSignal.timeout(15000) }); return await r.json(); }
    catch(e) { return { ok: false, error: e.message }; }
}
async function tgSend(chatId, text, opts) { return tgApi('sendMessage', { chat_id: chatId, text, parse_mode: 'HTML', disable_web_page_preview: true, ...(opts || {}) }); }
async function tgSendDocument(chatId, filename, content, caption) {
    const s = getTelegramSettings();
    if (!s.bot_token) return { ok: false };
    try { const form = new FormData(); form.append('chat_id', chatId); if (caption) form.append('caption', caption); form.append('document', new Blob([content], { type: 'application/json' }), filename); const r = await fetch(`https://api.telegram.org/bot${s.bot_token}/sendDocument`, { method: 'POST', body: form, signal: AbortSignal.timeout(30000) }); return await r.json(); }
    catch(e) { return { ok: false, error: e.message }; }
}

function generateBackupJson() {
    return JSON.stringify({ app: 'gzmnet', version: '0.0.5', exportedAt: new Date().toISOString(), vpnConfig: getVpnConfig(), inbounds: vpnDb.prepare('SELECT * FROM inbounds').all(), clients: vpnDb.prepare('SELECT * FROM clients').all(), subscriptionDevices: vpnDb.prepare('SELECT * FROM subscription_devices').all(), routingSettings: vpnDb.prepare('SELECT * FROM routing_settings').all(), routingRules: vpnDb.prepare('SELECT * FROM routing_rules').all(), telegramSettings: vpnDb.prepare('SELECT enabled, admin_ids, notify_payment, notify_online, auto_backup, auto_backup_hour, auto_backup_minute FROM telegram_settings').all() }, null, 2);
}

async function tgHandleUpdate(update) {
    if (!update.message || !update.message.text) return;
    const msg = update.message;
    const chatId = String(msg.chat.id);
    const text = String(msg.text).trim();
    const admins = getAdminIds();
    if (!admins.includes(chatId)) { await tgSend(chatId, `<b>GZMNET</b>\n\nTu chat_id es:\n<code>${chatId}</code>\n\nPide al administrador que te agregue.`); return; }
    const state = botState[chatId];
    if (state) return handleBotState(chatId, text, state);
    const cmd = text.split(/\s+/)[0].toLowerCase();
    try {
        if (cmd === '/start' || cmd === '/menu') {
            await tgApi('sendMessage', { chat_id: chatId, text: `<b>🤖 GZMNET Bot</b>\n\nSelecciona una acción:`, parse_mode: 'HTML', reply_markup: { inline_keyboard: [
                [{ text: '📊 Estado', callback_data: 'status' }, { text: '👥 Clientes', callback_data: 'clients' }],
                [{ text: '➕ Crear usuario', callback_data: 'create_user' }, { text: '🗑️ Eliminar usuario', callback_data: 'delete_user' }],
                [{ text: '📋 Copiar config', callback_data: 'copy_config' }, { text: '💳 Pagos', callback_data: 'payments' }],
                [{ text: '📦 Backup', callback_data: 'backup' }, { text: '❓ Ayuda', callback_data: 'help' }]
            ] } });
            return;
        }
        if (cmd === '/status') { const xrayOk = await checkXrayActive(), warpOk = await isWireproxyRunning(); const totalC = vpnDb.prepare('SELECT COUNT(*) as c FROM clients').get().c; const onlineC = vpnDb.prepare('SELECT COUNT(*) as c FROM clients WHERE online = 1').get().c; const totalIb = vpnDb.prepare('SELECT COUNT(*) as c FROM inbounds').get().c; await tgSend(chatId, `<b>Estado</b>\n\nXray: ${xrayOk ? 'Activo' : 'Caido'}\nWARP: ${warpOk ? 'Activo' : 'Inactivo'}\nServidores: ${totalIb}\nClientes: ${totalC}\nEn linea: ${onlineC}\nUptime: ${Math.floor(process.uptime()/3600)}h`); return; }
        if (cmd === '/online') { const list = vpnDb.prepare('SELECT id, name, email FROM clients WHERE online = 1 AND enabled = 1').all(); if (!list.length) { await tgSend(chatId, 'Sin usuarios conectados.'); return; } await tgSend(chatId, `<b>En linea (${list.length})</b>\n\n${list.map(c => `ID ${c.id}: <b>${c.name}</b>`).join('\n\n')}`); return; }
        if (cmd === '/payments') { const u = getUpcoming(); if (!u.total) { await tgSend(chatId, 'Sin pagos proximos.'); return; } await tgSend(chatId, `<b>Pagos proximos</b>\n\n${u.payments.map(p => `Pago ${p.dueIn}: <b>${p.name}</b> (${p.dateFormatted})`).join('\n')}`); return; }
        if (cmd === '/clients') { const list = vpnDb.prepare('SELECT c.id, c.name, c.enabled, i.protocol FROM clients c JOIN inbounds i ON i.id = c.inbound_id ORDER BY c.id DESC LIMIT 50').all(); await tgSend(chatId, `<b>Ultimos ${list.length}</b>\n\n${list.map(c => `${c.enabled ? '[ON]' : '[OFF]'} <b>${c.name}</b> (${c.id}) ${c.protocol.toUpperCase()}`).join('\n')}`); return; }
        if (cmd === '/backup') { const json = generateBackupJson(); await tgSendDocument(chatId, `gzmnet-backup-${getTodayKey()}.json`, json, 'Backup GZMNET'); return; }
        if (cmd === '/help') { await tgSend(chatId, `<b>Comandos</b>\n\n/start - Menú\n/status - Estado\n/online - Conectados\n/payments - Pagos\n/clients - Clientes\n/backup - Backup\n/crear - Crear\n/eliminar - Eliminar\n/copiar - Copiar`); return; }
        if (cmd === '/crear') { botState[chatId] = { action: 'create_user', step: 'name', data: {} }; await tgSend(chatId, '📝 <b>Paso 1/4:</b> Envía el <b>nombre</b>:'); return; }
        if (cmd === '/eliminar') { botState[chatId] = { action: 'delete_user', step: 'id', data: {} }; await tgSend(chatId, '🗑️ <b>Paso 1/2:</b> Envía el <b>ID</b>:'); return; }
        if (cmd === '/copiar') { botState[chatId] = { action: 'copy_config', step: 'id', data: {} }; await tgSend(chatId, '📋 <b>Paso 1/2:</b> Envía el <b>ID</b>:'); return; }
        await tgSend(chatId, 'Usa /start para el menú.');
    } catch (e) { console.error('[TG]', e.message); }
}

async function handleBotState(chatId, text, state) {
    try {
        if (state.action === 'create_user') {
            if (state.step === 'name') {
                state.data.name = text;
                state.step = 'protocol';
                const protos = vpnDb.prepare('SELECT DISTINCT protocol FROM inbounds').all().map(r => r.protocol);
                const keyboard = protos.map(p => [{ text: p.toUpperCase(), callback_data: `proto_${p}` }]);
                await tgApi('sendMessage', { chat_id: chatId, text: `📝 <b>Paso 2/4:</b> Elige el <b>protocolo</b>:`, parse_mode: 'HTML', reply_markup: { inline_keyboard: keyboard } });
                return;
            }
            if (state.step === 'limit') {
                const limit = parseFloat(text) || 0;
                state.data.limit = limit;
                const { name, protocol, inbound_id } = state.data;
                const ib = vpnDb.prepare('SELECT * FROM inbounds WHERE id = ?').get(inbound_id);
                if (!ib) { await tgSend(chatId, '❌ Servidor no encontrado.'); delete botState[chatId]; return; }
                const isAuth = protocolUsesAuth(ib.protocol);
                const cred = isAuth ? '' : (ib.protocol === 'trojan' || ib.protocol === 'shadowsocks' ? generatePassword() : generateUuid());
                const authUser = isAuth ? generateShortToken(8) : '';
                const authPass = isAuth ? generatePassword() : '';
                const email = `c${Date.now()}`;
                const subToken = protocolHasSub(ib.protocol) ? ensureUniqueSubToken() : null;
                const info = vpnDb.prepare(`INSERT INTO clients (inbound_id, name, uuid, email, flow, limit_gb, enabled, up_bytes, down_bytes, total_bytes, online, sub_token, auth_user, auth_pass, device_limit) VALUES (?,?,?,?,?,?,1,0,0,0,0,?,?,?,0)`)
                    .run(inbound_id, name, cred, email, '', limit, subToken, authUser, authPass);
                scheduleApply(true);
                emitRefresh();
                let resp = `✅ Usuario <b>${name}</b> creado.\n\nID: <code>${info.lastInsertRowid}</code>`;
                if (!isAuth) resp += `\nUUID: <code>${cred}</code>`;
                else resp += `\nUser: <code>${authUser}</code>\nPass: <code>${authPass}</code>`;
                if (subToken) resp += `\nToken: <code>${subToken}</code>`;
                await tgSend(chatId, resp);
                delete botState[chatId];
                return;
            }
        }
        if (state.action === 'delete_user' && state.step === 'id') {
            const id = parseInt(text);
            if (!id) { await tgSend(chatId, '❌ ID inválido.'); return; }
            const c = vpnDb.prepare('SELECT name FROM clients WHERE id = ?').get(id);
            if (!c) { await tgSend(chatId, '❌ No existe.'); return; }
            vpnDb.prepare('DELETE FROM clients WHERE id = ?').run(id);
            await tgSend(chatId, `✅ Usuario <b>${c.name}</b> eliminado.`);
            delete botState[chatId];
            scheduleApply(true);
            emitRefresh();
            return;
        }
        if (state.action === 'copy_config' && state.step === 'id') {
            const id = parseInt(text);
            if (!id) { await tgSend(chatId, '❌ ID inválido.'); return; }
            const c = vpnDb.prepare('SELECT * FROM clients WHERE id = ?').get(id);
            if (!c) { await tgSend(chatId, '❌ No existe.'); return; }
            const full = vpnDb.prepare(`SELECT c.*, i.protocol, i.port, i.network, i.path, i.tls, i.domain as ib_domain, i.host, i.security, i.flow as inbound_flow, i.reality_public_key, i.reality_short_ids, i.fingerprint, i.alpn, i.ss_method, i.grpc_service, i.grpc_multi, i.h2_path, i.h2_host, i.quic_key, i.quic_security, i.quic_header, i.kcp_seed, i.kcp_header, i.xhttp_path, i.xhttp_host, i.xhttp_mode FROM clients c JOIN inbounds i ON i.id = c.inbound_id WHERE c.id = ?`).get(id);
            if (!full) { await tgSend(chatId, '❌ Error.'); return; }
            const link = buildClientLink(full);
            await tgSend(chatId, `📋 <b>Configuración de ${c.name}</b>\n\n<code>${link}</code>`);
            delete botState[chatId];
            return;
        }
    } catch (e) { console.error('[TG-State]', e.message); }
}

async function tgHandleCallback(cb) {
    const chatId = String(cb.message.chat.id);
    const admins = getAdminIds();
    if (!admins.includes(chatId)) { await tgApi('answerCallbackQuery', { callback_query_id: cb.id, text: 'No autorizado', show_alert: true }); return; }
    await tgApi('answerCallbackQuery', { callback_query_id: cb.id });
    const data = cb.data;
    const state = botState[chatId];
    if (data.startsWith('proto_') && state && state.action === 'create_user' && state.step === 'protocol') {
        const proto = data.replace('proto_', '');
        state.data.protocol = proto;
        state.step = 'port';
        const inbounds = vpnDb.prepare('SELECT id, name, port FROM inbounds WHERE protocol = ?').all(proto);
        if (!inbounds.length) { await tgSend(chatId, '❌ No hay servidores con ese protocolo.'); delete botState[chatId]; return; }
        const keyboard = inbounds.map(ib => [{ text: `${ib.name} (:${ib.port})`, callback_data: `port_${ib.id}` }]);
        await tgApi('sendMessage', { chat_id: chatId, text: `📝 <b>Paso 3/4:</b> Elige el <b>servidor/puerto</b>:`, parse_mode: 'HTML', reply_markup: { inline_keyboard: keyboard } });
        return;
    }
    if (data.startsWith('port_') && state && state.action === 'create_user' && state.step === 'port') {
        const inboundId = parseInt(data.replace('port_', ''));
        state.data.inbound_id = inboundId;
        state.step = 'limit';
        await tgSend(chatId, '📝 <b>Paso 4/4:</b> Envía el <b>límite en GB</b> (0 = sin límite):');
        return;
    }
    const map = { status: '/status', online: '/online', payments: '/payments', clients: '/clients', backup: '/backup', help: '/help', create_user: '/crear', delete_user: '/eliminar', copy_config: '/copiar' };
    if (map[data]) await tgHandleUpdate({ message: { chat: cb.message.chat, text: map[data], from: cb.from } });
}

async function startTelegramPolling() {
    if (telegramPolling) return;
    telegramPolling = true;
    while (true) {
        try {
            const s = getTelegramSettings();
            if (!s.enabled || !s.bot_token) { await new Promise(r => setTimeout(r, 5000)); continue; }
            const r = await fetch(`https://api.telegram.org/bot${s.bot_token}/getUpdates?offset=${telegramOffset}&timeout=25`, { signal: AbortSignal.timeout(30000) });
            const data = await r.json();
            if (data.ok && Array.isArray(data.result)) { for (const upd of data.result) { telegramOffset = upd.update_id + 1; try { if (upd.callback_query) await tgHandleCallback(upd.callback_query); else if (upd.message) await tgHandleUpdate(upd); } catch(e) {} } }
            else await new Promise(r => setTimeout(r, 5000));
        } catch(e) { await new Promise(r => setTimeout(r, 5000)); }
    }
}

let lastBackupRunDate = '';
setInterval(async () => {
    try {
        const s = getTelegramSettings();
        if (!s.enabled || !s.auto_backup || !s.bot_token) return;
        const todayKey = getTodayKey();
        if (lastBackupRunDate === todayKey) return;
        const now = getTzDate();
        const curMin = now.getHours() * 60 + now.getMinutes();
        const bParts = `${s.auto_backup_hour}:${s.auto_backup_minute}`.split(':');
        const bH = parseInt(bParts[0], 10), bM = parseInt(bParts[1], 10);
        const confMin = (isNaN(bH) ? 3 : bH) * 60 + (isNaN(bM) ? 0 : bM);
        if (curMin < confMin || curMin > confMin + 4) return;
        lastBackupRunDate = todayKey;
        const admins = getAdminIds();
        if (!admins.length) return;
        const json = generateBackupJson();
        for (const a of admins) await tgSendDocument(a, `gzmnet-backup-${todayKey}.json`, json, 'Backup automatico GZMNET');
        vpnDb.prepare("UPDATE telegram_settings SET last_backup_at = datetime('now','localtime') WHERE id = 1").run();
    } catch(e) {}
}, 30000);

function getSubUaList() {
    const vpn = getVpnConfig();
    const raw = String(vpn.subUserAgent || '');
    return raw.split(/[,\n]+/).map(x => x.trim().toLowerCase()).filter(Boolean);
}
function validateUA(req) {
    const list = getSubUaList();
    if (list.length === 0) return true;
    const ua = String(req.get('user-agent') || '').toLowerCase();
    return list.some(a => ua.includes(a));
}
function deviceDisplayName(ua) {
    const l = String(ua || '').toLowerCase();
    if (l.includes('v2rayng')) return 'v2rayNG';
    if (l.includes('v2raytun')) return 'v2rayTun';
    if (l.includes('shadowrocket')) return 'Shadowrocket';
    if (l.includes('sing-box')) return 'Sing-Box';
    if (l.includes('nekobox')) return 'NekoBox';
    if (l.includes('nekoray')) return 'NekoRay';
    if (l.includes('hiddify')) return 'Hiddify';
    if (l.includes('streisand')) return 'Streisand';
    if (l.includes('clashmeta') || l.includes('clash')) return 'Clash';
    if (l.includes('quantumult')) return 'Quantumult';
    if (l.includes('surfboard')) return 'Surfboard';
    if (l.includes('mozilla') || l.includes('chrome') || l.includes('safari') || l.includes('firefox')) return 'Navegador';
    if (!ua) return 'Desconocido';
    return String(ua).substring(0, 30);
}
function trackDevice(clientId, req, deviceLimit) {
    const ua = String(req.get('user-agent') || '');
    const ip = req.ip || '0.0.0.0';
    const hash = crypto.createHash('sha256').update(ua).digest('hex').substring(0, 16);
    const existing = vpnDb.prepare('SELECT id FROM subscription_devices WHERE client_id = ? AND device_hash = ?').get(clientId, hash);
    if (existing) {
        vpnDb.prepare("UPDATE subscription_devices SET last_seen = datetime('now','localtime'), ip_address = ? WHERE id = ?").run(ip, existing.id);
        return { ok: true };
    }
    if (deviceLimit > 0) {
        const count = vpnDb.prepare('SELECT COUNT(*) as c FROM subscription_devices WHERE client_id = ?').get(clientId).c;
        if (count >= deviceLimit) return { ok: false, error: 'device_limit' };
    }
    vpnDb.prepare('INSERT INTO subscription_devices (client_id, device_hash, user_agent, display_name, ip_address) VALUES (?,?,?,?,?)').run(clientId, hash, ua.substring(0, 200), deviceDisplayName(ua), ip);
    return { ok: true };
}

