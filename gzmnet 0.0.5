<div class="hero">
    <div class="logo-plate"><img src="${LOGO_URL}" alt="GZMNET"></div>
    <div class="name">${c.name}</div>
    <div class="meta">
        <span class="badge proto"><i data-lucide="zap"></i>${(c.protocol||'').toUpperCase()}</span>
        <span class="badge server"><i data-lucide="server"></i>${c.inbound_name}</span>
