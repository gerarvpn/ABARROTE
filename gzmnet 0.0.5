app.post('/api/clients', checkAuth, async (req, res) => {
    try {
        const { inbound_id, name, email, limit_gb, flow, credential, auth_user, auth_pass, sub_token, payment_enabled, payment_date, payment_frequency, payment_time, telegram_chat_id, device_limit } = req.body;
        if (!inbound_id || !name) return res.status(400).json({ ok: false, error: 'Faltan campos' });
        const ib = vpnDb.prepare('SELECT * FROM inbounds WHERE id = ?').get(inbound_id);
        if (!ib) return res.status(404).json({ ok: false, error: 'Servidor no existe' });
        const isAuth = protocolUsesAuth(ib.protocol);
        const hasSub = protocolHasSub(ib.protocol);
        let finalEmail = `c${Date.now()}`;
        let cred = (credential && String(credential).trim()) ? String(credential).trim() : '';
        if (!isAuth) {
            if (!cred) cred = (ib.protocol === 'trojan' || ib.protocol === 'shadowsocks') ? generatePassword() : generateUuid();
            else if ((ib.protocol === 'vless' || ib.protocol === 'vmess') && !/^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$/.test(cred)) return res.status(400).json({ ok: false, error: 'UUID inválido' });
        }
        let finalAuthUser = isAuth ? (auth_user && String(auth_user).trim()) : '';
        let finalAuthPass = isAuth ? (auth_pass && String(auth_pass).trim()) : '';
        if (isAuth) {
            if (!finalAuthUser) finalAuthUser = 'user_' + generateShortToken(6);
            if (!finalAuthPass) finalAuthPass = generatePassword();
            const dup = vpnDb.prepare('SELECT id FROM clients WHERE inbound_id = ? AND auth_user = ?').get(inbound_id, finalAuthUser);
            if (dup) finalAuthUser = finalAuthUser + '_' + generateShortToken(3);
        }
        let subToken = null;
        if (hasSub) {
            if (sub_token && String(sub_token).trim()) { const t = String(sub_token).trim(); if (/^[a-zA-Z0-9_-]+$/.test(t) && !vpnDb.prepare('SELECT id FROM clients WHERE sub_token = ?').get(t)) subToken = t; }
            if (!subToken) subToken = ensureUniqueSubToken();
        }
        const dl = parseInt(device_limit) || 0;
        const info = vpnDb.prepare(`INSERT INTO clients (inbound_id, name, uuid, email, flow, limit_gb, enabled, up_bytes, down_bytes, total_bytes, online, sub_token, auth_user, auth_pass, payment_enabled, payment_date, payment_frequency, payment_time, telegram_chat_id, last_payment_notified, device_limit) VALUES (?,?,?,?,?,?,1,0,0,0,0,?,?,?,?,?,?,?,?,'',?)`)
            .run(inbound_id, name, cred || '', finalEmail, flow || '', parseFloat(limit_gb) || 0, subToken, finalAuthUser || '', finalAuthPass || '', payment_enabled ? 1 : 0, (payment_date||'').trim(), parseInt(payment_frequency) || 0, (payment_time||'09:00').trim(), (telegram_chat_id||'').trim(), dl);
        emitRefresh(); emitVpnStats(); statsCache = { data: null, time: 0 }; totalsCache = { data: null, time: 0 };
        res.json({ ok: true, id: info.lastInsertRowid, client: vpnDb.prepare('SELECT * FROM clients WHERE id = ?').get(info.lastInsertRowid), credential: cred, subToken, authUser: finalAuthUser, authPass: finalAuthPass });
        scheduleApply(false);
    } catch(e) { res.status(500).json({ ok: false, error: e.message }); }
});

app.put('/api/clients/:id', checkAuth, async (req, res) => {
    try {
        const { id } = req.params;
        const old = vpnDb.prepare('SELECT * FROM clients WHERE id = ?').get(id);
        if (!old) return res.status(404).json({ ok: false, error: 'No encontrado' });
        const oldIb = vpnDb.prepare('SELECT * FROM inbounds WHERE id = ?').get(old.inbound_id);
        const { name, email, limit_gb, flow, regenerate_credential, credential, auth_user, auth_pass, sub_token, inbound_id, payment_enabled, payment_date, payment_frequency, payment_time, telegram_chat_id, device_limit } = req.body;
        let newInboundId = old.inbound_id, newCredential = old.uuid, credentialMigrated = false;
        let newAuthUser = old.auth_user, newAuthPass = old.auth_pass;
        let newPrevUuid = old.prev_uuid, newPrevAuthUser = old.prev_auth_user, newPrevAuthPass = old.prev_auth_pass;

        if (inbound_id !== undefined && parseInt(inbound_id) !== old.inbound_id) {
            const targetIb = vpnDb.prepare('SELECT * FROM inbounds WHERE id = ?').get(parseInt(inbound_id));
            if (!targetIb) return res.status(404).json({ ok: false, error: 'Servidor destino no existe' });
            newInboundId = parseInt(inbound_id);
            const oldType = credentialTypeBackend(oldIb.protocol);
            const newType = credentialTypeBackend(targetIb.protocol);
            if (oldType !== newType) {
                if (oldType === 'auth') { newPrevAuthUser = old.auth_user; newPrevAuthPass = old.auth_pass; }
                else { newPrevUuid = old.uuid; }
                if (newType === 'uuid') { newCredential = generateUuid(); newAuthUser = ''; newAuthPass = ''; }
                else if (newType === 'password') { newCredential = generatePassword(); newAuthUser = ''; newAuthPass = ''; }
                else if (newType === 'auth') { newCredential = ''; newAuthUser = 'user_' + generateShortToken(6); newAuthPass = generatePassword(); }
                credentialMigrated = true;
            }
        }
        const targetProto = vpnDb.prepare('SELECT protocol FROM inbounds WHERE id = ?').get(newInboundId).protocol;
        const isAuth = protocolUsesAuth(targetProto);
        const targetType = credentialTypeBackend(targetProto);
        if (regenerate_credential && !isAuth) {
            if (targetType === 'uuid') newCredential = generateUuid();
            else if (targetType === 'password') newCredential = generatePassword();
        }
        else if (credential !== undefined && String(credential).trim() && !isAuth) { const c = String(credential).trim(); if ((targetProto === 'vless' || targetProto === 'vmess') && !/^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$/.test(c)) return res.status(400).json({ ok: false, error: 'UUID inválido' }); newCredential = c; }
        const finalAuthUser = isAuth ? ((auth_user !== undefined && String(auth_user).trim()) ? String(auth_user).trim() : (newAuthUser || ('user_' + generateShortToken(6)))) : '';
        const finalAuthPass = isAuth ? ((auth_pass !== undefined && String(auth_pass).trim()) ? String(auth_pass).trim() : (newAuthPass || generatePassword())) : '';
        let newToken = old.sub_token;
        if (protocolHasSub(targetProto)) {
            if (sub_token !== undefined && sub_token !== '') { const t = String(sub_token).trim(); if (t.length >= 1 && t.length <= 32 && /^[a-zA-Z0-9_-]+$/.test(t)) { if (t !== old.sub_token) { if (vpnDb.prepare('SELECT id FROM clients WHERE sub_token = ? AND id != ?').get(t, id)) return res.status(400).json({ ok: false, error: 'Token ya en uso' }); newToken = t; } } else return res.status(400).json({ ok: false, error: 'Token inválido' }); }
            if (!newToken) newToken = ensureUniqueSubToken();
        } else newToken = null;
        if (newCredential !== old.uuid) delete lastTrafficSnapshot[`c${old.id}`];
        const newPayEnabled = payment_enabled !== undefined ? (payment_enabled ? 1 : 0) : old.payment_enabled;
        const newPayDate = payment_date !== undefined ? String(payment_date).trim() : old.payment_date;
        const newPayFreq = payment_frequency !== undefined ? (parseInt(payment_frequency) || 0) : old.payment_frequency;
        const newPayTime = payment_time !== undefined ? String(payment_time).trim() : old.payment_time;
        const paymentChanged = (newPayEnabled !== old.payment_enabled) || (newPayDate !== old.payment_date) || (newPayFreq !== old.payment_frequency) || (newPayTime !== old.payment_time);
        const newLastNotif = paymentChanged ? '' : old.last_payment_notified;
        const newDeviceLimit = device_limit !== undefined ? (parseInt(device_limit) || 0) : (old.device_limit || 0);
