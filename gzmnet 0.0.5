function updateNotifBadge(){
    const unread = notifList.filter(n => !notifSeenKeys.has(n.key)).length;
    const badge = document.getElementById('notifBadge');
    const btn = document.getElementById('notifBtn');
    if (!badge || !btn) return;
    badge.textContent = unread > 0 ? (unread > 9 ? '9+' : String(unread)) : '';
    btn.classList.toggle('has-unread', unread > 0);
}
async function loadNotifications(){
    try {
        const r = await fetch('/api/payments/upcoming');
        const d = await r.json();
        if (!d.ok) return;
        notifList = [];
        for (const p of (d.payments||[])) {
            const isToday = p.dueIn === 'hoy';
            const key = 'pay-' + p.id + '-' + p.date;
            notifList.push({ key, title: isToday ? `Pago HOY: ${p.name}` : `Pago mañana: ${p.name}`, desc: `El cliente ${p.name} tiene pago ${isToday ? 'hoy' : 'mañana'} (${formatDateSpanish(p.date)}). Avisa al cliente.`, type: isToday ? 'warn' : 'pay', icon: 'credit-card' });
        }
        renderNotifList();
        updateNotifBadge();
    } catch(e){}
}
function renderNotifList(){
    const list = document.getElementById('notifList');
    if (!list) return;
    if (!notifList.length) { list.innerHTML = '<div class="notif-empty"><i data-lucide="bell-off"></i><div class="notif-empty-text">Sin notificaciones</div></div>'; renderIcons(); return; }
    list.innerHTML = notifList.map(n => { const unread = !notifSeenKeys.has(n.key); return `<div class="notif-item ${unread ? 'unread' : ''}" onclick="markNotifRead('${n.key}')"><div class="notif-item-icon ${n.type === 'pay' ? 'pay' : n.type === 'warn' ? 'warn' : ''}"><i data-lucide="${n.icon}"></i></div><div class="notif-item-body"><div class="notif-item-title">${esc(n.title)}</div><div class="notif-item-desc">${esc(n.desc)}</div></div></div>`; }).join('');
    renderIcons();
}
function markNotifRead(key){ notifSeenKeys.add(key); saveNotifSeen(); renderNotifList(); updateNotifBadge(); }
function clearNotifBadge(){ notifList.forEach(n => notifSeenKeys.add(n.key)); saveNotifSeen(); renderNotifList(); updateNotifBadge(); }

function b64ToUint8(b64) { const pad = '='.repeat((4 - b64.length % 4) % 4); const raw = atob((b64 + pad).replace(/-/g, '+').replace(/_/g, '/')); return new Uint8Array([...raw].map(c => c.charCodeAt(0))); }
async function adminSubscribePush() {
    if (!vapidPubKey) return false;
    try {
        const reg = await navigator.serviceWorker.ready;
        let sub = await reg.pushManager.getSubscription();
        if (sub) await sub.unsubscribe();
        sub = await reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: b64ToUint8(vapidPubKey) });
        const subData = sub.toJSON ? sub.toJSON() : sub;
        const r = await fetch('/api/admin/subscribe', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(subData) });
        const d = await r.json();
        return d.ok;
    } catch(e) { return false; }
}
async function adminRequestNotif() {
    try {
        const perm = await Notification.requestPermission();
        if (perm !== 'granted') { toast('Permiso denegado', 'warning'); return; }
        const ok = await adminSubscribePush();
        if (ok) toast('Notificaciones activadas', 'success');
        updateAdminNotifStatus();
    } catch(e) { toast('Error: ' + e.message, 'error'); }
}
async function updateAdminNotifStatus(){
    const el = document.getElementById('adminNotifStatus');
    const btn = document.getElementById('adminNotifBtn');
    if (!el || !btn) return;
    if (!('serviceWorker' in navigator) || !('PushManager' in window) || !vapidPubKey) { el.textContent = 'Push no disponible en este navegador.'; btn.style.display = 'none'; return; }
    if (Notification.permission === 'denied') { el.textContent = 'Notificaciones bloqueadas. Habilítalas desde el navegador.'; btn.style.display = 'none'; return; }
    if (Notification.permission === 'granted') { try { const reg = await navigator.serviceWorker.ready; const sub = await reg.pushManager.getSubscription(); if (sub) { el.textContent = 'Notificaciones activadas en este dispositivo.'; btn.style.display = 'none'; return; } } catch(e){} el.textContent = 'Permiso concedido pero sin suscripción.'; btn.style.display = 'flex'; return; }
    el.textContent = 'Activa las notificaciones para recibir alertas de pago.'; btn.style.display = 'flex';
}
