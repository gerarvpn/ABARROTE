    const streamSettings = {};
    const pathValue = c.path || '/';
    if (network === 'ws') { streamSettings.network = 'ws'; streamSettings.wsSettings = { path: pathValue, headers: { Host: hostHeader } }; }
    else if (network === 'httpupgrade') { streamSettings.network = 'httpupgrade'; streamSettings.httpupgradeSettings = { path: pathValue, host: hostHeader }; }
    else if (network === 'grpc') { streamSettings.network = 'grpc'; streamSettings.grpcSettings = { serviceName: c.grpc_service || 'grpc', multiMode: c.grpc_multi == 1 }; }
    else if (network === 'h2' || network === 'http') { streamSettings.network = 'h2'; streamSettings.httpSettings = { path: c.h2_path || pathValue, host: [c.h2_host || hostHeader] }; }
    else if (network === 'quic') { streamSettings.network = 'quic'; streamSettings.quicSettings = { security: c.quic_security || 'none', key: c.quic_key || '', header: { type: c.quic_header || 'none' } }; }
    else if (network === 'kcp') { streamSettings.network = 'kcp'; streamSettings.kcpSettings = { mtu: 1350, tti: 50, uplinkCapacity: 5, downlinkCapacity: 20, congestion: false, header: { type: c.kcp_header || 'none' }, seed: c.kcp_seed || '' }; }
    else if (network === 'xhttp') { streamSettings.network = 'xhttp'; streamSettings.xhttpSettings = { path: c.xhttp_path || pathValue, host: c.xhttp_host || hostHeader, mode: c.xhttp_mode || 'auto' }; }
    else { streamSettings.network = 'raw'; streamSettings.rawSettings = {}; }
    streamSettings.security = security;
    if (security === 'reality') streamSettings.realitySettings = { serverName: sni, fingerprint: c.fingerprint || 'chrome', publicKey: c.reality_public_key || '', shortId: (c.reality_short_ids || '').split(',')[0].trim(), spiderX: '/' };
    else if (security === 'tls') { streamSettings.tlsSettings = { serverName: sni, fingerprint: c.fingerprint || 'chrome', allowInsecure: false }; let alpnList = ['h2', 'http/1.1']; if (c.alpn) alpnList = c.alpn.split(',').map(x => x.trim()).filter(Boolean); alpnList = alpnList.filter(x => x !== 'h3'); if (alpnList.length === 0) alpnList = ['h2', 'http/1.1']; streamSettings.tlsSettings.alpn = alpnList; }
    const encKey = getVlessEncryptionKey();
    const encryptionValue = (encKey && encKey !== 'none') ? encKey : 'none';
    let flow = c.flow || c.inbound_flow || "";
    if (flow === 'xtls-rprx-vision') { if (network !== 'tcp' && network !== 'raw') flow = ""; if (streamSettings.security === 'none') flow = ""; }
    let outbound;
    // FIX: mux disabled to improve upload speed
    if (c.protocol === 'vmess') outbound = { protocol: 'vmess', tag: 'proxy', settings: { vnext: [{ address, port: c.port, users: [{ id: c.uuid, alterId: 0, security: 'auto', level: 8 }] }] }, streamSettings };
    else if (c.protocol === 'trojan') outbound = { protocol: 'trojan', tag: 'proxy', settings: { servers: [{ address, port: c.port, password: c.uuid, level: 8 }] }, streamSettings };
    else if (c.protocol === 'shadowsocks') outbound = { protocol: 'shadowsocks', tag: 'proxy', settings: { servers: [{ address, port: c.port, method: c.ss_method || 'aes-256-gcm', password: c.uuid }] }, streamSettings };
    else outbound = { protocol: 'vless', tag: 'proxy', settings: { vnext: [{ address, port: c.port, users: [{ id: c.uuid, encryption: encryptionValue, flow: flow, level: 8 }] }] }, streamSettings };
    const vpn = getVpnConfig();
    const bypassRaw = String(vpn.jsonBypassDomains || '').split(/[\n,;]+/).map(x => x.trim()).filter(Boolean);
    const bypassDomains = [], bypassGeosites = [];
    for (const item of bypassRaw) { if (item.startsWith('geosite:')) bypassGeosites.push(item); else if (item.includes('.') && !item.startsWith('domain:') && !item.startsWith('full:') && !item.startsWith('regexp:')) bypassDomains.push('domain:' + item); else if (item.startsWith('domain:') || item.startsWith('full:') || item.startsWith('regexp:')) bypassDomains.push(item); else bypassGeosites.push('geosite:' + item); }
    const routingRules = [{ type: 'field', ip: ['geoip:private'], outboundTag: 'direct' }];
    if (bypassDomains.length) routingRules.push({ type: 'field', domain: bypassDomains, outboundTag: 'direct' });
    if (bypassGeosites.length) routingRules.push({ type: 'field', domain: bypassGeosites, outboundTag: 'direct' });
