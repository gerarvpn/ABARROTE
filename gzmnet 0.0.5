    return { remarks: c.name || 'GZMNET', log: { loglevel: 'warning' }, dns: { queryStrategy: 'UseIP', servers: [{ address: '8.8.8.8', skipFallback: false }, { address: '1.1.1.1', skipFallback: false }], tag: 'dns_out' }, inbounds: [{ tag: 'mixed', listen: '127.0.0.1', port: 10808, protocol: 'socks', settings: { auth: 'noauth', udp: true, userLevel: 8 }, sniffing: { enabled: true, destOverride: ['http', 'tls', 'quic', 'fakedns'] } }, { tag: 'http', listen: '127.0.0.1', port: 10809, protocol: 'http', settings: { userLevel: 8 } }], outbounds: [outbound, { protocol: 'freedom', tag: 'direct', settings: { domainStrategy: 'AsIs' } }, { protocol: 'blackhole', tag: 'block', settings: { response: { type: 'http' } } }], policy: { levels: { '8': { connIdle: 300, downlinkOnly: 1, handshake: 4, uplinkOnly: 1 } }, system: { statsOutboundDownlink: true, statsOutboundUplink: true } }, routing: { domainStrategy: 'AsIs', rules: routingRules }, stats: {} };
}

