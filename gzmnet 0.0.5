function getProtocolsInfo() { return protocolsInfo || { vless:{transports:['raw','xhttp','grpc','ws','httpupgrade','kcp'],securities:['none','tls','reality']}, vmess:{transports:['raw','xhttp','grpc','ws','httpupgrade','kcp'],securities:['none','tls','reality']}, trojan:{transports:['raw','xhttp','grpc','ws','httpupgrade','kcp'],securities:['none','tls','reality']}, shadowsocks:{transports:['raw','xhttp','grpc','ws','httpupgrade','kcp'],securities:['none','tls']}, socks:{transports:['raw'],securities:['none','tls']}, http:{transports:['raw'],securities:['none','tls']} }; }
