}, 3000);

// FIX: reduced polling interval from 5000ms to 3000ms for faster online detection
setInterval(async () => {
    if (!fs.existsSync(XRAY_BIN)) return;
    if (isQuerying) return;
    isQuerying = true;
    try { const traffic = await queryTrafficStats(); if (!traffic || Object.keys(traffic).length === 0) return; await processStatsSnapshot(traffic); emitVpnStats(); }
    catch(e) {} finally { isQuerying = false; }
}, 3000);

setTimeout(async () => {
    let waited = 0;
    while (waited < 30000) { if (await checkXrayActive()) break; await new Promise(r => setTimeout(r, 1000)); waited += 1000; }
    await refreshWireproxyStatus();
    try { invalidateConfigCache(); forceNextApply = true; lastWrittenConfigHash = ''; await applyXrayNow(); } catch(e) {}
}, 5000);

startTelegramPolling();

setTimeout(() => {
