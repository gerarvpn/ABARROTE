function buildClientLink(c) {
    if (protocolUsesAuth(c.protocol)) {
        const host = c.host || c.ib_domain || 'HOST';
        if (c.protocol === 'socks') return `socks://${Buffer.from(`${c.auth_user}:${c.auth_pass}`).toString('base64').replace(/=+$/,'')}@${host}:${c.port}#${encodeURIComponent(c.name)}`;
        if (c.protocol === 'http') return `http://${c.auth_user}:${c.auth_pass}@${host}:${c.port}#${encodeURIComponent(c.name)}`;
        return '';
    }
    const address = c.ib_domain || c.host || c.domain || 'TU_DOMINIO.com';
    const hostHeader = c.host || c.ib_domain || c.domain || 'TU_DOMINIO.com';
    const sni = c.ib_domain || c.host || c.domain || 'TU_DOMINIO.com';
    const port = c.port;
    const pathValue = c.path || '/';
    const network = c.network || 'ws';
    const security = c.security || (c.tls ? 'tls' : 'none');
    let flow = c.flow || c.inbound_flow || "";
    if (flow === 'xtls-rprx-vision') { if (network !== 'tcp' && network !== 'raw') flow = ""; if (security === 'none') flow = ""; }
    const params = new URLSearchParams();
    if (network === 'ws') { params.set('type', 'ws'); params.set('path', pathValue); if (hostHeader) params.set('host', hostHeader); }
    else if (network === 'httpupgrade') { params.set('type', 'httpupgrade'); params.set('path', pathValue); if (hostHeader) params.set('host', hostHeader); }
    else if (network === 'grpc') { params.set('type', 'grpc'); if (c.grpc_service) params.set('serviceName', c.grpc_service); if (c.grpc_multi == 1) params.set('mode', 'multi'); }
    else if (network === 'h2' || network === 'http') { params.set('type', 'http'); if (c.h2_path || pathValue) params.set('path', c.h2_path || pathValue); if (c.h2_host || hostHeader) params.set('host', c.h2_host || hostHeader); }
    else if (network === 'quic') { params.set('type', 'quic'); if (c.quic_security) params.set('quicSecurity', c.quic_security); if (c.quic_key) params.set('key', c.quic_key); if (c.quic_header) params.set('headerType', c.quic_header); }
    else if (network === 'kcp') { params.set('type', 'kcp'); if (c.kcp_header) params.set('headerType', c.kcp_header); if (c.kcp_seed) params.set('seed', c.kcp_seed); }
    else if (network === 'xhttp') { params.set('type', 'xhttp'); params.set('path', c.xhttp_path || pathValue); if (c.xhttp_host || hostHeader) params.set('host', c.xhttp_host || hostHeader); if (c.xhttp_mode) params.set('mode', c.xhttp_mode); }
    else { params.set('type', 'tcp'); params.set('headerType', 'none'); }

    if (security === 'reality') { params.set('security', 'reality'); params.set('sni', sni); params.set('fp', c.fingerprint || 'chrome'); if (c.reality_public_key) params.set('pbk', c.reality_public_key); const sid = (c.reality_short_ids || '').split(',').map(x => x.trim()).filter(Boolean)[0] || ''; if (sid) params.set('sid', sid); params.set('spx', '/'); }
    else if (security === 'tls' || c.tls) { params.set('security', 'tls'); params.set('sni', sni); params.set('fp', c.fingerprint || 'chrome'); if (c.alpn) params.set('alpn', c.alpn); }
    else params.set('security', 'none');

    if (c.protocol === 'vless') {
        const encKey = getVlessEncryptionKey();
        if (encKey && encKey !== 'none') params.set('encryption', encKey);
        if (flow) params.set('flow', flow);
        return `vless://${c.uuid}@${address}:${port}?${params.toString()}#${encodeURIComponent(c.name)}`;
    }
    if (c.protocol === 'vmess') {
        const vmessNet = network === 'raw' ? 'tcp' : network;
        const vmess = { v: "2", ps: c.name, add: address, port: port, id: c.uuid, aid: "0", scy: "auto", net: vmessNet, type: "none", host: hostHeader, path: pathValue, tls: security === 'none' ? "" : security, sni: security !== 'none' ? sni : "", fp: security !== 'none' ? (c.fingerprint || 'chrome') : "" };
        if (security === 'reality') { vmess.pbk = c.reality_public_key || ""; vmess.sid = (c.reality_short_ids || "").split(',')[0].trim(); vmess.spx = "/"; }
        if (network === 'grpc') { vmess.path = c.grpc_service || 'grpc'; vmess.type = c.grpc_multi == 1 ? 'multi' : 'gun'; }
        else if (network === 'h2' || network === 'http') { vmess.path = c.h2_path || pathValue; vmess.host = c.h2_host || hostHeader; }
        return `vmess://${Buffer.from(JSON.stringify(vmess)).toString('base64')}`;
    }
    if (c.protocol === 'trojan') return `trojan://${encodeURIComponent(c.uuid)}@${address}:${port}?${params.toString()}#${encodeURIComponent(c.name)}`;
    if (c.protocol === 'shadowsocks') {
        const method = c.ss_method || 'aes-256-gcm';
        const userinfo = Buffer.from(`${method}:${c.uuid}`).toString('base64').replace(/=+$/,'').replace(/\+/g,'-').replace(/\//g,'_');
        const params2 = new URLSearchParams(params);
        return `ss://${userinfo}@${address}:${port}?${params2.toString()}#${encodeURIComponent(c.name)}`;
    }
    return '';
}

function buildClientJsonConfig(c) {
    if (protocolUsesAuth(c.protocol)) return null;
    const address = c.ib_domain || c.host || c.domain || 'TU_DOMINIO.com';
    const hostHeader = c.host || c.ib_domain || c.domain || 'TU_DOMINIO.com';
