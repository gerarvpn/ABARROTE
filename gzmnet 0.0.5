function getNextPaymentDate(c) {
    if (!c.payment_enabled || !c.payment_date) return null;
    const freq = parseInt(c.payment_frequency) || 0;
    if (freq <= 0) return c.payment_date;
    const parts = String(c.payment_date).split('-').map(Number);
    if (parts.length !== 3 || isNaN(parts[0])) return null;
    const start = new Date(parts[0], parts[1]-1, parts[2]);
    if (isNaN(start.getTime())) return null;
    const today = getTzDate(); today.setHours(0,0,0,0);
    if (start >= today) return c.payment_date;
    const diffDays = Math.floor((today.getTime() - start.getTime()) / 86400000);
    const periods = Math.ceil(diffDays / freq);
    const next = new Date(start.getTime() + periods * freq * 86400000);
    const y = next.getFullYear(), mo = String(next.getMonth()+1).padStart(2,'0'), da = String(next.getDate()).padStart(2,'0');
    return `${y}-${mo}-${da}`;
}

function getUpcoming() {
    const today = getTzDate(); today.setHours(0,0,0,0);
    const clients = vpnDb.prepare('SELECT id, name, payment_enabled, payment_date, payment_frequency FROM clients WHERE payment_enabled = 1').all();
    const payments = [];
    for (const c of clients) {
        const nd = getNextPaymentDate(c);
        if (!nd) continue;
        const target = new Date(nd + 'T00:00:00');
        const diff = Math.round((target.getTime() - today.getTime()) / 86400000);
        if (diff === 0 || diff === 1) payments.push({ id: c.id, name: c.name, date: nd, dateFormatted: formatDateSpanish(nd), dueIn: diff === 0 ? 'hoy' : 'mañana', diff });
    }
    return { payments, expiries: [], total: payments.length };
}

async function sendPushToClient(clientId, payload) {
    if (!webpush) return { ok: false, error: 'webpush no disponible', sent: 0, total: 0 };
    if (!vapidKeys.publicKey) return { ok: false, error: 'VAPID no configurado', sent: 0, total: 0 };
    const subs = vpnDb.prepare('SELECT * FROM push_subscriptions WHERE client_id = ?').all(clientId);
    let sent = 0, failed = 0;
    if (subs.length === 0) { logApply(`[PUSH-CLIENT-NOSUB] client=${clientId}`); return { ok: false, error: 'Sin suscripciones', sent: 0, failed: 0, total: 0 }; }
    for (const sub of subs) {
        try { await webpush.sendNotification({ endpoint: sub.endpoint, keys: { p256dh: sub.p256dh, auth: sub.auth } }, JSON.stringify(payload), { TTL: 86400, urgency: 'high' }); sent++; logApply(`[PUSH-CLIENT-OK] client=${clientId}`); }
        catch(e) { failed++; const code = e.statusCode || 0; logApply(`[PUSH-CLIENT-FAIL] client=${clientId} code=${code}`); if (code === 404 || code === 410) vpnDb.prepare('DELETE FROM push_subscriptions WHERE id = ?').run(sub.id); }
    }
    return { ok: sent > 0, sent, failed, total: subs.length };
}
