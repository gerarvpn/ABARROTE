#!/bin/bash
# ============================================================
# GZMNET VPN PANEL - v0.0.5 (FINAL)
# - Fix: cliente conectado aparecía tarde (polling 3s + invalidación total de cachés)
# - Fix: servidor en puerto 80 caía cada 4s (Nginx fallback ya NO usa puerto 80)
# - Fix: subida baja (removido mark:255, mejoras de sockopt, mux deshabilitado)
# - Feat: nueva opción "YouTube sin anuncios" (solo bloquea ads de YouTube)
# - Feat: compatible con WARP (regla block va antes de warp)
# - ZeroSSL únicamente (ECC + RSA) con verificación estricta
# ============================================================

clear
echo "============================================================="
echo "         GZMNET VPN PANEL - Instalacion v0.0.5"
echo "============================================================="

if [ "$EUID" -ne 0 ]; then echo "Error: ejecuta como root (sudo)."; exit 1; fi

# ============ LIBERACIÓN SILENCIOSA DEL PUERTO 80 ============
{
    if [ -f "/root/gzmnet/data/vpn.sqlite" ]; then
        XRAY_ON_80=$(sqlite3 "/root/gzmnet/data/vpn.sqlite" "SELECT COUNT(*) FROM inbounds WHERE port = 80" 2>/dev/null || echo 0)
        if [ "$XRAY_ON_80" -gt 0 ]; then
            pm2 stop xray 2>/dev/null || true
            pkill -9 -f "xray run" 2>/dev/null || true
            sleep 2
        fi
    fi
    systemctl stop nginx 2>/dev/null || true
    systemctl stop apache2 2>/dev/null || true
    pkill -9 nginx 2>/dev/null || true
    pkill -9 apache2 2>/dev/null || true
} > /dev/null 2>&1
sleep 2
for i in {1..10}; do
    if ! ss -tln | grep -q ':80 '; then break; fi
    fuser -k -9 80/tcp 2>/dev/null || true
    sleep 2
done

# ============ PREPARACIÓN ============
mkdir -p /etc/nginx/sites-enabled /etc/nginx/sites-available /etc/nginx/conf.d /etc/nginx/ssl /var/www/html
rm -f /etc/nginx/conf.d/gzmnet*.conf 2>/dev/null || true
rm -f /etc/nginx/sites-enabled/gzmnet /etc/nginx/sites-enabled/default 2>/dev/null || true
[ -f /etc/nginx/nginx.conf ] && [ ! -f /etc/nginx/nginx.conf.gzmnet.bak ] && cp /etc/nginx/nginx.conf /etc/nginx/nginx.conf.gzmnet.bak 2>/dev/null || true

cat > /etc/nginx/nginx.conf <<'NGINX_MAIN'
user www-data;
worker_processes auto;
worker_rlimit_nofile 1000000;
pid /run/nginx.pid;
include /etc/nginx/modules-enabled/*.conf;
events { worker_connections 16384; multi_accept on; use epoll; }
http {
    sendfile on; tcp_nopush on; tcp_nodelay on; keepalive_timeout 65;
    types_hash_max_size 4096; server_tokens off;
    include /etc/nginx/mime.types; default_type application/octet-stream;
    ssl_protocols TLSv1.2 TLSv1.3; ssl_prefer_server_ciphers on;
    access_log off; error_log /var/log/nginx/error.log;
    gzip on; gzip_vary on; gzip_min_length 1024; gzip_comp_level 3;
    client_body_buffer_size 256k; client_max_body_size 100M;
    include /etc/nginx/conf.d/*.conf; include /etc/nginx/sites-enabled/*;
}
NGINX_MAIN

if [ -L /etc/resolv.conf ] && readlink /etc/resolv.conf 2>/dev/null | grep -q systemd; then
    mkdir -p /etc/systemd/resolved.conf.d
    cat > /etc/systemd/resolved.conf.d/gzmnet.conf <<'RESOLVEOF'
[Resolve]
DNS=8.8.8.8 1.1.1.1 8.8.4.4
FallbackDNS=
RESOLVEOF
    systemctl restart systemd-resolved 2>/dev/null || true
else
    printf 'nameserver 8.8.8.8\nnameserver 1.1.1.1\nnameserver 8.8.4.4\n' > /etc/resolv.conf
fi

for i in {1..10}; do
    if ping -c 1 8.8.8.8 > /dev/null 2>&1; then echo "Conectividad: OK"; break; fi
    if [ $i -eq 10 ]; then echo "Error: sin Internet."; exit 1; fi
    echo "Esperando... ($i)"; sleep 5
done

# ============ INSTALACIÓN INTELIGENTE ============
echo ""
echo "╔══════════════════════════════════════════════════════════╗"
echo "║          CONFIGURACIÓN DEL PANEL GZMNET                  ║"
echo "╚══════════════════════════════════════════════════════════╝"

EXISTING_USER=""
EXISTING_PASS=""
EXISTING_DOMAIN=""
EXISTING_PORT=""

if [ -f "/root/gzmnet/config.json" ] && [ -f "/root/gzmnet/vpn_config.json" ]; then
    EXISTING_USER=$(jq -r '.adminUser // ""' /root/gzmnet/config.json 2>/dev/null)
    EXISTING_PASS=$(jq -r '.adminPassword // ""' /root/gzmnet/config.json 2>/dev/null)
    EXISTING_DOMAIN=$(jq -r '.domain // ""' /root/gzmnet/vpn_config.json 2>/dev/null)
    EXISTING_PORT=$(jq -r '.panelPort // 443' /root/gzmnet/vpn_config.json 2>/dev/null)
fi

ADMIN_USER=""
ADMIN_PASS=""
DOMAIN=""
PANEL_PORT=""

if [ -n "$EXISTING_USER" ]; then
    echo ""
    echo "  📦 Instalación previa detectada:"
    echo ""
    echo "     Usuario:  $EXISTING_USER"
    echo "     Dominio:  $EXISTING_DOMAIN"
    echo "     Puerto:   $EXISTING_PORT"
    echo ""
    read -p "  ¿Deseas mantener estas credenciales? [S/n]: " USE_EXISTING
    USE_EXISTING=${USE_EXISTING:-S}
    if [[ "$USE_EXISTING" =~ ^[SsYy]$ ]]; then
        ADMIN_USER="$EXISTING_USER"
        ADMIN_PASS="$EXISTING_PASS"
        DOMAIN="$EXISTING_DOMAIN"
        PANEL_PORT="$EXISTING_PORT"
        echo "  ✓ Credenciales existentes conservadas"
    fi
fi

if [ -z "$ADMIN_USER" ] || [ -z "$DOMAIN" ]; then
    echo ""
    while true; do
        read -p "  👤 Usuario administrador: " ADMIN_USER
        [ -z "$ADMIN_USER" ] && echo "     ⚠ Debe ingresar un usuario" && continue
        break
    done
    echo ""
    while true; do
        read -p "  🔑 Contraseña (visible): " ADMIN_PASS
        [ -z "$ADMIN_PASS" ] && echo "     ⚠ Debe ingresar una contraseña" && continue
        break
    done
    echo ""
    while true; do
        read -p "  🌐 Dominio (ej: panel.midominio.com): " DOMAIN
        [ -z "$DOMAIN" ] && echo "     ⚠ Debe ingresar un dominio" && continue
        break
    done
    echo ""
    echo "  ┌─────────────────────────────────────────────┐"
    echo "  │  Usuario:    $ADMIN_USER"
    echo "  │  Contraseña: $ADMIN_PASS"
    echo "  │  Dominio:    $DOMAIN"
    echo "  └─────────────────────────────────────────────┘"
    echo ""
    read -p "  ¿Son correctas estas credenciales? [S/n]: " CONFIRM
    CONFIRM=${CONFIRM:-S}
    if [[ ! "$CONFIRM" =~ ^[SsYy]$ ]]; then
        echo "  Cancelando instalación..."
        exit 1
    fi
fi

[ -z "$DOMAIN" ] && { echo "Error: dominio requerido."; exit 1; }

SERVER_TZ="America/Santo_Domingo"
timedatectl set-timezone "$SERVER_TZ" 2>/dev/null || true

PUBLIC_IP=$(curl -s4 --max-time 5 ifconfig.me 2>/dev/null || echo "")
DOMAIN_IP=$(getent hosts "$DOMAIN" 2>/dev/null | awk '{print $1}' | head -1)
echo "IP publica: $PUBLIC_IP  |  DNS $DOMAIN -> $DOMAIN_IP"
if [ -n "$PUBLIC_IP" ] && [ -n "$DOMAIN_IP" ] && [ "$PUBLIC_IP" != "$DOMAIN_IP" ]; then
    read -p "ATENCION: $DOMAIN resuelve a $DOMAIN_IP pero tu IP publica es $PUBLIC_IP. Continuar? [s/N]: " CONT
    [ "$CONT" != "s" ] && exit 1
fi

if [ -z "$PANEL_PORT" ]; then
    read -p "Puerto HTTPS del panel [Enter = 443]: " PANEL_PORT
    PANEL_PORT=${PANEL_PORT:-443}
fi
if ! [[ "$PANEL_PORT" =~ ^[0-9]+$ ]] || [ "$PANEL_PORT" -lt 1 ] || [ "$PANEL_PORT" -gt 65535 ]; then PANEL_PORT=443; fi
[ "$PANEL_PORT" = "80" ] && PANEL_PORT=443

if [ "$PANEL_PORT" = "443" ]; then PANEL_URL="https://$DOMAIN"; else PANEL_URL="https://$DOMAIN:$PANEL_PORT"; fi
echo "Panel URL: $PANEL_URL"

# ============ FUNCIONES AUXILIARES ============
apt_install() {
    local max_retries=5; local count=0
    until [ $count -ge $max_retries ]; do
        DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=-1 -o Dpkg::Options::=--force-confold install -y -qq --no-install-recommends --fix-missing "$@" && return 0
        count=$((count+1)); sleep 10; apt-get update -qq
    done
    return 1
}

apt-get -o DPkg::Lock::Timeout=-1 update -qq || true
apt_install nginx curl wget git ca-certificates build-essential sqlite3 libsqlite3-dev lsof cron openssl ufw unzip zip jq iproute2 socat tzdata iptables libcairo2-dev libpango1.0-dev libjpeg-dev libgif-dev librsvg2-dev pkg-config psmisc

curl -fsSL https://deb.nodesource.com/setup_20.x | bash - > /dev/null 2>&1
apt_install nodejs

# ============ OPTIMIZACIÓN DEL SISTEMA ============
cat > /etc/sysctl.d/99-gzmnet-optimize.conf <<'SYSCTL_EOF'
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr
net.core.rmem_max = 268435456
net.core.wmem_max = 268435456
net.ipv4.tcp_rmem = 8192 262144 268435456
net.ipv4.tcp_wmem = 8192 262144 268435456
net.ipv4.tcp_fastopen = 3
net.ipv4.tcp_slow_start_after_idle = 0
net.ipv4.tcp_mtu_probing = 1
net.ipv4.tcp_keepalive_time = 300
net.ipv4.tcp_fin_timeout = 15
net.ipv4.tcp_tw_reuse = 1
net.ipv4.tcp_ecn = 1
net.ipv4.tcp_syncookies = 1
net.ipv4.tcp_notsent_lowat = 16384
net.ipv4.ip_local_port_range = 10240 65535
net.core.somaxconn = 65535
net.core.netdev_max_backlog = 65535
net.ipv4.tcp_max_syn_backlog = 65535
net.ipv4.tcp_window_scaling = 1
net.ipv4.tcp_timestamps = 1
net.ipv4.tcp_sack = 1
fs.file-max = 2000000
fs.nr_open = 2000000
vm.swappiness = 5
vm.overcommit_memory = 1
vm.max_map_count = 262144
SYSCTL_EOF

modprobe tcp_bbr 2>/dev/null || true
echo "tcp_bbr" > /etc/modules-load.d/bbr.conf 2>/dev/null || true
sysctl -p /etc/sysctl.d/99-gzmnet-optimize.conf > /dev/null 2>&1 || true

cat > /etc/security/limits.d/99-gzmnet.conf <<'LIMITS_EOF'
*    soft nofile 1000000
*    hard nofile 1000000
root soft nofile 1000000
root hard nofile 1000000
LIMITS_EOF

mkdir -p /etc/systemd/system/pm2-root.service.d
cat > /etc/systemd/system/pm2-root.service.d/limits.conf <<'P2LIM'
[Service]
LimitNOFILE=1000000
P2LIM
systemctl daemon-reload 2>/dev/null || true

# ============ ACME.SH ============
curl -s https://get.acme.sh | sh -s email=admin@$DOMAIN > /dev/null 2>&1
source ~/.acme.sh/acme.sh.env 2>/dev/null || true

# ============ DIRECTORIOS Y CONFIG ============
mkdir -p /root/gzmnet/{views,data,backups,public}
mkdir -p /var/www/html /etc/nginx/ssl
chmod 700 /root/gzmnet /root/gzmnet/data
cd /root/gzmnet

SESSION_SECRET=$(openssl rand -hex 32)
jq -n --arg u "$ADMIN_USER" --arg p "$ADMIN_PASS" --arg s "$SESSION_SECRET" \
    '{adminUser:$u, adminPassword:$p, port:3000, sessionSecret:$s}' > config.json
chmod 600 /root/gzmnet/config.json

if [ -f /root/gzmnet/vpn_config.json ]; then
    jq --arg d "$DOMAIN" --arg tz "$SERVER_TZ" --argjson pp "$PANEL_PORT" \
        '.domain = $d | .timezone = $tz | .panelPort = $pp | .subPort = ($pp)' \
        /root/gzmnet/vpn_config.json > /tmp/vpn_config.tmp && mv /tmp/vpn_config.tmp /root/gzmnet/vpn_config.json
else
    jq -n --arg d "$DOMAIN" --arg tz "$SERVER_TZ" --argjson pp "$PANEL_PORT" \
        '{enabled:true, domain:$d, timezone:$tz, timeFormat:"24h", panelPort:$pp, subInterval:12, subPort:$pp, subPath:"/sub", subShowUsage:1, subTitle:"GZMNET VPN", subUserAgent:"", jsonEnabled:0, jsonPath:"/subjson", jsonBypass:"", jsonBypassDomains:"", jsonBypassGeosites:"", lastSslNotified:"", lastSslRenewed:""}' > vpn_config.json
fi
chmod 600 vpn_config.json

# ============ INICIALIZAR BASE DE DATOS ============
cat > init-db.js <<'INITEOF'
const Database = require('better-sqlite3');
const path = require('path');
const db = new Database(path.join(__dirname, 'data', 'vpn.sqlite'));
db.pragma('journal_mode = WAL');
db.exec(`
  CREATE TABLE IF NOT EXISTS inbounds (
    id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, protocol TEXT NOT NULL,
    port INTEGER NOT NULL, network TEXT DEFAULT 'ws', path TEXT DEFAULT '/',
    tls INTEGER DEFAULT 0, domain TEXT DEFAULT '', host TEXT DEFAULT '',
    security TEXT DEFAULT 'none', flow TEXT DEFAULT '', sniffing INTEGER DEFAULT 1,
    encryption TEXT DEFAULT '', fingerprint TEXT DEFAULT 'chrome', alpn TEXT DEFAULT '',
    reality_dest TEXT DEFAULT '', reality_server_names TEXT DEFAULT '',
    reality_private_key TEXT DEFAULT '', reality_public_key TEXT DEFAULT '',
    reality_short_ids TEXT DEFAULT '',
    grpc_service TEXT DEFAULT '', grpc_multi INTEGER DEFAULT 0,
    h2_path TEXT DEFAULT '/', h2_host TEXT DEFAULT '',
    quic_key TEXT DEFAULT '', quic_security TEXT DEFAULT 'none', quic_header TEXT DEFAULT 'none',
    kcp_seed TEXT DEFAULT '', kcp_header TEXT DEFAULT 'none',
    xhttp_path TEXT DEFAULT '/', xhttp_host TEXT DEFAULT '', xhttp_mode TEXT DEFAULT 'auto',
    ss_method TEXT DEFAULT 'aes-256-gcm',
    created_at TEXT DEFAULT (datetime('now','localtime')),
    updated_at TEXT DEFAULT (datetime('now','localtime'))
  );
  CREATE TABLE IF NOT EXISTS clients (
    id INTEGER PRIMARY KEY AUTOINCREMENT, inbound_id INTEGER NOT NULL,
    name TEXT NOT NULL, uuid TEXT NOT NULL, email TEXT, flow TEXT DEFAULT '',
    limit_gb REAL DEFAULT 0, enabled INTEGER DEFAULT 1, last_seen TEXT,
    up_bytes INTEGER DEFAULT 0, down_bytes INTEGER DEFAULT 0, total_bytes INTEGER DEFAULT 0,
    online INTEGER DEFAULT 0, sub_token TEXT, sub_blocked INTEGER DEFAULT 0,
    auth_user TEXT DEFAULT '', auth_pass TEXT DEFAULT '',
    prev_uuid TEXT DEFAULT '', prev_auth_user TEXT DEFAULT '', prev_auth_pass TEXT DEFAULT '',
    payment_enabled INTEGER DEFAULT 0, payment_date TEXT DEFAULT '',
    payment_frequency INTEGER DEFAULT 0, payment_time TEXT DEFAULT '09:00',
    telegram_chat_id TEXT DEFAULT '',
    last_payment_notified TEXT DEFAULT '',
    device_limit INTEGER DEFAULT 0,
    created_at TEXT DEFAULT (datetime('now','localtime')),
    FOREIGN KEY(inbound_id) REFERENCES inbounds(id) ON DELETE CASCADE
  );
  CREATE INDEX IF NOT EXISTS idx_clients_inbound ON clients(inbound_id);
  CREATE UNIQUE INDEX IF NOT EXISTS idx_clients_subtoken ON clients(sub_token);
  CREATE TABLE IF NOT EXISTS subscription_devices (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    client_id INTEGER NOT NULL,
    device_hash TEXT NOT NULL,
    user_agent TEXT DEFAULT '',
    display_name TEXT DEFAULT '',
    ip_address TEXT DEFAULT '',
    first_seen TEXT DEFAULT (datetime('now','localtime')),
    last_seen TEXT DEFAULT (datetime('now','localtime')),
    FOREIGN KEY(client_id) REFERENCES clients(id) ON DELETE CASCADE
  );
  CREATE INDEX IF NOT EXISTS idx_devices_client ON subscription_devices(client_id);
  CREATE TABLE IF NOT EXISTS routing_settings (
    id INTEGER PRIMARY KEY CHECK (id = 1),
    block_ads INTEGER DEFAULT 0, block_adult INTEGER DEFAULT 0,
    block_malware INTEGER DEFAULT 0, block_trackers INTEGER DEFAULT 0,
    block_bittorrent INTEGER DEFAULT 0, prevent_captcha INTEGER DEFAULT 0,
    block_youtube_ads INTEGER DEFAULT 0,
    warp_enabled INTEGER DEFAULT 0, domain_strategy TEXT DEFAULT 'IPIfNonMatch',
    ip_type TEXT DEFAULT 'dual', fake_dns INTEGER DEFAULT 0,
    dns_primary TEXT DEFAULT '1.1.1.1', dns_secondary TEXT DEFAULT '8.8.8.8',
    dns_primary_v6 TEXT DEFAULT '2606:4700:4700::1111', dns_secondary_v6 TEXT DEFAULT '2001:4860:4860::8888',
    dns_query_strategy TEXT DEFAULT 'UseIP',
    cache_enabled INTEGER DEFAULT 0, cache_hour INTEGER DEFAULT 4,
    cache_minute INTEGER DEFAULT 0, last_cache_at TEXT,
    block_quic_global INTEGER DEFAULT 0,
    updated_at TEXT DEFAULT (datetime('now','localtime'))
  );
  CREATE TABLE IF NOT EXISTS routing_rules (
    id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL,
    match_type TEXT NOT NULL, value TEXT NOT NULL,
    outbound TEXT NOT NULL, enabled INTEGER DEFAULT 1,
    priority INTEGER DEFAULT 0, match_rules TEXT DEFAULT '',
    created_at TEXT DEFAULT (datetime('now','localtime'))
  );
  CREATE TABLE IF NOT EXISTS json_sub_settings (
    id INTEGER PRIMARY KEY CHECK (id = 1), enabled INTEGER DEFAULT 0,
    path TEXT DEFAULT '/subjson', bypass TEXT DEFAULT '',
    updated_at TEXT DEFAULT (datetime('now','localtime'))
  );
  CREATE TABLE IF NOT EXISTS telegram_settings (
    id INTEGER PRIMARY KEY CHECK (id = 1),
    enabled INTEGER DEFAULT 0,
    bot_token TEXT DEFAULT '',
    admin_ids TEXT DEFAULT '',
    notify_payment INTEGER DEFAULT 1,
    notify_online INTEGER DEFAULT 0,
    auto_backup INTEGER DEFAULT 0,
    auto_backup_hour INTEGER DEFAULT 3,
    auto_backup_minute INTEGER DEFAULT 0,
    last_backup_at TEXT DEFAULT '',
    updated_at TEXT DEFAULT (datetime('now','localtime'))
  );
  CREATE TABLE IF NOT EXISTS push_subscriptions (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    client_id INTEGER NOT NULL,
    endpoint TEXT NOT NULL,
    p256dh TEXT NOT NULL,
    auth TEXT NOT NULL,
    created_at TEXT DEFAULT (datetime('now','localtime')),
    FOREIGN KEY(client_id) REFERENCES clients(id) ON DELETE CASCADE
  );
  CREATE INDEX IF NOT EXISTS idx_push_client ON push_subscriptions(client_id);
  CREATE TABLE IF NOT EXISTS admin_push_subscriptions (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    endpoint TEXT NOT NULL UNIQUE,
    p256dh TEXT NOT NULL,
    auth TEXT NOT NULL,
    created_at TEXT DEFAULT (datetime('now','localtime'))
  );
  CREATE TABLE IF NOT EXISTS system_metrics (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    ts TEXT DEFAULT (datetime('now','localtime')),
    cpu REAL DEFAULT 0,
    ram REAL DEFAULT 0
  );
  CREATE INDEX IF NOT EXISTS idx_metrics_ts ON system_metrics(ts);
`);
function ensureCol(table, col, def) {
    try {
        const cols = db.prepare(`PRAGMA table_info(${table})`).all().map(c => c.name);
        if (!cols.includes(col)) db.exec(`ALTER TABLE ${table} ADD COLUMN ${col} ${def}`);
    } catch(e) {}
}
ensureCol('clients', 'payment_enabled', 'INTEGER DEFAULT 0');
ensureCol('clients', 'payment_date', "TEXT DEFAULT ''");
ensureCol('clients', 'payment_frequency', 'INTEGER DEFAULT 0');
ensureCol('clients', 'payment_time', "TEXT DEFAULT '09:00'");
ensureCol('clients', 'telegram_chat_id', "TEXT DEFAULT ''");
ensureCol('clients', 'last_payment_notified', "TEXT DEFAULT ''");
ensureCol('clients', 'auth_user', "TEXT DEFAULT ''");
ensureCol('clients', 'auth_pass', "TEXT DEFAULT ''");
ensureCol('clients', 'prev_uuid', "TEXT DEFAULT ''");
ensureCol('clients', 'prev_auth_user', "TEXT DEFAULT ''");
ensureCol('clients', 'prev_auth_pass', "TEXT DEFAULT ''");
ensureCol('clients', 'device_limit', 'INTEGER DEFAULT 0');
ensureCol('inbounds', 'ss_method', "TEXT DEFAULT 'aes-256-gcm'");
ensureCol('inbounds', 'grpc_service', "TEXT DEFAULT ''");
ensureCol('inbounds', 'grpc_multi', "INTEGER DEFAULT 0");
ensureCol('inbounds', 'h2_path', "TEXT DEFAULT '/'");
ensureCol('inbounds', 'h2_host', "TEXT DEFAULT ''");
ensureCol('inbounds', 'quic_key', "TEXT DEFAULT ''");
ensureCol('inbounds', 'quic_security', "TEXT DEFAULT 'none'");
ensureCol('inbounds', 'quic_header', "TEXT DEFAULT 'none'");
ensureCol('inbounds', 'kcp_seed', "TEXT DEFAULT ''");
ensureCol('inbounds', 'kcp_header', "TEXT DEFAULT 'none'");
ensureCol('inbounds', 'xhttp_path', "TEXT DEFAULT '/'");
ensureCol('inbounds', 'xhttp_host', "TEXT DEFAULT ''");
ensureCol('inbounds', 'xhttp_mode', "TEXT DEFAULT 'auto'");
ensureCol('routing_settings', 'block_youtube_ads', 'INTEGER DEFAULT 0');
ensureCol('telegram_settings', 'auto_backup_minute', 'INTEGER DEFAULT 0');

const r1 = db.prepare('SELECT COUNT(*) as c FROM routing_settings').get();
if (!r1 || r1.c === 0) db.prepare(`INSERT INTO routing_settings (id) VALUES (1)`).run();
const r2 = db.prepare('SELECT COUNT(*) as c FROM json_sub_settings').get();
if (!r2 || r2.c === 0) db.prepare(`INSERT INTO json_sub_settings (id) VALUES (1)`).run();
const r3 = db.prepare('SELECT COUNT(*) as c FROM telegram_settings').get();
if (!r3 || r3.c === 0) db.prepare(`INSERT INTO telegram_settings (id) VALUES (1)`).run();
console.log('Base de datos lista');
INITEOF

echo "Instalando dependencias de Node.js..."
npm install --production --no-optional --no-audit --no-fund --loglevel=error express socket.io express-session better-sqlite3 better-sqlite3-session-store qrcode web-push canvas > /dev/null 2>&1 || npm install --production --no-optional --no-audit --no-fund --loglevel=error express socket.io express-session better-sqlite3 qrcode web-push > /dev/null 2>&1

echo "Inicializando base de datos..."
node init-db.js

# ============ XRAY ============
echo "Descargando Xray (latest)..."
ARCH=$(uname -m)
case $ARCH in
    x86_64) XRAY_ARCH="64" ;;
    aarch64) XRAY_ARCH="arm64-v8a" ;;
    *) XRAY_ARCH="64" ;;
esac

XRAY_URL="https://github.com/XTLS/Xray-core/releases/latest/download/Xray-linux-${XRAY_ARCH}.zip"

if curl -fsSL -o /tmp/xray.zip "$XRAY_URL"; then
    mkdir -p /usr/local/bin /usr/local/etc/xray
    unzip -o /tmp/xray.zip -d /usr/local/bin/ > /dev/null 2>&1
    rm -f /tmp/xray.zip
    chmod +x /usr/local/bin/xray
    echo "Xray instalado: $(/usr/local/bin/xray version | head -1)"
else
    echo "Error: No se pudo descargar Xray"
    exit 1
fi

mkdir -p /root/gzmnet/data
if [ -s /root/gzmnet/data/vless_decryption.key ] && [ -s /root/gzmnet/data/vless_encryption.key ]; then
    DECRYPTION_KEY=$(cat /root/gzmnet/data/vless_decryption.key)
    ENCRYPTION_KEY=$(cat /root/gzmnet/data/vless_encryption.key)
else
    VLESSENC_OUTPUT=$(/usr/local/bin/xray vlessenc 2>&1 | tr -d '\r')
    VLESSENC_FLAT=$(printf '%s' "$VLESSENC_OUTPUT" | tr '\n' ' ')
    DECRYPTION_KEY=$(printf '%s' "$VLESSENC_FLAT" | sed -n 's/.*"decryption"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
    ENCRYPTION_KEY=$(printf '%s' "$VLESSENC_FLAT" | sed -n 's/.*"encryption"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
    [ -z "$DECRYPTION_KEY" ] && DECRYPTION_KEY="none"
    [ -z "$ENCRYPTION_KEY" ] && ENCRYPTION_KEY="none"
    echo "$DECRYPTION_KEY" > /root/gzmnet/data/vless_decryption.key
    echo "$ENCRYPTION_KEY" > /root/gzmnet/data/vless_encryption.key
fi
chmod 600 /root/gzmnet/data/vless_decryption.key /root/gzmnet/data/vless_encryption.key

mkdir -p /usr/local/share/xray
curl -fsSL -o /usr/local/share/xray/geoip.dat "https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geoip.dat" 2>/dev/null || true
curl -fsSL -o /usr/local/share/xray/geosite.dat "https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geosite.dat" 2>/dev/null || true
ln -sf /usr/local/share/xray/geoip.dat /usr/local/bin/geoip.dat 2>/dev/null || true
ln -sf /usr/local/share/xray/geosite.dat /usr/local/bin/geosite.dat 2>/dev/null || true

mkdir -p /usr/local/etc/xray
cat > /usr/local/etc/xray/config.json <<'XRAYEOF'
