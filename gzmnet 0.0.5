    let filtered = allClients;
    if (q) filtered = allClients.filter(c => String(c.name||'').toLowerCase().includes(q) || String(c.id).includes(q));
    if (!filtered.length) { list.innerHTML = `<div class="card empty"><i data-lucide="users"></i><div class="empty-title">${q ? 'Sin resultados' : 'Aún no hay clientes'}</div><div class="empty-text">${q ? 'Intenta otra búsqueda' : 'Crea tu primer cliente'}</div>${!q ? '<button class="btn btn-primary" onclick="openNewClient()"><i data-lucide="user-plus"></i> Crear</button>' : ''}</div>`; renderIcons(); return; }
    list.innerHTML = filtered.map(c => {
        const s = vpnStats.find(v => v.id === c.id) || {};
        const en = c.enabled == 1, on = en && s.connected;
        const proto = (c.protocol||'').toLowerCase();
        const badges = getPayBadges(c);
        return `<div class="client-row ${!en ? 'disabled' : ''}"><span class="client-dot ${on ? 'on' : ''}"></span><div class="client-info"><div class="client-name">${esc(c.name)} <span class="mono" style="font-size:11px;color:var(--text-3);font-weight:400;">ID ${c.id}</span></div><div class="client-meta"><span class="badge ${proto}">${proto.toUpperCase()}</span><span class="badge count">${esc(c.inbound_name||'')}</span><span class="badge ${en ? 'on' : 'off'}">${en ? 'Activo' : 'Inactivo'}</span><span class="mono" style="color:var(--text-2);">${fmtB(s.total||0)}</span></div>${badges ? `<div class="client-badges">${badges}${c.payment_enabled && c.payment_date ? `<span class="badge count">${formatDateSpanish(c.payment_date)}</span>` : ''}</div>` : ''}</div><div class="client-actions"><button class="btn btn-ghost btn-icon" onclick="openEditClient(${c.id}, ${c.inbound_id})"><i data-lucide="edit-2"></i></button><button class="btn btn-ghost btn-icon" onclick="openShare(${c.id})"><i data-lucide="share-2"></i></button><button class="btn btn-ghost btn-icon" onclick="toggleClient(${c.id})"><i data-lucide="power"></i></button><button class="btn btn-ghost btn-icon" style="color:var(--danger);" onclick="deleteClient(${c.id})"><i data-lucide="trash-2"></i></button></div></div>`;
    }).join('');
    renderIcons();
}

async function loadRouting(){ try { const r = await fetch('/api/routing'); const d = await r.json(); if (!d.ok) return; routingSettings = d.settings || {}; routingRules = d.rules || []; renderToggles(); renderRules(); selectedIpType = routingSettings.ip_type || 'dual'; renderIpType(); const el = id => document.getElementById(id); if (el('dnsPrimary')) el('dnsPrimary').value = routingSettings.dns_primary || '1.1.1.1'; if (el('dnsSecondary')) el('dnsSecondary').value = routingSettings.dns_secondary || '8.8.8.8'; if (el('dnsPrimaryV6')) el('dnsPrimaryV6').value = routingSettings.dns_primary_v6 || ''; if (el('dnsSecondaryV6')) el('dnsSecondaryV6').value = routingSettings.dns_secondary_v6 || ''; if (el('domainStrategy')) el('domainStrategy').value = routingSettings.domain_strategy || 'IPIfNonMatch'; if (el('swFakeDns')) el('swFakeDns').classList.toggle('on', routingSettings.fake_dns == 1); } catch(e){} }
