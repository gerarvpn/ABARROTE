pm2 start pm2-logrotate 2>/dev/null || true

pm2 start /usr/local/bin/xray-pm2-wrapper.sh --name xray --interpreter bash --max-restarts 200 --restart-delay 3000
pm2 start app.js --name gzmnet --node-args="--max-old-space-size=192" --max-memory-restart 300M --max-restarts 30 --restart-delay 2000
pm2 save
pm2 startup systemd -u root --hp /root > /dev/null 2>&1 || true

# =================== SSL ÚNICAMENTE CON ZEROSSL ===================
echo ""
echo "============================================================="
echo "  Configurando Nginx y certificado SSL (ZeroSSL)"
echo "============================================================="

CERT_FILE="/etc/nginx/ssl/$DOMAIN.crt"
KEY_FILE="/etc/nginx/ssl/$DOMAIN.key"
NEED_ISSUE=0
SSL_SUCCESS=0

if [ -f "$CERT_FILE" ] && [ -f "$KEY_FILE" ] && [ -s "$CERT_FILE" ] && [ -s "$KEY_FILE" ]; then
    START_DATE=$(openssl x509 -in "$CERT_FILE" -noout -startdate 2>/dev/null | sed 's/notBefore=//')
    START_TS=$(date -d "$START_DATE" +%s 2>/dev/null || echo 0)
    END_DATE=$(openssl x509 -in "$CERT_FILE" -noout -enddate 2>/dev/null | sed 's/notAfter=//')
    END_TS=$(date -d "$END_DATE" +%s 2>/dev/null || echo 0)
    NOW_TS=$(date +%s)
    CERT_HOST_OK=0
    if openssl x509 -in "$CERT_FILE" -noout -checkhost "$DOMAIN" 2>/dev/null | grep -q "does match"; then CERT_HOST_OK=1; fi
    if [ "$START_TS" -gt 0 ] && [ "$END_TS" -gt "$NOW_TS" ] && [ "$CERT_HOST_OK" -eq 1 ]; then
        DAYS_OLD=$(( (NOW_TS - START_TS) / 86400 ))
        DAYS_LEFT=$(( (END_TS - NOW_TS) / 86400 ))
        if [ "$DAYS_OLD" -lt 50 ] && [ "$DAYS_LEFT" -gt 40 ]; then
            echo ">>> ✓ Certificado válido ($DAYS_OLD días, $DAYS_LEFT restantes)"
            SSL_SUCCESS=1
        else
            echo ">>> Certificado requiere renovación, reemitiendo con ZeroSSL..."
            NEED_ISSUE=1
        fi
    else
        echo ">>> Certificado inválido o expirado, reemitiendo con ZeroSSL..."
        NEED_ISSUE=1
    fi
else
    echo ">>> No existe certificado, emitiendo con ZeroSSL..."
    NEED_ISSUE=1
fi

if [ "$NEED_ISSUE" -eq 1 ]; then
    {
        if [ -f "/root/gzmnet/data/vpn.sqlite" ]; then
            XRAY_ON_80=$(sqlite3 "/root/gzmnet/data/vpn.sqlite" "SELECT COUNT(*) FROM inbounds WHERE port = 80" 2>/dev/null || echo 0)
            if [ "$XRAY_ON_80" -gt 0 ]; then
                pm2 stop xray 2>/dev/null || true
                pkill -9 -f "xray run" 2>/dev/null || true
            fi
        fi
        systemctl stop nginx 2>/dev/null || true
        systemctl stop apache2 2>/dev/null || true
        pkill -9 nginx 2>/dev/null || true
        pkill -9 apache2 2>/dev/null || true
    } > /dev/null 2>&1
    sleep 2

    for i in {1..15}; do
        if ! ss -tln | grep -q ':80 '; then break; fi
        fuser -k -9 80/tcp 2>/dev/null || true
        sleep 2
    done

    export LE_WORKING_DIR="/root/.acme.sh"
    ufw allow 80/tcp >/dev/null 2>&1 || true

    echo ">>> Registrando cuenta ZeroSSL..."
    /root/.acme.sh/acme.sh --register-account -m "admin@$DOMAIN" --server zerossl --force > /tmp/acme-zerossl-register.log 2>&1
    if [ $? -ne 0 ]; then
        /root/.acme.sh/acme.sh --register-account -m "gzmnet@$DOMAIN" --server zerossl --force > /tmp/acme-zerossl-register.log 2>&1 || true
    fi

    echo ">>> Emitiendo certificado ZeroSSL (ECC)..."
    for attempt in 1 2 3; do
        echo "    Intento $attempt/3..."
        fuser -k -9 80/tcp 2>/dev/null || true
        sleep 3
        timeout 300 /root/.acme.sh/acme.sh --issue -d "$DOMAIN" --standalone --server zerossl --keylength ec-256 --force --accountemail "admin@$DOMAIN" > /tmp/ssl-zerossl-ecc.log 2>&1
        if [ $? -eq 0 ]; then
            /root/.acme.sh/acme.sh --install-cert -d "$DOMAIN" --ecc \
                --key-file "$KEY_FILE" \
                --fullchain-file "$CERT_FILE" > /tmp/ssl-install-ecc.log 2>&1
            if [ -f "$CERT_FILE" ] && [ -f "$KEY_FILE" ] && [ -s "$CERT_FILE" ] && [ -s "$KEY_FILE" ]; then
                if openssl x509 -in "$CERT_FILE" -noout -checkhost "$DOMAIN" 2>/dev/null | grep -q "does match"; then
                    SSL_SUCCESS=1
                    echo ">>> ✓ ZeroSSL ECC emitido correctamente"
                    break
                fi
            fi
        fi
        sleep 8
    done

    if [ "$SSL_SUCCESS" -eq 0 ]; then
        echo ">>> ECC falló, intentando ZeroSSL RSA..."
        for attempt in 1 2 3; do
            echo "    Intento RSA $attempt/3..."
            fuser -k -9 80/tcp 2>/dev/null || true
            sleep 3
            timeout 300 /root/.acme.sh/acme.sh --issue -d "$DOMAIN" --standalone --server zerossl --keylength 2048 --force --accountemail "admin@$DOMAIN" > /tmp/ssl-zerossl-rsa.log 2>&1
            if [ $? -eq 0 ]; then
                /root/.acme.sh/acme.sh --install-cert -d "$DOMAIN" \
                    --key-file "$KEY_FILE" \
                    --fullchain-file "$CERT_FILE" > /tmp/ssl-install-rsa.log 2>&1
                if [ -f "$CERT_FILE" ] && [ -f "$KEY_FILE" ] && [ -s "$CERT_FILE" ] && [ -s "$KEY_FILE" ]; then
                    if openssl x509 -in "$CERT_FILE" -noout -checkhost "$DOMAIN" 2>/dev/null | grep -q "does match"; then
                        SSL_SUCCESS=1
                        echo ">>> ✓ ZeroSSL RSA emitido correctamente"
                        break
                    fi
                fi
            fi
            sleep 8
        done
    fi

    if [ -f "/root/gzmnet/data/vpn.sqlite" ]; then
        XRAY_ON_80=$(sqlite3 "/root/gzmnet/data/vpn.sqlite" "SELECT COUNT(*) FROM inbounds WHERE port = 80" 2>/dev/null || echo 0)
        if [ "$XRAY_ON_80" -gt 0 ]; then
            echo ">>> Restaurando Xray en puerto 80..."
            pm2 restart xray >/dev/null 2>&1 || pm2 start xray >/dev/null 2>&1 || pm2 reload xray >/dev/null 2>&1 || true
            sleep 5
        fi
    fi
fi

# ============ CONFIGURAR NGINX ============
rm -f /etc/nginx/sites-enabled/default 2>/dev/null || true
mkdir -p /etc/nginx/sites-available /etc/nginx/sites-enabled

PANEL_MODE=""
if [ "$SSL_SUCCESS" -eq 1 ] && [ -f "$CERT_FILE" ] && [ -f "$KEY_FILE" ] && [ -s "$CERT_FILE" ] && [ -s "$KEY_FILE" ]; then
    PANEL_MODE="https"
    cat > /etc/nginx/sites-available/gzmnet <<EOF
server {
    listen $PANEL_PORT ssl http2;
    server_name $DOMAIN;
    client_max_body_size 100M;
    ssl_certificate $CERT_FILE;
    ssl_certificate_key $KEY_FILE;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'HIGH:!aNULL:!MD5';
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    location /static/ { alias /root/gzmnet/public/; expires 1d; access_log off; }
    location / { proxy_pass http://127.0.0.1:3000; proxy_http_version 1.1; proxy_set_header Upgrade \$http_upgrade; proxy_set_header Connection 'upgrade'; proxy_set_header Host \$host; proxy_set_header X-Real-IP \$remote_addr; proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto \$scheme; }
    location /socket.io/ { proxy_pass http://127.0.0.1:3000/socket.io/; proxy_http_version 1.1; proxy_set_header Upgrade \$http_upgrade; proxy_set_header Connection "upgrade"; proxy_set_header Host \$host; proxy_read_timeout 86400s; }
}
EOF
    (crontab -l 2>/dev/null | grep -v acme.sh; echo "0 0 * * * /root/.acme.sh/acme.sh --cron --home /root/.acme.sh > /dev/null 2>&1") | crontab -
    echo ">>> Panel HTTPS configurado en puerto $PANEL_PORT"
else
    # FIX: Nginx fallback NO usa puerto 80 (conflictúa con Xray). Usa 8443 en HTTP.
    PANEL_MODE="http"
    cat > /etc/nginx/sites-available/gzmnet <<EOF
server {
    listen 8443;
    server_name $DOMAIN;
    client_max_body_size 100M;
    location /static/ { alias /root/gzmnet/public/; expires 1d; access_log off; }
    location / { proxy_pass http://127.0.0.1:3000; proxy_http_version 1.1; proxy_set_header Upgrade \$http_upgrade; proxy_set_header Connection 'upgrade'; proxy_set_header Host \$host; proxy_set_header X-Real-IP \$remote_addr; proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto \$scheme; }
    location /socket.io/ { proxy_pass http://127.0.0.1:3000/socket.io/; proxy_http_version 1.1; proxy_set_header Upgrade \$http_upgrade; proxy_set_header Connection "upgrade"; proxy_set_header Host \$host; proxy_read_timeout 86400s; }
}
EOF
    echo ">>> ADVERTENCIA: ZeroSSL no pudo emitir el certificado."
    echo ">>> Panel accesible por HTTP: http://$DOMAIN:8443 (puerto 80 libre para Xray)"
    echo ">>> Puedes reintentar la emisión con: /usr/local/bin/gzmnet-renew-cert.sh"
fi

ln -sf /etc/nginx/sites-available/gzmnet /etc/nginx/sites-enabled/
systemctl start nginx
nginx -t && systemctl reload nginx || { echo "ERROR nginx"; journalctl -xeu nginx.service -n 20 --no-pager; }

# =================== SCRIPT DE RENOVACIÓN SSL ===================
cat > /usr/local/bin/gzmnet-renew-cert.sh <<'RENEWEOF'
#!/bin/bash
DOMAIN="__DOMAIN__"
CERT_FILE="/etc/nginx/ssl/$DOMAIN.crt"
KEY_FILE="/etc/nginx/ssl/$DOMAIN.key"
LOG="/root/gzmnet/data/cert-renew.log"
LOCK="/root/gzmnet/data/ssl-renew.lock"

mkdir -p /root/gzmnet/data
echo "[$(date)] === Verificando certificado SSL ===" >> "$LOG"

NEED_ISSUE=0
if [ -f "$CERT_FILE" ] && [ -f "$KEY_FILE" ] && [ -s "$CERT_FILE" ] && [ -s "$KEY_FILE" ]; then
    START_DATE=$(openssl x509 -in "$CERT_FILE" -noout -startdate 2>/dev/null | sed 's/notBefore=//')
    START_TS=$(date -d "$START_DATE" +%s 2>/dev/null || echo 0)
    END_DATE=$(openssl x509 -in "$CERT_FILE" -noout -enddate 2>/dev/null | sed 's/notAfter=//')
    END_TS=$(date -d "$END_DATE" +%s 2>/dev/null || echo 0)
    NOW_TS=$(date +%s)
    CERT_HOST_OK=0
    if openssl x509 -in "$CERT_FILE" -noout -checkhost "$DOMAIN" 2>/dev/null | grep -q "does match"; then CERT_HOST_OK=1; fi
    if [ "$START_TS" -gt 0 ] && [ "$END_TS" -gt "$NOW_TS" ] && [ "$CERT_HOST_OK" -eq 1 ]; then
        DAYS_OLD=$(( (NOW_TS - START_TS) / 86400 ))
        DAYS_LEFT=$(( (END_TS - NOW_TS) / 86400 ))
        echo "[$(date)] Certificado válido: $DAYS_OLD días de antigüedad, $DAYS_LEFT restantes" >> "$LOG"
        if [ "$DAYS_OLD" -lt 50 ]; then
            echo "[$(date)] Certificado joven (<50 días). Saltando renovación." >> "$LOG"
            exit 0
        fi
    else
        echo "[$(date)] Certificado inválido o expirado, requiere reemisión" >> "$LOG"
        NEED_ISSUE=1
    fi
else
    echo "[$(date)] No hay certificado, requiere emisión" >> "$LOG"
    NEED_ISSUE=1
fi

exec 200>"$LOCK"
if ! flock -n 200; then
    echo "[$(date)] Otra renovación en curso, saliendo." >> "$LOG"
    exit 0
fi

{
    if [ -f "/root/gzmnet/data/vpn.sqlite" ]; then
        XRAY_ON_80=$(sqlite3 "/root/gzmnet/data/vpn.sqlite" "SELECT COUNT(*) FROM inbounds WHERE port = 80" 2>/dev/null || echo 0)
        if [ "$XRAY_ON_80" -gt 0 ]; then
            pm2 stop xray 2>/dev/null || true
            pkill -9 -f "xray run" 2>/dev/null || true
        fi
    fi
    systemctl stop nginx 2>/dev/null || true
    systemctl stop apache2 2>/dev/null || true
    pkill -9 nginx 2>/dev/null || true
    pkill -9 apache2 2>/dev/null || true
} > /dev/null 2>&1
sleep 2

for i in {1..10}; do
    if ! ss -tln | grep -q ':80 '; then break; fi
    fuser -k -9 80/tcp 2>/dev/null || true
    sleep 2
done

export LE_WORKING_DIR="/root/.acme.sh"
/root/.acme.sh/acme.sh --register-account -m "admin@$DOMAIN" --server zerossl --force > /dev/null 2>&1 || true

echo "[$(date)] Renovando con ZeroSSL ECC..." >> "$LOG"
/root/.acme.sh/acme.sh --renew -d "$DOMAIN" --ecc --server zerossl --force >> "$LOG" 2>&1
RENEW_ECC_OK=$?

if [ $RENEW_ECC_OK -ne 0 ]; then
    echo "[$(date)] ECC falló, intentando RSA..." >> "$LOG"
    /root/.acme.sh/acme.sh --renew -d "$DOMAIN" --server zerossl --force >> "$LOG" 2>&1
fi

/root/.acme.sh/acme.sh --install-cert -d "$DOMAIN" --ecc \
    --key-file "$KEY_FILE" \
    --fullchain-file "$CERT_FILE" 2>/dev/null || \
/root/.acme.sh/acme.sh --install-cert -d "$DOMAIN" \
    --key-file "$KEY_FILE" \
    --fullchain-file "$CERT_FILE" 2>/dev/null

if [ -f "/root/gzmnet/data/vpn.sqlite" ]; then
    XRAY_ON_80=$(sqlite3 "/root/gzmnet/data/vpn.sqlite" "SELECT COUNT(*) FROM inbounds WHERE port = 80" 2>/dev/null || echo 0)
    if [ "$XRAY_ON_80" -gt 0 ]; then
        pm2 restart xray 2>/dev/null || pm2 start xray 2>/dev/null || pm2 reload xray 2>/dev/null || true
        sleep 5
    fi
fi
systemctl start nginx 2>/dev/null || true
nginx -t && systemctl reload nginx 2>/dev/null || systemctl restart nginx 2>/dev/null || true

echo "[$(date)] === Renovación completada ===" >> "$LOG"
RENEWEOF

sed -i "s/__DOMAIN__/$DOMAIN/g" /usr/local/bin/gzmnet-renew-cert.sh
chmod +x /usr/local/bin/gzmnet-renew-cert.sh

(crontab -l 2>/dev/null | grep -v "gzmnet-renew-cert"; echo "0 4 * * * /usr/local/bin/gzmnet-renew-cert.sh") | crontab -

# =================== FIREWALL ===================
echo "Configurando UFW..."
ufw default deny incoming > /dev/null 2>&1
ufw default allow outgoing > /dev/null 2>&1
ufw allow 22/tcp > /dev/null 2>&1
ufw allow 80/tcp > /dev/null 2>&1
ufw allow $PANEL_PORT/tcp > /dev/null 2>&1
ufw allow 8443/tcp > /dev/null 2>&1
if [ -f "/root/gzmnet/data/vpn.sqlite" ]; then
    PORTS=$(sqlite3 "/root/gzmnet/data/vpn.sqlite" "SELECT DISTINCT port FROM inbounds;" 2>/dev/null | sort -u | tr '\n' ' ')
    for p in $PORTS; do ufw allow ${p}/tcp > /dev/null 2>&1; ufw allow ${p}/udp > /dev/null 2>&1; done
fi
for p in 2053 2083 2087 2096 8080; do ufw allow ${p}/tcp > /dev/null 2>&1; ufw allow ${p}/udp > /dev/null 2>&1; done
ufw --force enable > /dev/null 2>&1
ufw reload > /dev/null 2>&1

# =================== MENÚ GZM ===================
cat > /usr/local/bin/gzm <<'GZMENU'
#!/bin/bash
DIR="/root/gzmnet"
CONFIG="$DIR/config.json"
[ ! -d "$DIR" ] && { echo "No instalado"; exit 1; }
get_domain(){ sed -n 's/.*"domain"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$DIR/vpn_config.json" | head -1; }
get_port(){ sed -n 's/.*"panelPort"[[:space:]]*:[[:space:]]*\([0-9]*\).*/\1/p' "$DIR/vpn_config.json" | head -1; }
get_user(){ sed -n 's/.*"adminUser"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$CONFIG" | head -1; }
get_tz(){ sed -n 's/.*"timezone"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$DIR/vpn_config.json" | head -1; }
menu(){
    clear
    echo "============================================================="
    echo "  GZMNET VPN PANEL v0.0.5"
    echo "============================================================="
    echo " DOMINIO: $(get_domain)"
    echo " PUERTO:  $(get_port)"
    echo " USUARIO: $(get_user)"
    echo " ZONA:    $(get_tz)"
    echo "============================================================="
    echo " 1) REINICIAR PANEL"
    echo " 2) REINICIAR XRAY"
    echo " 3) ESTADO PM2"
    echo " 4) TEST CONFIG XRAY"
    echo " 5) LOGS DEL PANEL"
    echo " 6) LOGS XRAY"
    echo " 7) ESTADO WARP"
    echo " 8) VER FIREWALL"
    echo " 9) TEST NGINX"
    echo " S) VERIFICAR CERTIFICADO SSL"
    echo " R) RENOVAR CERTIFICADO SSL AHORA"
    echo " 0) SALIR"
    read -p "OPCION: " ch
    case $ch in
        1) pm2 restart gzmnet; pm2 save; echo "OK"; sleep 1 ;;
        2) pm2 restart xray; echo "OK"; sleep 1 ;;
        3) pm2 status; read ;;
        4) /usr/local/bin/xray run -test -config /usr/local/etc/xray/config.json 2>&1 | tail -5; read ;;
        5) pm2 logs gzmnet --lines 30 --nostream; read ;;
        6) pm2 logs xray --lines 30 --nostream; read ;;
        7) systemctl status wireproxy --no-pager | head -10 2>/dev/null || echo "No instalado"; read ;;
        8) ufw status numbered; read ;;
        9) nginx -t; read ;;
        S|s) DOM=$(get_domain); echo "=== Certificado ==="; openssl x509 -in "/etc/nginx/ssl/$DOM.crt" -noout -subject -dates -issuer 2>/dev/null; openssl x509 -in "/etc/nginx/ssl/$DOM.crt" -noout -checkhost "$DOM" 2>/dev/null; read ;;
        R|r) /usr/local/bin/gzmnet-renew-cert.sh; echo "Log: /root/gzmnet/data/cert-renew.log"; tail -20 /root/gzmnet/data/cert-renew.log; read ;;
        0) exit 0 ;;
    esac
    menu
}
menu
GZMENU
chmod +x /usr/local/bin/gzm

# =================== REINICIO FINAL ===================
pm2 delete gzmnet xray 2>/dev/null || true
pm2 start /usr/local/bin/xray-pm2-wrapper.sh --name xray --interpreter bash --max-restarts 200 --restart-delay 3000

echo ">>> Esperando a que Xray arranque..."
for i in {1..30}; do
    if ss -tln 2>/dev/null | grep -q ':10085 '; then
        echo ">>> Xray listo (API activo)"
        break
    fi
    sleep 1
done

pm2 start app.js --name gzmnet --node-args="--max-old-space-size=192" --max-memory-restart 300M --max-restarts 30 --restart-delay 2000
pm2 save

echo ""
echo "============================================================="
echo "  INSTALACION COMPLETADA v0.0.5"
echo "============================================================="
if [ "$PANEL_MODE" = "https" ]; then
    echo " PANEL:   $PANEL_URL  ✅ HTTPS (ZeroSSL)"
else
    echo " PANEL:   http://$DOMAIN:8443  ⚠️  (ZeroSSL no emitió)"
    echo "          Puerto 80 LIBRE para Xray"
fi
echo " USUARIO: $ADMIN_USER"
echo " PUERTO:  $PANEL_PORT"
echo " ZONA:    $SERVER_TZ"
echo " COMANDO: gzm"
echo "============================================================="