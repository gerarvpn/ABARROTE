app.post('/api/generate-password', checkAuth, (req, res) => { try { const len = Math.max(8, Math.min(32, parseInt(req.body.length) || 16)); const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789'; const bytes = crypto.randomBytes(len); let s = ''; for (let i = 0; i < len; i++) s += chars[bytes[i] % chars.length]; res.json({ ok: true, password: s }); } catch(e) { res.status(500).json({ ok: false, error: e.message }); } });

app.get('/api/portal/:token/vapid', (req, res) => {
