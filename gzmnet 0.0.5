function genUuidClient() {
    if (window.crypto && crypto.randomUUID) { try { return crypto.randomUUID(); } catch(e){} }
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => { const r = Math.random() * 16 | 0; return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16); });
}
function genShortTokenClient(len) {
    const chars = 'abcdefghjkmnpqrstuvwxyz23456789';
    let t = '';
    try { const bytes = crypto.getRandomValues(new Uint8Array(len || 8)); for (let i = 0; i < (len || 8); i++) t += chars[bytes[i] % chars.length]; }
    catch(e) { for (let i = 0; i < (len || 8); i++) t += chars[Math.floor(Math.random() * chars.length)]; }
    return t;
}
function genPassClient(len) {
    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
    let s = '';
    try { const bytes = crypto.getRandomValues(new Uint8Array(len || 16)); for (let i = 0; i < (len || 16); i++) s += chars[bytes[i] % chars.length]; }
    catch(e) { for (let i = 0; i < (len || 16); i++) s += chars[Math.floor(Math.random() * chars.length)]; }
    return s;
}
function fillInbSelect(selVal){ const s = document.getElementById('cl-inbound'); s.innerHTML = '<option value="">Selecciona...</option>' + inbounds.map(ib => `<option value="${ib.id}">${esc(ib.name)} (${ib.protocol.toUpperCase()}:${ib.port})</option>`).join(''); if (selVal) s.value = selVal; }
function currentInboundProtocol(){ const id = parseInt(document.getElementById('cl-inbound').value) || (editingClientInbound || 0); const ib = inbounds.find(x => x.id === id); return ib ? ib.protocol : 'vless'; }
function protocolUsesAuthFrontend(proto) { return ['socks','http'].includes(proto); }
function protocolHasUuidFrontend(proto) { return ['vless','vmess','trojan','shadowsocks'].includes(proto); }
function credentialTypeFrontend(proto) {
    if (['socks','http'].includes(proto)) return 'auth';
    if (['vless','vmess'].includes(proto)) return 'uuid';
    if (['trojan','shadowsocks'].includes(proto)) return 'password';
    return 'unknown';
}
function updateClientFieldsForProtocol(proto) {
    const needsCred = protocolHasUuidFrontend(proto);
    const needsAuth = protocolUsesAuthFrontend(proto);
    document.getElementById('cl-field-cred').style.display = needsCred ? 'block' : 'none';
    document.getElementById('cl-field-auth').style.display = needsAuth ? 'block' : 'none';
    document.getElementById('cl-field-token').style.display = needsCred ? 'block' : 'none';
    document.getElementById('cl-field-devicelimit').style.display = needsCred ? 'block' : 'none';
}
function generateClientCredentials(proto) {
    if (protocolUsesAuthFrontend(proto)) {
        document.getElementById('cl-auth-user').value = 'user_' + genShortTokenClient(6);
        document.getElementById('cl-auth-pass').value = genPassClient(16);
        document.getElementById('cl-cred').value = '';
        document.getElementById('cl-token').value = '';
    } else {
        if (proto === 'trojan' || proto === 'shadowsocks') document.getElementById('cl-cred').value = genPassClient(24);
        else document.getElementById('cl-cred').value = genUuidClient();
        document.getElementById('cl-token').value = genShortTokenClient(8);
        document.getElementById('cl-auth-user').value = '';
        document.getElementById('cl-auth-pass').value = '';
    }
}
async function regenCred(){ const proto = currentInboundProtocol(); const el = document.getElementById('cl-cred'); if (proto === 'trojan' || proto === 'shadowsocks') { el.value = genPassClient(24); toast('Regenerada', 'success'); } else { el.value = genUuidClient(); toast('Regenerada', 'success'); } }
async function regenAuthPass(){ document.getElementById('cl-auth-pass').value = genPassClient(16); toast('Regenerada', 'success'); }

function onClientInboundChange(){
    const newId = parseInt(document.getElementById('cl-inbound').value);
    const newIb = inbounds.find(x => x.id === newId);
    if (!newIb) return;
    const newProto = newIb.protocol;
    updateClientFieldsForProtocol(newProto);

    if (editingClientId && editingClientOriginalInbound) {
        const oldIb = inbounds.find(x => x.id === editingClientOriginalInbound);
        if (oldIb) {
            const oldType = credentialTypeFrontend(oldIb.protocol);
            const newType = credentialTypeFrontend(newProto);
            if (oldType !== newType) {
                generateClientCredentials(newProto);
                toast('Credenciales regeneradas por cambio de protocolo', 'info', 3000);
            } else if (newType !== 'auth' && !document.getElementById('cl-token').value) {
                document.getElementById('cl-token').value = genShortTokenClient(8);
            }
        }
    } else if (!editingClientId) {
        generateClientCredentials(newProto);
    }
}
