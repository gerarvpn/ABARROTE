        const ah = parseInt(auto_backup_hour, 10);
        const am = parseInt(auto_backup_minute, 10);
        saveTelegramSettings({ enabled: enabled?1:0, bot_token: String(bot_token||'').trim(), admin_ids: String(admin_ids||'').trim(), notify_payment: notify_payment?1:0, notify_online: notify_online?1:0, auto_backup: auto_backup?1:0, auto_backup_hour: isNaN(ah) ? 3 : Math.max(0, Math.min(23, ah)), auto_backup_minute: isNaN(am) ? 0 : Math.max(0, Math.min(59, am)) });
