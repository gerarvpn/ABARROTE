        if (subShowUsage !== undefined) vpn.subShowUsage = subShowUsage ? 1 : 0;
        if (subTitle !== undefined) vpn.subTitle = String(subTitle).trim().substring(0, 64);
        if (subUserAgent !== undefined) vpn.subUserAgent = String(subUserAgent).trim().substring(0, 500);
