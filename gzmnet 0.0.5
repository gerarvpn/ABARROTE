io.on('connection', (socket) => {
    activeSockets++;
    try { socket.emit('vpn_stats', buildVpnStatsPayload()); } catch(e) {}
    socket.on('vpn_stats_request', () => { try { socket.emit('vpn_stats', buildVpnStatsPayload()); } catch(e){} });
    socket.on('disconnect', () => { activeSockets = Math.max(0, activeSockets - 1); });
});

setTimeout(async () => {
