async function loadTotals(){ try { const r = await fetch('/api/traffic-total'); const d = await r.json(); if (!d.ok) return; const el = id => document.getElementById(id); if (el('kpiInbounds')) el('kpiInbounds').textContent = d.totalInbounds; if (el('kpiClients')) el('kpiClients').textContent = d.totalClients; if (el('kpiOnline')) el('kpiOnline').textContent = d.active; if (el('kpiTraffic')) el('kpiTraffic').textContent = fmtB(d.total); if (el('kpiTrafficSub')) el('kpiTrafficSub').textContent = '↑ ' + fmtB(d.up) + ' · ↓ ' + fmtB(d.down); if (el('sysTraffic')) el('sysTraffic').textContent = fmtB(d.total); } catch(e){} }

function renderConnected(){ const list = document.getElementById('connectedList'); const online = vpnStats.filter(s => s.connected && s.enabled); document.getElementById('connCount').textContent = online.length; if (!online.length) { list.innerHTML = '<div class="empty" style="padding:36px 12px;min-height:auto;"><i data-lucide="wifi-off"></i><div class="empty-text" style="margin-bottom:0;">Sin usuarios conectados</div></div>'; renderIcons(); return; } list.innerHTML = online.map(u => { const proto = (u.protocol||'').toLowerCase(); return `<div style="display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--border);"><span class="dot on"></span><div style="flex:1;min-width:0;"><div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;"><span style="font-weight:500;font-size:13px;">${esc(u.name)}</span><span class="badge ${proto}">${proto.toUpperCase()}</span></div><div style="font-size:11px;color:var(--text-3);margin-top:2px;">${esc(u.inbound||'')}</div></div><div class="mono" style="font-size:11.5px;">${fmtB(u.total)}</div></div>`; }).join(''); renderIcons(); }

function renderServers(){
    const list = document.getElementById('serversList');
    if (!inbounds.length) { list.innerHTML = `<div class="card empty"><i data-lucide="server"></i><div class="empty-title">Aún no hay servidores</div><div class="empty-text">Crea tu primer servidor.</div><button class="btn btn-primary" onclick="openInboundModal()"><i data-lucide="plus"></i> Crear</button></div>`; renderIcons(); return; }
    list.innerHTML = inbounds.map(ib => {
        const cls = clientsByInbound[ib.id] || [];
        const online = cls.filter(c => { const s = vpnStats.find(v => v.id === c.id); return s && s.connected && c.enabled; }).length;
        const tot = cls.reduce((a,c) => { const s = vpnStats.find(v => v.id === c.id) || {total:0}; return a + (s.total||0); }, 0);
        const iconName = ib.protocol === 'vless' ? 'zap' : ib.protocol === 'vmess' ? 'shield' : ib.protocol === 'trojan' ? 'key-round' : ib.protocol === 'shadowsocks' ? 'lock' : ib.protocol === 'socks' ? 'radio' : 'globe';
        return `<div class="server-card"><div class="server-card-header"><div class="server-icon ${ib.protocol}"><i data-lucide="${iconName}"></i></div><div class="server-info"><div class="server-name">${esc(ib.name)}</div><div class="server-meta"><span class="badge ${ib.protocol}">${ib.protocol.toUpperCase()}</span><span>:${ib.port}</span><span>·</span><span>${esc((ib.network||'ws').toUpperCase())}</span></div></div><div class="server-actions"><button class="btn btn-ghost btn-icon" onclick="editInbound(${ib.id})"><i data-lucide="edit-2"></i></button><button class="btn btn-primary btn-icon" onclick="openNewClient(${ib.id})"><i data-lucide="user-plus"></i></button></div></div><div class="server-stats"><div class="server-stat"><div class="server-stat-label">Clientes</div><div class="server-stat-value accent">${cls.length}</div></div><div class="server-stat"><div class="server-stat-label">En línea</div><div class="server-stat-value success">${online}</div></div><div class="server-stat"><div class="server-stat-label">Tráfico</div><div class="server-stat-value">${fmtB(tot)}</div></div></div></div>`;
    }).join('');
    renderIcons();
}

function getPayBadges(c) {
    if (!c.payment_enabled || !c.payment_date) return '';
    const freq = parseInt(c.payment_frequency) || 0;
    const today = new Date(); today.setHours(0,0,0,0);
    let target;
    if (freq === 0) target = new Date(c.payment_date + 'T00:00:00');
    else { let start = new Date(c.payment_date + 'T00:00:00'); if (start >= today) target = start; else { const diff = Math.floor((today - start) / 86400000); target = new Date(start.getTime() + Math.ceil(diff/freq) * freq * 86400000); } }
    const diff = Math.round((target - today) / 86400000);
    if (diff === 0) return '<span class="badge pay-today"><i data-lucide="credit-card" style="width:11px;height:11px;"></i>Pago HOY</span>';
    if (diff === 1) return '<span class="badge pay"><i data-lucide="credit-card" style="width:11px;height:11px;"></i>Pago mañana</span>';
    if (diff > 1 && diff <= 7) return `<span class="badge pay"><i data-lucide="credit-card" style="width:11px;height:11px;"></i>En ${diff}d</span>`;
    return '';
}

function renderClientsAll(){
