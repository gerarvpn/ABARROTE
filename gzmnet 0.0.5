app.get('/sw.js', (req, res) => {
    res.set('Content-Type', 'application/javascript'); res.set('Service-Worker-Allowed', '/');
    res.send(`self.addEventListener('install', e => self.skipWaiting());self.addEventListener('activate', e => e.waitUntil(clients.claim()));self.addEventListener('push', e => { let d = { title: 'GZMNET', body: '' }; try { d = e.data.json(); } catch(err) {} const opts = { body: d.body || '', icon: '/icon-192.png', badge: '/icon-192.png', vibrate: [200,100,200], data: { url: d.url || '/' } }; if (d.tag) { opts.tag = d.tag; opts.renotify = true; } e.waitUntil(self.registration.showNotification(d.title || 'GZMNET', opts)); });self.addEventListener('notificationclick', e => { e.notification.close(); const url = (e.notification.data && e.notification.data.url) || '/'; e.waitUntil(clients.matchAll({ type: 'window', includeUncontrolled: true }).then(ws => { for (const w of ws) { if (w.url.includes(url)) return w.focus(); } if (clients.openWindow) return clients.openWindow(url); })); });`);
});

function servePortal(req, res) {
    try {
        const token = String(req.params.token || '').trim();
        if (!token) return res.status(404).send('Not found');
        const c = vpnDb.prepare(`SELECT c.*, i.protocol, i.name as inbound_name, i.port FROM clients c JOIN inbounds i ON i.id = c.inbound_id WHERE c.sub_token = ?`).get(token);
        if (!c) return res.status(404).send('Portal no encontrado');
        if (protocolUsesAuth(c.protocol)) return res.status(404).send('Portal no disponible para este protocolo');
        const vpn = getVpnConfig();
        const jsonEnabled = vpn.jsonEnabled == 1;
        const subPort = vpn.subPort || vpn.panelPort || 443;
        const subPortPart = subPort == 443 ? '' : ':' + subPort;
        const subUrl = `https://${vpn.domain}${subPortPart}${vpn.subPath || '/sub'}/${c.sub_token}`;
        const jsonUrl = jsonEnabled ? `https://${vpn.domain}${subPortPart}${vpn.jsonPath || '/subjson'}/${c.sub_token}` : '';
        res.set('Cache-Control', 'no-store');
        res.send(renderPortalHTML(c, subUrl, jsonUrl, jsonEnabled, vapidKeys.publicKey, token));
    } catch(e) { res.status(500).send('Error'); }
}

function renderPortalHTML(c, subUrl, jsonUrl, jsonEnabled, vapidPub, token) {
    const fmtB = b => { b = Number(b)||0; if (b<=0) return '0 B'; const k=1024; const u=['B','KB','MB','GB','TB']; const i=Math.min(Math.floor(Math.log(b)/Math.log(k)),u.length-1); return (b/Math.pow(k,i)).toFixed(2)+' '+u[i]; };
    const lim = c.limit_gb || 0;
    const total = c.total_bytes || 0;
    const pct = lim > 0 ? Math.min(100, (total/(lim*1024*1024*1024))*100) : 0;
    const relDate = (dStr) => { if (!dStr) return ''; try { const today = new Date(); today.setHours(0,0,0,0); const t = new Date(dStr + 'T00:00:00'); const diff = Math.round((t.getTime() - today.getTime()) / 86400000); if (diff === 0) return 'HOY'; if (diff === 1) return 'Mañana'; if (diff < 0) return 'Vencido'; return 'En ' + diff + ' día' + (diff !== 1 ? 's' : ''); } catch(e) { return ''; } };
    const nextPayDate = c.payment_enabled ? (getNextPaymentDate(c) || c.payment_date) : '';
    const payDateBlock = (c.payment_enabled && nextPayDate) ? `<div class="date-card"><div class="date-icon"><i data-lucide="credit-card"></i></div><div class="date-body"><div class="date-label">Fecha de pago</div><div class="date-value">${formatDateSpanish(nextPayDate)}</div><div class="date-rel">${relDate(nextPayDate)}</div></div></div>` : '';
    const limitBar = lim > 0 ? `<div class="usage-bar"><div class="usage-fill" style="width:${pct}%"></div></div><div class="usage-text">${fmtB(total)} de ${lim} GB (${pct.toFixed(0)}%)</div>` : '<div class="usage-text">Sin límite de datos</div>';

    return `<!DOCTYPE html>
<html lang="es"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#000000">
