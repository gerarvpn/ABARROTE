async function performFullCacheClean() {
    try { vpnDb.exec('VACUUM'); vpnDb.exec('PRAGMA wal_checkpoint(TRUNCATE)'); } catch(e) {}
    try { if (fs.existsSync('/var/log/xray/access.log')) fs.writeFileSync('/var/log/xray/access.log', ''); if (fs.existsSync('/var/log/xray/error.log')) fs.writeFileSync('/var/log/xray/error.log', ''); } catch(e) {}
    await new Promise(resolve => exec('journalctl --vacuum-time=1d > /dev/null 2>&1', { timeout: 30000 }, () => resolve()));
    await new Promise(resolve => exec('sync && echo 3 > /proc/sys/vm/drop_caches 2>/dev/null', { timeout: 10000 }, () => resolve()));
    vpnDb.prepare("UPDATE routing_settings SET last_cache_at = datetime('now','localtime') WHERE id = 1").run();
}

setInterval(async () => {
    try {
        const s = vpnDb.prepare('SELECT cache_enabled, cache_hour, cache_minute, last_cache_at FROM routing_settings WHERE id = 1').get() || {};
