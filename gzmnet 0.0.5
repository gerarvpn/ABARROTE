        if (subs === 0) return res.json({ ok: false, error: 'No hay dispositivos suscritos.' });
        const r = await sendPushToAdmin({ title: '🧪 Test GZMNET', body: 'Notificación de prueba del panel.', url: '/' });
        res.json({ ok: r.ok, sent: r.sent, total: r.total, error: r.ok ? null : 'No se pudo enviar' });
    } catch(e) { res.status(500).json({ ok: false, error: e.message }); }
});
app.post('/api/notifications/test-client/:id', checkAuth, async (req, res) => {
    try {
        if (!webpush) return res.json({ ok: false, error: 'webpush no disponible' });
        if (!vapidKeys.publicKey) return res.json({ ok: false, error: 'VAPID keys no configuradas' });
        const c = vpnDb.prepare('SELECT id, name, sub_token FROM clients WHERE id = ?').get(req.params.id);
        if (!c) return res.json({ ok: false, error: 'Cliente no existe' });
        if (!c.sub_token) return res.json({ ok: false, error: 'Este cliente no tiene suscripción (SOCKS/HTTP)' });
        const subs = vpnDb.prepare('SELECT COUNT(*) as c FROM push_subscriptions WHERE client_id = ?').get(c.id).c;
        if (subs === 0) return res.json({ ok: false, error: `El cliente ${c.name} no tiene dispositivos suscritos.` });
        const r = await sendPushToClient(c.id, { title: '🧪 Test GZMNET', body: `Hola ${c.name}, notificación de prueba.`, url: '/portal/' + c.sub_token });
        res.json({ ok: r.ok, sent: r.sent, total: r.total, error: r.ok ? null : 'No se pudo enviar' });
