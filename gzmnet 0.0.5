let lastTrafficSnapshot = {};
let isFirstSnapshot = true;
let statsCache = { data: null, time: 0 };
let totalsCache = { data: null, time: 0 };
const ONLINE_TIMEOUT_MS = 45 * 1000;
let isQuerying = false;
let lastStatsDebugLog = 0;

function queryTrafficStats() {
    return new Promise((resolve) => {
        if (!fs.existsSync(XRAY_BIN)) return resolve({});
        exec(`${XRAY_BIN} api statsquery --server=127.0.0.1:${XRAY_API_PORT} 2>/dev/null`, { timeout: 5000 }, (err, stdout) => {
            if (err || !stdout) return resolve({});
            const result = {};
            try {
                const json = JSON.parse(stdout);
                for (const s of (json.stat || json.stats || [])) {
                    if (!s || !s.name) continue;
                    const parts = String(s.name).split('>>>');
                    if (parts.length < 3 || parts[0] !== 'user') continue;
                    if (!result[parts[1]]) result[parts[1]] = { up: 0, down: 0 };
                    if (parts[2] === 'traffic') {
                        const val = parseInt(s.value, 10) || 0;
                        if (parts[3] === 'uplink') result[parts[1]].up = val;
                        else if (parts[3] === 'downlink') result[parts[1]].down = val;
                    }
                }
            } catch(e) {}
            resolve(result);
        });
    });
}

// FIX: faster snapshot processing + invalidate totalsCache aggressively
async function processStatsSnapshot(trafficData) {
    const now = Date.now();
    const clients = vpnDb.prepare('SELECT id, email, up_bytes, down_bytes, total_bytes, online, last_seen, limit_gb, enabled FROM clients').all();
    const nowIso = new Date().toISOString();
    let configNeedsRefresh = false;
    let onlineChanged = false;
    if (isFirstSnapshot) {
        for (const c of clients) { const xemail = `c${c.id}`; const cur = trafficData[xemail] || { up: 0, down: 0 }; lastTrafficSnapshot[xemail] = { up: cur.up, down: cur.down }; }
        try { vpnDb.prepare('UPDATE clients SET online = 0').run(); } catch(e) {}
        isFirstSnapshot = false;
        statsCache = { data: null, time: 0 };
        totalsCache = { data: null, time: 0 };
        return;
    }
    const updateTraffic = vpnDb.prepare(`UPDATE clients SET up_bytes=?, down_bytes=?, total_bytes=?, online=?, last_seen=COALESCE(?, last_seen) WHERE id=?`);
    let onlineCount = 0;
    vpnDb.transaction(() => {
        for (const c of clients) {
            const xemail = `c${c.id}`;
            const hasData = Object.prototype.hasOwnProperty.call(trafficData, xemail);
            const cur = hasData ? trafficData[xemail] : { up: 0, down: 0 };
            const prev = lastTrafficSnapshot[xemail] || { up: 0, down: 0 };
            let deltaUp = cur.up - prev.up, deltaDown = cur.down - prev.down;
            if (deltaUp < 0) deltaUp = cur.up;
            if (deltaDown < 0) deltaDown = cur.down;
            const newUp = (c.up_bytes || 0) + deltaUp, newDown = (c.down_bytes || 0) + deltaDown, newTotal = newUp + newDown;
            const hadTraffic = (deltaUp + deltaDown) > 0;
            if (hasData) lastTrafficSnapshot[xemail] = { up: cur.up, down: cur.down };
            let isOnline = 0, lastSeenUpdate = null;
            if (hadTraffic) { isOnline = 1; lastSeenUpdate = nowIso; onlineCount++; }
            else if (c.last_seen) { const ls = new Date(c.last_seen).getTime(); if (!isNaN(ls) && (now - ls) < ONLINE_TIMEOUT_MS) { isOnline = 1; onlineCount++; } }
            if (isOnline !== (c.online || 0)) onlineChanged = true;
            updateTraffic.run(newUp, newDown, newTotal, isOnline, lastSeenUpdate, c.id);
            if (c.limit_gb > 0 && newTotal >= c.limit_gb * 1024 * 1024 * 1024 && c.enabled === 1) { vpnDb.prepare('UPDATE clients SET enabled = 0 WHERE id = ?').run(c.id); configNeedsRefresh = true; }
        }
    })();
    // FIX: always invalidate caches (online status changes matter for UI consistency)
    statsCache = { data: null, time: 0 };
    totalsCache = { data: null, time: 0 };
    if (now - lastStatsDebugLog > 60000) {
        lastStatsDebugLog = now;
        logApply(`[STATS] clients=${clients.length} online=${onlineCount} trafficEntries=${Object.keys(trafficData).length} changed=${onlineChanged}`);
    }
    if (configNeedsRefresh) scheduleApply(true);
}

function buildVpnStatsPayload() {
    const now = Date.now();
    // FIX: shorter cache TTL for faster UI updates
    if (statsCache.data && (now - statsCache.time) < 500) return statsCache.data;
    const clients = vpnDb.prepare(`SELECT c.id, c.name, c.email, c.inbound_id, c.up_bytes, c.down_bytes, c.total_bytes, c.online, c.last_seen, c.limit_gb, c.enabled, c.payment_enabled, c.payment_date, c.payment_frequency, c.payment_time, c.auth_user, c.auth_pass, c.device_limit, i.name as inbound_name, i.protocol FROM clients c JOIN inbounds i ON i.id = c.inbound_id`).all();
    const payload = clients.map(c => ({ id: c.id, name: c.name, email: c.email, inbound_id: c.inbound_id, inbound: c.inbound_name, protocol: c.protocol, up: c.up_bytes || 0, down: c.down_bytes || 0, total: c.total_bytes || 0, connected: c.online === 1, last_seen: c.last_seen, limit_gb: c.limit_gb || 0, enabled: c.enabled === 1, payment_enabled: c.payment_enabled === 1, payment_date: c.payment_date || '', payment_frequency: c.payment_frequency || 0, payment_time: c.payment_time || '09:00', auth_user: c.auth_user || '', device_limit: c.device_limit || 0 }));
    statsCache = { data: payload, time: now };
    return payload;
}
