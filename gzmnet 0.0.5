});

function handleSubBase64(req, res) {
    try {
        const token = String(req.params.token || '').trim();
        if (!token) return res.status(404).send('Not found');
        if (!validateUA(req)) return res.status(403).send('Forbidden');
        const c = vpnDb.prepare(`SELECT c.*, i.protocol, i.port, i.network, i.path, i.tls, i.domain as ib_domain, i.host, i.security, i.flow as inbound_flow, i.reality_public_key, i.reality_short_ids, i.fingerprint, i.alpn, i.ss_method, i.grpc_service, i.grpc_multi, i.h2_path, i.h2_host, i.quic_key, i.quic_security, i.quic_header, i.kcp_seed, i.kcp_header, i.xhttp_path, i.xhttp_host, i.xhttp_mode FROM clients c JOIN inbounds i ON i.id = c.inbound_id WHERE c.sub_token = ? AND c.enabled = 1`).get(token);
        if (!c) return res.status(404).send('Not found');
        if (protocolUsesAuth(c.protocol)) return res.status(404).send('No subscription available for this protocol');
        const track = trackDevice(c.id, req, c.device_limit || 0);
        if (!track.ok) return res.status(403).send('Device limit reached');
        const link = buildClientLink(c);
        if (!link) return res.status(500).send('Error');
        const b64 = Buffer.from(link).toString('base64');
        const vpn = getVpnConfig();
        res.set('Content-Type', 'text/plain; charset=utf-8'); res.set('Cache-Control', 'no-store');
        res.set('Profile-Update-Interval', String(vpn.subInterval || 12));
        res.set('Profile-Title', vpn.subTitle || c.name || 'VPN');
        if (vpn.subShowUsage == 1) { const tb = (c.limit_gb || 0) * 1024 * 1024 * 1024; res.set('Subscription-Userinfo', `upload=${c.up_bytes || 0}; download=${c.down_bytes || 0}; total=${tb}; expire=0`); }
        res.send(b64);
    } catch(e) { res.status(500).send('Error'); }
}

function handleSubJson(req, res) {
    try {
        const token = String(req.params.token || '').trim();
        if (!token) return res.status(404).send('Not found');
        const vpn = getVpnConfig();
        if (vpn.jsonEnabled != 1) return res.status(403).send('JSON disabled');
        if (vpn.jsonBypass && String(vpn.jsonBypass).trim()) { const ua = String(req.get('user-agent') || ''); if (ua.toLowerCase().indexOf(String(vpn.jsonBypass).toLowerCase()) !== -1) return res.status(403).send('Forbidden'); }
        if (!validateUA(req)) return res.status(403).send('Forbidden');
        const c = vpnDb.prepare(`SELECT c.*, i.protocol, i.port, i.network, i.path, i.tls, i.domain as ib_domain, i.host, i.security, i.flow as inbound_flow, i.reality_public_key, i.reality_short_ids, i.fingerprint, i.alpn, i.ss_method, i.grpc_service, i.grpc_multi, i.h2_path, i.h2_host, i.quic_key, i.quic_security, i.quic_header, i.kcp_seed, i.kcp_header, i.xhttp_path, i.xhttp_host, i.xhttp_mode FROM clients c JOIN inbounds i ON i.id = c.inbound_id WHERE c.sub_token = ? AND c.enabled = 1`).get(token);
        if (!c) return res.status(404).send('Not found');
        if (protocolUsesAuth(c.protocol)) return res.status(404).send('No JSON config available for this protocol');
        const track = trackDevice(c.id, req, c.device_limit || 0);
        if (!track.ok) return res.status(403).send('Device limit reached');
        const jsonConf = buildClientJsonConfig(c);
        if (!jsonConf) return res.status(404).send('No JSON config available');
        res.set('Content-Type', 'application/json; charset=utf-8'); res.set('Cache-Control', 'no-store');
        res.set('Profile-Update-Interval', String(vpn.subInterval || 12));
        res.set('Profile-Title', vpn.subTitle || c.name || 'VPN');
        if (vpn.subShowUsage == 1) { const tb = (c.limit_gb || 0) * 1024 * 1024 * 1024; res.set('Subscription-Userinfo', `upload=${c.up_bytes || 0}; download=${c.down_bytes || 0}; total=${tb}; expire=0`); }
        res.send(JSON.stringify(jsonConf, null, 2));
    } catch(e) { res.status(500).send('Error: ' + e.message); }
}

app.get('/sub/:token', (req, res) => { if (isBrowserRequest(req)) return servePortal(req, res); return handleSubBase64(req, res); });
app.get('/portal/:token', servePortal);
app.get('/subjson/:token', handleSubJson);
app.get('/:jsonPathSeg/:token', (req, res, next) => {
    const seg = String(req.params.jsonPathSeg || '');
    if (['api','static','socket.io','sub','login','logout','portal','manifest.json','admin-manifest.json','sw.js','icon-192.png','icon-512.png','apple-touch-icon.png'].includes(seg)) return next();
    const vpn = getVpnConfig();
    const confPath = String(vpn.jsonPath || '/subjson').replace(/^\/+/, '').replace(/\/+$/, '');
    if (seg !== confPath) return next();
    return handleSubJson(req, res);
});

app.get('/icon-:size.png', async (req, res) => {
    const size = Math.min(1024, Math.max(48, parseInt(req.params.size) || 512));
    if (canvasLib && logoBuf) {
        try { const canvas = canvasLib.createCanvas(size, size); const ctx = canvas.getContext('2d'); ctx.fillStyle = '#000000'; ctx.fillRect(0, 0, size, size); const img = await canvasLib.loadImage(logoBuf); const pad = Math.floor(size * 0.225); ctx.drawImage(img, pad, pad, size - pad*2, size - pad*2); res.set('Content-Type', 'image/png'); res.set('Cache-Control', 'public, max-age=86400'); return res.send(canvas.toBuffer('image/png')); }
        catch(e) { console.error('[ICON] canvas fail:', e.message); }
    }
    const logoSrc = logoBuf ? 'data:image/png;base64,' + logoBuf.toString('base64') : LOGO_URL;
    const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${size} ${size}"><rect width="${size}" height="${size}" fill="#000000"/><image x="${size*0.225}" y="${size*0.225}" width="${size*0.55}" height="${size*0.55}" href="${logoSrc}" preserveAspectRatio="xMidYMid meet"/></svg>`;
    res.set('Content-Type', 'image/svg+xml'); res.set('Cache-Control', 'public, max-age=86400'); res.send(svg);
});
