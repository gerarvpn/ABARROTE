function isBrowserRequest(req) {
    const ua = String(req.get('user-agent') || '').toLowerCase();
    const vpnClients = ['v2rayng','v2raytun','v2ray','shadowrocket','clash','quantumult','surfboard','sing-box','nekobox','nekoray','hiddify','streisand','stash','loon','foxray','shadowsocks','trojan','kitsunebi','postern','wireguard','openvpn','outline','ssr','matsuri','husi','pharos','fair','clashmeta','metacubex','flclash','mihomo'];
    for (const v of vpnClients) if (ua.includes(v)) return false;
    if (ua.includes('mozilla/')) if (ua.includes('chrome/') || ua.includes('safari/') || ua.includes('firefox/') || ua.includes('edg/')) return true;
