function renderToggles(){ const keys = ['block_ads','block_youtube_ads','block_trackers','block_adult','block_malware','prevent_captcha','block_bittorrent']; let ac = 0; for (const k of keys) { const el = document.querySelector(`[data-filter="${k}"]`); if (el) el.classList.toggle('on', routingSettings[k] == 1); if (routingSettings[k] == 1) ac++; } const desc = document.getElementById('filtersDesc'); if (desc) desc.textContent = ac > 0 ? `${ac} filtro${ac > 1 ? 's' : ''} activo${ac > 1 ? 's' : ''}` : 'Publicidad, rastreadores, malware'; const w = document.getElementById('swWarp'); if (w) { const a = routingSettings.warp_enabled == 1; w.classList.toggle('on', a); const dot = document.getElementById('warpDot'); const txt = document.getElementById('warpStatusText'); if (dot) dot.className = 'dot ' + (a ? 'on' : ''); if (txt) { txt.textContent = a ? 'ACTIVO' : 'Inactivo'; txt.style.color = a ? 'var(--warp)' : ''; } } }
async function toggleBlock(k){ const el = document.querySelector(`[data-filter="${k}"]`); const prev = routingSettings[k]; const nv = Number(prev) === 1 ? 0 : 1; routingSettings[k] = nv; if (el) el.classList.toggle('on', nv == 1); renderToggles(); const d = await pushRoutingSettings({ [k]: nv == 1 }); if (!d.ok) { routingSettings[k] = prev; renderToggles(); toast(d.error || 'Error', 'error'); } else toast(k === 'block_youtube_ads' ? (nv ? 'YouTube sin anuncios activado' : 'YouTube sin anuncios desactivado') : 'Aplicado', 'success'); }
async function toggleWarp(){ const prev = routingSettings.warp_enabled; const nv = Number(prev) === 1 ? 0 : 1; routingSettings.warp_enabled = nv; renderToggles(); const d = await pushRoutingSettings({ warp_enabled: nv == 1 }); if (!d.ok) { routingSettings.warp_enabled = prev; renderToggles(); toast(d.error || 'Error', 'error'); } else if (d.warp_enabled === 0 && nv === 1) { routingSettings.warp_enabled = 0; renderToggles(); toast('WARP no disponible', 'warning'); } else toast(nv ? 'WARP activado' : 'WARP desactivado', 'success'); }
