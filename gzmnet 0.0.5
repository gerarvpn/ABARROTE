        vpnDb.prepare('DELETE FROM inbounds WHERE id = ?').run(req.params.id);
        await ufwDeletePort(ib.port);
        emitRefresh();
        res.json({ ok: true });
        scheduleApply(false);
    } catch(e) { res.status(500).json({ ok: false, error: e.message }); }
});

