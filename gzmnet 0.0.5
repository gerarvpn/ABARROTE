app.get('/api/traffic-total', checkAuth, (req, res) => { try { const now = Date.now(); if (totalsCache.data && (now - totalsCache.time) < 500) return res.json(totalsCache.data); const row = vpnDb.prepare('SELECT COALESCE(SUM(up_bytes),0) as up, COALESCE(SUM(down_bytes),0) as down, COALESCE(SUM(total_bytes),0) as total FROM clients').get(); const payload = { ok: true, up: row.up, down: row.down, total: row.total, active: vpnDb.prepare('SELECT COUNT(*) as c FROM clients WHERE online = 1').get().c, totalClients: vpnDb.prepare('SELECT COUNT(*) as c FROM clients').get().c, totalInbounds: vpnDb.prepare('SELECT COUNT(*) as c FROM inbounds').get().c, top: vpnDb.prepare('SELECT name, total_bytes FROM clients ORDER BY total_bytes DESC LIMIT 5').all() }; totalsCache = { data: payload, time: now }; res.json(payload); } catch(e) { res.json({ ok: false, error: e.message }); } });

