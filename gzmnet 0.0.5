.filter-title{font-size:13px;font-weight:500;display:flex;align-items:center;gap:6px}
.filter-desc{font-size:11.5px;color:var(--text-3);margin-top:2px}
.filter-yt-icon{display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;border-radius:5px;background:rgba(255,0,0,0.12);color:#FF0000;flex-shrink:0}
.filter-yt-icon svg{width:11px;height:11px}
.rule-card{background:var(--bg);border:1px solid var(--border);border-left:3px solid var(--accent);border-radius:var(--radius);padding:12px 14px;display:flex;align-items:center;gap:12px;margin-bottom:8px}
.rule-card.disabled{opacity:0.5}
.rule-card.out-block{border-left-color:var(--danger)}
.rule-card.out-direct{border-left-color:var(--success)}
.rule-card.out-warp{border-left-color:var(--warp)}
.rule-card.out-block_quic{border-left-color:var(--quic)}
.rule-info{flex:1;min-width:0}
.rule-name{font-weight:500;font-size:13px}
.rule-conds{display:flex;flex-wrap:wrap;gap:4px;margin-top:5px}
.rule-cond{font-family:'JetBrains Mono',monospace;font-size:10.5px;padding:2px 7px;background:var(--surface-2);border-radius:5px;color:var(--text-2);max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.protocol-list{display:flex;flex-wrap:wrap;gap:6px;padding:4px 0}
.protocol-item{display:inline-flex;align-items:center;justify-content:center;padding:7px 14px;border-radius:8px;background:var(--bg);border:1px solid var(--border);cursor:pointer;font-size:12px;font-weight:600;user-select:none;transition:all 0.15s;text-transform:uppercase;letter-spacing:0.03em}
.protocol-item:hover{border-color:var(--border-2)}
.protocol-item.on{background:var(--accent);border-color:var(--accent);color:#fff}
.chart-stats{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.chart-stat{padding:20px 16px;background:var(--bg);border:1px solid var(--border);border-radius:14px;display:flex;flex-direction:column;align-items:center;gap:14px;transition:all 0.2s}
.chart-stat:hover{border-color:var(--border-2)}
.chart-stat-label{font-family:'Sora',sans-serif;font-size:11px;font-weight:600;color:var(--text-2);text-transform:uppercase;letter-spacing:0.12em;display:flex;align-items:center;gap:8px}
.chart-stat-label .dot-indicator{width:7px;height:7px;border-radius:50%}
.circular-gauge{position:relative;width:110px;height:110px;margin:0 auto}
.circular-gauge svg{position:absolute;inset:0;width:100%;height:100%;transform:rotate(-90deg);overflow:visible}
.circular-gauge .ring-bg{fill:none;stroke:var(--border-2);stroke-width:7}
.circular-gauge .ring-fg{fill:none;stroke-width:7;stroke-linecap:round;transition:stroke-dasharray 0.7s cubic-bezier(0.4, 0, 0.2, 1), stroke 0.4s ease}
.circular-gauge .gauge-label{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;pointer-events:none}
.circular-gauge .gauge-label .big{font-family:'Sora',sans-serif;font-size:26px;font-weight:700;line-height:1;letter-spacing:-0.02em;color:var(--text)}
.circular-gauge .gauge-label .unit{font-size:10px;color:var(--text-3);text-transform:uppercase;letter-spacing:0.12em;margin-top:2px;font-weight:600}
.chart-stat-sub{font-size:11.5px;color:var(--text-3);font-family:'JetBrains Mono',monospace;text-align:center;padding-top:4px}
@media(max-width:640px){.chart-stats{grid-template-columns:1fr 1fr;gap:10px}.circular-gauge{width:82px;height:82px}.circular-gauge .gauge-label .big{font-size:20px}.chart-stat{padding:16px 10px}}
.server-info-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.server-info-item{display:flex;align-items:center;gap:14px;padding:16px;background:var(--bg);border:1px solid var(--border);border-radius:12px;transition:all 0.15s}
.server-info-item:hover{border-color:var(--border-2)}
.server-info-icon{width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;border:1px solid}
.server-info-icon svg{width:20px;height:20px}
.server-info-icon.green{background:rgba(34,197,94,0.12);color:#22c55e;border-color:rgba(34,197,94,0.2)}
.server-info-icon.cyan{background:rgba(6,182,212,0.12);color:#06b6d4;border-color:rgba(6,182,212,0.2)}
.server-info-icon.blue{background:rgba(59,130,246,0.12);color:#3b82f6;border-color:rgba(59,130,246,0.2)}
.server-info-icon.amber{background:rgba(245,158,11,0.12);color:#f59e0b;border-color:rgba(245,158,11,0.2)}
.server-info-content{flex:1;min-width:0}
.server-info-label{font-size:10.5px;color:var(--text-3);text-transform:uppercase;letter-spacing:0.08em;font-weight:600;margin-bottom:4px}
.server-info-value{font-family:'JetBrains Mono',monospace;font-size:13.5px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;cursor:pointer}
.server-info-value.small{font-size:11.5px}
.server-info-value.copied{color:var(--success)!important}
@media(max-width:560px){.server-info-grid{grid-template-columns:1fr}.server-info-item{padding:14px}}
.device-row{display:flex;align-items:center;gap:12px;padding:12px;background:var(--bg);border:1px solid var(--border);border-radius:10px;margin-bottom:6px}
.device-icon{width:36px;height:36px;border-radius:10px;background:rgba(34,197,94,0.12);color:#22c55e;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.device-icon svg{width:16px;height:16px}
.device-info{flex:1;min-width:0}
.device-name{font-weight:600;font-size:13px}
.device-meta{font-size:11px;color:var(--text-3);margin-top:2px;font-family:'JetBrains Mono',monospace}
.device-client{font-size:10.5px;color:var(--accent-2);margin-top:2px}
.ua-chip{display:inline-flex;align-items:center;gap:6px;padding:5px 10px;background:rgba(59,130,246,0.12);border:1px solid rgba(59,130,246,0.25);border-radius:8px;font-size:12px;font-weight:600;color:var(--accent-2);margin:0 6px 6px 0;font-family:'JetBrains Mono',monospace}
.ua-chip button{background:rgba(239,68,68,0.15);color:#f87171;width:16px;height:16px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:14px;line-height:1;padding:0}
.ua-chip button:hover{background:rgba(239,68,68,0.25)}
.ua-chips-wrap{min-height:40px;padding:8px;background:var(--bg);border:1px solid var(--border);border-radius:10px;margin-bottom:8px}
.ua-chips-wrap:empty::before{content:'Sin restricciones - funciona en cualquier app';color:var(--text-3);font-size:11.5px;font-style:italic}
.toast{position:fixed;bottom:20px;right:20px;background:#18181b;border:1px solid var(--border-2);color:#f5f5f5;padding:12px 16px;border-radius:12px;font-size:13px;font-weight:500;box-shadow:0 12px 32px rgba(0,0,0,0.4);display:flex;align-items:center;gap:10px;z-index:2000;opacity:0;transform:translateY(20px);transition:all 0.25s;pointer-events:none;max-width:340px}
.toast.on{opacity:1;transform:translateY(0)}
.toast-icon{width:22px;height:22px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;background:rgba(59,130,246,0.2);color:#60a5fa}
.toast.success .toast-icon{background:rgba(34,197,94,0.2);color:#4ade80}
.toast.error .toast-icon{background:rgba(239,68,68,0.2);color:#f87171}
.toast.warning .toast-icon{background:rgba(245,158,11,0.2);color:#fbbf24}
.toast-icon svg{width:12px;height:12px}
@media(max-width:520px){.toast{left:14px;right:14px;max-width:none}}
.ip-pick{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;width:100%}
.ip-card{padding:14px 10px;background:var(--bg);border:1.5px solid var(--border);border-radius:12px;text-align:center;cursor:pointer;transition:all 0.2s;display:flex;flex-direction:column;align-items:center;gap:8px}
.ip-card.active{border-color:var(--accent);background:linear-gradient(135deg,rgba(59,130,246,0.08),rgba(59,130,246,0.03));box-shadow:0 0 0 3px rgba(59,130,246,0.1)}
.ip-card-icon{width:40px;height:40px;border-radius:11px;display:flex;align-items:center;justify-content:center;background:rgba(59,130,246,0.08);color:var(--text-2)}
.ip-card-icon svg{width:18px;height:18px}
.ip-card.active .ip-card-icon{background:rgba(59,130,246,0.15);color:var(--accent-2)}
.ip-card-label{font-family:'Sora',sans-serif;font-size:12px;font-weight:600}
.ip-card-sub{font-size:10px;color:var(--text-3);font-family:'JetBrains Mono',monospace}
#qr1{display:flex;align-items:center;justify-content:center;padding:8px;background:#fff;border-radius:12px;min-height:200px;min-width:200px}
#qr1 img{display:block;width:100%;max-width:220px;height:auto;border-radius:6px}
.tz-selector{display:grid;grid-template-columns:1fr 1fr auto;gap:10px;align-items:end}
@media(max-width:640px){.tz-selector{grid-template-columns:1fr 1fr}.tz-selector button{grid-column:span 2}}
.tz-preview{display:flex;align-items:center;gap:10px;padding:12px 14px;background:var(--bg);border:1px solid var(--border);border-radius:10px;margin-top:10px}
.tz-preview-icon{width:36px;height:36px;border-radius:11px;display:flex;align-items:center;justify-content:center;background:rgba(59,130,246,0.1);color:var(--accent-2);border:1px solid rgba(59,130,246,0.15);flex-shrink:0}
.tz-preview-icon svg{width:16px;height:16px}
.tz-preview-content{flex:1;min-width:0}
.tz-preview-label{font-size:10px;color:var(--text-3);text-transform:uppercase;letter-spacing:0.07em;font-weight:600;margin-bottom:3px}
.tz-preview-value{font-size:13px;font-weight:600}
.tz-preview-tz{font-size:11px;color:var(--text-3);font-family:'JetBrains Mono',monospace;margin-top:2px}
.backup-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media(max-width:520px){.backup-grid{grid-template-columns:1fr}}
.backup-card{background:var(--bg);border:1px solid var(--border);border-radius:14px;padding:18px;display:flex;flex-direction:column;align-items:center;text-align:center;gap:12px;transition:all 0.2s}
.backup-card:hover{border-color:var(--border-2);transform:translateY(-2px);box-shadow:0 8px 24px rgba(0,0,0,0.15)}
.backup-icon{width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.backup-icon.download{background:rgba(34,197,94,0.15);color:var(--success)}
.backup-icon.upload{background:rgba(245,158,11,0.15);color:var(--warning)}
.backup-icon svg{width:22px;height:22px}
.backup-title{font-family:'Sora',sans-serif;font-size:14px;font-weight:600}
.backup-desc{font-size:11.5px;color:var(--text-3);line-height:1.4}
.input-group{display:flex;gap:6px}
.input-group input{flex:1;min-width:0}
.input-group .btn{flex-shrink:0;height:auto}
.protocol-chip{display:inline-flex;align-items:center;justify-content:center;padding:6px 12px;border-radius:8px;background:var(--bg);border:1px solid var(--border);cursor:pointer;font-size:11.5px;font-weight:600;user-select:none;transition:all 0.15s;text-transform:uppercase}
.protocol-chip:hover{border-color:var(--border-2)}
.protocol-chip.on{background:var(--accent);border-color:var(--accent);color:#fff}
@media(max-width:640px){.dynamic-island{min-height:46px;padding:4px 5px;gap:6px}.dynamic-island.island-expanded{min-width:auto;padding:4px 5px 4px 12px}.island-menu-btn{width:36px;height:36px}.island-menu-btn svg{width:15px;height:15px}.island-brand-text{display:none}.island-divider{height:18px}.island-clock{padding:6px 11px;font-size:11.5px}.island-notif-btn{width:34px;height:34px}.island-notif-btn svg{width:15px;height:15px}.gauge{width:34px;height:34px}.gauge-value{font-size:9px}.island-dropdown{right:8px;left:8px;max-width:none}.clock-popover{left:8px;right:8px;transform:none;min-width:auto}.clock-popover.open{transform:translateY(0)}.notif-panel{left:8px;right:8px;transform:translateY(-12px) scale(0.96);min-width:auto;max-width:none}.notif-panel.open{transform:translateY(0) scale(1)}.content{padding-left:12px;padding-right:12px}.floating-theme-btn{display:none}.dynamic-island{max-width:calc(100vw - 28px)}.client-row{flex-wrap:wrap}.client-actions{width:100%;justify-content:flex-end;margin-top:8px}}
@media(max-width:420px){.island-brand{display:none}}
</style>
</head>
<body>

<button class="floating-theme-btn" onclick="toggleThemeGlobal()"><i data-lucide="sun-moon" id="themeIconGlobal"></i></button>

<div class="dynamic-island" id="island">
  <div class="island-brand" onclick="nav('dash')"><span class="island-brand-dot"></span><span class="island-brand-text">GZMNET</span></div>
  <div class="island-divider"></div>
  <button class="island-notif-btn" id="notifBtn" onclick="toggleNotifPanel(event)" title="Notificaciones">
    <i data-lucide="bell"></i>
    <span class="island-notif-badge" id="notifBadge"></span>
  </button>
  <div class="island-divider"></div>
  <div class="island-gauges">
    <div class="gauge" title="CPU"><svg viewBox="0 0 38 38"><circle class="ring-bg" cx="19" cy="19" r="14"></circle><circle class="ring-fg" id="cpuRing" cx="19" cy="19" r="14" stroke-dasharray="0 87.96" stroke="#22c55e"></circle></svg><span class="gauge-value" id="cpuVal">0</span></div>
    <div class="gauge" title="RAM"><svg viewBox="0 0 38 38"><circle class="ring-bg" cx="19" cy="19" r="14"></circle><circle class="ring-fg" id="ramRing" cx="19" cy="19" r="14" stroke-dasharray="0 87.96" stroke="#22c55e"></circle></svg><span class="gauge-value" id="ramVal">0</span></div>
  </div>
  <div class="island-divider"></div>
  <button class="island-clock" onclick="toggleClockPopover(event)"><span id="islandTime">--:--</span></button>
  <button class="island-menu-btn" onclick="toggleIslandMenu(event)"><i data-lucide="menu" id="menuIcon"></i></button>
</div>

<div class="notif-panel" id="notifPanel">
  <div class="notif-head">
    <div class="notif-head-title"><i data-lucide="bell"></i> Notificaciones</div>
    <button class="notif-head-clear" onclick="clearNotifBadge()">Marcar leídas</button>
  </div>
  <div class="notif-list" id="notifList"></div>
</div>

<div class="clock-popover" id="clockPopover"><div class="time-big" id="clockPopTime">--:--:--</div><div class="date-line" id="clockPopDate">—</div></div>
<div class="island-overlay" id="islandOverlay" onclick="closeAllPopovers()"></div>

<div class="island-dropdown" id="islandMenu">
  <button class="island-dropdown-item active" data-nav="dash" onclick="nav('dash')"><i data-lucide="layout-dashboard"></i> Panel</button>
  <button class="island-dropdown-item" data-nav="servers" onclick="nav('servers')"><i data-lucide="server"></i> Servidores</button>
  <button class="island-dropdown-item" data-nav="clients" onclick="nav('clients')"><i data-lucide="users"></i> Clientes</button>
  <div class="island-dropdown-divider"></div>
  <div class="island-dropdown-section">Red</div>
  <button class="island-dropdown-item" data-nav="routing" onclick="nav('routing')"><i data-lucide="route"></i> Enrutamiento</button>
  <button class="island-dropdown-item" data-nav="sub" onclick="nav('sub')"><i data-lucide="rss"></i> Suscripción</button>
  <div class="island-dropdown-divider"></div>
  <div class="island-dropdown-section">Sistema</div>
  <button class="island-dropdown-item" data-nav="settings" onclick="nav('settings')"><i data-lucide="settings"></i> Ajustes</button>
  <button class="island-dropdown-item" onclick="toggleThemeGlobal();closeAllPopovers();"><i data-lucide="sun-moon"></i> Cambiar tema</button>
  <div class="island-dropdown-divider"></div>
  <button class="island-dropdown-item danger" onclick="location.href='/logout'"><i data-lucide="log-out"></i> Cerrar sesión</button>
</div>

<main class="content">

<div class="page active" id="p-dash">
  <div class="page-title"><h1>Panel</h1></div>
  <div class="kpis">
    <div class="kpi"><div class="kpi-label">Servidores</div><div class="kpi-value" id="kpiInbounds">0</div></div>
    <div class="kpi"><div class="kpi-label">Clientes</div><div class="kpi-value" id="kpiClients">0</div></div>
    <div class="kpi"><div class="kpi-label">En línea</div><div class="kpi-value" id="kpiOnline" style="color:var(--success);">0</div></div>
    <div class="kpi"><div class="kpi-label">Tráfico total</div><div class="kpi-value" id="kpiTraffic">0 B</div><div class="kpi-sub" id="kpiTrafficSub">↑ 0 · ↓ 0</div></div>
  </div>
  <div class="card"><div class="card-header"><div class="card-title"><i data-lucide="wifi"></i> Conectados ahora</div><span class="badge on" id="connCount">0</span></div><div id="connectedList"></div></div>
</div>

<div class="page" id="p-servers">
  <div class="page-title"><h1>Servidores</h1><button class="btn btn-primary" onclick="openInboundModal()"><i data-lucide="plus"></i> Nuevo servidor</button></div>
  <div id="serversList"></div>
</div>

<div class="page" id="p-clients">
  <div class="page-title"><h1>Clientes</h1><button class="btn btn-primary" onclick="openNewClient()"><i data-lucide="user-plus"></i> Nuevo cliente</button></div>
  <div class="search-bar"><i data-lucide="search"></i><input type="text" id="clientSearch" placeholder="Buscar por nombre o ID..." oninput="renderClientsAll()"></div>
  <div id="clientsAllList"></div>
</div>

<div class="page" id="p-routing">
  <div class="page-title"><h1>Enrutamiento</h1></div>
  <div class="routing-section" id="secNet">
    <div class="routing-head" onclick="toggleSection('secNet')"><div class="routing-icon net"><i data-lucide="network"></i></div><div class="routing-title"><div class="routing-title-text">Tipo de Red</div><div class="routing-title-desc">Solo IPv4, solo IPv6 o ambos</div></div><i data-lucide="chevron-down" class="routing-chevron"></i></div>
    <div class="routing-body"><div class="routing-body-inner">
      <div class="field"><label>Preferencia de IP</label><div class="ip-pick">
        <div class="ip-card" data-ip="ipv4" onclick="selectIpType('ipv4')"><div class="ip-card-icon"><i data-lucide="wifi"></i></div><div class="ip-card-label">Solo IPv4</div><div class="ip-card-sub">UseIPv4</div></div>
        <div class="ip-card" data-ip="ipv6" onclick="selectIpType('ipv6')"><div class="ip-card-icon"><i data-lucide="wifi"></i></div><div class="ip-card-label">Solo IPv6</div><div class="ip-card-sub">UseIPv6</div></div>
        <div class="ip-card active" data-ip="dual" onclick="selectIpType('dual')"><div class="ip-card-icon"><i data-lucide="wifi"></i></div><div class="ip-card-label">IPv4 + IPv6</div><div class="ip-card-sub">Dual</div></div>
      </div></div>
      <div class="field" style="margin-bottom:0;"><label>Estrategia de dominio</label><select id="domainStrategy" onchange="saveDomainStrategy()"><option value="IPIfNonMatch">IPIfNonMatch (recomendado)</option><option value="IPOnDemand">IPOnDemand</option><option value="AsIs">AsIs</option></select></div>
    </div></div>
  </div>
  <div class="routing-section" id="secDNS">
    <div class="routing-head" onclick="toggleSection('secDNS')"><div class="routing-icon dns"><i data-lucide="globe"></i></div><div class="routing-title"><div class="routing-title-text">DNS</div><div class="routing-title-desc">Servidores DNS y presets</div></div><i data-lucide="chevron-down" class="routing-chevron"></i></div>
    <div class="routing-body"><div class="routing-body-inner">
      <div class="field-row"><div class="field"><label>DNS IPv4 primario</label><input type="text" id="dnsPrimary" placeholder="1.1.1.1" class="mono"></div><div class="field"><label>DNS IPv4 secundario</label><input type="text" id="dnsSecondary" placeholder="8.8.8.8" class="mono"></div></div>
      <div class="field-row"><div class="field"><label>DNS IPv6 primario</label><input type="text" id="dnsPrimaryV6" placeholder="2606:4700:4700::1111" class="mono"></div><div class="field"><label>DNS IPv6 secundario</label><input type="text" id="dnsSecondaryV6" placeholder="2001:4860:4860::8888" class="mono"></div></div>
      <div class="row-switch"><div class="row-switch-text"><div class="row-switch-title">Fake DNS Boost</div><div class="row-switch-desc">Añade DoH y caché extendida</div></div><button class="toggle" id="swFakeDns" onclick="toggleFakeDns()"></button></div>
      <button class="btn btn-primary" style="width:100%;" onclick="autoSaveDns()"><i data-lucide="check"></i> Guardar DNS</button>
      <div style="margin-top:16px;padding-top:14px;border-top:1px solid var(--border);"><div style="font-size:11.5px;font-weight:600;color:var(--text-2);margin-bottom:8px;letter-spacing:0.05em;">PRESETS RÁPIDOS</div><div class="dns-presets">
        <button class="dns-preset" onclick="quickDns('1.1.1.1','1.0.0.1','2606:4700:4700::1111','2606:4700:4700::1001')"><span class="name">Cloudflare</span><span class="ip">1.1.1.1</span></button>
        <button class="dns-preset" onclick="quickDns('8.8.8.8','8.8.4.4','2001:4860:4860::8888','2001:4860:4860::8844')"><span class="name">Google</span><span class="ip">8.8.8.8</span></button>
        <button class="dns-preset" onclick="quickDns('94.140.14.14','94.140.15.15','2a10:50c0::ad1:ff','2a10:50c0::ad2:ff')"><span class="name">AdGuard</span><span class="ip">94.140.14.14</span></button>
        <button class="dns-preset" onclick="quickDns('9.9.9.9','149.112.112.112','2620:fe::fe','2620:fe::9')"><span class="name">Quad9</span><span class="ip">9.9.9.9</span></button>
      </div></div>
