async function bootstrapNotifications() {
    try { const r = await fetch('/api/status'); const d = await r.json(); if (d.ok && d.vapidPublicKey) vapidPubKey = d.vapidPublicKey; } catch(e) {}
    if (!('serviceWorker' in navigator) || !('PushManager' in window) || !vapidPubKey) { updateAdminNotifStatus(); return; }
    try { await navigator.serviceWorker.register('/sw.js'); } catch(e) {}
    try { await navigator.serviceWorker.ready; } catch(e) {}
    await updateAdminNotifStatus();
    if (Notification.permission === 'granted') { try { const reg = await navigator.serviceWorker.ready; const sub = await reg.pushManager.getSubscription(); if (!sub) { await adminSubscribePush(); await updateAdminNotifStatus(); } } catch(e) {} }
}

function nav(page){ closeAllPopovers(); document.querySelectorAll('.page').forEach(p => p.classList.remove('active')); const t = document.getElementById('p-' + page); if (t) t.classList.add('active'); document.querySelectorAll('.island-dropdown-item[data-nav]').forEach(i => i.classList.toggle('active', i.dataset.nav === page)); renderIcons(); if (page === 'dash') { loadTotals(); renderConnected(); } if (page === 'servers') renderServers(); if (page === 'clients') loadAllClients(); if (page === 'routing') loadRouting(); if (page === 'sub') { loadSubSettings(); loadDevices(); } if (page === 'settings') { loadSystemInfo(); loadCacheSettings(); loadTimezone(); loadTelegramSettings(); updateAdminNotifStatus(); } }
const toastEl = document.getElementById('toast');
let toastTO = null;
function toast(text, type, ms){ if (toastTO) clearTimeout(toastTO); toastEl.classList.remove('success','error','warning'); const icons = { success:'check', error:'x', warning:'alert-triangle', info:'info' }; document.getElementById('toastIcon').innerHTML = `<i data-lucide="${icons[type]||'info'}"></i>`; document.getElementById('toastText').textContent = text; toastEl.classList.add('on', type || 'info'); renderIcons(); toastTO = setTimeout(() => { toastEl.classList.remove('on'); toastTO = null; }, ms || 2500); }
async function updateSystemInfo(){ try { const r = await fetch('/api/system-info'); const d = await r.json(); if (!d.ok) return; if (d.timezone && d.timezone !== serverTimezone) serverTimezone = d.timezone; if (d.timeFormat && d.timeFormat !== serverTimeFormat) serverTimeFormat = d.timeFormat; updateClock(); const cpu = parseFloat(d.cpuUsage) || 0; const ram = parseFloat(d.memPercent) || 0; updateGauge('cpuRing', 'cpuVal', cpu, 87.96); updateGauge('ramRing', 'ramVal', ram, 87.96); updateGauge('cpuRingBig', 'cpuBigVal', cpu, 238.76); updateGauge('ramRingBig', 'ramBigVal', ram, 238.76); const el = id => document.getElementById(id); if (el('cpuBigVal')) { el('cpuBigVal').style.color = cpu >= 85 ? getGaugeColor(cpu) : 'var(--text)'; } if (el('ramBigVal')) { el('ramBigVal').style.color = ram >= 85 ? getGaugeColor(ram) : 'var(--text)'; } if (el('cpuStatSub')) el('cpuStatSub').textContent = (d.cpuCount || 1) + ' núcleos'; if (el('ramStatSub')) { const used = ((d.memUsed||0)/1024/1024/1024).toFixed(1); const total = ((d.memTotal||0)/1024/1024/1024).toFixed(1); el('ramStatSub').textContent = used + ' / ' + total + ' GB'; } if (el('sysUptime')) el('sysUptime').textContent = fmtUptime(d.uptime || 0); if (el('sysIpv4')) el('sysIpv4').textContent = d.ipv4 || '—'; if (el('sysIpv6')) el('sysIpv6').textContent = d.ipv6 || '—'; } catch(e){} }

