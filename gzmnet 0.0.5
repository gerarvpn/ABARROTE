            for (const ib of b.inbounds) iS.run(ib.id, ib.name, ib.protocol, ib.port, ib.network||'ws', ib.path||'/', ib.tls?1:0, ib.domain||'', ib.host||'', ib.security||'none', ib.flow||'', ib.sniffing?1:0, ib.encryption||'', ib.fingerprint||'chrome', ib.alpn||'', ib.reality_dest||'', ib.reality_server_names||'', ib.reality_private_key||'', ib.reality_public_key||'', ib.reality_short_ids||'', ib.grpc_service||'', ib.grpc_multi?1:0, ib.h2_path||'/', ib.h2_host||'', ib.quic_key||'', ib.quic_security||'none', ib.quic_header||'none', ib.kcp_seed||'', ib.kcp_header||'none', ib.xhttp_path||'/', ib.xhttp_host||'', ib.xhttp_mode||'auto', ib.ss_method||'aes-256-gcm');
            const cS = vpnDb.prepare(`INSERT INTO clients (id, inbound_id, name, uuid, email, flow, limit_gb, enabled, last_seen, up_bytes, down_bytes, total_bytes, online, sub_token, sub_blocked, auth_user, auth_pass, prev_uuid, prev_auth_user, prev_auth_pass, payment_enabled, payment_date, payment_frequency, payment_time, telegram_chat_id, last_payment_notified, device_limit) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)`);
            for (const c of (b.clients || [])) cS.run(c.id, c.inbound_id, c.name, c.uuid, c.email||`c${c.id}`, c.flow||'', c.limit_gb||0, c.enabled?1:0, c.last_seen||null, c.up_bytes||0, c.down_bytes||0, c.total_bytes||0, 0, c.sub_token||null, c.sub_blocked||0, c.auth_user||'', c.auth_pass||'', c.prev_uuid||'', c.prev_auth_user||'', c.prev_auth_pass||'', c.payment_enabled||0, c.payment_date||'', c.payment_frequency||0, c.payment_time||'09:00', c.telegram_chat_id||'', '', c.device_limit||0);
            const rS = vpnDb.prepare(`INSERT INTO routing_rules (id, name, match_type, value, outbound, enabled, priority, match_rules) VALUES (?,?,?,?,?,?,?,?)`);
            for (const r of (b.routingRules || [])) rS.run(r.id, r.name, r.match_type, r.value, r.outbound, r.enabled?1:0, r.priority||0, r.match_rules||'');
